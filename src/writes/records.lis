// -------------------------------------------------------------------- docs

/// A doc edit; None leaves the field as it is. The confidence pair is a
/// judgement about a finding (confirm/refute), the rest its content.
#[json]
pub struct DocPatch {
  #[json(omitempty)]
  pub title: Option<string>,
  #[json(omitempty)]
  pub kind: Option<string>,
  #[json(omitempty)]
  pub body: Option<string>,
  #[json(omitempty)]
  pub area: Option<string>,
  #[json(omitempty)]
  pub paths: Option<string>,
  #[json(omitempty)]
  pub confidence: Option<string>,
  #[json(omitempty)]
  pub confidence_note: Option<string>,
}

pub fn create_doc(ctx: pb.Client, doc: models.NewDoc) -> Result<string, pb.CliError> {
  create(ctx, pb.Caller.Process, collection_path("docs"), doc, "doc")
}

pub fn update_doc(
  ctx: pb.Client,
  id: string,
  patch: DocPatch,
) -> Result<(), pb.CliError> {
  let _ = update(ctx, pb.Caller.Process, "docs", id, patch, "doc")?
  Ok(())
}

pub fn delete_doc(ctx: pb.Client, id: string) -> Result<(), pb.CliError> {
  remove(ctx, pb.Caller.Process, "docs", id)
}

#[json]
struct LinkIssue {
  #[json("issues+", omitempty)]
  add: Option<Slice<string>>,
  #[json("issues-", omitempty)]
  remove: Option<Slice<string>>,
}

/// Link one issue to a doc. One edge as a relation modifier, never the whole
/// array (LLL-513): the server applies it under the doc's lock, so two
/// concurrent links both land.
pub fn link_doc_issue(
  ctx: pb.Client,
  doc_id: string,
  issue_id: string,
) -> Result<(), pb.CliError> {
  let _ = update(
    ctx,
    pb.Caller.Process,
    "docs",
    doc_id,
    LinkIssue { add: Some([issue_id]), remove: None },
    "doc link",
  )?
  Ok(())
}

pub fn unlink_doc_issue(
  ctx: pb.Client,
  doc_id: string,
  issue_id: string,
) -> Result<(), pb.CliError> {
  let _ = update(
    ctx,
    pb.Caller.Process,
    "docs",
    doc_id,
    LinkIssue { add: None, remove: Some([issue_id]) },
    "doc link",
  )?
  Ok(())
}

// ------------------------------------------------------------------- teams

/// A team edit; None leaves the field as it is.
#[json]
pub struct TeamPatch {
  #[json(omitempty)]
  pub key: Option<string>,
  #[json(omitempty)]
  pub name: Option<string>,
  #[json(omitempty)]
  pub accent: Option<string>,
  #[json(omitempty)]
  pub emoji: Option<string>,
  #[json(omitempty)]
  pub archived: Option<bool>,
}

pub fn create_team(
  ctx: pb.Client,
  team: models.NewTeam,
) -> Result<string, pb.CliError> {
  create(ctx, pb.Caller.Process, collection_path("teams"), team, "team")
}

/// `caller` is the board's verified superuser for its archive action.
pub fn update_team(
  ctx: pb.Client,
  caller: pb.Caller,
  id: string,
  patch: TeamPatch,
) -> Result<(), pb.CliError> {
  let _ = update(ctx, caller, "teams", id, patch, "team patch")?
  Ok(())
}

pub fn delete_team(ctx: pb.Client, id: string) -> Result<(), pb.CliError> {
  remove(ctx, pb.Caller.Process, "teams", id)
}

// ----------------------------------------------------------------- members

/// A member edit; None leaves the field as it is. Members is an auth
/// collection: a password goes with its confirmation, and a member changing
/// its own password names the old one.
#[json]
pub struct MemberPatch {
  #[json(omitempty)]
  pub name: Option<string>,
  #[json(omitempty)]
  pub email: Option<string>,
  #[json("oldPassword", omitempty)]
  pub old_password: Option<string>,
  #[json(omitempty)]
  pub password: Option<string>,
  #[json("passwordConfirm", omitempty)]
  pub password_confirm: Option<string>,
  #[json(omitempty)]
  pub scope: Option<string>,
  #[json(omitempty)]
  pub teams: Option<Slice<string>>,
  #[json(omitempty)]
  pub mode: Option<string>,
}

/// Member writes name their caller: creating a person and changing access
/// or a password take a verified superuser token, a bot its owner's.
pub fn create_member(
  ctx: pb.Client,
  caller: pb.Caller,
  member: models.NewMember,
) -> Result<string, pb.CliError> {
  create(ctx, caller, collection_path("members"), member, "member")
}

pub fn update_member(
  ctx: pb.Client,
  caller: pb.Caller,
  id: string,
  patch: MemberPatch,
) -> Result<(), pb.CliError> {
  let _ = update(ctx, caller, "members", id, patch, "member")?
  Ok(())
}

pub fn delete_member(
  ctx: pb.Client,
  caller: pb.Caller,
  id: string,
) -> Result<(), pb.CliError> {
  remove(ctx, caller, "members", id)
}

