}

pub fn update_label(
  ctx: pb.Client,
  id: string,
  patch: LabelPatch,
) -> Result<(), pb.CliError> {
  let _ = update(ctx, pb.Caller.Process, "labels", id, patch, "label")?
  Ok(())
}

pub fn delete_label(ctx: pb.Client, id: string) -> Result<(), pb.CliError> {
  remove(ctx, pb.Caller.Process, "labels", id)
}

