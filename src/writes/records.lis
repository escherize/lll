import "models"
import "pb"

// Writes to the records around issues: comments, labels, projects, docs,
// teams, members, webhooks, and the board's workspace rows (favorites and
// saved views). A create returns the created record's body; the caller
// decodes the fields it needs.

// ---------------------------------------------------------------- comments

pub fn create_comment(
  ctx: pb.Client,
  caller: pb.Caller,
  comment: models.NewComment,
) -> Result<string, pb.CliError> {
  create(ctx, caller, collection_path("comments"), comment, "comment")
}

#[json]
struct CommentBody { body: string }

/// A comment's body is the only thing an edit changes: its issue is fixed
/// at create (LLL-678, enforced by gopb) and its author is the server's.
pub fn edit_comment(
  ctx: pb.Client,
  id: string,
  body: string,
) -> Result<(), pb.CliError> {
  let _ = update(
    ctx,
    pb.Caller.Process,
    "comments",
    id,
    CommentBody { body },
    "comment",
  )?
  Ok(())
}

pub fn delete_comment(ctx: pb.Client, id: string) -> Result<(), pb.CliError> {
  remove(ctx, pb.Caller.Process, "comments", id)
}

