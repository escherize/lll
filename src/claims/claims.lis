import "go:net/url"
import "models"
import "pb"
import "query"

/// The id of the claim held on the issue right now, None when it is not
/// claimed: the claim a write observed, for the server to check.
pub fn observed_id(ctx: pb.Client, issue_id: models.IssueId) -> Result<Option<models.ClaimId>, pb.CliError> {
  Ok(fetch(ctx, issue_id)?.map(|held| held.id))
}

pub fn fetch(ctx: pb.Client, issue_id: models.IssueId) -> Result<Option<models.Claim>, pb.CliError> {
  let filter = url.QueryEscape(f"issue={query.quote(issue_id.string())}")
  let mut list = models.ClaimList { .. }
  pb.fetch(ctx, 
    f"/api/collections/claims/records?perPage=1&filter={filter}&expand=member",
    "claims", &list,
  )?
  Ok(list.items.get(0))
}

/// Expanded holds in `scope`, shared by initial boards and live refreshes.
/// query.TeamScope.Every reads the holds in every team the token can see.
pub fn for_team(ctx: pb.Client, scope: query.TeamScope) -> Result<Slice<models.Claim>, pb.CliError> {
  let filter = match scope {
    query.TeamScope.Every => "",
    query.TeamScope.Only(team) => url.QueryEscape(f"issue.team={query.quote(team.string())}"),
  }
  let mut result: Slice<models.Claim> = []
  let mut page = 1
  loop {
    let mut list = models.ClaimList { .. }
    pb.fetch(ctx, f"/api/collections/claims/records?filter={filter}&expand=member&sort=id&perPage=200&page={page}", "team claims", &list)?
    result = result.append(list.items...)
    if page >= list.total_pages { break }
    page += 1
  }
  Ok(result)
}
