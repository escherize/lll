import "go:net/url"
import "models"
import "pb"
import "query"

pub fn observed_id(ctx: pb.Client, issue_id: string) -> Result<string, string> {
  Ok(fetch(ctx, issue_id)?.map_or("", |held| held.id))
}

pub fn fetch(ctx: pb.Client, issue_id: string) -> Result<Option<models.Claim>, string> {
  let filter = url.QueryEscape(f"issue={query.quote(issue_id)}")
  let mut list = models.ClaimList { .. }
  pb.fetch(ctx, 
    f"/api/collections/claims/records?perPage=1&filter={filter}&expand=member",
    "claims", &list,
  )?
  Ok(list.items.get(0))
}

/// Expanded holds for one team, shared by initial boards and live refreshes.
/// A team_id of "" (records.TeamScope.Every's filter_team) reads the holds in
/// every team the token can see.
pub fn for_team(ctx: pb.Client, team_id: string) -> Result<Slice<models.Claim>, string> {
  let filter = if team_id == "" { "" } else { url.QueryEscape(f"issue.team={query.quote(team_id)}") }
  let mut result: Slice<models.Claim> = []
  let mut page = 1
  loop {
    let mut list = models.ClaimList { .. }
    pb.fetch(ctx, f"/api/collections/claims/records?filter={filter}&expand=member&sort=id&perPage=200&page={page}", "team claims", &list)?
    result = result.append(list.items...)
    if page >= list.total_pages { break }
    page += 1
  }
  Ok(result)
}
