#[test]
fn filter_empty_criteria_yields_empty_string() {
  assert filter("", "", "", "", "", "") == ""
}

#[test]
fn filter_team_only() {
  assert filter("abc123", "", "", "", "", "") == "team='abc123'"
}

#[test]
fn filter_state_only() {
  assert filter("", "todo", "", "", "", "") == "state='todo'"
}

#[test]
fn filter_assignee_only() {
  assert filter("", "", "mem456", "", "", "") == "assignee='mem456'"
}

#[test]
fn filter_project_only() {
  assert filter("", "", "", "prj789", "", "") == "project='prj789'"
}

#[test]
fn filter_label_uses_membership_operator() {
  assert filter("", "", "", "", "lbl321", "") == "labels.id ?= 'lbl321'"
}

#[test]
fn filter_search_matches_title_substring() {
  assert filter("", "", "", "", "", "login") == "title ~ 'login'"
}

#[test]
fn filter_combines_criteria_with_and() {
  assert filter("abc123", "in-progress", "", "", "", "") ==
  "team='abc123' && state='in-progress'"
  assert filter("abc123", "todo", "mem456", "", "", "") ==
  "team='abc123' && state='todo' && assignee='mem456'"
  assert filter("abc123", "", "", "prj789", "lbl321", "fix") ==
  "team='abc123' && project='prj789' && labels.id ?= 'lbl321' && title ~ 'fix'"
}

#[test]
fn filter_escapes_quotes_and_backslashes() {
  assert filter("a'b", "", "", "", "", "") == r"team='a\'b'"
  assert filter(r"a\b", "", "", "", "", "") == r"team='a\\b'"
}

#[test]
fn filter_escapes_quotes_in_search() {
  assert filter("", "", "", "", "", "it's") == r"title ~ 'it\'s'"
  assert filter("", "", "", "", "", r"a\'b") == r"title ~ 'a\\\'b'"
}

#[test]
fn sort_accepts_known_fields() {
  let assert Ok(s) = sort("created")
  assert s == "created"
  let assert Ok(d) = sort("-priority")
  assert d == "-priority"
}

#[test]
fn sort_rejects_unknown_fields() {
  let assert Err(msg) = sort("title")
  assert msg.contains("unknown sort field 'title'")
  let assert Err(_) = sort("-nope")
}

#[test]
fn scoped_without_a_team_is_the_bare_clause() {
  assert scoped("", "name", "bug") == "name='bug'"
  assert scoped("", "slug", "index") == "slug='index'"
}

#[test]
fn scoped_with_a_team_leads_with_it() {
  assert scoped("t1", "slug", "index") == "team='t1' && slug='index'"
}

#[test]
fn scoped_escapes_both_halves() {
  assert scoped("a'b", "name", "it's") == r"team='a\'b' && name='it\'s'"
  assert scoped(r"a\b", "name", r"c\d") == r"team='a\\b' && name='c\\d'"
}

#[test]
fn quote_wraps_and_escapes() {
  assert quote("plain") == "'plain'"
  assert quote("it's") == r"'it\'s'"
  assert quote(r"a\b") == r"'a\\b'"
}

/// The payload that made TASK-134 a security bug rather than a tidy-up. The
/// old call sites built `name='<value>'` by interpolation, so this value
/// closed the clause and appended its own: `name='x' || name!=''` matches
/// EVERY row instead of one. Reached from the board's `/issues?assignee=`,
/// which is unauthenticated and unsanitized.
///
/// `quote` has to leave the `'` escaped and inside the literal. Asserting the
/// whole clause, not just `quote`'s output, is deliberate: the defect lived in
/// how callers assembled the clause, so the clause is what must be pinned.
#[test]
fn quote_contains_a_filter_breakout_payload() {
  let payload = "x' || name!='"
  assert quote(payload) == r"'x\' || name!=\''"
  // What member.lis's find_member_as now sends. The `||` survives as text
  // inside the string literal; it never becomes an operator.
  assert f"name={quote(payload)}" == r"name='x\' || name!=\''"
}
