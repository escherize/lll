import "models"

fn every() -> IssueFilter {
  IssueFilter.over(TeamScope.Every)
}

fn team(id: string) -> IssueFilter {
  IssueFilter.over(TeamScope.Only(models.TeamId(id)))
}

#[test]
fn filter_empty_criteria_yields_empty_string() {
  assert filter(every()) == ""
}

#[test]
fn filter_team_only() {
  assert filter(team("abc123")) == "team='abc123'"
}

#[test]
fn filter_state_only() {
  assert filter(IssueFilter { states: [models.IssueState.Todo], ..every() }) == "state='todo'"
}

#[test]
fn filter_assignee_only() {
  assert filter(IssueFilter { assignee: Some(models.MemberId("mem456")), ..every() }) == "assignee='mem456'"
}

#[test]
fn filter_project_only() {
  assert filter(IssueFilter { projects: [models.ProjectId("prj789")], ..every() }) == "project='prj789'"
}

#[test]
fn filter_label_uses_membership_operator() {
  assert filter(IssueFilter { labels: [models.LabelId("lbl321")], ..every() }) == "labels.id ?= 'lbl321'"
}

#[test]
fn filter_search_matches_title_substring() {
  assert filter(IssueFilter { search: "login", ..every() }) == "title ~ 'login'"
}

#[test]
fn filter_combines_criteria_with_and() {
  assert filter(IssueFilter { states: [models.IssueState.InProgress], ..team("abc123") }) ==
  "team='abc123' && state='in-progress'"
  assert filter(IssueFilter { states: [models.IssueState.Todo], assignee: Some(models.MemberId("mem456")), ..team("abc123") }) ==
  "team='abc123' && state='todo' && assignee='mem456'"
  assert filter(IssueFilter { projects: [models.ProjectId("prj789")], labels: [models.LabelId("lbl321")], search: "fix", ..team("abc123") }) ==
  "team='abc123' && project='prj789' && labels.id ?= 'lbl321' && title ~ 'fix'"
}

#[test]
fn filter_escapes_quotes_and_backslashes() {
  assert filter(team("a'b")) == r"team='a\'b'"
  assert filter(team(r"a\b")) == r"team='a\\b'"
}

#[test]
fn filter_escapes_quotes_in_search() {
  assert filter(IssueFilter { search: "it's", ..every() }) == r"title ~ 'it\'s'"
  assert filter(IssueFilter { search: r"a\'b", ..every() }) == r"title ~ 'a\\\'b'"
}

#[test]
fn every_team_has_no_team_clause_and_one_team_always_does() {
  // LLL-671: widening is the Every variant, written out; no id spells it.
  assert filter(every()) == ""
  assert filter(team("")) == "team=''"
}

#[test]
fn sort_accepts_known_fields() {
  let assert Ok(s) = sort("created")
  assert s == "created"
  let assert Ok(d) = sort("-priority")
  assert d == "-priority"
  let assert Ok(t) = sort("title")
  assert t == "title"
  let assert Ok(td) = sort("-title")
  assert td == "-title"
}

#[test]
fn sort_rejects_unknown_fields() {
  let assert Err(msg) = sort("state")
  assert msg.message.contains("unknown sort field 'state'")
  let assert Err(_) = sort("-nope")
}

#[test]
fn repeated_projects_become_a_parenthesised_or() {
  let two = filter(IssueFilter { projects: [models.ProjectId("p1"), models.ProjectId("p2")], ..every() })
  assert two == "(project='p1' || project='p2')"
  assert filter(IssueFilter { projects: [models.ProjectId("p1")], ..team("t1") }) == "team='t1' && project='p1'"
}

#[test]
fn scoped_with_a_team_leads_with_it() {
  assert scoped(models.TeamId("t1"), "slug", "index") == "team='t1' && slug='index'"
}

#[test]
fn scoped_escapes_both_halves() {
  assert scoped(models.TeamId("a'b"), "name", "it's") == r"team='a\'b' && name='it\'s'"
  assert scoped(models.TeamId(r"a\b"), "name", r"c\d") == r"team='a\\b' && name='c\\d'"
}

#[test]
fn quote_wraps_and_escapes() {
  assert quote("plain") == "'plain'"
  assert quote("it's") == r"'it\'s'"
  assert quote(r"a\b") == r"'a\\b'"
}

/// The payload that made TASK-134 a security bug rather than a tidy-up. The
/// old call sites built `name='<value>'` by interpolation, so this value
/// closed the clause and appended its own: `name='x' || name!=''` matches
/// EVERY row instead of one. Reached from the board's `/issues?assignee=`,
/// which is unauthenticated and unsanitized.
///
/// `quote` has to leave the `'` escaped and inside the literal. Asserting the
/// whole clause, not just `quote`'s output, is deliberate: the defect lived in
/// how callers assembled the clause, so the clause is what must be pinned.
#[test]
fn quote_contains_a_filter_breakout_payload() {
  let payload = "x' || name!='"
  assert quote(payload) == r"'x\' || name!=\''"
  // What member.lis's find_member_as now sends. The `||` survives as text
  // inside the string literal; it never becomes an operator.
  assert f"name={quote(payload)}" == r"name='x\' || name!=\''"
}

/// 1.0 fleet case 20: four agents typed --state review.
#[test]
fn a_near_state_names_the_one_it_matches() {
  let assert Err(e) = state("review")
  assert e.message.contains("did you mean 'in-review'?")
  let assert Err(far) = state("xyz")
  assert !far.message.contains("did you mean")
}

#[test]
fn a_longer_spelling_of_a_state_names_it_too() {
  let assert Err(e) = state("reviewing")
  assert e.message.contains("did you mean 'in-review'?")
}
