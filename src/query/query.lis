import "go:strings"

/// The six issue states, in workflow order.
pub fn states() -> Slice<string> {
  ["backlog", "todo", "in-progress", "in-review", "done", "cancelled"]
}

/// A supplied state must be in the workflow vocabulary. Empty is not a
/// state; filter adapters decide whether absence means no restriction.
pub fn state(value: string) -> Result<string, string> {
  if !states().contains(value) {
    return Err(f"unknown state '{value}' (use one of: {strings.Join(states(), ", ")})")
  }
  Ok(value)
}

/// User-facing filter values, before member/label/project name resolution.
/// Shared by CLI and web adapters; transport and database I/O stay outside.
pub struct Filters {
  // Slices, because `--state todo --state in-review` means BOTH (LLL-381).
  // Keeping one value silently discarded the rest and answered a question
  // nobody asked, which is worse than refusing: the output was a plausible,
  // well-formed, wrong list with exit code 0.
  pub state: Slice<string>,
  pub assignee: string,
  pub label: Slice<string>,
  pub project: string,
  pub search: string,
}

impl Filters {
  pub fn validate(self) -> Result<Filters, string> {
    for s in self.state { let _ = state(s)? }
    Ok(self)
  }

  /// The one state a single-valued surface means. The board's URL carries one
  /// of each and renders it as a chip, so it asks for that rather than
  /// learning that the CLI can mean several (LLL-381).
  pub fn one_state(self) -> string {
    self.state.get(0).unwrap_or("")
  }

  /// The one label, for the same reason.
  pub fn one_label(self) -> string {
    self.label.get(0).unwrap_or("")
  }
}

/// Sortable issue fields (PB record fields).
pub fn sort_fields() -> Slice<string> {
  ["created", "updated", "priority", "number", "title"]
}

/// Build a PocketBase filter expression from optional criteria.
/// Empty criteria are omitted; an empty result means "no filter".
/// `label_id` matches multi-relation membership (`labels.id ?=`); `search`
/// is a title substring match (`title ~`).
///
/// The single-value door onto `filter_in`, for the callers that can only ever
/// mean one state or one label. Repeated values arrive through `filter_in`.
pub fn filter(
  team_id: string,
  state: string,
  assignee_id: string,
  project_id: string,
  label_id: string,
  search: string,
) -> string {
  let states = if state == "" { [] } else { [state] }
  let labels = if label_id == "" { [] } else { [label_id] }
  filter_in(team_id, states, assignee_id, project_id, labels, search)
}

/// `filter`, with states and labels that may repeat (LLL-381).
///
/// Several of either is an OR inside the AND: `--state todo --state in-review`
/// becomes `(state='todo' || state='in-review')`, which is what a repeated flag
/// means everywhere else and what makes "everything unfinished" one command.
/// Labels do the same, so an issue carrying ANY of them matches.
pub fn filter_in(
  team_id: string,
  states: Slice<string>,
  assignee_id: string,
  project_id: string,
  label_ids: Slice<string>,
  search: string,
) -> string {
  let mut clauses: Slice<string> = []
  if team_id != "" { clauses = clauses.append(f"team={quote(team_id)}") }
  if let Some(c) = any_of("state=", states) { clauses = clauses.append(c) }
  if assignee_id != "" {
    clauses = clauses.append(f"assignee={quote(assignee_id)}")
  }
  if project_id != "" {
    clauses = clauses.append(f"project={quote(project_id)}")
  }
  if let Some(c) = any_of("labels.id ?= ", label_ids) { clauses = clauses.append(c) }
  if search != "" { clauses = clauses.append(f"title ~ {quote(search)}") }
  strings.Join(clauses, " && ")
}

/// `<lhs>value` for one value, `(<lhs>a || <lhs>b)` for several, and nothing
/// at all for none. Parenthesised, or the ORs would escape the surrounding AND
/// and widen every other clause with them.
///
/// `lhs` carries its own operator AND its spacing, because the two differ:
/// `state=` has none and `labels.id ?= ` has spaces on both sides, which is
/// how PocketBase's parser wants the membership operator written.
fn any_of(lhs: string, values: Slice<string>) -> Option<string> {
  let mut parts: Slice<string> = []
  for v in values {
    if v != "" { parts = parts.append(f"{lhs}{quote(v)}") }
  }
  if parts.is_empty() { return None }
  if parts.length() == 1 { return Some(parts[0]) }
  Some("(" + strings.Join(parts, " || ") + ")")
}

/// Validate a sort spec ("field" or "-field" for descending) and return it
/// in PB sort syntax, which is the same shape.
pub fn sort(spec: string) -> Result<string, string> {
  let field = strings.TrimPrefix(spec, "-")
  if sort_fields().find(|f| f == field).is_none() {
    return Err(
      f"unknown sort field '{field}' (use one of: {strings.Join(sort_fields(), ", ")}; prefix - for descending)",
    )
  }
  Ok(spec)
}

/// A PB filter for one team-owned record found by a unique-per-team field:
/// a label or project by `name`, a doc by `slug`. An empty `team_id` means
/// "every team" — the answer `lll label list` and an unconfigured board
/// still need, and the only way to say it.
///
/// This exists so no caller ever concatenates a team key into a filter by
/// hand: both halves go through `quote` (TASK-134).
pub fn scoped(team_id: string, field: string, value: string) -> string {
  let clause = f"{field}={quote(value)}"
  if team_id == "" { return clause }
  f"team={quote(team_id)} && {clause}"
}

/// Single-quote a value for a PB filter, escaping backslashes and quotes.
pub fn quote(value: string) -> string {
  let mut escaped = strings.ReplaceAll(value, r"\", r"\\")
  escaped = strings.ReplaceAll(escaped, "'", r"\'")
  f"'{escaped}'"
}
