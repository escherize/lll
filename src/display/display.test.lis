import "go:io/fs"
import "go:github.com/escherize/lll/web"

import "query"

// TASK-158: the SVG symbols in web/templates/icons.html are coupled to the two
// scales - display.priorities() and query.states() - by string, through
// `<use href="#pri-{{.}}">` and `<use href="#st-{{.}}">`. Nothing else checks
// the coupling: rename a level and the <use> points at a symbol that does not
// exist, which draws NOTHING and raises no error - not at compile time, not at
// runtime, and the e2e assertions look at the option label rather than the
// icon. So the drift is silent in every layer that could have caught it.
//
// The link is these two tests. They read the same embedded template the server
// renders (web.Assets(), not a path on disk, so they cannot go stale against a
// moved file) and compare the symbol ids to the scale in BOTH directions:
// a slug with no symbol fails, and a symbol with no slug fails. One direction
// alone would let a rename pass by leaving the old symbol behind.

/// Every `id="<prefix>-..."` in the icons template, with the prefix stripped:
/// symbol_slugs("pri-") over `<g id="pri-urgent">` yields ["urgent"].
/// Written here rather than in display.lis because it exists only to check
/// the markup - nothing at runtime needs to know what symbols the file holds.
fn symbol_slugs(prefix: string) -> Slice<string> {
  let Ok(data) = fs.ReadFile(web.Assets(), "templates/icons.html") else {
    return []
  }
  // The opening delimiter only - `id="pri-`, no closing quote - so the slug
  // itself is what follows, up to the next quote.
  let quote = "\""
  let mut found: Slice<string> = []
  for (i, chunk) in (data as string).split(f"id={quote}{prefix}").enumerate() {
    // Chunk 0 is the text before the first marker, not an id.
    if i > 0 { found = found.append(chunk.split(quote)[0]) }
  }
  found
}

#[test]
fn every_priority_has_an_icon_symbol_and_no_symbol_is_orphaned() {
  let symbols = symbol_slugs("pri-")
  assert symbols.length() > 0   // the template was found and parsed at all
  for slug in priorities() {
    assert symbols.contains(slug)
  }
  for slug in symbols {
    assert priorities().contains(slug)
  }
}

#[test]
fn every_state_has_an_icon_symbol_and_no_symbol_is_orphaned() {
  let symbols = symbol_slugs("st-")
  assert symbols.length() > 0
  for slug in query.states() {
    assert symbols.contains(slug)
  }
  for slug in symbols {
    assert query.states().contains(slug)
  }
}

#[test]
fn relative_under_a_minute_is_just_now() {
  assert relative_seconds(0) == "just now"
  assert relative_seconds(59) == "just now"
}

#[test]
fn relative_minutes_hours_days() {
  assert relative_seconds(60) == "1m ago"
  assert relative_seconds(180) == "3m ago"
  assert relative_seconds(3600) == "1h ago"
  assert relative_seconds(10800) == "3h ago"
  assert relative_seconds(86400) == "1d ago"
  assert relative_seconds(176400) == "2d ago"
}

#[test]
fn every_state_has_a_distinct_glyph() {
  let glyphs = [
      "backlog",
      "todo",
      "in-progress",
      "in-review",
      "done",
      "cancelled",
    ].map(
    glyph,
  )
  for (i, g) in glyphs.enumerate() {
    assert g != "?"
    for (j, other) in glyphs.enumerate() {
      assert i == j || g != other
    }
  }
  assert glyph("bogus") == "?"
}

#[test]
fn priority_markers_follow_linear_scale() {
  assert priority_marker(0) == ""
  assert priority_marker(1) == "!!!"
  assert priority_marker(2) == "!!"
  assert priority_marker(3) == "!"
  assert priority_marker(4) == "·"
  assert priority_marker(5) == ""
  assert priority_marker(-1) == ""
}

#[test]
fn priority_names_follow_linear_scale() {
  assert priority_name(0) == "none"
  assert priority_name(1) == "urgent"
  assert priority_name(2) == "high"
  assert priority_name(3) == "medium"
  assert priority_name(4) == "low"
  assert priority_name(5) == "?"
  assert priority_name(-1) == "?"
}

// The scale is one table now, so what needs guarding is that the derived
// views agree with it: a name that maps back to the value it came from.
#[test]
fn priority_round_trips_value_to_name_to_value() {
  assert priorities().length() == 5
  for (value, name) in priorities().enumerate() {
    assert priority_name(value) == name
    assert priority_value(name).unwrap_or(-1) == value
  }
}

#[test]
fn priority_round_trips_name_to_value_to_name() {
  for name in priorities() {
    assert priority_name(priority_value(name).unwrap_or(-1)) == name
  }
}

#[test]
fn priority_value_rejects_names_off_the_scale() {
  assert priority_value("critical").is_none()
  assert priority_value("Urgent").is_none()
  assert priority_value("").is_none()
}
