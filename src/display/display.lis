import "go:time"

// Glyph legend (one per state, workflow order):
//   ◌ backlog   ○ todo   ◐ in-progress   ◉ in-review   ● done   ⊗ cancelled

/// Glyph for an issue state.
pub fn glyph(state: string) -> string {
  match state {
    "backlog" => "◌",
    "todo" => "○",
    "in-progress" => "◐",
    "in-review" => "◉",
    "done" => "●",
    "cancelled" => "⊗",
    _ => "?",
  }
}

/// The priority scale, in Linear order: the index is the stored value and a
/// lower value is more urgent. This is the only place the scale is written
/// down — priority_name, priority_value, and the web's <option> lists all
/// derive from it, so adding or renaming a level is a one-line edit here.
pub fn priorities() -> Slice<string> {
  ["none", "urgent", "high", "medium", "low"]
}

/// Marker for a priority, one per priorities() entry: 1 urgent !!!, 2 high !!,
/// 3 medium !, 4 low ·, 0 none blank. Off-scale values are blank too.
pub fn priority_marker(priority: int) -> string {
  ["", "!!!", "!!", "!", "·"].get(priority).unwrap_or("")
}

/// Human name for a priority (Linear scale); "?" for an off-scale value.
pub fn priority_name(priority: int) -> string {
  priorities().get(priority).unwrap_or("?")
}

/// Priority name -> Linear value, the inverse of priority_name; None for a
/// name that is not on the scale. Five entries, so the scan is a formality.
pub fn priority_value(name: string) -> Option<int> {
  for (value, slug) in priorities().enumerate() {
    if slug == name { return Some(value) }
  }
  None
}

/// Render a PocketBase timestamp ("2026-08-28 18:20:00.123Z") as a relative
/// age like "3h ago". Unparseable input is returned as-is.
pub fn relative(timestamp: string) -> string {
  time
    .Parse("2006-01-02 15:04:05.999Z", timestamp)
    .map_or(timestamp, |t| relative_seconds(time.Now().Unix() - t.Unix()))
}

/// Pure core of relative(): seconds-ago -> "3h ago".
pub fn relative_seconds(seconds: int64) -> string {
  if seconds < 60 { return "just now" }
  if seconds < 3600 { return f"{seconds / 60}m ago" }
  if seconds < 86400 { return f"{seconds / 3600}h ago" }
  f"{seconds / 86400}d ago"
}
