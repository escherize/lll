import "go:time"
import "models"

// Glyph legend (one per state, workflow order):
//   ◌ backlog   ○ todo   ◐ in-progress   ◉ in-review   ● done   ⊗ cancelled

/// Glyph for an issue state; "?" for a record with none lll knows.
pub fn glyph(state: Option<models.IssueState>) -> string {
  match state {
    Some(models.IssueState.Backlog) => "◌",
    Some(models.IssueState.Todo) => "○",
    Some(models.IssueState.InProgress) => "◐",
    Some(models.IssueState.InReview) => "◉",
    Some(models.IssueState.Done) => "●",
    Some(models.IssueState.Cancelled) => "⊗",
    None => "?",
  }
}

/// A record's state as printed: its wire spelling, "" for none.
pub fn state_name(state: Option<models.IssueState>) -> string {
  state.map_or("", |s| s.wire())
}

/// The priority names in Linear order: what the web's <option> lists offer.
pub fn priorities() -> Slice<string> {
  models.Priority.all().map(|p| p.name())
}

/// Marker for a priority; blank for none and for an off-scale value.
pub fn priority_marker(priority: Option<models.Priority>) -> string {
  priority.map_or("", |p| p.marker())
}

/// Human name for a priority (Linear scale); "?" for an off-scale value.
pub fn priority_name(priority: Option<models.Priority>) -> string {
  priority.map_or("?", |p| p.name())
}

/// Render a PocketBase timestamp ("2026-08-28 18:20:00.123Z") as an absolute
/// UTC minute, "2026-08-28 18:20 UTC". Unparseable input is returned as-is.
///
/// relative() is for a person reading a screen now; this is for output that
/// gets stored and re-read — a piped brief, an agent's context, an exported
/// mirror under Git. Re-rendering "5d ago" tomorrow says "6d ago" and diffs
/// a line whose record never changed.
pub fn absolute(timestamp: string) -> string {
  time
    .Parse("2006-01-02 15:04:05.999Z", timestamp)
    .map_or(timestamp, |t| t.UTC().Format("2006-01-02 15:04 UTC"))
}

/// A PocketBase timestamp ("2026-08-28 18:20:00.123Z") in RFC3339 with
/// milliseconds ("2026-08-28T18:20:00.123Z"), the form every --json output
/// prints (LLL-645). Unparseable input, "" included, is returned as-is.
pub fn rfc3339(timestamp: string) -> string {
  time
    .Parse("2006-01-02 15:04:05.999Z", timestamp)
    .map_or(timestamp, |t| t.UTC().Format("2006-01-02T15:04:05.000Z07:00"))
}

/// Render a PocketBase timestamp ("2026-08-28 18:20:00.123Z") as a relative
/// age like "3h ago". Unparseable input is returned as-is.
pub fn relative(timestamp: string) -> string {
  time
    .Parse("2006-01-02 15:04:05.999Z", timestamp)
    .map_or(timestamp, |t| relative_seconds(time.Now().Unix() - t.Unix()))
}

/// A member's name with the session label it wrote under (LLL-521), so one
/// token shared by several agents still reads as several writers.
pub fn byline(name: string, agent: string) -> string {
  if agent == "" { name } else { f"{name} (agent {agent})" }
}

/// What every surface prints for a member the reader may not see (LLL-551):
/// a team-scoped member sees only part of the roster, so a record can point
/// at someone whose name the server withholds. Saying "hidden" rather than
/// "none" keeps the record honest: the issue IS assigned, the comment HAS an
/// author.
pub fn hidden_member() -> string {
  "hidden member"
}

/// A related member's name as the reader may see it: the expanded `name`,
/// else "hidden member" when the relation holds an id the server would not
/// expand, else `empty` when the relation is empty.
pub fn member_name(id: models.MemberId, name: string, empty: string) -> string {
  if name != "" { return name }
  if id != "" { return hidden_member() }
  empty
}

/// A comment's byline: "system" when the server wrote it on its own (LLL-654:
/// the claim-expiry note, whose body names the holder), else the
/// author as member_name reads it, with its session label.
pub fn comment_byline(kind: string, id: models.MemberId, name: string, agent: string, empty: string) -> string {
  if kind == "system" { return "system" }
  byline(member_name(id, name, empty), agent)
}

/// Pure core of relative(): seconds-ago -> "3h ago".
pub fn relative_seconds(seconds: int64) -> string {
  if seconds < 60 { return "just now" }
  if seconds < 3600 { return f"{seconds / 60}m ago" }
  if seconds < 86400 { return f"{seconds / 3600}h ago" }
  f"{seconds / 86400}d ago"
}

/// The marker after an author's name (LLL-610): "" for a person, " [bot]",
/// or " [bot via OWNER]" when the caller may read the owner.
pub fn author_tag(bot: bool, owner: string) -> string {
  if !bot { return "" }
  if owner == "" { return " [bot]" }
  f" [bot via {owner}]"
}

/// Urgency rank: 1 urgent .. 4 low, with none last, the rotation
/// prios_by_urgency makes for the filter chooser. An off-scale value ranks
/// after none.
pub fn prio_rank(priority: Option<models.Priority>) -> int {
  priority.map_or(6, |p| p.rank())
}

/// The marker that keeps a guess from reading as fact (LLL-396): confirmed
/// findings — which is everything written before the field existed — print
/// unmarked, so the noise lands only where judgement changed the meaning.
/// Takes the two fields rather than the record so the board's finding view
/// model and the CLI's Doc share one rule.
pub fn confidence_suffix(confidence: string, note: string) -> string {
  if confidence == "suspected" { return " [suspected]" }
  if confidence == "refuted" {
    if note != "" { return f" [refuted: {note}]" }
    return " [refuted]"
  }
  ""
}
