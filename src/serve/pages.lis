import "records"
import "claims"
import "go:encoding/json"
import "go:html/template"
import "go:net/http"
import "go:net/url"
import "go:strings"

import "display"
import "models"
import "pb"
import "query"
import "theme"
import "buildinfo"

// The app shell and the two board pages: the rail every page wears, GET / and
// GET /issue/{key}.

/// The rail for one page: `active` names the current row, `me` decides
/// whether "My issues" has anywhere to point, and `team` carries the accent
/// every page wears.
fn rail_vm(ctx: pb.Client, active: string, me: string, team: models.Team) -> RailVM {
  RailVM { favorites: fav_vms(ctx), views: view_vms(ctx), ..shell_rail(ctx, active, me, team) }
}

/// The rail without the workspace's favorites and saved views.
fn shell_rail(ctx: pb.Client, active: string, me: string, team: models.Team) -> RailVM {
  let hex = theme.normalize_hex(team.accent)
  RailVM {
    team_key: team.key,
    active,
    me,
    version: buildinfo.version(),
    accent_css: theme.accent_css(hex),
    favicon: theme.favicon_url(hex, theme.mark_for(team.key, team.emoji)),
    board_base: board_base(team.key),
    teams: rail_teams(ctx, team.key),
    favorites: [],
    views: [],
    scoped: false,
    bot_owner: "",
  }
}

/// The rail for this request's viewer. `ctx` reads as the viewer
/// (LLL-658), so the team switcher lists the teams it may see. A scoped
/// viewer gets no favorites or saved views: those belong to the whole
/// workspace, and only the board login writes them. A member viewer's "My
/// issues" is its own (LLL-545).
fn rail_for(ctx: pb.Client, viewer: Viewer, active: string, me: string, team: models.Team) -> RailVM {
  let Viewer.Scoped(v) = viewer else { return rail_vm(ctx, active, me, team) }
  let rail = shell_rail(ctx, active, me, team)
  let mine = v.member.map_or(rail.me, |m| m.name)
  // "Add a bot" (LLL-546): a read-write person viewer owns what it mints. A
  // bot viewer cannot own bots (gopb), so it gets no button.
  let bot_owner = match v.member {
    Some(m) if m.access.mode.writes() && !strings.HasPrefix(m.name, "bot-") => m.name,
    _ => "",
  }
  RailVM {
    me: mine,
    scoped: true,
    bot_owner,
    ..rail
  }
}

/// The board path for a team key: "/t/KEY/", or "/" when no key scopes the
/// page (defensive — run_server insists on a boot team). TASK-198.
fn board_base(key: string) -> string {
  if key == "" { return "/" }
  f"/t/{key}/"
}

/// The rail's team switcher rows (TASK-198): every team on the server,
/// key-sorted, the current page's marked. A failed fetch renders no switcher
/// rather than a 500 — the same bargain as the rail's other groups.
/// Archived teams stay off the switcher (TASK-210) — even the one the page
/// is scoped to: its board says "archived" in its own banner instead.
fn rail_teams(ctx: pb.Client, current: string) -> Slice<RailTeamVM> {
  let Ok(teams) = records.list_teams(ctx) else {
    return []
  }
  teams.items.filter(|t| !t.archived).map(|t| RailTeamVM {
    key: t.key,
    name: t.name,
    emoji: t.emoji,
    href: board_base(t.key),
    active: t.key == current,
  })
}

/// The rail's SAVED VIEWS group. Same bargain as fav_vms: a failed fetch
/// renders an empty group rather than a 500.
fn view_vms(ctx: pb.Client) -> Slice<ViewVM> {
  fetch_view_vms(ctx).unwrap_or([])
}

/// A refresh must distinguish a failed read from an actually empty group.
fn fetch_view_vms(ctx: pb.Client) -> Result<Slice<ViewVM>, pb.CliError> {
  let mut list = models.ViewList { .. }
  pb.fetch(ctx, "/api/collections/views/records?perPage=200&sort=-created", "views", &list)?
  // A view is a name plus a query string, nothing more: the rail row is the
  // board URL that query string reproduces.
  Ok(list.items.map(|v| {
    let mut href = "/"
    if v.query != "" { href = f"/?{v.query}" }
    ViewVM { name: v.name, href }
  }))
}

/// The rail's FAVORITES group. A failed fetch renders an empty group rather
/// than a 500: a missing star list must not cost you the board.
fn fav_vms(ctx: pb.Client) -> Slice<FavVM> {
  let Ok(favs) = fetch_favorites(ctx) else {
    return []
  }
  favorite_rows(favs)
}

/// The rail projection contains only navigation metadata, never issue bodies.
fn favorite_rows(favs: Slice<models.Favorite>) -> Slice<FavVM> {
  favs.map(|f| {
    let issue = f.expand.issue
    FavVM {
      key: f"{issue.expand.team.key}-{issue.number}",
      title: issue.title,
      state: display.state_name(issue.state()),
    }
  })
}

/// Every favorite, newest first, with only the metadata the rail displays.
///
/// Unscoped by member on purpose: auth is deferred (task-32), so every row
/// carries member="" and a star belongs to the workspace. When members
/// arrive this grows a filter, not a new shape.
fn fetch_favorites(ctx: pb.Client) -> Result<Slice<models.Favorite>, pb.CliError> {
  let mut list = models.FavoriteList { .. }
  pb.fetch(ctx, 
    "/api/collections/favorites/records?perPage=200&sort=-created,id&expand=issue.team&fields=id,issue,expand.issue.id,expand.issue.number,expand.issue.title,expand.issue.state,expand.issue.expand.team.key",
    "favorites",
    &list,
  )?
  // A favorite whose issue expand came back empty (issue deleted between the
  // list and the expand) has no link to render.
  Ok(list.items.filter(|f| f.expand.issue.id != ""))
}

/// The workspace's favorite row for one issue, if it has one.
fn fetch_favorite(ctx: pb.Client, issue_id: models.IssueId) -> Result<Option<models.Favorite>, pb.CliError> {
  let filter = url.QueryEscape(f"issue={query.quote(issue_id.string())} && member=''")
  let mut list = models.FavoriteList { .. }
  pb.fetch(ctx, 
    f"/api/collections/favorites/records?perPage=1&filter={filter}",
    "favorites",
    &list,
  )?
  Ok(list.items.get(0))
}

/// One query parameter, or "" when there is no URL to ask.
fn query_param(r: Ref<http.Request>, name: string) -> string {
  let Some(u) = r.URL else {
    return ""
  }
  u.Query().Get(name)
}

/// The board: whose whole view state — filter chips AND hidden lanes — is
/// its query string (TASK-94). The server reads the params, validates them,
/// and renders the filtered board; every control that changes a filter is a
/// navigation, so a filtered URL reproduces the view in a fresh browser and
/// the back button walks between filter states for free.
///
/// A rejected param is dropped and said out loud in the flash strip, never
/// a 500 — the same contract /issues runs on: a stale bookmark must still
/// show a board.
///
/// /events still broadcasts ONE unfiltered #board fragment to every
/// board-scoped client, so the URL filter is guarded client-side too: each
/// card's data-show checks the $flt signal the page seeds from its own URL.
/// `team` is the ROUTED team (TASK-198): /t/{team}/ resolved it before this
/// handler ran, so every fetch and every generated URL below is that team's.
fn board_page(ctx: pb.Client, w: http.ResponseWriter, r: Ref<http.Request>, team: models.Team, me: string, viewer: Viewer) {
  let team_id = team.id
  let mut err = ""
  let raw = view_query(r)

  // Validate every value against the catalogue before it filters anything.
  let mut states: Slice<models.IssueState> = []
  for s in csv(raw.state) {
    match query.state(s) {
      Ok(valid) => { states = states.append(valid) },
      Err(e) => { if err == "" { err = e.message } },
    }
  }
  // Who this viewer may name on this team (LLL-551). An assignee filter
  // outside it answers exactly like a name nobody has.
  let roster = match read_roster(ctx) {
    Ok(found) => found,
    Err(e) => {
      http.Error(w, e.message, 500)
      return
    },
  }
  let mut assignees: Slice<string> = []
  for a in csv(raw.assignee) {
    match roster_member(roster, a) {
      Ok(_) => assignees = assignees.append(a),
      Err(e) => { if err == "" { err = e.message } },
    }
  }
  let mut labels: Slice<string> = []
  for l in csv(raw.label) {
    match records.resolve_label(ctx, team_id, l) {
      Ok(_) => labels = labels.append(l),
      Err(e) => { if err == "" { err = e.message } },
    }
  }
  // Projects filter by id (LLL-523): the URL speaks names, as /issues does,
  // and the resolved id is what a board issue carries without an expand.
  // Split on commas like every board dimension, which is a known limit: a
  // project named "Q3, infra" cannot be filtered here, though /issues takes
  // ?project= as one value. Labels share the limit.
  let mut projects: Slice<string> = []
  let mut project_ids: Slice<models.ProjectId> = []
  for p in csv(raw.project) {
    match records.resolve_project(ctx, team_id, p) {
      Ok(found) => {
        projects = projects.append(p)
        project_ids = project_ids.append(found.id)
      },
      Err(e) => { if err == "" { err = e.message } },
    }
  }
  let mut prios: Slice<string> = []
  for p in csv(raw.prio) {
    if models.Priority.named(p).is_some() {
      prios = prios.append(p)
    } else if err == "" {
      err = f"unknown priority '{p}'"
    }
  }
  let mut hidden: Slice<string> = []
  for h in csv(raw.hide) {
    match query.state(h) {
      Ok(valid) => { hidden = hidden.append(valid.wire()) },
      Err(e) => { if err == "" { err = f"{e.message} (hide)" } },
    }
  }
  // The saved view (LLL-375): on a URL that says nothing about hide — the
  // bare board, the way anyone opens it — this team's view cookie replays
  // the browser's hidden columns, so the server's FIRST paint is already
  // correct and the old localStorage redirect never fires. An explicit
  // ?hide= in the URL still wins (a shared link shows what its sender saw);
  // a stale slug in the cookie is dropped silently, because a renamed state
  // must not become a permanent flash there is no URL to fix.
  let view_cookie_name = f"lll_view_{team.key}"
  let mut view_restored = false
  let mut url_says_hide = false
  if let Some(u) = r.URL {
    url_says_hide = u.Query().Has("hide")
  }
  // "Bare" means the URL says nothing the board can render — the same test
  // data-init used to apply to the localStorage restore. Any other URL is a
  // full view statement (TASK-94): it overrides the cookie, and the write
  // below clears or rewrites it to match. sort is an /issues dimension the
  // board drops, so it leaves a URL bare, exactly as it leaves the canonical
  // query string empty. project used to be dropped too; since LLL-523 the
  // board filters on it, so a ?project= URL is a view statement like ?label=.
  let bare = raw.state == "" && raw.assignee == "" && raw.label == "" && raw.prio == ""
    && raw.project == "" && raw.order == ""
  if !url_says_hide && bare {
    if let Some(cv) = cookie_named(r, view_cookie_name) {
      view_restored = true
      let mut decoded = cv
      if let Ok(d) = url.QueryUnescape(cv) { decoded = d }
      for h in csv(decoded) {
        if let Ok(valid) = query.state(h) { hidden = hidden.append(valid.wire()) }
      }
    }
  }
  // Card ordering (TASK-209): "manual" is the default and never a URL param,
  // so ?order=manual normalizes back to the bare URL. An unknown value flashes
  // and falls back to manual, the same contract the filters run on.
  let mut order = raw.order
  if order == "" { order = "manual" }
  if board_orders().find(|o| o == order).is_none() {
    if err == "" {
      err = f"unknown order '{raw.order}' (use one of: {strings.Join(board_orders(), ", ")})"
    }
    order = "manual"
  }
  let mut order_param = order
  if order == "manual" { order_param = "" }

  let q = ViewQuery {
    state: join_csv(states.map(|s| s.wire())),
    assignee: join_csv(assignees),
    label: join_csv(labels),
    prio: join_csv(prios),
    project: join_csv(projects),
    order: order_param,
    hide: join_csv(hidden),
    .. // `sort` is an /issues dimension; the board drops it.
  }
  let flt = BoardFilter { states, assignees, labels, prios, projects: project_ids }

  // Cookie maintenance (LLL-375). The URL's hide — including an explicit
  // empty ?hide= — always wins and rewrites the cookie; any other param'd
  // URL clears it, exactly as every navigation used to overwrite the
  // localStorage mirror (the URL is the whole view, TASK-94); a bare arrival
  // with a cookie rewrites its own value, which keeps the expiry fresh; and
  // a browser with neither cookie nor params writes nothing, so data-init's
  // one-time localStorage migration can still seed the cookie itself.
  let query_str = view_query_string(q)
  if url_says_hide || query_str != "" || view_restored {
    set_view_cookie(w, view_cookie_name, join_csv(hidden))
  }

  let issues = match records.fetch_board_issues(ctx, team_id) {
    Ok(i) => issues_for(viewer_is_scoped(viewer), i).map(|x| roster.issue(x)),
    Err(e) => {
      http.Error(w, e.message, 500)
      return
    },
  }
  let raw_mode = wants_raw(r)
  let compose = match compose_vm(ctx, team_id, roster) {
    Ok(c) => c,
    Err(e) => {
      http.Error(w, e.message, 500)
      return
    },
  }

  let mut pairs: Slice<string> = []
  for s in states { pairs = pairs.append(f"state:{s.wire()}") }
  for a in assignees { pairs = pairs.append(f"assignee:{a}") }
  for l in labels { pairs = pairs.append(f"label:{l}") }
  for p in prios { pairs = pairs.append(f"prio:{p}") }
  for p in project_ids { pairs = pairs.append(f"project:{p}") }

  let mut active = "board"
  if me != "" && assignees.contains(me) { active = "mine" }

  let held = match claims.for_team(ctx, query.TeamScope.Only(team.id)) {
    Ok(found) => found.map(|c| roster.claim(c)),
    Err(e) => { http.Error(w, e.message, 500); return },
  }
  let vm = BoardVM {
    states: state_opts(),
    columns: board_columns(issues, flt, held, order),
    filter_groups: filter_groups(
      board_base(team.key),
      issues,
      q,
      roster.members.map(|m| m.name),
      fetch_label_names(ctx, team_id).unwrap_or([]),
      records.fetch_projects(ctx, query.TeamScope.Only(team_id)).unwrap_or([]),
    ),
    flt_seed: flt_seed_js(pairs),
    query_str,
    hidden,
    hide_seed: hide_seed_js(hidden),
    hide_csv: join_csv(hidden),
    error: err,
    no_match: view_query_filtered(q) && !issues.any(|i| issue_matches(i, flt)),
    compose,
    team_key: team.key,
    team_archived: team.archived,
    view_cookie_name,
    view_restored,
    order,
    orders: order_opts(board_base(team.key), q, order),
  }
  if raw_mode {
    write_raw(w, board_raw(vm))
    return
  }
  let rail = rail_for(ctx, viewer, active, me, team)
  render_html(w, "board-page", PageVM { rail, page: vm })
}

/// The ordering picker's options (TASK-209): each is the current URL with
/// ?order= swapped — a navigation, like the filter chips, so an ordering is
/// shareable and rides the same localStorage view restore. Manual drops the
/// param: the default needs no URL to say so.
fn order_opts(base: string, q: ViewQuery, active: string) -> Slice<OrderOptVM> {
  board_orders().map(|o| {
    let mut nq = q
    nq.order = o
    if o == "manual" { nq.order = "" }
    OrderOptVM {
      value: o,
      label: state_label(o),
      href: view_query_href(base, nq),
      active: o == active,
    }
  })
}

/// The active filter as a JSON array of "dim:value" keys, seeding the card
/// data-show's $flt signal. JSON rather than string interpolation because
/// the values are member and label names: html/template escapes the
/// attribute, the browser unescapes it, and a name with an apostrophe in it
/// would otherwise land as broken JS.
fn flt_seed_js(pairs: Slice<string>) -> template.JS {
  let Ok(json_bytes) = json.Marshal(pairs) else {
    return "[]" as template.JS
  }
  let text = json_bytes as string
  text as template.JS
}

/// One `$hide_<sig> = ...` assignment per state, so the data-class on .main
/// always reads defined signals: the states hidden by ?hide= get true, the
/// rest false.
fn hide_seed_js(hidden: Slice<string>) -> template.JS {
  let mut parts: Slice<string> = []
  for s in query.states() {
    let sig = strings.ReplaceAll(s, "-", "_")
    let mut on = "false"
    if hidden.contains(s) { on = "true" }
    parts = parts.append(f"$hide_{sig} = {on};")
  }
  strings.Join(parts, " ") as template.JS
}

/// `team` is the ROUTED team (TASK-198). An issue renders only under its own
/// team's route, with its canonical key (LLL-664): /t/LLL/issue/ENG-3 and
/// /t/ENG/issue/ENG-003 redirect to /t/ENG/issue/ENG-3, so the rail, the
/// accent and every link on the page belong to the issue's team. A scoped
/// viewer who cannot see that team gets the 404 a missing issue gets.
fn issue_page(ctx: pb.Client, w: http.ResponseWriter, r: Ref<http.Request>, team: models.Team, me: string, viewer: Viewer) {
  let key = r.PathValue("key")
  let fetched = match records.fetch_issue(ctx, key) {
    Ok(i) => i,
    Err(e) => {
      http.Error(w, e.message, 404)
      return
    },
  }
  let own = fetched.expand.team.key
  let canonical = f"{own}-{fetched.number}"
  if r.PathValue("team") != own || key != canonical {
    redirect_with_query(w, r, f"/t/{own}/issue/{canonical}")
    return
  }
  let issue = issues_for(viewer_is_scoped(viewer), [fetched])[0]
  let comments = match records.fetch_comments(ctx, issue.id) {
    Ok(c) => c,
    Err(e) => {
      http.Error(w, e.message, 500)
      return
    },
  }
  // An issue is a detail view under the board, so the board row stays
  // current — which also makes the rail byte-identical to the board's.
  let roster = match read_roster(ctx) {
    Ok(found) => found,
    Err(e) => {
      http.Error(w, e.message, 500)
      return
    },
  }
  let mut page = match issue_vm(ctx, issue, comments, roster) {
    Ok(p) => p,
    Err(e) => {
      http.Error(w, e.message, 500)
      return
    },
  }
  // Related findings (TASK-103) are fetched BEFORE ?raw answers, unlike the
  // star and emoji catalogue: the raw form carries them too — "everything
  // is curl-able" includes the unprompted part. A failed fetch renders no
  // section rather than a 500 (same bargain as the rail's groups).
  page.findings = records.findings_for_issue(ctx, issue).map_or([], |f| f.map(|d| finding_vm(d, team.key)))
  // A scoped viewer claims as itself, or not at all (LLL-545): `ctx` reads
  // as the viewer, so issue_vm already named it as the claim actor.
  if !viewer_writes(viewer) { page.claim_read_only = true }
  // ?raw answers before the remaining page-only extras (star state, emoji
  // catalogue) are fetched: none of them are markdown's business. An
  // unknown key never gets here — fetch_issue already 404'd above, raw or
  // not.
  if wants_raw(r) {
    write_raw(w, issue_raw(page))
    return
  }
  if let Ok(Some(_)) = fetch_favorite(ctx, issue.id) { page.favorited = true }
  page.emojis = emoji_catalog()
  let vm = PageVM { rail: rail_for(ctx, viewer, "board", me, team), page }
  render_html(w, "issue-page", vm)
}

/// The configured team record, re-read per page load. /settings can change
/// the accent at any moment, so a value cached at startup would leave every
/// open tab on a stale colour; this is one small GET beside the fetches the
/// page already makes. A missing or unreadable team yields a blank record,
/// which renders as the canonical orange.
fn shell_team(ctx: pb.Client, team_id: models.TeamId) -> models.Team {
  let mut team = models.Team { .. }
  if team_id == "" { return team }
  let path = f"/api/collections/teams/records/{team_id}"
  if pb.fetch(ctx, path, "team", &team).is_err() { return models.Team { .. } }
  team
}
