import "records"
import "go:crypto/rand"
import "go:encoding/json"
import "go:html/template"
import "go:net/http"
import "go:strings"
import "go:time"

import "models"
import "pb"
import "query"
import "theme"
import "writes"
import "tokens"

// /settings - the workspace records the web can edit, and the one handler
// that writes them.

/// The settings sections, in nav order. The string is the URL's last
/// segment, the template's dispatch key and the nav's active marker.
///
/// LLL-446: the first three are the TEAM's own records, the last three the
/// server's, shared by every team. One scroll could not say that, and the
/// page's lede claiming it was not something anyone reads before renaming a
/// member on every board at once. The nav is the claim now.
pub fn settings_sections() -> Slice<string> {
  ["identity", "labels", "projects", "teams", "members", "access"]
}

/// One section of the settings surface. The team is the ROUTED one, so the
/// rail keeps the board you came from even while a server-wide section is
/// open — the server-wide sections are still addressed under /t/KEY/ for
/// exactly that reason (LLL-426 fixed the reverse of this bug).
fn settings_page(
  ctx: pb.Client,
  w: http.ResponseWriter,
  r: Ref<http.Request>,
  team_id: string,
  me: string,
  section: string,
) {
  if settings_sections().find(|s| s == section).is_none() {
    http.Error(
      w,
      f"no settings section '{section}'; try {strings.Join(settings_sections(), ", ")}",
      404,
    )
    return
  }
  let team = shell_team(ctx, team_id)
  let vm = match settings_vm(ctx, team, section) {
    Ok(v) => v,
    Err(e) => {
      http.Error(w, e.message, 500)
      return
    },
  }
  if wants_raw(r) {
    write_raw(w, settings_raw(vm))
    return
  }
  let page = PageVM { rail: rail_vm(ctx, "settings", me, team), page: vm }
  render_html(w, "settings-page", page)
}

/// One section's data, and only that section's.
///
/// LLL-446: this used to fetch everything on every render — a count query per
/// label AND one per team, plus members and projects, to draw a page that
/// shows one of them at a time. A section pays for itself now: opening
/// Identity costs nothing beyond the team already in hand.
fn settings_vm(ctx: pb.Client, team: models.Team, section: string) -> Result<SettingsVM, pb.CliError> {
  let hex = theme.normalize_hex(team.accent)
  let mut accent = hex
  if accent == "" { accent = "#f0883e" }
  let mut vm = SettingsVM {
    section,
    team_key: team.key,
    team_name: team.name,
    team_emoji: team.emoji,
    team_mark: theme.mark_for(team.key, team.emoji),
    accent,
    accent_set: hex != "",
    ..
  }
  match section {
    // Identity is the team record itself, which shell_team already fetched.
    "identity" => (),
    "labels" => {
      vm.labels = label_rows(ctx, team.id)?
      vm.teams = scope_rows(ctx)?
    },
    "projects" => {
      vm.projects = records.fetch_projects(ctx, team.id)?.map(|p| SetProjectVM {
        id: p.id,
        name: p.name,
        status: p.status,
      })
      vm.statuses = records.project_statuses().map(|s| StateOpt {
        value: s,
        label: state_label(s),
      })
      vm.teams = scope_rows(ctx)?
    },
    "teams" => vm.teams = team_rows(ctx)?,
    // Members stay unscoped on purpose: one person or agent works across many
    // projects, which is what makes a member meaningful on every board. Access
    // shows the same list because both its forms pick a member.
    "members" => vm.members = member_rows(ctx)?,
    "access" => vm.members = member_rows(ctx)?,
    other => return Err(pb.failed(f"unknown settings section '{other}'")),
  }
  Ok(vm)
}

fn member_rows(ctx: pb.Client) -> Result<Slice<SetMemberVM>, pb.CliError> {
  Ok(
    records.fetch_members(ctx)?.map(|m| SetMemberVM {
      id: m.id,
      name: m.name,
      email: m.email,
    }),
  )
}

/// The teams a label or project row can be MOVED to (LLL-100's select) —
/// key and archived flag only. Deliberately not `team_rows`: that one counts
/// issues per team, and a select showing six keys has no use for six count
/// queries.
fn scope_rows(ctx: pb.Client) -> Result<Slice<SetTeamVM>, pb.CliError> {
  Ok(
    records.list_teams(ctx)?.items.map(|t| SetTeamVM {
      id: t.id,
      key: t.key,
      name: t.name,
      archived: t.archived,
      ..
    }),
  )
}

/// The Teams section's rows (TASK-210): every team on the server, archived
/// ones included — this is the one web surface an archived team stays
/// visible on, which is what makes unarchiving from here possible. One
/// perPage=1 count fetch per team, paid per settings render like the
/// section's other fetches.
fn team_rows(ctx: pb.Client) -> Result<Slice<SetTeamVM>, pb.CliError> {
  let mut rows: Slice<SetTeamVM> = []
  for t in records.list_teams(ctx)?.items {
    let held = records.issue_count(ctx, f"team={query.quote(t.id)}")?
    rows = rows.append(
      SetTeamVM {
        id: t.id,
        key: t.key,
        name: t.name,
        issues: held,
        issues_text: issue_count_text(held),
        archived: t.archived,
      },
    )
  }
  Ok(rows)
}


/// The Labels section's rows (TASK-208): each label with how many issues
/// carry it, busiest first. One perPage=1 count fetch per label — the same
/// per-row price the Teams section pays, per settings render. Usage-descending
/// order is what makes the inventory readable as "what this team actually
/// uses", so a near-duplicate (bug/bugs/defect) is visible next to the label
/// it duplicates before someone creates another one.
fn label_rows(ctx: pb.Client, team_id: string) -> Result<Slice<SetLabelVM>, pb.CliError> {
  let mut rows: Slice<SetLabelVM> = []
  // fetch_labels answers name-sorted; the strict > below keeps equal-usage
  // rows in that order, so ties stay alphabetical.
  for l in records.fetch_labels(ctx, team_id)? {
    let used = records.entity_issue_count(ctx, "label", l.id)?
    let row = SetLabelVM {
      id: l.id,
      name: l.name,
      color: theme.normalize_hex(l.color),
      usage: used,
      usage_text: issue_count_text(used),
    }
    let mut sorted: Slice<SetLabelVM> = []
    let mut placed = false
    for r in rows {
      if !placed && row.usage > r.usage {
        sorted = sorted.append(row)
        placed = true
      }
      sorted = sorted.append(r)
    }
    if !placed { sorted = sorted.append(row) }
    rows = sorted
  }
  Ok(rows)
}


/// One write for every settings section: `kind` picks the section, an `id`
/// picks update over create, and `?del=1` picks removal.
///
/// The reply is the action's own SSE body — /settings opens no /events
/// connection at all. The bridge broadcasts one unfiltered #board to every
/// board-scoped client, so a settings page on that scope would have to defend
/// against fragments meant for a different view; answering in the response
/// needs no defence, and the page has no realtime story to get wrong.
///
/// The redrawn page rides back as `flashing`'s extra SSE, after the cleared
/// flash. A fragment that fails to render is dropped rather than failed on:
/// the record is already written, and a flash saying otherwise would be a
/// lie about the database.
fn settings_write(
  ctx: pb.Client,
  r: mut Ref<http.Request>,
  team_id: string,
  me: string,
) -> Result<string, pb.CliError> {
  if r.FormValue("cancel") != "" {
    // Restore the row after a deletion review without writing a record.
  } else if r.FormValue("del") != "" {
    if let Some(review) = settings_delete(ctx, r, team_id)? { return Ok(review) }
  } else {
    settings_apply(ctx, r, team_id)?
  }
  let team = shell_team(ctx, team_id)
  let mut extra = ""
  let mut nav = ""
  // The reply redraws the section the row belongs to, which is the section
  // the browser is looking at: #settings is the section wrapper now, so the
  // patch id is unchanged and a label save still cannot redraw the members
  // list it is not showing.
  if let Ok(vm) = settings_vm(ctx, team, section_of(r.PathValue("kind"))) {
    if let Ok(html) = render("settings", vm) { extra += patch_event(html) }
    if let Ok(html) = render("settings-nav", vm) { nav = patch_event(html) }
  }
  // The accent lives in <head> and the team's mark on the section nav, both
  // outside #settings: patch them by id too, so a new colour or emoji lands
  // on the open page instead of waiting for a reload.
  if let Ok(html) = render("accent-head", rail_vm(ctx, "settings", me, team)) {
    extra += patch_event(html)
  }
  extra += nav
  Ok(extra)
}

/// The section a written row lives in — the write's `kind` is singular and
/// the section plural, and this is the only place that translation happens.
fn section_of(kind: string) -> string {
  match kind {
    "team" => "identity",
    "label" => "labels",
    "project" => "projects",
    "member" => "members",
    // A write whose kind is not a section has already failed in
    // settings_apply; redrawing identity costs one render of data in hand.
    _ => "identity",
  }
}

/// Create or update the record this request names.
fn settings_apply(
  ctx: pb.Client,
  r: mut Ref<http.Request>,
  team_id: string,
) -> Result<(), pb.CliError> {
  let kind = r.PathValue("kind")
  let id = strings.TrimSpace(r.PostFormValue("id"))
  let name = strings.TrimSpace(r.PostFormValue("name"))

  // Labels and projects are team-owned, just like the team section.
  if team_id == "" {
    return Err(pb.failed("no team configured: set LLL_TEAM or 'team' in .lll.toml"))
  }

  match kind {
    "team" => {
      if name == "" { return Err(pb.failed("team name is required")) }
      let accent = form_hex(r, "accent")?
      // Validated with the CLI's rule, not the browser's: a maxlength on the
      // input is a hint, and this is the same field `lll team set-emoji`
      // writes.
      let emoji = records.team_emoji_value(r.PostFormValue("emoji"))?
      writes.update_team(ctx, pb.Caller.Process, team_id, writes.TeamPatch {
        name: Some(name),
        accent: Some(accent),
        emoji: Some(emoji),
        ..
      })
    },
    "label" => {
      if name == "" { return Err(pb.failed("label name is required")) }
      records.check_filter_name("label", name)?
      let color = form_hex(r, "color")?
      // LLL-100: the row's team select. The move runs FIRST and may refuse,
      // so a rejected move leaves the name and colour untouched too - one
      // submit is one outcome. `owner` is where the record ends up, so the
      // patch below cannot drag it back to the page's team.
      let owner = move_scope_if_asked(ctx, r, "label", name, id, team_id)?
      if id == "" {
        let _ = writes.create_label(ctx, models.NewLabel { name, color, team: owner })?
        return Ok(())
      }
      writes.update_label(ctx, id, writes.LabelPatch { name: Some(name), color: Some(color), team: Some(owner) })
    },
    "member" => {
      if name == "" { return Err(pb.failed("member name is required")) }
      let email = strings.TrimSpace(r.PostFormValue("email"))
      if id == "" {
        // members is an auth collection (TASK-180): a create needs an email
        // identity and a password. The synthesized identity and the random
        // never-shown password are the same bargain the CLI's member add
        // runs; nobody can log in as one until a password is set.
        let member_email = if email == "" {
          records.synthesize_email(name)
        } else {
          email
        }
        // One value for both password fields: two rand.Text() calls would
        // disagree with each other and fail PB's confirm check.
        let password = rand.Text()
        let _ = writes.create_member(ctx, pb.Caller.Process, models.NewMember {
          name,
          email: member_email,
          password,
          password_confirm: password,
          email_visibility: true,
          ..
        })?
        return Ok(())
      }
      let known = records.fetch_members(ctx)?
      let Some(existing) = known.find(|m| m.id == id) else {
        return Err(
          pb.failed(f"unknown member '{id}'; reload the page for the current list"),
        )
      }
      // Email is the member's login identity now (TASK-180): PocketBase
      // refuses an email change on an auth record without its password, so
      // this row rejects an email change before saving either field.
      let posted_email = strings.TrimSpace(email)
      if posted_email != "" && posted_email != existing.email {
        return Err(
          pb.failed(f"'{existing.name}'s email is their login identity; change it under Access → Member sign-in. No changes saved."),
        )
      }
      writes.update_member(ctx, pb.Caller.Process, id, writes.MemberPatch { name: Some(name), .. })
    },
    "project" => {
      if name == "" { return Err(pb.failed("project name is required")) }
      records.check_filter_name("project", name)?
      let status = r.PostFormValue("status")
      if records.project_statuses().find(|s| s == status).is_none() {
        return Err(pb.failed(f"unknown project status '{status}'"))
      }
      let owner = move_scope_if_asked(ctx, r, "project", name, id, team_id)?
      if id == "" {
        let new_project = models.NewProject { name, description: "", status, team: owner }
        let _ = writes.create_project(ctx, new_project)?
        return Ok(())
      }
      writes.update_project(ctx, id, writes.ProjectPatch { name: Some(name), description: None, status: Some(status), team: Some(owner) })
    },
    other => Err(pb.failed(f"unknown settings section '{other}'")),
  }
}

/// A "#rrggbb" form field: "" clears the colour, anything unparseable is a
/// user error rather than a silent fallback — a typed hex that quietly did
/// nothing would be the worst of both.
fn form_hex(r: mut Ref<http.Request>, field: string) -> Result<string, pb.CliError> {
  let raw = strings.TrimSpace(r.PostFormValue(field))
  if raw == "" { return Ok("") }
  let hex = theme.normalize_hex(raw)
  if hex == "" { return Err(pb.failed(f"'{raw}' is not a #rrggbb colour")) }
  // The canonical orange is stored as "no choice", so a team that picks it
  // back gets theme.css's exact tokens instead of a derived copy of them.
  if field == "accent" && hex == "#f0883e" { return Ok("") }
  Ok(hex)
}

/// Sections whose rows can be deleted. The team is not one: it owns every
/// issue's key, and `lll team` has no delete either.
fn settings_collection(kind: string) -> Result<string, pb.CliError> {
  match kind {
    "label" => Ok("labels"),
    "member" => Ok("members"),
    "project" => Ok("projects"),
    other => Err(pb.failed(f"cannot delete from '{other}'")),
  }
}

/// Create (no id) or update (id) one record.
/// LLL-100: the settings row's team select, applied before anything else the
/// row asked for. Returns the team the record should END UP in, so the caller's
/// patch writes the destination rather than dragging it back.
///
/// A create (no id) has nothing to move: the row's team select is the team the
/// new record is born in, which `team_id` already is.
///
/// The refusal rule lives in writes/moves.lis and is the CLI's, so the board and
/// `lll label move` cannot answer differently - one rule, two doors.
fn move_scope_if_asked(
  ctx: pb.Client,
  r: mut Ref<http.Request>,
  kind: string,
  name: string,
  id: string,
  team_id: string,
) -> Result<string, pb.CliError> {
  let wanted = strings.TrimSpace(r.PostFormValue("team"))
  if id == "" || wanted == "" { return Ok(team_id) }
  let to = writes.move_destination(ctx, wanted)?
  if to.id == team_id { return Ok(team_id) }
  let from = shell_team(ctx, team_id)
  let _ = writes.move_to_team(ctx, kind, name, id, from, to)?
  Ok(to.id)
}

/// A request body for the Access actions' credential endpoints.
fn marshal(value: Unknown) -> Result<string, pb.CliError> {
  match json.Marshal(value) {
    Ok(p) => Ok(p as string),
    Err(e) => Err(pb.failed(f"encoding request: {e}")),
  }
}

// ── Access (TASK-204) ────────────────────────────────────────────────────
// The settings page is reachable with the board token alone, but minting an
// agent token and credentialing a member are superuser-power actions — the
// server's own PocketBase identity rides the superuser token, so answering
// these on the board token would promote every board-token holder to admin.
// DECISION (per-action re-auth): each Access form carries the admin password,
// verified server-side through PocketBase's own _superusers auth-with-password
// endpoint per request; the token that auth answers with is what rides the
// write, and the password itself is never stored. A separate admin session
// was the alternative — rejected because a session is a second credential
// store to build, expire and steal, while re-auth adds one form field and
// leaves nothing behind.

/// The one-shown-once token, as the mint action's response patch.
pub struct AccessTokenVM {
  pub name: string,
  pub token: string,
}

/// PATCH body for credentialing a member: the login identity and the
/// password pair, nothing else — PB replaces every field it is handed.
/// The superuser identity Access actions verify against: LLL_ADMIN_EMAIL, or
/// the same printed default `lll up` upserts when the env is unset.
fn admin_email(ctx: pb.Client) -> string {
  ctx.settings.admin().map_or("admin@local.dev", |admin| admin.email)
}

/// Verify the form's admin password against the superuser and return the
/// superuser token that verification minted — the credential the action's
/// own write rides, so board token + admin password suffices no matter what
/// identity the process holds. The password is checked per action through
/// PocketBase's own endpoint and never stored.
fn verify_admin(ctx: pb.Client, pass: string) -> Result<string, pb.CliError> {
  if pass == "" {
    return Err(
      pb.failed("the admin password is required: this is a superuser action, and the board token alone must not grant it"),
    )
  }
  let payload = marshal(models.AuthRequest { identity: admin_email(ctx), password: pass })?
  let body = match ctx.post_anon(
    "/api/collections/_superusers/auth-with-password",
    payload,
  ) {
    Ok(b) => b,
    Err(e) => return Err(admin_verification_error(ctx, e)),
  }
  tokens.decode_auth(body, "the superuser auth response")
}

/// Authentication failures have a specific recovery; other errors retain
/// their actual server status and transport details.
pub fn admin_verification_error(ctx: pb.Client, e: pb.CliError) -> pb.CliError {
  if e.status == 400 {
    return pb.failed(f"wrong admin password for {admin_email(ctx)}; use the administrator credentials supplied through LLL_ADMIN_EMAIL and LLL_ADMIN_PASSWORD in the server's own environment")
  }
  e.with_message(f"verifying the admin password: {e.message}")
}

/// The named member, from the current list — so the flash can say "reload"
/// instead of relaying a PB 404.
fn access_member(ctx: pb.Client, r: mut Ref<http.Request>) -> Result<models.Member, pb.CliError> {
  let id = strings.TrimSpace(r.PostFormValue("member"))
  if id == "" { return Err(pb.failed("pick a member")) }
  let known = records.fetch_members(ctx)?
  let Some(member) = known.find(|m| m.id == id) else {
    return Err(pb.failed(f"unknown member '{id}'; reload the page for the current list"))
  }
  Ok(member)
}

/// Mint an agent token for a member — the web face of `lll token create`.
/// The token rides back in the response patch and is shown exactly once:
/// impersonate tokens are stateless (nothing records a mint), so no list of
/// minted tokens exists to show, here or anywhere.
///
/// TASK-219: this was the second door onto TASK-214's bug. The CLI stopped
/// minting with duration 0 — which hands the lifetime to the members
/// collection, five days out of the box — but the Access panel kept doing it,
/// so a token minted from the board still died in under a week, silently. It
/// borrows the CLI's `default_token_duration` rather than restating a year in
/// seconds: two doors onto one mint should not be able to drift apart.
fn access_token_write(ctx: pb.Client, _v: Viewing, r: mut Ref<http.Request>) -> Result<string, pb.CliError> {
  let member = access_member(ctx, r)?
  let su = verify_admin(ctx, r.PostFormValue("admin_password"))?
  let body = ctx.post_as(
    f"/api/collections/members/impersonate/{member.id}",
    mint_payload()?,
    su,
  )?
  let tok = tokens.decode_auth(body, "the impersonate response")?
  let html = render(
    "access-token-result",
    AccessTokenVM { name: member.name, token: tok },
  )?
  Ok(patch_event(html) + mint_expiry_event(time.Now()))
}

/// The impersonate request body the Access mint sends, duration included.
/// The lifetime is chosen here rather than at the call site so a test can
/// read the number that actually reaches PocketBase — the whole bug was a
/// duration nobody could see without watching the wire.
fn mint_payload() -> Result<string, pb.CliError> {
  marshal(models.ImpersonateRequest { duration: tokens.default_token_duration() })
}

/// The expiry the mint says out loud, as the flash that rides after the token
/// patch. It goes on the strip rather than into the token block for the same
/// reason the CLI prints it next to the token: this is the only moment anyone
/// sees it, since impersonate tokens are stateless and nothing records a mint.
/// `now` is a parameter so the wording is a function of its arguments alone.
fn mint_expiry_event(now: time.Time) -> string {
  flash_ok_event(tokens.expiry_line(tokens.default_token_duration(), now, "lll token create"))
}

/// Give a member a login credential (email + password) — the admin
/// counterpart of the CLI's honor-system member row. The email is the login
/// identity, so this is the one place the web may change it: the write rides
/// the just-verified superuser token, which is exactly the authority the
/// settings row's rename lacks.
fn access_credential_write(
  ctx: pb.Client,
  r: mut Ref<http.Request>,
  team_id: string,
) -> Result<string, pb.CliError> {
  let member = access_member(ctx, r)?
  let password = r.PostFormValue("password")
  if password == "" { return Err(pb.failed("a password is required")) }
  if password != r.PostFormValue("password_confirm") {
    return Err(pb.failed("the two passwords do not match"))
  }
  let su = verify_admin(ctx, r.PostFormValue("admin_password"))?
  // A blank email keeps the member's current identity (often the
  // synthesized @members.invalid one) and just sets the password.
  let mut email = strings.TrimSpace(r.PostFormValue("email"))
  if email == "" { email = member.email }
  let credential = writes.MemberPatch {
    email: Some(email),
    password: Some(password),
    password_confirm: Some(password),
    ..
  }
  writes.update_member(ctx, pb.Caller.Member(su), member.id, credential)?
  // The Access section shows the member's email, so patch that section back
  // — and say the success out loud in the flash strip, after the redraw, so
  // the morph cannot swallow it.
  let mut extra = ""
  if let Ok(vm) = settings_vm(ctx, shell_team(ctx, team_id), "access") {
    if let Ok(html) = render("settings", vm) { extra += patch_event(html) }
  }
  extra += flash_ok_event(f"{member.name} can now sign in as {email}")
  Ok(extra)
}

/// A green flash: the same strip errors use, patched with a success tone.
/// Rides AFTER flashing's flash_clear in the response body, so the strip
/// ends up showing the message.
fn flash_ok_event(msg: string) -> string {
  let safe = template.HTMLEscapeString(msg)
  patch_event(f"<div id=\"flash\" class=\"flash flash-ok\" role=\"status\" aria-atomic=\"true\">{safe}</div>")
}

// ── Teams (TASK-210) ─────────────────────────────────────────────────────
// Archive / unarchive from the web. DECISION: the same per-action admin
// re-auth as Access, for the same reason — /settings is reachable with the
// board token alone, and while archiving deletes nothing, it removes a team
// from every list and rail on the server (destructive-adjacent). The form
// carries the admin password, verified server-side per request; the write
// rides the superuser token that verification minted, never the board token.

/// Archive or unarchive one team from the settings page. `archived=1`
/// archives, anything else unarchives — the row's form posts the state it
/// wants, so a stale page converges instead of toggling blind.
fn teams_archive_write(
  ctx: pb.Client,
  r: mut Ref<http.Request>,
  team_id: string,
) -> Result<string, pb.CliError> {
  let id = strings.TrimSpace(r.PostFormValue("id"))
  if id == "" { return Err(pb.failed("pick a team")) }
  let known = records.list_teams(ctx)?
  let Some(t) = known.items.find(|x| x.id == id) else {
    return Err(pb.failed("unknown team; reload the page for the current list"))
  }
  let archived = r.PostFormValue("archived") == "1"
  let su = verify_admin(ctx, r.PostFormValue("admin_password"))?
  writes.update_team(ctx, pb.Caller.Member(su), id, writes.TeamPatch { archived: Some(archived), .. })?
  // The page shows the row's state, so patch the Teams section back and say
  // the success out loud — same shape as access_credential_write.
  let mut extra = ""
  if let Ok(vm) = settings_vm(ctx, shell_team(ctx, team_id), "teams") {
    if let Ok(html) = render("settings", vm) { extra += patch_event(html) }
  }
  let mut msg = f"team {t.key} archived; its board stays readable at /t/{t.key}/"
  if !archived { msg = f"team {t.key} unarchived" }
  extra += flash_ok_event(msg)
  Ok(extra)
}
