import "go:fmt"
import "go:github.com/escherize/lll/gopb"
import "go:github.com/escherize/lll/web"
import "go:net"
import "go:net/http"
import "go:net/url"
import "go:strconv"
import "go:strings"

import "config"
import "models"
import "pb"
import "realtime"
import "records"

// The web board — a server-rendered board with realtime updates, started by
// `lll up`.
//
// Architecture: browsers hold ONE SSE connection to /events. The server holds
// one unfiltered (team-scoped at most) PB realtime subscription to issues +
// comments; on any event it re-renders the affected fragments and broadcasts
// them as datastar-patch-elements SSE events, which Datastar morphs into the
// DOM by element id. Actions (@post) write to PB and return 204 — the UI
// updates via the same broadcast as CLI-driven changes, so there is no
// swap-on-POST double-update race.
//
// Templates and static assets are compiled into the binary (see web/embed.go),
// so the board serves from any working directory. Markup edits need a rebuild:
// edit, `mise run dev`, refresh.

/// Start the board server on `port`. The board is `lll up`'s web half.
///
/// `refresh` re-mints the process's PocketBase token after an auth-shaped
/// realtime reconnect failure (the boot passes its superuser credentials'
/// minter when it owns the token; None when the caller brought a member
/// token the process cannot renew). See realtime.subscribe.
/// A concrete bind address is also the address a teammate can open. Wildcard
/// binds (used by hosted reverse proxies) have no client URL of their own.
/// The address is the settings' bind (TASK-171: LLL_BIND, default
/// 127.0.0.1; a container deploy sets 0.0.0.0).
pub fn advertised_board_url(settings: config.Settings, port: int) -> string {
  let bind = settings.bind()
  let host = if bind == "0.0.0.0" || bind == "::" { "127.0.0.1" } else { bind }
  f"http://{net.JoinHostPort(host, strconv.Itoa(port))}"
}

/// Serve PocketBase's own routes from the board's port, so the API and the
/// board share one address (TASK-241).
///
/// `base` is where PocketBase actually listens - the same url the pb client
/// and the CLI use, which `lll up` set to its in-process server. Proxying to
/// it rather than reaching into PocketBase directly keeps ONE data path: the
/// board, the CLI and a remote agent all go through the same endpoints under
/// the same collection rules, which is the property TASK-114 and TASK-131
/// were both about.
///
/// UNGATED, deliberately. Every other route requires the board-token cookie
/// (serve/gate.lis); these do not, because PocketBase's per-collection rules
/// are the authorization here and they are the same rules that answered on
/// :8091 before this existed. So this is a MOVE, not a widening: the same
/// requests reach the same checks at a different address, and an agent's
/// LLL_TOKEN keeps working untouched. Gating it behind the board cookie would
/// instead BREAK every non-browser caller, since none of them has one.
///
/// The port was never the boundary. Anyone who could reach :8091 could always
/// reach these routes; all that changes is that they no longer have to guess
/// a port number to do it.
fn api_proxy(
  mux: mut Ref<http.ServeMux>,
  base: string,
  admin_ui: bool,
) -> Result<(), pb.CliError> {
  let Ok(target) = url.Parse(base) else {
    return Err(pb.failed(f"cannot proxy the API: '{base}' is not a url"))
  }
  // LLL-676: the proxy presents the API's own host upstream, so a loopback
  // API answers what a LAN board forwards (gopb.NewAPIProxy).
  let proxy = gopb.NewAPIProxy(target)
  // /api/ is the REST surface every client speaks. The administration UI
  // shares that upstream only when the operator explicitly enables it.
  mux.HandleFunc("GET /.well-known/lll", board_discovery)
  mux.Handle("/api/", proxy)
  if admin_ui {
    mux.Handle("/_/", proxy)
  } else {
    for path in ["/_", "/_/"] {
      mux.HandleFunc(path, http.NotFound)
    }
  }
  Ok(())
}

pub fn run_server(
  ctx: pb.Client,
  port: int,
  refresh: Option<fn() -> Result<string, pb.CliError>>,
  admin_ui: bool,
) -> Result<(), pb.CliError> {
  // `lll up` resolved the gate's token (generated when unset) into these
  // settings before any request could arrive, so the handlers and the
  // banner below agree.
  let board_tok = ctx.settings.board_token()
  let Some(board_member) = records.find_actor(ctx)? else {
    return Err(pb.failed("the board needs a member token; start it with lll up"))
  }
  // The BOOT team (TASK-198): the server hosts every team — the board views
  // one per URL under /t/KEY/ — and the configured team is only where the
  // bare / redirect and the compatibility routes land. `lll up` (the one
  // caller) has already settled a team, so a missing one here is a real
  // misconfiguration, not the old "unscoped board".
  let Some(boot) = records.configured_team(ctx)? else {
    return Err(records.no_team())
  }

  // Fail fast on broken templates before accepting connections — both
  // pages, because they share the rail and a typo in it breaks every page.
  let shell = rail_vm(ctx, "board", board_member.name, models.Team { .. })
  let _ = render(
    "board-page",
    PageVM {
      rail: shell,
      page: BoardVM { states: state_opts(), columns: [], .. },
    },
  )?
  let _ = render("issue-page", PageVM { rail: shell, page: IssueVM { .. } })?
  let _ = render("issues-page", PageVM { rail: shell, page: IssuesVM { .. } })?
  // Every settings section, because each is its own template block and a
  // typo in one would otherwise wait for someone to click that nav row.
  for section in settings_sections() {
    let _ = render(
      "settings-page",
      PageVM { rail: shell, page: SettingsVM { section, .. } },
    )?
  }
  let _ = render("search-page", PageVM { rail: shell, page: SearchVM { .. } })?
  let _ = render(
    "projects-page",
    PageVM { rail: shell, page: ProjectsVM { .. } },
  )?
  let _ = render("doc-page", PageVM { rail: shell, page: DocVM { .. } })?
  let _ = render("docs-page", PageVM { rail: shell, page: DocsVM { .. } })?

  // One PB subscription for everything. Issues are UNSCOPED (TASK-198): the
  // server hosts every team, and the bridge routes each event to the clients
  // viewing that record's team ("board:KEY" scopes). Never state-filtered
  // either: PB emits nothing when an update moves a record out of a
  // subscription filter, so filtered board columns would go stale.
  let issues_topic = realtime.topic_with_options(
    "issues",
    "",
    "team,assignee,labels,project",
  )?
  let comments_topic = realtime.topic_with_options("comments", "", "author")?
  // Favorites and saved views drive their own rail groups, which every
  // page shows, so these topics are unfiltered too.
  let on_dead_token = refresh.map_or(
    realtime.DeadToken.Retry,
    |mint| realtime.DeadToken.Remint(mint),
  )
  let events = realtime.subscribe_resyncing(
    ctx,
    [issues_topic, comments_topic, "claims", "favorites", "views"],
    on_dead_token,
  )?

  let hub = new_hub()
  task {
    bridge(ctx, events, hub)
  }

  let mux = board_mux(ctx, boot, hub, board_member, admin_ui)?

  // Bind BEFORE announcing: "board <url>" is the promise that the board is
  // accepting connections, and e2e_web.sh curls the URL the moment the line
  // is printed — announcing before the listen made that a race that fast
  // runners lose (CI run 33343854995).
  // LLL_BIND (default 127.0.0.1): inside a container the proxy can only
  // reach a loopback bind from outside it, so deploys set 0.0.0.0 — and a
  // laptop keeps its default, which is how it avoids serving the internet.
  let bind = ctx.settings.bind()
  let listener = match net.Listen("tcp", f"{bind}:{port}") {
    Ok(l) => l,
    Err(e) => return Err(pb.failed(f"server: {e}")),
  }
  let board_url = advertised_board_url(ctx.settings, port)
  fmt.Println(f"board  {board_url}")
  if admin_ui { fmt.Println(f"admin  {board_url}/_/ (enabled by --admin-ui)") }
  fmt.Println(
    f"board  login {board_url}/?board_token={board_tok} (sets a cookie; LLL_BOARD_TOKEN pins it)",
  )
  // LLL-676: a loopback board answers only loopback Host names, which
  // refuses DNS-rebinding pages (the API listener checks the same).
  match http.Serve(listener, gopb.LoopbackHostGuard(bind, mux)) {
    Ok(_) => Ok(()),
    Err(e) => Err(pb.failed(f"server: {e}")),
  }
}

/// Construct an independent router. Runtime I/O (configuration, listener and
/// realtime subscription) belongs to run_server, not route registration.
fn board_mux(
  ctx: pb.Client,
  boot: models.Team,
  hub: Hub,
  board_member: records.Actor,
  admin_ui: bool,
) -> Result<http.Handler, pb.CliError> {
  let mut mux: mut Ref<http.ServeMux> = http.NewServeMux()
  let boot_key = boot.key
  // TASK-241: the API answers here too, so there is ONE address. The hosted
  // deployment used to split them - the board on 443, PocketBase on :8091 -
  // and the port was invisible: a user who set url to the board host got a
  // bare "404 page not found" from a host that answers, which is TASK-213 and
  // cost a real debugging loop. Fly needed a dedicated IPv4 to make :8091
  // reachable at all (TASK-201, which listed this proxy as the alternative it
  // deferred rather than rejected).
  //
  // Registered FIRST so the board's own routes cannot shadow /api/.
  api_proxy(mux, ctx.url()?, admin_ui)?
  // Invite links (LLL-544) sit outside the gate: the visitor has no board
  // credential until the redemption hands it one (serve/join.lis).
  mux.HandleFunc("GET /join/{code}", |w: http.ResponseWriter, r: Ref<http.Request>| join_page(ctx, w, r))
  mux.HandleFunc("POST /join/{code}", |w: http.ResponseWriter, r: Ref<http.Request>| join_redeem(ctx, w, r))
  // A member's own page and CLI login (LLL-648), where a join lands. Gated:
  // it answers the cookie the join just set.
  mux.HandleFunc("GET /me", gated(ctx, |w: http.ResponseWriter, r: Ref<http.Request>, v: Viewing| me_page(ctx, w, r, v.viewer)))
  mux.HandleFunc("POST /me", gated(ctx, |w: http.ResponseWriter, r: Ref<http.Request>, v: Viewing| me_cli(ctx, w, r, v.viewer)))
  //
  // Every BOARD route sits behind the board gate (serve/gate.lis): pages,
  // writes, the SSE stream and static assets alike answer only board-token
  // requests. /api/ stays outside that cookie gate for remote clients.
  // /_/ is registered only with --admin-ui and keeps upstream admin auth.
  //
  // The board, its issue pages and its search live under /t/KEY/ (TASK-198):
  // one server, every team, each team's board a shareable URL. The bare
  // legacy paths stay as redirects — bookmarks, the CLI's printed URLs and
  // the rail's favorites all speak them — landing on the boot team (or, for
  // an issue, on the team its key names).
  // The sign-in confirm page's POST (LLL-545). Ungated: it carries the
  // credential itself and checks Origin before setting any cookie.
  mux.HandleFunc("POST /login", |w: http.ResponseWriter, r: Ref<http.Request>| board_login(ctx, w, r))
  mux.HandleFunc(
    "GET /{$}",
    gated(ctx, |w: http.ResponseWriter, r: Ref<http.Request>, _v: Viewing| {
      redirect_with_query(w, r, f"/t/{boot_key}/")
    }),
  )
  mux.HandleFunc(
    "GET /t/{team}",
    gated(ctx, |w: http.ResponseWriter, r: Ref<http.Request>, v: Viewing| {
      // Read as the viewer first (LLL-658): a team it cannot see answers 404
      // here, as a missing one does, rather than redirecting.
      if let Some(_) = routed_team(v.reads, w, r) {
        redirect_with_query(w, r, f"/t/{r.PathValue("team")}/")
      }
    }),
  )
  mux.HandleFunc(
    "GET /t/{team}/{$}",
    gated(ctx, |w: http.ResponseWriter, r: Ref<http.Request>, v: Viewing| {
      if let Some(t) = routed_team(v.reads, w, r) {
        board_page(v.reads, w, r, t, board_member.name, v.viewer)
      }
    }),
  )
  mux.HandleFunc(
    "GET /t/{team}/issue/{key}",
    gated(ctx, |w: http.ResponseWriter, r: Ref<http.Request>, v: Viewing| {
      if let Some(t) = routed_team(v.reads, w, r) {
        issue_page(v.reads, w, r, t, board_member.name, v.viewer)
      }
    }),
  )
  // LLL-405: a doc's address. Team-routed like the board and issue pages,
  // because slugs are unique PER TEAM, not per server - GRDN and LLL both
  // get an `index`, so a bare /doc/SLUG cannot name one record.
  mux.HandleFunc(
    "GET /t/{team}/doc/{slug}",
    gated(ctx, |w: http.ResponseWriter, r: Ref<http.Request>, v: Viewing| {
      if let Some(t) = routed_team(v.reads, w, r) {
        doc_page(v.reads, w, r, t, board_member.name, v.viewer)
      }
    }),
  )
  // LLL-643: the team's docs, each row linking to the address above.
  mux.HandleFunc(
    "GET /t/{team}/docs",
    gated(ctx, |w: http.ResponseWriter, r: Ref<http.Request>, v: Viewing| {
      if let Some(t) = routed_team(v.reads, w, r) {
        docs_page(v.reads, w, r, t, board_member.name, v.viewer)
      }
    }),
  )
  mux.HandleFunc(
    "GET /t/{team}/search",
    gated(ctx, |w: http.ResponseWriter, r: Ref<http.Request>, v: Viewing| {
      if let Some(t) = routed_team(v.reads, w, r) {
        search_page(v.reads, w, r, t, board_member.name, v.viewer)
      }
    }),
  )
  // LLL-426: the table, the projects list and settings answer for the team in
  // the URL, like the board and the issue pages. They used to take the
  // CONFIGURED team, so on a multi-team server they showed the boot team's
  // data whichever board you came from - and settings, being the only surface
  // that edits a team's name and accent, made every other team uneditable.
  mux.HandleFunc(
    "GET /t/{team}/issues",
    gated(ctx, |w: http.ResponseWriter, r: Ref<http.Request>, v: Viewing| {
      if let Some(t) = routed_team(v.reads, w, r) {
        issues_page(v.reads, w, r, t.id, board_member.name, v.viewer)
      }
    }),
  )
  mux.HandleFunc(
    "GET /t/{team}/projects",
    gated(ctx, |w: http.ResponseWriter, r: Ref<http.Request>, v: Viewing| {
      if let Some(t) = routed_team(v.reads, w, r) {
        projects_page(v.reads, w, r, t.id, board_member.name, v.viewer)
      }
    }),
  )
  // LLL-446: settings is six sections with six addresses, so a render fetches
  // what it shows and a link can name a section. The bare path is the first
  // one — someone arriving from the rail wants the team they are standing in.
  mux.HandleFunc(
    "GET /t/{team}/settings",
    gated(ctx, |w: http.ResponseWriter, r: Ref<http.Request>, _v: Viewing| {
      redirect_with_query(w, r, f"/t/{r.PathValue("team")}/settings/identity")
    }),
  )
  // The server-wide sections (teams, members, access) are routed under a team
  // like the rest: their SCOPE is the server, but the page still has a rail,
  // and a rail that quietly switched teams is the bug LLL-426 fixed.
  mux.HandleFunc(
    "GET /t/{team}/settings/{section}",
    gated(ctx, |w: http.ResponseWriter, r: Ref<http.Request>, v: Viewing| {
      if let Some(t) = routed_team(v.reads, w, r) {
        settings_page(v.reads, w, r, t.id, board_member.name, r.PathValue("section"))
      }
    }),
  )
  // The team-scoped writes ride the same path as the page that made them, so
  // a form on team B's settings cannot write team A. The server-wide actions
  // (member sign-in, team archiving) ride it too (LLL-664): what they write
  // is the server's, but the section they redraw is the page's team.
  mux.HandleFunc(
    "POST /t/{team}/settings/{kind}",
    gated(ctx, flashing(ctx, |_ctx: pb.Client, _v: Viewing, r: mut Ref<http.Request>| settings_write(ctx,
      r,
      routed_team_id(ctx, r)?,
      board_member.name,
    ))),
  )
  mux.HandleFunc(
    "POST /t/{team}/settings/access/member",
    gated(ctx, flashing(ctx, |_ctx: pb.Client, _v: Viewing, r: mut Ref<http.Request>| access_credential_write(ctx,
      r,
      routed_team_id(ctx, r)?,
    ))),
  )
  mux.HandleFunc(
    "POST /t/{team}/settings/teams/archive",
    gated(ctx, flashing(ctx, |_ctx: pb.Client, _v: Viewing, r: mut Ref<http.Request>| teams_archive_write(ctx,
      r,
      routed_team_id(ctx, r)?,
    ))),
  )
  // The bare paths stay as redirects onto the configured team, the same
  // compatibility `/` and `/issue/{key}` make: bookmarks, printed URLs and
  // anything that learned them keep working.
  mux.HandleFunc(
    "GET /issues",
    gated(ctx, |w: http.ResponseWriter, r: Ref<http.Request>, _v: Viewing| {
      redirect_with_query(w, r, f"/t/{boot_key}/issues")
    }),
  )
  mux.HandleFunc(
    "GET /issue/{key}",
    gated(ctx, |w: http.ResponseWriter, r: Ref<http.Request>, v: Viewing| {
      // The issue key names its own team (ENG-3 -> ENG), so the canonical
      // team-routed URL needs no lookup; an unknown key 404s over there. A
      // key that does not parse 404s here instead of borrowing the boot team.
      let key = r.PathValue("key")
      let Ok((tk, _)) = records.split_issue_key(key) else {
        http.Error(w, records.issue_not_found(key), 404)
        return
      }
      // A scoped viewer's read decides first (LLL-658): an issue it cannot
      // see answers 404 here, as a missing one does.
      if let Viewer.Scoped(_) = v.viewer {
        if records.fetch_issue(v.reads, key).is_err() {
          http.Error(w, records.issue_not_found(key), 404)
          return
        }
      }
      redirect_with_query(w, r, f"/t/{tk}/issue/{key}")
    }),
  )
  // The bare path lands on the SELECTED team, the same compatibility the
  // other unrouted reads (/issues, /projects) already make. It cannot look
  // the slug up to do better: two teams may both own it.
  mux.HandleFunc(
    "GET /doc/{slug}",
    gated(ctx, |w: http.ResponseWriter, r: Ref<http.Request>, _v: Viewing| {
      redirect_with_query(w, r, f"/t/{boot_key}/doc/{r.PathValue("slug")}")
    }),
  )
  mux.HandleFunc(
    "GET /docs",
    gated(ctx, |w: http.ResponseWriter, r: Ref<http.Request>, _v: Viewing| {
      redirect_with_query(w, r, f"/t/{boot_key}/docs")
    }),
  )
  mux.HandleFunc(
    "GET /projects",
    gated(ctx, |w: http.ResponseWriter, r: Ref<http.Request>, _v: Viewing| {
      redirect_with_query(w, r, f"/t/{boot_key}/projects")
    }),
  )
  mux.HandleFunc(
    "GET /settings",
    gated(ctx, |w: http.ResponseWriter, r: Ref<http.Request>, _v: Viewing| {
      redirect_with_query(w, r, f"/t/{boot_key}/settings/identity")
    }),
  )
  // A bookmarked section on the bare path lands on the same section of the
  // boot team, not back at the top: /settings/access is where the release
  // notes and the CLI's own error messages send people.
  mux.HandleFunc(
    "GET /settings/{section}",
    gated(ctx, |w: http.ResponseWriter, r: Ref<http.Request>, _v: Viewing| {
      redirect_with_query(
        w,
        r,
        f"/t/{boot_key}/settings/{r.PathValue("section")}",
      )
    }),
  )
  // Every POST is a write returning Result; `flashing` (serve/actions.lis) is
  // the one place an Err becomes the flash strip.
  //
  // The bare settings writes are refused, not redirected (LLL-664): they
  // used to write the team the server started with, whichever team's page
  // posted them. The board's own forms post the /t/{team}/ paths above.
  mux.HandleFunc("POST /settings/{kind}", gated(ctx, flashing(ctx, bare_settings_write)))
  mux.HandleFunc("POST /settings/access/member", gated(ctx, flashing(ctx, bare_settings_write)))
  mux.HandleFunc("POST /settings/teams/archive", gated(ctx, flashing(ctx, bare_settings_write)))
  // The Access section's superuser-power actions (TASK-204). Their own
  // routes, not a {kind}: each verifies the form's admin password against
  // the superuser before writing — the board token alone must not suffice.
  // Minting a token redraws nothing team-shaped, so it stays bare. Member
  // sign-in and the Teams section's archive lifecycle (TASK-210) run the
  // same re-auth on their team-routed paths above.
  mux.HandleFunc(
    "POST /settings/access/token",
    gated(ctx, flashing(ctx, access_token_write)),
  )
  mux.HandleFunc(
    "GET /search",
    gated(ctx, |w: http.ResponseWriter, r: Ref<http.Request>, _v: Viewing| {
      redirect_with_query(w, r, f"/t/{boot_key}/search")
    }),
  )
  mux.HandleFunc(
    "GET /events",
    gated(ctx, |w: http.ResponseWriter, r: Ref<http.Request>, v: Viewing| {
      events_stream(ctx, w, r, hub, boot_key, v)
    }),
  )
  mux.HandleFunc(
    "POST /create",
    gated(ctx, flashing(ctx, create_write)),
  )
  mux.HandleFunc("POST /state", gated(ctx, flashing(ctx, state_write)))
  mux.HandleFunc("POST /attachments/upload", gated(ctx, flashing(ctx, attachment_upload)))
  mux.HandleFunc("POST /attachments/remove", gated(ctx, flashing(ctx, attachment_remove)))
  mux.HandleFunc("GET /attachments/file", gated(ctx, |w: http.ResponseWriter, r: Ref<http.Request>, v: Viewing| attachment_download(v.reads, w, r)))
  mux.HandleFunc("POST /favorite", gated(ctx, flashing(ctx, favorite_write)))
  mux.HandleFunc("POST /priority", gated(ctx, flashing(ctx, priority_write)))
  mux.HandleFunc("POST /emoji", gated(ctx, flashing(ctx, emoji_write)))
  mux.HandleFunc("POST /title", gated(ctx, flashing(ctx, title_write)))
  mux.HandleFunc("POST /project", gated(ctx, flashing(ctx, project_write)))
  mux.HandleFunc("POST /assignee", gated(ctx, flashing(ctx, assignee_write)))
  mux.HandleFunc("POST /claim", gated(ctx, flashing(ctx, claim_write)))
  mux.HandleFunc("POST /release", gated(ctx, flashing(ctx, release_write)))
  mux.HandleFunc("POST /labels", gated(ctx, flashing(ctx, labels_write)))
  mux.HandleFunc("POST /comment", gated(ctx, flashing(ctx, comment_write)))
  mux.HandleFunc("POST /bot", gated(ctx, flashing_with(ctx, bot_write)))
  mux.HandleFunc("POST /views/save", gated(ctx, flashing_with(ctx, views_save)))
  // The embedded tree keeps its repo paths, so "/static/theme.css" resolves to
  // "static/theme.css" with no prefix surgery.
  let assets = http.FileServerFS(web.Assets())
  mux.HandleFunc(
    "GET /static/",
    |w: http.ResponseWriter, r: Ref<http.Request>| {
      if admitted(ctx, w, r) {
        // Embedded files carry a ZERO ModTime, so http.ServeContent omits
        // Last-Modified and sets no ETag. With no validator and no freshness
        // directive the browser cannot reuse anything: every load refetched
        // the 352KB variable font, and theme.css's `font-display: swap`
        // rendered the fallback until it landed. That is the flash on refresh.
        //
        // Fonts are the one asset here safe to pin hard: the file is a
        // vendored Inter release, so the bytes behind
        // /static/fonts/InterVariable.woff2 do not change without the name
        // changing too. `immutable` means the browser does not even revalidate.
        //
        // theme.css and the scripts deliberately keep no caching. They DO
        // change from deploy to deploy and the URLs carry no content hash, so
        // caching them would serve a stale board after an upgrade with no way
        // to say otherwise. The cost is that they are refetched per load,
        // which is worth measuring only once the URLs are versioned; that is
        // the upgrade path if the CSS ever becomes a problem too.
        if let Some(u) = r.URL {
          if strings.HasPrefix(u.Path, "/static/fonts/") {
            w
              .Header()
              .Set("Cache-Control", "public, max-age=31536000, immutable")
          }
        }
        // FileServer's ServeHTTP wants a writable request; the mux hands out
        // read-only ones, so serve a clone (see `flashing`).
        let mut rc = r.Clone(r.Context())
        assets.ServeHTTP(w, rc)
      }
    },
  )

  // LLL-630: every non-GET request, on every route but /api/, must come
  // from the board's own origin (serve/gate.lis).
  Ok(same_origin_writes(mux))
}

/// 303 to `path`, carrying the request's query string over — the bare board
/// and search paths redirect to their team-routed twins (TASK-198), and a
/// filtered URL must stay filtered across the hop.
fn redirect_with_query(
  w: http.ResponseWriter,
  r: Ref<http.Request>,
  path: string,
) {
  let mut target = path
  if let Some(u) = r.URL {
    if u.RawQuery != "" { target = f"{path}?{u.RawQuery}" }
  }
  http.Redirect(w, r, target, 303)
}

/// The id of the team a /t/{team}/... write names; an unknown key refuses
/// the write.
fn routed_team_id(ctx: pb.Client, r: Ref<http.Request>) -> Result<string, pb.CliError> {
  let key = r.PathValue("team")
  let Some(t) = records.find_team(ctx, key)? else {
    return Err(pb.failed(f"no team with key '{key}' on this server"))
  }
  Ok(t.id)
}

/// A settings write on a path that names no team (LLL-664).
fn bare_settings_write(_ctx: pb.Client, _v: Viewing, _r: mut Ref<http.Request>) -> Result<string, pb.CliError> {
  Err(pb.failed("this settings form names no team; reload the page to get one that does"))
}

/// The team a /t/{team}/... URL names, freshly fetched (the accent it
/// carries can change under /settings at any moment — shell_team's bargain).
/// None means the response is already written: a 404 naming the key, or a
/// 500 for a lookup the database refused.
fn routed_team(
  ctx: pb.Client,
  w: http.ResponseWriter,
  r: Ref<http.Request>,
) -> Option<models.Team> {
  let key = r.PathValue("team")
  match records.find_team(ctx, key) {
    Ok(Some(t)) => Some(t),
    Ok(None) => {
      http.Error(
        w,
        f"no team with key '{key}' on this server; see the rail's team switcher",
        404,
      )
      None
    },
    Err(e) => {
      http.Error(w, e.message, 500)
      None
    },
  }
}
