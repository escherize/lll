import "records"
import "go:html/template"
import "go:net/http"
import "go:strings"

import "models"
import "pb"
import "query"
import "writes"

// Actions: the endpoints the board posts to. Each writes to PocketBase and
// answers with a flash; the data itself comes back through the broadcast, the
// same way a CLI-driven change does.

/// Turn a write into the handler that registration wants.
///
/// http.HandleFunc fixes the handler signature, so a write cannot return its
/// own Result to the mux — something has to consume one, and applying this
/// once per route is that something. It buys every action below the right to
/// spend a `?` where it used to spend a six-line match, and it puts the only
/// two answers an action can give, flash the error or clear the strip, in the
/// one place instead of once per fallible step.
///
/// The Ok value is any extra SSE the action owes the page past the cleared
/// flash. Almost none owes any and returns "".
fn flashing(
  ctx: pb.Client,
  write: fn(pb.Client, Viewing, mut Ref<http.Request>) -> Result<string, pb.CliError>,
) -> fn(http.ResponseWriter, Ref<http.Request>, Viewing) {
  |w: http.ResponseWriter, r: Ref<http.Request>, v: Viewing| {
    // The mux hands out read-only requests; parsing a form body is a write
    // (it caches into r.Form). Clone is the sanctioned upgrade: the copy is
    // ours to parse, and it shares the one Body stream each action reads once.
    let mut wr = r.Clone(r.Context())
    finish_action(v, w, wr, write(ctx, v, wr))
  }
}

/// The same, for the one write that must also touch the response headers
/// (LLL-375): /views/save hands the browser the saved view's cookie, and a
/// Set-Cookie has to be on the writer before the flash body is written.
fn flashing_with(
  ctx: pb.Client,
  write: fn(pb.Client, Viewing, http.ResponseWriter, mut Ref<http.Request>) -> Result<string, pb.CliError>,
) -> fn(http.ResponseWriter, Ref<http.Request>, Viewing) {
  |w: http.ResponseWriter, r: Ref<http.Request>, v: Viewing| {
    let mut wr = r.Clone(r.Context())
    finish_action(v, w, wr, write(ctx, v, w, wr))
  }
}

/// The only two answers an action can give — flash the error or clear the
/// strip — consumed in one place instead of once per fallible step.
fn finish_action(
  v: Viewing,
  w: http.ResponseWriter,
  wr: mut Ref<http.Request>,
  result: Result<string, pb.CliError>,
) {
  // Only known surfaces may choose an inline alert. The create dialog
  // must not send its errors behind the modal shade to the page strip.
  let target = if wr.PostFormValue("flash_target") == "ni-flash" { "ni-flash" } else { "flash" }
  match result {
    Ok(extra) => {
      action_flash(w, target, None)
      if extra != "" { let _ = w.Write(extra.bytes()) }
    },
    Err(e) => {
      action_flash(w, target, Some(e))
      if wr.PostFormValue("property_edit") == "1" {
        let _ = w.Write(property_recovery(v.reads, wr.FormValue("key")).bytes())
      }
    },
  }
}

/// One issue edit from a board control, as the viewer, through the write
/// layer. Each endpoint sets exactly the field its control edits.
fn patch_issue(who: Acting, active: records.WritableIssue, patch: writes.IssuePatch) -> Result<string, pb.CliError> {
  match writes.update_issue(who.reads, active.issue(), patch, writes.UpdateOptions.as_caller(who.caller)) {
    Ok(_) => Ok(""),
    Err(writes.UpdateFailure.Failed(e)) => Err(e),
    Err(writes.UpdateFailure.Changed(e)) => Err(e),
    Err(writes.UpdateFailure.ReplaceMatched(n)) => Err(pb.failed(f"the description edit matched {n} times")),
  }
}

/// Who a board write runs as (LLL-545). The board token writes as the
/// board's own member, as it always has. A read-write member viewer writes
/// with its own token, so PocketBase checks its teams and mode and records
/// it as the author. `reads` is the viewer's own read client (LLL-658): the
/// issue, team and catalogues a write checks are read as the viewer.
struct Acting {
  caller: pb.Caller,
  member: Option<ViewerMember>,
  reads: pb.Client,
}

/// The acting identity for this write. The gate already refused a read-only
/// viewer's POST; this refuses again rather than fall back to the process.
fn acting_as(v: Viewing) -> Result<Acting, pb.CliError> {
  match v.viewer {
    Viewer.Full => Ok(Acting { caller: pb.Caller.Process, member: None, reads: v.reads }),
    Viewer.Scoped(s) => {
      let Some(m) = s.member else { return Err(pb.failed(scoped_read_only())) }
      if !m.access.mode.writes() { return Err(pb.failed(scoped_read_only())) }
      Ok(Acting { caller: pb.Caller.Member(m.token), member: Some(m), reads: v.reads })
    },
  }
}

fn scoped_read_only() -> string {
  "read-only board login: it can read its teams but not change them"
}

impl Acting {
  /// The issue `key` names, read as this actor: one it may not see answers
  /// exactly as a missing one does, because it never arrives.
  fn issue(self, key: string) -> Result<models.Issue, pb.CliError> {
    records.fetch_issue(self.reads, key)
  }

  /// The member a write names as its author or claimant: the viewer, or the
  /// board's own member for the board token.
  fn member_id(self, ctx: pb.Client) -> Result<Option<models.MemberId>, pb.CliError> {
    if let Some(m) = self.member { return Ok(Some(m.id)) }
    Ok(records.find_actor(ctx)?.map(|a| a.id))
  }
}

/// One escaped alert response for the page strip and dialog-local errors.
/// Actions use 200/SSE for both outcomes; an empty message clears the alert.
fn action_flash(w: http.ResponseWriter, target: string, failure: Option<pb.CliError>) {
  let presented = failure.map_or(pb.ErrorDisplay { summary: "", details: "" }, pb.display_error)
  let safe = template.HTMLEscapeString(presented.summary)
  let details = if presented.details == "" { "" } else {
    f"<details class=\"error-details\"><summary>Technical details</summary><pre>{template.HTMLEscapeString(presented.details)}</pre></details>"
  }
  let hidden = if failure.is_none() { " hidden" } else { "" }
  respond_flash(w, f"<div id=\"{target}\" class=\"flash\"{hidden} role=\"alert\" aria-atomic=\"true\"><span class=\"error-summary\">{safe}</span>{details}</div>")
}

fn respond_flash(w: http.ResponseWriter, html: string) {
  w.Header().Set("Content-Type", "text/event-stream")
  let _ = w.Write(patch_event(html).bytes())
}

/// The board's one write path for new issues, shared by the topbar's
/// one-line composer and the full create dialog. Everything past `title` is
/// optional, so a request carrying only a title is byte-for-byte what it
/// always was and the fast path pays nothing for the dialog's existence.
///
/// Relation ids (assignee, project, labels) are parsed against what the
/// viewer may pick for this team (LLL-675): the roster, the team's projects
/// and its labels. An id outside them is refused by name rather than handed
/// to PocketBase, so no write carries another team's record.
fn create_write(ctx: pb.Client, v: Viewing, r: mut Ref<http.Request>) -> Result<string, pb.CliError> {
  let title = strings.TrimSpace(r.PostFormValue("title"))
  if title == "" { return Err(pb.failed("title is required")) }
  // Absent state means todo, the same default `lll issue create` uses, so
  // `curl -d title=...` is a complete request.
  let posted_state = r.PostFormValue("state")
  let state = if posted_state == "" { models.IssueState.Todo } else { query.state(posted_state)? }
  // The board posts the team it is viewing (TASK-198). A request naming
  // none is refused (LLL-664): it used to land in whatever team the server
  // started with, which is nobody's choice.
  let team_key = strings.TrimSpace(r.PostFormValue("team"))
  if team_key == "" {
    return Err(pb.failed("a new issue names its team: the board's form sends it, so reload the page"))
  }
  let who = acting_as(v)?
  // Read as the viewer: a hidden team answers like a missing one.
  let Some(t) = records.find_team(who.reads, team_key)? else {
    return Err(records.unknown_team(who.reads, team_key))
  }
  // New issues do not land in an archived team (TASK-210), same refusal as
  // `lll issue create`.
  let team = records.active_team(t)?.id()
  let mut priority = models.Priority.None
  let prio_slug = r.PostFormValue("priority")
  if prio_slug != "" {
    let Some(p) = models.Priority.named(prio_slug) else {
      return Err(pb.failed(f"unknown priority '{prio_slug}'"))
    }
    priority = p
  }
  // PostFormValue above has already parsed the body, so PostForm is populated;
  // labels is the one field that repeats (one checkbox per label).
  let raw_labels = r.PostForm.map_or([], |form| {
    (form as Map<string, Slice<string>>)["labels"].filter(|id| id != "")
  })
  let mut labels: Slice<models.LabelId> = []
  if !raw_labels.is_empty() {
    let known = records.fetch_labels(who.reads, query.TeamScope.Only(team))?
    for raw in raw_labels { labels = labels.append(picked_label(known, raw)?.id) }
  }
  let project = match r.PostFormValue("project") {
    "" => None,
    raw => Some(picked_project(records.fetch_projects(who.reads, query.TeamScope.Only(team))?, raw)?.id),
  }
  // A viewer assigns only members it may see (LLL-551), the ones its picker
  // offered.
  let assignee = match r.PostFormValue("assignee") {
    "" => None,
    raw => Some(picked_member(read_roster(who.reads)?, raw)?.id),
  }
  let new_issue = models.NewIssue {
    creator: who.member_id(ctx)?,
    origin: models.IssueOrigin { tool: "web", .. },
    team,
    title,
    state: state.wire(),
    priority: priority.wire(),
    description: r.PostFormValue("description"),
    assignee,
    project,
    labels,
    ..,
  }
  let _ = writes.create_issue(who.reads, who.caller, new_issue, "")?
  // Only a success closes the dialog and empties the composers, and the
  // server is what says so. If the client cleared optimistically, a rejected
  // create would take a typed description down with it — the field this whole
  // dialog exists for. Clearing new_title matters because the dialog opens
  // carrying the topbar's text: leaving it behind would arm a duplicate the
  // next time someone pressed Enter up there.
  Ok(signals_event("{\"ni_open\": false, \"new_title\": \"\"}"))
}

fn state_write(_ctx: pb.Client, v: Viewing, r: mut Ref<http.Request>) -> Result<string, pb.CliError> {
  // FormValue, not PostFormValue: drag-and-drop posts key/state as query params.
  let key = r.FormValue("key")
  let state = query.state(r.FormValue("state"))?
  // Record id of the card the drop lands before; "" means end of column.
  let before = r.FormValue("before")
  let who = acting_as(v)?
  let issue = who.issue(key)?
  // An archived team's board is read-only (TASK-210): the edit is handed
  // only an issue whose team takes writes.
  let active = records.active_issue(issue)?
  // The issue's OWN team scopes the reorder (TASK-198): a drop on any
  // team's board must compute the midpoint against that team's column, not
  // the boot team's.
  let sort = reorder_sort(who.reads, issue, state, before, issue.team)?
  patch_issue(who, active, writes.IssuePatch { state: Some(state), sort: Some(sort), ..writes.IssuePatch.unchanged() })
}

/// New manual position for `issue` landing in `state` before the record id
/// `before` ("" = end of column): the fractional midpoint of its neighbors'
/// sorts, so a reorder patches exactly one record.
fn reorder_sort(
  ctx: pb.Client,
  issue: models.Issue,
  state: models.IssueState,
  before: string,
  team_id: models.TeamId,
) -> Result<float64, pb.CliError> {
  // Dropping a card onto itself moves nothing.
  if before == issue.id.string() { return Ok(issue.sort) }
  // Column-scoped fetch (LLL-428): only this column, board order, id+sort.
  let others = records.fetch_column_issues(ctx, team_id, state)?.filter(|i| i.id != issue.id)
  if others.is_empty() { return Ok(issue.sort) }
  let Some(target) = others.find(|i| i.id.string() == before) else {
    // End of column — also the fallback when `before` went stale (moved or
    // deleted between the drop and this request).
    return Ok(others[others.length() - 1].sort + 1.0)
  }
  // Sort of the card just above the drop slot; before the first card, a
  // synthetic target.sort - 2 makes the midpoint land strictly first.
  let mut prev_sort = target.sort - 2.0
  for i in others {
    if i.id.string() == before { break }
    prev_sort = i.sort
  }
  Ok((prev_sort + target.sort) / 2.0)
}

/// Star or unstar an issue for the workspace: `on=true` adds, anything else
/// removes.
///
/// A set, not a toggle. The button posts the state it just moved to, so a
/// double click or a stale page converges on what the user sees instead of
/// flipping the row out from under them. Both directions are idempotent.
fn favorite_write(ctx: pb.Client, v: Viewing, r: mut Ref<http.Request>) -> Result<string, pb.CliError> {
  let caller = workspace_writer(v)?
  let key = r.FormValue("key")
  let on = r.FormValue("on") == "true"
  let issue = records.fetch_issue(ctx, key)?
  let existing = fetch_favorite(ctx, issue.id)?
  if on {
    if existing.is_some() { return Ok("") }
    // member stays empty: a star belongs to the workspace.
    writes.create_favorite(v.reads, caller, models.NewFavorite { issue: issue.id, .. })?
  } else if let Some(fav) = existing {
    writes.delete_favorite(v.reads, caller, fav.id)?
  }
  Ok("")
}

/// Who writes a workspace row: a favorite or a saved view (LLL-664). Both
/// carry no member, so they belong to the whole workspace, and only the
/// board login, which sees every team, changes them; its writes are the
/// board member's. Any other login is refused here, not written as the
/// process: the gate closes both routes to it already, and this keeps that
/// true if the gate's allowlist ever opens them.
fn workspace_writer(v: Viewing) -> Result<pb.Caller, pb.CliError> {
  match v.viewer {
    Viewer.Full => Ok(pb.Caller.Process),
    Viewer.Scoped(_) => Err(pb.failed("favorites and saved views belong to the whole workspace; only the board login changes them")),
  }
}

fn priority_write(_ctx: pb.Client, v: Viewing, r: mut Ref<http.Request>) -> Result<string, pb.CliError> {
  let key = r.FormValue("key")
  let slug = r.FormValue("priority")
  let Some(prio) = models.Priority.named(slug) else {
    return Err(pb.failed(f"unknown priority '{slug}'"))
  }
  let who = acting_as(v)?
  let issue = who.issue(key)?
  // An archived team's board is read-only (TASK-210): the edit is handed
  // only an issue whose team takes writes.
  let active = records.active_issue(issue)?
  patch_issue(who, active, writes.IssuePatch { priority: Some(prio), ..writes.IssuePatch.unchanged() })
}

/// Set or clear the issue's marker from the web picker.
///
/// An empty `emoji` is the way back to "none" — a picker with no way to
/// unset would be a one-way trap — so this keys off the parameter being
/// present, exactly as `lll issue update --emoji ""` keys off the flag.
/// Validation is the CLI's `check_emoji`: the picker only ever posts one of
/// its own candidates, but the endpoint is curl-able like every other.
fn emoji_write(_ctx: pb.Client, v: Viewing, r: mut Ref<http.Request>) -> Result<string, pb.CliError> {
  let key = r.FormValue("key")
  let Ok(emoji) = records.check_emoji(r.FormValue("emoji")) else {
    return Err(pb.failed("an issue takes one emoji, or none"))
  }
  let who = acting_as(v)?
  let issue = who.issue(key)?
  // An archived team's board is read-only (TASK-210): the edit is handed
  // only an issue whose team takes writes.
  let active = records.active_issue(issue)?
  patch_issue(who, active, writes.IssuePatch { emoji: Some(emoji), ..writes.IssuePatch.unchanged() })
}

fn title_write(_ctx: pb.Client, v: Viewing, r: mut Ref<http.Request>) -> Result<string, pb.CliError> {
  let key = r.FormValue("key")
  let title = strings.TrimSpace(r.FormValue("title"))
  if title == "" { return Err(pb.failed("title is required")) }
  let who = acting_as(v)?
  let issue = who.issue(key)?
  // An archived team's board is read-only (TASK-210): the edit is handed
  // only an issue whose team takes writes.
  let active = records.active_issue(issue)?
  patch_issue(who, active, writes.IssuePatch { title: Some(title), ..writes.IssuePatch.unchanged() })
}

fn project_write(_ctx: pb.Client, v: Viewing, r: mut Ref<http.Request>) -> Result<string, pb.CliError> {
  let key = r.FormValue("key")
  let id = r.FormValue("project")
  // The issue first: its own team is what the posted id has to belong to,
  // and a project from another team is as unknown here as a deleted one
  // (TASK-173).
  let who = acting_as(v)?
  let issue = who.issue(key)?
  // An archived team's board is read-only (TASK-210): the edit is handed
  // only an issue whose team takes writes.
  let active = records.active_issue(issue)?
  let project = if id == "" {
    writes.Relation.Clear
  } else {
    writes.Relation.Set(picked_project(records.fetch_projects(who.reads, query.TeamScope.Only(issue.team))?, id)?.id)
  }
  patch_issue(who, active, writes.IssuePatch { project, ..writes.IssuePatch.unchanged() })
}

fn assignee_write(_ctx: pb.Client, v: Viewing, r: mut Ref<http.Request>) -> Result<string, pb.CliError> {
  let key = r.FormValue("key")
  let id = r.FormValue("assignee")
  let who = acting_as(v)?
  let issue = who.issue(key)?
  // The picker offers the viewer's roster for the issue's team (LLL-551); a
  // posted id outside it is as unknown as a deleted one.
  let picked = if id == "" { None } else { Some(picked_member(read_roster(who.reads)?, id)?.id) }
  // An archived team's board is read-only (TASK-210): the edit is handed
  // only an issue whose team takes writes.
  let active = records.active_issue(issue)?
  // Never forced (LLL-662): clearing the assignee releases the claim, so the
  // picker clears only the viewer's own hold. Taking anyone else's goes
  // through the Release form, which asks for a reason. The write layer reads
  // the observed claim as the viewer.
  let assignee = match picked {
    None => writes.Relation.Clear,
    Some(member) => writes.Relation.Set(member),
  }
  let _ = patch_issue(who, active, writes.IssuePatch { assignee, ..writes.IssuePatch.unchanged() }).map_err(|e| {
    if e.has_code(pb.ServerCode.NeedsForce) {
      e.with_message(f"{strings.TrimSuffix(pb.display_error(e).summary, ".")} - release it with a reason first (the Release form on the issue)")
    } else { e }
  })?
  Ok("")
}

/// Add or remove the one label whose chip was toggled: `label` is its id,
/// `on=true` adds, anything else removes. A set, not a toggle, like
/// favorite_write: the checkbox posts the state it just moved to.
///
/// Only the toggled label is written (LLL-519). Posting the whole checked set
/// replaced the field from the page's earlier read, which dropped a label
/// `lll issue update --add-label` added after the page rendered. The
/// server's per-issue lock serializes the modifiers.
fn labels_write(_ctx: pb.Client, v: Viewing, r: mut Ref<http.Request>) -> Result<string, pb.CliError> {
  let key = r.FormValue("key")
  if key == "" {
    return Err(
      pb.failed("labels_write got no issue key. Reload the page; if it keeps happening, this is a bug in the labels form"),
    )
  }
  let id = r.FormValue("label")
  if id == "" {
    return Err(
      pb.failed("labels_write got no label. Reload the page; if it keeps happening, this is a bug in the labels form"),
    )
  }
  // The issue first, for its team: a label from another team is as unknown
  // here as a deleted one, which is what stops a POST crossing tenancy
  // however the checkbox got its id (TASK-173).
  let who = acting_as(v)?
  let issue = who.issue(key)?
  // An archived team's board is read-only (TASK-210): the edit is handed
  // only an issue whose team takes writes.
  let active = records.active_issue(issue)?
  let label = picked_label(records.fetch_labels(who.reads, query.TeamScope.Only(issue.team))?, id)?.id
  let labels = if r.FormValue("on") == "true" {
    writes.LabelEdit.Delta { add: [label], remove: [] }
  } else {
    writes.LabelEdit.Delta { add: [], remove: [label] }
  }
  patch_issue(who, active, writes.IssuePatch { labels, ..writes.IssuePatch.unchanged() })
}

fn comment_write(ctx: pb.Client, v: Viewing, r: mut Ref<http.Request>) -> Result<string, pb.CliError> {
  let key = r.PostFormValue("key")
  let body = strings.TrimSpace(r.PostFormValue("body"))
  if body == "" { return Err(pb.failed("comment body is required")) }
  let who = acting_as(v)?
  let issue = records.active_issue(who.issue(key)?)?.issue()
  let Some(author) = who.member_id(ctx)? else {
    return Err(pb.failed("commenting needs a member token; start the board with lll up"))
  };
  let _ = writes.create_comment(who.reads, who.caller, models.NewComment { issue: issue.id, author: Some(author), agent: "", body })?
  // LLL-386/LLL-384: the comment arrives through the live stream, so the
  // composer was never told the write landed and kept the text - which reads
  // as "it did not send" and invites a second identical comment.
  //
  // Returned from the Ok branch ONLY, so a refusal (empty body, archived team)
  // leaves the draft exactly where it was. `mode replace` rather than a morph
  // because a morph retains the live value, which is the thing being cleared.
  let html = render("comment-composer", f"{issue.expand.team.key}-{issue.number}")?
  Ok(replace_event("#comment-form", html))
}

/// Save the board's current view under a name (TASK-94, half two): one row
/// in `views` holding the query string it stands for. The rail renders the
/// row as the board URL that query string reproduces, so a saved view is a
/// name plus a query string and nothing else.
///
/// The query is canonicalized through the shared encoder before it is
/// stored — the form posts the board page's own rendering of the URL, but
/// the endpoint is curl-able like every other, and a view must always be
/// exactly the URL it will navigate to.
fn views_save(_ctx: pb.Client, v: Viewing, w: http.ResponseWriter, r: mut Ref<http.Request>) -> Result<string, pb.CliError> {
  let caller = workspace_writer(v)?
  let name = strings.TrimSpace(r.PostFormValue("name"))
  if name == "" { return Err(pb.failed("a view needs a name")) }
  if name.length() > 80 { return Err(pb.failed("view names are capped at 80 characters")) }
  let raw_q = view_query_parse_raw(r.PostFormValue("query"))?
  let query_str = view_query_string(raw_q)
  if query_str.length() > 500 {
    return Err(pb.failed("this view's query string is too long to save"))
  }
  // The unique index is the backstop; this pre-check is what makes the
  // flash strip say something a human can read.
  // Every page (LLL-659): one page of 200 missed a duplicate past it.
  let existing = records.fetch_all_records<models.View>(v.reads, "/api/collections/views/records?sort=id", "views")?
  if existing.any(|view| view.name == name) {
    return Err(pb.failed(f"a view named '{name}' already exists"))
  }
  // member stays empty: a saved view belongs to the workspace.
  writes.create_view(v.reads, caller, models.NewView { name, query: strings.TrimPrefix(query_str, "?"), .. })?
  // LLL-375: saving a view makes it this browser's view — the same cookie a
  // board GET would write, so a bare reload honors what was just saved even
  // if the page's own cookie went stale. The team key rides the form (the
  // endpoint stays curl-able without one); a cookie named for a team that
  // does not exist is never read, and the slugs are re-validated on every
  // read, so an unvalidated write here plants nothing a board would act on.
  let team_key = strings.TrimSpace(r.PostFormValue("team"))
  if team_key != "" {
    set_view_cookie(w, f"lll_view_{team_key}", raw_q.hide)
  }
  Ok("")
}

/// The board uses its process identity; the button names it explicitly.
fn claim_write(ctx: pb.Client, v: Viewing, r: mut Ref<http.Request>) -> Result<string, pb.CliError> {
  let who = acting_as(v)?
  let issue = records.active_issue(who.issue(r.FormValue("key"))?)?.issue()
  // A member viewer claims as itself, whatever name the shared live
  // fragment last rendered on the button (LLL-545).
  if let Some(m) = who.member {
    let _ = writes.acquire_claim(who.reads, who.caller, issue.id, m.id, "")?
    return Ok("")
  }
  let Some(member) = records.find_actor(ctx)? else { return Err(pb.failed("No member is configured for this board.")) };
  if r.FormValue("member_id") != member.id.string() { return Err(pb.failed("The board identity changed; refresh before claiming.")) }
  let _ = writes.acquire_claim(who.reads, who.caller, issue.id, member.id, "")?
  Ok("")
}

/// The viewer releases as itself (LLL-662): a member login as that member,
/// the board token as the board's member. The holder's release needs nothing
/// more. Anyone else's is forced, and force comes only with a reason typed
/// into the form, which the server records in its comment; without one the
/// server's refusal is the answer. The live fragment is shared by every
/// viewer, so the form cannot know who is looking; the server decides.
fn release_write(_ctx: pb.Client, v: Viewing, r: mut Ref<http.Request>) -> Result<string, pb.CliError> {
  let who = acting_as(v)?
  let issue = records.active_issue(who.issue(r.FormValue("key"))?)?.issue()
  let posted = r.FormValue("claim_id")
  if posted == "" { return Err(pb.failed("The claim changed; refresh before releasing it.")) }
  let observed = writes.observed_claim(posted)
  let reason = strings.TrimSpace(r.FormValue("reason"))
  let by = writes.ClaimAs { caller: who.caller, agent: "", force: reason != "", reason }
  let _ = writes.release_claim(who.reads, issue.id, observed, by).map_err(|e| {
    if e.has_code(pb.ServerCode.NeedsForce) {
      e.with_message(f"{strings.TrimSuffix(pb.display_error(e).summary, ".")} - type a reason to release it anyway; it is recorded in a comment on the issue")
    } else { e }
  })?
  Ok("")
}

/// A label id a form posted, parsed against the team's labels: one from
/// another team is as unknown as a deleted one (TASK-173).
fn picked_label(known: Slice<models.Label>, raw: string) -> Result<models.Label, pb.CliError> {
  let Some(label) = known.find(|l| l.id.string() == raw) else {
    return Err(pb.failed(f"unknown label '{raw}'; reload the page for the current list"))
  }
  Ok(label)
}

/// A project id a form posted, parsed against the team's projects.
fn picked_project(known: Slice<models.Project>, raw: string) -> Result<models.Project, pb.CliError> {
  let Some(project) = known.find(|p| p.id.string() == raw) else {
    return Err(pb.failed(f"unknown project '{raw}'; reload the page for the current list"))
  }
  Ok(project)
}

/// A member id a form posted, parsed against the viewer's roster (LLL-551).
fn picked_member(roster: Roster, raw: string) -> Result<models.Member, pb.CliError> {
  let Some(member) = roster.members.find(|m| m.id.string() == raw) else {
    return Err(pb.failed(f"unknown member '{raw}'; reload the page for the current list"))
  }
  Ok(member)
}
