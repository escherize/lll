import "go:net/http"
import "go:net/url"
import "go:strconv"
import "go:strings"

import "models"
import "pb"
import "writes"
import "records"

pub struct SettingsDeleteVM {
  pub kind: string,
  pub id: string,
  pub name: string,
  pub used: int,
  pub changed: bool,
}

/// A review replaces the clicked row, so its impact and confirmation stay
/// beside the record. Recount on submission; stale counts require a new review.
fn settings_delete(ctx: pb.Client, r: mut Ref<http.Request>, team_id: models.TeamId) -> Result<Option<string>, pb.CliError> {
  let kind = r.PathValue("kind")
  let coll = settings_collection(kind)?
  let id = strings.TrimSpace(r.PostFormValue("id"))
  if id == "" { return Err(pb.failed("nothing to delete")) }
  let path = f"/api/collections/{coll}/records/{url.PathEscape(id)}"
  if kind == "member" { return settings_member_delete(ctx, r, id) }
  let (name, owner, what) = if kind == "label" {
    let mut label = models.Label { .. }
    pb.fetch(ctx, path, "label", &label)?
    (label.name, label.team, records.Classifier.Label(label.id))
  } else {
    let mut project = models.Project { .. }
    pb.fetch(ctx, path, "project", &project)?
    (project.name, project.team, records.Classifier.Project(project.id))
  }
  if owner != team_id {
    return Err(pb.failed(f"the {kind} is not in this team; reload settings"))
  }
  let used = records.entity_issue_count(ctx, what)?
  let confirmed = r.PostFormValue("confirmed") == "1"
  if !confirmed || r.PostFormValue("expected") != strconv.Itoa(used) {
    let vm = SettingsDeleteVM { kind, id, name, used, changed: confirmed }
    return Ok(Some(patch_event(render("set-delete-review", vm)?)))
  }
  match what {
    records.Classifier.Label(label) => writes.delete_label(ctx, label)?,
    records.Classifier.Project(project) => writes.delete_project(ctx, project)?,
  }
  Ok(None)
}
