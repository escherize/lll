import "go:strings"
import "models"

#[test]
fn scoped_board_token_opens_only_its_team() {
  let tok = scoped_board_token("board-secret", "AAA")
  assert team_scope(tok, "board-secret") == Some("AAA")
  // Another board's secret, a renamed key and the full token are not scopes.
  assert team_scope(tok, "other-secret") == None
  assert team_scope("BBB" + strings.TrimPrefix(tok, "AAA"), "board-secret") == None
  assert team_scope("board-secret", "board-secret") == None
  assert team_scope(tok, "") == None
}

fn route_kind(route: ScopedVerdict) -> string {
  match route {
    ScopedVerdict.Open => "open",
    ScopedVerdict.Closed(_) => "closed",
  }
}

// The allowlist decides routes, never teams (LLL-658): a page reads as its
// viewer, so another team's address is open here and answers 404 from the
// viewer's own read.
#[test]
fn scoped_viewer_allowlist() {
  let get = |path: string| route_kind(scoped_route("GET", path, false))
  for path in ["/t/AAA", "/t/AAA/", "/t/AAA/issues", "/t/AAA/projects", "/t/AAA/docs", "/t/AAA/search",
               "/t/AAA/issue/AAA-3", "/t/AAA/issue/aaa-3", "/t/AAA/doc/index", "/t/aaa/", "/static/app.js",
               "/issue/AAA-3", "/issue/aaa-3", "/t/BBB/", "/t/BBB/issue/BBB-1", "/events", "/attachments/file"] {
    assert get(path) == "open"
  }
  for path in ["/", "/t/AAA/settings", "/t/AAA/settings/access", "/t/BBB/settings/identity", "/t/AAA/doc/",
               "/t/AAA/doc/a/b", "/t/AAA/docs/x", "/t/AAA/issue/", "/issue/", "/issue/AAA-3/x", "/search",
               "/settings/access", "/issues"] {
    assert get(path) == "closed"
  }
  // Read-only: no write is admitted.
  assert route_kind(scoped_route("POST", "/t/AAA/settings/label", false)) == "closed"
  assert route_kind(scoped_route("POST", "/state", false)) == "closed"
  assert route_kind(scoped_route("HEAD", "/t/AAA/", false)) == "closed"
}

#[test]
fn login_redirect_stays_on_the_board() {
  assert local_path("/t/AAA/") == "/t/AAA/"
  assert local_path("/t/AAA/issue/AAA-1?order=priority") == "/t/AAA/issue/AAA-1?order=priority"
  for bad in ["", "//evil.example/", "https://evil.example/", "/\\evil.example", "t/AAA",
              "/\t/evil.example", "/\n/evil.example", "/\r/x", "/\u{7f}/x", "/\u{0}/x"] {
    assert local_path(bad) == "/"
  }
}

#[test]
fn member_viewer_writes_only_when_read_write() {
  for path in ["/create", "/state", "/title", "/comment", "/claim", "/release", "/attachments/upload"] {
    assert route_kind(scoped_route("POST", path, true)) == "open"
    assert route_kind(scoped_route("POST", path, false)) == "closed"
  }
  // Workspace-wide rows and settings stay closed even to a writer.
  for path in ["/favorite", "/views/save", "/settings/label", "/t/AAA/settings/label",
               "/settings/access/token", "/settings/access/member", "/settings/teams/archive"] {
    assert route_kind(scoped_route("POST", path, true)) == "closed"
  }
  let m = ViewerMember { id: "m1", name: "ann", token: "t", access: models.Access { reach: models.Reach.Teams([]), mode: models.Mode.ReadWrite } }
  let v = ScopedViewer { teams: ["AAA", "CCC"], member: Some(m) }
  // The stream's revocation check (LLL-626) reads these.
  assert v.sees("ccc") && !v.sees("BBB") && v.sees_issue("CCC-2") && !v.sees_issue("BBB-2")
  assert !v.sees_issue("AAA-X-1") && !v.sees_issue("AAA-")
  // No teams sees nothing: empty never means every team.
  let none = ScopedViewer { teams: [], member: Some(m) }
  assert !none.sees("AAA")
}

// What a viewer may do follows its access and nothing else (LLL-658).
#[test]
fn a_viewer_writes_and_sees_everything_only_as_its_access_says() {
  let rw = ViewerMember { id: "m1", name: "ann", token: "t", access: models.Access { reach: models.Reach.Teams([]), mode: models.Mode.ReadWrite } }
  let ro = ViewerMember { access: models.Access { reach: models.Reach.Teams([]), mode: models.Mode.ReadOnly }, ..rw }
  let all = ViewerMember { access: models.Access { reach: models.Reach.Every, mode: models.Mode.ReadWrite }, ..rw }
  assert viewer_writes(Viewer.Full) && !viewer_is_scoped(Viewer.Full)
  assert viewer_writes(Viewer.Scoped(ScopedViewer { teams: ["AAA"], member: Some(rw) }))
  assert !viewer_writes(Viewer.Scoped(ScopedViewer { teams: ["AAA"], member: Some(ro) }))
  let link = Viewer.Scoped(ScopedViewer { teams: ["AAA"], member: None })
  assert !viewer_writes(link) && viewer_is_scoped(link)
  assert !viewer_is_scoped(Viewer.Scoped(ScopedViewer { teams: ["AAA"], member: Some(all) }))
}
