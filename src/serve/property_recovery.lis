import "records"
import "pb"

/// A failed immediate-save control must not keep its unsaved selection.
/// Reuse the normal property template, but replace this panel: a morph
/// preserves selected/checked DOM properties when server attributes have
/// not changed. Title and comment drafts live outside this boundary.
fn property_recovery(ctx: pb.Client, key: string) -> string {
  let html = current_properties(ctx, key).unwrap_or_else(|_| {
    render("issue-properties-unavailable", "").unwrap_or("")
  })
  if html == "" { return "" }
  replace_event("#issue-properties", html)
}

/// `ctx` is the viewer's read client (LLL-658), so an issue the viewer may
/// not see is missing, and its labels, project and members arrive only as
/// far as the viewer may see them.
fn current_properties(ctx: pb.Client, key: string) -> Result<string, string> {
  let issue = shown_refs(records.fetch_issue(ctx, key)?)
  let vm = issue_fields_vm(ctx, issue, [], read_roster(ctx)?)?
  render("issue-properties", vm)
}
