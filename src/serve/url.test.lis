import "pb"
import "query"

/// The board half of the shared-filter contract: a URL's view state becomes
/// the same query.Filters, and fails the same validation, as the CLI's
/// flags (that half is in src/commands/issue_filters.test.lis).
#[test]
fn web_filters_share_values_and_validation_with_the_cli() {
  let assert Ok(web) = view_filters(
    ViewQuery {
      state: "in-review",
      assignee: "Alice O'Neil",
      label: "needs review",
      project: "Release 2",
      ..,
    },
  ).parse()
  let assert Ok(cli) = query.Filters {
    state: ["in-review"],
    assignee: "Alice O'Neil",
    label: ["needs review"],
    project: "Release 2",
    ..,
  }.parse()
  assert web.one_state() == cli.one_state()
  assert web.assignee == cli.assignee
  assert web.one_label() == cli.one_label()
  assert web.project == cli.project
  let assert Err(web_error) = view_filters(ViewQuery { state: "bogus", .. }).parse()
  let assert Err(cli_error) = query.Filters { state: ["bogus"], .. }.parse()
  assert web_error == cli_error
  assert pb.exit_code(web_error.kind) == 2
}

#[test]
fn a_view_without_a_state_filters_nothing() {
  assert view_filters(ViewQuery { .. }).parse().is_ok()
}
