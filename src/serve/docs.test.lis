import "models"

// LLL-643: the docs index.

#[test]
fn docs_kind_takes_the_catalogue_and_flashes_the_rest() {
  assert docs_kind("") == ("", "")
  assert docs_kind(" Decision ") == ("decision", "")
  let (kind, err) = docs_kind("note")
  assert kind == "" &&
  err == "unknown kind 'note' (use one of: wiki, finding, decision, prd)"
}

#[test]
fn doc_matches_slug_or_title_ignoring_case() {
  let d = models.Doc { slug: "board-render", title: "Render On The Server", .. }
  assert doc_matches(d, "")
  assert doc_matches(d, "BOARD")
  assert doc_matches(d, "on the server")
  assert !doc_matches(d, "body only")
}

// LLL-635: a doc stored without a kind must not take the list down with it.
#[test]
fn a_doc_with_no_kind_is_a_row_with_a_dash() {
  let row = doc_row_vm(
    models.Doc { slug: "untyped", title: "Untyped", .. },
    "TST",
  )
  assert row.kind_label == "" && row.author == "" &&
  row.href == "/t/TST/doc/untyped"
  assert doc_kind_label("prd") == "PRD" && doc_kind_label("wiki") == "Wiki"
  // The doc's own page shares the label, so it renders instead of panicking.
  assert doc_vm(models.Doc { slug: "untyped", .. }, "TST").kind_label == ""
  let raw = docs_raw(DocsVM { docs: [row], team_key: "TST", .. })
  assert raw.contains("- [untyped](/t/TST/doc/untyped) | Untyped | - | - | - |")
}

// LLL-551: a viewer whose read of the roster lacks the author sees "hidden
// member", with no kind or owner; a full viewer's row names the bot and its owner.
#[test]
fn a_doc_row_follows_the_viewers_roster() {
  let owner = models.MemberOwner { id: "bob", name: "bob" }
  let bot = models.Member {
    id: "garden",
    name: "bot-garden",
    kind_wire: "bot",
    scope_wire: "all",
    expand: Some(models.MemberExpand { owner: Some(owner) }),
    ..,
  }
  let mut d = models.Doc {
    slug: "s",
    title: "t",
    kind: "decision",
    author: "garden",
    ..,
  }
  d.expand.author = Some(bot)
  let alice = models.Member {
    id: "alice",
    name: "alice",
    kind_wire: "person",
    scope_wire: "teams",
    teams: ["t-a"],
    ..,
  }

  // The viewer's own read of the members collection did not return the bot.
  let scoped = Roster { members: [alice] }
  let hidden = doc_row_vm(scoped.doc(d), "TST")
  assert hidden.author == "hidden member" && hidden.author_kind == "" &&
  hidden.author_via == ""

  let full = doc_row_vm(
    Roster { members: [alice, bot, models.Member { id: "bob", name: "bob", .. }] }.doc(d),
    "TST",
  )
  assert full.author == "bot-garden" && full.author_kind == "bot" &&
  full.author_via == "bob"
  assert docs_raw(DocsVM { docs: [full], team_key: "TST", .. }).contains(
    "| bot-garden [bot via bob] |",
  )
}

// LLL-682: the last editor shows only when it is not the author, follows the
// viewer's roster, and names a bot editor's owner as the author line does.
#[test]
fn a_doc_shows_its_last_editor_only_when_someone_else_edited() {
  let alice = models.Member { id: "alice", name: "alice", kind_wire: "person", .. }
  let bob = models.Member { id: "bob", name: "bob", kind_wire: "person", .. }
  let bot = models.Member {
    id: "garden",
    name: "bot-garden",
    kind_wire: "bot",
    expand: Some(models.MemberExpand { owner: Some(models.MemberOwner { id: "bob", name: "bob" }) }),
    ..,
  }
  let mut d = models.Doc { slug: "s", title: "t", author: "alice", last_editor: "alice", .. }
  d.expand.author = Some(alice)
  d.expand.last_editor = Some(alice)
  let everyone = Roster { members: [alice, bob, bot] }
  assert doc_row_vm(everyone.doc(d), "TST").editor == ""
  assert !doc_raw(doc_vm(everyone.doc(d), "TST")).contains("Edited by")

  d.last_editor = "bob"
  d.expand.last_editor = Some(bob)
  assert doc_vm(everyone.doc(d), "TST").editor == "bob"
  assert doc_raw(doc_vm(everyone.doc(d), "TST")).contains("Author: alice\nEdited by: bob\n")
  assert docs_raw(DocsVM { docs: [doc_row_vm(everyone.doc(d), "TST")], team_key: "TST", .. }).contains(
    "| alice, edited by bob |",
  )

  // A viewer whose roster lacks bob sees the placeholder, and so does one
  // whose read did not expand him at all.
  let scoped = Roster { members: [alice] }
  assert doc_row_vm(scoped.doc(d), "TST").editor == "hidden member"
  d.expand.last_editor = None
  assert doc_vm(scoped.doc(d), "TST").editor == "hidden member"

  d.last_editor = "garden"
  d.expand.last_editor = Some(bot)
  let row = doc_row_vm(everyone.doc(d), "TST")
  assert row.editor == "bot-garden" && row.editor_bot && row.editor_via == "bob"
  assert doc_raw(doc_vm(everyone.doc(d), "TST")).contains("Edited by: bot-garden [bot via bob]\n")
}
