import "go:os"
import "go:os/exec"
import "go:path/filepath"

// Cover for the two rules TASK-168 turns on: config files LAYER, and the
// search for the repo file stops at the git root.
//
// These tests touch the filesystem and the working directory, because
// that is exactly what they are about — a pure test of load() would prove
// nothing about which file it reads.

// ----------------------------------------------------------------- ceiling

#[test]
fn within_accepts_the_root_and_what_is_under_it() {
  assert within("/a/repo", "/a/repo")
  assert within("/a/repo/src", "/a/repo")
  assert within("/a/repo/src/commands", "/a/repo")
}

#[test]
fn within_rejects_parents_and_prefix_lookalikes() {
  assert !within("/a", "/a/repo")
  assert !within("/", "/a/repo")
  // The one a bare HasPrefix would get wrong: a sibling whose name starts
  // with the root's.
  assert !within("/a/repository", "/a/repo")
}

// ---------------------------------------------------------------- fixtures

/// A temp tree: a git repo carrying `repo_toml`, a home config carrying
/// `home_toml` (either skipped when ""), and a stray `.lll.toml` one level
/// ABOVE the repo root — the trap the ceiling exists for. Yields (root, home).
fn fixture(repo_toml: string, home_toml: string) -> Result<(string, string), string> {
  let Ok(tmp) = os.MkdirTemp("", "lll-config") else {
    return Err("making a temp dir")
  }
  // Resolved, so the walk's comparisons match what git reports on a machine
  // whose temp directory is itself a symlink (macOS /tmp).
  let Ok(base) = filepath.EvalSymlinks(tmp) else {
    return Err(f"resolving {tmp}")
  }

  let home = filepath.Join(base, "home")
  write(filepath.Join(home, ".config", "lll", "lll.toml"), home_toml)?
  write(filepath.Join(base, ".lll.toml"), "team = \"STRAY\"\n")?

  let root = filepath.Join(base, "repo")
  if let Err(e) = os.MkdirAll(filepath.Join(root, "src", "commands"), 0o755) {
    return Err(f"making {root}: {e}")
  }
  if let Err(e) = exec.Command("git", "-C", root, "init", "-q").Run() {
    return Err(f"git init in {root}: {e}")
  }
  write(filepath.Join(root, ".lll.toml"), repo_toml)?
  Ok((root, home))
}

/// Write `text` to `path`, creating its directory. Empty text writes nothing:
/// an absent file is a case these tests need.
fn write(path: string, text: string) -> Result<(), string> {
  let dir = filepath.Dir(path)
  if let Err(e) = os.MkdirAll(dir, 0o755) {
    return Err(f"making {dir}: {e}")
  }
  if text == "" { return Ok(()) }
  if let Err(e) = os.WriteFile(path, text.bytes(), 0o644) {
    return Err(f"writing {path}: {e}")
  }
  Ok(())
}

/// The environment a test hands resolution: `home` as $HOME and nothing
/// else set. The real process environment never reaches `resolve` (LLL-486),
/// so a developer's exported LLL_* or XDG_CONFIG_HOME cannot fail these.
fn env_at(home: string) -> Env {
  Env { home, .. }
}

/// Resolve settings from `dir` with `env`, restoring the working directory
/// after. The working directory is the one ambient input left: the repo file
/// is found from it.
fn settings_in(dir: string, env: Env, overrides: Overrides) -> Result<Settings, string> {
  let Ok(prev_dir) = os.Getwd() else {
    return Err("reading the working directory")
  }
  defer { let _ = os.Chdir(prev_dir) }
  if let Err(e) = os.Chdir(dir) {
    return Err(f"entering {dir}: {e}")
  }
  Ok(resolve(env, overrides))
}

fn traced_with(dir: string, env: Env) -> Result<(Config, Sources), string> {
  settings_in(dir, env, no_overrides())?.traced()
}

fn traced_from(dir: string, home: string) -> Result<(Config, Sources), string> {
  traced_with(dir, env_at(home))
}

fn load_from(dir: string, home: string) -> Result<Config, string> {
  let (cfg, _) = traced_from(dir, home)?
  Ok(cfg)
}


// ---------------------------------------------------------------- layering

#[test]
fn repo_file_supplies_team_without_losing_the_home_url_and_sort() {
  let assert Ok((root, home)) = fixture(
    "team = \"REPO\"\n",
    "url = \"http://home:9999\"\nme = \"homer\"\nsort = \"-updated\"\n",
  )
  let assert Ok(cfg) = load_from(root, home)
  assert cfg.team == "REPO"
  // First-wins threw all three away the moment a repo file existed, which is
  // what made a committed repo file impossible.
  assert cfg.url == "http://home:9999"
  assert cfg.sort == "-updated"
}

#[test]
fn the_repo_file_overrides_the_home_file_key_by_key() {
  let assert Ok((root, home)) = fixture(
    "team = \"REPO\"\n",
    "url = \"http://home:9999\"\nteam = \"HOME\"\n",
  )
  let assert Ok(cfg) = load_from(filepath.Join(root, "src"), home)
  assert cfg.team == "REPO"
  assert cfg.url == "http://home:9999"
}

// -------------------------------------------------------------- the walk

#[test]
fn a_subdirectory_finds_the_repo_root_file() {
  let assert Ok((root, home)) = fixture("team = \"REPO\"\n", "url = \"http://home:9999\"\n")
  let assert Ok(cfg) = load_from(filepath.Join(root, "src", "commands"), home)
  assert cfg.team == "REPO"
}

#[test]
fn the_walk_stops_at_the_git_root() {
  // No repo file at all: the stray one directory above the root must stay out
  // of reach, or it would silently capture every repo beneath it — a worse
  // bug than the cwd-only lookup the walk replaces.
  let assert Ok((root, home)) = fixture("", "url = \"http://home:9999\"\n")
  let assert Ok(from_root) = load_from(root, home)
  assert from_root.team == ""
  let assert Ok(from_sub) = load_from(filepath.Join(root, "src", "commands"), home)
  assert from_sub.team == ""
}

// -------------------------------------------------- the plain-directory walk

/// A temp tree with NO repo anywhere above it, standing in for a scratch
/// directory: `home/` is $HOME, `home/work/` the attached plain dir, and
/// `home/work/co/` a checkout inside it. Yields (base, home).
fn plain_fixture() -> Result<(string, string), string> {
  let Ok(tmp) = os.MkdirTemp("", "lll-plain") else {
    return Err("making a temp dir")
  }
  let Ok(base) = filepath.EvalSymlinks(tmp) else {
    return Err(f"resolving {tmp}")
  }
  let home = filepath.Join(base, "home")
  write(filepath.Join(home, ".config", "lll", "lll.toml"), "url = \"http://home:9999\"\n")?
  write(filepath.Join(home, "work", ".lll.toml"), "team = \"PLAIN\"\n")?
  if let Err(e) = os.MkdirAll(filepath.Join(home, "work", "sub", "deep"), 0o755) {
    return Err(f"making the subtree: {e}")
  }
  let co = filepath.Join(home, "work", "co")
  if let Err(e) = os.MkdirAll(filepath.Join(co, "src"), 0o755) {
    return Err(f"making {co}: {e}")
  }
  if let Err(e) = exec.Command("git", "-C", co, "init", "-q").Run() {
    return Err(f"git init in {co}: {e}")
  }
  Ok((base, home))
}

#[test]
fn a_plain_directory_inherits_its_team_down_the_subtree() {
  // TASK-212: outside a repo there is no git root to bound the walk, but a
  // scratch project's subdirectories still have to see the file attach wrote.
  let assert Ok((_, home)) = plain_fixture()
  let work = filepath.Join(home, "work")
  let assert Ok(here) = load_from(work, home)
  assert here.team == "PLAIN"
  let assert Ok(deep) = load_from(filepath.Join(work, "sub", "deep"), home)
  assert deep.team == "PLAIN"
  // And the home config still layers under it, as it does inside a repo.
  assert deep.url == "http://home:9999"
}

#[test]
fn the_plain_walk_stops_at_a_git_boundary() {
  // A checkout under an attached plain dir keeps its own answer: the repo's
  // committed team is the repo's business, and inheriting the enclosing
  // directory's would point a real project at a scratch team.
  let assert Ok((_, home)) = plain_fixture()
  let co = filepath.Join(home, "work", "co")
  let assert Ok(from_root) = load_from(co, home)
  assert from_root.team == ""
  let assert Ok(from_sub) = load_from(filepath.Join(co, "src"), home)
  assert from_sub.team == ""
}

#[test]
fn a_toml_directly_in_home_captures_nothing() {
  // $HOME is EXCLUSIVE: a file there would claim every project on the machine
  // by accident. ~/.config/lll/lll.toml is the deliberate way to say that.
  let assert Ok((_, home)) = plain_fixture()
  let assert Ok(()) = write(filepath.Join(home, ".lll.toml"), "team = \"HOMETOML\"\n")
  // A directory under $HOME but outside `work`, so the only .lll.toml above it
  // is the excluded one.
  let scratch = filepath.Join(home, "scratch")
  assert os.MkdirAll(scratch, 0o755).is_ok()
  let assert Ok(cfg) = load_from(scratch, home)
  assert cfg.team == ""
  // The machine config underneath it is untouched by that exclusion.
  assert cfg.url == "http://home:9999"
}

#[test]
fn a_toml_in_home_captures_nothing_from_home_itself() {
  // The exclusion has to hold when the working directory IS home, not just
  // when it is somewhere below: a cwd-first lookup would read the file the
  // rule above exists to skip, and every command run from ~ would silently
  // take that team.
  let assert Ok((_, home)) = plain_fixture()
  let assert Ok(()) = write(filepath.Join(home, ".lll.toml"), "team = \"HOMETOML\"\n")
  let assert Ok(cfg) = load_from(home, home)
  assert cfg.team == ""
  assert cfg.url == "http://home:9999"
}

// --------------------------------------------------------------- origins

#[test]
fn load_traced_names_the_file_each_value_came_from() {
  let assert Ok((root, home)) = fixture("team = \"REPO\"\n", "url = \"http://home:9999\"\n")
  let assert Ok((cfg, src)) = traced_from(root, home)
  assert cfg.team == "REPO"
  // The repo's file and the machine's are told apart by the type, not by
  // the file name (LLL-687).
  let assert Some(Source.RepoFile(team_file)) = src.team
  assert team_file.contains(".lll.toml")
  let assert Some(Source.HomeFile(url_file)) = src.url
  assert url_file.contains(filepath.Join("home", ".config", "lll", "lll.toml"))
  // Nothing named web_url, so `--list` must attribute it to the default.
  assert src.web_url == None
}

// LLL-687 review: a repo file naming the same url as the home config is
// still the one that wins, so it is the source the hints name: editing the
// home file would change nothing.
#[test]
fn a_repo_file_repeating_the_home_value_is_still_its_source() {
  let assert Ok((root, home)) = fixture(
    "url = \"http://same:1\"\ntoken = \"tok\"\n",
    "url = \"http://same:1\"\ntoken = \"tok\"\nteam = \"HOME\"\n",
  )
  let assert Ok((cfg, src)) = traced_from(root, home)
  assert cfg.url == "http://same:1"
  let assert Some(Source.RepoFile(_)) = src.url
  let assert Some(Source.RepoFile(_)) = src.token
  // A key the repo file does not name stays the home file's.
  let assert Some(Source.HomeFile(_)) = src.team
}

// LLL-687 review: `key = ""` names nothing. Uncommenting the template's
// `# token = ""` must not make the repo file a token's source, or `config
// list` warns about a committed token that does not exist.
#[test]
fn an_empty_value_does_not_make_a_file_the_source() {
  let assert Ok((root, home)) = fixture("sort = \"\"\ntoken = \"\"\n", "")
  let assert Ok((cfg, src)) = traced_from(root, home)
  assert cfg.sort == ""
  assert cfg.token == ""
  assert src.sort == None
  assert src.token == None
}

// The decoder takes `URL` for url, so the source must too.
#[test]
fn a_key_spelled_in_another_case_still_names_its_file() {
  let assert Ok((root, home)) = fixture("URL = \"http://same:1\"\n", "url = \"http://same:1\"\n")
  let assert Ok((cfg, src)) = traced_from(root, home)
  assert cfg.url == "http://same:1"
  let assert Some(Source.RepoFile(_)) = src.url
}

// ------------------------------------------------------------- web_url

#[test]
fn an_api_url_does_not_invent_a_board_endpoint() {
  for base in ["http://127.0.0.1:49000", "https://tracker.example.com:8091"] {
    let assert Ok((root, home)) = fixture("team = \"REPO\"\n", f"url = \"{base}\"\n")
    let assert Ok((cfg, src)) = traced_from(root, home)
    assert cfg.web_url == ""
    assert src.web_url == None
  }
}

// ----------------------------------------------------------------- token

#[test]
fn a_repo_file_without_token_keeps_the_home_one() {
  // TASK-179: token layers exactly like url — a committed repo file
  // carrying 'team' alone must not throw away the machine's secret.
  let assert Ok((root, home)) = fixture(
    "team = \"REPO\"\n",
    "url = \"http://home:9999\"\ntoken = \"home-token\"\n",
  )
  let assert Ok((cfg, src)) = traced_from(root, home)
  assert cfg.token == "home-token"
  let assert Some(Source.HomeFile(token_file)) = src.token
  assert token_file.contains(filepath.Join("home", ".config", "lll", "lll.toml"))
}

#[test]
fn the_repo_file_overrides_the_home_token() {
  let assert Ok((root, home)) = fixture(
    "token = \"repo-token\"\n",
    "token = \"home-token\"\n",
  )
  let assert Ok(cfg) = load_from(root, home)
  assert cfg.token == "repo-token"
}

#[test]
fn lll_token_beats_both_files_and_is_traced_to_the_env() {
  let assert Ok((root, home)) = fixture(
    "token = \"repo-token\"\n",
    "token = \"home-token\"\n",
  )
  let assert Ok((cfg, src)) = traced_with(root, Env { home, token: "env-token", .. })
  assert cfg.token == "env-token"
  assert src.token == Some(Source.Env("LLL_TOKEN"))
}

// ------------------------------------------------- precedence (LLL-486)
//
// Precedence is computed in one place, `resolve`, from values: flags >
// env > the repo's .lll.toml > the home config > the default url. These pin
// it one key at a time, because the env override is written out per field
// and a forgotten key would otherwise go unnoticed.

#[test]
fn every_env_var_overrides_its_file_key_and_is_traced_to_the_env() {
  let assert Ok((root, home)) = fixture(
    "team = \"REPO\"\n",
    "url = \"http://home:9999\"\nsort = \"-updated\"\nweb_url = \"http://home:8080\"\n",
  )
  let env = Env {
    home,
    url: "http://env:1111",
    team: "ENVTEAM",
    sort: "priority",
    web_url: "http://env:2222",
    ..
  }
  let assert Ok((cfg, src)) = traced_with(root, env)
  assert cfg.url == "http://env:1111"
  assert cfg.team == "ENVTEAM"
  assert cfg.sort == "priority"
  assert cfg.web_url == "http://env:2222"
  assert src.url == Some(Source.Env("LLL_URL"))
  assert src.team == Some(Source.Env("LLL_TEAM"))
  assert src.sort == Some(Source.Env("LLL_SORT"))
  assert src.web_url == Some(Source.Env("LLL_WEB_URL"))
}

#[test]
fn an_empty_env_var_cannot_clear_a_file_value() {
  // Each override is gated on != "", so an exported-but-empty variable is
  // indistinguishable from an unset one and the file still wins.
  let assert Ok((root, home)) = fixture(
    "team = \"REPO\"\n",
    "url = \"http://home:9999\"\ntoken = \"home-token\"\n",
  )
  let assert Ok((cfg, src)) = traced_from(root, home)
  assert cfg.token == "home-token"
  assert cfg.url == "http://home:9999"
  assert cfg.team == "REPO"
  assert src.token != Some(Source.Env("LLL_TOKEN"))
  assert src.url != Some(Source.Env("LLL_URL"))
  assert src.team != Some(Source.Env("LLL_TEAM"))
}

#[test]
fn the_default_url_applies_only_when_nothing_supplied_one() {
  let assert Ok((root, home)) = fixture("team = \"REPO\"\n", "")
  let assert Ok((cfg, src)) = traced_from(root, home)
  assert cfg.url == "http://127.0.0.1:8090"
  assert src.url == Some(Source.Default)
  let assert Ok((root2, home2)) = fixture("team = \"REPO\"\n", "url = \"http://home:9999\"\n")
  let assert Ok((cfg2, src2)) = traced_from(root2, home2)
  assert cfg2.url == "http://home:9999"
  assert src2.url != Some(Source.Default)
}

#[test]
fn a_team_flag_beats_lll_team_and_is_attributed_to_the_flag() {
  // T7: the attribution comes from the value. LLL_TEAM_FROM_FLAG is gone,
  // so an inherited environment cannot claim a --team nobody typed.
  let assert Ok((root, home)) = fixture("team = \"REPO\"\n", "")
  let env = Env { home, team: "ENVTEAM", .. }
  let flagged = Overrides { team: Some("FLAG"), ..no_overrides() }
  let assert Ok(s) = settings_in(root, env, flagged)
  let assert Ok((cfg, src)) = s.traced()
  assert cfg.team == "FLAG"
  assert src.team == Some(Source.Flag("--team"))
  // Without the flag, the same environment is attributed to LLL_TEAM.
  let assert Ok((cfg2, src2)) = traced_with(root, env)
  assert cfg2.team == "ENVTEAM"
  assert src2.team == Some(Source.Env("LLL_TEAM"))
}

#[test]
fn a_url_flag_beats_lll_url() {
  let assert Ok((root, home)) = fixture("", "url = \"http://home:9999\"\n")
  let env = Env { home, url: "http://env:1111", .. }
  let assert Ok(s) = settings_in(root, env, no_overrides())
  let assert Ok((cfg, src)) = s.with_url("http://flag:3333").traced()
  assert cfg.url == "http://flag:3333"
  assert src.url == Some(Source.Flag("--url"))
  // The token and the other keys are untouched by the url override.
  let assert Ok((plain, _)) = s.traced()
  assert plain.url == "http://env:1111"
}

#[test]
fn the_config_root_is_lll_config_home_then_xdg_then_home() {
  let env = Env { home: "/h", .. }
  let assert Ok(home_only) = resolve(env, no_overrides()).home_path()
  assert home_only == "/h/.config/lll/lll.toml"
  let xdg = Env { home: "/h", xdg_config_home: "/x", .. }
  let assert Ok(from_xdg) = resolve(xdg, no_overrides()).home_path()
  assert from_xdg == "/x/lll/lll.toml"
  let both = Env { home: "/h", xdg_config_home: "/x", config_home: " /c ", .. }
  let assert Ok(from_lll) = resolve(both, no_overrides()).home_path()
  assert from_lll == "/c/lll/lll.toml"
  let assert Err(_) = resolve(Env { .. }, no_overrides()).home_path()
}

#[test]
fn lll_config_home_reaches_a_config_outside_home() {
  // LLL-400's harness case, as a value: a config root that is not $HOME.
  let assert Ok((root, home)) = fixture("team = \"REPO\"\n", "url = \"http://home:9999\"\n")
  let assert Ok(elsewhere) = os.MkdirTemp("", "lll-elsewhere")
  let assert Ok(_) = write(
    filepath.Join(elsewhere, "lll", "lll.toml"),
    "url = \"http://elsewhere:1\"\ntoken = \"elsewhere-token\"\n",
  )
  let assert Ok((cfg, src)) = traced_with(root, Env { home, config_home: elsewhere, .. })
  assert cfg.url == "http://elsewhere:1"
  assert cfg.token == "elsewhere-token"
  assert src.url == Some(Source.HomeFile(filepath.Join(elsewhere, "lll", "lll.toml")))
  assert cfg.team == "REPO"
}

#[test]
fn load_home_reads_the_machine_file_alone() {
  // The one reader that deliberately ignores the repo file and the
  // environment: login compares the saved pair to detect a server switch.
  let assert Ok((root, home)) = fixture(
    "team = \"REPO\"\nurl = \"http://repo:7777\"\n",
    "url = \"http://home:9999\"\nteam = \"HOME\"\n",
  )
  let env = Env { home, url: "http://env:1111", .. }
  let assert Ok(s) = settings_in(root, env, no_overrides())
  let assert Ok(cfg) = s.load_home()
  assert cfg.url == "http://home:9999"
  assert cfg.team == "HOME"
}

#[test]
fn a_broken_file_fails_the_reads_not_the_settings() {
  // `lll --help` and `lll config init` must still work beside a file that
  // does not parse; the error is returned where configuration is read.
  let assert Ok((root, home)) = fixture("team = \n", "")
  let assert Ok(s) = settings_in(root, env_at(home), no_overrides())
  let assert Err(e) = s.traced()
  assert e.contains("parsing")
  let assert Err(_) = s.config()
  let assert Ok(_) = s.home_path()
}

#[test]
fn the_admin_pair_counts_only_whole() {
  let half = resolve(Env { admin_email: "a@x", .. }, no_overrides())
  assert half.admin().is_none()
  let whole = resolve(Env { admin_email: "a@x", admin_password: "pw", .. }, no_overrides())
  let assert Some(pair) = whole.admin()
  assert pair.email == "a@x"
  // What lll up started its server with outranks the environment's pair.
  let boot = whole.with_admin(AdminCreds { email: "boot@x", password: "b" })
  let assert Some(booted) = boot.admin()
  assert booted.email == "boot@x"
}

#[test]
fn bind_and_board_token_default_from_the_environment() {
  let s = resolve(Env { .. }, no_overrides())
  assert s.bind() == "127.0.0.1"
  assert s.board_token() == ""
  let env = resolve(Env { bind: "10.0.0.2", board_token: "envtok", .. }, no_overrides())
  assert env.bind() == "10.0.0.2"
  assert env.board_token() == "envtok"
  let boot = env.with_bind("10.0.0.3").with_board_token("boottok")
  assert boot.bind() == "10.0.0.3"
  assert boot.board_token() == "boottok"
}

#[test]
fn given_settings_read_no_file_and_no_environment() {
  // What command tests build: exactly the configuration they name.
  let s = given(Config { url: "http://t:1", team: "T", .. }, Sources { url: Some(Source.Env("TEST")), .. }, Env { .. })
  let assert Ok((cfg, src)) = s.traced()
  assert cfg.url == "http://t:1"
  assert cfg.team == "T"
  assert src.url == Some(Source.Env("TEST"))
  let assert Ok((cfg2, src2)) = s.with_team("OTHER").traced()
  assert cfg2.team == "OTHER"
  assert src2.team == Some(Source.Flag("--team"))
}

#[test]
fn repeated_resolution_from_one_directory_agrees() {
  let assert Ok((root, home)) = fixture("team = \"REPO\"\n", "url = \"http://home:9999\"\ntoken = \"t\"\n")
  let assert Ok(a) = load_from(root, home)
  let assert Ok(b) = load_from(filepath.Join(root, "src"), home)
  let assert Ok(c) = load_from(root, home)
  assert a.team == b.team && b.team == c.team
  assert a.url == b.url && b.url == c.url
  assert a.token == b.token && b.token == c.token
}

// LLL-687: what `lll config list` prints for each source. These are the
// strings the origins were before they were typed; the column and its JSON
// field keep them.
#[test]
fn each_source_prints_as_it_always_has() {
  let rows: Slice<(Option<Source>, string)> = [
    (Some(Source.Flag("--team")), "flag:--team"),
    (Some(Source.Env("LLL_URL")), "env:LLL_URL"),
    (Some(Source.RepoFile(".lll.toml")), "file:.lll.toml"),
    (Some(Source.HomeFile("/h/.config/lll/lll.toml")), "file:/h/.config/lll/lll.toml"),
    (Some(Source.Default), "default"),
    (None, ""),
  ]
  for (source, shown) in rows {
    assert origin(source) == shown
  }
}
