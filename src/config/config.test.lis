import "go:os"
import "go:os/exec"
import "go:path/filepath"

// Cover for the two rules TASK-168 turns on: config files LAYER, and the
// search for the repo file stops at the git root.
//
// These tests touch the filesystem, $HOME and the working directory, because
// that is exactly what they are about — a pure test of load() would prove
// nothing about which file it reads.

// ----------------------------------------------------------------- ceiling

#[test]
fn within_accepts_the_root_and_what_is_under_it() {
  assert within("/a/repo", "/a/repo")
  assert within("/a/repo/src", "/a/repo")
  assert within("/a/repo/src/commands", "/a/repo")
}

#[test]
fn within_rejects_parents_and_prefix_lookalikes() {
  assert !within("/a", "/a/repo")
  assert !within("/", "/a/repo")
  // The one a bare HasPrefix would get wrong: a sibling whose name starts
  // with the root's.
  assert !within("/a/repository", "/a/repo")
}

// ---------------------------------------------------------------- fixtures

/// A temp tree: a git repo carrying `repo_toml`, a home config carrying
/// `home_toml` (either skipped when ""), and a stray `.lll.toml` one level
/// ABOVE the repo root — the trap the ceiling exists for. Yields (root, home).
fn fixture(repo_toml: string, home_toml: string) -> Result<(string, string), string> {
  let Ok(tmp) = os.MkdirTemp("", "lll-config") else {
    return Err("making a temp dir")
  }
  // Resolved, so the walk's comparisons match what git reports on a machine
  // whose temp directory is itself a symlink (macOS /tmp).
  let Ok(base) = filepath.EvalSymlinks(tmp) else {
    return Err(f"resolving {tmp}")
  }

  let home = filepath.Join(base, "home")
  write(filepath.Join(home, ".config", "lll", "lll.toml"), home_toml)?
  write(filepath.Join(base, ".lll.toml"), "team = \"STRAY\"\n")?

  let root = filepath.Join(base, "repo")
  if let Err(e) = os.MkdirAll(filepath.Join(root, "src", "commands"), 0o755) {
    return Err(f"making {root}: {e}")
  }
  if let Err(e) = exec.Command("git", "-C", root, "init", "-q").Run() {
    return Err(f"git init in {root}: {e}")
  }
  write(filepath.Join(root, ".lll.toml"), repo_toml)?
  Ok((root, home))
}

/// Write `text` to `path`, creating its directory. Empty text writes nothing:
/// an absent file is a case these tests need.
fn write(path: string, text: string) -> Result<(), string> {
  let dir = filepath.Dir(path)
  if let Err(e) = os.MkdirAll(dir, 0o755) {
    return Err(f"making {dir}: {e}")
  }
  if text == "" { return Ok(()) }
  if let Err(e) = os.WriteFile(path, text.bytes(), 0o644) {
    return Err(f"writing {path}: {e}")
  }
  Ok(())
}

/// One saved environment variable, remembering whether it was set at all: an
/// unset variable must be restored unset, not set to "".
struct EnvVar {
  name: string,
  value: Option<string>,
}

/// Every variable config resolution consults — the config root (config.lis
/// `config_root`) and the per-key overrides (`load_traced`).
fn config_env_names() -> Slice<string> {
  [
    "HOME",
    "LLL_CONFIG_HOME",
    "XDG_CONFIG_HOME",
    "LLL_URL",
    "LLL_TEAM",
    "LLL_ME",
    "LLL_SORT",
    "LLL_WEB_URL",
    "LLL_TOKEN",
  ]
}

/// Save every variable above and clear it. Setting $HOME is not enough: the
/// reader honours LLL_CONFIG_HOME and XDG_CONFIG_HOME first, and the per-key
/// LLL_* variables override files outright — so a developer's own config and
/// exported token reached these tests and failed eight of them (LLL-449).
fn isolate_config_env() -> Slice<EnvVar> {
  let saved = config_env_names().map(|name| EnvVar {
    name,
    value: os.LookupEnv(name),
  })
  for v in saved {
    let _ = os.Unsetenv(v.name)
  }
  saved
}

fn restore_config_env(saved: Slice<EnvVar>) {
  for v in saved {
    match v.value {
      Some(text) => {
        let _ = os.Setenv(v.name, text)
      },
      None => {
        let _ = os.Unsetenv(v.name)
      },
    }
  }
}

/// Run `load_traced()` from `dir` with `home` as $HOME and nothing else the
/// reader consults left set, restoring the working directory and the whole
/// environment after. `token`, when given, is exported as LLL_TOKEN.
fn traced_in(
  dir: string,
  home: string,
  token: Option<string>,
) -> Result<(Config, Sources), string> {
  let Ok(prev_dir) = os.Getwd() else {
    return Err("reading the working directory")
  }
  let saved = isolate_config_env()
  defer restore(prev_dir, saved)
  if let Err(e) = os.Chdir(dir) {
    return Err(f"entering {dir}: {e}")
  }
  let _ = os.Setenv("HOME", home)
  if let Some(text) = token {
    let _ = os.Setenv("LLL_TOKEN", text)
  }
  load_traced()
}

fn traced_from(dir: string, home: string) -> Result<(Config, Sources), string> {
  traced_in(dir, home, None)
}

fn load_from(dir: string, home: string) -> Result<Config, string> {
  let (cfg, _) = traced_from(dir, home)?
  Ok(cfg)
}

fn restore(dir: string, saved: Slice<EnvVar>) {
  let _ = os.Chdir(dir)
  restore_config_env(saved)
}

// ---------------------------------------------------------------- layering

#[test]
fn repo_file_supplies_team_without_losing_the_home_url_and_sort() {
  let assert Ok((root, home)) = fixture(
    "team = \"REPO\"\n",
    "url = \"http://home:9999\"\nme = \"homer\"\nsort = \"-updated\"\n",
  )
  let assert Ok(cfg) = load_from(root, home)
  assert cfg.team == "REPO"
  // First-wins threw all three away the moment a repo file existed, which is
  // what made a committed repo file impossible.
  assert cfg.url == "http://home:9999"
  assert cfg.sort == "-updated"
}

#[test]
fn the_repo_file_overrides_the_home_file_key_by_key() {
  let assert Ok((root, home)) = fixture(
    "team = \"REPO\"\n",
    "url = \"http://home:9999\"\nteam = \"HOME\"\n",
  )
  let assert Ok(cfg) = load_from(filepath.Join(root, "src"), home)
  assert cfg.team == "REPO"
  assert cfg.url == "http://home:9999"
}

// -------------------------------------------------------------- the walk

#[test]
fn a_subdirectory_finds_the_repo_root_file() {
  let assert Ok((root, home)) = fixture("team = \"REPO\"\n", "url = \"http://home:9999\"\n")
  let assert Ok(cfg) = load_from(filepath.Join(root, "src", "commands"), home)
  assert cfg.team == "REPO"
}

#[test]
fn the_walk_stops_at_the_git_root() {
  // No repo file at all: the stray one directory above the root must stay out
  // of reach, or it would silently capture every repo beneath it — a worse
  // bug than the cwd-only lookup the walk replaces.
  let assert Ok((root, home)) = fixture("", "url = \"http://home:9999\"\n")
  let assert Ok(from_root) = load_from(root, home)
  assert from_root.team == ""
  let assert Ok(from_sub) = load_from(filepath.Join(root, "src", "commands"), home)
  assert from_sub.team == ""
}

// -------------------------------------------------- the plain-directory walk

/// A temp tree with NO repo anywhere above it, standing in for a scratch
/// directory: `home/` is $HOME, `home/work/` the attached plain dir, and
/// `home/work/co/` a checkout inside it. Yields (base, home).
fn plain_fixture() -> Result<(string, string), string> {
  let Ok(tmp) = os.MkdirTemp("", "lll-plain") else {
    return Err("making a temp dir")
  }
  let Ok(base) = filepath.EvalSymlinks(tmp) else {
    return Err(f"resolving {tmp}")
  }
  let home = filepath.Join(base, "home")
  write(filepath.Join(home, ".config", "lll", "lll.toml"), "url = \"http://home:9999\"\n")?
  write(filepath.Join(home, "work", ".lll.toml"), "team = \"PLAIN\"\n")?
  if let Err(e) = os.MkdirAll(filepath.Join(home, "work", "sub", "deep"), 0o755) {
    return Err(f"making the subtree: {e}")
  }
  let co = filepath.Join(home, "work", "co")
  if let Err(e) = os.MkdirAll(filepath.Join(co, "src"), 0o755) {
    return Err(f"making {co}: {e}")
  }
  if let Err(e) = exec.Command("git", "-C", co, "init", "-q").Run() {
    return Err(f"git init in {co}: {e}")
  }
  Ok((base, home))
}

#[test]
fn a_plain_directory_inherits_its_team_down_the_subtree() {
  // TASK-212: outside a repo there is no git root to bound the walk, but a
  // scratch project's subdirectories still have to see the file attach wrote.
  let assert Ok((_, home)) = plain_fixture()
  let work = filepath.Join(home, "work")
  let assert Ok(here) = load_from(work, home)
  assert here.team == "PLAIN"
  let assert Ok(deep) = load_from(filepath.Join(work, "sub", "deep"), home)
  assert deep.team == "PLAIN"
  // And the home config still layers under it, as it does inside a repo.
  assert deep.url == "http://home:9999"
}

#[test]
fn the_plain_walk_stops_at_a_git_boundary() {
  // A checkout under an attached plain dir keeps its own answer: the repo's
  // committed team is the repo's business, and inheriting the enclosing
  // directory's would point a real project at a scratch team.
  let assert Ok((_, home)) = plain_fixture()
  let co = filepath.Join(home, "work", "co")
  let assert Ok(from_root) = load_from(co, home)
  assert from_root.team == ""
  let assert Ok(from_sub) = load_from(filepath.Join(co, "src"), home)
  assert from_sub.team == ""
}

#[test]
fn a_toml_directly_in_home_captures_nothing() {
  // $HOME is EXCLUSIVE: a file there would claim every project on the machine
  // by accident. ~/.config/lll/lll.toml is the deliberate way to say that.
  let assert Ok((_, home)) = plain_fixture()
  let assert Ok(()) = write(filepath.Join(home, ".lll.toml"), "team = \"HOMETOML\"\n")
  // A directory under $HOME but outside `work`, so the only .lll.toml above it
  // is the excluded one.
  let scratch = filepath.Join(home, "scratch")
  assert os.MkdirAll(scratch, 0o755).is_ok()
  let assert Ok(cfg) = load_from(scratch, home)
  assert cfg.team == ""
  // The machine config underneath it is untouched by that exclusion.
  assert cfg.url == "http://home:9999"
}

#[test]
fn a_toml_in_home_captures_nothing_from_home_itself() {
  // The exclusion has to hold when the working directory IS home, not just
  // when it is somewhere below: a cwd-first lookup would read the file the
  // rule above exists to skip, and every command run from ~ would silently
  // take that team.
  let assert Ok((_, home)) = plain_fixture()
  let assert Ok(()) = write(filepath.Join(home, ".lll.toml"), "team = \"HOMETOML\"\n")
  let assert Ok(cfg) = load_from(home, home)
  assert cfg.team == ""
  assert cfg.url == "http://home:9999"
}

// --------------------------------------------------------------- origins

#[test]
fn load_traced_names_the_file_each_value_came_from() {
  let assert Ok((root, home)) = fixture("team = \"REPO\"\n", "url = \"http://home:9999\"\n")
  let assert Ok((cfg, src)) = traced_from(root, home)
  assert cfg.team == "REPO"
  assert src.team.contains(".lll.toml")
  assert src.url.contains(filepath.Join("home", ".config", "lll", "lll.toml"))
  // Nothing named web_url, so `--list` must attribute it to the default.
  assert src.web_url == ""
}

// ------------------------------------------------------------- web_url

#[test]
fn an_api_url_does_not_invent_a_board_endpoint() {
  for base in ["http://127.0.0.1:49000", "https://tracker.example.com:8091"] {
    let assert Ok((root, home)) = fixture("team = \"REPO\"\n", f"url = \"{base}\"\n")
    let assert Ok((cfg, src)) = traced_from(root, home)
    assert cfg.web_url == ""
    assert src.web_url == ""
  }
}

// ----------------------------------------------------------------- token

#[test]
fn a_repo_file_without_token_keeps_the_home_one() {
  // TASK-179: token layers exactly like url — a committed repo file
  // carrying 'team' alone must not throw away the machine's secret.
  let assert Ok((root, home)) = fixture(
    "team = \"REPO\"\n",
    "url = \"http://home:9999\"\ntoken = \"home-token\"\n",
  )
  let assert Ok((cfg, src)) = traced_from(root, home)
  assert cfg.token == "home-token"
  assert src.token.contains(filepath.Join("home", ".config", "lll", "lll.toml"))
}

#[test]
fn the_repo_file_overrides_the_home_token() {
  let assert Ok((root, home)) = fixture(
    "token = \"repo-token\"\n",
    "token = \"home-token\"\n",
  )
  let assert Ok(cfg) = load_from(root, home)
  assert cfg.token == "repo-token"
}

#[test]
fn lll_token_beats_both_files_and_is_traced_to_the_env() {
  let assert Ok((root, home)) = fixture(
    "token = \"repo-token\"\n",
    "token = \"home-token\"\n",
  )
  let assert Ok((cfg, src)) = traced_with_token(root, home, "env-token")
  assert cfg.token == "env-token"
  assert src.token == "env:LLL_TOKEN"
}

fn traced_with_token(
  dir: string,
  home: string,
  token: string,
) -> Result<(Config, Sources), string> {
  traced_in(dir, home, Some(token))
}

// ------------------------------------------------------------- isolation

#[test]
fn a_real_home_config_and_exported_env_cannot_reach_these_tests() {
  // The guard for LLL-449. Eight tests above read the developer's own
  // ~/.config/lll/lll.toml and exported LLL_* instead of the fixture, because
  // setting $HOME does not cover LLL_CONFIG_HOME, XDG_CONFIG_HOME or the
  // per-key overrides. Poison every one of them; the fixture must still win.
  let assert Ok((root, home)) = fixture(
    "team = \"REPO\"\n",
    "url = \"http://home:9999\"\nme = \"homer\"\nsort = \"-updated\"\n",
  )
  let assert Ok(elsewhere) = os.MkdirTemp("", "lll-elsewhere")
  let assert Ok(_) = write(
    filepath.Join(elsewhere, "lll", "lll.toml"),
    "url = \"http://elsewhere:1\"\nme = \"stranger\"\ntoken = \"real-token\"\n",
  )

  let saved = isolate_config_env()
  defer restore_config_env(saved)
  let _ = os.Setenv("LLL_CONFIG_HOME", elsewhere)
  let _ = os.Setenv("XDG_CONFIG_HOME", elsewhere)
  let _ = os.Setenv("LLL_URL", "http://exported:2")
  let _ = os.Setenv("LLL_TEAM", "EXPORTED")
  let _ = os.Setenv("LLL_ME", "exported")
  let _ = os.Setenv("LLL_SORT", "-exported")
  let _ = os.Setenv("LLL_WEB_URL", "http://exported-board:3")
  let _ = os.Setenv("LLL_TOKEN", "exported-token")

  let assert Ok(cfg) = load_from(root, home)
  assert cfg.team == "REPO"
  assert cfg.url == "http://home:9999"
  assert cfg.sort == "-updated"
  assert cfg.web_url == ""
  // The one that printed a real hosted token into a failure message.
  assert cfg.token == ""
}

// ------------------------------------------- characterization: LLL-486
//
// Pinned BEFORE threading Config through the call sites (LLL-486), so the
// refactor has to prove it changed nothing. Every assertion here passes on
// the ambient-config code these were written against.
//
// The file-layering rules above are already covered. What was not covered is
// the half the refactor actually moves: per-key environment precedence, the
// rule that an env var can only ADD a value and never clear one, and the
// `--team` override, which today is process-environment mutation
// (scope.lis:22) rather than a value anyone passes.

/// `traced_in`, for any set of variables rather than LLL_TOKEN alone. The
/// fixture's $HOME is applied first, so a caller may override it.
fn traced_with_env(
  dir: string,
  home: string,
  vars: Slice<(string, string)>,
) -> Result<(Config, Sources), string> {
  let Ok(prev_dir) = os.Getwd() else {
    return Err("reading the working directory")
  }
  let saved = isolate_config_env()
  defer restore(prev_dir, saved)
  if let Err(e) = os.Chdir(dir) { return Err(f"entering {dir}: {e}") }
  let _ = os.Setenv("HOME", home)
  for pair in vars {
    let (name, value) = pair
    let _ = os.Setenv(name, value)
  }
  load_traced()
}

#[test]
fn every_env_var_overrides_its_file_key_and_is_traced_to_the_env() {
  // One case per key, because the override is written out per field in
  // load_traced rather than driven by a table: a key can be forgotten there
  // and nothing else would notice.
  let assert Ok((root, home)) = fixture(
    "team = \"REPO\"\n",
    "url = \"http://home:9999\"\nsort = \"-updated\"\nweb_url = \"http://home:8080\"\n",
  )
  let assert Ok((cfg, src)) = traced_with_env(root, home, [
    ("LLL_URL", "http://env:1111"),
    ("LLL_TEAM", "ENVTEAM"),
    ("LLL_SORT", "priority"),
    ("LLL_WEB_URL", "http://env:2222"),
  ])
  assert cfg.url == "http://env:1111"
  assert cfg.team == "ENVTEAM"
  assert cfg.sort == "priority"
  assert cfg.web_url == "http://env:2222"
  assert src.url == "env:LLL_URL"
  assert src.team == "env:LLL_TEAM"
  assert src.sort == "env:LLL_SORT"
  assert src.web_url == "env:LLL_WEB_URL"
}

#[test]
fn an_empty_env_var_cannot_clear_a_file_value() {
  // load_traced gates each override on `!= ""`, so an exported-but-empty
  // variable is indistinguishable from an unset one and the file still wins.
  // This is why `LLL_TOKEN= lll up` cannot shed an inherited hosted token,
  // and why isolating a throwaway board needs LLL_CONFIG_HOME instead
  // (LLL-487). Pinned as current behaviour, not endorsed: if threading ever
  // makes clearing expressible, this test is the one that must change, and
  // changing it should be a deliberate decision rather than a side effect.
  let assert Ok((root, home)) = fixture(
    "team = \"REPO\"\n",
    "url = \"http://home:9999\"\ntoken = \"home-token\"\n",
  )
  let assert Ok((cfg, src)) = traced_with_env(root, home, [
    ("LLL_TOKEN", ""),
    ("LLL_URL", ""),
    ("LLL_TEAM", ""),
  ])
  assert cfg.token == "home-token"
  assert cfg.url == "http://home:9999"
  assert cfg.team == "REPO"
  // Traced to the file, not to the empty variable that failed to override it.
  assert src.token != "env:LLL_TOKEN"
  assert src.url != "env:LLL_URL"
  assert src.team != "env:LLL_TEAM"
}

#[test]
fn the_default_url_applies_only_when_nothing_supplied_one() {
  let assert Ok((root, home)) = fixture("team = \"REPO\"\n", "")
  let assert Ok((cfg, src)) = traced_from(root, home)
  assert cfg.url == "http://127.0.0.1:8090"
  assert src.url == "default"
  // A supplied url keeps its own origin rather than picking up "default".
  let assert Ok((root2, home2)) = fixture(
    "team = \"REPO\"\n",
    "url = \"http://home:9999\"\n",
  )
  let assert Ok((cfg2, src2)) = traced_from(root2, home2)
  assert cfg2.url == "http://home:9999"
  assert src2.url != "default"
}

#[test]
fn load_and_load_traced_agree_on_every_field() {
  // `--list` explains what the rest of the CLI uses only while these two stay
  // the same code path. Threading must not let them drift apart.
  let assert Ok((root, home)) = fixture(
    "team = \"REPO\"\n",
    "url = \"http://home:9999\"\nsort = \"-updated\"\ntoken = \"home-token\"\n",
  )
  let assert Ok(plain) = load_from(root, home)
  let assert Ok((traced, _)) = traced_from(root, home)
  assert plain.url == traced.url
  assert plain.team == traced.team
  assert plain.sort == traced.sort
  assert plain.web_url == traced.web_url
  assert plain.token == traced.token
}

#[test]
fn load_home_reads_the_machine_file_alone() {
  // The one reader that deliberately ignores the repo file and the
  // environment: login compares the saved pair to detect a server switch, so
  // it must not see an override. Threading gives every other reader a passed
  // value; this one keeps reading a specific file, and that difference is the
  // point.
  let assert Ok((root, home)) = fixture(
    "team = \"REPO\"\nurl = \"http://repo:7777\"\n",
    "url = \"http://home:9999\"\nteam = \"HOME\"\n",
  )
  let assert Ok(prev_dir) = os.Getwd()
  let saved = isolate_config_env()
  defer restore(prev_dir, saved)
  let assert Ok(()) = os.Chdir(root)
  let _ = os.Setenv("HOME", home)
  let _ = os.Setenv("LLL_URL", "http://env:1111")
  let assert Ok(cfg) = load_home()
  // Neither the repo file nor the environment reaches it.
  assert cfg.url == "http://home:9999"
  assert cfg.team == "HOME"
}

#[test]
fn repeated_loads_from_one_directory_agree() {
  // Config is re-derived at 41 call sites today, so a single command resolves
  // it many times and every one must land on the same answer. After threading
  // this is true by construction; today it is a property worth pinning,
  // because it is what makes the refactor behaviour-preserving rather than
  // behaviour-changing.
  let assert Ok((root, home)) = fixture(
    "team = \"REPO\"\n",
    "url = \"http://home:9999\"\ntoken = \"home-token\"\n",
  )
  let assert Ok(first) = load_from(root, home)
  let assert Ok(second) = load_from(root, home)
  let assert Ok(third) = load_from(filepath.Join(root, "src"), home)
  assert first.url == second.url
  assert first.team == second.team
  assert first.token == second.token
  // A subdirectory of the same repo resolves to the same values, which is
  // what lets a deep call site load config without knowing where it stands.
  assert third.url == first.url
  assert third.team == first.team
}
