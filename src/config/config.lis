import "go:github.com/BurntSushi/toml"
import "go:os"
import "go:os/exec"
import "go:path/filepath"
import "go:strings"

#[json]
#[toml]
pub struct Config {
  pub url: string,
  pub team: string,
  pub sort: string,
  pub web_url: string,
  pub token: string,
}

/// Where each field's winning value came from, None when nothing set it.
/// Filled in lockstep with the Config it explains and printed by `lll config
/// list`. The failure it exists for is silent — a repo pointed at the wrong
/// team lists the wrong issues and reports no error — so "which file won?"
/// has to be a question you can ask.
pub struct Sources {
  pub url: Option<Source>,
  pub team: Option<Source>,
  pub sort: Option<Source>,
  pub web_url: Option<Source>,
  pub token: Option<Source>,
}

/// One layer of the precedence `resolve` applies (LLL-687). Every message
/// that says how to change a setting matches on this, with no wildcard arm,
/// so a new layer cannot ship until each of those messages says what fixes a
/// value that came from it. It replaced origin strings ("env:LLL_URL",
/// "file:<path>") that the messages took apart by prefix and suffix.
pub enum Source {
  /// A command-line flag, by its spelling ("--team"). `lll up` choosing its
  /// own API url counts as --url.
  Flag(string),
  /// An environment variable, by name ("LLL_URL").
  Env(string),
  /// A `.lll.toml` found from the working directory: a repo's, or a plain
  /// directory's. It outranks the machine's file, so 'lll config set' and
  /// 'lll login' cannot override what it says.
  RepoFile(string),
  /// The machine's config file, the one 'lll config set' and 'lll login'
  /// write.
  HomeFile(string),
  /// The built-in url, chosen by nobody.
  Default,
}

/// A source as `lll config list` prints it: "flag:--team", "env:LLL_X",
/// "file:<path>", "default", or "" when nothing set the value.
pub fn origin(source: Option<Source>) -> string {
  match source {
    None => "",
    Some(Source.Flag(spelling)) => f"flag:{spelling}",
    Some(Source.Env(name)) => f"env:{name}",
    Some(Source.RepoFile(path)) | Some(Source.HomeFile(path)) => f"file:{path}",
    Some(Source.Default) => "default",
  }
}

/// The environment this process was handed, read once (LLL-486). Every
/// value lll takes from its environment is a field here, and `read_env` is
/// the only function in src/ that reads one. A test builds an Env literal
/// instead of mutating the real environment, and nothing lll does later can
/// change it: no os.Setenv carries state, so a child process (gh, git, a
/// browser opener) inherits exactly what lll's own parent gave it.
pub struct Env {
  /// LLL_URL, LLL_TEAM, LLL_SORT, LLL_WEB_URL and LLL_TOKEN: the per-key
  /// overrides of the config files. Empty means unset; an empty variable
  /// cannot clear a file value.
  pub url: string,
  pub team: string,
  pub sort: string,
  pub web_url: string,
  pub token: string,
  /// LLL_CONFIG_HOME, then XDG_CONFIG_HOME, then home/.config: the root of
  /// the machine config.
  pub config_home: string,
  pub xdg_config_home: string,
  /// $HOME as os.UserHomeDir reports it, "" when unset.
  pub home: string,
  /// $USER: the member a first `lll up` names the board after.
  pub user: string,
  /// LLL_ADMIN_EMAIL and LLL_ADMIN_PASSWORD. Used only as a pair, and only
  /// where D7 lets them count (see `admin`).
  pub admin_email: string,
  pub admin_password: string,
  /// LLL_AGENT: the session label claims and comments carry.
  pub agent: string,
  /// LLL_BOARD_TOKEN, LLL_BIND and LLL_ALLOWED_ORIGINS: the board's gate
  /// token, listen address and extra API origins (`lll up`).
  pub board_token: string,
  pub bind: string,
  pub allowed_origins: string,
  /// LLL_WORK_HOST: the host recorded as an issue's work site (a test seam).
  pub work_host: string,
  /// LLL_REMINT=1 with LLL_REMINT_MEMBER: a process that may renew its own
  /// token from the admin pair. `lll up` decides this for its board
  /// itself; the variables remain for tests that exercise renewal in a CLI
  /// process.
  pub remint: bool,
  pub remint_member: string,
}

/// The administrator pair, both halves present.
pub struct AdminCreds {
  pub email: string,
  pub password: string,
}

/// What an invocation chose over its environment: command-line flags, and
/// what `lll up` settled for the server it runs in this process.
pub struct Overrides {
  /// --team KEY on a scoped command.
  pub team: Option<string>,
  /// --url on the commands that take one, or `lll up`'s chosen API.
  pub url: Option<string>,
  /// The board url a command was pointed at (`lll member passes` uses the
  /// saved local share's).
  pub web_url: Option<string>,
  /// The administrator pair `lll up` started its server with.
  pub admin: Option<AdminCreds>,
  /// The board token `lll up` resolved for this boot.
  pub board_token: Option<string>,
  /// The address `lll up --bind` listens on.
  pub bind: Option<string>,
}

/// One process's configuration: the environment it was handed, what its
/// flags overrode, and the config files layered under both, resolved once in
/// main and passed down (LLL-486). Precedence is decided here and nowhere
/// else: flags > env > the repo's .lll.toml > the home config > defaults.
///
/// A config file that does not parse is not fatal to building this: `lll
/// --help` and `lll config init` must still work beside a broken file. The
/// failure is kept and returned by `traced` and `config`, at the same points
/// the commands asked for configuration before.
pub struct Settings {
  pub env: Env,
  pub overrides: Overrides,
  loaded: Result<(Config, Sources), string>,
  /// The url the home config names, "" for none: the server its token was
  /// saved for (LLL-688).
  home_url: string,
}

impl Settings {
  /// The effective configuration and the origin of every field. A home
  /// config token is absent when the effective url is not the one it was
  /// saved with (`withheld`), so nothing that reads it can send it there.
  pub fn traced(self) -> Result<(Config, Sources), string> {
    let (cfg, src) = self.loaded?
    if withheld_token(cfg, src, self.home_url).is_some() {
      return Ok((Config { token: "", ..cfg }, Sources { token: None, ..src }))
    }
    Ok((cfg, src))
  }

  /// The effective configuration.
  pub fn config(self) -> Result<Config, string> {
    let (cfg, _) = self.traced()?
    Ok(cfg)
  }

  /// The home config's token held back from this url, or None (LLL-688).
  pub fn withheld(self) -> Option<Withheld> {
    let Ok((cfg, src)) = self.loaded else { return None }
    withheld_token(cfg, src, self.home_url)
  }

  /// These settings with the API url chosen by a flag (or by `lll up`).
  pub fn with_url(self, url: string) -> Settings {
    let mut out = self
    out.overrides.url = Some(url)
    out.loaded = apply_overrides(self.loaded, out.overrides)
    out
  }

  /// These settings with the board url a command was pointed at.
  pub fn with_web_url(self, web_url: string) -> Settings {
    let mut out = self
    out.overrides.web_url = Some(web_url)
    out.loaded = apply_overrides(self.loaded, out.overrides)
    out
  }

  /// These settings with the team chosen by --team (or settled by `lll up`).
  pub fn with_team(self, team: string) -> Settings {
    let mut out = self
    out.overrides.team = Some(team)
    out.loaded = apply_overrides(self.loaded, out.overrides)
    out
  }

  /// These settings with the administrator pair `lll up` started with.
  pub fn with_admin(self, admin: AdminCreds) -> Settings {
    let mut out = self
    out.overrides.admin = Some(admin)
    out
  }

  /// These settings with the board token `lll up` resolved.
  pub fn with_board_token(self, token: string) -> Settings {
    let mut out = self
    out.overrides.board_token = Some(token)
    out
  }

  /// These settings with the address `lll up --bind` listens on.
  pub fn with_bind(self, bind: string) -> Settings {
    let mut out = self
    out.overrides.bind = Some(bind)
    out
  }

  /// The same environment and flags over the files as they are now: for a
  /// command that has just written a config file and reports the result.
  pub fn reload(self) -> Settings {
    resolve(self.env, self.overrides)
  }

  /// The administrator pair this process was given: what `lll up` started
  /// with, else LLL_ADMIN_EMAIL with LLL_ADMIN_PASSWORD, else None. Callers
  /// apply D7 on top: a configured token outranks a pair from the
  /// environment.
  pub fn admin(self) -> Option<AdminCreds> {
    if let Some(admin) = self.overrides.admin { return Some(admin) }
    if self.env.admin_email == "" || self.env.admin_password == "" { return None }
    Some(AdminCreds { email: self.env.admin_email, password: self.env.admin_password })
  }

  /// The board's gate token: what `lll up` resolved, else LLL_BOARD_TOKEN,
  /// else "" (not known to this process).
  pub fn board_token(self) -> string {
    self.overrides.board_token.unwrap_or(self.env.board_token)
  }

  /// The board and API listen address: --bind, else LLL_BIND, else loopback.
  pub fn bind(self) -> string {
    let b = self.overrides.bind.unwrap_or(self.env.bind)
    if b == "" { "127.0.0.1" } else { b }
  }

  /// Path of the machine's config, whether or not it exists.
  pub fn home_path(self) -> Result<string, string> {
    home_path_in(self.env)
  }

  /// The machine's config alone, without the repo file or the environment.
  /// Login uses the saved API/board pair to detect a server switch reliably.
  pub fn load_home(self) -> Result<Config, string> {
    let Some(path) = home_file(self.env) else { return Ok(Config { .. }) }
    read_config(path, Config { .. })
  }

  /// Where a repo-level key gets written: the repo file already in play, else
  /// a new one at the git root, else here.
  pub fn repo_path(self) -> string {
    if let Some(path) = repo_file(self.env) { return path }
    if let Some(root) = git_root() { return filepath.Join(root, ".lll.toml") }
    ".lll.toml"
  }
}

/// The process environment, read once. The only function in src/ that calls
/// os.Getenv (scripts/test_no_ambient_env.py holds that line).
pub fn read_env() -> Env {
  Env {
    url: os.Getenv("LLL_URL"),
    team: os.Getenv("LLL_TEAM"),
    sort: os.Getenv("LLL_SORT"),
    web_url: os.Getenv("LLL_WEB_URL"),
    token: os.Getenv("LLL_TOKEN"),
    config_home: os.Getenv("LLL_CONFIG_HOME"),
    xdg_config_home: os.Getenv("XDG_CONFIG_HOME"),
    home: os.UserHomeDir().unwrap_or(""),
    user: os.Getenv("USER"),
    admin_email: os.Getenv("LLL_ADMIN_EMAIL"),
    admin_password: os.Getenv("LLL_ADMIN_PASSWORD"),
    agent: os.Getenv("LLL_AGENT"),
    board_token: os.Getenv("LLL_BOARD_TOKEN"),
    bind: os.Getenv("LLL_BIND"),
    allowed_origins: os.Getenv("LLL_ALLOWED_ORIGINS"),
    work_host: os.Getenv("LLL_WORK_HOST"),
    remint: os.Getenv("LLL_REMINT") == "1",
    remint_member: os.Getenv("LLL_REMINT_MEMBER"),
  }
}

/// No flag overrides anything.
pub fn no_overrides() -> Overrides {
  Overrides { .. }
}

/// Resolve settings: the files layered (home, then the repo's), the
/// environment over them per key, flags over that. The files LAYER rather
/// than shadow: each supplies the keys it names, so a committed repo file can
/// carry `team` alone and still inherit `url` and `token` from the machine.
pub fn resolve(env: Env, overrides: Overrides) -> Settings {
  let loaded = apply_overrides(layered(env), overrides)
  let home_url = home_file(env).map_or("", |path| read_config(path, Config { .. }).map_or("", |c| c.url))
  Settings { env, overrides, loaded, home_url }
}

/// Settings from known values, reading no file and no environment: for
/// tests, which hand a command exactly the configuration it should see.
pub fn given(cfg: Config, src: Sources, env: Env) -> Settings {
  Settings { env, overrides: no_overrides(), loaded: Ok((cfg, src)), home_url: "" }
}

/// A home config token not sent to the effective url (LLL-688), and why.
pub struct Withheld {
  /// The url the home config names: the server the token was saved for.
  pub home_url: string,
  /// The url this command would have sent it to.
  pub url: string,
  /// Where that url came from: a repo file, an environment variable or a flag.
  pub url_source: Option<Source>,
}

/// Pure. The same url once a trailing slash is dropped, as 'lll login'
/// drops it before saving. Nothing else is normalised: localhost and
/// 127.0.0.1 stay different servers, so a near miss withholds a token
/// rather than sending it somewhere new.
pub fn same_url(a: string, b: string) -> bool {
  strings.TrimRight(a, "/") == strings.TrimRight(b, "/")
}

/// Pure. A token is bound to the url it was saved with. The home config's
/// token goes only to the url that file names (a trailing slash aside), or to the
/// default when it names none. The layers combine key by key, so a repo
/// file naming only `url` would otherwise send the machine's login to
/// whatever server it chose. A token from LLL_TOKEN or a repo file stays
/// with the url configured beside it: whoever set it chose both.
pub fn withheld_token(cfg: Config, src: Sources, home_url: string) -> Option<Withheld> {
  if cfg.token == "" { return None }
  match src.token {
    Some(Source.HomeFile(_)) => (),
    Some(Source.Env(_)) | Some(Source.RepoFile(_)) | Some(Source.Flag(_)) | Some(Source.Default) | None => return None,
  }
  let bound = match src.url {
    Some(Source.HomeFile(_)) | Some(Source.Default) => true,
    Some(Source.Env(_)) | Some(Source.RepoFile(_)) | Some(Source.Flag(_)) | None => same_url(cfg.url, home_url),
  }
  if bound { return None }
  Some(Withheld { home_url, url: cfg.url, url_source: src.url })
}

/// The config files, then the environment, then the default url.
fn layered(env: Env) -> Result<(Config, Sources), string> {
  let mut cfg = Config { .. }
  let mut src = Sources { .. }

  for (path, file) in config_files(env) {
    let was = cfg
    let (next, named) = read_layer(path, cfg)?
    cfg = next
    let from = Some(file)
    if sets(named, "url", cfg.url, was.url) { src.url = from }
    if sets(named, "team", cfg.team, was.team) { src.team = from }
    if sets(named, "sort", cfg.sort, was.sort) { src.sort = from }
    if sets(named, "web_url", cfg.web_url, was.web_url) { src.web_url = from }
    if sets(named, "token", cfg.token, was.token) { src.token = from }
  }

  if env.url != "" {
    cfg.url = env.url
    src.url = Some(Source.Env("LLL_URL"))
  }
  if env.team != "" {
    cfg.team = env.team
    src.team = Some(Source.Env("LLL_TEAM"))
  }
  if env.sort != "" {
    cfg.sort = env.sort
    src.sort = Some(Source.Env("LLL_SORT"))
  }
  if env.web_url != "" {
    cfg.web_url = env.web_url
    src.web_url = Some(Source.Env("LLL_WEB_URL"))
  }
  if env.token != "" {
    cfg.token = env.token
    src.token = Some(Source.Env("LLL_TOKEN"))
  }
  if cfg.url == "" {
    cfg.url = "http://127.0.0.1:8090"
    src.url = Some(Source.Default)
  }
  // Every request is base + "/api/...", and a server answers "//api" with a
  // redirect lll does not follow (LLL-688): a url written with a trailing
  // slash is the same url, as 'lll login' saves it.
  cfg.url = strings.TrimRight(cfg.url, "/")
  Ok((cfg, src))
}

/// Whether a file that names the keys `named` is the source of `key`, now
/// `value` and `was` before it. A file is the source of every key it names
/// with a value, even one that matches the layer below: it is the one that
/// wins, so it is the one to edit (LLL-687). `key = ""` names nothing: the
/// commented template line `# token = ""` uncommented must leave the key
/// unset, as it was before the file named keys. A changed value counts
/// too, so a file that clears a lower layer's value still owns the result.
fn sets(named: Slice<string>, key: string, value: string, was: string) -> bool {
  (named.contains(key) && value != "") || value != was
}

/// Flags over the environment and files. A failed load stays failed.
fn apply_overrides(
  loaded: Result<(Config, Sources), string>,
  overrides: Overrides,
) -> Result<(Config, Sources), string> {
  let (cfg, src) = loaded?
  let mut cfg = cfg
  let mut src = src
  if let Some(team) = overrides.team {
    cfg.team = team
    src.team = Some(Source.Flag("--team"))
  }
  if let Some(url) = overrides.url {
    cfg.url = strings.TrimRight(url, "/")
    src.url = Some(Source.Flag("--url"))
  }
  if let Some(web_url) = overrides.web_url {
    cfg.web_url = web_url
    src.web_url = Some(Source.Flag("--web-url"))
  }
  Ok((cfg, src))
}

/// The files to layer, lowest precedence first: the machine's config, then
/// the repo's. Either may be absent.
fn config_files(env: Env) -> Slice<(string, Source)> {
  let mut files: Slice<(string, Source)> = []
  if let Some(home) = home_file(env) { files = files.append((home, Source.HomeFile(home))) }
  if let Some(repo) = repo_file(env) { files = files.append((repo, Source.RepoFile(repo))) }
  files
}

/// Path of the machine's config, whether or not it exists. `url` and `token`
/// belong here: how THIS machine reaches the tracker, and the login credential.
///
/// The config ROOT is overridable, because a harness that cannot set HOME can
/// still set an environment variable (LLL-400). Fleet workers that could write
/// HOME but not set it wrote `lll login` into the
/// developer's own ~/.config/lll/lll.toml six times in one replay.
///
/// Precedence: LLL_CONFIG_HOME, then XDG_CONFIG_HOME, then ~/.config. The
/// middle one is not a new opinion - `~/.config` IS the XDG default, so this
/// finishes a convention the path already followed without reading its
/// variable. Both name the root and get `lll/lll.toml` appended, so
/// LLL_CONFIG_HOME=/tmp/w1 puts the file at /tmp/w1/lll/lll.toml and two
/// workers cannot collide.
fn home_path_in(env: Env) -> Result<string, string> {
  Ok(filepath.Join(config_root(env)?, "lll", "lll.toml"))
}

/// The directory holding per-machine config, overridable so a process that
/// cannot change HOME can still be given its own.
fn config_root(env: Env) -> Result<string, string> {
  let explicit = strings.TrimSpace(env.config_home)
  if explicit != "" { return Ok(explicit) }
  let xdg = strings.TrimSpace(env.xdg_config_home)
  if xdg != "" { return Ok(xdg) }
  if env.home == "" {
    return Err(
      "no home directory to read config from: $HOME is unset; set LLL_CONFIG_HOME to a directory this process can write",
    )
  }
  Ok(filepath.Join(env.home, ".config"))
}

fn home_file(env: Env) -> Option<string> {
  let Ok(path) = home_path_in(env) else {
    return None
  }
  if exists(path) { Some(path) } else { None }
}

/// The repo's `.lll.toml`: the nearest one at or above the working directory,
/// searching no higher than the git root. Stopping at the root is the point —
/// an unbounded parent walk would let one stray ~/dv/.lll.toml capture every
/// repo beneath it, silently and with the wrong team, which is worse than the
/// cwd-only lookup it replaces.
///
/// Outside any repo the ceiling is `plain_dir_file()`'s instead: there is no
/// git root to stop at, but a plain directory still deserves the inheritance
/// a checkout gets (TASK-212).
fn repo_file(env: Env) -> Option<string> {
  // Outside a repo the whole decision belongs to plain_dir_file(), cwd
  // included. Short-circuiting on the working directory's own file first
  // would read a ~/.lll.toml whenever the cwd IS home — the one file the
  // HOME-exclusive rule exists to ignore.
  let Some(root) = git_root() else {
    return plain_dir_file(env.home)
  }
  // In a repo the working directory's own file keeps its short name, so error
  // messages read `.lll.toml` rather than an absolute path.
  if exists(".lll.toml") { return Some(".lll.toml") }
  let Ok(start) = os.Getwd() else {
    return None
  }
  // Both ends resolved, or they disagree the moment any parent is a symlink:
  // git reports /private/var/..., Getwd prefers $PWD's /var/..., and the walk
  // would give up at the first comparison. macOS /tmp alone is enough.
  let mut dir = filepath.Dir(no_symlinks(start))
  let root = no_symlinks(root)
  loop {
    // The ceiling, and the guard that keeps a stray file above the repo — or
    // a working directory git does not agree is inside one — out of reach.
    if !within(dir, root) { return None }
    let path = filepath.Join(dir, ".lll.toml")
    if exists(path) { return Some(path) }
    if dir == root { return None }
    let parent = filepath.Dir(dir)
    if parent == dir { return None }
    dir = parent
  }
}

/// The nearest `.lll.toml` at or above the working directory when no git root
/// bounds the walk. Two stops besides finding the file, both there so a
/// scratch directory cannot be captured by a stranger's config:
///
///   - a directory holding `.git`. Above a plain dir sits, often, someone's
///     checkout; its committed team is not this directory's team, and the
///     repo's own walk already refuses to look past its root.
///   - $HOME, EXCLUSIVE. A `.lll.toml` sitting directly in the home directory
///     would silently claim every project under it. Machine-wide defaults have
///     a place already: ~/.config/lll/lll.toml, which layers underneath.
fn plain_dir_file(home_dir: string) -> Option<string> {
  let Ok(start) = os.Getwd() else {
    return None
  }
  // Resolved for the same reason the repo walk resolves: on macOS a plain dir
  // under /tmp is reached through a symlink, and $HOME is reported unresolved.
  let mut dir = no_symlinks(start)
  let home = if home_dir == "" { "" } else { no_symlinks(home_dir) }
  let mut first = true
  loop {
    if dir == home { return None }
    if exists(filepath.Join(dir, ".git")) { return None }
    let path = filepath.Join(dir, ".lll.toml")
    // The working directory's own file keeps its short name, as it does inside
    // a repo, so `--list` names it the same way wherever it was found. Only
    // the cwd earns that: anything walked up to is named in full, or the
    // origin would not say which directory won.
    if exists(path) {
      let named = if first { ".lll.toml" } else { path }
      return Some(named)
    }
    first = false
    let parent = filepath.Dir(dir)
    if parent == dir { return None }
    dir = parent
  }
}

/// The repository root, or None outside a repo (or without git on PATH).
pub fn git_root() -> Option<string> {
  let Ok(out) = exec.Command("git", "rev-parse", "--show-toplevel").Output() else {
    return None
  }
  let root = strings.TrimSpace(out as string)
  if root == "" { None } else { Some(root) }
}

/// `path` with symlinks resolved, or unchanged when it cannot be resolved.
fn no_symlinks(path: string) -> string {
  let Ok(resolved) = filepath.EvalSymlinks(path) else {
    return path
  }
  resolved
}

/// True when `dir` is `root` or a directory under it.
fn within(dir: string, root: string) -> bool {
  dir == root || strings.HasPrefix(dir, root + "/")
}

fn exists(path: string) -> bool {
  os.Stat(path).is_ok()
}

fn read_config(path: string, initial: Config) -> Result<Config, string> {
  let (cfg, _) = read_layer(path, initial)?
  Ok(cfg)
}

/// The file at `path` over `initial`, and the keys it names, lowercased.
fn read_layer(path: string, initial: Config) -> Result<(Config, Slice<string>), string> {
  let data = match os.ReadFile(path) {
    Ok(data) => data,
    Err(e) => return Err(f"reading {path}: {e}"),
  }
  // TOML overwrites only present fields; this is also the layering policy.
  let mut cfg = initial
  let meta = match toml.Decode(data as string, &cfg) {
    Ok(meta) => meta,
    Err(e) => return Err(f"parsing {path}: {e}\nfix the TOML syntax in {path}, or remove it and rerun 'lll config init'"),
  }
  // Lowercased because the decoder matches keys without regard to case,
  // so `URL = ...` sets url.
  let named = meta.Keys().map(|key| strings.ToLower(key.String()))
  Ok((cfg, named))
}
