import "go:github.com/BurntSushi/toml"
import "go:os"
import "go:path/filepath"

#[json]
#[toml]
pub struct Config {
  pub url: string,
  pub team: string,
  pub sort: string,
  pub me: string,
  pub web_url: string,
}

/// Load config: env vars > ./.lll.toml > ~/.config/lll/lll.toml.
/// The first config file found is used whole; env vars override per field.
pub fn load() -> Result<Config, string> {
  let mut cfg = Config { .. }
  if let Some(path) = config_file() {
    let data = match os.ReadFile(path) {
      Ok(d) => d,
      Err(e) => return Err(f"reading {path}: {e}"),
    }
    if let Err(e) = toml.Unmarshal(data, &cfg) {
      return Err(
        f"parsing {path}: {e}
fix the TOML syntax in {path}, or remove it and rerun 'lll config init'",
      )
    }
  }

  let url = os.Getenv("LLL_URL")
  if url != "" { cfg.url = url }
  let team = os.Getenv("LLL_TEAM")
  if team != "" { cfg.team = team }
  let me = os.Getenv("LLL_ME")
  if me != "" { cfg.me = me }
  let sort = os.Getenv("LLL_SORT")
  if sort != "" { cfg.sort = sort }
  let web_url = os.Getenv("LLL_WEB_URL")
  if web_url != "" { cfg.web_url = web_url }

  if cfg.url == "" { cfg.url = "http://127.0.0.1:8090" }
  if cfg.web_url == "" { cfg.web_url = "http://127.0.0.1:8100" }
  Ok(cfg)
}

/// First existing config file: ./.lll.toml, then ~/.config/lll/lll.toml.
fn config_file() -> Option<string> {
  if exists(".lll.toml") { return Some(".lll.toml") }
  let Ok(home) = os.UserHomeDir() else {
    return None
  }
  let path = filepath.Join(home, ".config", "lll", "lll.toml")
  if exists(path) { Some(path) } else { None }
}

fn exists(path: string) -> bool {
  os.Stat(path).is_ok()
}
