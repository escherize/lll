import "go:fmt"
import "go:os"

import "commands"

fn main() {
  let Some(noun) = os.Args.get(1) else {
    print_usage()
    return
  }

  let result = match noun {
    "issue" => commands.issue(os.Args),
    "team" => commands.team(os.Args),
    "member" => commands.member(os.Args),
    "project" => commands.project(os.Args),
    "label" => commands.label(os.Args),
    "config" => commands.config_cmd(os.Args),
    "watch" => commands.watch(os.Args),
    "serve" => commands.serve(os.Args),
    "up" => commands.up(os.Args),
    "board" => commands.board(os.Args),
    "completions" => commands.completions(os.Args),
    "--help" => {
      print_usage()
      Ok(())
    },
    "-h" => {
      print_usage()
      Ok(())
    },
    "help" => {
      print_usage()
      Ok(())
    },
    other => Err(f"unknown command: '{other}'"),
  }

  if let Err(msg) = result {
    fmt.Println(f"Error: {msg}")
    os.Exit(1)
  }
}

fn print_usage() {
  fmt.Println(
    "lll - a Linear-style issue tracker

Usage:
  lll issue <command>     work with issues (see 'lll issue --help')
  lll team <command>      work with teams (see 'lll team --help')
  lll member <command>    work with members (see 'lll member --help')
  lll project <command>   work with projects (see 'lll project --help')
  lll label <command>     work with labels (see 'lll label --help')
  lll config <command>    manage configuration (see 'lll config --help')
  lll watch [flags]       live event stream for a query (see 'lll watch --help')
  lll serve [--port 8100] web board with realtime updates (see 'lll serve --help')
  lll up [--port 8100]    start PocketBase + web board together (see 'lll up --help')
  lll board [-w]          print the web board URL; -w opens it (see 'lll board --help')
  lll completions <shell> completion script for bash, zsh, or fish
                          (see 'lll completions --help')
  lll --help              show this help

Configuration (env > ./.lll.toml > ~/.config/lll/lll.toml):
  LLL_URL      PocketBase base URL (default http://127.0.0.1:8090)
  LLL_TEAM     default team key (e.g. ENG); scopes 'issue list', used by 'issue create'
  LLL_SORT     default sort for 'issue list': created, updated, priority, number; prefix - to descend
  LLL_WEB_URL  web board base URL for 'board', 'issue url', 'view -w' (default http://127.0.0.1:8100)",
  )
}
