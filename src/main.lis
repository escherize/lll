import "go:fmt"
import "go:os"

import "commands"

fn main() {
  let Some(noun) = os.Args.get(1) else {
    print_usage()
    return
  }

  let result = match noun {
    "issue" => commands.issue(os.Args),
    "team" => commands.team(os.Args),
    "member" => commands.member(os.Args),
    "project" => commands.project(os.Args),
    "label" => commands.label(os.Args),
    "config" => commands.config_cmd(os.Args),
    "--help" => {
      print_usage()
      Ok(())
    },
    "-h" => {
      print_usage()
      Ok(())
    },
    "help" => {
      print_usage()
      Ok(())
    },
    other => Err(f"unknown command: '{other}'"),
  }

  if let Err(msg) = result {
    fmt.Println(f"Error: {msg}")
    os.Exit(1)
  }
}

fn print_usage() {
  fmt.Println(
    "lin - a Linear-style issue tracker

Usage:
  lin issue <command>     work with issues (see 'lin issue --help')
  lin team <command>      work with teams (see 'lin team --help')
  lin member <command>    work with members (see 'lin member --help')
  lin project <command>   work with projects (see 'lin project --help')
  lin label <command>     work with labels (see 'lin label --help')
  lin config <command>    manage configuration (see 'lin config --help')
  lin --help              show this help

Configuration (env > ./.lin.toml > ~/.config/lin/lin.toml):
  LIN_URL    PocketBase base URL (default http://127.0.0.1:8090)
  LIN_TEAM   default team key (e.g. ENG); scopes 'issue list', used by 'issue create'
  LIN_SORT   default sort for 'issue list': created, updated, priority, number; prefix - to descend",
  )
}
