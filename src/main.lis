import "go:fmt"
import "go:github.com/escherize/lll/docs"
import "go:os"
import "go:regexp"
import "go:strings"

import "commands"
import "config"
import "output"
import "pb"
import "query"
import "buildinfo"

fn main() {
  // LLL-486: the environment is read here, once, and everything below gets
  // its configuration as a value. Nothing sets an environment variable to
  // carry state, so a child process sees only what lll's parent gave it.
  let env = config.read_env()
  let Some(noun) = os.Args.get(1) else {
    render(output.none(), Ok(usage(pb.Client.new(config.resolve(env, config.no_overrides())))), None)
    return
  }

  // --team is taken off the arguments before the settings are built, so the
  // team it names is a flag override like any other. Its usage errors are
  // reported where they always were, after renewal.
  let scoped = commands.scoped_args(os.Args)
  let team_flag = match scoped {
    Ok((_, team)) => team,
    Err(_) => None,
  }
  let resolved = config.resolve(env, config.Overrides { team: team_flag, .. })
  // LLL-441: before anything reads the token, renew a login token near
  // expiry - only for nouns that talk to the server anyway, so --help,
  // version and completions never wait on the network.
  let (settings, renewal) = if commands.talks_to_server(noun) {
    commands.renew_login_token(resolved)
  } else {
    (resolved, output.none())
  }
  let ctx = pb.Client.new(settings)
  let skew = commands.version_skew_check(ctx, noun)
  let result = match scoped {
    Ok((args, _)) => dispatch(ctx, noun, args),
    Err(msg) => Err(msg),
  }
  render(renewal, result, skew.receive().unwrap_or(None))
}

/// The one place lll writes a command's outcome (LLL-683): what came before
/// the command (a login renewal's note), then the command's data to stdout
/// and its notices to stderr (none under --json or --env) in the order it
/// gave them, then the version-skew line, then any error with its exit code.
/// A failed command's output is what it had said before failing.
///
/// A write that fails (a full disk, a closed pipe) is an error of its own,
/// exit 1: a truncated download or a --json document cut short must not
/// read as success.
fn render(before: output.Output, result: Result<output.Output, pb.CliError>, skew: Option<string>) {
  let out = match result {
    Ok(out) => out,
    Err(err) => err.output(),
  }
  let wrote = match write(before) {
    Ok(_) => write(out),
    Err(e) => Err(e),
  }
  if let Err(e) = wrote {
    let lost = if out.lost == "" { "" } else { f"\n{out.lost}" }
    let _ = fmt.Fprintln(os.Stderr, f"Error: writing output: {e}{lost}")
    os.Exit(pb.exit_code(pb.ErrorKind.Failed))
  }
  if let Some(line) = skew {
    fmt.Fprintln(os.Stderr, line)
  }

  if let Err(err) = result {
    // A help request travels as an error so it short-circuits the verb before
    // it can act (flags.parse, TASK-237). It is not a failure: print it bare
    // and exit 0, or `lll issue list -h` in a script reads as a broken command.
    if let pb.ErrorKind.Help = err.kind {
      fmt.Println(err.message)
      return
    }
    // Every failing exit is decided here, by the error's kind (LLL-645,
    // docs/cli-contract.md): scripts branch on the code, not the text.
    // Exit 5 is an outcome, not a failure (fleet case 13): "Error:" belongs
    // only to real errors.
    let prefix = if let pb.ErrorKind.NothingToDo = err.kind { "Nothing to do" } else { "Error" }
    fmt.Fprintln(os.Stderr, f"{prefix}: {err.message}")
    os.Exit(pb.exit_code(err.kind))
  }
}

fn write(out: output.Output) -> Result<(), error> {
  for part in out.written() {
    match part {
      output.Part.Data(s) => { fmt.Print(s)?; },
      output.Part.Notice(s) => { fmt.Fprintln(os.Stderr, s)?; },
    }
  }
  Ok(())
}

fn dispatch(ctx: pb.Client, noun: string, args: Slice<string>) -> Result<output.Output, pb.CliError> {
  match noun {
    "issue" => commands.issue(ctx, args),
    "team" => commands.team(ctx, args),
    "member" => commands.member(ctx, args),
    "invite" => commands.invite(ctx, args),
    "project" => commands.project(ctx, args),
    "api" => commands.api(ctx, args),
    "label" => commands.label(ctx, args),
    "doc" => commands.doc(ctx, args),
    "finding" => commands.finding(ctx, args),
    "import" => commands.import_cmd(ctx, args),
    "export" => commands.export_cmd(ctx, args),
    "config" => commands.config_cmd(ctx, args),
    "login" => commands.login(ctx, args),
    "logout" => commands.logout(ctx, args),
    "whoami" => commands.whoami(ctx, args),
    "token" => commands.token(ctx, args),
    "bot" => commands.bot(ctx, args),
    "attach" => commands.attach(ctx, args),
    "watch" => commands.watch(ctx, args),
    "webhook" => commands.webhook(ctx, args),
    "search" => commands.search_cmd(ctx, args),
    "up" => commands.up(ctx, args),
    "board" => commands.board(ctx, args),
    "skill" => commands.skill(args),
    "completions" => commands.completions(args),
    "upgrade" => commands.upgrade(args),
    "--help" | "-h" => Ok(usage(ctx)),
    "help" => help(ctx, args),
    "--version" | "-v" | "version" => version(noun, args),
    other => Err(pb.fail(pb.ErrorKind.Usage, unknown_command(other, os.Args.get(2).unwrap_or("")))),
  }
}

/// `lll version`, `--version` and `-v`: the version, `--help` the usage, and
/// anything else a usage error (exit 2) like every other command line.
fn version(noun: string, args: Slice<string>) -> Result<output.Output, pb.CliError> {
  match args.get(2) {
    None => Ok(output.line(f"lll {buildinfo.version()}")),
    Some("--help") | Some("-h") => Err(pb.fail(pb.ErrorKind.Help, "lll version - print the version\n\nUsage:\n  lll version    (also: lll --version, lll -v)")),
    Some(extra) => Err(pb.fail(pb.ErrorKind.Usage, f"lll {noun} takes no arguments; got '{extra}'")),
  }
}

/// `lll help [contract]`. The contract is a help topic rather than a noun: it
/// is reference text, like --help, and `help` already answers with the usage
/// page. It ships in the binary because installed users have no docs/ (1.0
/// fleet: a worker tried 'lll skill get cli-contract').
fn help(ctx: pb.Client, args: Slice<string>) -> Result<output.Output, pb.CliError> {
  match (args.get(2), args.get(3)) {
    (None, _) | (Some("--help"), None) | (Some("-h"), None) => Ok(usage(ctx)),
    (Some("contract"), None) => Ok(output.text(docs.Contract())),
    _ => Err(
      pb.fail(
        pb.ErrorKind.Usage,
        f"unknown help topic: '{strings.Join(args[2..], " ")}'; 'lll help contract' prints the CLI contract, 'lll --help' the commands, 'lll NOUN --help' one noun",
      ),
    ),
  }
}

fn usage(ctx: pb.Client) -> output.Output {
  let page = output.line(
    f"lll - a Linear-style issue tracker

Every verb lives under a noun: 'lll issue list', 'lll issue comment KEY \"body\"',
'lll doc view SLUG'. There is no 'lll list' or 'lll comment'.

A team is one tracker on the server: its key (ENG) prefixes every issue id
(ENG-12), and each repo or directory attaches to one team.

Start here, with no server yet:
  lll up                  start a server and web board on this machine; keep it
                          running (on this machine it also logs the CLI in)
  lll login --url URL     from another machine, or for a hosted server: log the
                          CLI in (see 'lll login --help' for a first account)
  lll attach              in your repo: point it at a team (--key KEY to pick one)
  lll issue create -t \"First issue\"

Usage:
  lll issue <command>     work with issues (see 'lll issue --help')
  lll search <text>       full-text search: issues, comments, docs, ranked, with context
  lll bot create bot-<name>
                          an agent identity in one command: member + token, printed
                          once in a prompt to paste into the agent (--env: only the
                          exports); the name must start with bot- (lll bot create bot-myrepo)
  lll bot rotate bot-<name>
                          a new token for a bot; the previous one stops working
                          (see 'lll bot rotate --help')
  lll team <command>      work with teams (see 'lll team --help')
  lll member <command>    work with members (see 'lll member --help')
  lll invite create --team KEY [--read-only]
                          a single-use link that lets one person join with
                          those teams (see 'lll invite --help')
  lll project <command>   work with projects (see 'lll project --help')
  lll api METHOD PATH     raw passthrough to the board's server API;
                          --schema prints the collection/field reference
                          (see 'lll api --help')
  lll label <command>     work with labels (see 'lll label --help')
  lll import github OWNER/REPO
                          bring a GitHub repo's issues in via gh: title, body,
                          labels, state (open todo, closed done), each issue
                          ref'd gh#N; re-import skips what it already brought
  lll export [DIR]        the team as readable Markdown a repo can hold:
                          one file per issue and doc, attachment bytes beside
                          them (default DIR: mirror)
  lll doc <command>       work with docs: wiki, findings, decisions, PRDs
                          (see 'lll doc --help')
  lll finding <command>   retrieve findings by area or path
                          (see 'lll finding --help')
  lll config <command>    manage configuration (see 'lll config --help')
  lll login [--url URL]   authenticate as a member; the token goes to
                          ~/.config/lll/lll.toml, and --url persists the
                          server url too: the one-command machine setup
                          (see 'lll login --help')
  lll logout              clear the stored token (see 'lll logout --help')
  lll whoami              which member, server and team you are acting as
  lll token create        mint a static agent token (superuser only)
                          (see 'lll token --help')
  lll attach [--key KEY]  write this repo's team to a shareable
                          .lll.toml (see 'lll attach --help')
  lll watch [flags]       live event stream for a query; --ready streams the
                          ready agenda (see 'lll watch --help')
  lll webhook <command>   outbound webhooks: add/list/remove URLs that the
                          server POSTs issue events to (see 'lll webhook --help')
  lll up [--port 8100]    start the lll server and web board together (see 'lll up --help')
  lll board [-w]          print the web board URL; -w opens it (see 'lll board --help')
  lll board --team KEY    a view-only link to one team's board, no account needed
  lll skill list          the agent operating instructions in this binary
  lll skill get NAME      one of them as markdown (see 'lll skill --help')
  lll completions <shell> completion script for bash, zsh, or fish
                          (see 'lll completions --help')
  lll upgrade [--dry-run] upgrade lll the way it was installed: runs
                          'brew upgrade lll', or prints the command to run
                          (see 'lll upgrade --help')
  lll --version, -v       print the version
  lll --help              show this help
  lll help contract       the CLI contract: exit codes, --json fields, spellings

Exit codes: 0 ok, 1 error, 2 usage, 3 not found, 4 refused or conflict,
5 nothing to do, 6 not authenticated. They and the --json fields scripts may
rely on are the CLI contract: 'lll help contract' prints it.

Scoped commands (issue, project, label, doc, finding, import, export, watch,
search, webhook) accept --team KEY.
It overrides LLL_TEAM for this invocation and never writes configuration.
Explicit issue IDs still target their own team.

Examples:
  lll issue list --team ENG --search checkout
  lll issue update ENG-1 --assignee alice --state in-review
  lll issue claim ENG-1   take it so no other agent does; 'lll issue release
                          ENG-1' gives it back, and close releases it too
  next=$(lll issue next)  the one issue to work next: ready, unclaimed,
                          priority, age, unblocks; add --claim to take it

Configuration (env > the repo's .lll.toml > ~/.config/lll/lll.toml; the files
layer, each supplying the keys it names; 'lll config list' shows which won):
  LLL_URL      lll server base URL (default http://127.0.0.1:8090)
  LLL_TEAM     default team key (e.g. ENG); scopes 'issue list', used by 'issue create'
  LLL_SORT     default sort for 'issue list': {strings.Join(query.sort_fields(), ", ")}; prefix - to descend
  LLL_WEB_URL  web board base URL for 'board', 'issue url', 'view -w' (set with 'lll config set web_url URL')",
  )
  let hint = commands.setup_hint(ctx)
  if hint == "" { page } else { page.line(hint) }
}

/// An issue verb typed as a noun ('lll comment ...') is the most common
/// unknown command (three of thirty fleet agents); name where it lives.
fn unknown_command(noun: string, verb: string) -> string {
  // 'lll issues list' for 'lll issue list': the plural is the natural guess.
  // The verb rides along - seven of thirty fleet agents rated the bare
  // "did you mean 'lll issue'" the least helpful message, since it dropped
  // the half they had right.
  let singular = strings.TrimSuffix(noun, "s")
  for n in ["issue", "team", "member", "project", "label", "doc", "finding", "token"] {
    if singular == n && noun != n {
      let rest = if verb == "" || verb.starts_with("-") { "" } else { f" {verb}" }
      return f"unknown command: '{noun}'; did you mean 'lll {n}{rest}'? (see 'lll {n} -h')"
    }
  }
  for c in commands.issue_commands() {
    // An accepted alias counts too: 'lll read KEY' (five of ten 1.0 fleet
    // agents, case 20) names 'issue view', which also takes 'read'.
    if c.name == noun || (noun != "" && (c.alias == noun || c.hidden_alias == noun)) {
      // 'lll comment create' is the common shape of this mistake; dropping
      // the typed verb here, as the plural branch once did, hid the half
      // the user had right. So the verb rides along (LLL-313).
      let rest = if verb == "" || verb.starts_with("-") { "" } else { f" {verb}" }
      // Only a key is carried into the suggestion: 'lll comment add' must not
      // become 'lll issue comment add', which is refused too (case 20).
      let carried = if regexp.MustCompile(r"^[A-Za-z][A-Za-z0-9_-]*-[0-9]+$").MatchString(verb) { f" {verb}" } else { " ..." }
      return f"unknown command: '{noun}{rest}'; it is an issue verb: 'lll issue {c.name}{carried}' (see 'lll issue {c.name} -h')"
    }
  }
  // 'lll FLEET-4': a key where the noun goes (case 20).
  if regexp.MustCompile(r"^[A-Za-z][A-Za-z0-9_-]*-[0-9]+$").MatchString(noun) {
    return f"unknown command: '{noun}' is an issue ID; to see it use 'lll issue view {noun}'"
  }
  // A member verb typed as a noun, the same mistake shape (fleet case 11 was
  // 'lll invite', which is now its own noun and points back at member invite).
  for c in commands.member_commands() {
    if c.name == noun {
      return f"unknown command: '{noun}'; it is a member verb: 'lll member {noun} ...' (see 'lll member {noun} -h')"
    }
  }
  if let Some(hint) = commands.issue_verb_hint(noun) {
    return f"unknown command: '{noun}'; {hint} (see 'lll issue -h')"
  }
  f"unknown command: '{noun}' (see 'lll --help')"
}
