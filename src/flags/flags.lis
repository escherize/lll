import "go:strings"

import "output"
import "pb"

/// One source of truth for a CLI flag (TASK-127). The verb's parser loop,
/// its --help output and the shell completions all read this table, so a
/// flag is declared exactly once and the three surfaces cannot drift.
///
/// `name` is the canonical spelling — the one shown in help and usage lines.
/// `alias` is any further accepted spellings, space-separated (`-d` for
/// `--description`; `--body -m --message` for `-b`);
/// parsed values always land under `name`. A flag with no long form (-t,
/// -w, -k) simply has the short spelling as its name.
pub struct Flag {
  pub name: string,
  pub alias: string,
  pub value: bool,    // consumes the next argument
  pub hint: string,   // placeholder shown in usage lines, "" for booleans
  pub required: bool, // parse errors with the usage line when never given
  pub repeat: bool,   // may be given more than once (values accumulate)
  pub hidden: bool,   // kept out of help and completions (--help itself)
  pub help: string,   // one help line; "\n" continues on an aligned line
  /// The closed set a value flag takes, when it has one. The usage line
  /// shows it (unless `hint` says it better), completions offer it, and the
  /// parser refuses anything else; an empty value is left to the verb.
  pub values: Slice<string>,
  /// The value '-' reads it from stdin. Only one such flag may say so per
  /// command line: with two, which line answers which flag would depend on
  /// the order the command reads them, which nothing on the line says.
  pub stdin: bool,
}

pub struct Parsed {
  spec: Slice<Flag>,                // kept for alias resolution on lookup
  vals: Map<string, Slice<string>>, // canonical name -> occurrences in order
  pos: Slice<string>,               // bare arguments, in order
}

/// Parse `args` from `start` against `spec`.
///
/// Bare arguments become positionals when `allow_positional` (at most one,
/// as every verb here takes), else they are rejected as unknown flags —
/// which is how `issue create` rejects a stray word. Unknown dash-prefixed
/// arguments always error with `unknown flag: '<arg>'`, suffixed with
/// `usage` when one is given. A value flag consumes the next argument
/// without looking at it; missing values error naming the typed spelling.
/// A required flag that never appeared errors with `usage: <usage>`.
///
/// A dash-prefixed argument may also carry its value inline as
/// `--flag=value` (TASK-165), split at the FIRST equals so the value may
/// contain more. A boolean spelt that way (`--json=1`) is an error.
/// Refuse a second occurrence of a flag that did not declare itself
/// repeatable (LLL-381).
///
/// `repeat` used to be decoration: it added "..." to the usage line and
/// nothing else, so `--state todo --state in-review` was accepted and then
/// read with `one()`, which took the last. The result was a plausible,
/// well-formed, WRONG list at exit 0 - worse than a refusal, because nothing
/// on screen said half the question had been dropped.
///
/// Now the table decides. A repeatable flag accumulates and its consumer ORs
/// the values; anything else says so the first time it is doubled.
fn repeat_ok(fl: Flag, existing: Slice<string>) -> Result<(), pb.CliError> {
  if fl.repeat || existing.is_empty() { return Ok(()) }
  Err(
    usage_error(f"{fl.name} may only be given once (got {existing.length() + 1}); it takes a single value"),
  )
}

/// A value outside the flag's closed set is a usage error. Compared without
/// case or surrounding space, as the verbs' own parsers read them.
fn in_values(fl: Flag, value: string) -> Result<(), pb.CliError> {
  let typed = strings.ToLower(strings.TrimSpace(value))
  if fl.values.is_empty() || typed == "" || fl.values.contains(typed) { return Ok(()) }
  Err(usage_error(unknown_value(fl, value)))
}

pub fn parse(
  spec: Slice<Flag>,
  args: Slice<string>,
  start: int,
  allow_positional: bool,
  usage: string,
) -> Result<Parsed, pb.CliError> {
  let limit = if allow_positional { 1 } else { 0 }
  parse_n(spec, args, start, limit, usage)
}

/// `parse`, with the positional limit as a COUNT. The table reads it off the
/// Command's `positional` shape (flags.arity), so a table entry declares its
/// arity in the same place it declares its usage line and the two cannot
/// disagree.
///
/// Help is not answered here. The table's parser asks help_requested first
/// (TASK-237): `--help` and `-h` work on every verb, before an unknown flag,
/// a missing value or a missing required flag can refuse them, and a help
/// request never reaches the verb body.
pub fn parse_n(
  spec: Slice<Flag>,
  args: Slice<string>,
  start: int,
  max_positional: int,
  usage: string,
) -> Result<Parsed, pb.CliError> {
  let mut vals = Map.new<string, Slice<string>>()
  let mut pos: Slice<string> = []
  let mut i = start
  let mut options_ended = false
  while i < args.length() {
    let arg = args[i]
    if options_ended {
      if pos.length() >= max_positional { return Err(usage_error(f"unexpected argument: '{arg}'")) }
      pos = pos.append(arg)
      i += 1
      continue
    }
    if arg == "--" {
      options_ended = true
      i += 1
      continue
    }
    // `--flag=value` (TASK-165). Split ONCE, so a value may itself contain
    // an equals sign: `--filter=a=b` is the value `a=b`. SplitN, not Index +
    // substring: strings.Index returns a BYTE offset while substring takes
    // RUNE indices, and the two disagree on any multi-byte character.
    if arg.starts_with("-") && arg.contains("=") {
      let parts = strings.SplitN(arg, "=", 2)
      let spelling = parts[0]
      let Some(fl) = spec.find(|f| spells(f, spelling)) else {
        if spelling == "--team" { return Err(usage_error(team_scope_error(arg, parts[1], usage))) }
        if spelling == "--url" { return Err(usage_error(url_scope_error(arg, parts[1], usage))) }
        return Err(usage_error(unknown_flag(arg, usage, spec)))
      }
      // A boolean given a value is a mistake, not a truthy string: `--json=0`
      // would otherwise read as "json on". Reject it naming the flag.
      if !fl.value {
        return Err(usage_error(f"{spelling} takes no value"))
      }
      repeat_ok(fl, vals.get(fl.name).unwrap_or([]))?
      in_values(fl, parts[1])?
      vals[fl.name] = vals.get(fl.name).unwrap_or([]).append(parts[1])
      i += 1
      continue
    }
    let Some(fl) = spec.find(|f| spells(f, arg)) else {
      if arg == "--team" { return Err(usage_error(team_scope_error(arg, args.get(i + 1).unwrap_or("KEY"), usage))) }
      if arg == "--url" { return Err(usage_error(url_scope_error(arg, args.get(i + 1).unwrap_or("URL"), usage))) }
      if arg.starts_with("-") || max_positional == 0 {
        return Err(usage_error(unknown_flag(arg, usage, spec)))
      }
      if pos.length() >= max_positional {
        return Err(usage_error(f"unexpected argument: '{arg}'"))
      }
      pos = pos.append(arg)
      i += 1
      continue
    }
    if fl.value {
      let Some(val) = args.get(i + 1) else {
        return Err(usage_error(f"{arg} requires a value"))
      }
      repeat_ok(fl, vals.get(fl.name).unwrap_or([]))?
      in_values(fl, val)?
      vals[fl.name] = vals.get(fl.name).unwrap_or([]).append(val)
      i += 2
    } else {
      vals[fl.name] = vals.get(fl.name).unwrap_or([]).append("")
      i += 1
    }
  }
  for fl in spec {
    if fl.required && vals.get(fl.name).is_none() {
      return Err(usage_error(f"usage: {usage}"))
    }
  }
  let piped = spec.filter(|f| f.stdin && vals.get(f.name).unwrap_or([]).contains("-")).map(|f| f.name)
  if piped.length() > 1 {
    return Err(usage_error(f"only one of {strings.Join(piped, " and ")} can read stdin ('-'); pass the other as a value"))
  }
  Ok(Parsed { spec, vals, pos })
}

/// Find help switches while respecting values consumed by declared flags.
pub fn help_requested(spec: Slice<Flag>, args: Slice<string>, start: int) -> bool {
  let mut index = start
  while let Some(arg) = args.get(index) {
    if arg == "--" { return false }
    if arg == "--help" || arg == "-h" { return true }
    if spec.find(|f| f.value && spells(f, arg)).is_some() {
      index += 2
    } else {
      index += 1
    }
  }
  false
}

pub fn shell_argument(value: string) -> string {
  if value != "" && value.runes().all(|r| ('a' <= r && r <= 'z') || ('A' <= r && r <= 'Z') || ('0' <= r && r <= '9') || r == '_' || r == '-' || r == '.') { return value }
  let escaped = strings.ReplaceAll(value, "'", "'\\''")
  f"'{escaped}'"
}

/// A bad command line: exit 2 (LLL-645). Commands that refuse their own
/// arguments after parsing use it too.
pub fn usage_error(message: string) -> pb.CliError {
  pb.fail(pb.ErrorKind.Usage, message)
}

/// The help text for a verb: its usage line, then the flags block the spec
/// already knows how to render. Verbs with richer prose keep their own
/// hand-written help by checking --help before they call parse - this is the
/// floor, not a ceiling.
fn usage_help(usage: string, spec: Slice<Flag>) -> string {
  let head = if usage == "" { "" } else { f"usage: {usage}" }
  let flags_block = section(spec)
  // A verb with no flags and no usage line would otherwise print a blank
  // line, which reads as "help is broken" rather than "there is nothing to
  // configure here". `team list` and `member list` are both like this.
  if head == "" && flags_block == "" {
    return "this command takes no flags (see 'lll --help')"
  }
  // section() leads with a newline so it can be appended to a usage line.
  // Without a usage line it would open on a blank, so trim it.
  if head == "" { return strings.TrimPrefix(flags_block, "\n") }
  f"{head}{flags_block}"
}

impl Parsed {
  pub fn positional_count(self) -> int { self.pos.length() }
  /// The canonical name for a spelling, or the name itself when unknown.
  fn canon(self, name: string) -> string {
    let Some(fl) = self.spec.find(|f| spells(f, name)) else {
      return name
    }
    fl.name
  }

  /// True when the flag (by either spelling) appeared, boolean or not.
  pub fn given(self, name: string) -> bool {
    self.vals.get(self.canon(name)).is_some()
  }

  /// The flag's last value, "" when it never appeared. Later occurrences
  /// overwrite earlier ones, as every hand-written loop did.
  pub fn one(self, name: string) -> string {
    let vals = self.all(name)
    let Some(last) = vals.get(vals.length() - 1) else {
      return ""
    }
    last
  }

  /// Every value the flag was given, in order.
  pub fn all(self, name: string) -> Slice<string> {
    self.vals.get(self.canon(name)).unwrap_or([])
  }

  /// The first positional argument, "" when there is none.
  pub fn first(self) -> string {
    let Some(f) = self.pos.get(0) else {
      return ""
    }
    f
  }

  /// The i-th positional argument (0-based), "" when there is none. Two
  /// verbs take two: `issue link KEY SLUG`, and `issue comment KEY [body]`
  /// since TASK-309's fleet showed a third of first-time agents type the body
  /// bare, the way `create` takes a bare title.
  pub fn nth(self, i: int) -> string {
    let Some(v) = self.pos.get(i) else {
      return ""
    }
    v
  }
}

/// One invocation parsed by the table (LLL-684). Handlers consume `parsed`; raw `args`
/// remain available for diagnostic spelling, never as a second parser input.
pub struct CommandInput {
  /// The client and settings main built (LLL-486): what the verb talks to.
  pub ctx: pb.Client,
  pub args: Slice<string>,
  pub parsed: Parsed,
  /// Canonical usage generated from the resolved command declaration.
  pub usage: string,
}

/// One verb of a noun, as a value (TASK-307). Dispatch, the noun's help
/// table and shell completions all read the same slice of these, so a verb is
/// declared exactly once and the three cannot drift. Before this, nine nouns
/// each carried a hand-rolled `match verb`, eleven files their own copy of the
/// `--help` arm, and completions.verbs() was a fourth list that drifted twice
/// in one wave.
///
/// `summary` is one line and required: it is the row in `lll <noun> --help`.
/// `page` is the verb's own help when it has a hand-written one; "" means
/// generate usage + flags from `spec`, which is the floor, not a ceiling.
/// `positional` is the shape after the verb: "" for none, "[KEY-123]" for
/// optional, "KEY-123" for required - it feeds the usage line only; the verb
/// still reads its positional through Parsed.first().
pub struct Command {
  pub name: string,
  /// One accepted alternate spelling; empty means none. Kept out of help.
  pub alias: string,
  /// A hidden verb dispatches but has no help row and no completion, and
  /// neither does its alias (LLL-505). It keeps a spelling agents guess
  /// working when the documented operation lives under another noun.
  pub hidden: bool,
  /// A spelling that dispatches but is never shown: no help row, no
  /// completion, and usage lines name `name`. Empty means none. It keeps a
  /// verb agents guess working (`read` for `view`: 5 of 20 fleet workers).
  pub hidden_alias: string,
  pub summary: string,
  pub page: string,
  pub spec: Slice<Flag>,
  pub positional: string,
  /// What the missing-argument error says above the usage line, when the
  /// positional needs saying more about ("" says nothing more).
  pub missing: string,
  /// Whether the verb writes or only reads; no default, so every verb says.
  pub access: Access,
  /// Sub-verbs: 'lll issue comment edit KEY N'. A word that is none of them
  /// is the command's own first positional.
  pub verbs: Slice<Command>,
  pub run: fn(CommandInput) -> Result<output.Output, pb.CliError>,
}

/// `lll <noun> --help`: every verb's usage line and summary, aligned, then the
/// noun's intro. Generated from the table so a verb cannot be missing from it.
fn noun_help(noun: string, tagline: string, intro: string, cmds: Slice<Command>) -> string {
  let mut out = if tagline == "" { f"lll {noun}" } else { f"lll {noun} - {tagline}" }
  out += "\n\nUsage:"
  // One row per verb: the usage line, then the summary on the next line,
  // indented. The hand-written pages aligned summaries into a right-hand
  // column, but a generated usage line can run to 110 characters (member
  // set-password), and padding every row to the widest made the whole table
  // 150 columns. Two lines per verb reads in any terminal.
  for c in cmds.filter(|c| !c.hidden) {
    let l = usage(f"lll {noun} {c.name}", c.spec, c.positional)
    out += f"\n  {l}\n      {c.summary}"
  }
  if intro != "" { out += f"\n\n{intro}" }
  // Fleet case 13: two workers read only a noun's help and guessed the
  // exit codes, so every noun page carries the legend 'lll --help' does.
  out += "\n\n" + exit_code_legend()
  out
}

/// The one-line exit-code legend every noun's --help ends with.
pub fn exit_code_legend() -> string {
  "Exit codes: 0 ok, 1 error, 2 usage, 3 not found, 4 refused or conflict, 5 nothing to do, 6 not authenticated"
}

/// A usage line fragment: "lll issue create -t \"title\" [-d desc] ...".
/// Required flags render bare, optional ones bracketed; a repeated flag
/// trails "..."; `positional` (e.g. "[KEY-123]") sits after the command.
pub fn usage(cmd: string, spec: Slice<Flag>, positional: string) -> string {
  let mut out = cmd
  if positional != "" { out += f" {positional}" }
  for fl in spec {
    if fl.hidden { continue }
    let hint = shown_hint(fl)
    if fl.required {
      out += f" {fl.name} {hint}"
    } else if hint != "" {
      out += f" [{fl.name} {hint}]"
    } else {
      out += f" [{fl.name}]"
    }
    if fl.repeat { out += "..." }
  }
  out
}

/// The placeholder a usage line shows: the hint, else the closed set.
fn shown_hint(fl: Flag) -> string {
  if fl.hint != "" || fl.values.is_empty() { fl.hint } else { strings.Join(fl.values, "|") }
}

/// The "Flags:" block for --help, aligned from the spec. Empty when the
/// spec has no visible flags. Continuation lines (a "\n" in help) indent
/// to the help column.
pub fn section(spec: Slice<Flag>) -> string {
  let visible = spec.filter(|f| !f.hidden)
  if visible.is_empty() { return "" }
  // The label carries the alias ("-b, --body"): the long form guessed at a
  // steady rate across fleet runs was never shown anywhere.
  let mut width = 0
  for fl in visible {
    if flag_label(fl).length() > width { width = flag_label(fl).length() }
  }
  let cont = strings.Repeat(" ", width + 4)
  let mut out = "\nFlags:"
  for fl in visible {
    let label = flag_label(fl)
    let pad = strings.Repeat(" ", width - label.length() + 2)
    let mut first = true
    for l in fl.help.split("\n") {
      if first {
        out += f"\n  {label}{pad}{l}"
        first = false
      } else {
        out += f"\n{cont}{l}"
      }
    }
  }
  out
}

/// True when `s` is the flag's name or one of its aliases.
fn spells(fl: Flag, s: string) -> bool {
  if fl.name == s { return true }
  for a in strings.Fields(fl.alias) { if a == s { return true } }
  false
}

fn flag_label(fl: Flag) -> string {
  if fl.alias == "" { return fl.name }
  f"{fl.name}, {strings.Join(strings.Fields(fl.alias), ", ")}"
}

/// Completion tokens for a spec: every accepted spelling, hidden flags
/// excluded. This is what the shell scripts source.
pub fn tokens(spec: Slice<Flag>) -> Slice<string> {
  let mut out: Slice<string> = []
  for fl in spec {
    if fl.hidden { continue }
    out = out.append(fl.name)
    for a in strings.Fields(fl.alias) { out = out.append(a) }
  }
  out
}

/// One entity name, supplied positionally or by its named flag.
pub fn entity_name(p: Parsed, flag: string, usage: string) -> Result<string, pb.CliError> {
  if p.first() != "" && p.given(flag) {
    return Err(usage_error(f"give the name as a positional argument or {flag}, not both\nusage: {usage}"))
  }
  let value = if p.given(flag) { p.one(flag) } else { p.first() }
  if strings.TrimSpace(value) == "" { return Err(usage_error(f"a name is required\nusage: {usage}")) }
  Ok(value)
}

/// Team selection is shared by every team-scoped command; existing create
/// metadata keeps its spelling while other verbs gain the same selector.
pub fn with_team(spec: Slice<Flag>) -> Slice<Flag> {
  if spec.find(|f| f.name == "--team").is_some() { return spec }
  spec.append(Flag { name: "--team", value: true, hint: "KEY", help: "team for this invocation (overrides LLL_TEAM; never writes config)", .. })
}

/// Strip only actual --team options, preserving bodies and other flag values
/// literally. Return the selection separately so parsing has no side effects.
pub fn extract_team(args: Slice<string>, start: int, spec: Slice<Flag>) -> Result<(Slice<string>, Option<string>), pb.CliError> {
  let mut cleaned = args[..start].clone()
  let mut team: Option<string> = None
  let mut given = 0
  let mut i = start
  while let Some(arg) = args.get(i) {
    if arg == "--" {
      for rest in args[i..] { cleaned = cleaned.append(rest) }
      break
    }
    if arg == "--team" || arg.starts_with("--team=") {
      let value = if arg == "--team" {
        let Some(value) = args.get(i + 1) else { return Err(usage_error("--team requires a team key")) }
        i += 1
        value
      } else {
        strings.TrimPrefix(arg, "--team=")
      }
      if strings.TrimSpace(value) == "" { return Err(usage_error("--team requires a nonempty team key")) }
      team = Some(value)
      given += 1
    } else {
      cleaned = cleaned.append(arg)
      if spec.find(|f| f.value && spells(f, arg)).is_some() {
        if let Some(value) = args.get(i + 1) {
          cleaned = cleaned.append(value)
          i += 1
        }
      }
    }
    i += 1
  }
  // A second --team used to win silently (T7, the LLL-381 drop for --team):
  // refused like every other single-value flag.
  if given > 1 {
    return Err(usage_error(f"--team may only be given once (got {given}); it takes a single value"))
  }
  Ok((cleaned, team))
}

/// Look up the declaration shared by parsing and completions.
pub fn command_spec(cmds: Slice<Command>, verb: string) -> Slice<Flag> {
  let Some(c) = resolve_command(cmds, verb) else { return [] }
  c.spec
}

/// Resolve both advertised verbs and accepted aliases to the same command.
pub fn resolve_command(cmds: Slice<Command>, verb: string) -> Option<Command> {
  if verb.is_empty() { return None }
  cmds.find(|c| c.name == verb || c.alias == verb || c.hidden_alias == verb)
}

/// Shell completion offers every accepted spelling without duplicating help,
/// except a hidden verb's.
pub fn command_names(cmds: Slice<Command>) -> Slice<string> {
  let mut names: Slice<string> = []
  for c in cmds.filter(|c| !c.hidden) {
    names = names.append(c.name)
    if !c.alias.is_empty() { names = names.append(c.alias) }
  }
  names
}
