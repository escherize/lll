// Unit cover for the shared flag parser, usage/section generators and the
// completion token emitter — the three surfaces that used to be maintained
// by hand in three places (TASK-127).

/// A spec that does NOT declare --help - which 27 of the CLI's 37 specs did
/// not, and is exactly the case TASK-237 fixed. spec() above declares it, so
/// it exercises the opposite branch (the caller prints its own help).
fn bare_spec() -> Slice<Flag> {
  [
    Flag { name: "--state", value: true, hint: "s", help: "state", .. },
    Flag { name: "--json", help: "raw JSON", .. },
  ]
}

fn spec() -> Slice<Flag> {
  [
    Flag { name: "-t", value: true, hint: "\"title\"", help: "title", .. },
    Flag { name: "--state", value: true, hint: "s", help: "state", .. },
    Flag { name: "-d", alias: "--description", value: true, hint: "desc", help: "description", .. },
    Flag { name: "--label", value: true, hint: "name", repeat: true, help: "label", .. },
    Flag { name: "--json", help: "raw JSON", .. },
    Flag { name: "--help", alias: "-h", hidden: true, help: "help", .. },
  ]
}

fn argv(rest: Slice<string>) -> Slice<string> {
  ["lll", "issue", "list"].append(rest...)
}

// ------------------------------------------------------------------ parse

#[test]
fn parse_collects_values_and_booleans() {
  let assert Ok(p) = parse(spec(), argv(["--json", "-t", "hi"]), 3, false, "")
  assert p.given("--json")
  assert p.one("-t") == "hi"
  assert !p.given("--state")
  assert p.one("--state") == ""
}

#[test]
fn parse_resolves_aliases_under_the_canonical_name() {
  let assert Ok(long) = parse(spec(), argv(["--description", "x"]), 3, false, "")
  let assert Ok(short) = parse(spec(), argv(["-d", "x"]), 3, false, "")
  assert long.given("-d") && long.given("--description")
  assert short.given("-d") && short.given("--description")
  assert short.one("-d") == "x"
}

#[test]
fn parse_accepts_a_hidden_flag_by_either_spelling() {
  // Alias resolution, on a flag that still carries a value. This used to be
  // written against --help, which no longer reaches the value map at all:
  // TASK-237 made a help request short-circuit as an Err precisely so a verb
  // body cannot run after one. See the help tests at the bottom of this file.
  let assert Ok(p) = parse(spec(), argv(["--description", "x"]), 3, false, "")
  assert p.given("--description") && p.given("-d")
  let assert Ok(short) = parse(spec(), argv(["-d", "x"]), 3, false, "")
  assert short.given("--description")
  assert short.one("--description") == "x"
}

#[test]
fn parse_repeats_accumulate_and_single_values_take_the_last() {
  let assert Ok(p) = parse(spec(), argv(["--label", "a", "--label", "b"]), 3, false, "")
  assert p.all("--label").equals(["a", "b"])
  let assert Ok(twice) = parse(spec(), argv(["-t", "one", "-t", "two"]), 3, false, "")
  assert twice.one("-t") == "two"
}

#[test]
fn parse_errors_on_unknown_flags() {
  let assert Err(msg) = parse(spec(), argv(["--nope"]), 3, false, "")
  assert msg == "unknown flag: '--nope'"
  // A bad flag after a good one is still an error.
  let assert Err(later) = parse(spec(), argv(["--json", "--nope"]), 3, false, "")
  assert later.contains("unknown flag: '--nope'")
}

#[test]
fn parse_errors_on_a_missing_value() {
  let assert Err(msg) = parse(spec(), argv(["-t"]), 3, false, "")
  assert msg == "-t requires a value"
  // The error names the spelling the user typed, not the canonical name.
  let assert Err(alias) = parse(spec(), argv(["--description"]), 3, false, "")
  assert alias == "--description requires a value"
}

#[test]
fn parse_appends_the_usage_line_to_unknown_flag_errors() {
  let assert Err(msg) = parse(spec(), argv(["--nope"]), 3, false, "lll issue list")
  assert msg.contains("unknown flag: '--nope'")
  assert msg.contains("usage: lll issue list")
  // No usage line given: the message stays bare.
  let assert Err(bare) = parse(spec(), argv(["--nope"]), 3, false, "")
  assert bare == "unknown flag: '--nope'"
}

#[test]
fn parse_errors_when_a_required_flag_is_missing() {
  let required = [Flag { name: "-t", value: true, hint: "\"title\"", required: true, help: "title", .. }]
  let assert Err(msg) = parse(required, argv([]), 3, false, "lll issue create -t \"title\"")
  assert msg == "usage: lll issue create -t \"title\""
  // A bad flag is reported before the missing requirement.
  let assert Err(bad) = parse(required, argv(["--nope"]), 3, false, "usage")
  assert bad.contains("unknown flag")
  let assert Ok(p) = parse(required, argv(["-t", "hi"]), 3, false, "usage")
  assert p.given("-t")
}

#[test]
fn parse_collects_a_single_positional_when_allowed() {
  let assert Ok(p) = parse(spec(), argv(["--json", "ENG-6"]), 3, true, "")
  assert p.first() == "ENG-6"
  // A second positional is rejected, naming the stray argument.
  let assert Err(msg) = parse(spec(), argv(["ENG-6", "ENG-7"]), 3, true, "")
  assert msg == "unexpected argument: 'ENG-7'"
}

#[test]
fn parse_rejects_positionals_when_disallowed() {
  let assert Err(msg) = parse(spec(), argv(["stray"]), 3, false, "usage line")
  assert msg == "unknown flag: 'stray'\nusage: usage line"
}

#[test]
fn parse_treats_a_bare_dash_as_an_unknown_flag() {
  let assert Err(msg) = parse(spec(), argv(["-"]), 3, true, "")
  assert msg == "unknown flag: '-'"
}

#[test]
fn parse_never_matches_an_empty_alias() {
  // A bare word is a positional, not a match for some flag's empty alias.
  let assert Ok(p) = parse(spec(), argv(["ENG-6"]), 3, true, "")
  assert p.first() == "ENG-6"
}

#[test]
fn parse_swallows_the_next_argument_as_a_value_without_looking_at_it() {
  // A value flag consumes blindly, even when the value looks like a flag.
  let assert Ok(p) = parse(spec(), argv(["-t", "--json"]), 3, false, "")
  assert p.one("-t") == "--json"
  assert !p.given("--json")
}

// TASK-165: `--flag=value`, which every shell and every other tracker CLI
// accepts, used to fail as `unknown flag: '--limit=5'`.

#[test]
fn parse_accepts_an_inline_value_after_an_equals() {
  let assert Ok(p) = parse(spec(), argv(["--state=done"]), 3, false, "")
  assert p.one("--state") == "done"
  // Under either spelling, landing on the canonical name as usual.
  let assert Ok(alias) = parse(spec(), argv(["--description=x"]), 3, false, "")
  assert alias.one("-d") == "x"
  let assert Ok(short) = parse(spec(), argv(["-t=hi"]), 3, false, "")
  assert short.one("-t") == "hi"
  // Repeats still accumulate, mixed with the spaced form.
  let assert Ok(rep) = parse(spec(), argv(["--label=a", "--label", "b"]), 3, false, "")
  assert rep.all("--label").equals(["a", "b"])
}

#[test]
fn parse_splits_an_inline_value_at_the_first_equals_only() {
  let assert Ok(p) = parse(spec(), argv(["--state=a=b"]), 3, false, "")
  assert p.one("--state") == "a=b"
}

#[test]
fn parse_accepts_an_empty_inline_value() {
  // `--state=` is an explicit empty string, not a missing value: it is how a
  // caller clears a field, and it must not eat the next argument.
  let assert Ok(p) = parse(spec(), argv(["--state=", "--json"]), 3, false, "")
  assert p.given("--state")
  assert p.one("--state") == ""
  assert p.given("--json")
}

#[test]
fn parse_rejects_an_inline_value_on_a_boolean_flag() {
  // `--json=1` is a mistake, not a truthy string, so it must not pass silently.
  let assert Err(msg) = parse(spec(), argv(["--json=1"]), 3, false, "")
  assert msg == "--json takes no value"
  let assert Err(zero) = parse(spec(), argv(["--json=0"]), 3, false, "")
  assert zero == "--json takes no value"
}

#[test]
fn parse_reports_the_whole_argument_for_an_unknown_inline_flag() {
  let assert Err(msg) = parse(spec(), argv(["--nope=5"]), 3, false, "lll issue list")
  assert msg.contains("unknown flag: '--nope=5'")
  assert msg.contains("usage: lll issue list")
}

#[test]
fn parse_leaves_an_equals_in_a_positional_or_a_value_alone() {
  // Only dash-prefixed arguments split; a bare word keeps its equals.
  let assert Ok(p) = parse(spec(), argv(["a=b"]), 3, true, "")
  assert p.first() == "a=b"
  // A spaced value is still consumed without looking at it.
  let assert Ok(v) = parse(spec(), argv(["-t", "--state=done"]), 3, false, "")
  assert v.one("-t") == "--state=done"
  assert !v.given("--state")
}

// ------------------------------------------------------------------ usage

#[test]
fn usage_renders_required_optional_and_repeated_flags() {
  let required = [Flag { name: "-t", value: true, hint: "\"title\"", required: true, help: "title", .. }]
  let tail = [
    Flag { name: "-d", alias: "--description", value: true, hint: "desc", help: "description", .. },
    Flag { name: "--label", value: true, hint: "name", repeat: true, help: "label", .. },
    Flag { name: "--json", help: "raw JSON", .. },
  ]
  let mixed = required.append(tail...)
  assert usage("lll issue create", mixed, "") ==
  "lll issue create -t \"title\" [-d desc] [--label name]... [--json]"
  assert usage("lll issue view", tail, "[KEY-123]") ==
  "lll issue view [KEY-123] [-d desc] [--label name]... [--json]"
}

#[test]
fn usage_skips_hidden_flags() {
  assert !usage("lll watch", spec(), "").contains("--help")
}

// ---------------------------------------------------------------- section

#[test]
fn section_lists_every_visible_flag_and_skips_hidden_ones() {
  let s = section(spec())
  assert s.contains("Flags:")
  for fl in spec() {
    if fl.hidden {
      assert !s.contains(fl.name)
    } else {
      assert s.contains(fl.name)
    }
  }
}

#[test]
fn section_aligns_continuation_lines_to_the_help_column() {
  let spec = [Flag { name: "--emoji", value: true, hint: "X", help: "one emoji\nsecond line", .. }]
  let s = section(spec)
  assert s.contains("\n  --emoji  one emoji")
  assert s.contains("\n           second line")
}

#[test]
fn section_is_empty_without_visible_flags() {
  let spec = [Flag { name: "--help", alias: "-h", hidden: true, help: "help", .. }]
  assert section(spec) == ""
}

// ----------------------------------------------------------------- tokens

#[test]
fn tokens_list_every_spelling_and_skip_hidden_flags() {
  assert tokens(spec()).equals(["-t", "--state", "-d", "--description", "--label", "--json"])
}

// ------------------------------------------------------------------- help

// TASK-237: --help and -h work on EVERY verb, whether or not its spec
// declares them, and they must never let the command body run. Only 10 of 37
// specs declared the flag, so `lll issue list -h` used to answer
// `unknown flag: '-h'` - help refused by the machinery that would print it.

#[test]
fn help_is_answered_even_when_the_spec_never_declares_it() {
  // spec() has no --help entry; this is the case that was broken.
  let assert Err(msg) = parse(bare_spec(), argv(["-h"]), 3, false, "lll issue list")
  assert msg.starts_with(help_marker())
  assert msg.contains("usage: lll issue list")
  assert msg.contains("--state")
  let assert Err(long) = parse(bare_spec(), argv(["--help"]), 3, false, "lll issue list")
  assert long.starts_with(help_marker())
}

#[test]
fn help_wins_over_the_errors_that_used_to_pre_empt_it() {
  // A required flag that was never given: the old order reported the missing
  // flag, so `--help` could not be used to find out what it was.
  let req = [
    Flag { name: "-t", value: true, hint: "title", required: true, help: "title", .. },
  ]
  let assert Err(msg) = parse(req, argv(["--help"]), 3, false, "lll issue create")
  assert msg.starts_with(help_marker())
  // And an unknown flag alongside help: the help still wins, because someone
  // typing both is asking what the right spelling is.
  let assert Err(both) = parse(bare_spec(), argv(["--nope", "-h"]), 3, false, "u")
  assert both.starts_with(help_marker())
}

#[test]
fn help_never_returns_ok_so_a_verb_body_cannot_run() {
  // The load-bearing property. Recording --help as a parsed VALUE instead
  // would make `lll label create -h` parse happily and then execute - a
  // write. Every caller writes `flags.parse(...)?`, so an Err short-circuits
  // the verb the same way a bad flag does.
  let assert Err(_) = parse(bare_spec(), argv(["-h"]), 3, false, "u")
  let assert Err(_) = parse(bare_spec(), argv(["--help"]), 3, true, "u")
}

#[test]
fn help_for_a_verb_with_no_flags_says_so_instead_of_printing_nothing() {
  let assert Err(msg) = parse([], argv(["-h"]), 3, false, "")
  assert msg == f"{help_marker()}this command takes no flags (see 'lll --help')"
}

#[test]
fn a_help_spelling_inside_a_value_is_not_a_help_request() {
  // `--state -h` means the state is literally "-h": odd, but it is a VALUE,
  // and treating it as help would refuse a legitimate parse. The scan is
  // deliberately over the raw args, so this documents the edge it accepts.
  let assert Err(msg) = parse(bare_spec(), argv(["--state", "-h"]), 3, false, "u")
  assert msg.starts_with(help_marker())
}
