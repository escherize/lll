import "go:bufio"
import "go:bytes"
import "go:encoding/json"
import "go:fmt"
import "go:net/http"
import "go:net/url"
import "go:os"
import "go:strings"
import "go:time"

import "pb"

/// A record event from a PocketBase realtime stream. `topic` is the
/// subscription topic with any ?options= suffix stripped ("issues",
/// "issues/RECORDID", "comments"); `data` is the raw JSON payload,
/// {"action":"create|update|delete","record":{...}}.
pub struct Event {
  pub topic: string,
  pub data: string,
}

/// One complete SSE frame: the event name and its data payload
/// (multi-line data joined with newlines).
pub struct Frame {
  pub event: string,
  pub data: string,
}

/// Incremental SSE frame parser. Feed one line at a time (without the
/// trailing newline); a blank line completes and returns the frame.
/// Pure state machine — no IO.
pub struct FrameParser { event: string, data: Slice<string> }

impl FrameParser {
  pub fn new() -> FrameParser {
    FrameParser { event: "", data: [] }
  }

  /// Feed one line. Returns the completed frame at a blank-line delimiter,
  /// None otherwise. Comment lines (leading ':') and fields other than
  /// event/data (id, retry) are ignored; a stray blank line yields nothing.
  pub fn push_line(self: mut Ref<FrameParser>, raw: string) -> Option<Frame> {
    let line = strings.TrimSuffix(raw, "\r")
    if line == "" {
      if self.event == "" && self.data.is_empty() { return None }
      let frame = Frame {
        event: self.event,
        data: strings.Join(self.data, "\n"),
      }
      self.event = ""
      self.data = []
      return Some(frame)
    }
    if line.starts_with(":") { return None }
    let (field, value) = split_field(line)
    match field {
      "event" => self.event = value,
      "data" => self.data = self.data.append(value),
      other => (),
    }
    None
  }
}

/// Split an SSE line at the first colon; one leading space of the value is
/// eaten per the SSE spec. A line without a colon is a field with no value.
fn split_field(line: string) -> (string, string) {
  // SplitN, not Index + substring: strings.Index returns a BYTE offset while
  // substring takes RUNE indices, so any multi-byte character in the line made
  // the two disagree and panicked with "substring index out of range".
  let parts = strings.SplitN(line, ":", 2)
  let Some(value) = parts.get(1) else {
    return (line, "")
  }
  (parts[0], strings.TrimPrefix(value, " "))
}

#[json]
struct OptionsQuery {
  #[json(omitempty)]
  filter: string,
  #[json(omitempty)]
  expand: string,
}

#[json]
struct TopicOptions { query: OptionsQuery }

/// A subscription topic with server-side options attached:
/// topic?options=<url-encoded {"query":{"filter":...,"expand":...}}>.
/// The "query" wrapper is load-bearing: PB silently ignores a bare
/// {"filter":...} object (verified against PB 0.40.1 — no error, no
/// filtering). Empty filter and expand return the topic unchanged.
pub fn topic_with_options(
  topic: string,
  filter: string,
  expand: string,
) -> Result<string, string> {
  if filter == "" && expand == "" { return Ok(topic) }
  let options = TopicOptions { query: OptionsQuery { filter, expand } }
  let encoded = match json.Marshal(options) {
    Ok(b) => b as string,
    Err(e) => return Err(f"encoding topic options: {e}"),
  }
  Ok(f"{topic}?options={url.QueryEscape(encoded)}")
}

/// The topic without its ?options= suffix.
fn strip_options(topic: string) -> string {
  // SplitN keeps this byte-safe; see split_field.
  strings.SplitN(topic, "?", 2)[0]
}

#[json]
struct ConnectMsg {
  #[json("clientId")]
  client_id: string,
}

#[json]
struct SubscribeMsg {
  #[json("clientId")]
  client_id: string,
  subscriptions: Slice<string>,
}

/// What the reconnect loop does when the server refuses the token
/// (`auth_failure`). Each caller picks one; there is no default.
pub enum DeadToken {
  /// Re-mint with this function, renew the client's token to it and retry:
  /// `lll up` passes its superuser credentials' minter when it minted the
  /// process token itself, so an expired token heals instead of wedging
  /// the board.
  Remint(fn() -> Result<string, string>),
  /// Keep retrying, printing the failure once. For a caller-provided token
  /// the process cannot renew; a token fixed in a config file is picked up
  /// on the next attempt.
  Retry,
  /// Print one line naming the cause and the fix, then exit 1 (`lll watch`,
  /// LLL-617): a watch cannot mint a token, and retrying a dead one forever
  /// looks the same as a quiet board.
  Exit,
}

/// Subscribe to PB realtime topics and stream their record events.
///
/// The first connection is established synchronously so configuration errors
/// (bad URL, PB down, a rejected token) surface immediately; after that a
/// background task pumps events into the returned channel and, on any stream
/// error (PB restart, idle disconnect), reconnects from scratch — new SSE
/// connection, new client id, re-subscribe — retrying every second, forever.
/// The loop is honest about state instead of silently stopping: a lost stream
/// and every distinct reconnect error are printed, and a recovery is too.
///
/// `on_dead_token` decides what an auth-shaped failure (401/403, including
/// connect's token check) does; see DeadToken. Under Retry each refused
/// attempt re-reads the config files, so a token rotated in a config file is
/// picked up without a restart — an env token is frozen for the process's
/// life, which only a re-mint can unlock.
///
/// The protocol (verified live against PB 0.40.1): GET /api/realtime opens an
/// SSE stream whose first event is PB_CONNECT carrying {"clientId":...};
/// POSTing {"clientId","subscriptions":[...]} back to /api/realtime (204)
/// activates the topics; record events then arrive named by topic, verbatim
/// including any options suffix.
pub fn subscribe(
  ctx: pb.Client,
  topics: Slice<string>,
  on_dead_token: DeadToken,
) -> Result<Channel<Event>, string> {
  start(ctx, topics, on_dead_token, false)
}

/// The topic of the event subscribe_resyncing sends after each reconnect.
/// PocketBase does not replay what happened while the stream was down, so a
/// consumer that renders state (the board, LLL-666) re-reads everything it
/// shows when this arrives. Not a PocketBase topic: it carries no data.
pub const RESYNC: string = "lll:resync"

/// subscribe, plus one Event { topic: RESYNC } after every reconnect, sent
/// once the new subscriptions are accepted and before the first event they
/// carry. The first connection sends none: there was no outage to cover.
pub fn subscribe_resyncing(
  ctx: pb.Client,
  topics: Slice<string>,
  on_dead_token: DeadToken,
) -> Result<Channel<Event>, string> {
  start(ctx, topics, on_dead_token, true)
}

fn start(
  ctx: pb.Client,
  topics: Slice<string>,
  on_dead_token: DeadToken,
  resync: bool,
) -> Result<Channel<Event>, string> {
  let ch = Channel.new<Event>()
  let mut reader = match connect(ctx, topics) {
    Ok(r) => r,
    Err(e) => {
      if auth_failure(e) {
        if let DeadToken.Exit = on_dead_token { return Err(pb.fail(pb.ErrorKind.Auth, dead_token_fix(e))) }
      }
      return Err(e)
    },
  }
  task {
    pump(reader, ch)
    reconnect(ctx, topics, on_dead_token, ch, resync)
  }
  Ok(ch)
}

/// The reconnect loop after the first stream is lost. Retries every second
/// forever; prints each state change once, so a long outage cannot spam the
/// log with a line a second, but a board whose subscription died is never
/// indistinguishable from a live one.
fn reconnect(
  ctx: pb.Client,
  topics: Slice<string>,
  on_dead_token: DeadToken,
  ch: Channel<Event>,
  resync: bool,
) {
  fmt.Fprintln(os.Stderr, "realtime: lll server stream lost; reconnecting")
  let mut last_err = ""
  loop {
    time.Sleep(time.Second)
    match connect(ctx, topics) {
      Ok(r) => {
        fmt.Fprintln(os.Stderr, "realtime: reconnected to the lll server (subscriptions accepted)")
        last_err = ""
        if resync { let _ = ch.send(Event { topic: RESYNC, data: "" }) }
        pump(r, ch)
        fmt.Fprintln(os.Stderr, "realtime: lll server stream lost; reconnecting")
      },
      Err(e) => {
        let dead = auth_failure(e)
        if dead {
          if let DeadToken.Exit = on_dead_token {
            fmt.Fprintln(os.Stderr, f"realtime: {dead_token_fix(e)}")
            os.Exit(pb.exit_code(pb.ErrorKind.Auth))
          }
        }
        if e != last_err {
          fmt.Fprintln(os.Stderr, f"realtime: reconnect failed: {pb.plain(e)}")
          last_err = e
        }
        if dead {
          if let DeadToken.Remint(mint) = on_dead_token {
            if let Ok(tok) = mint() {
              ctx.renew_to(tok)
              fmt.Fprintln(os.Stderr,
                "realtime: renewed the server auth token after an auth failure",
              )
            }
          }
          if let DeadToken.Retry = on_dead_token { ctx.reload_token() }
        }
      },
    }
  }
}

/// Does a connect error name an authorization refusal? connect's status
/// errors are "GET|POST /api/realtime: <status>", so matching the path plus
/// code cannot confuse a port number for a status; the token check's
/// refusal starts with TOKEN_REJECTED.
fn auth_failure(e: string) -> bool {
  strings.Contains(e, "/api/realtime: 401") ||
  strings.Contains(e, "/api/realtime: 403") ||
  e.starts_with(TOKEN_REJECTED)
}

const TOKEN_REJECTED: string = "the server rejected this token"

/// The auth failure with the fix a person or agent can act on, for a
/// caller that cannot renew its own token.
fn dead_token_fix(e: string) -> string {
  f"{pb.plain(e)}; run 'lll login', or set a fresh LLL_TOKEN ('lll bot rotate bot-NAME' or 'lll token create NAME'), then start the watch again"
}

/// Open the SSE stream, wait for PB_CONNECT, and POST the subscriptions.
/// Returns a reader positioned at the first record event.
///
/// Both requests carry the configured token: the rules make every topic
/// authenticated-only now, PocketBase derives the client's authorization
/// from the connect request (apis/realtime.go reads the standard
/// Authorization header), and the subscription POST must present the same
/// identity or the upgrade from guest is refused.
fn connect(
  ctx: pb.Client,
  topics: Slice<string>,
) -> Result<mut Ref<bufio.Reader>, string> {
  let base_url = ctx.url()?
  let auth = pb.bearer(ctx.token())
  let mut req = match http.NewRequest(
    "GET",
    base_url + "/api/realtime",
    bytes.NewReader("".bytes()),
  ) {
    Ok(r) => r,
    Err(e) => return Err(f"GET /api/realtime: {e}"),
  }
  if auth != "" {
    // NewRequest always populates Header; the unwrap is the Option field's toll.
    if let Some(h) = req.Header {
      let mut h = h
      h.Set("Authorization", auth)
    }
  }
  let resp = match http.DefaultClient.Do(req) {
    Ok(r) => r,
    Err(e) => return Err(pb.unreachable(base_url, e)),
  }
  let Some(stream) = resp.Body else {
    return Err("GET /api/realtime: empty response body")
  }
  if resp.StatusCode >= 300 {
    let _ = stream.Close()
    return Err(f"GET /api/realtime: {resp.Status}")
  }

  let mut reader = bufio.NewReader(stream)
  let mut parser = FrameParser.new()
  let mut client_id = ""
  while client_id == "" {
    let line = match reader.ReadString('\n') {
      Partial.Ok(l) => l,
      Partial.Both(_, e) => return Err(f"realtime handshake interrupted: {e}"),
      Partial.Err(e) => return Err(f"realtime handshake interrupted: {e}"),
    }
    let Some(frame) = parser.push_line(strings.TrimSuffix(line, "\n")) else {
      continue
    }
    if frame.event != "PB_CONNECT" { continue }
    let mut msg = ConnectMsg { .. }
    if let Err(e) = json.Unmarshal(frame.data.bytes(), &msg) {
      return Err(f"decoding PB_CONNECT: {e}")
    }
    client_id = msg.client_id
  }

  let sub = SubscribeMsg { client_id, subscriptions: topics }
  let payload = match json.Marshal(sub) {
    Ok(b) => b,
    Err(e) => return Err(f"encoding subscription: {e}"),
  }
  let mut sub_req = match http.NewRequest(
    "POST",
    base_url + "/api/realtime",
    bytes.NewReader(payload),
  ) {
    Ok(r) => r,
    Err(e) => return Err(f"POST /api/realtime: {e}"),
  }
  // NewRequest always populates Header; the unwrap is the Option field's toll.
  if let Some(h) = sub_req.Header {
    let mut h = h
    h.Set("Content-Type", "application/json")
    if auth != "" { h.Set("Authorization", auth) }
  }
  let sub_resp = match http.DefaultClient.Do(sub_req) {
    Ok(r) => r,
    Err(e) => return Err(pb.unreachable(base_url, e)),
  }
  if let Some(body) = sub_resp.Body { let _ = body.Close() }
  if sub_resp.StatusCode >= 300 {
    return Err(f"POST /api/realtime: {sub_resp.Status}")
  }
  if let Err(e) = check_token(base_url, auth) {
    let _ = stream.Close()
    return Err(e)
  }
  // The board owns one subscription. Keep its accepted request so a member
  // token renewal can reauthenticate that same client using PocketBase's own
  // subscription endpoint; token-key rotation clears auth without closing SSE.
  ctx.remember_subscription(payload as string)
  Ok(reader)
}

/// LLL-617: one authenticated 1-row read per (re)connect. PocketBase treats
/// a request whose token it cannot load (rotated, revoked, expired) as a
/// guest: GET /api/realtime still answers 200 and the subscription POST 204,
/// but every topic is authenticated-only, so the stream never carries an
/// event. A record request is the cheap place that refuses a guest with 401
/// (gopb's TASK-319 middleware), and teams is readable by every member.
/// Not auth-refresh: bot and `lll token create` tokens are non-refreshable
/// (TASK-309). A token rotated after this check goes unnoticed until the
/// next reconnect, which an idle stream reaches within five minutes.
fn check_token(base_url: string, auth: string) -> Result<(), string> {
  let mut req = match http.NewRequest(
    "GET",
    base_url + "/api/collections/teams/records?perPage=1&fields=id&skipTotal=1",
    bytes.NewReader("".bytes()),
  ) {
    Ok(r) => r,
    Err(e) => return Err(f"token check: {e}"),
  }
  if auth != "" {
    // NewRequest always populates Header; the unwrap is the Option field's toll.
    if let Some(h) = req.Header {
      let mut h = h
      h.Set("Authorization", auth)
    }
  }
  let resp = match http.DefaultClient.Do(req) {
    Ok(r) => r,
    Err(e) => return Err(pb.unreachable(base_url, e)),
  }
  if let Some(body) = resp.Body { let _ = body.Close() }
  if resp.StatusCode == 401 {
    return Err(f"{TOKEN_REJECTED} ({resp.Status}): it was rotated, revoked or has expired, so the stream would carry no events")
  }
  if resp.StatusCode >= 300 {
    return Err(f"token check: {resp.Status}")
  }
  Ok(())
}

/// Forward record events from an established stream into the channel.
/// Returns when the stream errors; the caller reconnects. The dead
/// connection's stream is abandoned (its socket is already gone).
fn pump(reader: mut Ref<bufio.Reader>, ch: Channel<Event>) {
  let mut parser = FrameParser.new()
  loop {
    let line = match reader.ReadString('\n') {
      Partial.Ok(l) => l,
      Partial.Both(_, _) => {
        return
      },
      Partial.Err(_) => {
        return
      },
    }
    let Some(frame) = parser.push_line(strings.TrimSuffix(line, "\n")) else {
      continue
    }
    if frame.event == "PB_CONNECT" { continue }
    let _ = ch.send(
      Event { topic: strip_options(frame.event), data: frame.data },
    )
  }
}
