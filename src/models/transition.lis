import "go:encoding/json"

// State changes and their claim rule (LLL-685).
//
// Every write that changes an issue's state goes through `transition`:
// `issue close`, `issue update --state`, `issue start` and the board's drag.
// It turns the ask into Effects, and the write layer puts a state on the
// wire only as Effects.write(), a StateWrite nothing else can build, so no
// path sets a state around it (scripts/test_transition_ratchet.py).
//
// What the change does to the claim is the server's to decide, inside the
// transaction that saves the issue, after checks this side cannot see (the
// agent label, a read-only member, an archived team). So the client sends
// what was asked and reports what the server did. The rule itself is
// stated here as a table, move_effect and close_effect, and in Go as gopb
// TransitionClaim, which /close and finishReleases (/assignment and a native
// PATCH) enforce; transition.test.lis runs every row through both and fails
// when they disagree.
//
// A state change never edits the assignee: a finished issue keeps it as the
// record of who did the work (fleet case 07). Only an assignee edit clears
// it, and that is the release rule's business, not this table's.

/// Who holds the issue's claim, from the caller's side.
pub enum Hold {
  Unclaimed,
  /// The caller's own hold, in the caller's session.
  Caller,
  /// The caller's member under another non-empty agent label (LLL-521).
  OtherSession,
  /// Another member's hold. A superuser has no member, so every hold is
  /// this to it.
  OtherMember,
}

/// How a state change is asked for.
pub enum Ask {
  /// `lll issue close`: done, and the hold settled whatever the issue was.
  /// `force` takes another's hold, which comments on the issue.
  Close { keep_claim: bool, force: bool },
  /// Any other state write: update --state, start, the board's drag. It
  /// carries no force: another's hold is left alone.
  Move { to: IssueState, keep_claim: bool },
}

/// What the change does to the claim.
pub enum ClaimEffect {
  /// No hold, or a move that is not a finish.
  Untouched,
  /// The holder's own finish gives the hold back.
  Released,
  /// The holder finished and kept the hold (--keep-claim).
  Kept,
  /// A forced close took another's hold, and comments on the issue.
  ForceReleased,
  /// A move into done or cancelled by anyone but the holder leaves the hold.
  Left,
}

/// Why a state change is refused, with the server's code for it.
pub enum Refusal {
  /// Closing over another's hold needs force (needs_force).
  NeedsForce,
  /// Only the holder keeps a hold while closing (claim_held).
  KeepNotHolder,
}

/// The write a state change makes: the state, and the claim opt-out the
/// request carries. Only `transition` builds one; the field is private so
/// nothing else can.
pub struct Effects {
  asked: Ask,
}

impl Effects {
  /// The state the issue moves to.
  pub fn state(self) -> IssueState {
    match self.asked {
      Ask.Close { .. } => IssueState.Done,
      Ask.Move { to, .. } => to,
    }
  }

  /// The opt-out the request carries.
  pub fn keep_claim(self) -> bool {
    match self.asked {
      Ask.Close { keep_claim, .. } => keep_claim,
      Ask.Move { keep_claim, .. } => keep_claim,
    }
  }

  /// The state as a write body carries it.
  pub fn write(self) -> StateWrite {
    StateWrite { wire: self.state().wire() }
  }
}

/// A state on the wire. Its field is private, so the only way to put a state
/// into a write body is Effects.write(); it encodes as the wire string.
pub struct StateWrite {
  wire: string,
}

impl StateWrite {
  pub fn MarshalJSON(self) -> Result<Slice<byte>, error> {
    json.Marshal(self.wire)
  }
}

/// The one door to a state write.
pub fn transition(asked: Ask) -> Effects {
  Effects { asked }
}

/// The move rows of the claim rule: a move into done or cancelled by the
/// holder releases the hold (or keeps it, asked to); by anyone else it
/// leaves the hold; any other move touches none. `from` is the issue's state
/// as read (None for a value this lll does not know).
pub fn move_effect(from: Option<IssueState>, to: IssueState, hold: Hold, keep_claim: bool) -> ClaimEffect {
  if hold == Hold.Unclaimed || from == Some(to) || !to.is_terminal() { return ClaimEffect.Untouched }
  if hold != Hold.Caller { return ClaimEffect.Left }
  if keep_claim { ClaimEffect.Kept } else { ClaimEffect.Released }
}

/// The close rows: a close settles any hold. The holder's is released or
/// kept; anyone else's needs force, which releases it with a comment, and
/// cannot be kept.
pub fn close_effect(hold: Hold, keep_claim: bool, force: bool) -> Result<ClaimEffect, Refusal> {
  if hold == Hold.Unclaimed { return Ok(ClaimEffect.Untouched) }
  if hold != Hold.Caller {
    if !force { return Err(Refusal.NeedsForce) }
    if keep_claim { return Err(Refusal.KeepNotHolder) }
    return Ok(ClaimEffect.ForceReleased)
  }
  if keep_claim { Ok(ClaimEffect.Kept) } else { Ok(ClaimEffect.Released) }
}

/// The hold `claim` is to the member `me` (None for a superuser) acting
/// under the agent label `agent` ("" for none). Two labels differ only when
/// both are set, the server's agentsDiffer.
pub fn hold_of(claim: Option<Claim>, me: Option<MemberId>, agent: string) -> Hold {
  let Some(held) = claim else { return Hold.Unclaimed }
  if me != Some(held.member) { return Hold.OtherMember }
  if held.agent != "" && agent != "" && held.agent != agent { return Hold.OtherSession }
  Hold.Caller
}
