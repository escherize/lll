// The transition table (LLL-685): what changing an issue's state does to
// its claim, decided in one pure function. Every path that changes a state
// plans its write through `transition` - `issue close`, `issue update
// --state`, `issue start` and the board's drag - and the write layer takes
// only the Effects it returns, so no path sets a state around it.
//
// The server enforces the same table in Go, because its hooks and routes run
// there, inside the transaction that saves the issue: gopb TransitionClaim,
// called by /close and by finishReleases (/assignment and a native PATCH).
// transition.test.lis runs every row through both and fails when they
// disagree, so a raw API client gets what the CLI and the board predict.
//
// A state change never edits the assignee: a finished issue keeps it as the
// record of who did the work (fleet case 07). Only an assignee edit clears
// it, and that is the release rule's business, not this table's.

/// Who holds the issue's claim, from the caller's side.
pub enum Hold {
  Unclaimed,
  /// The caller's own hold, in the caller's session.
  Caller,
  /// The caller's member under another non-empty agent label (LLL-521).
  OtherSession,
  /// Another member's hold. A superuser has no member, so every hold is
  /// this to it.
  OtherMember,
}

/// How a state change is asked for.
pub enum Ask {
  /// `lll issue close`: done, and the hold settled whatever the issue was.
  /// `force` takes another's hold, which comments on the issue.
  Close { keep_claim: bool, force: bool },
  /// Any other state write: update --state, start, the board's drag. It
  /// carries no force: another's hold is left alone.
  Move { to: IssueState, keep_claim: bool },
}

/// What the change does to the claim.
pub enum ClaimEffect {
  /// No hold, or a move that is not a finish.
  Untouched,
  /// The holder's own finish gives the hold back.
  Released,
  /// The holder finished and kept the hold (--keep-claim).
  Kept,
  /// A forced close took another's hold, and comments on the issue.
  ForceReleased,
  /// A move into done or cancelled by anyone but the holder leaves the hold.
  Left,
}

/// Why a state change is refused, with the server's code for it.
pub enum Refusal {
  /// Closing over another's hold needs force (needs_force).
  NeedsForce,
  /// Only the holder keeps a hold while closing (claim_held).
  KeepNotHolder,
}

impl Refusal {
  /// The refusal in the server's words (gopb releaseAuthority and closeIssue,
  /// as PocketBase sentences them), so a refusal decided here before any
  /// request reads as the one the server gives a raw API client. `holder` is
  /// the holder's byline as the caller may see it.
  pub fn message(self, hold: Hold, holder: string) -> string {
    match self {
      Refusal.NeedsForce => {
        let whose = if hold == Hold.OtherSession { "another session's" } else { "another member's" }
        f"The claim is held by {holder}; releasing {whose} claim needs force."
      },
      Refusal.KeepNotHolder => f"The claim is held by {holder}; only the holder keeps a claim while closing, and closing anyone else's claimed issue releases it.",
    }
  }
}

/// The writes a state change makes: the state, and what becomes of the
/// claim. Only `transition` builds one; the fields are private so nothing
/// else can.
pub struct Effects {
  asked: Ask,
  effect: ClaimEffect,
}

impl Effects {
  /// The state the issue moves to.
  pub fn state(self) -> IssueState {
    match self.asked {
      Ask.Close { .. } => IssueState.Done,
      Ask.Move { to, .. } => to,
    }
  }

  pub fn claim(self) -> ClaimEffect {
    self.effect
  }

  /// The opt-out the request carries: the server re-decides under its lock,
  /// so it gets what was asked, not only what was predicted.
  pub fn keep_claim(self) -> bool {
    match self.asked {
      Ask.Close { keep_claim, .. } => keep_claim,
      Ask.Move { keep_claim, .. } => keep_claim,
    }
  }
}

/// The table. `from` is the issue's state as read (None for a value this
/// lll does not know). A close does not consult it.
pub fn transition(from: Option<IssueState>, hold: Hold, asked: Ask) -> Result<Effects, Refusal> {
  let mine = match hold {
    Hold.Unclaimed => return Ok(Effects { asked, effect: ClaimEffect.Untouched }),
    Hold.Caller => true,
    Hold.OtherSession | Hold.OtherMember => false,
  }
  let effect = match asked {
    Ask.Close { keep_claim, force } => {
      if !mine && !force { return Err(Refusal.NeedsForce) }
      if !mine && keep_claim { return Err(Refusal.KeepNotHolder) }
      if !mine {
        ClaimEffect.ForceReleased
      } else if keep_claim {
        ClaimEffect.Kept
      } else {
        ClaimEffect.Released
      }
    },
    Ask.Move { to, keep_claim } => {
      if from == Some(to) || !to.is_terminal() {
        ClaimEffect.Untouched
      } else if !mine {
        ClaimEffect.Left
      } else if keep_claim {
        ClaimEffect.Kept
      } else {
        ClaimEffect.Released
      }
    },
  }
  Ok(Effects { asked, effect })
}

/// The hold `claim` is to the member `me` (None for a superuser) acting
/// under the agent label `agent` ("" for none). Two labels differ only when
/// both are set, the server's agentsDiffer.
pub fn hold_of(claim: Option<Claim>, me: Option<MemberId>, agent: string) -> Hold {
  let Some(held) = claim else { return Hold.Unclaimed }
  if me != Some(held.member) { return Hold.OtherMember }
  if held.agent != "" && agent != "" && held.agent != agent { return Hold.OtherSession }
  Hold.Caller
}
