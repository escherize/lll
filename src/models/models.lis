  #[json(omitempty)]
  pub description: string,
  pub status: string,
  pub team: TeamId,
}

#[json]
pub struct LabelExpand {
  pub team: Team,
}

#[json]
pub struct Label {
  pub id: LabelId,
  pub name: string,
  pub color: string,
  pub team: TeamId,
  pub expand: LabelExpand,
}

#[json]
pub struct LabelList {
  pub items: Slice<Label>,
}

#[json]
pub struct NewLabel {
  pub name: string,
  #[json(omitempty)]
  pub color: string,
  pub team: TeamId,
