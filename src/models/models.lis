#[json]
pub struct Team {
  pub id: string,
  pub key: string,
  pub name: string,
  // The team's accent colour as "#rrggbb". Empty means DESIGN.md's canonical
  // ember orange, which theme.css already hard-codes.
  pub accent: string,
  // An optional glyph beside the key, and the tab icon's mark (LLL-427).
  // Empty renders exactly as before: the letter derived from the key.
  pub emoji: string,
  // The lifecycle end (TASK-210): an archived team leaves the rail switcher
  // and default team lists; its board stays readable at /t/KEY/ and its data
  // is untouched. 'lll team unarchive KEY' brings it back.
  pub archived: bool,
}

#[json]
pub struct TeamList {
  pub items: Slice<Team>,
}

#[json]
pub struct NewTeam {
  pub key: string,
  pub name: string,
}

#[json]
pub struct Member {
  pub id: string,
  pub name: string,
  pub email: string,
  // Bot accounts (LLL-407): "person" or "bot"; "" only on servers that have
  // not applied the kind migration. `owner` is the creating human member's
  // id, empty for people and for bots minted by the superuser.
  pub kind: string,
  #[json(omitempty)]
  pub owner: string,
}

#[json]
pub struct MemberList {
  pub items: Slice<Member>,
}

#[json]
pub struct NewMember {
  pub name: string,
  #[json(omitempty)]
  pub email: string,
  // members is an auth collection (TASK-180): PB requires the password pair
  // on create. Random and never printed — nobody logs in until a real
  // password is set by an admin or the member.
  pub password: string,
  #[json("passwordConfirm")]
  pub password_confirm: string,
  // keeps emails visible to `lll member list` and the board, as they were
  // before the collection became an auth one.
  #[json("emailVisibility")]
  pub email_visibility: bool,
  // Bot accounts (LLL-407). Selects have no schema-level default, so every
  // create states its kind; owner is the creating human member's id, sent
  // only for bots.
  #[json(omitempty)]
  pub kind: string,
  #[json(omitempty)]
  pub owner: string,
  // Team scope: the ids of the only teams this member may see. Empty means
  // every team; `lll member invite --team` sets one.
  #[json(omitempty)]
  pub teams: Slice<string>,
}

#[json]
pub struct ProjectExpand {
  pub team: Team,
}

#[json]
pub struct Project {
  pub id: string,
  pub name: string,
  pub description: string,
  pub status: string,
  pub team: string,
  pub expand: ProjectExpand,
}

#[json]
pub struct ProjectList {
  pub items: Slice<Project>,
}

#[json]
pub struct NewProject {
  pub name: string,
  #[json(omitempty)]
  pub description: string,
  pub status: string,
  pub team: string,
}

#[json]
pub struct LabelExpand {
  pub team: Team,
}

#[json]
pub struct Label {
  pub id: string,
  pub name: string,
  pub color: string,
  pub team: string,
  pub expand: LabelExpand,
}

#[json]
pub struct LabelList {
  pub items: Slice<Label>,
}

#[json]
pub struct NewLabel {
  pub name: string,
  #[json(omitempty)]
  pub color: string,
  pub team: string,
}

#[json]
pub struct IssueExpand {
  pub creator: Member,
  pub team: Team,
  pub assignee: Member,
  pub project: Project,
  pub labels: Slice<Label>,
  pub blocked_by: Slice<Issue>,
}

#[json]
pub struct Issue {
  pub creator: string,
  pub origin: IssueOrigin,
  pub refs: string,
  pub attachments: Slice<string>,
  pub id: string,
  pub team: string,
  pub number: int,
  pub title: string,
  pub description: string,
  pub state: string,
  pub priority: int,
  pub sort: float64,
  // One author-chosen marker. Empty for most issues.
  pub emoji: string,
  // TASK-205 work-site slot: where the branch is checked out RIGHT NOW.
  // Written by `issue start` on an existing matching issue branch; a start from a
  // different site overwrites it (and leaves an auto-comment recording the
  // displaced one). Never cleared — staleness is a presentation rule.
  pub work_branch: string,
  pub work_host: string,
  pub work_path: string,
  pub assignee: string,
  pub project: string,
  pub labels: Slice<string>,
  // LLL-175: the issues that must be done before this one can start.
  pub blocked_by: Slice<string>,
  pub created: string,
  pub updated: string,
  pub expand: IssueExpand,
}

#[json]
pub struct IssueList {
  pub items: Slice<Issue>,
  #[json("totalItems")]
  pub total_items: int,
}

#[json]
pub struct NewIssue {
  #[json(omitempty)]
  pub creator: string,
  pub origin: IssueOrigin,
  pub team: string,
  // LLL-454: normally left at zero, which is how gopb's issueDefaults knows
  // to allocate the next number and sort for the team. `lll import dir`
  // supplies them, so a restored mirror reproduces ENG-7 as ENG-7 rather
  // than renumbering and silently repointing every cross-reference.
  #[json(omitempty)]
  pub number: int,
  #[json(omitempty)]
  pub sort: float64,
  pub title: string,
  pub state: string,
  pub priority: int,
  #[json(omitempty)]
  pub description: string,
  #[json(omitempty)]
  pub emoji: string,
  #[json(omitempty)]
  pub assignee: string,
  #[json(omitempty)]
  pub project: string,
  #[json(omitempty)]
  pub labels: Slice<string>,
}

#[json]
pub struct IssueOrigin {
  pub host: string,
  pub cwd: string,
  pub branch: string,
  pub sha: string,
  pub tool: string,
}

#[json]
pub struct CommentExpand {
  pub author: Member,
}

#[json]
pub struct Comment {
  pub id: string,
  pub issue: string,
  pub author: string,
  pub body: string,
  pub created: string,
  pub updated: string,
  pub expand: CommentExpand,
}

#[json]
pub struct CommentList {
  pub items: Slice<Comment>,
  #[json("totalPages")]
  pub total_pages: int,
}

#[json]
pub struct NewComment {
  pub issue: string,
  #[json(omitempty)]
  pub author: string,
  pub body: string,
}

/// A favorite's expanded issue. Fetched with `expand=issue.team`, so the
/// nested Issue carries its own expand.team and the rail can build a key.
#[json]
pub struct FavoriteExpand {
  pub issue: Issue,
}

/// One starred issue. `member` is "" for every row written before auth
/// (TASK-32) lands: a favorite is workspace-wide, not personal.
#[json]
pub struct Favorite {
  pub id: string,
  pub issue: string,
  pub member: string,
  pub created: string,
  pub expand: FavoriteExpand,
}

#[json]
pub struct FavoriteList {
  pub items: Slice<Favorite>,
}

#[json]
pub struct NewFavorite {
  pub issue: string,
  #[json(omitempty)]
  pub member: string,
}

/// A claim's holder, fetched with `expand=member` so a refusal can name them.
#[json]
pub struct ClaimExpand {
  pub member: Member,
}

/// One exclusive hold on an issue. The unique issue index admits one hold;
/// server operations couple acquisition/release with the assignment update.
/// `created` records when this hold was acquired, retained by an own-claim retry.
#[json]
pub struct Claim {
  pub id: string,
  pub issue: string,
  pub member: string,
  pub created: string,
  pub expand: ClaimExpand,
}

#[json]
pub struct ClaimList {
  #[json("totalPages")]
  pub total_pages: int,
  pub items: Slice<Claim>,
}

/// One saved view (TASK-94): a name plus the board query string it stands
/// for. `member` is "" for every row written before auth (TASK-32) lands:
/// a view is workspace-wide, not personal.
#[json]
pub struct View {
  pub id: string,
  pub name: string,
  pub query: string,
  pub member: string,
  pub created: string,
}

#[json]
pub struct ViewList {
  pub items: Slice<View>,
}

#[json]
pub struct NewView {
  pub name: string,
  pub query: string,
  #[json(omitempty)]
  pub member: string,
}

/// One doc (TASK-86): a wiki page, finding, decision or PRD. The `issues`
/// relation is the doc -> issue direction; the issue -> doc direction is a
/// `issues.id ?= 'x'` filter, no stored back-reference.
#[json]
pub struct DocExpand {
  pub issues: Slice<Issue>,
}

#[json]
pub struct Doc {
  pub id: string,
  // Required (TASK-173): a doc belongs to exactly one team, and slugs are
  // unique per team, not per server — GRDN and LLL both get an `index`.
  pub team: string,
  pub slug: string,
  pub title: string,
  pub kind: string,
  pub body: string,
  // TASK-103: the retrieval coordinates. `area` is one workspace area,
  // conventionally a label's name — an issue whose labels contain it
  // surfaces the doc. `paths` is comma-separated file/directory paths the
  // doc is about; `lll finding near <path>` matches by directory
  // containment. Empty on docs that name neither.
  pub area: string,
  pub paths: string,
  pub issues: Slice<string>,
  pub created: string,
  pub updated: string,
  // LLL-396: a finding is asserted by default; these mark the guesses.
  // 'confirmed' is the stored default so every pre-field doc keeps today's
  // semantics, and only 'suspected' and 'refuted' change how it reads.
  pub confidence: string,
  pub confidence_note: string,
  pub expand: DocExpand,
}

#[json]
pub struct DocList {
  pub items: Slice<Doc>,
}

/// LLL-396: the confirm/refute PATCH body — a judgement about a finding,
/// never an edit of its content.
#[json]
pub struct ConfidencePatch {
  pub confidence: string,
  pub confidence_note: string,
}

#[json]
pub struct NewDoc {
  pub team: string,
  pub slug: string,
  pub title: string,
  pub kind: string,
  pub body: string,
  // Set explicitly on every create: selects have no schema-level default.
  pub confidence: string,
  #[json(omitempty)]
  pub confidence_note: string,
  #[json(omitempty)]
  pub area: string,
  #[json(omitempty)]
  pub paths: string,
  #[json(omitempty)]
  pub issues: Slice<string>,
}

/// POST body for PocketBase's auth-with-password (members and _superusers
/// alike): `identity` is the account's email.
#[json]
pub struct AuthRequest {
  pub identity: string,
  pub password: string,
}

/// The shape both auth-with-password and impersonate answer with (verified
/// in v0.40.1 apis/record_helpers.go): the token to send as Bearer and the
/// member record it belongs to. `record.name` is who a login is.
#[json]
pub struct AuthResponse {
  pub token: string,
  pub record: Member,
}

/// PATCH body for `lll member set-password` (TASK-203): the password pair
/// PocketBase requires, plus the email when the member needs a real one to
/// log in with (a synthesized @members.invalid identity is not typable in
/// good conscience).
#[json]
pub struct PasswordPatch {
  pub password: string,
  #[json("passwordConfirm")]
  pub password_confirm: string,
  #[json(omitempty)]
  pub email: string,
}

/// POST body for /api/collections/members/impersonate/{id} (TASK-183): a
/// static, non-refreshable agent token. 0 uses the collection's token
/// duration; the endpoint validates duration >= 0 (v0.40.1
/// apis/record_auth_impersonate.go).
#[json]
pub struct ImpersonateRequest {
  pub duration: int,
}

#[json]
pub struct WebhookExpand {
  pub team: Team,
  pub project: Project,
}

/// An outbound webhook registration (LLL-409): one URL that receives issue
/// events for its team, narrowed to one project when `project` is set.
#[json]
pub struct Webhook {
  pub id: string,
  pub url: string,
  pub secret: string,
  pub team: string,
  pub project: string,
  pub expand: WebhookExpand,
}

#[json]
pub struct WebhookList {
  pub items: Slice<Webhook>,
}

#[json]
pub struct NewWebhook {
  pub team: string,
  #[json(omitempty)]
  pub project: string,
  pub url: string,
  #[json(omitempty)]
  pub secret: string,
}

/// POST body for /api/lll/bots/rotate (LLL-407): re-mint the named bot's
/// static token after invalidating the previous one. 0 uses the collection's
/// token duration, the same contract impersonate has. The name rides the
/// body because member names are arbitrary text, not path segments.
#[json]
pub struct BotRotate {
  pub name: string,
  pub duration: int,
}
