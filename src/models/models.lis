/// Record identifiers, one type per collection (LLL-675). Each is the
/// PocketBase id as the server sent it, so a team's id cannot be passed where
/// an issue's is wanted, and none can be passed as a plain string. Values are
/// made by decoding a record (here, from JSON) or in records/ and writes/;
/// scripts/test_typed_ids.py holds that. A relation PocketBase reports as
/// unset decodes to the empty id: `is_empty` says so.
///
/// `string()` makes each a Stringer, so an id interpolates as itself into a
/// URL or a filter.
pub struct TeamId(string)
pub struct IssueId(string)
pub struct LabelId(string)
pub struct ProjectId(string)
pub struct MemberId(string)
pub struct ClaimId(string)

impl TeamId {
  pub fn string(self) -> string { self.0 }
  pub fn is_empty(self) -> bool { self.0 == "" }
}

impl IssueId {
  pub fn string(self) -> string { self.0 }
  pub fn is_empty(self) -> bool { self.0 == "" }
}

impl LabelId {
  pub fn string(self) -> string { self.0 }
  pub fn is_empty(self) -> bool { self.0 == "" }
}

impl ProjectId {
  pub fn string(self) -> string { self.0 }
  pub fn is_empty(self) -> bool { self.0 == "" }
}

impl MemberId {
  pub fn string(self) -> string { self.0 }
  pub fn is_empty(self) -> bool { self.0 == "" }
}

impl ClaimId {
  pub fn string(self) -> string { self.0 }
  pub fn is_empty(self) -> bool { self.0 == "" }
}

#[json]
pub struct Team {
  pub id: TeamId,
  pub key: string,
  pub name: string,
  // The team's accent colour as "#rrggbb". Empty means DESIGN.md's canonical
  // ember orange, which theme.css already hard-codes.
  pub accent: string,
  // An optional glyph beside the key, and the tab icon's mark (LLL-427).
  // Empty renders exactly as before: the letter derived from the key.
  pub emoji: string,
  // The lifecycle end (TASK-210): an archived team leaves the rail switcher
  // and default team lists; its board stays readable at /t/KEY/ and its data
  // is untouched. 'lll team unarchive KEY' brings it back.
  pub archived: bool,
}

#[json]
pub struct TeamList {
  pub items: Slice<Team>,
}

#[json]
pub struct NewTeam {
  pub key: string,
  pub name: string,
}

#[json]
pub struct Member {
  pub id: MemberId,
  pub name: string,
  pub email: string,
  // Bot accounts (LLL-407): "person" or "bot"; "" only on servers that have
  // not applied the kind migration. `owner` is the creating human member's
  // id, empty for people and for bots minted by the superuser.
  pub kind: string,
  #[json(omitempty)]
  pub owner: MemberId,
  // Access (LLL-542): "all" | "teams", the team ids, "rw" | "ro". Empty on a
  // server that predates scoped members.
  #[json(omitempty)]
  pub scope: string,
  #[json(omitempty)]
  pub teams: Slice<TeamId>,
  #[json(omitempty)]
  pub mode: string,
  // Keys of `teams` the caller can see; filled by 'member list --json' only.
  #[json(omitempty)]
  pub team_keys: Slice<string>,
  // A bot's owner (LLL-610), present only when the read asked PocketBase to
  // expand `owner` and the caller may read that member. Absent is not "no
  // owner": it may be an owner this caller cannot see.
  #[json(omitempty)]
  pub expand: Option<MemberExpand>,
}

#[json]
pub struct MemberExpand {
  #[json(omitempty)]
  pub owner: Option<MemberOwner>,
}

/// The owner as a comment needs it: who, not their email or access.
#[json]
pub struct MemberOwner {
  pub id: MemberId,
  pub name: string,
}

impl Member {
  /// The expanded owner's name, or "" when there is none to show.
  pub fn owner_name(self) -> string {
    self.expand.and_then(|e| e.owner).map_or("", |o| o.name)
  }

  /// This member's access within `owner`'s (LLL-543): a bot with an owner
  /// sees only teams both see, and writes only if both write. The server
  /// enforces the same (gopb effectiveAccess), reading the owner live, so
  /// this is what the bot can do right now.
  pub fn within(self, owner: Member) -> Member {
    let mut out = self
    out.mode = if self.mode == "rw" && owner.mode == "rw" { "rw" } else { "ro" }
    if self.scope == "all" && owner.scope == "all" { return out }
    out.scope = "teams"
    out.teams = if self.scope == "all" {
      owner.teams
    } else if owner.scope == "all" {
      self.teams
    } else {
      self.teams.filter(|t| owner.teams.contains(t))
    }
    out
  }
}

#[json]
pub struct MemberList {
  pub items: Slice<Member>,
}

#[json]
pub struct NewMember {
  pub name: string,
  #[json(omitempty)]
  pub email: string,
  // members is an auth collection (TASK-180): PB requires the password pair
  // on create. Random and never printed — nobody logs in until a real
  // password is set by an admin or the member.
  pub password: string,
  #[json("passwordConfirm")]
  pub password_confirm: string,
  // keeps emails visible to `lll member list` and the board, as they were
  // before the collection became an auth one.
  #[json("emailVisibility")]
  pub email_visibility: bool,
  // Bot accounts (LLL-407). Selects have no schema-level default, so every
  // create states its kind; owner is the creating human member's id, sent
  // only for bots.
  #[json(omitempty)]
  pub kind: string,
  #[json(omitempty)]
  pub owner: Option<MemberId>,
  // Access scope: "all" or "teams". Empty lets the server fill in the
  // creator's ("all"). With "teams", the member sees only `teams`, the ids
  // `lll member invite --team` sets; an empty list then sees nothing.
  #[json(omitempty)]
  pub scope: string,
  #[json(omitempty)]
  pub teams: Slice<TeamId>,
  // "rw" | "ro"; empty lets the server fill in the creator's ("rw").
  #[json(omitempty)]
  pub mode: string,
}

#[json]
pub struct ProjectExpand {
  pub team: Team,
}

#[json]
pub struct Project {
  pub id: ProjectId,
  pub name: string,
  pub description: string,
  pub status: string,
  pub team: TeamId,
  pub expand: ProjectExpand,
