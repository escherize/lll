#[json]
pub struct Team {
  pub id: string,
  pub key: string,
  pub name: string,
  // The team's accent colour as "#rrggbb". Empty means DESIGN.md's canonical
  // ember orange, which theme.css already hard-codes.
  pub accent: string,
}

#[json]
pub struct TeamList {
  pub items: Slice<Team>,
}

#[json]
pub struct NewTeam {
  pub key: string,
  pub name: string,
}

#[json]
pub struct Member {
  pub id: string,
  pub name: string,
  pub email: string,
}

#[json]
pub struct MemberList {
  pub items: Slice<Member>,
}

#[json]
pub struct NewMember {
  pub name: string,
  #[json(omitempty)]
  pub email: string,
}

#[json]
pub struct ProjectExpand {
  pub team: Team,
}

#[json]
pub struct Project {
  pub id: string,
  pub name: string,
  pub description: string,
  pub status: string,
  pub team: string,
  pub expand: ProjectExpand,
}

#[json]
pub struct ProjectList {
  pub items: Slice<Project>,
}

#[json]
pub struct NewProject {
  pub name: string,
  #[json(omitempty)]
  pub description: string,
  pub status: string,
  #[json(omitempty)]
  pub team: string,
}

#[json]
pub struct LabelExpand {
  pub team: Team,
}

#[json]
pub struct Label {
  pub id: string,
  pub name: string,
  pub color: string,
  pub team: string,
  pub expand: LabelExpand,
}

#[json]
pub struct LabelList {
  pub items: Slice<Label>,
}

#[json]
pub struct NewLabel {
  pub name: string,
  #[json(omitempty)]
  pub color: string,
  #[json(omitempty)]
  pub team: string,
}

#[json]
pub struct IssueExpand {
  pub team: Team,
  pub assignee: Member,
  pub project: Project,
  pub labels: Slice<Label>,
}

#[json]
pub struct Issue {
  pub id: string,
  pub team: string,
  pub number: int,
  pub title: string,
  pub description: string,
  pub state: string,
  pub priority: int,
  pub sort: float64,
  // One author-chosen marker. Empty for most issues.
  pub emoji: string,
  pub assignee: string,
  pub project: string,
  pub labels: Slice<string>,
  pub created: string,
  pub updated: string,
  pub expand: IssueExpand,
}

#[json]
pub struct IssueList {
  pub items: Slice<Issue>,
  #[json("totalItems")]
  pub total_items: int,
}

#[json]
pub struct NewIssue {
  pub team: string,
  pub title: string,
  pub state: string,
  pub priority: int,
  #[json(omitempty)]
  pub description: string,
  #[json(omitempty)]
  pub emoji: string,
  #[json(omitempty)]
  pub assignee: string,
  #[json(omitempty)]
  pub project: string,
  #[json(omitempty)]
  pub labels: Slice<string>,
}

#[json]
pub struct CommentExpand {
  pub author: Member,
}

#[json]
pub struct Comment {
  pub id: string,
  pub issue: string,
  pub author: string,
  pub body: string,
  pub created: string,
  pub expand: CommentExpand,
}

#[json]
pub struct CommentList {
  pub items: Slice<Comment>,
}

#[json]
pub struct NewComment {
  pub issue: string,
  #[json(omitempty)]
  pub author: string,
  pub body: string,
}

/// A favorite's expanded issue. Fetched with `expand=issue.team`, so the
/// nested Issue carries its own expand.team and the rail can build a key.
#[json]
pub struct FavoriteExpand {
  pub issue: Issue,
}

/// One starred issue. `member` is "" for every row written before auth
/// (TASK-32) lands: a favorite is workspace-wide, not personal.
#[json]
pub struct Favorite {
  pub id: string,
  pub issue: string,
  pub member: string,
  pub created: string,
  pub expand: FavoriteExpand,
}

#[json]
pub struct FavoriteList {
  pub items: Slice<Favorite>,
}

#[json]
pub struct NewFavorite {
  pub issue: string,
  #[json(omitempty)]
  pub member: string,
}

/// A claim's holder, fetched with `expand=member` so a refusal can name them.
#[json]
pub struct ClaimExpand {
  pub member: Member,
}

/// One exclusive hold on an issue (TASK-175). `claims` is UNIQUE on `issue`,
/// so the row IS the arbitration: two agents racing both POST one and the
/// index admits exactly one. `created` is the claim's age.
#[json]
pub struct Claim {
  pub id: string,
  pub issue: string,
  pub member: string,
  pub created: string,
  pub expand: ClaimExpand,
}

#[json]
pub struct ClaimList {
  pub items: Slice<Claim>,
}

#[json]
pub struct NewClaim {
  pub issue: string,
  pub member: string,
}

/// One saved view (TASK-94): a name plus the board query string it stands
/// for. `member` is "" for every row written before auth (TASK-32) lands:
/// a view is workspace-wide, not personal.
#[json]
pub struct View {
  pub id: string,
  pub name: string,
  pub query: string,
  pub member: string,
  pub created: string,
}

#[json]
pub struct ViewList {
  pub items: Slice<View>,
}

#[json]
pub struct NewView {
  pub name: string,
  pub query: string,
  #[json(omitempty)]
  pub member: string,
}

/// One doc (TASK-86): a wiki page, finding, decision or PRD. The `issues`
/// relation is the doc -> issue direction; the issue -> doc direction is a
/// `issues.id ?= 'x'` filter, no stored back-reference.
#[json]
pub struct DocExpand {
  pub issues: Slice<Issue>,
}

#[json]
pub struct Doc {
  pub id: string,
  pub slug: string,
  pub title: string,
  pub kind: string,
  pub body: string,
  // TASK-103: the retrieval coordinates. `area` is one workspace area,
  // conventionally a label's name — an issue whose labels contain it
  // surfaces the doc. `paths` is comma-separated file/directory paths the
  // doc is about; `lll finding near <path>` matches by directory
  // containment. Empty on docs that name neither.
  pub area: string,
  pub paths: string,
  pub issues: Slice<string>,
  pub created: string,
  pub updated: string,
  pub expand: DocExpand,
}

#[json]
pub struct DocList {
  pub items: Slice<Doc>,
}

#[json]
pub struct NewDoc {
  pub slug: string,
  pub title: string,
  pub kind: string,
  pub body: string,
  #[json(omitempty)]
  pub area: string,
  #[json(omitempty)]
  pub paths: string,
  #[json(omitempty)]
  pub issues: Slice<string>,
}
