#[json]
pub struct Team {
  pub id: string,
  pub key: string,
  pub name: string,
}

#[json]
pub struct TeamList {
  pub items: Slice<Team>,
}

#[json]
pub struct NewTeam {
  pub key: string,
  pub name: string,
}

#[json]
pub struct Member {
  pub id: string,
  pub name: string,
  pub email: string,
}

#[json]
pub struct MemberList {
  pub items: Slice<Member>,
}

#[json]
pub struct NewMember {
  pub name: string,
  #[json(omitempty)]
  pub email: string,
}

#[json]
pub struct ProjectExpand {
  pub team: Team,
}

#[json]
pub struct Project {
  pub id: string,
  pub name: string,
  pub description: string,
  pub status: string,
  pub team: string,
  pub expand: ProjectExpand,
}

#[json]
pub struct ProjectList {
  pub items: Slice<Project>,
}

#[json]
pub struct NewProject {
  pub name: string,
  #[json(omitempty)]
  pub description: string,
  pub status: string,
  #[json(omitempty)]
  pub team: string,
}

#[json]
pub struct LabelExpand {
  pub team: Team,
}

#[json]
pub struct Label {
  pub id: string,
  pub name: string,
  pub color: string,
  pub team: string,
  pub expand: LabelExpand,
}

#[json]
pub struct LabelList {
  pub items: Slice<Label>,
}

#[json]
pub struct NewLabel {
  pub name: string,
  #[json(omitempty)]
  pub color: string,
  #[json(omitempty)]
  pub team: string,
}

#[json]
pub struct IssueExpand {
  pub team: Team,
  pub assignee: Member,
  pub project: Project,
  pub labels: Slice<Label>,
}

#[json]
pub struct Issue {
  pub id: string,
  pub team: string,
  pub number: int,
  pub title: string,
  pub description: string,
  pub state: string,
  pub priority: int,
  pub sort: float64,
  pub assignee: string,
  pub project: string,
  pub labels: Slice<string>,
  pub created: string,
  pub updated: string,
  pub expand: IssueExpand,
}

#[json]
pub struct IssueList {
  pub items: Slice<Issue>,
  #[json("totalItems")]
  pub total_items: int,
}

#[json]
pub struct NewIssue {
  pub team: string,
  pub title: string,
  pub state: string,
  pub priority: int,
  #[json(omitempty)]
  pub assignee: string,
  #[json(omitempty)]
  pub project: string,
  #[json(omitempty)]
  pub labels: Slice<string>,
}

#[json]
pub struct CommentExpand {
  pub author: Member,
}

#[json]
pub struct Comment {
  pub id: string,
  pub issue: string,
  pub author: string,
  pub body: string,
  pub created: string,
  pub expand: CommentExpand,
}

#[json]
pub struct CommentList {
  pub items: Slice<Comment>,
}

#[json]
pub struct NewComment {
  pub issue: string,
  #[json(omitempty)]
  pub author: string,
  pub body: string,
}
