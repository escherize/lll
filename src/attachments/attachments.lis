import "go:bytes"
import "go:encoding/json"
import "go:io"
import "go:mime/multipart"
import "go:net/url"
import "go:path/filepath"
import "go:strings"
import "models"
import "pb"
import "writes"

/// Transport memory bound, deliberately above the schema's per-file limit.
/// PocketBase's file field is the authority for size and count acceptance.
pub fn read_upload(reader: io.Reader) -> Result<Slice<byte>, pb.CliError> {
  let cap = 32 * 1024 * 1024
  let result = io.ReadAll(io.LimitReader(reader, (cap + 1) as int64))
  let data = match result {
    Partial.Ok(data) => data,
    Partial.Both(_, e) | Partial.Err(e) => return Err(pb.failed(f"reading attachment: {e}")),
  }
  if data.length() > cap { return Err(pb.failed("attachment exceeds the 32 MiB upload transport limit")) }
  Ok(data)
}

pub fn upload(ctx: pb.Client, caller: pb.Caller, issue: models.Issue, name: string, data: Slice<byte>) -> Result<string, pb.CliError> {
  if issue.expand.team.archived { return Err(pb.failed(f"team {issue.expand.team.key} is archived; run 'lll team unarchive {issue.expand.team.key}' first")) }
  let filename = filepath.Base(strings.ReplaceAll(name, "\\", "/"))
  if filename == "" || filename == "." || filename == "/" { return Err(pb.failed("attachment needs a filename")) }
  let mut buffer = bytes.Buffer { .. }
  let mut writer = multipart.NewWriter(&buffer)
  let part = match writer.CreateFormFile("attachments+", filename) {
    Ok(part) => part,
    Err(e) => return Err(pb.failed(f"encoding attachment: {e}")),
  }
  let Partial.Ok(_) = part.Write(data) else { return Err(pb.failed("encoding attachment bytes failed")) }
  if let Err(e) = writer.Close() { return Err(pb.failed(f"encoding attachment: {e}")) }
  let response = writes.upload_attachments(ctx, caller, issue.id, buffer.String(), writer.FormDataContentType())?
  let mut saved = models.Issue { .. }
  if let Err(e) = json.Unmarshal(response.bytes(), &saved) { return Err(pb.failed(f"decoding uploaded issue: {e}")) }
  // Native append keeps the uploaded file last. Comparing every filename
  // against the caller's earlier read would also report concurrent uploads.
  let Some(stored) = saved.attachments.get(saved.attachments.length() - 1) else {
    return Err(pb.failed("server did not save the attachment; update the server to a version with issue attachments"))
  }
  if issue.attachments.contains(stored) { return Err(pb.failed("server did not append an attachment")) }
  Ok(stored)
}

pub fn require_file(issue: models.Issue, filename: string) -> Result<(), pb.CliError> {
  if !issue.attachments.contains(filename) { return Err(pb.failed(f"no attachment named '{filename}' on this issue")) }
  Ok(())
}

pub fn remove(ctx: pb.Client, caller: pb.Caller, issue: models.Issue, filename: string) -> Result<(), pb.CliError> {
  if issue.expand.team.archived { return Err(pb.failed(f"team {issue.expand.team.key} is archived; run 'lll team unarchive {issue.expand.team.key}' first")) }
  require_file(issue, filename)?
  writes.remove_attachment(ctx, caller, issue.id, filename)
}

#[json]
struct FileToken { token: string }

/// Fetch with a short-lived PocketBase file token. Keep that token on the
/// server; browser links name only the issue and its attachment.
pub fn read_file(ctx: pb.Client, issue: models.Issue, filename: string) -> Result<string, pb.CliError> {
  require_file(issue, filename)?
  let response = ctx.post("/api/files/token", "{}")?
  let mut token = FileToken { .. }
  if let Err(e) = json.Unmarshal(response.bytes(), &token) { return Err(pb.failed(f"decoding file access: {e}")) }
  if token.token == "" { return Err(pb.failed("server did not provide file access")) }
  let path = f"/api/files/issues/{issue.id}/{url.PathEscape(filename)}?token={url.QueryEscape(token.token)}"
  // Do not include a token-bearing upstream URL in any user-facing error.
  ctx.get(path).map_err(|_| pb.failed("could not read the attachment from storage"))
}
