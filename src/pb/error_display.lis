import "go:encoding/json"

pub struct ErrorDisplay { pub summary: string, pub details: string }

#[json]
struct ErrorEnvelope {
  message: string,
  data: json.RawMessage,
  status: int,
}

#[json]
struct EnvelopeCode {
  code: string,
}

/// The board's presentation of an error: a sentence for the person, and the
/// diagnostics apart from it. Decided by the error's kind, never its wording.
pub fn display_error(err: CliError) -> ErrorDisplay {
  match err.kind {
    ErrorKind.Server => {
      let summary = if err.status >= 500 {
        f"The server could not complete this request (HTTP {err.status}). Try again."
      } else if err.status != 0 {
        f"The server rejected this request (HTTP {err.status})."
      } else { "The server returned an unreadable response. Try again." }
      ErrorDisplay { summary, details: err.message }
    },
    ErrorKind.Network => ErrorDisplay {
      summary: "The board could not communicate with its server. Try again.",
      details: err.message,
    },
    _ => ErrorDisplay { summary: err.message, details: "" },
  }
}

/// The stable code an lll refusal carries at data.code (gopb), None for none.
fn envelope_code(raw: json.RawMessage) -> Option<ServerCode> {
  let mut data = EnvelopeCode { .. }
  if json.Unmarshal(raw, &data).is_err() { return None }
  code_named(data.code)
}

fn field_errors(raw: json.RawMessage, path: string, depth: int) -> Slice<string> {
  if depth > 8 { return [] }
  let mut fields = Map.new<string, json.RawMessage>()
  if json.Unmarshal(raw, &fields).is_err() { return [] }
  if let Some(value) = fields.get("message") {
    let mut message = ""
    let decoded = json.Unmarshal(value, &message).is_ok()
    if decoded && message != "" && path != "" { return [f"{path}: {message}"] }
  }
  let mut result: Slice<string> = []
  for (name, value) in fields {
    if name == "code" || name == "message" { continue }
    let child = if path == "" { name } else { f"{path}.{name}" }
    result = result.append(field_errors(value, child, depth + 1)...)
  }
  result
}
