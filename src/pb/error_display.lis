import "go:encoding/json"
import "go:sort"
import "go:strings"

pub struct ErrorDisplay { pub summary: string, pub details: string }

#[json]
struct ErrorEnvelope {
  message: string,
  data: json.RawMessage,
}

/// Presentation is separate from the original error protocol: status-sensitive
/// callers and CLI diagnostics retain the exact request error they received.
pub fn display_error(message: string) -> ErrorDisplay {
  let status = response_status(message)
  if status >= 400 && status < 500 {
    let mut envelope = ErrorEnvelope { .. }
    let decoded = json.Unmarshal(response_body(message).bytes(), &envelope).is_ok()
    if decoded && envelope.message != "" {
      let mut fields = field_errors(envelope.data, "", 0).clone()
      sort.Strings(fields)
      let mut summary = envelope.message
      for field in fields { summary += f"\n{field}" }
      return ErrorDisplay { summary, details: "" }
    }
  }
  if status != 0 {
    let summary = if status >= 500 {
      f"The server could not complete this request (HTTP {status}). Try again."
    } else { f"The server rejected this request (HTTP {status})." }
    return ErrorDisplay { summary, details: message }
  }
  if message.starts_with("cannot reach PocketBase at ") || ["GET http", "POST http", "PATCH http", "DELETE http", "PUT http", "HEAD http", "OPTIONS http"].any(|prefix| message.starts_with(prefix)) {
    return ErrorDisplay { summary: "The board could not communicate with its server. Try again.", details: message }
  }
  if message.starts_with("decoding ") {
    return ErrorDisplay { summary: "The server returned an unreadable response. Try again.", details: message }
  }
  ErrorDisplay { summary: message, details: "" }
}

fn field_errors(raw: json.RawMessage, path: string, depth: int) -> Slice<string> {
  if depth > 8 { return [] }
  let mut fields = Map.new<string, json.RawMessage>()
  if json.Unmarshal(raw, &fields).is_err() { return [] }
  if let Some(value) = fields.get("message") {
    let mut message = ""
    let decoded = json.Unmarshal(value, &message).is_ok()
    if decoded && message != "" && path != "" { return [f"{path}: {message}"] }
  }
  let mut result: Slice<string> = []
  for (name, value) in fields {
    if name == "code" || name == "message" { continue }
    let child = if path == "" { name } else { f"{path}.{name}" }
    result = result.append(field_errors(value, child, depth + 1)...)
  }
  result
}
