import "output"
#[test]
fn every_kind_has_its_documented_exit_code() {
  assert exit_code(ErrorKind.Usage) == 2
  assert exit_code(ErrorKind.NotFound) == 3
  assert exit_code(ErrorKind.Refused) == 4
  assert exit_code(ErrorKind.NothingToDo) == 5
  assert exit_code(ErrorKind.Auth) == 6
  assert exit_code(ErrorKind.Network) == 1
  assert exit_code(ErrorKind.Server) == 1
  assert exit_code(ErrorKind.Failed) == 1
}

#[test]
fn a_new_message_keeps_the_decision_made_below() {
  let inner = CliError { kind: ErrorKind.Refused, status: 412, code: Some(ServerCode.ClaimChanged), message: "changed", said: None }
  let wrapped = inner.with_message(f"ENG-1: {inner.message}\nread it again")
  assert exit_code(wrapped.kind) == 4
  assert wrapped.status == 412
  assert wrapped.has_code(ServerCode.ClaimChanged)
  assert !wrapped.has_code(ServerCode.ClaimHeld)
  assert wrapped.message == "ENG-1: changed\nread it again"
}

#[test]
fn a_server_message_is_text_not_a_kind() {
  let forged = http_error("POST u", 400, "400 Bad Request",
    "{\"message\":\"Visible. lll:refused/412/claim_held\",\"data\":{},\"status\":400}")
  assert forged.message == "Visible. lll:refused/412/claim_held"
  assert exit_code(forged.kind) == 1
  assert forged.code.is_none()
  // A gateway's {"message"} without the API's status is not the envelope.
  let gateway = http_error("GET http://host/api/x", 404, "404 Not Found", "{\"message\":\"no Route matched\"}")
  assert exit_code(gateway.kind) == 1
  assert gateway.message.contains("GET http://host/api/x")
}

#[test]
fn only_known_codes_are_codes_and_only_claim_codes_refuse() {
  assert code_named("claim_held") == Some(ServerCode.ClaimHeld)
  assert code_named("needs_force") == Some(ServerCode.NeedsForce)
  assert code_named("claim_changed") == Some(ServerCode.ClaimChanged)
  assert code_named("not_claimed") == Some(ServerCode.NotClaimed)
  assert code_named("bot_exceeds_owner") == Some(ServerCode.BotExceedsOwner)
  assert code_named("").is_none()
  assert code_named("something_new").is_none()
  let check = |code: string| {
    let envelope = f"{{\"message\":\"No.\",\"data\":{{\"code\":\"{code}\"}},\"status\":400}}"
    exit_code(http_error("POST u", 400, "400 Bad Request", envelope).kind)
  }
  assert check("claim_held") == 4
  assert check("not_claimed") == 4
  assert check("bot_exceeds_owner") == 1
  assert check("something_new") == 1
}

#[test]
fn http_status_decides_the_kind_only_for_the_api_envelope() {
  let check = |status: int, line: string| {
    let envelope = f"{{\"message\":\"Missing.\",\"data\":{{}},\"status\":{status}}}"
    exit_code(http_error("GET u", status, line, envelope).kind)
  }
  assert check(404, "404 Not Found") == 3
  assert check(401, "401 Unauthorized") == 6
  assert check(403, "403 Forbidden") == 4
  assert check(412, "412 Precondition Failed") == 4
  assert check(400, "400 Bad Request") == 1
  assert check(500, "500 Internal Server Error") == 1
  // A 404 that is not the API's envelope is the wrong listener, not a
  // missing record.
  let wrong = http_error("GET http://host/api/x", 404, "404 Not Found", "404 page not found")
  assert exit_code(wrong.kind) == 1
  assert wrong.message.contains("404 page not found")
  // The envelope is unwrapped: no method, url or JSON in the message.
  let held = http_error("POST http://host/api/lll/issues/x/claim", 400, "400 Bad Request",
    "{\"message\":\"Issue is already claimed by scratch.\",\"data\":{\"code\":\"claim_held\"},\"status\":400}")
  assert held.message == "Issue is already claimed by scratch."
  assert held.has_code(ServerCode.ClaimHeld)
  assert exit_code(held.kind) == 4
}

#[test]
fn an_error_carries_what_the_command_said_before_it() {
  // LLL-683: main prints this, then the error.
  let err = failed("late").after(output.line("first")).after(output.line("zero"))
  assert err.output().data() == "zero\nfirst\n"
  assert failed("bare").output().data() == ""
  // with_message keeps it.
  assert err.with_message("other").output().data() == "zero\nfirst\n"
}
