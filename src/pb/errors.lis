import "go:strings"

/// What kind of failure an error is, as far as a caller deciding what to do
/// next cares. Each kind is one exit code (exit_code), the D1 contract in
/// docs/cli-contract.md.
pub enum ErrorKind {
  /// A bad command line: unknown noun, verb or flag, or a bad argument.
  Usage,
  /// The named record does not exist, or the caller cannot see it.
  NotFound,
  /// The server or the user said no: a claim held by someone else, a
  /// read-only member, a stale If-Unmodified-Since, an aborted confirmation.
  Refused,
  /// The command had nothing to do: an empty `issue next`.
  NothingToDo,
  /// No token, or a token the server does not accept.
  Auth,
  /// The server could not be reached, or its answer could not be read.
  Network,
  /// The server failed (5xx), or something that is not the API answered.
  Server,
  /// Anything else.
  Failed,
  /// Not a failure: a help page was asked for. It travels the error path so
  /// it short-circuits the verb before the verb can act (`lll label create
  /// -h` must not create); main prints the message on stdout and exits 0.
  Help,
}

/// A failure with its kind, the HTTP status behind it (0 when none) and the
/// server's stable code (data.code; None when there is none, or lll does not
/// know it). `message` is the human text, which is not part of the contract.
///
/// Every fallible function above the boundaries returns Result<T, CliError>
/// (LLL-675), so the kind travels as a value from where it is decided to
/// main, which turns it into the exit code.
pub struct CliError {
  pub kind: ErrorKind,
  pub status: int,
  pub code: Option<ServerCode>,
  pub message: string,
}

impl CliError {
  /// The same failure (kind, status and code) told differently: a caller
  /// adding where it happened ("ENG-1: ...") keeps the decision made below.
  pub fn with_message(self, message: string) -> CliError {
    CliError { message, ..self }
  }

  /// True when the server refused with `code`.
  pub fn has_code(self, code: ServerCode) -> bool {
    match self.code {
      Some(c) => c == code,
      None => false,
    }
  }
}

/// The stable codes the lll server (gopb) puts in an error's data.code. The
/// claim codes are refusals: the request was well formed and the answer is
/// no. A code lll does not know is no code (None), never a guess.
pub enum ServerCode {
  /// Someone else holds the issue's claim.
  ClaimHeld,
  /// Releasing someone else's claim needs force.
  NeedsForce,
  /// The claim changed under the request.
  ClaimChanged,
  /// The issue is not claimed.
  NotClaimed,
  /// A member with an owner would have wider access than its owner.
  BotExceedsOwner,
}

/// The code a server's data.code names; None for "" or an unknown code.
pub fn code_named(code: string) -> Option<ServerCode> {
  match code {
    "claim_held" => Some(ServerCode.ClaimHeld),
    "needs_force" => Some(ServerCode.NeedsForce),
    "claim_changed" => Some(ServerCode.ClaimChanged),
    "not_claimed" => Some(ServerCode.NotClaimed),
    "bot_exceeds_owner" => Some(ServerCode.BotExceedsOwner),
    _ => None,
  }
}

/// A claim refusal: someone said no to a well-formed request.
fn is_refusal(code: Option<ServerCode>) -> bool {
  match code {
    Some(ServerCode.ClaimHeld) => true,
    Some(ServerCode.NeedsForce) => true,
    Some(ServerCode.ClaimChanged) => true,
    Some(ServerCode.NotClaimed) => true,
    Some(ServerCode.BotExceedsOwner) => false,
    None => false,
  }
}

/// The exit code for a kind. The only place an exit code is decided.
pub fn exit_code(kind: ErrorKind) -> int {
  match kind {
    ErrorKind.Help => 0,
    ErrorKind.Usage => 2,
    ErrorKind.NotFound => 3,
    ErrorKind.Refused => 4,
    ErrorKind.NothingToDo => 5,
    ErrorKind.Auth => 6,
    ErrorKind.Network | ErrorKind.Server | ErrorKind.Failed => 1,
  }
}

/// The kind of an HTTP error answer. `envelope` says the body was the API's
/// JSON error object; anything else came from a listener that is not the API
/// (a proxy, the wrong port), so its 404 is not a missing record.
pub fn kind_of_status(status: int, code: Option<ServerCode>, envelope: bool) -> ErrorKind {
  if !envelope || status >= 500 { return ErrorKind.Server }
  if is_refusal(code) { return ErrorKind.Refused }
  match status {
    401 => ErrorKind.Auth,
    403 | 409 | 412 => ErrorKind.Refused,
    404 => ErrorKind.NotFound,
    _ => ErrorKind.Failed,
  }
}

/// A command's own failure of a known kind, with no HTTP status behind it.
pub fn fail(kind: ErrorKind, message: string) -> CliError {
  CliError { kind, status: 0, code: None, message }
}

/// A failure with no more specific kind: exit 1.
pub fn failed(message: string) -> CliError {
  fail(ErrorKind.Failed, message)
}

/// A help page, asked for with -h or --help, or a noun with no verb.
pub fn help(page: string) -> CliError {
  fail(ErrorKind.Help, page)
}

// Removed in the last commit of LLL-675, once nothing calls them.
fn tag_end() -> string { "\u{1d}" }

/// Text from outside this process (a server's message or body) with the tag
/// delimiter removed, so it can neither start a tag nor hide what follows.
pub fn untagged(text: string) -> string {
  strings.ReplaceAll(text, tag_end(), "")
}
