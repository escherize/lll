#[test]
fn expected_errors_show_messages_and_sorted_field_details() {
  let raw = tag(http_error(
    "POST http://127.0.0.1:40015/api/lll/issues/id/assignment", 400, "400 Bad Request",
    "{\"message\":\"Issue is claimed by café.\",\"data\":{\"code\":\"claim_held\"},\"status\":400}",
  ))
  let shown = display_error(raw)
  assert shown.summary == "Issue is claimed by café."
  assert shown.details == ""
  let err = classify(raw)
  assert err.status == 400
  assert err.code == "claim_held"
  assert exit_code(err.kind) == 4
  let fields = display_error(tag(http_error("POST http://host", 400, "400 Bad Request",
    "{\"message\":\"Invalid fields.\",\"data\":{\"title\":{\"code\":\"required\",\"message\":\"Cannot be blank.\"},\"labels\":{\"0\":{\"message\":\"Unknown label.\"}}},\"status\":400}")))
  assert fields.summary == "Invalid fields.\nlabels.0: Unknown label.\ntitle: Cannot be blank."
}

#[test]
fn unexpected_http_and_transport_errors_keep_diagnostics_separate() {
  for raw in [
    tag(http_error("GET http://127.0.0.1:40015/400", 503, "503 Service Unavailable", "backend failure 400")),
    tag(http_error("POST http://host", 400, "400 Bad Request", "<html>upstream error</html>")),
    tag(http_error("POST http://host", 400, "400 Bad Request", "{broken json")),
    fail(ErrorKind.Network, "PATCH http://host: reading response: unexpected EOF"),
    fail(ErrorKind.Network, "cannot reach the lll server at http://127.0.0.1:8090: connection refused"),
    fail(ErrorKind.Server, "decoding issue: unexpected EOF"),
  ] {
    let shown = display_error(raw)
    assert shown.details == plain(raw)
    assert !shown.summary.contains("http://")
    assert !shown.summary.contains("<html>")
  }
  assert display_error("unknown priority 'bogus'").summary == "unknown priority 'bogus'"
  assert display_error("").summary == ""
}
