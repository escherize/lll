import "go:bytes"
import "go:encoding/json"
import "go:io"
import "go:net/http"
import "go:strings"

import "config"

/// Base URL of the PocketBase server, from config (LLL_URL > config files).
pub fn base_url() -> Result<string, string> {
  let cfg = config.load()?
  Ok(cfg.url)
}

/// Connection-failure message that names the fix. Shared by every request
/// path here and by the realtime client.
pub fn unreachable(base: string, e: error) -> string {
  f"cannot reach PocketBase at {base}: {e}
is PocketBase running? start everything with 'lll up', or point LLL_URL (or 'url' in .lll.toml) at your server"
}

/// unreachable(), plus — when the url that refused was nobody's choice but
/// the built-in default — the pointer a fresh machine needs. The transcript
/// failure this exists for: a new machine with no config runs any command,
/// the default 127.0.0.1:8090 refuses, and nothing says how to connect.
fn unreachable_hint(base: string, defaulted: bool, e: error) -> string {
  let msg = unreachable(base, e)
  if !defaulted { return msg }
  msg + "\nno url is configured on this machine — connect with: lll login --url https://your-server"
}

/// GET a path (joined to base_url) and return the response body.
pub fn get(path: string) -> Result<string, string> {
  send("GET", path, "")
}

/// GET a path and decode the JSON body into `out`, naming `what` in the
/// decode error ("decoding issues: ...").
///
/// The out-parameter is forced, not chosen. Lisette (still true in 0.12.0) has generic
/// functions, but a type parameter cannot be *constructed*: `T { .. }` inside
/// a generic body fails to resolve. So the tidier `fetch<T>(path) ->
/// Result<T, string>` is not expressible, and the caller declares the zero
/// value it wants filled.
pub fn fetch<T>(
  path: string,
  what: string,
  out: mut Ref<T>,
) -> Result<(), string> {
  let body = get(path)?
  if let Err(e) = json.Unmarshal(body.bytes(), out) {
    return Err(f"decoding {what}: {e}")
  }
  Ok(())
}

/// POST a JSON payload to a path and return the response body.
pub fn post(path: string, payload: string) -> Result<string, string> {
  send("POST", path, payload)
}

/// PATCH a JSON payload to a path and return the response body.
pub fn patch(path: string, payload: string) -> Result<string, string> {
  send("PATCH", path, payload)
}

/// DELETE a path and return the (usually empty) response body.
pub fn delete(path: string) -> Result<string, string> {
  send("DELETE", path, "")
}

/// POST without the configured token — for the auth endpoints themselves
/// (member login, superuser auth), where the request must stand on the
/// credentials in its body and a stale or unrelated token must not ride along.
pub fn post_anon(path: string, payload: string) -> Result<string, string> {
  let (cfg, src) = config.load_traced()?
  request(cfg.url, "POST", path, payload, "", src.url == "default")
}

/// POST without any token to an explicit base — `lll login --url`, which must
/// authenticate against the url it was handed, never whatever is configured.
pub fn post_anon_to(
  base: string,
  path: string,
  payload: string,
) -> Result<string, string> {
  request(base, "POST", path, payload, "", false)
}

/// GET riding `tok` instead of the configured token — for flows that act as
/// a specific actor (token create's superuser-gated member lookup).
pub fn get_as(path: string, tok: string) -> Result<string, string> {
  let (cfg, src) = config.load_traced()?
  request(cfg.url, "GET", path, "", bearer(tok), src.url == "default")
}

/// POST riding `tok` instead of the configured token (impersonation).
pub fn post_as(
  path: string,
  payload: string,
  tok: string,
) -> Result<string, string> {
  let (cfg, src) = config.load_traced()?
  request(cfg.url, "POST", path, payload, bearer(tok), src.url == "default")
}

/// PATCH riding `tok` instead of the configured token — writes that must
/// stand on a just-verified credential (member set-password, the settings
/// Access section's re-auth), not whatever identity the process holds.
pub fn patch_as(
  path: string,
  payload: string,
  tok: string,
) -> Result<string, string> {
  let (cfg, src) = config.load_traced()?
  request(cfg.url, "PATCH", path, payload, bearer(tok), src.url == "default")
}

/// The value of an Authorization header for `tok`, or "" when there is no
/// token to send. Pure so the decision is testable without the network: every
/// verb asks it, and an empty answer means today's request, untouched.
pub fn bearer(tok: string) -> string {
  if tok == "" { return "" }
  f"Bearer {tok}"
}

/// Every verb's single path to the wire. One place decides the headers, so a
/// token configured anywhere in the layering reaches PocketBase on every
/// request — GET included, which is why `get` no longer calls http.Get.
fn send(method: string, path: string, payload: string) -> Result<string, string> {
  let (cfg, src) = config.load_traced()?
  request(cfg.url, method, path, payload, bearer(cfg.token), src.url == "default")
}

/// The request every verb here shares; `auth` is the Authorization header
/// value ("" sends none), `defaulted` says nothing configured the url. Every
/// error names the base url — a bare "POST /api/...: 500" once hid which
/// server a login was failing against.
fn request(
  base: string,
  method: string,
  path: string,
  payload: string,
  auth: string,
  defaulted: bool,
) -> Result<string, string> {
  let mut req = match http.NewRequest(
    method,
    base + path,
    bytes.NewReader(payload.bytes()),
  ) {
    Ok(r) => r,
    Err(e) => return Err(f"{method} {base}{path}: {e}"),
  }
  // http.NewRequest always populates Header, so None cannot happen; the
  // unwrap is the Option<Header> field type's toll, not a real branch.
  if let Some(h) = req.Header {
    let mut h = h
    if payload != "" { h.Set("Content-Type", "application/json") }
    if auth != "" { h.Set("Authorization", auth) }
  }
  let resp = match http.DefaultClient.Do(req) {
    Ok(r) => r,
    Err(e) => return Err(unreachable_hint(base, defaulted, e)),
  }
  read_body(resp, f"{method} {base}{path}")
}

fn read_body(resp: Ref<http.Response>, what: string) -> Result<string, string> {
  let Some(stream) = resp.Body else {
    return Err(f"{what}: empty response body")
  }
  defer stream.Close()
  let body = match io.ReadAll(stream) {
    Partial.Ok(b) => b,
    Partial.Both(b, _) => b,
    Partial.Err(e) => return Err(f"{what}: reading response: {e}"),
  }
  if resp.StatusCode >= 300 {
    return Err(
      f"{what}: {resp.Status}: {body as string}" +
        wrong_port_hint(what, resp.StatusCode, body as string),
    )
  }
  Ok(body as string)
}

/// The suffix for a 404 that came from something other than PocketBase's API.
/// "" for every other failure — a genuine missing record is a 404 too, and
/// telling someone to check their port when the record simply does not exist
/// would be worse than saying nothing.
///
/// The transcript this exists for: `url` set to the hosted board's bare host,
/// with no `:8091`. Every request then reaches the web board, which answers
/// Go's own plain-text `404 page not found`, and the CLI reported that verbatim
/// — a whole debugging loop with nothing anywhere naming the port.
///
/// The tell is the body, not the status: PocketBase answers every API error
/// with a JSON object, so a 404 at an /api/ path whose body is not JSON came
/// from a listener that has never heard of the API.
fn wrong_port_hint(what: string, status: int, body: string) -> string {
  if status != 404 { return "" }
  if !strings.Contains(what, "/api/") { return "" }
  if strings.HasPrefix(strings.TrimSpace(body), "{") { return "" }
  "\nthis looks like the web board, not the API - the hosted API is usually https://host:8091; check 'lll config --list'"
}
