import "go:bytes"
import "go:encoding/base64"
import "go:crypto/sha256"
import "go:encoding/hex"
import "go:encoding/json"
import "go:io"
import "go:net/http"
import "go:sort"
import "go:strings"
import "go:time"
import "go:github.com/escherize/lll/gopb"

import "config"

/// The board's right to renew its own token from the administrator pair
/// (TASK-255, LLL-388). Only a process given this may re-mint silently;
/// everyone else is told their token is dead, which is the honest answer
/// for a person. `member` keeps the renewed token that member's ("" renews
/// as the superuser).
pub struct Renewal {
  pub admin: config.AdminCreds,
  pub member: string,
}

/// How lll talks to its server (LLL-486): the settings main resolved, the
/// live credential, and whether that credential may renew itself. Built once
/// from Settings and passed to everything that makes a request; no request
/// re-reads configuration or the environment.
///
/// The credential lives in a Session because it changes after construction
/// and must be shared by every copy of this value: `lll up` hands its board
/// a member token, and a renewal replaces it while requests are in flight.
pub struct Client {
  pub settings: config.Settings,
  session: gopb.Session,
  /// Where the session's token came from, as config's Sources.token names
  /// it: the refusal messages say which variable or file to fix.
  token_source: Option<config.Source>,
  renewal: Option<Renewal>,
}

impl Client {
  /// The client for `settings`: their url, their token. A process started
  /// with LLL_REMINT=1 and the administrator pair renews its own token;
  /// `lll up` grants its board that explicitly instead (`renewing`).
  pub fn new(settings: config.Settings) -> Client {
    let (token, source) = match settings.traced() {
      Ok((cfg, src)) => (cfg.token, src.token),
      Err(_) => ("", None),
    }
    let renewal = if settings.env.remint {
      settings.admin().map(|admin| Renewal { admin, member: settings.env.remint_member })
    } else {
      None
    }
    Client { settings, session: gopb.NewSession(token), token_source: source, renewal }
  }

  /// Base URL of the server (a flag > LLL_URL > config files > default).
  pub fn url(self) -> Result<string, CliError> {
    let cfg = self.settings.config().map_err(failed)?
    Ok(cfg.url)
  }

  /// The credential every request sends, "" for none.
  pub fn token(self) -> string {
    self.session.Token()
  }

  /// Replace the credential in place, for every copy of this client: a
  /// renewal after the server refused the old one.
  pub fn renew_to(self, token: string) {
    self.session.SetToken(token)
  }

  /// This client against another server (`--url`, `lll up`'s own API),
  /// keeping the credential.
  pub fn with_url(self, url: string) -> Client {
    Client {
      settings: self.settings.with_url(url),
      session: gopb.NewSession(self.token()),
      token_source: self.token_source,
      renewal: self.renewal,
    }
  }

  /// This client with other settings: the same credential, renewal and
  /// session. For a value that changes what a request means (the team), not
  /// whom it is sent as.
  pub fn with_settings(self, settings: config.Settings) -> Client {
    let mut out = self
    out.settings = settings
    out
  }

  /// This client sending `token`, from `source` (None when no config key or
  /// variable supplied it). A fresh session: nothing was probed yet.
  pub fn with_token(self, token: string, source: Option<config.Source>) -> Client {
    Client {
      settings: self.settings,
      session: gopb.NewSession(token),
      token_source: source,
      renewal: self.renewal,
    }
  }

  /// This client sending `token`, held on someone else's behalf: a board
  /// viewer's member token or a team link's reader (LLL-658). It never renews
  /// and never re-reads a config file, so a refused token fails its request
  /// instead of retrying as this process's own identity.
  pub fn reading_as(self, token: string) -> Client {
    Client { settings: self.settings, session: gopb.NewSession(token), token_source: None, renewal: None }
  }

  /// Re-read the config files and send their token from now on: a token
  /// rotated in a file while a long-running process (a board on a caller's
  /// token, a watch) keeps going. Only a token that came from a file is
  /// replaced: an environment token never changes this way, and a token a
  /// boot handed over (with_token) is not traded for whatever a file says.
  ///
  /// The token is adopted only when the configuration as it is now, without
  /// any url flag, names the server this client talks to: a 'lll login
  /// --url B' elsewhere rewrites url and token together, and B's token must
  /// never be sent to this client's server. True when the token changed.
  pub fn reload_token(self) -> bool {
    let from_file = match self.token_source {
      Some(config.Source.RepoFile(_)) | Some(config.Source.HomeFile(_)) => true,
      Some(config.Source.Flag(_)) | Some(config.Source.Env(_)) | Some(config.Source.Default) | None => false,
    }
    if !from_file { return false }
    let Ok(base) = self.url() else { return false }
    let unflagged = config.Overrides { url: None, ..self.settings.overrides }
    let Ok(now) = config.resolve(self.settings.env, unflagged).config() else { return false }
    if now.url != base || now.token == "" || now.token == self.token() { return false }
    self.renew_to(now.token)
    true
  }

  /// This client renewing its own token as `renewal` says (the board).
  pub fn renewing(self, renewal: Option<Renewal>) -> Client {
    let mut out = self
    out.renewal = renewal
    out
  }

  /// The realtime subscription a renewal must re-authenticate (LLL-445),
  /// recorded only for a client that renews.
  pub fn remember_subscription(self, payload: string) {
    if self.renewal.is_some() { self.session.SetSubscription(payload) }
  }

  /// GET a path (joined to the url) and return the response body.
  pub fn get(self, path: string) -> Result<string, CliError> {
    self.send("GET", path, "")
  }

  /// POST a JSON payload to a path and return the response body.
  pub fn post(self, path: string, payload: string) -> Result<string, CliError> {
    self.send("POST", path, payload)
  }

  /// Replayable JSON creation carrying the same key through token renewal.
  pub fn post_idempotent(self, path: string, payload: string, key: string) -> Result<string, CliError> {
    self.send_content_options("POST", path, payload, "application/json", "", key)
  }

  /// PATCH a JSON payload to a path and return the response body.
  pub fn patch(self, path: string, payload: string) -> Result<string, CliError> {
    self.send("PATCH", path, payload)
  }

  /// PATCH carrying If-Unmodified-Since: LLL-399's optimistic-write stamp.
  /// The server (a gopb hook on issues) answers 412 when the stamp does not
  /// name the record's current 'updated', so the precondition holds at the
  /// write, not at the caller's earlier read. "" sends no header — callers can
  /// pass the flag through untouched.
  pub fn patch_with_stamp(self, path: string, payload: string, stamp: string) -> Result<string, CliError> {
    self.send_content_options("PATCH", path, payload, "application/json", stamp, "")
  }

  /// patch_with_stamp as `caller` (LLL-665): a stamped edit from a board
  /// viewer rides the viewer's token, as every other board write does.
  pub fn patch_with_stamp_as(self, caller: Caller, path: string, payload: string, stamp: string) -> Result<string, CliError> {
    match caller {
      Caller.Process => self.patch_with_stamp(path, payload, stamp),
      Caller.Member(tok) => {
        let (cfg, src) = self.settings.traced().map_err(failed)?
        request_content(cfg.url, "PATCH", path, payload, bearer(tok), src.url, "application/json", stamp)
      },
    }
  }

  /// DELETE a path and return the (usually empty) response body.
  pub fn delete(self, path: string) -> Result<string, CliError> {
    self.send("DELETE", path, "")
  }

  /// POST without the configured token — for the auth endpoints themselves
  /// (member login, superuser auth), where the request must stand on the
  /// credentials in its body and a stale or unrelated token must not ride along.
  pub fn post_anon(self, path: string, payload: string) -> Result<string, CliError> {
    let (cfg, src) = self.settings.traced().map_err(failed)?
    request(cfg.url, "POST", path, payload, "", src.url)
  }

  /// GET riding `tok` instead of the configured token — for flows that act as
  /// a specific actor (token create's superuser-gated member lookup).
  pub fn get_as(self, path: string, tok: string) -> Result<string, CliError> {
    let (cfg, src) = self.settings.traced().map_err(failed)?
    request(cfg.url, "GET", path, "", bearer(tok), src.url)
  }

  /// POST riding `tok` instead of the configured token (impersonation).
  pub fn post_as(self, path: string, payload: string, tok: string) -> Result<string, CliError> {
    let (cfg, src) = self.settings.traced().map_err(failed)?
    request(cfg.url, "POST", path, payload, bearer(tok), src.url)
  }

  /// PATCH riding `tok` instead of the configured token — writes that must
  /// stand on a just-verified credential (member set-password, the settings
  /// Access section's re-auth), not whatever identity the process holds.
  pub fn patch_as(self, path: string, payload: string, tok: string) -> Result<string, CliError> {
    let (cfg, src) = self.settings.traced().map_err(failed)?
    request(cfg.url, "PATCH", path, payload, bearer(tok), src.url)
  }

  /// DELETE riding `tok` instead of the configured token — superuser-gated
  /// removals (member remove), which a member token must not be able to make.
  pub fn delete_as(self, path: string, tok: string) -> Result<string, CliError> {
    let (cfg, src) = self.settings.traced().map_err(failed)?
    request(cfg.url, "DELETE", path, "", bearer(tok), src.url)
  }

  /// One request as `caller`, with an explicit content type.
  pub fn send_as(
    self,
    caller: Caller,
    method: string,
    path: string,
    payload: string,
    content_type: string,
  ) -> Result<string, CliError> {
    match caller {
      Caller.Process => self.send_content_options(method, path, payload, content_type, "", ""),
      Caller.Member(tok) => {
        let (cfg, src) = self.settings.traced().map_err(failed)?
        request_content(cfg.url, method, path, payload, bearer(tok), src.url, content_type, "")
      },
    }
  }

  /// Every verb's single path to the wire. One place decides the headers, so
  /// the configured token reaches PocketBase on every request — GET included,
  /// which is why `get` does not call http.Get.
  fn send(self, method: string, path: string, payload: string) -> Result<string, CliError> {
    self.send_content_options(method, path, payload, "application/json", "", "")
  }

  /// The whole authenticated path — token check, 401 re-mint, empty-list
  /// probe — with an optional If-Unmodified-Since stamp and idempotency key,
  /// "" for none.
  fn send_content_options(
    self,
    method: string, path: string, payload: string, content_type: string,
    stamp: string, key: string,
  ) -> Result<string, CliError> {
    let (cfg, src) = self.settings.traced().map_err(failed)?
    let token = self.token()
    if token == "" && (strings.HasPrefix(path, "/api/collections/") || strings.HasPrefix(path, "/api/lll/")) {
      return Err(not_logged_in(cfg.url, src.url))
    }
    let wire = Wire { base: cfg.url, url_origin: src.url, method, path, payload, content_type, stamp, key }
    // TASK-319: the server answers 401 to a record request whose token it
    // could not load, which is how an expired, corrupted or disowned token now
    // arrives - one step earlier than the empty list below, same verdicts.
    let body = match request_options(cfg.url, method, path, payload, bearer(token), wire.url_origin, content_type, stamp, key) {
      Ok(b) => b,
      Err(e) => {
        if token != "" && e.status == 401 {
          // A server refusal invalidates the earlier successful identity probe.
          // Member tokens are revoked by password changes; the board must renew
          // as its member even after it previously read an empty list (LLL-445).
          self.forget_probe()
          if let Some(refused) = self.refused_token(token, wire) {
            return refused
          }
        }
        return Err(e)
      },
    }
    // TASK-247: the same filter-not-gate semantics that hid a MISSING token also
    // hide a DEAD one. PocketBase rotates a record's tokenKey on every password
    // change, so a token issued before a reset stops matching — and the list rule
    // then filters everything out, answering 200 with an empty array. The reads
    // just go quiet, exactly as they did before anyone logged in.
    //
    // An empty list is the only case worth paying for, and it costs one extra
    // request in the case where the command was about to print nothing anyway.
    if is_empty_list(method, body) && token != "" {
      if let Some(refused) = self.refused_token(token, wire) {
        return refused
      }
    }
    Ok(body)
  }

  /// The answer for a token the server did not honour, by verdict: corrupted
  /// and expired are named from the token itself; rejected re-mints and
  /// repeats when this client may renew (the board, TASK-255) and is named
  /// otherwise. None when the token is valid after all - an empty list that
  /// really is empty.
  fn refused_token(self, token: string, wire: Wire) -> Option<Result<string, CliError>> {
    let verdict = self.token_verdict(wire.base, token)
    // A process that cannot re-mint (anything but a granted board) heals
    // the way it did when every request re-read the config: a token
    // rewritten in a config file since this client was built ('lll login'
    // elsewhere, a rotated bot token) is tried once before the refusal.
    let mut token = token
    let mut verdict = verdict
    if verdict != "valid" && verdict != "opaque" && self.renewal.is_none() && self.reload_token() {
      let fresh = self.token()
      match request_options(
        wire.base, wire.method, wire.path, wire.payload, bearer(fresh), wire.url_origin,
        wire.content_type, wire.stamp, wire.key,
      ) {
        Ok(body) => return Some(Ok(body)),
        Err(e) => {
          if e.status != 401 { return Some(Err(e)) }
          // The file's token is refused too: name it the way the first
          // refusal would have been named.
          token = fresh
          verdict = self.token_verdict(wire.base, fresh)
        },
      }
    }
    if verdict == "corrupted" { return Some(Err(corrupted_token(self.token_source))) }
    // An expired token is a refusal the board can heal exactly like a
    // rejected one (LLL-388): the expiry verdict used to return here before
    // the re-mint below, so the one process allowed to re-mint never did,
    // and the hosted board served empty pages from the moment its boot token
    // aged out until someone restarted the machine.
    if verdict == "expired" && self.renewal.is_none() {
      return Some(Err(expired_token(token, self.token_source)))
    }
    if verdict == "rejected" || verdict == "expired" {
      // A process holding the server's admin credentials can fix this itself.
      // That is the board (TASK-255): `lll up` bootstraps its member token
      // and re-mints it "if refused", but a stale token was never refused on a
      // read, so the board silently saw an empty database and told everyone its
      // own configured team did not exist. Re-mint once and repeat the request;
      // a plain CLI user has no admin credentials and gets the message instead.
      if let Some(fresh) = self.remint(wire.base) {
        self.renew_to(fresh)
        let subscription = self.session.Subscription()
        if subscription != "" {
          // PocketBase revocation clears a realtime client's auth but keeps its
          // stream alive. Restore that client's existing subscriptions as the
          // renewed member so reads and live updates recover together (LLL-445).
          let _ = request(wire.base, "POST", "/api/realtime", subscription, bearer(fresh), None)
        }
        return Some(request_options(
          wire.base, wire.method, wire.path, wire.payload, bearer(fresh), wire.url_origin,
          wire.content_type, wire.stamp, wire.key,
        ))
      }
      if verdict == "expired" { return Some(Err(expired_token(token, self.token_source))) }
      return Some(Err(stale_token(wire.base, self.token_source)))
    }
    None
  }

  /// Renew from the administrator pair, keeping the renewal's member when the
  /// board has selected one. None when this client may not renew.
  ///
  /// Deliberately narrow: only a process that was given the server's own
  /// credentials AND told to renew may re-authenticate silently. Anyone else
  /// holding the admin pair - a fleet, the e2e suite, a developer shell -
  /// gets the honest refusal instead of a silent superuser upgrade.
  fn remint(self, base: string) -> Option<string> {
    let Some(renewal) = self.renewal else { return None }
    let Ok(payload) = json.Marshal(AdminAuth { identity: renewal.admin.email, password: renewal.admin.password }) else {
      return None
    }
    let Ok(body) = request(
      base,
      "POST",
      "/api/collections/_superusers/auth-with-password",
      payload as string,
      "",
      None,
    ) else { return None }
    let mut auth = TokenOnly { .. }
    if let Err(_e) = json.Unmarshal(body.bytes(), &auth) { return None }
    if auth.token == "" { return None }
    if renewal.member != "" {
      return impersonate_member(base, auth.token, renewal.member, 31536000).ok()
    }
    Some(auth.token)
  }

  /// token_verdict, remembering a confirmed token for this session.
  fn token_verdict(self, base: string, tok: string) -> string {
    // Empty independent reads may arrive together. Coalesce the cold probe,
    // and check expiry after waiting rather than trusting an ageing answer.
    self.session.LockProbe()
    defer self.session.UnlockProbe()
    verdict(base, tok, self.session)
  }

  fn forget_probe(self) {
    self.session.LockProbe()
    defer self.session.UnlockProbe()
    self.session.SetProbed("")
  }

  /// not_logged_in, with the url and its origin, for callers outside the
  /// request path's error handling (whoami).
  pub fn not_logged_in_message(self) -> CliError {
    let Ok((cfg, src)) = self.settings.traced() else { return not_logged_in("", Some(config.Source.Default)) }
    not_logged_in(cfg.url, src.url)
  }

  /// corrupted_token, with the origin, for whoami.
  pub fn corrupted_token_message(self) -> CliError {
    corrupted_token(self.token_source)
  }

  /// expired_token, for whoami.
  pub fn expired_token_message(self) -> CliError {
    expired_token(self.token(), self.token_source)
  }
}

/// GET a path and decode the JSON body into `out`, naming `what` in the
/// decode error ("decoding issues: ...").
///
/// The out-parameter is forced, not chosen. Lisette (still true in 0.12.0) has generic
/// functions, but a type parameter cannot be *constructed*: `T { .. }` inside
/// a generic body fails to resolve. So the tidier `fetch<T>(path) ->
/// Result<T, CliError>` is not expressible, and the caller declares the zero
/// value it wants filled.
pub fn fetch<T>(
  c: Client,
  path: string,
  what: string,
  out: mut Ref<T>,
) -> Result<(), CliError> {
  let body = c.get(path)?
  if let Err(e) = json.Unmarshal(body.bytes(), out) {
    return Err(fail(ErrorKind.Server, f"decoding {what}: {e}"))
  }
  Ok(())
}

/// One authenticated request, kept whole so a renewal can repeat it.
struct Wire {
  base: string,
  url_origin: Option<config.Source>,
  method: string,
  path: string,
  payload: string,
  content_type: string,
  stamp: string,
  key: string,
}

/// Connection-failure message that names the fix. Shared by every request
/// path here and by the realtime client.
pub fn unreachable(base: string, e: error) -> CliError {
  fail(ErrorKind.Network, f"cannot reach the lll server at {base}: {e}
is the lll server running? start everything with 'lll up', or point LLL_URL (or 'url' in .lll.toml) at your server")
}

/// unreachable(), plus — when the url that refused was nobody's choice but
/// the built-in default — the pointer a fresh machine needs. The transcript
/// failure this exists for: a new machine with no config runs any command,
/// the default 127.0.0.1:8090 refuses, and nothing says how to connect.
///
/// Otherwise it names where the url came from and how to change it: four 1.0
/// fleet agents ran 'lll login' against a stale saved url because nothing
/// said which file held it.
fn unreachable_hint(base: string, url_origin: Option<config.Source>, e: error) -> CliError {
  let err = unreachable(base, e)
  let line = match url_origin {
    Some(config.Source.Default) => "no url is configured on this machine; connect with: lll login --url https://your-server",
    Some(config.Source.Env(name)) => f"this url comes from {name} in the environment; correct or unset it",
    // A repo file outranks the machine's, so 'config set url' would not win.
    Some(config.Source.RepoFile(path)) => f"this url comes from {path}; edit its url line, or remove it to use the machine's",
    Some(config.Source.HomeFile(path)) => f"this url comes from {path}; fix with 'lll config set url URL' or 'lll login --url URL'",
    Some(config.Source.Flag(spelling)) => f"this url comes from {spelling}",
    None => return err,
  }
  err.with_message(err.message + f"\n{line}")
}

/// POST without any token to an explicit base — `lll login --url`, which must
/// authenticate against the url it was handed, never whatever is configured.
pub fn post_anon_to(
  base: string,
  path: string,
  payload: string,
) -> Result<string, CliError> {
  request(base, "POST", path, payload, "", Some(config.Source.Flag("--url")))
}

/// The value of an Authorization header for `tok`, or "" when there is no
/// token to send. Pure so the decision is testable without the network: every
/// verb asks it, and an empty answer means today's request, untouched.
pub fn bearer(tok: string) -> string {
  if tok == "" { return "" }
  f"Bearer {tok}"
}

/// Whom a request runs as (LLL-545). `Process` is the client's token, with
/// the renewal and refusal handling every command gets. `Member` is a board
/// viewer's own member token: PocketBase checks that member's teams and mode
/// and records it as the author. A viewer's token is never re-minted here;
/// a refusal is the viewer's answer.
pub enum Caller {
  Process,
  Member(string),
}

/// PocketBase's impersonation endpoint, shared by boot and token renewal.
/// Explicit server and admin token prevent refresh from consulting stale config.
pub fn impersonate_member(
  base: string,
  admin: string,
  member: string,
  duration: int,
) -> Result<string, CliError> {
  let body = request(base, "POST", f"/api/collections/members/impersonate/{member}", f"{{\"duration\":{duration}}}", bearer(admin), None)?
  let mut auth = TokenOnly { .. }
  if let Err(e) = json.Unmarshal(body.bytes(), &auth) {
    return Err(failed(f"decoding the member token: {e}"))
  }
  if auth.token == "" { return Err(failed("the member token response carried no token")) }
  Ok(auth.token)
}

#[json]
struct AdminAuth { identity: string, password: string }

#[json]
struct TokenOnly { token: string }

/// True for a list response that matched nothing. `totalItems` is the list
/// envelope's own field, so a single-record GET never looks like one.
fn is_empty_list(method: string, body: string) -> bool {
  if method != "GET" { return false }
  let mut metadata = ListMetadata { .. }
  if json.Unmarshal(body.bytes(), &metadata).is_err() { return false }
  metadata.total_items == Some(0)
}

#[json]
struct ListMetadata {
  #[json("totalItems")]
  total_items: Option<int>,
}


/// Why a token is or is not usable: "valid", "corrupted", "expired", "rejected", or
/// "opaque". The last is a token this cannot read as a JWT at all - not three
/// segments - which is left alone, because it may be a credential of a kind
/// this client does not model. "corrupted" is the case fleet run 3 (TASK-309)
/// produced ten times over: three segments, so it IS a JWT, but the payload
/// does not decode - a hand-copied token with a typo in its middle third. The
/// old rule treated that as valid ("a token this cannot read is not accused"),
/// which meant every one of those agents got silence on their first command
/// instead of the one word that would have sent them back to the file.
///
/// `session` remembers a confirmed token. The probe is one round trip, and an
/// empty list is what triggers it - so `lll issue view` on an issue with no
/// linked docs, no blockers and no comments paid for it THREE times,
/// byte-identically, inside one process (LLL-436). A re-mint changes the
/// fingerprint. Expiry is checked locally on every call, and an explicit
/// server 401 clears a successful probe after token revocation. The caller
/// holds the session's probe lock, so a concurrent empty result cannot
/// duplicate the check or race invalidation.
fn verdict(base: string, tok: string, session: gopb.Session) -> string {
  let parts = strings.Split(tok, ".")
  if parts.length() != 3 { return "opaque" }
  let Some(id) = token_subject(tok) else { return "corrupted" }
  // Read from the token, so it costs nothing and stays live: a long-running
  // process must keep noticing when its own token ages out mid-run, which is
  // the whole of LLL-388. Never cached.
  if token_expired(tok) { return "expired" }
  let key = probe_key(base, tok)
  if session.Probed() == key { return "valid" }
  // link_viewers: the board's reader for a team link (LLL-658), which may
  // read its own record and nothing else there.
  for coll in ["members", "_superusers", "link_viewers"] {
    let found = request(
      base,
      "GET",
      f"/api/collections/{coll}/records/{id}?fields=id",
      "",
      bearer(tok),
      None,
    )
    if found.is_ok() {
      session.SetProbed(key)
      return "valid"
    }
  }
  "rejected"
}

/// A fingerprint rather than the token, so the remembered value is never a
/// usable credential.
fn probe_key(base: string, tok: string) -> string {
  let sum = sha256.Sum256(f"{base}\n{tok}".bytes())
  // Sum256 gives a fixed Array<byte, 32>; range indexing needs a slice.
  hex.EncodeToString(sum.to_slice())
}

/// Whether `tok` authenticates against `base` right now. For a caller that
/// holds BETTER credentials and only wants to know whether to bother with
/// this one - `lll up`, which owns the superuser pair (LLL-443). Everything
/// else wants `refused_token`'s verdict, which names WHY and can re-mint.
///
/// An opaque token counts as usable, matching the policy in `verdict`:
/// a credential this client cannot model is left alone rather than accused,
/// so an unreadable-but-working token is not silently traded for another.
pub fn token_usable(base: string, tok: string) -> bool {
  if tok == "" { return false }
  let v = verdict(base, tok, gopb.NewSession(""))
  v == "valid" || v == "opaque"
}

/// The record id a PocketBase auth JWT names, from its payload. None when the
/// token is not three base64url segments carrying an `id`, which is not a
/// judgement about validity - a token this cannot read is left alone.
pub fn token_subject(tok: string) -> Option<string> {
  let Some(claims) = token_claims(tok) else { return None };
  if claims.id == "" { return None }
  Some(claims.id)
}

/// The collection named by a JWT, for routing an identity lookup. This is
/// unverified metadata; the record request must still authenticate the token.
pub fn token_collection(tok: string) -> Option<string> {
  let Some(claims) = token_claims(tok) else { return None };
  if claims.collection_id == "" { return None }
  Some(claims.collection_id)
}

fn token_claims(tok: string) -> Option<TokenClaims> {
  let parts = strings.Split(tok, ".")
  if parts.length() != 3 { return None }
  let Ok(raw) = base64.RawURLEncoding.DecodeString(parts[1]) else { return None }
  let mut claims = TokenClaims { .. }
  if json.Unmarshal(raw, &claims).is_err() { return None }
  Some(claims)
}

#[json]
struct TokenClaims {
  id: string,
  exp: int,
  refreshable: bool,
  #[json("collectionId")]
  collection_id: string,
}

/// The unix time a PocketBase auth JWT expires, from its payload; None when
/// the token cannot be read or carries no exp. PocketBase honours exp on
/// impersonation tokens (verified: a 4-second token lists inside its
/// lifetime and is refused after), so a past exp is a verdict on its own.
pub fn token_expiry(tok: string) -> Option<int> {
  let Some(claims) = token_claims(tok) else { return None };
  if claims.exp == 0 { return None }
  Some(claims.exp)
}

/// True when the token carries an exp that has passed.
pub fn token_expired(tok: string) -> bool {
  let Some(exp) = token_expiry(tok) else { return false }
  exp < time.Now().Unix() as int
}

/// How close to expiry a refreshable token is renewed, in seconds (LLL-441).
/// A `lll login` token lives 5 days (the members collection's default
/// AuthToken duration) and auth-refresh refuses it once expired, so renewal
/// must happen while it still works. One refresh moves exp a full duration
/// out, so the next one is days away rather than on every command.
pub fn refresh_window() -> int {
  86400
}

/// True when `tok` says it is refreshable and expires inside the refresh
/// window but has not expired yet. Impersonation tokens (`lll token create`,
/// bots) carry refreshable: false and never qualify.
pub fn token_needs_refresh(tok: string, now: int) -> bool {
  let Some(claims) = token_claims(tok) else { return false };
  claims.refreshable && claims.exp > now && claims.exp - now < refresh_window()
}

/// True when `fresh` is a refreshable token for the same record and
/// collection as `old`, expiring later. A refresh answer that is anything
/// else - another server's token, an impersonation token, garbage - must not
/// replace the saved login.
pub fn same_login(old: string, fresh: string) -> bool {
  let Some(a) = token_claims(old) else { return false };
  let Some(b) = token_claims(fresh) else { return false };
  a.id != "" && b.id == a.id && b.collection_id == a.collection_id && b.refreshable && b.exp > a.exp
}

/// PocketBase's auth-refresh for the collection `tok` names: a fresh token
/// for the same record, its exp a full collection duration from now.
///
/// Its own 2-second client, not request(): this runs before ordinary commands,
/// and http.DefaultClient has no timeout, so a server that accepts and never
/// answers would hang the command indefinitely (version_skew uses 1s, discovery 2s).
pub fn refresh_token(base: string, tok: string) -> Result<string, CliError> {
  let Some(collection) = token_collection(tok) else {
    return Err(failed("the token names no collection"))
  }
  let what = f"POST {base}/api/collections/{collection}/auth-refresh"
  let mut req = match http.NewRequest("POST", f"{base}/api/collections/{collection}/auth-refresh", bytes.NewReader([])) {
    Ok(r) => r,
    Err(e) => return Err(failed(f"{what}: {e}")),
  }
  if let Some(h) = req.Header {
    let mut h = h
    h.Set("Authorization", bearer(tok))
  }
  let client = http.Client { Timeout: 2 * time.Second, .. }
  let resp = match client.Do(req) {
    Ok(r) => r,
    Err(e) => return Err(failed(f"{what}: {e}")),
  }
  let body = read_body(resp, what)?
  let mut auth = TokenOnly { .. }
  if let Err(e) = json.Unmarshal(body.bytes(), &auth) {
    return Err(failed(f"decoding the refreshed token: {e}"))
  }
  if !same_login(tok, auth.token) {
    return Err(failed("the refresh response is not a later token for the same member"))
  }
  Ok(auth.token)
}

/// The refusal for a token the server no longer accepts.
/// The refusal when the configured token is a JWT whose payload does not
/// decode: it was mangled in transit, almost always by being typed. Named
/// separately from a rejected token because the fix is different and local -
/// nobody reset anything; go back to where the token came from and copy it
/// again, by machine this time.
fn corrupted_token(origin: Option<config.Source>) -> CliError {
  let from = match origin {
    Some(config.Source.Env(name)) => name,
    Some(config.Source.RepoFile(path)) | Some(config.Source.HomeFile(path)) => path,
    Some(config.Source.Flag(_)) | Some(config.Source.Default) | None => "the configured token",
  }
  fail(ErrorKind.Auth, f"the token in {from} is corrupted: it is shaped like a token but its payload does not decode
it was almost certainly altered in copying - re-read it from its source into the variable
rather than typing it (a token is ~200 characters and one wrong one is enough)")
}


/// The refusal when a well-formed token is disowned by the server. `origin`
/// is where the token came from (config's Sources.token: LLL_TOKEN or a
/// file), because the fix depends on it.
///
/// This used to open "your saved token is no longer valid" and name one
/// cause, a password reset. Fleet run 3 (TASK-309) had ten of thirty agents
/// hit it with a token they had COPIED WRONG - an env var, never saved
/// anywhere - and every one of them went looking for a revoked credential,
/// because the message told them to. The three causes are listed in the order
/// an agent should check them: the cheap local one first.
/// The refusal for a token whose own payload says it has expired: exact,
/// because the payload is. Fleet shard 24 reported expired tokens keep
/// working; the probe said otherwise, and this is what it says now.
fn expired_token(tok: string, origin: Option<config.Source>) -> CliError {
  let from = token_named(origin)
  let exp = token_expiry(tok).unwrap_or(0)
  let when = time.Unix(exp as int64, 0).UTC().Format("2006-01-02 15:04:05 UTC")
  let ago = time.Now().Unix() as int - exp
  fail(ErrorKind.Auth, f"{from} expired at {when} ({ago}s ago). Every read comes back empty and every write is refused until it is replaced: {token_fix(origin)}")
}

/// The token as the expiry and rejection refusals name it.
fn token_named(origin: Option<config.Source>) -> string {
  match origin {
    Some(config.Source.Env(name)) => f"the token in {name}",
    Some(config.Source.RepoFile(path)) | Some(config.Source.HomeFile(path)) => f"the token in {path}",
    Some(config.Source.Flag(_)) | Some(config.Source.Default) | None => "your token",
  }
}

/// How to replace a token that no longer works (1.0 fleet: four of ten were
/// sent down the superuser and password paths first). LLL_TOKEN and a repo
/// file both outrank the saved token, so a login would not take effect while
/// either holds one.
fn token_fix(origin: Option<config.Source>) -> string {
  match origin {
    Some(config.Source.Env(name)) => f"{name} outranks the saved token: set it to a valid one ('lll token create <member>' mints an agent's), or unset it to use the saved one ('lll login' saves a new one). Then 'lll config check' to verify",
    // LLL-687: this used to send a repo file's token down the login path too,
    // and the login landed in the home file the repo file outranks.
    Some(config.Source.RepoFile(path)) => f"remove the token line from {path}, which outranks the saved token; then 'lll login' saves a new one to the home config. Then 'lll config check' to verify",
    Some(config.Source.HomeFile(_)) | Some(config.Source.Flag(_)) | Some(config.Source.Default) | None => "'lll token create <member>' (an agent's, minted by a superuser) or 'lll login --email <your email>' (a person); or, if you hold a valid token: 'lll login --token -' (reads it from stdin). Then 'lll config check' to verify",
  }
}

fn stale_token(base: string, origin: Option<config.Source>) -> CliError {
  let from = token_named(origin)
  fail(ErrorKind.Auth, f"{from} was rejected by {base}
it is well-formed, but the server does not recognise it. In order of
likelihood:
  1. it was copied wrong - compare it byte-for-byte with where it came from
  2. the password behind it was reset, which retires earlier tokens
  3. the member was removed, or its token revoked - ask whoever invited you
  4. it expired
a fresh one: {token_fix(origin)}")
}

/// Refusal for a collection request with no token anywhere in the layering.
///
/// Every collection rule is `@request.auth.id != ""` (ADR-1), and PocketBase
/// applies a LIST rule as a filter rather than a gate — so an unauthenticated
/// `issue list` gets 200 and an empty array, not a 401. Three separate
/// usability runs each opened with `lll issue list`, read the silence as an
/// empty backlog, and lost several commands before discovering they had never
/// authenticated. Writes were no better: `member add` answered PocketBase's
/// bare "Failed to create record" 400, which reads as a bad payload.
///
/// So the check happens here, before the wire, where it can say the true
/// thing once for every verb. A default url matters because it is the other
/// half of that transcript: nothing was configured, and the request was
/// about to go to whatever happens to be on 127.0.0.1:8090.
fn not_logged_in(base: string, url_origin: Option<config.Source>) -> CliError {
  // The url in the remedy is a PLACEHOLDER when nothing configured one. It
  // used to be the default itself, which reads as a discovered fact and
  // copy-pastes into the same failure — all three second-round usability runs
  // called that out, and it is the only line here that actively wasted them.
  let (where_, url_arg) = match url_origin {
    Some(config.Source.Default) => (f"{base} (the default; nothing here configured a url)", "<your server url>"),
    Some(config.Source.Flag(_)) | Some(config.Source.Env(_)) | Some(config.Source.RepoFile(_)) |
      Some(config.Source.HomeFile(_)) | None => (base, base),
  }
  fail(ErrorKind.Auth, f"not logged in to {where_}
every collection is authenticated-only, so reads would come back empty and writes refused
log in with: lll login --url {url_arg} --email <your email>
no account yet?
  you hold the server's admin credentials? One command, paste it whole:
    LLL_ADMIN_EMAIL=<admin email> LLL_ADMIN_PASSWORD=<admin password> \\
      lll login --url {url_arg} --email <your email> --create --password <pick one>
    (add --name <name> unless the part of your email before @ is the name you want)
  somebody else deployed it? Ask them to run:
    lll member invite <name> --email <your email>")
}

/// The request every verb here shares; `auth` is the Authorization header
/// value ("" sends none), `url_origin` is where the url came from (config's
/// trace, None when nothing recorded it). Every
/// error names the base url — a bare "POST /api/...: 500" once hid which
/// server a login was failing against.
fn request(
  base: string,
  method: string,
  path: string,
  payload: string,
  auth: string,
  url_origin: Option<config.Source>,
) -> Result<string, CliError> {
  request_content(base, method, path, payload, auth, url_origin, "application/json", "")
}

fn request_content(
  base: string, method: string, path: string, payload: string,
  auth: string, url_origin: Option<config.Source>, content_type: string, stamp: string,
) -> Result<string, CliError> {
  request_options(base, method, path, payload, auth, url_origin, content_type, stamp, "")
}

fn request_options(
  base: string, method: string, path: string, payload: string,
  auth: string, url_origin: Option<config.Source>, content_type: string, stamp: string, key: string,
) -> Result<string, CliError> {
  let mut req = match http.NewRequest(
    method,
    base + path,
    bytes.NewReader(payload.bytes()),
  ) {
    Ok(r) => r,
    Err(e) => return Err(fail(ErrorKind.Network, f"{method} {base}{path}: {e}")),
  }
  // http.NewRequest always populates Header, so None cannot happen; the
  // unwrap is the Option<Header> field type's toll, not a real branch.
  if let Some(h) = req.Header {
    let mut h = h
    if payload != "" { h.Set("Content-Type", content_type) }
    if auth != "" { h.Set("Authorization", auth) }
    // LLL-399: the optimistic-write precondition, "" for none.
    if stamp != "" { h.Set("If-Unmodified-Since", stamp) }
    if key != "" { h.Set("Idempotency-Key", key) }
  }
  let resp = match http.DefaultClient.Do(req) {
    Ok(r) => r,
    Err(e) => return Err(unreachable_hint(base, url_origin, e)),
  }
  read_body(resp, f"{method} {base}{path}")
}

fn read_body(resp: Ref<http.Response>, what: string) -> Result<string, CliError> {
  let Some(stream) = resp.Body else {
    return Err(fail(ErrorKind.Network, f"{what}: empty response body"))
  }
  defer stream.Close()
  let body = match io.ReadAll(stream) {
    Partial.Ok(b) => b,
    // A complete JSON prefix does not make an incomplete HTTP body valid.
    Partial.Both(_, e) | Partial.Err(e) => return Err(fail(ErrorKind.Network, f"{what}: reading response: {e}")),
  }
  if resp.StatusCode >= 300 {
    return Err(http_error(what, resp.StatusCode, resp.Status, body as string))
  }
  Ok(body as string)
}

/// An HTTP error answer, parsed once (LLL-645). The API's JSON envelope is
/// unwrapped to its message, any field errors and its stable code: the
/// method, url and raw body are transport, not the answer. A 5xx keeps the
/// request it failed, and a body that is not the envelope keeps everything,
/// because then the listener is not the API and the detail is the diagnosis.
pub fn http_error(what: string, status: int, status_line: string, body: string) -> CliError {
  let mut envelope = ErrorEnvelope { .. }
  let parsed = json.Unmarshal(body.bytes(), &envelope).is_ok()
  // The API's envelope names its own status; a gateway's bare
  // {"message": ...} does not, and its 404 is not a missing record.
  if !parsed || envelope.message == "" || envelope.status != status {
    return CliError {
      kind: kind_of_status(status, None, false),
      status,
      code: None,
      message: f"{what}: {status_line}: {body}" + wrong_port_hint(what, status, body),
      said: None,
    }
  }
  let code = envelope_code(envelope.data)
  let mut fields = field_errors(envelope.data, "", 0).clone()
  sort.Strings(fields)
  let mut message = envelope.message
  for field in fields { message += f"\n{field}" }
  if status >= 500 { message = f"{what}: {status_line}: {message}" }
  CliError { kind: kind_of_status(status, code, true), status, code, message, said: None }
}

/// The suffix for a 404 that came from something other than PocketBase's API.
/// "" for every other failure — a genuine missing record is a 404 too, and
/// telling someone to check their port when the record simply does not exist
/// would be worse than saying nothing.
///
/// The transcript this exists for: `url` set to the hosted board's bare host,
/// with no `:8091`. Every request then reaches the web board, which answers
/// Go's own plain-text `404 page not found`, and the CLI reported that verbatim
/// — a whole debugging loop with nothing anywhere naming the port.
///
/// TASK-241 removed that cause: the board proxies /api/ to its own PocketBase,
/// so the bare host is now the RIGHT url and the config that used to fail is
/// the one we document. The detection still holds - a non-JSON 404 at /api/
/// still means the listener is not a PocketBase API - but the remedy moved.
/// Telling someone to add :8091 would now point them away from the fix, since
/// their url is fine and the server is the thing that is behind.
///
/// The tell is the body, not the status: PocketBase answers every API error
/// with a JSON object, so a 404 at an /api/ path whose body is not JSON came
/// from a listener that has never heard of the API.
fn wrong_port_hint(what: string, status: int, body: string) -> string {
  if status != 404 { return "" }
  if !strings.Contains(what, "/api/") { return "" }
  if strings.HasPrefix(strings.TrimSpace(body), "{") { return "" }
  "\nthis host answers but is not serving the API. A current lll serves it at the same address as the board, so this is usually an older deployment - try https://host:8091, and check 'lll config list'"
}
