import "go:bytes"
import "go:io"
import "go:net/http"
import "go:os"

/// Base URL of the PocketBase server, from LIN_URL.
pub fn base_url() -> string {
  let url = os.Getenv("LIN_URL")
  if url == "" {
    "http://127.0.0.1:8090"
  } else {
    url
  }
}

/// GET a path (joined to base_url) and return the response body.
pub fn get(path: string) -> Result<string, string> {
  let resp = match http.Get(base_url() + path) {
    Ok(r) => r,
    Err(e) => return Err(f"cannot reach PocketBase at {base_url()}: {e}"),
  }
  read_body(resp, f"GET {path}")
}

/// POST a JSON payload to a path and return the response body.
pub fn post(path: string, payload: string) -> Result<string, string> {
  let resp = match http.Post(base_url() + path, "application/json", bytes.NewReader(payload.bytes())) {
    Ok(r) => r,
    Err(e) => return Err(f"cannot reach PocketBase at {base_url()}: {e}"),
  }
  read_body(resp, f"POST {path}")
}

fn read_body(resp: Ref<http.Response>, what: string) -> Result<string, string> {
  let Some(stream) = resp.Body else {
    return Err(f"{what}: empty response body")
  }
  defer stream.Close()
  let body = match io.ReadAll(stream) {
    Partial.Ok(b) => b,
    Partial.Both(b, _) => b,
    Partial.Err(e) => return Err(f"{what}: reading response: {e}"),
  }
  if resp.StatusCode >= 300 {
    return Err(f"{what}: {resp.Status}: {body as string}")
  }
  Ok(body as string)
}
