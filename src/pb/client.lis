import "go:bytes"
import "go:encoding/base64"
import "go:encoding/json"
import "go:io"
import "go:net/http"
import "go:os"
import "go:strings"
import "go:time"

import "config"

/// Base URL of the PocketBase server, from config (LLL_URL > config files).
pub fn base_url() -> Result<string, string> {
  let cfg = config.load()?
  Ok(cfg.url)
}

/// Connection-failure message that names the fix. Shared by every request
/// path here and by the realtime client.
pub fn unreachable(base: string, e: error) -> string {
  f"cannot reach PocketBase at {base}: {e}
is PocketBase running? start everything with 'lll up', or point LLL_URL (or 'url' in .lll.toml) at your server"
}

/// unreachable(), plus — when the url that refused was nobody's choice but
/// the built-in default — the pointer a fresh machine needs. The transcript
/// failure this exists for: a new machine with no config runs any command,
/// the default 127.0.0.1:8090 refuses, and nothing says how to connect.
fn unreachable_hint(base: string, defaulted: bool, e: error) -> string {
  let msg = unreachable(base, e)
  if !defaulted { return msg }
  msg + "\nno url is configured on this machine — connect with: lll login --url https://your-server"
}

/// GET a path (joined to base_url) and return the response body.
pub fn get(path: string) -> Result<string, string> {
  send("GET", path, "")
}

/// GET a path and decode the JSON body into `out`, naming `what` in the
/// decode error ("decoding issues: ...").
///
/// The out-parameter is forced, not chosen. Lisette (still true in 0.12.0) has generic
/// functions, but a type parameter cannot be *constructed*: `T { .. }` inside
/// a generic body fails to resolve. So the tidier `fetch<T>(path) ->
/// Result<T, string>` is not expressible, and the caller declares the zero
/// value it wants filled.
pub fn fetch<T>(
  path: string,
  what: string,
  out: mut Ref<T>,
) -> Result<(), string> {
  let body = get(path)?
  if let Err(e) = json.Unmarshal(body.bytes(), out) {
    return Err(f"decoding {what}: {e}")
  }
  Ok(())
}

/// POST a JSON payload to a path and return the response body.
pub fn post(path: string, payload: string) -> Result<string, string> {
  send("POST", path, payload)
}

/// PATCH a JSON payload to a path and return the response body.
pub fn patch(path: string, payload: string) -> Result<string, string> {
  send("PATCH", path, payload)
}

/// DELETE a path and return the (usually empty) response body.
pub fn delete(path: string) -> Result<string, string> {
  send("DELETE", path, "")
}

/// POST without the configured token — for the auth endpoints themselves
/// (member login, superuser auth), where the request must stand on the
/// credentials in its body and a stale or unrelated token must not ride along.
pub fn post_anon(path: string, payload: string) -> Result<string, string> {
  let (cfg, src) = config.load_traced()?
  request(cfg.url, "POST", path, payload, "", src.url == "default")
}

/// POST without any token to an explicit base — `lll login --url`, which must
/// authenticate against the url it was handed, never whatever is configured.
pub fn post_anon_to(
  base: string,
  path: string,
  payload: string,
) -> Result<string, string> {
  request(base, "POST", path, payload, "", false)
}

/// GET riding `tok` instead of the configured token — for flows that act as
/// a specific actor (token create's superuser-gated member lookup).
pub fn get_as(path: string, tok: string) -> Result<string, string> {
  let (cfg, src) = config.load_traced()?
  request(cfg.url, "GET", path, "", bearer(tok), src.url == "default")
}

/// POST riding `tok` instead of the configured token (impersonation).
pub fn post_as(
  path: string,
  payload: string,
  tok: string,
) -> Result<string, string> {
  let (cfg, src) = config.load_traced()?
  request(cfg.url, "POST", path, payload, bearer(tok), src.url == "default")
}

/// PATCH riding `tok` instead of the configured token — writes that must
/// stand on a just-verified credential (member set-password, the settings
/// Access section's re-auth), not whatever identity the process holds.
pub fn patch_as(
  path: string,
  payload: string,
  tok: string,
) -> Result<string, string> {
  let (cfg, src) = config.load_traced()?
  request(cfg.url, "PATCH", path, payload, bearer(tok), src.url == "default")
}

/// DELETE riding `tok` instead of the configured token — superuser-gated
/// removals (member remove), which a member token must not be able to make.
pub fn delete_as(path: string, tok: string) -> Result<string, string> {
  let (cfg, src) = config.load_traced()?
  request(cfg.url, "DELETE", path, "", bearer(tok), src.url == "default")
}

/// The value of an Authorization header for `tok`, or "" when there is no
/// token to send. Pure so the decision is testable without the network: every
/// verb asks it, and an empty answer means today's request, untouched.
pub fn bearer(tok: string) -> string {
  if tok == "" { return "" }
  f"Bearer {tok}"
}

/// Every verb's single path to the wire. One place decides the headers, so a
/// token configured anywhere in the layering reaches PocketBase on every
/// request — GET included, which is why `get` no longer calls http.Get.
fn send(method: string, path: string, payload: string) -> Result<string, string> {
  send_content(method, path, payload, "application/json")
}

/// Authenticated replayable body, shared by JSON and multipart writes.
pub fn send_content(method: string, path: string, payload: string, content_type: string) -> Result<string, string> {
  let (cfg, src) = config.load_traced()?
  if cfg.token == "" && (strings.HasPrefix(path, "/api/collections/") || strings.HasPrefix(path, "/api/lll/")) {
    return Err(not_logged_in(cfg.url, src.url == "default"))
  }
  // TASK-319: the server answers 401 to a record request whose token it
  // could not load, which is how an expired, corrupted or disowned token now
  // arrives - one step earlier than the empty list below, same verdicts.
  let body = match request_content(cfg.url, method, path, payload, bearer(cfg.token), src.url == "default", content_type) {
    Ok(b) => b,
    Err(e) => {
      if cfg.token != "" && response_status(e) == 401 {
        if let Some(refused) = refused_token(cfg, src, method, path, payload, content_type) {
          return refused
        }
      }
      return Err(e)
    },
  }
  // TASK-247: the same filter-not-gate semantics that hid a MISSING token also
  // hide a DEAD one. PocketBase rotates a record's tokenKey on every password
  // change, so a token issued before a reset stops matching — and the list rule
  // then filters everything out, answering 200 with an empty array. The reads
  // just go quiet, exactly as they did before anyone logged in.
  //
  // An empty list is the only case worth paying for, and it costs one extra
  // request in the case where the command was about to print nothing anyway.
  if is_empty_list(method, body) && cfg.token != "" {
    if let Some(refused) = refused_token(cfg, src, method, path, payload, content_type) {
      return refused
    }
  }
  Ok(body)
}

/// The answer for a token the server did not honour, by verdict: corrupted
/// and expired are named from the token itself; rejected re-mints and
/// repeats when this process holds the admin credentials (the board,
/// TASK-255) and is named otherwise. None when the token is valid after
/// all - an empty list that really is empty.
fn refused_token(
  cfg: config.Config,
  src: config.Sources,
  method: string,
  path: string,
  payload: string,
  content_type: string,
) -> Option<Result<string, string>> {
  let verdict = token_verdict(cfg.url, cfg.token)
  if verdict == "corrupted" { return Some(Err(corrupted_token(src.token))) }
  if verdict == "expired" { return Some(Err(expired_token(cfg.token, src.token))) }
  if verdict == "rejected" {
    // A process holding the server's admin credentials can fix this itself.
    // That is the board (TASK-255): `lll up` mints a superuser token at boot
    // and re-mints it "if refused", but a stale token was never refused on a
    // read, so the board silently saw an empty database and told everyone its
    // own configured team did not exist. Re-mint once and repeat the request;
    // a plain CLI user has no admin credentials and gets the message instead.
    if let Some(fresh) = remint_from_admin_credentials(cfg.url) {
      let _ = os.Setenv("LLL_TOKEN", fresh)
      return Some(request_content(
        cfg.url, method, path, payload, bearer(fresh), src.url == "default", content_type,
      ))
    }
    return Some(Err(stale_token(cfg.url, src.token)))
  }
  None
}

/// A fresh superuser token from LLL_ADMIN_EMAIL/LLL_ADMIN_PASSWORD, or None
/// when this process holds no admin credentials.
///
/// Deliberately narrow: only a process that was given the server's own
/// credentials may re-authenticate silently. Everyone else is told their
/// token is dead, which is the honest answer for a person.
fn remint_from_admin_credentials(base: string) -> Option<string> {
  // The board sets LLL_REMINT for itself at boot (up.lis). Anyone else
  // holding the admin pair - a fleet, the e2e suite, a developer shell -
  // gets the honest refusal instead of a silent superuser upgrade.
  if os.Getenv("LLL_REMINT") != "1" { return None }
  let email = os.Getenv("LLL_ADMIN_EMAIL")
  let pass = os.Getenv("LLL_ADMIN_PASSWORD")
  if email == "" || pass == "" { return None }
  let Ok(payload) = json.Marshal(AdminAuth { identity: email, password: pass }) else {
    return None
  }
  let Ok(body) = request(
    base,
    "POST",
    "/api/collections/_superusers/auth-with-password",
    payload as string,
    "",
    false,
  ) else { return None }
  let mut auth = TokenOnly { .. }
  if let Err(_e) = json.Unmarshal(body.bytes(), &auth) { return None }
  if auth.token == "" { return None }
  Some(auth.token)
}

#[json]
struct AdminAuth { identity: string, password: string }

#[json]
struct TokenOnly { token: string }

/// True for a list response that matched nothing. `totalItems` is the list
/// envelope's own field, so a single-record GET never looks like one.
fn is_empty_list(method: string, body: string) -> bool {
  if method != "GET" { return false }
  let mut metadata = ListMetadata { .. }
  if json.Unmarshal(body.bytes(), &metadata).is_err() { return false }
  metadata.total_items == Some(0)
}

#[json]
struct ListMetadata {
  #[json("totalItems")]
  total_items: Option<int>,
}


/// Why a token is or is not usable: "valid", "corrupted", "expired", "rejected", or
/// "opaque". The last is a token this cannot read as a JWT at all - not three
/// segments - which is left alone, because it may be a credential of a kind
/// this client does not model. "corrupted" is the case fleet run 3 (TASK-309)
/// produced ten times over: three segments, so it IS a JWT, but the payload
/// does not decode - a hand-copied token with a typo in its middle third. The
/// old rule treated that as valid ("a token this cannot read is not accused"),
/// which meant every one of those agents got silence on their first command
/// instead of the one word that would have sent them back to the file.
fn token_verdict(base: string, tok: string) -> string {
  let parts = strings.Split(tok, ".")
  if parts.length() != 3 { return "opaque" }
  let Some(id) = token_subject(tok) else { return "corrupted" }
  if token_expired(tok) { return "expired" }
  for coll in ["members", "_superusers"] {
    let found = request(
      base,
      "GET",
      f"/api/collections/{coll}/records/{id}?fields=id",
      "",
      bearer(tok),
      false,
    )
    if found.is_ok() { return "valid" }
  }
  "rejected"
}

/// The record id a PocketBase auth JWT names, from its payload. None when the
/// token is not three base64url segments carrying an `id`, which is not a
/// judgement about validity - a token this cannot read is left alone.
pub fn token_subject(tok: string) -> Option<string> {
  let parts = strings.Split(tok, ".")
  if parts.length() != 3 { return None }
  let Ok(raw) = base64.RawURLEncoding.DecodeString(parts[1]) else { return None }
  let mut claims = TokenClaims { .. }
  if json.Unmarshal(raw, &claims).is_err() { return None }
  if claims.id == "" { return None }
  Some(claims.id)
}

#[json]
struct TokenClaims {
  id: string,
  exp: int,
}

/// The unix time a PocketBase auth JWT expires, from its payload; None when
/// the token cannot be read or carries no exp. PocketBase honours exp on
/// impersonation tokens (verified: a 4-second token lists inside its
/// lifetime and is refused after), so a past exp is a verdict on its own.
pub fn token_expiry(tok: string) -> Option<int> {
  let parts = strings.Split(tok, ".")
  if parts.length() != 3 { return None }
  let Ok(raw) = base64.RawURLEncoding.DecodeString(parts[1]) else { return None }
  let mut claims = TokenClaims { .. }
  if json.Unmarshal(raw, &claims).is_err() { return None }
  if claims.exp == 0 { return None }
  Some(claims.exp)
}

/// True when the token carries an exp that has passed.
pub fn token_expired(tok: string) -> bool {
  let Some(exp) = token_expiry(tok) else { return false }
  exp < time.Now().Unix() as int
}

/// The refusal for a token the server no longer accepts.
/// The refusal when the configured token is a JWT whose payload does not
/// decode: it was mangled in transit, almost always by being typed. Named
/// separately from a rejected token because the fix is different and local -
/// nobody reset anything; go back to where the token came from and copy it
/// again, by machine this time.
fn corrupted_token(origin: string) -> string {
  let from = if strings.HasPrefix(origin, "env:") {
    "LLL_TOKEN"
  } else if strings.HasPrefix(origin, "file:") {
    strings.TrimPrefix(origin, "file:")
  } else {
    "the configured token"
  }
  f"the token in {from} is corrupted: it is shaped like a token but its payload does not decode
it was almost certainly altered in copying - re-read it from its source into the variable
rather than typing it (a token is ~200 characters and one wrong one is enough)"
}

/// not_logged_in, with the url and its origin looked up, for callers outside
/// send()'s error path (whoami).
pub fn not_logged_in_message() -> string {
  let Ok((cfg, src)) = config.load_traced() else { return not_logged_in("", true) }
  not_logged_in(cfg.url, src.url == "default")
}

/// corrupted_token, with the origin looked up, for callers that are not in
/// send()'s error path (whoami).
pub fn corrupted_token_message() -> string {
  let Ok((_, src)) = config.load_traced() else { return corrupted_token("") }
  corrupted_token(src.token)
}

/// The refusal when a well-formed token is disowned by the server. `origin`
/// is where the token came from (config's Sources.token: "env:LLL_TOKEN" or
/// "file:<path>"), because the fix depends on it.
///
/// This used to open "your saved token is no longer valid" and name one
/// cause, a password reset. Fleet run 3 (TASK-309) had ten of thirty agents
/// hit it with a token they had COPIED WRONG - an env var, never saved
/// anywhere - and every one of them went looking for a revoked credential,
/// because the message told them to. The three causes are listed in the order
/// an agent should check them: the cheap local one first.
/// The refusal for a token whose own payload says it has expired: exact,
/// because the payload is. Fleet shard 24 reported expired tokens keep
/// working; the probe said otherwise, and this is what it says now.
fn expired_token(tok: string, origin: string) -> string {
  let from = if strings.HasPrefix(origin, "env:") {
    "the token in LLL_TOKEN"
  } else if strings.HasPrefix(origin, "file:") {
    f"the token in {strings.TrimPrefix(origin, "file:")}"
  } else {
    "your token"
  }
  let exp = token_expiry(tok).unwrap_or(0)
  let when = time.Unix(exp as int64, 0).UTC().Format("2006-01-02 15:04:05 UTC")
  let ago = time.Now().Unix() as int - exp
  f"{from} expired at {when} ({ago}s ago) — every read comes back empty and every write is refused until it is replaced: 'lll token create <member>' (an agent's, minted by a superuser) or 'lll login --email <your email>' (a person)"
}

pub fn expired_token_message() -> string {
  let (cfg, src) = config.load_traced().unwrap_or((config.Config { .. }, config.Sources { .. }))
  expired_token(cfg.token, src.token)
}

fn stale_token(base: string, origin: string) -> string {
  let from = if strings.HasPrefix(origin, "env:") {
    "the token in LLL_TOKEN"
  } else if strings.HasPrefix(origin, "file:") {
    f"the token in {strings.TrimPrefix(origin, "file:")}"
  } else {
    "your token"
  }
  f"{from} was rejected by {base}
it is well-formed, but the server does not recognise it, so every read comes
back empty rather than failing. In order of likelihood:
  1. it was copied wrong - compare it byte-for-byte with where it came from
  2. the password behind it was reset, which retires earlier tokens
  3. it expired
a fresh one: 'lll login --email <your email>' (a person) or 'lll token create'
(an agent's, minted by a superuser)"
}

/// Refusal for a collection request with no token anywhere in the layering.
///
/// Every collection rule is `@request.auth.id != ""` (ADR-1), and PocketBase
/// applies a LIST rule as a filter rather than a gate — so an unauthenticated
/// `issue list` gets 200 and an empty array, not a 401. Three separate
/// usability runs each opened with `lll issue list`, read the silence as an
/// empty backlog, and lost several commands before discovering they had never
/// authenticated. Writes were no better: `member add` answered PocketBase's
/// bare "Failed to create record" 400, which reads as a bad payload.
///
/// So the check happens here, before the wire, where it can say the true
/// thing once for every verb. `defaulted` matters because a default url is
/// the other half of that transcript: nothing was configured, and the
/// request was about to go to whatever happens to be on 127.0.0.1:8090.
fn not_logged_in(base: string, defaulted: bool) -> string {
  // The url in the remedy is a PLACEHOLDER when nothing configured one. It
  // used to be the default itself, which reads as a discovered fact and
  // copy-pastes into the same failure — all three second-round usability runs
  // called that out, and it is the only line here that actively wasted them.
  let (where_, url_arg) = if defaulted {
    (f"{base} (the default — nothing here configured a url)", "<your server url>")
  } else {
    (base, base)
  }
  f"not logged in to {where_}
every collection is authenticated-only, so reads would come back empty and writes refused
log in with: lll login --url {url_arg} --email <your email>
no account yet?
  you hold the server's admin credentials — one command, paste it whole:
    LLL_ADMIN_EMAIL=<admin email> LLL_ADMIN_PASSWORD=<admin password> \\
      lll login --url {url_arg} --email <your email> --create --password <pick one>
    (add --name <name> unless the part of your email before @ is the name you want)
  somebody else deployed it — ask them to run:
    lll member invite <name> --email <your email>"
}

/// The request every verb here shares; `auth` is the Authorization header
/// value ("" sends none), `defaulted` says nothing configured the url. Every
/// error names the base url — a bare "POST /api/...: 500" once hid which
/// server a login was failing against.
fn request(
  base: string,
  method: string,
  path: string,
  payload: string,
  auth: string,
  defaulted: bool,
) -> Result<string, string> {
  request_content(base, method, path, payload, auth, defaulted, "application/json")
}

fn request_content(
  base: string, method: string, path: string, payload: string,
  auth: string, defaulted: bool, content_type: string,
) -> Result<string, string> {
  let mut req = match http.NewRequest(
    method,
    base + path,
    bytes.NewReader(payload.bytes()),
  ) {
    Ok(r) => r,
    Err(e) => return Err(f"{method} {base}{path}: {e}"),
  }
  // http.NewRequest always populates Header, so None cannot happen; the
  // unwrap is the Option<Header> field type's toll, not a real branch.
  if let Some(h) = req.Header {
    let mut h = h
    if payload != "" { h.Set("Content-Type", content_type) }
    if auth != "" { h.Set("Authorization", auth) }
  }
  let resp = match http.DefaultClient.Do(req) {
    Ok(r) => r,
    Err(e) => return Err(unreachable_hint(base, defaulted, e)),
  }
  read_body(resp, f"{method} {base}{path}")
}

fn read_body(resp: Ref<http.Response>, what: string) -> Result<string, string> {
  let Some(stream) = resp.Body else {
    return Err(f"{what}: empty response body")
  }
  defer stream.Close()
  let body = match io.ReadAll(stream) {
    Partial.Ok(b) => b,
    Partial.Both(b, _) => b,
    Partial.Err(e) => return Err(f"{what}: reading response: {e}"),
  }
  if resp.StatusCode >= 300 {
    return Err(
      f"{what}: {resp.Status}: {body as string}" +
        wrong_port_hint(what, resp.StatusCode, body as string),
    )
  }
  Ok(body as string)
}

/// The suffix for a 404 that came from something other than PocketBase's API.
/// "" for every other failure — a genuine missing record is a 404 too, and
/// telling someone to check their port when the record simply does not exist
/// would be worse than saying nothing.
///
/// The transcript this exists for: `url` set to the hosted board's bare host,
/// with no `:8091`. Every request then reaches the web board, which answers
/// Go's own plain-text `404 page not found`, and the CLI reported that verbatim
/// — a whole debugging loop with nothing anywhere naming the port.
///
/// TASK-241 removed that cause: the board proxies /api/ to its own PocketBase,
/// so the bare host is now the RIGHT url and the config that used to fail is
/// the one we document. The detection still holds - a non-JSON 404 at /api/
/// still means the listener is not a PocketBase API - but the remedy moved.
/// Telling someone to add :8091 would now point them away from the fix, since
/// their url is fine and the server is the thing that is behind.
///
/// The tell is the body, not the status: PocketBase answers every API error
/// with a JSON object, so a 404 at an /api/ path whose body is not JSON came
/// from a listener that has never heard of the API.
fn wrong_port_hint(what: string, status: int, body: string) -> string {
  if status != 404 { return "" }
  if !strings.Contains(what, "/api/") { return "" }
  if strings.HasPrefix(strings.TrimSpace(body), "{") { return "" }
  "\nthis host answers but is not serving the API. A current lll serves it at the same address as the board, so this is usually an older deployment - try https://host:8091, and check 'lll config --list'"
}
