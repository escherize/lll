import "go:errors"
import "go:github.com/escherize/lll/gopb"
import "go:net/http"
import "go:net/http/httptest"
import "go:os"
import "go:path/filepath"
import "go:strings"

import "config"

#[test]
fn empty_list_detection_uses_json_metadata() {
  assert is_empty_list("GET", "{\"totalItems\":0,\"items\":[]}")
  assert is_empty_list("GET", "{\n  \"totalItems\": 0, \"items\": []\n}")
  assert !is_empty_list("POST", "{\"totalItems\":0}")
  assert !is_empty_list("GET", "{\"totalItems\":1}")
  assert !is_empty_list("GET", "{\"totalItems\":null}")
  assert !is_empty_list("GET", "{\"items\":[]}")
  assert !is_empty_list("GET", "{\"totalItems\":\"0\"}")
  assert !is_empty_list("GET", "{\"description\":\"\\\"totalItems\\\":0\"}")
  assert !is_empty_list("GET", "{\"totalItems\":0")
}

// The bearer decision is the pure seam of TASK-179: every verb asks bearer()
// what to put in Authorization, and "" means today's request, untouched. The
// rest — the header actually reaching the wire — is covered by the e2e suite's
// scratch HTTP listener, which is the only honest proof of a header.

#[test]
fn no_token_means_no_authorization_value() {
  assert bearer("") == ""
}

#[test]
fn a_token_becomes_a_bearer_value() {
  assert bearer("abc123") == "Bearer abc123"
}

#[test]
fn only_an_empty_token_means_absent() {
  // Whitespace is a value like any other: trimming here would silently
  // "fix" a config typo that the user should see fail against the server.
  assert bearer(" ") == "Bearer  "
}

// The other pure seam (TASK-195/203): what an unreachable server says. The
// e2e assert for the defaulted case is guarded on :8090 being dead, so this
// is the check that always runs.

#[test]
fn a_refused_default_url_points_at_login_url() {
  let e = errors.New("connection refused")
  let msg = unreachable_hint("http://127.0.0.1:8090", true, e)
  assert msg.contains("127.0.0.1:8090")
  assert msg.contains("lll login --url")
}

#[test]
fn a_refused_configured_url_is_named_without_the_fresh_machine_hint() {
  let e = errors.New("connection refused")
  let msg = unreachable_hint("http://tracker.example.com:8091", false, e)
  assert msg.contains("tracker.example.com:8091")
  assert !msg.contains("lll login --url")
}

// The third pure seam (TASK-213): which 404s get told about the port. The
// whole value of the hint is that it stays quiet on the common 404, so the
// silent cases matter more here than the loud one.

#[test]
fn a_plain_text_404_from_the_board_names_the_api_port() {
  let msg = wrong_port_hint(
    "GET https://escherize-lll.fly.dev/api/collections/issues/records",
    404,
    "404 page not found\n",
  )
  assert msg.contains(":8091")
  assert msg.contains("lll config list")
}

#[test]
fn a_missing_record_keeps_its_own_message() {
  // PocketBase's own 404. Suggesting a port here would send someone hunting
  // config over a record that simply is not there.
  let msg = wrong_port_hint(
    "GET http://127.0.0.1:8090/api/collections/issues/records/abc",
    404,
    "{\"code\":404,\"message\":\"The requested resource wasn't found.\"}",
  )
  assert msg == ""
}

#[test]
fn only_404s_at_an_api_path_are_suspected() {
  assert wrong_port_hint("GET https://host/", 404, "404 page not found") == ""
  assert wrong_port_hint("GET https://host/api/health", 500, "boom") == ""
}

// TASK-309: the stale-token probe reads the token's own id out of the JWT and
// fetches that record, because auth-refresh refuses live impersonation
// tokens and a filtered list answers 200 to dead ones. token_subject is the
// pure half; it must read a real payload and must NOT accuse what it cannot
// read.

// LLL-436: the stale-token probe above is one round trip, and an EMPTY LIST is
// what triggers it. `lll issue view` on an issue with no linked docs, no
// blockers and no comments hit three empty lists and paid for the identical
// probe three times in one process. These pin the memo that stopped that.
// LLL-486: the memo lives in the client's session, not in the environment.

/// A live (exp 2100) member token naming abc123def456ghi.
fn live_token() -> string {
  "eyJhbGciOiJIUzI1NiJ9.eyJjb2xsZWN0aW9uSWQiOiJwYmNfMzU3MjczOTM0OSIsImV4cCI6NDEwMjQ0NDgwMCwiaWQiOiJhYmMxMjNkZWY0NTZnaGkiLCJyZWZyZXNoYWJsZSI6ZmFsc2UsInR5cGUiOiJhdXRoIn0.sig"
}

#[test]
fn the_identity_probe_is_remembered_once_per_session_server_and_token() {
  let hits = Channel.buffered<string>(64)
  let mut server = httptest.NewServer(http.HandlerFunc(|w, r| {
    if let Some(u) = r.URL { let _ = hits.send(u.Path) }
    let _ = w.Write("{\"id\":\"abc123def456ghi\"}".bytes())
  }))
  defer server.Close()
  let tok = live_token()
  let session = gopb.NewSession(tok)
  assert verdict(server.URL, tok, session) == "valid"
  assert verdict(server.URL, tok, session) == "valid"
  // One request for two verdicts: the second was remembered.
  let assert Some(_) = hits.receive()
  assert session.Probed() == probe_key(server.URL, tok)
  // A different server, or a re-minted token, is a different question.
  assert session.Probed() != probe_key("https://b.example", tok)
  assert session.Probed() != probe_key(server.URL, tok + "x")
  // A fresh session has remembered nothing.
  assert gopb.NewSession(tok).Probed() == ""
}

#[test]
fn a_renewed_token_reaches_every_copy_of_the_client() {
  // The board hands copies of its client to every handler; a renewal must
  // reach all of them, which is why the token lives in a shared session.
  let c = Client.new(config.given(config.Config { url: "http://127.0.0.1:1", token: "old", .. }, config.Sources { .. }, config.Env { .. }))
  let copy = c
  c.renew_to("new")
  assert copy.token() == "new"
  // with_token starts a separate session: the original keeps its own.
  let other = c.with_token("other", "")
  assert other.token() == "other"
  assert c.token() == "new"
}

#[test]
fn only_a_granted_client_renews() {
  // LLL_REMINT=1 with the admin pair grants renewal (the e2e seam); the pair
  // alone does not, and neither does LLL_REMINT alone.
  let pair = config.Env { admin_email: "a@x", admin_password: "pw", .. }
  let plain = Client.new(config.resolve(pair, config.no_overrides()))
  assert plain.renewal.is_none()
  let granted_env = config.Env { admin_email: "a@x", admin_password: "pw", remint: true, remint_member: "m1", .. }
  let granted = Client.new(config.resolve(granted_env, config.no_overrides()))
  let assert Some(r) = granted.renewal
  assert r.member == "m1"
  let flag_only = Client.new(config.resolve(config.Env { remint: true, .. }, config.no_overrides()))
  assert flag_only.renewal.is_none()
}

#[test]
fn the_probe_key_never_carries_the_token_itself() {
  // The memo is a digest, never a usable credential.
  let tok = "eyJhbGciOiJIUzI1NiJ9.eyJpZCI6InNlY3JldCJ9.sig"
  let key = probe_key("https://a.example", tok)
  assert !strings.Contains(key, tok)
  assert !strings.Contains(key, "https://a.example")
  assert key.length() == 64
  // Same inputs, same key: the memo has to hit on the second call.
  assert probe_key("https://a.example", tok) == key
}

#[test]
fn token_subject_reads_the_id_from_a_pocketbase_auth_jwt() {
  // header.payload.sig, payload = {"collectionId":"pbc_3572739349","exp":1,"id":"abc123def456ghi","refreshable":false,"type":"auth"}
  let tok = "eyJhbGciOiJIUzI1NiJ9.eyJjb2xsZWN0aW9uSWQiOiJwYmNfMzU3MjczOTM0OSIsImV4cCI6MSwiaWQiOiJhYmMxMjNkZWY0NTZnaGkiLCJyZWZyZXNoYWJsZSI6ZmFsc2UsInR5cGUiOiJhdXRoIn0.sig"
  let assert Some(id) = token_subject(tok)
  assert id == "abc123def456ghi"
  let assert Some(collection) = token_collection(tok)
  assert collection == "pbc_3572739349"
}

// LLL-441: a login token (refreshable: true) is renewed inside the last day
// of its life; an impersonation token (refreshable: false) never is, and an
// expired one cannot be, because auth-refresh refuses it.
#[test]
fn only_a_live_refreshable_token_near_expiry_needs_refresh() {
  // payload = {"collectionId":"pbc_1","exp":1000000,"id":"abc","refreshable":true}
  let login = "h.eyJjb2xsZWN0aW9uSWQiOiJwYmNfMSIsImV4cCI6MTAwMDAwMCwiaWQiOiJhYmMiLCJyZWZyZXNoYWJsZSI6dHJ1ZX0.s"
  // the same payload with refreshable: false
  let impersonate = "h.eyJjb2xsZWN0aW9uSWQiOiJwYmNfMSIsImV4cCI6MTAwMDAwMCwiaWQiOiJhYmMiLCJyZWZyZXNoYWJsZSI6ZmFsc2V9.s"
  let exp = 1000000
  assert token_needs_refresh(login, exp - 3600)
  assert !token_needs_refresh(login, exp - refresh_window())
  assert !token_needs_refresh(login, exp - 4 * 86400)
  assert !token_needs_refresh(login, exp)
  assert !token_needs_refresh(login, exp + 1)
  assert !token_needs_refresh(impersonate, exp - 3600)
  assert !token_needs_refresh("not-a-jwt", exp - 3600)
}

// LLL-441 review: only a later refreshable token for the same record and
// collection may replace the saved login. A foreign server's answer must not.
#[test]
fn a_refresh_answer_must_be_a_later_token_for_the_same_login() {
  // exp 1000000, id abc, pbc_1, refreshable
  let old = "h.eyJjb2xsZWN0aW9uSWQiOiJwYmNfMSIsImV4cCI6MTAwMDAwMCwiaWQiOiJhYmMiLCJyZWZyZXNoYWJsZSI6dHJ1ZX0.s"
  // exp 2000000 and: same login / other id / other collection / not refreshable
  let fresh = "h.eyJjb2xsZWN0aW9uSWQiOiJwYmNfMSIsImV4cCI6MjAwMDAwMCwiaWQiOiJhYmMiLCJyZWZyZXNoYWJsZSI6dHJ1ZX0.s"
  let other_id = "h.eyJjb2xsZWN0aW9uSWQiOiJwYmNfMSIsImV4cCI6MjAwMDAwMCwiaWQiOiJ4eXoiLCJyZWZyZXNoYWJsZSI6dHJ1ZX0.s"
  let other_collection = "h.eyJjb2xsZWN0aW9uSWQiOiJwYmNfMiIsImV4cCI6MjAwMDAwMCwiaWQiOiJhYmMiLCJyZWZyZXNoYWJsZSI6dHJ1ZX0.s"
  let not_refreshable = "h.eyJjb2xsZWN0aW9uSWQiOiJwYmNfMSIsImV4cCI6MjAwMDAwMCwiaWQiOiJhYmMiLCJyZWZyZXNoYWJsZSI6ZmFsc2V9.s"
  assert same_login(old, fresh)
  assert !same_login(old, other_id)
  assert !same_login(old, other_collection)
  assert !same_login(old, not_refreshable)
  assert !same_login(old, old)
  assert !same_login(fresh, old)
  assert !same_login(old, "FOREIGN-SERVER-TOKEN")
}

#[test]
fn token_subject_declines_what_it_cannot_read() {
  // Not three segments; a payload that is not JSON; a payload with no id.
  assert token_subject("not-a-jwt").is_none()
  assert token_subject("a.b").is_none()
  assert token_subject("h.!!!notbase64!!!.s").is_none()
  // {"exp":1} - valid JSON, no id: still None, so no record can be fetched
  // and the token is treated as valid rather than accused.
  assert token_subject("h.eyJleHAiOjF9.s").is_none()
  assert token_collection("not-a-jwt").is_none()
  assert token_collection("h.!!!notbase64!!!.s").is_none()
  assert token_collection("h.eyJleHAiOjF9.s").is_none()
}

#[test]
fn token_subject_declines_a_three_segment_token_with_a_broken_payload() {
  // A JWT with one character altered inside its payload segment: the shape
  // fleet run 3 produced ten times over by hand-copying. token_subject cannot
  // read an id from it, and token_verdict must call that "corrupted" rather
  // than shrug it through as valid - the whole point is to send the agent
  // back to the file instead of leaving it staring at an empty list.
  let good = "eyJhbGciOiJIUzI1NiJ9.eyJjb2xsZWN0aW9uSWQiOiJwYmNfMzU3MjczOTM0OSIsImV4cCI6MSwiaWQiOiJhYmMxMjNkZWY0NTZnaGkiLCJyZWZyZXNoYWJsZSI6ZmFsc2UsInR5cGUiOiJhdXRoIn0.sig"
  assert token_subject(good).is_some()
  // Flip one payload character. Still three segments; no longer decodable.
  let broken = "eyJhbGciOiJIUzI1NiJ9.eyJjb2xsZWN0aW9uSWQiOiJwYmNfMzU3MjczOTM0OSIsImV4cCI6MSwiaWQiOiJhYmMxMjNkZWY0NTZnaGkiLCJyZWZyZXNoYWJsZSI6ZmFsc2UsInR5cGUiOiJhdXRoIn0!.sig"
  assert token_subject(broken).is_none()
  assert strings.Split(broken, ".").length() == 3
}

#[test]
fn a_refused_file_token_is_replaced_by_the_one_the_file_holds_now() {
  // v0.9 re-read the config on every request, so a long-running process on
  // a file token (a board on the caller's token, a watch) healed when the
  // file was rewritten. The client re-reads once, on refusal, instead.
  let old = live_token()
  let fresh = "eyJhbGciOiJIUzI1NiJ9.eyJjb2xsZWN0aW9uSWQiOiJwYmNfMzU3MjczOTM0OSIsImV4cCI6NDEwMjQ0NDgwMCwiaWQiOiJ6enoxMjNkZWY0NTZnaGkiLCJyZWZyZXNoYWJsZSI6ZmFsc2UsInR5cGUiOiJhdXRoIn0.sig"
  let mut server = httptest.NewServer(http.HandlerFunc(|w, r| {
    let auth = r.Header.map_or("", |h| h.Get("Authorization"))
    if auth != f"Bearer {fresh}" {
      w.WriteHeader(401)
      let _ = w.Write("{\"data\":{},\"message\":\"The request requires valid record authorization token.\",\"status\":401}".bytes())
      return
    }
    let _ = w.Write("{\"page\":1,\"perPage\":30,\"totalItems\":1,\"totalPages\":1,\"items\":[{\"id\":\"t1\"}]}".bytes())
  }))
  defer server.Close()
  let assert Ok(root) = os.MkdirTemp("", "lll-reload")
  // Out of this checkout: its committed .lll.toml names the hosted server.
  let assert Ok(prev) = os.Getwd()
  defer { let _ = os.Chdir(prev) }
  let assert Ok(_) = os.Chdir(root)
  let file = filepath.Join(root, "lll", "lll.toml")
  let assert Ok(_) = os.MkdirAll(filepath.Dir(file), 0o700)
  let assert Ok(_) = os.WriteFile(file, f"url = \"{server.URL}\"\ntoken = \"{old}\"\n".bytes(), 0o600)
  let c = Client.new(config.resolve(config.Env { config_home: root, .. }, config.no_overrides()))
  assert c.token() == old
  let assert Ok(_) = os.WriteFile(file, f"url = \"{server.URL}\"\ntoken = \"{fresh}\"\n".bytes(), 0o600)
  let assert Ok(body) = c.get("/api/collections/teams/records")
  assert body.contains("\"t1\"")
  assert c.token() == fresh
  // A token a boot handed over is never traded for a file's.
  let handed = c.with_token(old, "")
  let assert Err(_) = handed.get("/api/collections/teams/records")
  assert handed.token() == old
}
