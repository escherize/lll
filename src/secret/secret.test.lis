import "go:bufio"
import "go:fmt"
import "go:strings"

import "flags"
import "pb"

// LLL-686: every secret flag reads '-' and a literal the same way, because
// every one is read here. SECRET_FLAGS in scripts/test_secret_flags.py is
// this list; that test also holds each flag to Secret.read.
fn secret_flags() -> Slice<string> {
  ["--password", "--old-password", "--admin-password", "--token", "--secret"]
}

fn parsed(flag: string, args: Slice<string>) -> flags.Parsed {
  let spec = [flags.Flag { name: flag, value: true, hint: "pw", .. }]
  let Ok(p) = flags.parse(spec, args, 0, false, "") else { panic("parse") }
  p
}

fn piped(text: string) -> mut Ref<bufio.Reader> {
  bufio.NewReader(strings.NewReader(text))
}

#[test]
fn dash_reads_one_line_from_piped_stdin_for_every_secret_flag() {
  for flag in secret_flags() {
    let mut input = piped("pw-from-stdin\nnext line\n")
    let Ok(s) = read_from(parsed(flag, [flag, "-"]), flag, "Prompt: ", input, false) else { panic("unexpected") }
    assert s.reveal() == "pw-from-stdin"
    // One line only: what follows is left for the next reader.
    let Partial.Ok(rest) = input.ReadString(10 as byte) else { panic("unexpected") }
    assert rest == "next line\n"
  }
}

#[test]
fn dash_strips_crlf_and_takes_a_last_line_without_newline() {
  for flag in secret_flags() {
    let mut crlf = piped("pw-crlf\r\n")
    assert read_from(parsed(flag, [flag, "-"]), flag, "", crlf, false).map_or("", |s| s.reveal()) == "pw-crlf"
    let mut bare = piped("pw-bare")
    assert read_from(parsed(flag, [flag, "-"]), flag, "", bare, false).map_or("", |s| s.reveal()) == "pw-bare"
  }
}

#[test]
fn dash_on_empty_stdin_is_a_usage_error_naming_the_flag() {
  for flag in secret_flags() {
    for text in ["", "\n"] {
      let mut input = piped(text)
      let Err(e) = read_from(parsed(flag, [flag, "-"]), flag, "", input, false) else { panic("unexpected") }
      assert e.message == f"{flag} -: stdin was empty"
      assert match e.kind {
        pb.ErrorKind.Usage => true,
        _ => false,
      }
    }
  }
}

#[test]
fn a_literal_value_is_the_secret_and_stdin_is_untouched() {
  for flag in secret_flags() {
    for lit in ["hunter2-literal", "--", "-x", ""] {
      let mut input = piped("not-read\n")
      let Ok(s) = read_from(parsed(flag, [flag, lit]), flag, "", input, false) else { panic("unexpected") }
      assert s.reveal() == lit
      let Partial.Ok(rest) = input.ReadString(10 as byte) else { panic("unexpected") }
      assert rest == "not-read\n"
    }
  }
}

#[test]
fn an_absent_flag_is_asked_for_and_a_piped_answer_is_a_plain_line() {
  let mut input = piped("typed\n")
  let Ok(s) = read_from(parsed("--password", []), "--password", "Password: ", input, false) else { panic("unexpected") }
  assert s.reveal() == "typed"
  // An empty answer is an empty secret; the caller names what is missing.
  let mut empty = piped("")
  let Ok(none) = read_from(parsed("--password", []), "--password", "Password: ", empty, false) else { panic("unexpected") }
  assert none.is_empty()
}

#[test]
fn printing_a_secret_shows_a_placeholder() {
  let mut input = piped("")
  let Ok(s) = read_from(parsed("--password", ["--password", "hunter2"]), "--password", "", input, false) else { panic("unexpected") }
  assert f"{s}" == "[secret]"
  assert fmt.Sprintf("%v %+v %#v %s %q", s, s, s, s, s) == "[secret] [secret] [secret] [secret] \"[secret]\""
  assert !fmt.Sprint(s).contains("hunter2")
}

#[test]
fn checks_that_need_no_text() {
  let mut input = piped("")
  let p = parsed("--password", ["--password", "abc"])
  let Ok(a) = read_from(p, "--password", "", input, false) else { panic("unexpected") }
  let Ok(b) = read_from(p, "--password", "", input, false) else { panic("unexpected") }
  assert a.length() == 3
  assert !a.is_empty()
  assert a.matches(b)
  assert from_stdin(parsed("--token", ["--token", "-"]), "--token")
  assert !from_stdin(parsed("--token", ["--token", "x"]), "--token")
  assert !from_stdin(parsed("--token", []), "--token")
}
