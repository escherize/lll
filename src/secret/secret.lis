import "go:bufio"
import "go:fmt"
import "go:golang.org/x/term"
import "go:os"
import "go:strings"

import "flags"
import "pb"

// A password, token or webhook secret given on the command line (LLL-686).
// Each secret flag had its own reading: --admin-password - read stdin,
// member create's --password took "-" literally, --token - printed its
// prompt into a pipe. Now every one is read by Secret.read, so '-' means
// the same on all of them.
//
// The value is private to this module. Other code can test, measure and
// compare a Secret, and printing one shows a placeholder; the text comes
// out only through reveal(), which scripts/test_secret_flags.py allows only
// where the secret is sent to the server or saved to the config.

pub struct Secret { value: string }

impl Secret {
  /// The value of the secret flag `flag`, the one way a Secret is made.
  ///
  /// A value other than '-' is the secret itself. '-' reads it: with echo
  /// off after `prompt` on a terminal, else one line from `input`, where
  /// an empty line is a usage error naming `flag` (two 1.0 agents logged in
  /// with the literal password "-"). A flag that was not given is asked
  /// for: `prompt`, then the hidden read on a terminal or a plain line.
  /// Callers whose flag is optional check p.given first.
  pub fn read(
    p: flags.Parsed,
    flag: string,
    prompt: string,
    input: mut Ref<bufio.Reader>,
  ) -> Result<Secret, pb.CliError> {
    read_from(p, flag, prompt, input, term.IsTerminal(os.Stdin.Fd() as int))
  }

  pub fn is_empty(self) -> bool {
    self.value == ""
  }

  /// The length, for minimum-length checks; says nothing of the content.
  pub fn length(self) -> int {
    self.value.length()
  }

  /// Whether two secrets are the same, as a password and its confirmation.
  pub fn matches(self, other: Secret) -> bool {
    self.value == other.value
  }

  /// The text, for the request that sends it or the config write that
  /// saves it. Every call site is listed in scripts/test_secret_flags.py.
  pub fn reveal(self) -> string {
    self.value
  }

  /// What fmt prints for a Secret (Go's String and GoString), so an f-string
  /// or a %v that reaches one shows a placeholder, not the value.
  pub fn string(self) -> string {
    "[secret]"
  }

  pub fn go_string(self) -> string {
    "[secret]"
  }
}

/// Whether the secret flag `flag` reads stdin ('-'). Only one flag of a
/// command can: a second reader would lose what the first one buffered.
pub fn from_stdin(p: flags.Parsed, flag: string) -> bool {
  p.one(flag) == "-"
}

/// Secret.read with the terminal question answered by the caller, so the
/// piped path runs under test whatever stdin the test runner has.
fn read_from(
  p: flags.Parsed,
  flag: string,
  prompt: string,
  input: mut Ref<bufio.Reader>,
  terminal: bool,
) -> Result<Secret, pb.CliError> {
  if !p.given(flag) { return prompted(prompt, input, terminal) }
  let raw = p.one(flag)
  if raw != "-" { return Ok(Secret { value: raw }) }
  // A plain line read on a terminal would echo the secret.
  if terminal { return prompted(prompt, input, true) }
  let line = match input.ReadString(10 as byte) {
    Partial.Ok(l) => strip_eol(l),
    Partial.Both(l, _) => strip_eol(l),
    Partial.Err(_) => "",
  }
  if line == "" { return Err(flags.usage_error(f"{flag} -: stdin was empty")) }
  Ok(Secret { value: line })
}

/// `prompt`, then the answer: term.ReadPassword on a terminal, so it never
/// lands in scrollback; a plain line otherwise, because piped input
/// (scripts, agents, e2e) has nothing to hide it from. The newline is not
/// part of the secret on either path.
fn prompted(
  prompt: string,
  input: mut Ref<bufio.Reader>,
  terminal: bool,
) -> Result<Secret, pb.CliError> {
  fmt.Print(prompt)
  if terminal {
    let bytes = match term.ReadPassword(os.Stdin.Fd() as int) {
      Ok(b) => b,
      Err(e) => return Err(pb.failed(f"reading the password: {e}")),
    }
    fmt.Println("")
    return Ok(Secret { value: bytes as string })
  }
  // Partial.Both (data, then EOF with no newline) is an answer too:
  // `printf 'pw' | lll login` ships one.
  let line = match input.ReadString(10 as byte) {
    Partial.Ok(l) => strip_eol(l),
    Partial.Both(l, _) => strip_eol(l),
    Partial.Err(_) => return Err(pb.failed("no answer on stdin")),
  }
  fmt.Println("")
  Ok(Secret { value: line })
}

/// The line ReadString returned, without its end-of-line: "\n" as piped,
/// or "\r\n" when the source writes Windows endings.
fn strip_eol(line: string) -> string {
  strings.TrimSuffix(strings.TrimSuffix(line, "\n"), "\r")
}
