import "go:bufio"
import "go:fmt"
import "go:golang.org/x/term"
import "go:os"
import "go:os/signal"
import "go:strings"

import "flags"
import "pb"

// A password, token or webhook secret given on the command line (LLL-686).
// Each secret flag had its own reading: --admin-password - read stdin,
// member create's --password took "-" literally, --token - printed its
// prompt into a pipe. Now every one is read by Secret.read, so '-' means
// the same on all of them.
//
// The value is private to this module. Other code can test, measure and
// compare a Secret, and printing one shows a placeholder; the text comes
// out only through reveal(), which scripts/test_secret_flags.py allows only
// where the secret is sent to the server or saved to the config.
//
// The field is a Ref, not the string. fmt calls String on a Secret it is
// handed, but not on one inside another struct's unexported field: there it
// prints the fields, and a string field would print the secret. A Ref prints
// as an address.

pub struct Secret { value: Ref<string> }

/// A Secret holding `text`.
fn hold(text: string) -> Secret {
  let held = text
  Secret { value: &held }
}

impl Secret {
  /// The value of the secret flag `flag`, the one way a Secret is made.
  ///
  /// A value other than '-' is the secret itself. '-' reads it: with echo
  /// off after `prompt` on a terminal, else one line from `input`, where
  /// an empty line is a usage error naming `flag` (two 1.0 agents logged in
  /// with the literal password "-"). A flag that was not given is asked
  /// for: `prompt`, then the hidden read on a terminal or a plain line.
  /// Callers whose flag is optional check p.given first.
  pub fn read(
    p: flags.Parsed,
    flag: string,
    prompt: string,
    input: mut Ref<bufio.Reader>,
  ) -> Result<Secret, pb.CliError> {
    read_from(p, flag, prompt, input, term.IsTerminal(os.Stdin.Fd() as int))
  }

  /// This secret, typed a second time when the first was typed blind: on a
  /// terminal, for `flag` given as '-'. A mismatch is refused, because a
  /// typo in a new password makes a login nobody can use. A literal or
  /// piped value is returned as it is.
  pub fn confirmed(
    self,
    p: flags.Parsed,
    flag: string,
    input: mut Ref<bufio.Reader>,
  ) -> Result<Secret, pb.CliError> {
    confirm_from(self, p, flag, input, term.IsTerminal(os.Stdin.Fd() as int))
  }

  pub fn is_empty(self) -> bool {
    self.value.* == ""
  }

  /// The length, for minimum-length checks; says nothing of the content.
  pub fn length(self) -> int {
    self.value.*.length()
  }

  /// Whether two secrets are the same, as a password and its confirmation.
  pub fn matches(self, other: Secret) -> bool {
    self.value.* == other.value.*
  }

  /// The text, for the request that sends it or the config write that
  /// saves it. Every call site is listed in scripts/test_secret_flags.py.
  pub fn reveal(self) -> string {
    self.value.*
  }

  /// What fmt prints for a Secret (Go's String and GoString), so an f-string
  /// or a %v that reaches one shows a placeholder, not the value.
  pub fn string(self) -> string {
    "[secret]"
  }

  pub fn go_string(self) -> string {
    "[secret]"
  }
}

/// Whether the secret flag `flag` reads stdin ('-'). Commands let only one
/// flag do so: with two, which line answers which flag would depend on the
/// order the command reads them, which nothing on the command line says.
pub fn from_stdin(p: flags.Parsed, flag: string) -> bool {
  p.one(flag) == "-"
}

/// Secret.read with the terminal question answered by the caller, so the
/// piped path runs under test whatever stdin the test runner has.
fn read_from(
  p: flags.Parsed,
  flag: string,
  prompt: string,
  input: mut Ref<bufio.Reader>,
  terminal: bool,
) -> Result<Secret, pb.CliError> {
  if !p.given(flag) { return prompted(prompt, input, terminal) }
  let raw = p.one(flag)
  if raw != "-" { return Ok(hold(raw)) }
  // A plain line read on a terminal would echo the secret.
  if terminal { return prompted(prompt, input, true) }
  let line = match input.ReadString(10 as byte) {
    Partial.Ok(l) => strip_eol(l),
    Partial.Both(l, _) => strip_eol(l),
    Partial.Err(_) => "",
  }
  if line == "" { return Err(flags.usage_error(f"{flag} -: stdin was empty")) }
  Ok(hold(line))
}

/// Secret.confirmed with the terminal question answered by the caller.
fn confirm_from(
  first: Secret,
  p: flags.Parsed,
  flag: string,
  input: mut Ref<bufio.Reader>,
  terminal: bool,
) -> Result<Secret, pb.CliError> {
  if !terminal || !from_stdin(p, flag) { return Ok(first) }
  let again = prompted("Confirm password: ", input, true)?
  if !first.matches(again) { return Err(pb.failed("the passwords do not match")) }
  Ok(first)
}

/// `prompt`, then the answer: term.ReadPassword on a terminal, so it never
/// lands in scrollback; a plain line otherwise, because piped input
/// (scripts, agents, e2e) has nothing to hide it from. The newline is not
/// part of the secret on either path.
fn prompted(
  prompt: string,
  input: mut Ref<bufio.Reader>,
  terminal: bool,
) -> Result<Secret, pb.CliError> {
  if terminal { return Ok(hold(hidden_line(prompt)?)) }
  fmt.Print(prompt)
  // Partial.Both (data, then EOF with no newline) is an answer too:
  // `printf 'pw' | lll login` ships one.
  let line = match input.ReadString(10 as byte) {
    Partial.Ok(l) => strip_eol(l),
    Partial.Both(l, _) => strip_eol(l),
    Partial.Err(_) => return Err(pb.failed("no answer on stdin")),
  }
  fmt.Println("")
  Ok(hold(line))
}

/// `prompt`, then one line typed on the terminal with echo off.
///
/// Echo goes off BEFORE the prompt is shown. ReadPassword turns it off
/// itself, but only once called: anything typed between seeing the prompt
/// and that call was echoed (a slower CI runner showed the token). MakeRaw
/// is the one way x/term offers to turn echo off early; ReadPassword then
/// reads a line, cooked and without echo, and the saved state is restored.
///
/// ReadPassword restores the terminal when it returns, but Ctrl-C killed the
/// process inside it and left the shell with echo off. Until it returns, an
/// interrupt restores the terminal and exits 130, as a shell reports a
/// SIGINT exit.
fn hidden_line(prompt: string) -> Result<string, pb.CliError> {
  let fd = os.Stdin.Fd() as int
  let state = match term.GetState(fd) {
    Ok(st) => st,
    Err(e) => return Err(pb.failed(f"reading the password: {e}")),
  }
  let interrupts = Channel.buffered<os.Signal>(1)
  let (tx, rx) = interrupts.split()
  signal.Notify(tx, os.Interrupt)
  task {
    if let Some(_) = rx.receive() {
      let _ = term.Restore(fd, state)
      fmt.Println("")
      os.Exit(130)
    }
  }
  if let Err(e) = term.MakeRaw(fd) {
    signal.Stop(tx)
    interrupts.close()
    return Err(pb.failed(f"reading the password: {e}"))
  }
  fmt.Print(prompt)
  let read = term.ReadPassword(fd)
  let _ = term.Restore(fd, state)
  signal.Stop(tx)
  interrupts.close()
  let bytes = match read {
    Ok(b) => b,
    Err(e) => return Err(pb.failed(f"reading the password: {e}")),
  }
  fmt.Println("")
  Ok(bytes as string)
}

/// The line ReadString returned, without its end-of-line: "\n" as piped,
/// or "\r\n" when the source writes Windows endings.
fn strip_eol(line: string) -> string {
  strings.TrimSuffix(strings.TrimSuffix(line, "\n"), "\r")
}
