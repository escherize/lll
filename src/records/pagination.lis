import "pb"

#[json]
struct CollectionPage<T> {
  items: Slice<T>,
  #[json("totalPages")]
  total_pages: int,
}

/// Complete typed collection reads, the one page loop (LLL-659): every read
/// that walks pages goes through here, with this one stop rule. The URL owns
/// scope, sort and expansions and must already carry a `?`; every page keeps
/// them. A failed page fails the read before callers print.
pub fn fetch_all_records<T>(ctx: pb.Client, path: string, thing: string) -> Result<Slice<T>, pb.CliError> {
  let mut out: Slice<T> = []
  let mut page = 1
  loop {
    let mut batch: CollectionPage<T> = CollectionPage { .. }
    pb.fetch(ctx, f"{path}&perPage=200&page={page}", thing, &batch)?
    out = out.append(batch.items...)
    if batch.total_pages > 0 {
      if page >= batch.total_pages { break }
    } else if batch.items.length() < 200 {
      // Empty native responses and older fixtures omit pagination metadata.
      break
    }
    page += 1
  }
  Ok(out)
}
