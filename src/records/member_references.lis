import "go:encoding/json"
import "go:net/url"

import "pb"
import "query"
import "models"

pub struct MemberReferences {
  pub assigned: int,
  pub authored: int,
  pub created: int,
}

/// Both deletion surfaces count assignments and authorship under the identity
/// that will perform the deletion, including references outside the current team.
pub fn count_member_references(
  ctx: pb.Client,
  id: models.MemberId,
  token: string,
) -> Result<MemberReferences, pb.CliError> {
  Ok(
    MemberReferences {
      assigned: member_reference_count(ctx, "issues", "assignee", id, token)?,
      authored: member_reference_count(ctx, "comments", "author", id, token)?,
      created: member_reference_count(ctx, "issues", "creator", id, token)?,
    },
  )
}

#[json]
struct MemberReferenceCount {
  #[json("totalItems")]
  total: Option<int>,
}

/// All reads and the deletion use the same administrative identity, so a
/// missing or stale configured member token cannot hide references.
fn member_reference_count(
  ctx: pb.Client,
  collection: string,
  field: string,
  id: models.MemberId,
  token: string,
) -> Result<int, pb.CliError> {
  let filter = url.QueryEscape(f"{field}={query.quote(id.string())}")
  let body = ctx.get_as(
    f"/api/collections/{collection}/records?filter={filter}&perPage=1&fields=id",
    token,
  )?
  let mut count = MemberReferenceCount { .. }
  if let Err(e) = json.Unmarshal(body.bytes(), &count) {
    return Err(pb.failed(f"counting member {collection}: {e}"))
  }
  let Some(total) = count.total else {
    return Err(pb.failed(f"counting member {collection}: response omitted totalItems"))
  }
  if total < 0 {
    return Err(pb.failed(f"counting member {collection}: invalid totalItems"))
  }
  Ok(total)
}
