import "go:encoding/json"
import "go:net/url"
import "models"
import "pb"
import "query"

/// An issue's comments, oldest first, author and a bot author's owner
/// expanded (LLL-610). PocketBase leaves the owner out when the caller may
/// not read it, so nobody learns an owner they cannot see.
pub fn fetch_comments(ctx: pb.Client, issue_id: string) -> Result<Slice<models.Comment>, string> {
  let filter = url.QueryEscape(f"issue={query.quote(issue_id)}")
  let mut result: Slice<models.Comment> = []
  let mut page = 1
  loop {
    let mut comments = models.CommentList { .. }
    pb.fetch(ctx, 
      f"/api/collections/comments/records?filter={filter}&sort=created,id&expand=author.owner&perPage=200&page={page}",
      "comments",
      &comments,
    )?
    for comment in comments.items {
      // PocketBase answers `"expand":{}` for an author with no owner to show;
      // dropping it keeps such an author's --json exactly as before LLL-610.
      let mut c = comment
      if c.expand.author.owner_name() == "" { c.expand.author.expand = None }
      result = result.append(c)
    }
    if page >= comments.total_pages { break }
    page += 1
  }
  Ok(result)
}

/// The stored spelling of a team key. Keys are uppercased on write (LLL-235),
/// so `lll issue view eng-1` has to match `ENG` to keep working.
fn records_team_key(key: string) -> string {
  normalize_team_key(key)
}

/// The answer for an issue key that names no issue. The board gives a
/// scoped viewer the same words for an issue it may not see (LLL-545).
pub fn issue_not_found(id: string) -> string {
  f"issue {id} not found; check 'lll issue list' or LLL_TEAM"
}

/// Fetch an issue by KEY-123 and return the raw PB record JSON (team,
/// assignee, labels, project expanded).
pub fn fetch_issue_record(ctx: pb.Client, id: string) -> Result<string, string> {
  let (team_key, number) = split_issue_key(id)?

  let not_found = issue_not_found(id)
  // One query, filtering through the team relation, rather than resolving the
  // team to an id first and filtering on that (LLL-436). PocketBase filters on
  // a relation's own fields, so `team.key` does in one round trip what the
  // team lookup plus this filter did in two - and both arms of the old version
  // returned the SAME not_found message, so nothing is lost by no longer
  // telling them apart.
  let filter = url.QueryEscape(
    f"team.key={query.quote(records_team_key(team_key))} && number={number}",
  )
  let mut issues = models.IssueList { .. }
  pb.fetch(ctx, 
    f"/api/collections/issues/records?filter={filter}&perPage=1",
    "issues",
    &issues,
  )?
  let Some(item) = issues.items.get(0) else {
    return Err(pb.fail(pb.ErrorKind.NotFound, not_found))
  }

  // blocked_by.team: a blocker's key is ITS team's key, not this issue's
  // (LLL-674).
  ctx.get(
    f"/api/collections/issues/records/{item.id}?expand=team,assignee,labels,project,blocked_by,blocked_by.team,creator",
  )
}

/// fetch_issue_record, decoded.
pub fn fetch_issue(ctx: pb.Client, id: string) -> Result<models.Issue, string> {
  let record = fetch_issue_record(ctx, id)?
  let mut full = models.Issue { .. }
  if let Err(e) = json.Unmarshal(record.bytes(), &full) {
    return Err(f"decoding issue: {e}")
  }
  Ok(full)
}

#[json]
struct BoardPage {
  items: Slice<models.Issue>,
  #[json("totalItems")]
  total_items: int,
  #[json("totalPages")]
  total_pages: int,
}

/// Complete board input, in deterministic manual order. Failed or inconsistent
/// pages never escape as a partial board; callers retain their prior view.
pub fn fetch_board_issues(ctx: pb.Client, team_id: string) -> Result<Slice<models.Issue>, string> {
  collect_board_issues(team_id, BOARD_EXPAND, |path| {
    let mut page = BoardPage { .. }
    pb.fetch(ctx, path, "board issues", &page)?
    Ok(page)
  })
}

/// What the board draws with. Deliberately not everything: each relation is
/// another join on a query that runs on every board load. `project` is here
/// because cards carry its id for the project filter, and a team-scoped
/// viewer must not get another team's project id (LLL-545): the board can
/// only tell whose project it is from the expanded record.
const BOARD_EXPAND: string = "team,assignee,labels,project"

/// The board's relations plus `project`, for callers writing the issue down
/// rather than drawing it. Members are deliberately NOT here: expanding a
/// relation into an auth collection proved to depend on the caller's
/// identity, so `lll export` resolves member names from one members request
/// instead (see mirror.Names).
const FULL_EXPAND: string = "team,assignee,labels,project"

/// fetch_board_issues with every named relation expanded.
pub fn fetch_full_issues(ctx: pb.Client, team_id: string) -> Result<Slice<models.Issue>, string> {
  collect_board_issues(team_id, FULL_EXPAND, |path| {
    let mut page = BoardPage { .. }
    pb.fetch(ctx, path, "issues", &page)?
    Ok(page)
  })
}

fn collect_board_issues(
  team_id: string,
  expand: string,
  fetch: fn(string) -> Result<BoardPage, string>,
) -> Result<Slice<models.Issue>, string> {
  let filter = url.QueryEscape(query.filter(team_id, "", "", "", "", ""))
  let mut result: Slice<models.Issue> = []
  let mut seen = Map.new<string, bool>()
  let mut expected = -1
  let mut pages = -1
  let mut page = 1
  loop {
    let batch = fetch(f"/api/collections/issues/records?perPage=200&page={page}&expand={expand}&sort=sort,created,id&filter={filter}")?
    if page == 1 { expected = batch.total_items; pages = batch.total_pages }
    if batch.total_items != expected || batch.total_pages != pages {
      return Err("the board changed while loading; refresh to retry")
    }
    for issue in batch.items {
      if seen.get(issue.id).is_some() { return Err("the board changed while loading; refresh to retry") }
      seen[issue.id] = true
      result = result.append(issue)
    }
    if page >= pages { break }
    page += 1
  }
  if result.length() != expected { return Err("the board response was incomplete; refresh to retry") }
  Ok(result)
}

/// One column's issues in board order: the input a reorder needs, not the
/// team. fetch_board_issues here made every card move re-read every issue
/// the team ever had, expanded, to find two sorts (LLL-428).
pub fn fetch_column_issues(ctx: pb.Client, team_id: string, state: string) -> Result<Slice<models.Issue>, string> {
  collect_column_issues(team_id, state, |path| {
    let mut page = BoardPage { .. }
    pb.fetch(ctx, path, "column issues", &page)?
    Ok(page)
  })
}

/// The column query behind fetch_column_issues, fetcher injected like
/// collect_board_issues. Deliberately no seen-duplicate or count check: the
/// caller computes one sort from the result, so a board changing mid-walk can
/// only land the midpoint a little off, and the next move corrects it — an
/// error here would fail a drag that is otherwise fine. Only id and sort are
/// read, so no expansions ride along.
fn collect_column_issues(
  team_id: string,
  state: string,
  fetch: fn(string) -> Result<BoardPage, string>,
) -> Result<Slice<models.Issue>, string> {
  let filter = url.QueryEscape(
    f"{query.filter(team_id, "", "", "", "", "")} && state={query.quote(state)}",
  )
  let mut result: Slice<models.Issue> = []
  let mut page = 1
  loop {
    let batch = fetch(f"/api/collections/issues/records?perPage=200&page={page}&sort=sort,created,id&fields=id,sort&filter={filter}")?
    for issue in batch.items { result = result.append(issue) }
    if batch.items.length() < 200 { break }
    page += 1
  }
  Ok(result)
}
