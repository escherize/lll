import "models"

#[test]
fn column_fetch_scopes_the_query_to_one_column_in_board_order() {
  let result = collect_column_issues("team", "todo", |path| {
    assert path.contains("filter=team")
    // the state clause rides the filter, URL-escaped: state='todo'
    assert path.contains("state%3D%27todo%27")
    assert path.contains("sort=sort,created,id")
    assert path.contains("fields=id,sort")
    // no expansions: a reorder reads only id and sort
    assert !path.contains("expand=")
    Ok(BoardPage { items: [models.Issue { id: "a", .. }], .. })
  })
  let Ok(issues) = result else { panic("column fetch failed") };
  assert issues.map(|i| i.id).equals(["a"])
}

#[test]
fn column_fetch_reads_every_page_of_a_large_column() {
  // 200 items per page: the loop must keep asking while a full page returns.
  let mut seen_pages: Slice<string> = []
  let result = collect_column_issues("team", "done", |path| {
    if path.contains("page=1&") {
      let mut items: Slice<models.Issue> = []
      for i in 0..200 { items = items.append(models.Issue { id: f"p1-{i}", .. }) }
      seen_pages = seen_pages.append("one")
      return Ok(BoardPage { items, .. })
    }
    assert path.contains("page=2&")
    seen_pages = seen_pages.append("two")
    Ok(BoardPage { items: [models.Issue { id: "p2-0", .. }], .. })
  })
  let Ok(issues) = result else { panic("paged column fetch failed") };
  assert issues.length() == 201
  assert issues[199].id == "p1-199"
  assert issues[200].id == "p2-0"
  assert seen_pages.length() == 2
}

#[test]
fn column_fetch_accepts_an_empty_column() {
  let result = collect_column_issues("team", "blocked", |_path| Ok(BoardPage { .. }))
  let Ok(issues) = result else { panic("empty column failed") };
  assert issues.is_empty()
}
