import "go:net/url"
import "go:strings"
import "config"
import "models"
import "pb"
import "query"

/// Resolve one team's project by name; unknown names error with the fix.
/// Names are unique within a team, not across them (TASK-173), so `team_id`
/// must name a team, as resolve_label's must (LLL-671). A read that spans
/// every team goes through project_ids.
pub fn resolve_project(team_id: string, name: string) -> Result<models.Project, string> {
  if team_id == "" { return Err(f"internal: resolve_project('{name}') without a team") }
  let filter = url.QueryEscape(query.scoped(team_id, "name", name))
  let mut result = models.ProjectList { .. }
  pb.fetch(
    f"/api/collections/projects/records?filter={filter}&expand=team",
    "projects",
    &result,
  )?
  let Some(p) = result.items.find(|p| p.name == name) else {
    // Four of thirty fleet agents passed the TEAM key here: the team scopes
    // the command already, so the flag they wanted was no flag at all.
    let team_key = config.load()?.team
    if team_key != "" && strings.EqualFold(name, team_key) {
      return Err(f"'{name}' is the team, not a project — the team scopes every command already, so drop --project, or pick one from 'lll project list'")
    }
    return Err(f"no project named '{name}' — see 'lll project list'")
  }
  Ok(p)
}

/// The ids of every project named `name` within `scope`, for a list filter,
/// as label_ids does for labels (LLL-671).
pub fn project_ids(scope: TeamScope, name: string) -> Result<Slice<string>, string> {
  match scope {
    TeamScope.Only(team_id) => Ok([resolve_project(team_id, name)?.id]),
    TeamScope.Every => {
      let filter = url.QueryEscape(f"name={query.quote(name)}")
      let found = fetch_all_records<models.Project>(f"/api/collections/projects/records?sort=id&filter={filter}", "projects")?
      let ids = found.filter(|p| p.name == name).map(|p| p.id)
      if ids.is_empty() { return Err(f"no project named '{name}' — see 'lll project list'") }
      Ok(ids)
    },
  }
}

/// One team's projects, scoped for the same reason labels are.
pub fn fetch_projects(team_id: string) -> Result<Slice<models.Project>, string> {
  fetch_all_records<models.Project>(
    f"/api/collections/projects/records?sort=name,id&expand=team&filter={team_param(team_id)}",
    "projects",
  )
}
