import "go:encoding/json"
import "go:net/url"
import "go:regexp"
import "go:strings"
import "models"
import "pb"
import "query"
import "flags"

/// A team key as it is stored: uppercase, trimmed (LLL-235).
///
/// One rule, applied at every boundary rather than in each verb. Keys were
/// stored as typed, so 'eng' and 'ENG' were two teams the unique index was
/// happy with and prose could not tell apart, while the derived issue key,
/// the rail and the docs all assumed uppercase. gopb enforces the same
/// normalisation on write, so a key reaching the database any other way
/// obeys it too; this is what makes READS agree - `LLL_TEAM=eng` finds ENG
/// rather than failing to.
pub fn normalize_team_key(key: string) -> string {
  strings.ToUpper(strings.TrimSpace(key))
}

/// Why `key` (already normalised) cannot be a team key, or None when it can
/// (LLL-628). The server enforces the same pattern on create and on a key
/// change; checking first means `lll attach` refuses before it writes
/// .lll.toml, and the message names the rule rather than a raw 400.
pub fn team_key_problem(key: string) -> Option<string> {
  if regexp.MustCompile("^[A-Z][A-Z0-9_-]{0,15}$").MatchString(key) {
    return None
  }
  Some(
    "a team key is a letter followed by up to 15 letters, digits, '_' or '-' (^[A-Z][A-Z0-9_-]{0,15}$ after uppercasing), e.g. ENG or WEB-2",
  )
}

pub fn find_team(ctx: pb.Client, key: string) -> Result<Option<models.Team>, pb.CliError> {
  let wanted = normalize_team_key(key)
  let filter = url.QueryEscape(f"key={query.quote(wanted)}")
  let mut result = models.TeamList { .. }
  pb.fetch(ctx, f"/api/collections/teams/records?filter={filter}", "teams", &result)?
  Ok(result.items.find(|t| t.key == wanted))
}

/// find_team, riding `tok` instead of the configured token: `lll bot` asks
/// whether the credential that will own the bot can see the team it names.
pub fn find_team_as(
  ctx: pb.Client,
  tok: string,
  key: string,
) -> Result<Option<models.Team>, pb.CliError> {
  let wanted = normalize_team_key(key)
  let filter = url.QueryEscape(f"key={query.quote(wanted)}")
  let body = ctx.get_as(f"/api/collections/teams/records?filter={filter}", tok)?
  let mut result = models.TeamList { .. }
  if let Err(e) = json.Unmarshal(body.bytes(), &result) {
    return Err(pb.failed(f"decoding teams: {e}"))
  }
  Ok(result.items.find(|t| t.key == wanted))
}

/// Every team, key-sorted. Shared by `lll team list` and `lll up`.
pub fn list_teams(ctx: pb.Client) -> Result<models.TeamList, pb.CliError> {
  let items = fetch_all_records<models.Team>(ctx, "/api/collections/teams/records?sort=key,id", "teams")?
  Ok(models.TeamList { items })
}

/// The team `LLL_TEAM` (or `team` in .lll.toml) names, or None when no key
/// is set. A key naming a team the server does not have is an error either
/// way — silently falling back to "every team" is how a scoped command ends
/// up answering for all of them.
pub fn configured_team(ctx: pb.Client) -> Result<Option<models.Team>, pb.CliError> {
  let (cfg, src) = ctx.settings.traced().map_err(pb.failed)?
  if cfg.team == "" { return Ok(None) }
  let Some(t) = find_team(ctx, cfg.team)? else {
    return Err(unknown_configured_team(ctx, cfg.team, src.team))
  }
  Ok(Some(t))
}

/// unknown_team, for the CONFIGURED key: says where the key came from. A
/// fleet agent (TASK-309, task 4) ran `lll` from inside a checkout whose
/// committed .lll.toml said team = LLL, against a server with no such team,
/// and got "no team with key 'LLL'" - true, and useless, because it had never
/// typed LLL and did not know which file had. `config list` knows; so does
/// this message now.
pub fn unknown_configured_team(ctx: pb.Client, key: string, origin: string) -> pb.CliError {
  if let Some(scoped) = unknown_team_scoped(ctx, key) { return scoped }
  let from = if origin == "flag:--team" {
    " (from --team)"
  } else if strings.HasPrefix(origin, "env:") {
    f" (from {strings.TrimPrefix(origin, "env:")})"
  } else if strings.HasPrefix(origin, "file:") {
    f" (from {strings.TrimPrefix(origin, "file:")})"
  } else {
    ""
  }
  pb.fail(pb.ErrorKind.NotFound, f"no team with key '{key}'{from} on the server. 'lll team list' shows the keys; 'lll attach --key KEY' points this directory at one, 'lll config list' shows every value and the file it came from, or create it with 'lll team create {key} -n \"Name\"'")
}

/// Missing-team message naming the fix. Shared by every command that needs a
/// team and was given none (same package: src/commands).
pub fn no_team() -> pb.CliError {
  // Names the command, not just the file. Every usability run read the old
  // wording as "go hand-edit a file", and none of them found 'lll attach' —
  // the command whose whole job is writing this key — from it. It follows
  // unknown_team's shape for the same reason: say the fix, not the setting.
  //
  // Usage, exit 2 (LLL-679): the fix is on the command line or in the
  // configuration that stands in for it, not on the server.
  flags.usage_error("no team configured: pass --team KEY for this command, or run 'lll attach' to write the team to .lll.toml
'lll team list' shows the keys; 'lll attach --key KEY' takes one directly")
}

/// Unknown-team message naming the fix. Shared by every command that
/// resolves a team key (same package: src/commands).
pub fn unknown_team(ctx: pb.Client, key: string) -> pb.CliError {
  if let Some(scoped) = unknown_team_scoped(ctx, key) { return scoped }
  pb.fail(pb.ErrorKind.NotFound, f"no team with key '{key}' on the server. First inspect 'lll team list --archived'; the team may have been renamed.\nFor an existing team, use 'lll attach --key EXISTING_KEY' to update the attachment, or prefix one command with LLL_TEAM=EXISTING_KEY.\nOnly if you intend a new team, create it with 'lll team create {key} -n \"Name\"'.")
}

/// For a team-scoped caller, a missing key usually means "not yours", and
/// 'lll team create' is a dead end it cannot run (fleet case 03). The wording
/// does not say whether the team exists.
pub fn unknown_team_scoped(ctx: pb.Client, key: string) -> Option<pb.CliError> {
  let Some(keys) = scoped_team_keys(ctx) else { return None }
  let mine = if keys.is_empty() { "none" } else { strings.Join(keys, ", ") }
  Some(
    pb.fail(pb.ErrorKind.NotFound, f"no team '{key}' among the teams you can see ({mine}). 'lll whoami' shows your access; ask the person who invited you if you need another team."),
  )
}

/// Archived-team refusal naming the fix. Shared by everything that refuses
/// to write into an archived team (same package: src/commands): the CLI's
/// attach and issue create, and the web board's write endpoints.
pub fn archived_hint(key: string) -> string {
  f"team {key} is archived; run 'lll team unarchive {key}' first"
}

/// A team that is not archived (TASK-210): what a write that lands in a
/// team is handed, so it cannot forget to ask. Only active_team makes one.
pub struct WritableTeam {
  active: models.Team,
}

impl WritableTeam {
  pub fn team(self) -> models.Team { self.active }
  pub fn id(self) -> models.TeamId { self.active.id }
}

/// `t`, if writes may land in it; the archived refusal otherwise.
pub fn active_team(t: models.Team) -> Result<WritableTeam, pb.CliError> {
  if t.archived { return Err(pb.failed(archived_hint(t.key))) }
  Ok(WritableTeam { active: t })
}

/// An issue in a team that is not archived: what an issue edit is handed.
/// Only active_issue makes one, from an issue read with its team expanded.
pub struct WritableIssue {
  active: models.Issue,
}

impl WritableIssue {
  pub fn issue(self) -> models.Issue { self.active }
}

/// `issue`, if its team takes writes; the archived refusal otherwise.
pub fn active_issue(issue: models.Issue) -> Result<WritableIssue, pb.CliError> {
  let _ = active_team(issue.expand.team)?
  Ok(WritableIssue { active: issue })
}
