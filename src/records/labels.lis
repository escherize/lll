import "go:net/url"
import "go:strings"
import "models"
import "pb"
import "query"

/// Resolve one team's label by name; unknown names error with the fix.
///
/// Names are unique within a team, not across them (TASK-173): two projects
/// may both call something "bug", and attaching one team's to the other
/// team's issue is the leak team scoping exists to stop. So `team_id` must
/// name a team. "" once meant "every team" here, and a writer acted on
/// whichever team's label came back first (LLL-671); a read that spans every
/// team goes through label_ids instead.
pub fn resolve_label(ctx: pb.Client, team_id: models.TeamId, name: string) -> Result<models.Label, pb.CliError> {
  let filter = url.QueryEscape(query.scoped(team_id, "name", name))
  let mut result = models.LabelList { .. }
  pb.fetch(ctx, f"/api/collections/labels/records?filter={filter}", "labels", &result)?
  let Some(l) = result.items.find(|l| l.name == name) else {
    return Err(pb.fail(pb.ErrorKind.NotFound, f"no label named '{name}'; see 'lll label list'"))
  }
  Ok(l)
}

/// The ids of every label named `name` within `scope`, for a list filter.
/// One team holds at most one. Every team may hold several, and a filter
/// that kept only the first answered for one team (LLL-671).
pub fn label_ids(ctx: pb.Client, scope: query.TeamScope, name: string) -> Result<Slice<models.LabelId>, pb.CliError> {
  match scope {
    query.TeamScope.Only(team_id) => Ok([resolve_label(ctx, team_id, name)?.id]),
    query.TeamScope.Every => {
      let filter = url.QueryEscape(f"name={query.quote(name)}")
      let found = fetch_all_records<models.Label>(ctx, f"/api/collections/labels/records?sort=id&filter={filter}", "labels")?
      let ids = found.filter(|l| l.name == name).map(|l| l.id)
      if ids.is_empty() { return Err(pb.failed(f"no label named '{name}'; see 'lll label list'")) }
      Ok(ids)
    },
  }
}

/// The names among `names` that more than one team the caller can see uses
/// (fleet case 12): 'Labels: bug' alone does not say whose bug.
pub fn shared_label_names(ctx: pb.Client, names: Slice<string>) -> Result<Slice<string>, pb.CliError> {
  if names.is_empty() { return Ok([]) }
  let filter = url.QueryEscape(strings.Join(names.map(|n| f"name={query.quote(n)}"), " || "))
  let found = fetch_all_records<models.Label>(ctx, f"/api/collections/labels/records?sort=id&fields=id,name,team&filter={filter}", "labels")?
  Ok(names.filter(|n| found.filter(|l| l.name == n).length() > 1))
}

/// One team's labels. Labels belong to exactly one team (TASK-173), so
/// every chooser, chip list and validator built on this is scoped by
/// construction. query.TeamScope.Every spans every team: `lll label list`
/// with no team configured.
pub fn fetch_labels(ctx: pb.Client, scope: query.TeamScope) -> Result<Slice<models.Label>, pb.CliError> {
  fetch_all_records<models.Label>(ctx,
    f"/api/collections/labels/records?sort=name,id&expand=team&filter={team_param(scope)}",
    "labels",
  )
}
