import "go:net/url"

import "models"
import "pb"
import "query"

/// A team-owned record that issues point at: what deleting it drops from
/// issues, and what moving it must not strand (LLL-675).
pub enum Classifier {
  Label(models.LabelId),
  Project(models.ProjectId),
}

impl Classifier {
  /// "label" or "project", for messages.
  pub fn noun(self) -> string {
    match self {
      Classifier.Label(_) => "label",
      Classifier.Project(_) => "project",
    }
  }

  /// Every issue, in any team, that carries it.
  pub fn issues(self) -> query.IssueFilter {
    let every = query.IssueFilter.over(query.TeamScope.Every)
    match self {
      Classifier.Label(id) => query.IssueFilter { labels: [id], ..every },
      Classifier.Project(id) => query.IssueFilter { projects: [id], ..every },
    }
  }
}

/// Count every issue affected by removing one shared classification record.
/// CLI deletion, web review and label inventory use the same relation filters.
pub fn entity_issue_count(ctx: pb.Client, of: Classifier) -> Result<int, pb.CliError> {
  issue_count(ctx, query.filter(of.issues()))
}

/// How many issues match a filter. perPage=1 so PocketBase answers the count
/// without a page of 
///
/// The one copy: team delete, team view, the settings team inventory and the
/// projects page all counted issues by spelling this request out again, four
/// times, one of them twice. Takes the filter UNESCAPED and escapes it here,
/// so no caller has to remember which side of the escape it is on.
pub fn issue_count(ctx: pb.Client, filter: string) -> Result<int, pb.CliError> {
  let mut list = models.IssueList { .. }
  pb.fetch(
    ctx,
    f"/api/collections/issues/records?perPage=1&fields=id&filter={url.QueryEscape(filter)}",
    "issues",
    &list,
  )?
  Ok(list.total_items)
}
