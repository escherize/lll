import "go:fmt"
import "go:os"
import "go:os/exec"
import "go:path/filepath"
import "go:time"

// Unit cover for TASK-214's pure halves in token.lis: the expiry line printed
// under a mint, and the refusal classifier. Both are functions of their
// arguments alone — expiry_line takes `now` precisely so this suite can pin a
// date instead of racing the clock.

// ------------------------------------------------------------ expiry_line

fn at_noon() -> time.Time {
  time.Date(2026, time.January, 15, 12, 0, 0, 0, time.UTC)
}

#[test]
fn expiry_line_dates_the_default_year_out() {
  let line = expiry_line(default_token_duration(), at_noon())
  assert line.contains("expires 2027-01-15")
  assert line.contains("lll token create")
}

#[test]
fn expiry_line_dates_a_short_duration() {
  // An hour still lands on the same day; the seconds are what disambiguate.
  let line = expiry_line(3600, at_noon())
  assert line.contains("expires 2026-01-15")
  assert line.contains("3600s from now")
}

#[test]
fn expiry_line_refuses_to_guess_for_the_collection_default() {
  let line = expiry_line(0, at_noon())
  assert !line.contains("2026-")
  assert line.contains("--duration")
}

#[test]
fn default_token_duration_is_a_year_of_seconds() {
  assert default_token_duration() == 31536000
}

// ------------------------------------------------------- impersonate_error

#[test]
fn a_401_blames_expiry_and_names_the_re_mint() {
  let msg = impersonate_error("bryan", "POST http://h/api/...: 401 Unauthorized: {}")
  assert msg.contains("expired")
  assert msg.contains("lll token create")
}

#[test]
fn a_403_still_names_the_superuser_gate() {
  let msg = impersonate_error("bryan", "POST http://h/api/...: 403 Forbidden: {}")
  assert msg.contains("superuser-only")
  assert msg.contains("LLL_ADMIN_EMAIL")
  // 403 is authenticated-but-unauthorized; blaming expiry here would send a
  // member off to re-mint a token that was never the problem.
  assert !msg.contains("expired")
}

#[test]
fn any_other_failure_keeps_the_raw_error() {
  let msg = impersonate_error("bryan", "POST http://h/api/...: 500 Internal Server Error: {}")
  assert msg.contains("impersonating bryan")
  assert msg.contains("500")
}

#[test]
fn status_classification_ignores_url_and_body_digits() {
  let forbidden = impersonate_error("bryan", "POST http://127.0.0.1:34015/api/401: 403 Forbidden: {}")
  assert forbidden.contains("superuser-only")
  assert !forbidden.contains("expired")
  let unauthorized = impersonate_error("bryan", "POST http://127.0.0.1:34035/api/403: 401 Unauthorized: {}")
  assert unauthorized.contains("expired")
  let failed = impersonate_error("bryan", "POST http://127.0.0.1:34015/api/403: 500 Internal Server Error: previous status: 401 Unauthorized")
  assert failed.contains("impersonating bryan")
  assert failed.contains("500 Internal Server Error")
}

// ------------------------------------------------------------ agent prompt (LLL-546)

#[test]
fn agent_prompt_is_the_design_doc_prompt() {
  let got = agent_prompt("https://lll.example.com", "ALPHA", "aaa.bbb-c_d.eee")
  // The doc's text, reshaped into a script every shell runs harmlessly
  // (LLL-546 F1): prose is the no-op `:` with one quoted word, never `#`.
  let want = ": 'You are joining lll team ALPHA at https://lll.example.com.'
export LLL_URL=https://lll.example.com
export LLL_TOKEN=aaa.bbb-c_d.eee
lll attach -k ALPHA
: 'Read the workflow:'
lll skill get software-factory
: 'Claim an issue before you edit code; record findings on the board.'
"
  assert got == want
  assert !got.contains("#")
}

/// The shells a pasted prompt meets. Interactive zsh without
/// interactive_comments (the macOS default) runs `#` lines as commands, so
/// it is the case that matters most; zsh rows are skipped, saying so, only
/// where zsh is not installed.
fn prompt_shells() -> Slice<Slice<string>> {
  let mut shells = [
    ["/bin/sh", "prompt.txt"],
    ["/bin/sh", "-c", "exec bash --norc --noprofile -i < prompt.txt"],
  ]
  if exec.LookPath("zsh").is_ok() {
    shells = shells.append(["/bin/sh", "-c", "exec zsh -f prompt.txt"])
    shells = shells.append(["/bin/sh", "-c", "exec zsh -f -i < prompt.txt"])
  } else {
    fmt.Println("token.test: zsh not installed here; skipping the zsh prompt shells")
  }
  shells
}

/// Run the WHOLE prompt through `shell` in a fresh directory whose only
/// `lll` is a stub logging its arguments, one per line. Returns the
/// directory's entries and the stub's log.
fn run_prompt_in(t: TestContext, shell: Slice<string>, url: string, team: string) -> (Slice<string>, string) {
  let assert Ok(dir) = os.MkdirTemp("", "lll-prompt-sh")
  let bin = filepath.Join(dir, "bin")
  let assert Ok(_) = os.Mkdir(bin, 0o755)
  let stub = "#!/bin/sh\nfor a in \"$@\"; do printf '%s\\n' \"$a\" >> \"$PROMPT_LOG\"; done\n"
  let assert Ok(_) = os.WriteFile(filepath.Join(bin, "lll"), stub.bytes(), 0o755)
  let prompt = agent_prompt(url, team, "aaa.bbb.ccc")
  let assert Ok(_) = os.WriteFile(filepath.Join(dir, "prompt.txt"), prompt.bytes(), 0o644)
  let mut cmd = exec.Command(shell[0], shell[1..]...)
  cmd.Dir = dir
  cmd.Env = [f"PATH={bin}:/usr/bin:/bin:/usr/local/bin:/opt/homebrew/bin", f"PROMPT_LOG={dir}/args.log", f"HOME={dir}", "HISTFILE=/dev/null"]
  let _ = cmd.Run()
  let assert Ok(entries) = os.ReadDir(dir)
  let names = entries.map(|e| e.Name())
  let log = os.ReadFile(filepath.Join(dir, "args.log")).map_or("", |b| b as string)
  let _ = os.RemoveAll(dir)
  (names, log)
}

#[test]
fn the_whole_prompt_is_a_harmless_shell_script_for_hostile_values(t: TestContext) {
  // Review repros: a ' in the url or key closing a quote, and interactive
  // zsh expanding `$(..)`, `$=IFS` and backticks on a `#` line.
  let urls = [
    "http://x'$(touch$IFS.pwned)@127.0.0.1:1",
    "http://$(touch$=IFS'PWNED-e2e')@127.0.0.1:1",
    "http://x/`touch .pwned`",
    "http://x/\ntouch .pwned\n",
    "http://x/'\ntouch .pwned #",
    "http://x/!!;touch .pwned",
  ]
  let teams = ["Q'$(touch$IFS.PWNTEAM)", "Q$(touch$=IFS'PWNTEAM')", "Q`touch .PWNTEAM`", "Q\ntouch .PWNTEAM", "ALPHA"]
  for shell in prompt_shells() {
    for url in urls {
      for team in teams {
        let (names, log) = run_prompt_in(t, shell, url, team)
        assert names.equals(["args.log", "bin", "prompt.txt"])
        // The stub saw exactly the two intended commands, each value whole.
        assert log == f"attach\n-k\n{team}\nskill\nget\nsoftware-factory\n"
      }
    }
  }
}

#[test]
fn agent_env_is_only_the_two_export_lines() {
  let got = agent_env("http://127.0.0.1:8090", "aaa.bbb.ccc")
  assert got == "export LLL_URL=http://127.0.0.1:8090\nexport LLL_TOKEN=aaa.bbb.ccc\n"
}

#[test]
fn shell_word_quotes_anything_a_shell_would_interpret() {
  assert shell_word("https://h.example:8090/x") == "https://h.example:8090/x"
  // A url from LLL_URL is pasted into the agent's shell: no command
  // substitution, word splitting or quote breakout survives it.
  assert shell_word("http://h/$(touch pwned)") == "'http://h/$(touch pwned)'"
  assert shell_word("http://h/a b") == "'http://h/a b'"
  assert shell_word("http://h/x';id;'") == "'http://h/x'\\'';id;'\\'''"
  assert shell_word("") == "''"
  let prompt = agent_prompt("http://h/`id`", "ALPHA", "t")
  assert prompt.contains("export LLL_URL='http://h/`id`'\n")
}
