import "attachments"
import "flags"
import "pb"
import "records"
import "go:fmt"
import "go:os"

fn issue_attach(input: flags.CommandInput) -> Result<(), pb.CliError> {
  let ctx = input.ctx
  let issue = records.fetch_issue(ctx, deslug(input.parsed.first()))?
  let path = input.parsed.nth(1)
  let file = match os.Open(path) {
    Ok(file) => file,
    Err(e) => return Err(pb.failed(f"opening attachment: {e}")),
  }
  defer file.Close()
  let data = attachments.read_upload(file)?
  let name = attachments.upload(ctx, pb.Caller.Process, issue, path, data)?
  let key = f"{issue.expand.team.key}-{issue.number}"
  issue_done(ctx, input.parsed, key, f"Attached to {key}: {name}")
}

fn issue_detach(input: flags.CommandInput) -> Result<(), pb.CliError> {
  let ctx = input.ctx
  let issue = records.fetch_issue(ctx, deslug(input.parsed.first()))?
  let name = input.parsed.nth(1)
  attachments.remove(ctx, pb.Caller.Process, issue, name)?
  issue_done(ctx, input.parsed, f"{issue.expand.team.key}-{issue.number}", f"Removed attachment from {input.parsed.first()}: {name}")
}

fn issue_download(input: flags.CommandInput) -> Result<(), pb.CliError> {
  let ctx = input.ctx
  let issue = records.fetch_issue(ctx, deslug(input.parsed.first()))?
  let data = attachments.read_file(ctx, issue, input.parsed.nth(1))?
  let Partial.Ok(_) = os.Stdout.Write(data.bytes()) else { return Err(pb.failed("writing attachment to stdout failed")) }
  Ok(())
}
