import "go:strings"
import "config"

// Unit cover for the whoami argument refusal (LLL-493, fleet case 05). The
// server half of whoami needs a live PocketBase and is covered by e2e; what
// is asserted here is the text a fresh agent reads when it guesses a flag
// that does not exist: the refusal must teach the bare invocation that DOES
// report context, plus the house one-command override for another team.

#[test]
fn team_argument_refusal_teaches_the_bare_invocation_and_the_override() {
  let msg = whoami_arg_error("--team", ["lll", "whoami", "--team", "FLEET"])
  assert strings.Contains(msg, "unknown whoami argument: '--team'")
  assert strings.Contains(msg, "takes no flags")
  assert strings.Contains(msg, "LLL_TEAM=FLEET")
  assert strings.Contains(msg, "saved attachment unchanged")
}

#[test]
fn inline_team_value_and_missing_value_both_name_a_key() {
  assert whoami_arg_error("--team=OPS", ["lll", "whoami", "--team=OPS"]).contains(
    "LLL_TEAM=OPS",
  )
  assert whoami_arg_error("--team", ["lll", "whoami", "--team"]).contains(
    "LLL_TEAM=KEY",
  )
  assert whoami_arg_error("--team=", ["lll", "whoami", "--team="]).contains(
    "LLL_TEAM=KEY",
  )
}

#[test]
fn other_unknown_arguments_keep_the_short_refusal() {
  let msg = whoami_arg_error("--json", ["lll", "whoami", "--json"])
  assert strings.Contains(msg, "unknown whoami argument: '--json'")
  assert !strings.Contains(msg, "LLL_TEAM=")
}

// LLL-441 review: the refresh carries the saved login token, so it may only
// go to the server the home config names. An LLL_URL or a repo url pointing
// elsewhere would hand the token over and save the stranger's answer.
#[test]
fn login_renewal_needs_the_home_token_and_the_home_url() {
  let file = Some(config.Source.HomeFile("/h/lll/lll.toml"))
  let saved = "https://lll.example"
  assert renews_home_login(config.Sources { token: file, url: file, .. }, saved, saved)
  // url is the default and the home config names none
  assert renews_home_login(config.Sources { token: file, url: Some(config.Source.Default), .. }, "", "http://127.0.0.1:8090")
  // the token is not the home login: never renewed, whatever the url
  assert !renews_home_login(config.Sources { token: Some(config.Source.Env("LLL_TOKEN")), url: file, .. }, saved, saved)
  assert !renews_home_login(config.Sources { token: Some(config.Source.RepoFile("/repo/.lll.toml")), url: file, .. }, saved, saved)
}

// LLL-653: automation sets LLL_URL on every call. When it names exactly the
// home config's url the token goes to the server that issued it, so renew.
#[test]
fn login_renewal_follows_an_lll_url_equal_to_the_home_url() {
  let file = Some(config.Source.HomeFile("/h/lll/lll.toml"))
  let saved = "https://lll.example"
  assert renews_home_login(config.Sources { token: file, url: Some(config.Source.Env("LLL_URL")), .. }, saved, saved)
}

// LLL-653 keeps the LLL-441 review's rule: any other url, however close,
// never receives the saved login. The match is byte-exact, so no
// normalisation can widen it.
#[test]
fn login_renewal_refuses_every_url_that_is_not_byte_equal_to_the_home_url() {
  let file = Some(config.Source.HomeFile("/h/lll/lll.toml"))
  let saved = "http://127.0.0.1:8090"
  let near_misses = [
    "https://other.example",
    "http://127.0.0.1:8090/",
    "HTTP://127.0.0.1:8090",
    "http://localhost:8090",
    "http://127.0.0.1:8091",
    "http://127.0.0.1:8090/proxy",
    "http://127.0.0.1:8090.evil.example",
    "http://127.0.0.1:8090@evil.example",
    "https://127.0.0.1:8090",
    " http://127.0.0.1:8090",
  ]
  for url in near_misses {
    for from in [Some(config.Source.Env("LLL_URL")), Some(config.Source.RepoFile("/repo/.lll.toml"))] {
      assert !renews_home_login(config.Sources { token: file, url: from, .. }, saved, url)
    }
  }
  // no saved url: only the default is the home config's server
  assert !renews_home_login(config.Sources { token: file, url: Some(config.Source.Env("LLL_URL")), .. }, "", "https://other.example")
}

#[test]
fn renewal_and_the_skew_probe_stay_off_the_network_for_local_nouns() {
  assert talks_to_server("issue")
  assert talks_to_server("whoami")
  for noun in ["--help", "version", "completions", "skill", "upgrade", "login", "logout"] {
    assert !talks_to_server(noun)
  }
}

// LLL-680: a login without --url saves into the home config, so it refuses
// when LLL_URL or a repo file points it at a server other than the one that
// file's url names.
#[test]
fn login_refuses_to_save_beside_another_servers_url() {
  let hosted = "https://lll.example.com"
  let local = "http://127.0.0.1:8090"
  assert login_target_conflict("", hosted, hosted).is_none()
  assert login_target_conflict("", hosted + "/", hosted).is_none()
  assert login_target_conflict("", "", local).is_none()
  assert login_target_conflict("", "http://localhost:8090", local).is_none()
  // --url names the server, and saves its url too.
  assert login_target_conflict(local, hosted, local).is_none()
  let why = login_target_conflict("", hosted, local).unwrap_or("")
  assert why.contains("lll login --url http://127.0.0.1:8090")
  assert why.contains("LLL_CONFIG_HOME")
}

// LLL-688: a login fixes its server before it holds a token, and everything
// it sends with that token goes there. A repo file or LLL_URL naming another
// server is named in a notice, never followed.
#[test]
fn login_plan_keeps_the_target_whatever_outranks_the_home_url() {
  let repo = Some(config.Source.RepoFile("/repo/.lll.toml"))
  let a = "http://127.0.0.1:8100"
  let b = "https://hostile.example"
  let plan = plan_login(a, b, repo)
  assert plan.server == a
  let Some(notice) = plan.shadowed else { panic("expected a notice") };
  assert notice.contains("/repo/.lll.toml sets url = https://hostile.example")
  assert notice.contains(f"not to {a}")
  let env = plan_login(a, b, Some(config.Source.Env("LLL_URL")))
  assert env.server == a
  assert env.shadowed.map_or(false, |n| n.contains("unset LLL_URL"))
}

#[test]
fn login_plan_without_a_target_rides_the_effective_url() {
  let repo = Some(config.Source.RepoFile("/repo/.lll.toml"))
  let plan = plan_login("", "https://lll.example", repo)
  assert plan.server == "https://lll.example"
  assert plan.shadowed.is_none()
}

#[test]
fn login_plan_owes_no_notice_when_the_home_config_decides() {
  let a = "http://127.0.0.1:8100"
  let home = Some(config.Source.HomeFile("/h/lll/lll.toml"))
  // The login rewrites the home url, so later commands follow it.
  assert plan_login(a, "https://old.example", home).shadowed.is_none()
  assert plan_login(a, "http://127.0.0.1:8090", Some(config.Source.Default)).shadowed.is_none()
  assert plan_login(a, "", None).shadowed.is_none()
  // A repo url naming the same server is no shadow.
  assert plan_login(a, "http://localhost:8100/", Some(config.Source.RepoFile("/r/.lll.toml"))).shadowed.is_none()
}

// LLL-688: a password or pasted token goes only to a server the user named.
#[test]
fn a_login_without_url_refuses_a_url_a_repo_or_the_environment_chose() {
  let repo = Some(config.Source.RepoFile("/r/.lll.toml"))
  let b = "http://127.0.0.1:9999"
  let Some(why) = login_needs_url("", b, repo, "") else { panic("expected a refusal") };
  assert why.contains("/r/.lll.toml sets url = http://127.0.0.1:9999")
  assert why.contains("lll login --url http://127.0.0.1:9999")
  assert login_needs_url("", b, Some(config.Source.Env("LLL_URL")), "").is_some()
  // --url names it; the home config chose the same url; the home url or default.
  assert login_needs_url(b, b, repo, "").is_none()
  assert login_needs_url("", b, repo, b).is_none()
  assert login_needs_url("", b, Some(config.Source.HomeFile("/h/lll.toml")), b).is_none()
  assert login_needs_url("", "http://127.0.0.1:8090", Some(config.Source.Default), "").is_none()
}
