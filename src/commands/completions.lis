import "go:fmt"
import "go:strings"

import "flags"

// `lll completions <shell>` — static completion scripts, all generated from
// the one command table below (nouns, verbs per noun, flags per verb).

pub fn completions(args: Slice<string>) -> Result<(), string> {
  let parsed = flags.parse([], args, 2, true, completions_usage())?
  let shell = parsed.first()
  if shell == "" {
    fmt.Println(completions_usage())
    return Ok(())
  }
  match shell {
    "bash" => {
      fmt.Print(bash_script())
      Ok(())
    },
    "zsh" => {
      fmt.Print(zsh_script())
      Ok(())
    },
    "fish" => {
      fmt.Print(fish_script())
      Ok(())
    },
    other => Err(f"unknown shell: '{other}' (expected bash, zsh, or fish)"),
  }
}

fn completions_usage() -> string {
  "lll completions - shell completion scripts

Usage:
  lll completions bash    add to ~/.bashrc:   eval \"$(lll completions bash)\"
  lll completions zsh     add to ~/.zshrc     eval \"$(lll completions zsh)\"
                          (after compinit)
  lll completions fish    add to ~/.config/fish/config.fish:
                          lll completions fish | source

Completes nouns, verbs per noun, and flags per verb."
}

// --- command table ---

fn nouns() -> Slice<string> {
  [
    "issue",
    "search",
    "bot",
    "team",
    "member",
    "project",
    "label",
    "api",
    "doc",
    "finding",
    "config",
    "import",
    "export",
    "attach",
    "watch",
    "up",
    "board",
    "login",
    "logout",
    "token",
    "webhook",
    "skill",
    "completions",
    "whoami",
    "help",
    "--version",
    "-v",
  ]
}

fn command_table(noun: string) -> Slice<flags.Command> {
  match noun {
    "issue" => issue_commands(),
    "team" => team_commands(),
    "member" => member_commands(),
    "project" => project_commands(),
    "label" => label_commands(),
    "doc" => doc_commands(),
    "finding" => finding_commands(),
    "config" => config_commands(),
    "import" => import_commands(),
    "token" => token_commands(),
    "webhook" => webhook_commands(),
    _ => [],
  }
}

fn verbs(noun: string) -> Slice<string> {
  let table = command_table(noun)
  if !table.is_empty() { return flags.command_names(table) }
  // TASK-307: every noun with a Command table is read FROM it, so a verb
  // added to a table is completed with no edit here. This was a fourth
  // hand-kept list of the same verbs, and it drifted twice in one wave.
  match noun {
    "bot" => ["rotate"],
    "skill" => ["list", "get"],
    "completions" => ["bash", "zsh", "fish"],
    _ => [],
  }
}

/// Flags for a noun-verb pair, read from the verb's OWN flag table (the
/// `*_verb_spec` accessors) through flags.tokens() — the same table the
/// parser, help and completions read, so the three cannot drift (TASK-127).
/// Every spelling is offered: completions teach what the parser accepts.
fn verb_flags(noun: string, verb: string) -> Slice<string> {
  // A table noun's flags come off the same Command entry its verb name did,
  // so the *_verb_spec accessors (one more hand-kept match per noun) retire.
  // The verb-less nouns keep their single spec fn: they have no table.
  let table = command_table(noun)
  if !table.is_empty() {
    let Some(c) = flags.resolve_command(table, verb) else { return [] }
    return flags.tokens(c.spec)
  }
  match noun {
    "search" => flags.tokens(search_spec()),
    "bot" => flags.tokens(token_create_spec()),
    "watch" => flags.tokens(watch_spec()),
    "up" => flags.tokens(up_spec()),
    "attach" => flags.tokens(attach_spec()),
    "board" => flags.tokens(board_spec()),
    "login" => flags.tokens(login_spec()),
    "api" => flags.tokens(api_spec()),
    _ => [],
  }
}

/// Flags for verb-less nouns: the noun itself is the verb.
fn noun_flags(noun: string) -> Slice<string> {
  verb_flags(noun, "")
}

// --- emitters ---

/// The two case-based shells share candidate collection and ordering;
/// each supplies only its assignment syntax.
fn shell_cases(assignment: fn(string) -> string) -> (string, string) {
  let mut verb_cases = ""
  let mut flag_cases = ""
  for n in nouns() {
    let vs = verbs(n)
    let own = noun_flags(n)
    let candidates = vs.append(own...)
    if !candidates.is_empty() {
      let ws = strings.Join(candidates, " ")
      verb_cases += f"      {n}) {assignment(ws)} ;;\n"
    }
    if !own.is_empty() {
      let ws = strings.Join(own, " ")
      flag_cases += f"      {n},*) {assignment(ws)} ;;\n"
    }
    for v in vs {
      let fs = verb_flags(n, v)
      if !fs.is_empty() {
        let ws = strings.Join(fs, " ")
        flag_cases += f"      {n},{v}) {assignment(ws)} ;;\n"
      }
    }
  }
  (verb_cases, flag_cases)
}

fn bash_script() -> string {
  let (verb_cases, flag_cases) = shell_cases(|words| f"words='{words}'")
  let all_nouns = strings.Join(nouns(), " ")
  "# lll bash completions
# Add to ~/.bashrc:  eval \"$(lll completions bash)\"
_lll() {
  local cur=${COMP_WORDS[COMP_CWORD]}
  local noun=${COMP_WORDS[1]-}
  local verb=${COMP_WORDS[2]-}
  local words=
  if [ $COMP_CWORD -eq 1 ]; then
    words='" +
  all_nouns +
  "'
  elif [ $COMP_CWORD -eq 2 ]; then
    case $noun in
" +
  verb_cases +
  "    esac
  else
    case $noun,$verb in
" +
  flag_cases +
  "    esac
  fi
  COMPREPLY=($(compgen -W \"$words\" -- \"$cur\"))
}
complete -F _lll lll
"
}

fn zsh_script() -> string {
  let (verb_cases, flag_cases) = shell_cases(|words| f"comps=({words})")
  let all_nouns = strings.Join(nouns(), " ")
  "# lll zsh completions
# Add to ~/.zshrc (after compinit):  eval \"$(lll completions zsh)\"
_lll() {
  local -a comps
  local noun=${words[2]-}
  local verb=${words[3]-}
  if (( CURRENT == 2 )); then
    comps=(" +
  all_nouns +
  ")
  elif (( CURRENT == 3 )); then
    case $noun in
" +
  verb_cases +
  "    esac
  else
    case $noun,$verb in
" +
  flag_cases +
  "    esac
  fi
  compadd -- $comps
}
compdef _lll lll
"
}

fn fish_script() -> string {
  let all_nouns = strings.Join(nouns(), " ")
  let mut out = "# lll fish completions
# Add to ~/.config/fish/config.fish:  lll completions fish | source
complete -c lll -f
"
  out += f"complete -c lll -n '__fish_use_subcommand' -a '{all_nouns}'\n"
  for n in nouns() {
    let vs = verbs(n)
    let own = noun_flags(n)
    if !vs.is_empty() {
      let ws = strings.Join(vs, " ")
      out += f"complete -c lll -n '__fish_seen_subcommand_from {n}; and not __fish_seen_subcommand_from {ws}' -a '{ws}'\n"
    }
    for fl in own {
      let spec = fish_flag(fl)
      out += f"complete -c lll -n '__fish_seen_subcommand_from {n}' {spec}\n"
    }
    for v in vs {
      for fl in verb_flags(n, v) {
        if own.contains(fl) { continue }
        let spec = fish_flag(fl)
        out += f"complete -c lll -n '__fish_seen_subcommand_from {n}; and __fish_seen_subcommand_from {v}' {spec}\n"
      }
    }
  }
  out
}

/// "--limit" -> "-l limit", "-w" -> "-s w".
fn fish_flag(flag: string) -> string {
  if flag.starts_with("--") {
    let name = flag.substring(2..flag.length())
    f"-l {name}"
  } else {
    let name = flag.substring(1..flag.length())
    f"-s {name}"
  }
}
