import "go:strings"

import "flags"
import "output"

// `lll completions <shell>` — static completion scripts, all generated from
// the one command table below (nouns, verbs per noun, flags per verb).

pub fn completions_commands() -> Slice<flags.Command> {
  [
    flags.Command { name: "bash", access: flags.Access.Read, summary: "add to ~/.bashrc: eval \"$(lll completions bash)\"", spec: [], run: |_| Ok(output.text(bash_script())), .. },
    flags.Command { name: "zsh", access: flags.Access.Read, summary: "add to ~/.zshrc (after compinit): eval \"$(lll completions zsh)\"", spec: [], run: |_| Ok(output.text(zsh_script())), .. },
    flags.Command { name: "fish", access: flags.Access.Read, summary: "add to ~/.config/fish/config.fish: lll completions fish | source", spec: [], run: |_| Ok(output.text(fish_script())), .. },
  ]
}

pub fn completions_usage() -> string {
  "lll completions - shell completion scripts

Usage:
  lll completions bash    add to ~/.bashrc:   eval \"$(lll completions bash)\"
  lll completions zsh     add to ~/.zshrc     eval \"$(lll completions zsh)\"
                          (after compinit)
  lll completions fish    add to ~/.config/fish/config.fish:
                          lll completions fish | source

Completes nouns, verbs per noun, and flags per verb."
}

// --- command table ---

/// Every first word: each noun, then its other spellings ('--version', '-v').
fn top_level() -> Slice<string> {
  let mut out: Slice<string> = []
  for n in nouns() { out = out.append(n.name) }
  for n in nouns() { out = out.append(strings.Fields(n.alias)...) }
  out
}

/// The noun's verbs, every accepted spelling but a hidden verb's (TASK-307:
/// read from the table, so a verb added there is completed with no edit here).
fn verbs(noun: string) -> Slice<string> {
  noun_named(noun).map_or([], |n| flags.command_names(flags.verbs_of(n)))
}

/// Flags for a noun-verb pair, from the verb's own flag table through
/// flags.tokens() - the table the parser and help read, so the three cannot
/// drift (TASK-127). Every spelling is offered: completions teach what the
/// parser accepts.
fn verb_flags(noun: string, verb: string) -> Slice<string> {
  let Some(n) = noun_named(noun) else { return [] }
  let Some(c) = flags.resolve_command(flags.verbs_of(n), verb) else { return [] }
  flags.tokens(c.spec)
}

/// Flags the noun takes itself: a verb-less noun's, or the verb that runs
/// when no verb is typed ('lll bot bot-NAME').
fn noun_flags(noun: string) -> Slice<string> {
  let Some(n) = noun_named(noun) else { return [] }
  match n.shape {
    flags.Shape.Single(c) => flags.tokens(c.spec),
    flags.Shape.VerbsOr(cmds, fallback) => flags.tokens(flags.command_spec(cmds, fallback)),
    flags.Shape.Verbs(_) | flags.Shape.Topics => [],
  }
}

// --- emitters ---

/// The two case-based shells share candidate collection and ordering;
/// each supplies only its assignment syntax.
fn shell_cases(assignment: fn(string) -> string) -> (string, string) {
  let mut verb_cases = ""
  let mut flag_cases = ""
  for n in nouns().map(|n| n.name) {
    let vs = verbs(n)
    let own = noun_flags(n)
    let candidates = vs.append(own...)
    if !candidates.is_empty() {
      let ws = strings.Join(candidates, " ")
      verb_cases += f"      {n}) {assignment(ws)} ;;\n"
    }
    if !own.is_empty() {
      let ws = strings.Join(own, " ")
      flag_cases += f"      {n},*) {assignment(ws)} ;;\n"
    }
    for v in vs {
      let fs = verb_flags(n, v)
      if !fs.is_empty() {
        let ws = strings.Join(fs, " ")
        flag_cases += f"      {n},{v}) {assignment(ws)} ;;\n"
      }
    }
  }
  (verb_cases, flag_cases)
}

fn bash_script() -> string {
  let (verb_cases, flag_cases) = shell_cases(|words| f"words='{words}'")
  let all_nouns = strings.Join(top_level(), " ")
  "# lll bash completions
# Add to ~/.bashrc:  eval \"$(lll completions bash)\"
_lll() {
  local cur=${COMP_WORDS[COMP_CWORD]}
  local noun=${COMP_WORDS[1]-}
  local verb=${COMP_WORDS[2]-}
  local words=
  if [ $COMP_CWORD -eq 1 ]; then
    words='" +
  all_nouns +
  "'
  elif [ $COMP_CWORD -eq 2 ]; then
    case $noun in
" +
  verb_cases +
  "    esac
  else
    case $noun,$verb in
" +
  flag_cases +
  "    esac
  fi
  COMPREPLY=($(compgen -W \"$words\" -- \"$cur\"))
}
complete -F _lll lll
"
}

fn zsh_script() -> string {
  let (verb_cases, flag_cases) = shell_cases(|words| f"comps=({words})")
  let all_nouns = strings.Join(top_level(), " ")
  "# lll zsh completions
# Add to ~/.zshrc (after compinit):  eval \"$(lll completions zsh)\"
_lll() {
  local -a comps
  local noun=${words[2]-}
  local verb=${words[3]-}
  if (( CURRENT == 2 )); then
    comps=(" +
  all_nouns +
  ")
  elif (( CURRENT == 3 )); then
    case $noun in
" +
  verb_cases +
  "    esac
  else
    case $noun,$verb in
" +
  flag_cases +
  "    esac
  fi
  compadd -- $comps
}
compdef _lll lll
"
}

fn fish_script() -> string {
  let all_nouns = strings.Join(top_level(), " ")
  let mut out = "# lll fish completions
# Add to ~/.config/fish/config.fish:  lll completions fish | source
complete -c lll -f
"
  out += f"complete -c lll -n '__fish_use_subcommand' -a '{all_nouns}'\n"
  for n in nouns().map(|n| n.name) {
    let vs = verbs(n)
    let own = noun_flags(n)
    if !vs.is_empty() {
      let ws = strings.Join(vs, " ")
      out += f"complete -c lll -n '__fish_seen_subcommand_from {n}; and not __fish_seen_subcommand_from {ws}' -a '{ws}'\n"
    }
    for fl in own {
      let spec = fish_flag(fl)
      out += f"complete -c lll -n '__fish_seen_subcommand_from {n}' {spec}\n"
    }
    for v in vs {
      for fl in verb_flags(n, v) {
        if own.contains(fl) { continue }
        let spec = fish_flag(fl)
        out += f"complete -c lll -n '__fish_seen_subcommand_from {n}; and __fish_seen_subcommand_from {v}' {spec}\n"
      }
    }
  }
  out
}

/// "--limit" -> "-l limit", "-w" -> "-s w".
fn fish_flag(flag: string) -> string {
  if flag.starts_with("--") {
    let name = flag.substring(2..flag.length())
    f"-l {name}"
  } else {
    let name = flag.substring(1..flag.length())
    f"-s {name}"
  }
}
