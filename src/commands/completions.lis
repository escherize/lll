import "go:fmt"
import "go:strings"

import "flags"

// `lll completions <shell>` — static completion scripts, all generated from
// the one command table below (nouns, verbs per noun, flags per verb).

pub fn completions(args: Slice<string>) -> Result<(), string> {
  let Some(shell) = args.get(2) else {
    print_completions_usage()
    return Ok(())
  }
  match shell {
    "bash" => {
      fmt.Print(bash_script())
      Ok(())
    },
    "zsh" => {
      fmt.Print(zsh_script())
      Ok(())
    },
    "fish" => {
      fmt.Print(fish_script())
      Ok(())
    },
    "--help" => {
      print_completions_usage()
      Ok(())
    },
    "-h" => {
      print_completions_usage()
      Ok(())
    },
    other => Err(f"unknown shell: '{other}' (expected bash, zsh, or fish)"),
  }
}

fn print_completions_usage() {
  fmt.Println(
    "lll completions - shell completion scripts

Usage:
  lll completions bash    add to ~/.bashrc:   eval \"$(lll completions bash)\"
  lll completions zsh     add to ~/.zshrc     eval \"$(lll completions zsh)\"
                          (after compinit)
  lll completions fish    add to ~/.config/fish/config.fish:
                          lll completions fish | source

Completes nouns, verbs per noun, and flags per verb.",
  )
}

// --- command table ---

fn nouns() -> Slice<string> {
  [
    "issue",
    "team",
    "member",
    "project",
    "label",
    "doc",
    "finding",
    "config",
    "attach",
    "watch",
    "up",
    "board",
    "login",
    "logout",
    "token",
    "completions",
    "whoami",
    "help",
    "--version",
    "-v",
  ]
}

fn verbs(noun: string) -> Slice<string> {
  match noun {
    "issue" => [
      "create",
      "list",
      "view",
      "update",
      "close",
      "start",
      "claim",
      "release",
      "delete",
      "comment",
      "watch",
      "url",
      "id",
      "title",
      "pr",
      "link",
      "unlink",
    ],
    "team" => ["list", "create", "view", "rename", "set-accent", "archive", "unarchive"],
    "member" => ["list", "add", "create", "invite", "set-password"],
    "project" => ["list", "view", "create", "edit", "delete"],
    "label" => ["list", "create", "edit", "delete"],
    "doc" => ["new", "list", "view", "edit", "delete"],
    "finding" => ["near", "list"],
    "config" => ["init", "set", "check", "--list"],
    "token" => ["create"],
    "completions" => ["bash", "zsh", "fish"],
    _ => [],
  }
}

/// Flags for a noun-verb pair, read from the verb's OWN flag table (the
/// `*_verb_spec` accessors) through flags.tokens() — the same table the
/// parser, help and completions read, so the three cannot drift (TASK-127).
/// Every spelling is offered: completions teach what the parser accepts.
fn verb_flags(noun: string, verb: string) -> Slice<string> {
  match noun {
    "issue" => flags.tokens(issue_verb_spec(verb)),
    "team" => flags.tokens(team_verb_spec(verb)),
    "member" => flags.tokens(member_verb_spec(verb)),
    "project" => flags.tokens(project_verb_spec(verb)),
    "label" => flags.tokens(label_verb_spec(verb)),
    "doc" => flags.tokens(doc_verb_spec(verb)),
    "finding" => flags.tokens(finding_verb_spec(verb)),
    "watch" => flags.tokens(watch_verb_spec(verb)),
    "up" => flags.tokens(up_verb_spec("")),
    "attach" => flags.tokens(attach_verb_spec("")),
    "board" => flags.tokens(board_verb_spec(verb)),
    "login" => flags.tokens(login_verb_spec("")),
    "token" => flags.tokens(token_verb_spec(verb)),
    _ => [],
  }
}

/// Flags for verb-less nouns: the noun itself is the verb.
fn noun_flags(noun: string) -> Slice<string> {
  verb_flags(noun, "")
}

// --- emitters ---

fn bash_script() -> string {
  let mut verb_cases = ""
  let mut flag_cases = ""
  for n in nouns() {
    let vs = verbs(n)
    if !vs.is_empty() {
      let ws = strings.Join(vs, " ")
      verb_cases += f"      {n}) words='{ws}' ;;\n"
    } else if !noun_flags(n).is_empty() {
      let ws = strings.Join(noun_flags(n), " ")
      verb_cases += f"      {n}) words='{ws}' ;;\n"
      flag_cases += f"      {n},*) words='{ws}' ;;\n"
    }
    for v in vs {
      let fs = verb_flags(n, v)
      if !fs.is_empty() {
        let ws = strings.Join(fs, " ")
        flag_cases += f"      {n},{v}) words='{ws}' ;;\n"
      }
    }
  }
  let all_nouns = strings.Join(nouns(), " ")
  "# lll bash completions
# Add to ~/.bashrc:  eval \"$(lll completions bash)\"
_lll() {
  local cur=${COMP_WORDS[COMP_CWORD]}
  local noun=${COMP_WORDS[1]-}
  local verb=${COMP_WORDS[2]-}
  local words=
  if [ $COMP_CWORD -eq 1 ]; then
    words='" +
  all_nouns +
  "'
  elif [ $COMP_CWORD -eq 2 ]; then
    case $noun in
" +
  verb_cases +
  "    esac
  else
    case $noun,$verb in
" +
  flag_cases +
  "    esac
  fi
  COMPREPLY=($(compgen -W \"$words\" -- \"$cur\"))
}
complete -F _lll lll
"
}

fn zsh_script() -> string {
  let mut verb_cases = ""
  let mut flag_cases = ""
  for n in nouns() {
    let vs = verbs(n)
    if !vs.is_empty() {
      let ws = strings.Join(vs, " ")
      verb_cases += f"      {n}) comps=({ws}) ;;\n"
    } else if !noun_flags(n).is_empty() {
      let ws = strings.Join(noun_flags(n), " ")
      verb_cases += f"      {n}) comps=({ws}) ;;\n"
      flag_cases += f"      {n},*) comps=({ws}) ;;\n"
    }
    for v in vs {
      let fs = verb_flags(n, v)
      if !fs.is_empty() {
        let ws = strings.Join(fs, " ")
        flag_cases += f"      {n},{v}) comps=({ws}) ;;\n"
      }
    }
  }
  let all_nouns = strings.Join(nouns(), " ")
  "# lll zsh completions
# Add to ~/.zshrc (after compinit):  eval \"$(lll completions zsh)\"
_lll() {
  local -a comps
  local noun=${words[2]-}
  local verb=${words[3]-}
  if (( CURRENT == 2 )); then
    comps=(" +
  all_nouns +
  ")
  elif (( CURRENT == 3 )); then
    case $noun in
" +
  verb_cases +
  "    esac
  else
    case $noun,$verb in
" +
  flag_cases +
  "    esac
  fi
  compadd -- $comps
}
compdef _lll lll
"
}

fn fish_script() -> string {
  let all_nouns = strings.Join(nouns(), " ")
  let mut out = "# lll fish completions
# Add to ~/.config/fish/config.fish:  lll completions fish | source
complete -c lll -f
"
  out += f"complete -c lll -n '__fish_use_subcommand' -a '{all_nouns}'\n"
  for n in nouns() {
    let vs = verbs(n)
    if !vs.is_empty() {
      let ws = strings.Join(vs, " ")
      out += f"complete -c lll -n '__fish_seen_subcommand_from {n}; and not __fish_seen_subcommand_from {ws}' -a '{ws}'\n"
    }
    for fl in noun_flags(n) {
      let spec = fish_flag(fl)
      out += f"complete -c lll -n '__fish_seen_subcommand_from {n}' {spec}\n"
    }
    for v in vs {
      for fl in verb_flags(n, v) {
        let spec = fish_flag(fl)
        out += f"complete -c lll -n '__fish_seen_subcommand_from {n}; and __fish_seen_subcommand_from {v}' {spec}\n"
      }
    }
  }
  out
}

/// "--limit" -> "-l limit", "-w" -> "-s w".
fn fish_flag(flag: string) -> string {
  if flag.starts_with("--") {
    let name = flag.substring(2..flag.length())
    f"-l {name}"
  } else {
    let name = flag.substring(1..flag.length())
    f"-s {name}"
  }
}
