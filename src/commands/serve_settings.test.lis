import "go:io/fs"
import "go:github.com/escherize/lll/web"
import "go:time"

// Unit cover for TASK-219: the Access panel's mint used to send
// `duration: 0`, which is not "no expiry" but "whatever the members
// collection says" — five days in PocketBase v0.40.1. The bug was in the
// number that reached the wire and in nothing being said about it, so that is
// what these pin: the body access_token_write posts, and the expiry it puts
// on the flash strip after the token.

fn minted() -> string {
  match mint_payload() {
    Ok(p) => p,
    Err(e) => e,
  }
}

#[test]
fn the_web_mint_asks_for_the_cli_s_default_duration() {
  // The literal year is spelled out once, here, as the tripwire: if the
  // shared default moves, this fails loudly rather than the board quietly
  // handing out a different lifetime than `lll token create` does.
  assert minted() == "{\"duration\":31536000}"
  assert default_token_duration() == 31536000
}

#[test]
fn the_web_mint_no_longer_defers_to_the_collection() {
  // The exact shape of the old bug: 0 hands the lifetime to PocketBase.
  assert !minted().contains("\"duration\":0")
}

#[test]
fn a_minted_token_says_when_it_dies() {
  // The flash the mint appends past the token patch. Impersonate tokens are
  // recorded nowhere, so this line is the only place the expiry is ever
  // visible — a mint that answered with the token alone is the silent failure
  // TASK-214 fixed on the CLI side.
  let at = time.Date(2026, time.January, 15, 12, 0, 0, 0, time.UTC)
  let flash = mint_expiry_event(at)
  assert flash.contains("expires 2027-01-15")
  assert flash.contains("flash-ok")
}

// LLL-446: the sections list is the URL segments, the template's dispatch
// keys and the nav's rows, all one list. Three things drifting apart is
// exactly how a nav row starts pointing at a 404, so pin them to each other.

/// The text of the embedded settings.html — the same bytes render() parses.
fn settings_template_text() -> string {
  let data = fs.ReadFile(web.Assets(), "templates/settings.html").unwrap_or([])
  data as string
}

#[test]
fn every_section_has_a_template_and_a_nav_row() {
  let tpl = settings_template_text()
  for s in settings_sections() {
    assert tpl.contains(f"{{{{define \"set-{s}\"}}}}")
    assert tpl.contains(f"/settings/{s}\"")
    assert tpl.contains(f"eq .Section \"{s}\"")
  }
}

#[test]
fn every_written_kind_redraws_its_own_section() {
  // The write's reply patches #settings, so a kind that mapped to the wrong
  // section would answer a label save with the members list.
  for pair in [["team", "identity"], ["label", "labels"], ["project", "projects"], ["member", "members"]] {
    let section = section_of(pair[0])
    assert section == pair[1]
    assert settings_sections().find(|s| s == section).is_some()
  }
}
