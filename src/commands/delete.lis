import "go:bufio"
import "go:fmt"
import "go:golang.org/x/term"
import "go:net/url"
import "go:os"
import "go:strings"

import "models"
import "pb"
import "query"

/// Count every issue affected by removing one shared classification record.
/// CLI deletion, web review and label inventory use the same relation filters.
fn entity_issue_count(kind: string, id: string) -> Result<int, string> {
  match kind {
    "label" => issue_count(query.filter("", "", "", "", id, "")),
    "project" => issue_count(query.filter("", "", "", id, "", "")),
    _ => Err(f"cannot count issue references for '{kind}'"),
  }
}

/// How many issues match a filter. perPage=1 so PocketBase answers the count
/// without a page of records.
///
/// The one copy: team delete, team view, the settings team inventory and the
/// projects page all counted issues by spelling this request out again, four
/// times, one of them twice. Takes the filter UNESCAPED and escapes it here,
/// so no caller has to remember which side of the escape it is on.
fn issue_count(filter: string) -> Result<int, string> {
  let mut list = models.IssueList { .. }
  pb.fetch(
    f"/api/collections/issues/records?perPage=1&fields=id&filter={url.QueryEscape(filter)}",
    "issues",
    &list,
  )?
  Ok(list.total_items)
}

/// The refusal a guarded delete answers with. Names the count and the exact
/// command that overrides it, so the user never has to guess the flag.
fn refuse_delete(kind: string, name: string, used: int) -> string {
  let argument = cli_argument(name)
  pb.fail(pb.ErrorKind.Refused, f"{used} issue(s) still reference the {kind} '{name}' — deleting it drops the {kind} off them.\nTo delete it anyway, run:\n  lll {kind} delete {argument} --force\nOr reassign those issues first.")
}

/// What a completed delete prints. The count rides along even on the forced
/// path, because "how many issues just changed" is the thing worth knowing.
fn deleted_line(kind: string, name: string, used: int) -> string {
  if used == 0 { return f"Deleted {kind} {name}" }
  f"Deleted {kind} {name} (dropped from {used} issue(s))"
}

/// Ask `question [y/N]` on stdout and read one answer from stdin; only y or
/// yes confirms. `--yes` is how a caller skips this (D6 in doc v1-0-plan).
fn confirmed(question: string) -> bool {
  fmt.Print(f"{question} [y/N] ")
  let mut scanner = bufio.NewScanner(os.Stdin)
  let mut answer = ""
  if scanner.Scan() { answer = strings.TrimSpace(scanner.Text()) }
  let a = strings.ToLower(answer)
  a == "y" || a == "yes"
}

/// A declined confirmation: exit 4, refused (LLL-645). It used to print
/// "Aborted." and exit 0, so a script could not tell a skipped delete from a
/// done one.
fn aborted() -> string {
  pb.fail(pb.ErrorKind.Refused, "aborted: nothing was deleted")
}

/// The confirmation for deletes that never prompted before 1.0 (team, label,
/// project, member, comment): a person at a terminal is asked, and a script
/// is not, so no existing script starts blocking on stdin.
fn confirmed_on_terminal(yes: bool, question: string) -> bool {
  if yes || !term.IsTerminal(os.Stdin.Fd() as int) { return true }
  confirmed(question)
}
