import "go:html/template"

// View models for the web board: the structs the templates read, and nothing
// that fetches or renders. They are built in serve_render.lis and composed
// into PageVM by the page handlers.

/// View model for one label chip.
pub struct LabelVM {
  pub name: string,
  pub color: string,
}

/// One relation option in the create dialog: the record id the form posts,
/// and the name a human picks by.
pub struct PickVM {
  pub id: string,
  pub name: string,
}

/// One selectable label in the create dialog. Same shape as LabelVM plus the
/// id, because a chip on a card is read-only and this one is a checkbox.
/// `on` marks the labels an issue already carries: false in the create
/// dialog (nothing is checked yet), set by issue_vm on the issue page,
/// where the same chips are the Properties panel's label editor.
pub struct LabelPickVM {
  pub id: string,
  pub name: string,
  pub color: string,
  pub on: bool,
}

/// Everything the create dialog offers beyond title and state — the same set
/// `lll issue create` takes as flags, resolved to record ids at page render.
///
/// Filled by board_page ONLY. The broadcast path re-renders the `board`
/// fragment, which never reads .Compose, so a repaint still costs one issues
/// fetch and not four. The lists are therefore as old as the page: a label
/// added elsewhere shows up on the next load, same bargain as the rail.
pub struct ComposeVM {
  pub prios: Slice<StateOpt>,
  pub members: Slice<PickVM>,
  pub projects: Slice<PickVM>,
  pub labels: Slice<LabelPickVM>,
}

/// A state <option>: slug value, humanized label.
pub struct StateOpt {
  pub value: string,
  pub label: string,
}

/// View model for an avatar: initials plus a stable per-name color class.
pub struct AvatarVM {
  pub initials: string,
  pub class: string,
}

/// View model for one issue: a board card, or one row of the /issues table.
pub struct CardVM {
  pub id: string,
  pub key: string,
  pub title: string,
  pub state: string,
  // Humanized state for the hover preview ("in-progress" -> "In progress").
  pub state_label: string,
  pub prio: string,
  // Priority for display: "No priority" for none, else capitalized slug.
  pub prio_label: string,
  pub assignee: string,
  pub avatar: AvatarVM,
  pub labels: Slice<LabelVM>,
  // The author's marker, or "" for most issues.
  pub emoji: string,
  // Relative created age ("3h ago") for the card's bottom row.
  pub created: string,
  // Relative updated age. Board cards do not show it; the /issues table
  // sorts on it by default, so the column has to exist somewhere.
  pub updated: string,
  // First ~2 lines of the description, truncated, for the hover preview.
  pub snippet: string,
}

/// One selectable filter value in the board's chooser and chip row. `href`
/// is the board URL with this value toggled — a navigation, because the URL
/// is the whole filter state (TASK-94). `active` marks the values the current
/// URL asked for; `count` is how many board issues carry the value, so a
/// filter that matches nothing still renders with a count of 0 (TASK-116).
pub struct FilterOptVM {
  pub value: string,
  pub label: string,
  pub href: string,
  pub active: bool,
  pub count: int,
}

/// One filter dimension with its distinct values. `dim` matches both the
/// query param name and the card data-* attribute the client-side guard
/// compares against.
pub struct FilterGroupVM {
  pub dim: string,
  pub label: string,
  pub opts: Slice<FilterOptVM>,
}

/// View model for one board column (a state). `cards` carries only the
/// cards the current URL's filter admits; `total` is the unfiltered count,
/// so the column's number stays stable across SSE morphs and dims while a
/// filter is active instead of flickering between the two views.
pub struct ColumnVM {
  pub state: string,
  pub label: string,
  pub glyph: string,
  // State as a Datastar signal name ("in-progress" -> "in_progress").
  // template.JS so data-on:* (a JS context to html/template) gets the bare
  // identifier instead of a quoted JS string.
  pub sig: template.JS,
  pub cards: Slice<CardVM>,
  pub total: int,
}

/// View model for the board page.
///
/// Since TASK-94 the URL is the source of truth for the board's view state:
/// the server renders the filtered board straight from the query params, the
/// filter chips and column-hide buttons are navigations, and localStorage
/// holds only the last view's query string to restore on a param-less
/// arrival. The broadcast path fills only `states` and `columns`.
pub struct BoardVM {
  pub states: Slice<StateOpt>,
  pub columns: Slice<ColumnVM>,
  pub filter_groups: Slice<FilterGroupVM>,
  // The active filter as a JSON array of "dim:value" keys for the card
  // data-show — the client-side guard that keeps a broadcast's unfiltered
  // cards honest on a filtered page. "[]" when the URL carries no filter.
  pub flt_seed: template.JS,
  // This request's canonical query string ("" or "?state=todo"), for the
  // save-view form's hidden field and for the restore-on-arrival check.
  pub query_str: string,
  // The state slugs hidden by ?hide=, rendered as hc-* classes on .main so
  // a curl of the URL sees the same board a browser does.
  pub hidden: Slice<string>,
  // One `$hide_<sig> = true/false` assignment per state, seeding the signals
  // data-class reads on .main.
  pub hide_seed: template.JS,
  // A rejected query param, said out loud in the flash strip rather than
  // silently dropped — the same contract /issues runs on.
  pub error: string,
  // True when a filter is active and matched nothing: the filter bar says
  // so instead of showing a silently empty board (TASK-116).
  pub no_match: bool,
  // Pickers for the create dialog. Zero-valued on the broadcast path — the
  // `board` fragment does not read it. See ComposeVM.
  pub compose: ComposeVM,
}

/// View model for the search page. `q` echoes back the URL's query so the
/// field stays filled and the page reloads to itself; `results` is what the
/// DATABASE returned for it, never what the board happened to be holding.
pub struct SearchVM {
  pub q: string,
  pub results: Slice<CardVM>,
}

/// View model for the app shell's left rail.
///
/// Shell data lives here and nowhere else. The SSE bridge broadcasts
/// FRAGMENTS rendered straight from BoardVM / IssueVM / CommentsVM, so
/// hanging the rail off those view models would make every broadcast
/// construct a rail it must never render. Page handlers compose the two
/// halves into a PageVM instead; a fragment cannot carry shell by accident.
pub struct RailVM {
  // Which row reads as current: "board", "mine", "issues", "projects",
  // "search" or "settings".
  pub active: string,
  // Config's `me`. Empty means there is no member to be, so no "My issues"
  // row — a rail link that leads nowhere is worse than no rail link.
  pub me: string,
  pub version: string,
  // The team's accent as the body of a `:root` rule, or "" for DESIGN.md's
  // canonical orange (theme.css already holds those exact values). It rides
  // the shell because every page wears it, and it renders into the head as
  // <style id="accent">, so /settings can morph a new colour into an open
  // page without a reload.
  pub accent_css: template.CSS,
  // The tab icon in the same colour, as a data: URL. template.URL for the
  // same reason ColumnVM.sig is template.JS: html/template will not emit a
  // data: URL typed as a plain string.
  pub favicon: template.URL,
  // The starred issues, newest first. The one part of the rail that is also
  // broadcast on its own (see favorites_broadcast).
  pub favorites: Slice<FavVM>,
  // The workspace's saved views (TASK-94, half two): a name plus the board
  // query string it stands for, rendered as a rail group beside favorites.
  pub views: Slice<ViewVM>,
}

/// One starred issue in the rail's FAVORITES group.
pub struct FavVM {
  pub key: string,
  pub title: string,
  pub state: string,
}


/// One saved view row in the rail. `href` is the board URL the view
/// navigates to; a view is a name plus a query string, nothing more.
pub struct ViewVM {
  pub name: string,
  pub href: string,
}

/// A whole page: the shell plus that page's own view model. Page templates
/// take one of these and reach the page through `.Page`; adding a page means
/// a handler and a `{{define}}`, never an edit to another page's template.
pub struct PageVM {
  pub rail: RailVM,
  pub page: Unknown,
}

/// View model for one comment.
pub struct CommentVM {
  pub id: string,
  pub author: string,
  pub avatar: AvatarVM,
  pub age: string,
  pub body: template.HTML,
}

/// View model for the comments fragment alone (broadcast re-renders).
pub struct CommentsVM {
  pub comments: Slice<CommentVM>,
}

/// View model for the issue page / issue-detail fragment.
pub struct IssueVM {
  pub deleted: bool,
  pub id: string,
  pub key: string,
  pub title: string,
  pub state: string,
  pub prio: string,
  pub assignee: string,
  pub avatar: AvatarVM,
  pub project: string,
  // /issues filtered to this project, or "" when the issue has none. The
  // name alone cannot answer that: a project may legitimately be called
  // "none", which is also what the empty case prints.
  pub project_href: string,
  pub labels: Slice<LabelVM>,
  // The author's marker, or "" for most issues.
  pub emoji: string,
  pub description: template.HTML,
  pub created: string,
  pub updated: string,
  pub states: Slice<StateOpt>,
  pub prios: Slice<StateOpt>,
  // The Properties panel's editors. states/prios above ride every
  // issue-detail broadcast because the selects live inside the morph
  // boundary; these three catalogues ride it for the same reason — a
  // select wiped by a morph with no options is a control that cannot act.
  pub project_id: string,
  pub assignee_id: string,
  pub member_opts: Slice<PickVM>,
  pub project_opts: Slice<PickVM>,
  pub label_opts: Slice<LabelPickVM>,
  pub comments: Slice<CommentVM>,
  // Seeds the topbar star's $fav signal. Only the page handler sets it: the
  // star lives outside #issue-detail, so no broadcast re-renders it.
  pub favorited: bool,
  // The emoji picker's candidates. Filled by issue_page ONLY, for the same
  // reason as `favorited`: the picker panel is rendered once per page load,
  // outside #issue-detail, so keeping the catalogue out of issue_vm keeps
  // 241 candidates out of every issue-detail broadcast.
  pub emojis: Slice<EmojiOpt>,
}

/// One column heading in the /issues table. `href` empty means the column has
/// no PB field behind it and does not sort; `dir` is "asc" or "desc" only on
/// the column currently doing the sorting.
pub struct IssueColVM {
  pub label: string,
  pub href: string,
  pub dir: string,
  pub cls: string,
}

/// View model for the /issues table.
///
/// Everything the page can be is in the URL, so this is a pure projection of
/// four query params. `shown` and `total` are kept apart on purpose: PB is
/// asked for 200 rows and reports how many matched, so the page can say
/// "showing 200 of 340" instead of silently ending at 200.
pub struct IssuesVM {
  // Header cells, in the order the row cells below them are written.
  pub cols: Slice<IssueColVM>,
  pub rows: Slice<CardVM>,
  pub shown: int,
  pub total: int,
  pub truncated: bool,
  // The per-request row ceiling, named in the count when it bites.
  pub limit: int,
  // Filter chooser contents and the values currently selected.
  pub states: Slice<StateOpt>,
  pub members: Slice<string>,
  pub label_names: Slice<string>,
  pub project_names: Slice<string>,
  pub state: string,
  pub assignee: string,
  pub label: string,
  pub project: string,
  pub sort: string,
  // URL with every filter dropped and the sort kept, for "Clear". Built by
  // the shared encoder (serve_url.lis), the one the board uses too.
  pub clear_href: string,
  // A rejected query param, said out loud in the flash strip rather than
  // served as a 500 or silently ignored.
  pub error: string,
}


/// One label row on /settings. `scope` is the owning team's key, or
/// "workspace" — shown, never edited: which team owns a label is a CLI
/// decision (`lll label create --team`), and a settings page that silently
/// moved records between teams would be worse than one that says where they
/// live.
pub struct SetLabelVM {
  pub id: string,
  pub name: string,
  pub color: string,
  pub scope: string,
}

/// One member row on /settings. Members are honor-system identities (ADR-1:
/// no auth), so this list is the workspace's — never "your account".
pub struct SetMemberVM {
  pub id: string,
  pub name: string,
  pub email: string,
}

/// One project row on /settings.
pub struct SetProjectVM {
  pub id: string,
  pub name: string,
  pub status: string,
  pub scope: string,
}

/// View model for /settings, and for the #settings fragment its actions patch
/// back.
///
/// Everything here passes one filter: server-side, shared between everyone,
/// and reachable only from the CLI today. Deliberately absent: hidden columns
/// and filter chips (per-browser, and already live on the board where they
/// are used), anything PocketBase's own admin UI does better, and
/// url/port/pb-dir — a page cannot change the address of the process serving
/// it without restarting that process.
pub struct SettingsVM {
  // "" when no team is configured; the team card then says so instead.
  pub team_key: string,
  pub team_name: string,
  // The accent as "#rrggbb", falling back to the canonical orange:
  // <input type="color"> has no empty state, so the swatch always shows one.
  pub accent: string,
  // Whether that colour is the team's own choice or just the default.
  pub accent_set: bool,
  pub labels: Slice<SetLabelVM>,
  pub members: Slice<SetMemberVM>,
  pub projects: Slice<SetProjectVM>,
  pub statuses: Slice<StateOpt>,
}

/// One project on /projects: what it is, how far along it is, and how many
/// issues point at it.
pub struct ProjectVM {
  pub name: string,
  // The first ~2 lines of the description. Projects are the one record whose
  // long text the web could never show; the CLI writes it with -d.
  pub description: string,
  pub status: string,
  pub status_label: string,
  // The --st-* token the status dot borrows. See project_tone.
  pub tone: string,
  pub scope: string,
  // Issues pointing here, under the same team scope /issues filters by, so
  // the number and the link it labels can never disagree.
  pub count: int,
  // /issues pre-filtered to this project — the count made clickable.
  pub href: string,
}

/// View model for /projects.
pub struct ProjectsVM {
  pub projects: Slice<ProjectVM>,
}
