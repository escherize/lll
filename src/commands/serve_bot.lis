import "go:net/http"
import "go:regexp"
import "go:strings"
import "go:time"

import "records"

// The board's "Add a bot" (LLL-546, doc scoped-access-invites Decision step
// 3): the web face of `lll bot`. A read-write member viewer mints a bot it
// owns and gets the agent prompt once, in this POST's own response.
//
// Every server call rides the VIEWER's token, never the board's process
// member or a superuser: the members create rule admits only a bot whose
// owner is the caller, and gopb keeps the bot within its owner's access.
// The token is never stored, broadcast or logged: the prompt is patched into
// #bot-result by this response alone, and every page renders that element
// empty, so a reload or a live update cannot show it again.

pub struct BotResultVM {
  pub name: string,
  pub team: string,
  pub prompt: string,
}

/// POST /bot: name, team. Refusals flash; success patches #bot-result.
fn bot_write(
  w: http.ResponseWriter,
  r: mut Ref<http.Request>,
) -> Result<string, string> {
  // The response may carry the bot's token: no cache keeps a copy.
  w.Header().Set("Cache-Control", "no-store")
  let who = acting_as(r)?
  // The board token names no person, so a bot minted from it would be owned
  // by the board's process member: refused until that is decided (LLL-546).
  let (Some(m), Some(v)) = (who.member, who.scope) else {
    return Err(board_token_bot_refusal())
  }
  let team = records.normalize_team_key(r.PostFormValue("team"))
  if !v.sees(team) { return Err(hidden_team(team)) }
  let name = board_bot_name(r.PostFormValue("name"))?
  if let Some(_) = records.find_member_as(m.token, name)? {
    return Err(
      f"a member named '{name}' already exists - pick another name (to re-mint a bot you own, run 'lll bot rotate {name}')",
    )
  }
  // Before anything is created: a refusal here must not leave a bot behind.
  let url = request_origin(r)?
  check_prompt_values(url, team, name)?
  let _ = create_bot_member_as(m.token, name, m.id)?
  let duration = default_token_duration()
  let tok = match bot_mint(m.token, name, duration) {
    Ok(t) => t,
    Err(e) => return Err(
      f"{e}\nthe bot {name} exists; mint its token with 'lll bot rotate {name}'",
    ),
  }
  let html = render(
    "bot-result",
    BotResultVM { name, team, prompt: agent_prompt(url, team, tok) },
  )?
  let day = time
    .Now()
    .Add(time.Duration(duration as int64) * time.Second)
    .Format("2006-01-02")
  Ok(
    patch_event(html) +
    flash_ok_event(
      f"{name} minted; its token expires {day} - re-mint with 'lll bot rotate {name}'",
    ),
  )
}

fn board_token_bot_refusal() -> string {
  "Add a bot needs a member board login (an invite link); this board login names no person to own the bot. From a terminal, run 'lll bot create bot-NAME'"
}

/// The bot's member name from the form: "name" or "bot-name", lowercase
/// letters, digits and dashes. Strict on purpose: it becomes a member name.
fn board_bot_name(raw: string) -> Result<string, string> {
  let name = strings.TrimPrefix(strings.TrimSpace(raw), "bot-")
  if !regexp.MustCompile("^[a-z0-9][a-z0-9-]{0,39}$").MatchString(name) {
    return Err(
      "name the bot with lowercase letters, digits and dashes (up to 40), e.g. myrepo - it becomes bot-myrepo",
    )
  }
  Ok("bot-" + name)
}

/// The address the viewer reached this board at: the board serves the API
/// under /api/, so it is the agent's LLL_URL. A Host outside a plain
/// host[:port] shape is refused rather than echoed into a prompt.
fn request_origin(r: Ref<http.Request>) -> Result<string, string> {
  let host = r.Host
  let plain = regexp.MustCompile(
    r"^([A-Za-z0-9.-]+|\[[0-9A-Fa-f:.]+\])(:[0-9]{1,5})?$",
  )
  if !plain.MatchString(host) {
    return Err(
      "cannot tell this board's address from the request; run 'lll bot create bot-NAME' from a terminal",
    )
  }
  let forwarded = r.Header.map_or("", |h| h.Get("X-Forwarded-Proto"))
  let scheme = if r.TLS.is_some() || forwarded == "https" {
    "https"
  } else {
    "http"
  }
  Ok(f"{scheme}://{host}")
}
