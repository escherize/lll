import "go:encoding/json"
import "go:net/url"
import "go:sort"
import "go:strconv"
import "go:strings"

import "display"
import "flags"
import "models"
import "output"
import "pb"
import "query"
import "records"

/// One audit_events row (LLL-609): a write to an issue, comment or claim,
/// who made it and what it changed. gopb/audit.go writes them.
#[json]
struct AuditEvent {
  id: string,
  seq: int,
  collection: string,
  record: string,
  action: string,
  team: string,
  issue: string,
  number: int,
  project: string,
  actor: models.MemberId,
  actor_kind: string,
  agent: string,
  origin_host: string,
  changes: Map<string, AuditChange>,
  created: string,
}

#[json]
struct AuditChange {
  from: Unknown,
  to: Unknown,
}

#[json]
struct AuditPage {
  items: Slice<AuditEvent>,
}

pub fn activity_command() -> flags.Command {
  flags.Command {
    name: "activity",
    access: flags.Access.Read,
    summary: "what changed on the board, in order, after a cursor: issue, comment and claim writes with who made them",
    page: activity_usage(),
    spec: activity_spec(),
    run: activity,
    ..,
  }
}

fn activity_spec() -> Slice<flags.Flag> {
  flags.with_team([
    flags.Flag { name: "--since", value: true, hint: "CURSOR", help: "only events after this cursor (the last event's seq); default: from the start", .. },
    flags.Flag { name: "--project", value: true, hint: "NAME", help: "only events on issues in this project", .. },
    flags.Flag { name: "--limit", value: true, hint: "N", help: "at most N events (default 100, at most 500); pass the cursor to read on", .. },
    flags.Flag { name: "--json", help: "print the events as a JSON list; the cursor is the last item's seq", .. },
  ])
}

fn activity_usage() -> string {
  "lll activity - what changed on the board, in order, after a cursor

Usage:
  lll activity [--since CURSOR] [--project NAME] [--limit N] [--team KEY] [--json]

Every write to an issue, comment or claim is recorded by the server with
who made it (member, agent label, origin host) and the fields it changed.
Events are read in order after a cursor, so a client keeps one number
instead of diffing snapshots: pass the cursor printed on stderr (or the
last --json item's seq) to --since, and nothing is missed or repeated.

Flags:
  --since CURSOR  only events after this cursor; default: from the start
  --project NAME  only events on issues in this project
  --limit N       at most N events (default 100, at most 500)
  --team KEY      team for this invocation (overrides LLL_TEAM)
  --json          the events as a JSON list; the cursor is the last item's seq

Example:
  lll activity --since 120 --limit 20"
}

fn activity(input: flags.CommandInput) -> Result<output.Output, pb.CliError> {
  let ctx = input.ctx
  let p = input.parsed
  let since = whole_number(p.one("--since"), 0, "--since")?
  let limit = whole_number(p.one("--limit"), 100, "--limit")?
  if limit < 1 || limit > 500 { return Err(flags.usage_error("--limit must be between 1 and 500")) }

  let team = records.configured_team(ctx)?
  let mut clauses = [f"seq > {since}"]
  if let Some(t) = team { clauses = clauses.append(f"team = {query.quote(t.id.string())}") }
  if p.given("--project") {
    let Some(t) = team else { return Err(records.no_team()) }
    let project = records.resolve_project(ctx, t.id, p.one("--project"))?
    clauses = clauses.append(f"project = {query.quote(project.id.string())}")
  }
  let filter = url.QueryEscape(strings.Join(clauses, " && "))
  let mut page = AuditPage { .. }
  pb.fetch(ctx, f"/api/collections/audit_events/records?filter={filter}&sort=seq&perPage={limit}&skipTotal=1", "activity", &page)?
  let events = page.items

  if p.given("--json") { return list_json(events, whole_list(events.length()), "activity") }
  if events.is_empty() { return Ok(output.notice(f"no activity after {since}")) }
  let cursor = events[events.length() - 1].seq
  let keys = team_keys(ctx)?
  // The roster as this reader may see it: a member it may not see stays
  // "hidden member" (LLL-551), as on every other surface.
  let mut names = Map.new<string, string>()
  for m in records.fetch_members(ctx)? { names[m.id.string()] = m.name }
  let mut out = output.none()
  for e in events {
    let key = f"{keys.get(e.team).unwrap_or("?")}-{e.number}"
    out = out.line(f"{e.seq}\t{display.absolute(e.created)}\t{key}\t{event_actor(e, names)}\t{event_summary(e)}")
  }
  Ok(out.notice(f"cursor {cursor}: lll activity --since {cursor}"))
}

fn whole_number(raw: string, fallback: int, flag: string) -> Result<int, pb.CliError> {
  if raw == "" { return Ok(fallback) }
  match strconv.Atoi(strings.TrimSpace(raw)) {
    Ok(n) if n >= 0 => Ok(n),
    _ => Err(flags.usage_error(f"{flag} takes a whole number, not '{raw}'")),
  }
}

fn team_keys(ctx: pb.Client) -> Result<Map<string, string>, pb.CliError> {
  let mut keys = Map.new<string, string>()
  for t in records.list_teams(ctx)?.items { keys[t.id.string()] = t.key }
  Ok(keys)
}

fn event_actor(e: AuditEvent, names: Map<string, string>) -> string {
  let name = match e.actor_kind {
    "system" => "the server",
    "superuser" => "an administrator",
    _ => display.member_name(e.actor, names.get(e.actor.string()).unwrap_or(""), "unknown"),
  }
  display.byline(name, e.agent)
}

/// One phrase per kind of write; an issue update names the fields it
/// changed, with the values of the ones short enough to read in a line.
fn event_summary(e: AuditEvent) -> string {
  match (e.collection, e.action) {
    ("claims", "create") => "claimed",
    ("claims", "update") => "renewed the claim",
    ("claims", "delete") => "released the claim",
    ("comments", "create") => f"commented: {excerpt(changed_to(e, "body"))}",
    ("comments", "update") => "edited a comment",
    ("comments", "delete") => "deleted a comment",
    ("issues", "create") => f"created: {changed_to(e, "title")}",
    ("issues", "delete") => "deleted the issue",
    _ => f"updated {changed_fields(e.changes)}",
  }
}

fn changed_to(e: AuditEvent, field: string) -> string {
  e.changes.get(field).map_or("", |c| text_of(c.to))
}

fn changed_fields(changes: Map<string, AuditChange>) -> string {
  let mut shown: mut Slice<string> = []
  for (name, c) in changes {
    let phrase = if name == "state" || name == "priority" { f"{name} {text_of(c.from)} -> {text_of(c.to)}" } else { name }
    shown = shown.append(phrase)
  }
  sort.Strings(shown)
  strings.Join(shown, ", ")
}

fn text_of(v: Unknown) -> string {
  assert_type<string>(v).unwrap_or_else(|| {
    let raw = json.Marshal(v).map_or("", |b| b as string)
    if raw == "null" { "" } else { raw }
  })
}

fn excerpt(body: string) -> string {
  let line = strings.Join(strings.Fields(body), " ")
  let runes = line as Slice<rune>
  if runes.length() <= 60 { line } else { f"{runes[..59] as string}…" }
}
