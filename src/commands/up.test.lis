// Unit cover for TASK-218's predicate. `is_loopback` is what stands between a
// throwaway `lll up --pb-dir` and a write to production: the old code asked
// `healthy()` whether something answered at the configured url, which a live
// prod instance does, and adopted it. This asks the question that actually
// matters — is that url this machine — so it has to be right about the forms a
// url really takes, brackets and trailing slashes included.

#[test]
fn loopback_recognises_the_local_forms() {
  assert is_loopback("http://127.0.0.1:8090")
  assert is_loopback("http://localhost:8090")
  assert is_loopback("https://localhost")
  // Trailing path: the host ends at the first slash after the scheme.
  assert is_loopback("http://127.0.0.1:8090/")
  // No scheme at all, as an LLL_URL might be typed.
  assert is_loopback("localhost:8090")
  assert is_loopback("127.0.0.1")
  // An IPv6 literal wears brackets.
  assert is_loopback("http://[::1]:8090")
}

#[test]
fn loopback_rejects_remote_hosts() {
  // The exact url that caused the incident.
  assert !is_loopback("https://escherize-lll.fly.dev:8091")
  assert !is_loopback("https://escherize-lll.fly.dev")
  assert !is_loopback("http://192.168.1.10:8090")
  assert !is_loopback("http://[2606:4700::1111]:8090")
}

#[test]
fn loopback_is_not_fooled_by_a_hostname_that_merely_starts_local() {
  // Substring matching would call these local; splitting on the port colon
  // and comparing whole names does not.
  assert !is_loopback("http://localhost.evil.example:8090")
  assert !is_loopback("http://127.0.0.1.evil.example")
  // Userinfo: the host is after the "@" (LLL-648 review).
  assert !is_loopback("http://localhost:1@evil.example")
  assert !is_loopback("http://127.0.0.1:1@evil.example/")
  assert !is_loopback("http://:80@evil.example")
  assert !is_loopback("http://localhost?x@evil.example")
  assert !is_loopback("http://evil.example\\@localhost")
}

// LLL-648: a loopback boot logs the CLI in, but only into an empty slot. A
// token or url from a file may be another server's login (url and token
// layer independently), so it is never replaced.
fn state(rides: bool, source: string, home_token: string, home_url: string) -> CliState {
  CliState {
    rides,
    throwaway: false,
    loopback: true,
    token_source: source,
    home_token,
    home_url,
    db_url: "http://127.0.0.1:8090",
  }
}

fn plan_kind(p: CliLogin) -> string {
  match p {
    CliLogin.Already => "already",
    CliLogin.Save => "save",
    CliLogin.Untouched(_) => "untouched",
    CliLogin.Keep(how) => f"keep: {how}",
  }
}

#[test]
fn the_cli_login_is_written_only_into_an_empty_slot() {
  assert plan_kind(cli_login_plan(state(true, "file:/h/lll.toml", "tok", ""))) == "already"
  assert plan_kind(cli_login_plan(state(false, "", "", ""))) == "save"
  assert plan_kind(cli_login_plan(state(false, "", "", "http://127.0.0.1:8090"))) == "save"
  assert plan_kind(cli_login_plan(state(false, "env:LLL_TOKEN", "", ""))) == "save"
  // Each kept credential names its own way out.
  assert plan_kind(cli_login_plan(state(false, "file:/h/lll.toml", "tok", ""))).contains("lll logout")
  let env = plan_kind(cli_login_plan(state(false, "env:LLL_TOKEN", "tok", "")))
  assert env.contains("unset it") && !env.contains("logout")
  let repo = plan_kind(cli_login_plan(state(false, "file:/repo/.lll.toml", "", "")))
  assert repo.contains("/repo/.lll.toml") && !repo.contains("logout")
  // A logged-out home pointed at a hosted board keeps its url.
  let hosted = plan_kind(cli_login_plan(state(false, "", "", "https://lll.example.com")))
  assert hosted.contains("lll config set url http://127.0.0.1:8090")
  // A --pb-dir boot and a non-loopback bind never touch the CLI.
  assert plan_kind(cli_login_plan(CliState { throwaway: true, ..state(false, "", "", "") })) == "untouched"
  assert plan_kind(cli_login_plan(CliState { loopback: false, ..state(false, "", "", "") })) == "untouched"
}

// LLL-648: one truth about the administrator pair. Only the proven loopback
// fallback is printed; an environment pair never is.
#[test]
fn the_banner_prints_only_the_proven_loopback_fallback() {
  let Some(line) = admin_line(true, true, false, true) else {
    assert false
    return
  }
  assert line.starts_with("admin  admin@local.dev / admin-local-123 ")
  assert admin_line(false, true, false, true).is_none()
  assert admin_line(true, false, false, true).is_none()
  assert admin_line(true, true, true, true).is_none()
  assert admin_line(true, true, false, false).is_none()
}
