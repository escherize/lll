import "config"

// Unit cover for TASK-218's predicate. `is_loopback` is what stands between a
// throwaway `lll up --pb-dir` and a write to production: the old code asked
// `healthy()` whether something answered at the configured url, which a live
// prod instance does, and adopted it. This asks the question that actually
// matters — is that url this machine — so it has to be right about the forms a
// url really takes, brackets and trailing slashes included.

#[test]
fn loopback_recognises_the_local_forms() {
  assert is_loopback("http://127.0.0.1:8090")
  assert is_loopback("http://localhost:8090")
  assert is_loopback("https://localhost")
  // Trailing path: the host ends at the first slash after the scheme.
  assert is_loopback("http://127.0.0.1:8090/")
  // No scheme at all, as an LLL_URL might be typed.
  assert is_loopback("localhost:8090")
  assert is_loopback("127.0.0.1")
  // An IPv6 literal wears brackets.
  assert is_loopback("http://[::1]:8090")
}

#[test]
fn loopback_rejects_remote_hosts() {
  // The exact url that caused the incident.
  assert !is_loopback("https://escherize-lll.fly.dev:8091")
  assert !is_loopback("https://escherize-lll.fly.dev")
  assert !is_loopback("http://192.168.1.10:8090")
  assert !is_loopback("http://[2606:4700::1111]:8090")
}

#[test]
fn loopback_is_not_fooled_by_a_hostname_that_merely_starts_local() {
  // Substring matching would call these local; splitting on the port colon
  // and comparing whole names does not.
  assert !is_loopback("http://localhost.evil.example:8090")
  assert !is_loopback("http://127.0.0.1.evil.example")
  // Userinfo: the host is after the "@" (LLL-648 review).
  assert !is_loopback("http://localhost:1@evil.example")
  assert !is_loopback("http://127.0.0.1:1@evil.example/")
  assert !is_loopback("http://:80@evil.example")
  assert !is_loopback("http://localhost?x@evil.example")
  assert !is_loopback("http://evil.example\\@localhost")
  // An empty authority: browsers skip the slashes to the next name.
  assert !is_loopback("http:///evil.example")
  assert !is_loopback("http:////evil.example")
  assert !is_loopback("http://\\evil.example")
  assert !is_loopback("http://:8090")
}

// LLL-648: a loopback boot logs the CLI in, but only into an empty slot. A
// token or url from a file may be another server's login (url and token
// layer independently), so it is never replaced.
fn state(rides: bool, source: Option<config.Source>, home_token: string, home_url: string) -> CliState {
  CliState {
    rides,
    throwaway: false,
    loopback: true,
    token_source: source,
    home_token,
    home_url,
    db_url: "http://127.0.0.1:8090",
  }
}

fn plan_kind(p: CliLogin) -> string {
  match p {
    CliLogin.Already => "already",
    CliLogin.Save => "save",
    CliLogin.Untouched(_) => "untouched",
    CliLogin.Keep(how) => f"keep: {how}",
  }
}

#[test]
fn the_cli_login_is_written_only_into_an_empty_slot() {
  assert plan_kind(cli_login_plan(state(true, Some(config.Source.HomeFile("/h/lll.toml")), "tok", ""))) == "already"
  assert plan_kind(cli_login_plan(state(false, None, "", ""))) == "save"
  assert plan_kind(cli_login_plan(state(false, None, "", "http://127.0.0.1:8090"))) == "save"
  assert plan_kind(cli_login_plan(state(false, Some(config.Source.Env("LLL_TOKEN")), "", ""))) == "save"
  // Each kept credential names its own way out.
  assert plan_kind(cli_login_plan(state(false, Some(config.Source.HomeFile("/h/lll.toml")), "tok", ""))).contains("lll logout")
  let env = plan_kind(cli_login_plan(state(false, Some(config.Source.Env("LLL_TOKEN")), "tok", "")))
  assert env.contains("unset it") && !env.contains("logout")
  let repo = plan_kind(cli_login_plan(state(false, Some(config.Source.RepoFile("/repo/.lll.toml")), "", "")))
  assert repo.contains("/repo/.lll.toml") && !repo.contains("logout")
  // A repo token over a home token: logout alone would leave the repo one
  // winning, so the repo line comes first and logout second.
  let both = plan_kind(cli_login_plan(state(false, Some(config.Source.RepoFile("/repo/.lll.toml")), "tok", "")))
  assert both.contains("/repo/.lll.toml is not valid for this server: remove that line") && both.contains("also run 'lll logout'")
  // A logged-out home pointed at a hosted board keeps its url.
  let hosted = plan_kind(cli_login_plan(state(false, None, "", "https://lll.example.com")))
  assert hosted.contains("lll config set url http://127.0.0.1:8090")
  // A --pb-dir boot and a non-loopback bind never touch the CLI.
  assert plan_kind(cli_login_plan(CliState { throwaway: true, ..state(false, None, "", "") })) == "untouched"
  assert plan_kind(cli_login_plan(CliState { loopback: false, ..state(false, None, "", "") })) == "untouched"
}

// LLL-648, LLL-676: the banner names a proven generated administrator and
// the file holding its password, never the password; an environment pair
// is never named.
#[test]
fn the_banner_names_only_the_proven_generated_admin() {
  let Some(line) = admin_line(
    true,
    true,
    false,
    "admin@local.dev",
    "/d/.lll-admin.json",
  ) else {
    assert false
    return
  }
  assert line.starts_with(
    "admin  admin@local.dev; generated password in /d/.lll-admin.json ",
  )
  assert !line.contains("admin-local-123")
  assert admin_line(false, true, false, "e", "p").is_none()
  assert admin_line(true, false, false, "e", "p").is_none()
  assert admin_line(true, true, true, "e", "p").is_none()
}

// LLL-699: a boot that logged the CLI in closes with a prompt that names the
// team and the url and attaches before anything needs the team; any other
// boot gets only the bot hint.
#[test]
fn the_agent_prompt_follows_only_a_saved_login() {
  let saved = agent_lines(true, "ENG", "http://127.0.0.1:8090")
  assert saved.join("\n") == [
    "agent  paste this into your agent:",
    "  You're on lll team ENG at http://127.0.0.1:8090.",
    "  Run `lll attach --key ENG` in your working directory first.",
    "  Run `lll skill get software-factory` and follow it.",
    "  Claim before you edit: `lll issue next --claim`.",
    "agent  own identity: lll bot create bot-NAME --env > agent.env",
  ].join("\n")
  assert agent_lines(false, "ENG", "http://127.0.0.1:8090").join("\n") == [
    "agent  own identity: lll bot create bot-NAME --env > agent.env",
  ].join("\n")
}

// LLL-699: the prompt prints only when a command run from this shell uses
// the saved login: a shell token or a shell or repo url pointing elsewhere
// outranks it, and an agent would inherit that and fail.
#[test]
fn the_agent_prompt_needs_a_login_nothing_outranks() {
  let api = "http://127.0.0.1:8091"
  assert saved_login_reaches(api, None, api, Some(config.Source.Env("LLL_URL")))
  assert saved_login_reaches(api, None, "", None)
  assert saved_login_reaches(api, Some(config.Source.HomeFile("/h/lll.toml")), api, None)
  // The configured url moved off a taken port, but the home file chose it.
  assert saved_login_reaches(api, None, "http://127.0.0.1:8090", Some(config.Source.HomeFile("/h/lll.toml")))
  assert !saved_login_reaches(api, Some(config.Source.Env("LLL_TOKEN")), api, None)
  assert !saved_login_reaches(api, None, "http://127.0.0.1:8090", Some(config.Source.Env("LLL_URL")))
  assert !saved_login_reaches(api, None, "http://127.0.0.1:8090", Some(config.Source.RepoFile("/r/.lll.toml")))
}

// LLL-680: a boot saves its board address as web_url only into a home config
// whose url names this board's server, or none. A hosted url (and the token
// beside it) keeps its own web_url.
#[test]
fn web_url_is_saved_only_beside_this_boards_url() {
  let db = "http://127.0.0.1:8090"
  let board = "http://127.0.0.1:8100"
  assert home_names_board("", db, board)
  assert home_names_board("http://127.0.0.1:8090/", db, board)
  assert home_names_board(board, db, board)
  assert !home_names_board("https://lll.example.com", db, board)
  assert !home_names_board("http://127.0.0.1:8091", db, board)
  // Loopback spellings name one server.
  assert home_names_board("http://localhost:8090", db, board)
  assert home_names_board("http://[::1]:8100/", db, board)
  assert !home_names_board("http://localhost.example.com:8090", db, board)
}

// LLL-688 re-review: a running server is adopted only at a url the user
// chose. A repo file's url may be any listener, and adopting sends it the
// administrator pair.
#[test]
fn up_adopts_a_running_server_only_at_a_url_the_user_chose() {
  let url = "http://127.0.0.1:29733"
  let repo = Some(config.Source.RepoFile(".lll.toml"))
  let Some(why) = adopt_refusal(url, repo, "") else { panic("expected a refusal") };
  // The safe way out first; adopting is offered last, saying what it sends.
  assert why == ".lll.toml points lll up at http://127.0.0.1:29733, where a server is already running, and nothing else here chose that url
if you did not choose this url: remove the url line from .lll.toml
only if that server is yours: LLL_URL=http://127.0.0.1:29733 lll up (this sends your admin credentials to it)"
  assert adopt_refusal(url, repo, "http://127.0.0.1:8090").is_some()
  assert adopt_refusal(url, repo, "http://localhost:29733").is_some()
  // The home config names the same url (a trailing slash aside): adopted.
  assert adopt_refusal(url, repo, url).is_none()
  assert adopt_refusal(url + "/", repo, url).is_none()
  assert adopt_refusal(url, Some(config.Source.HomeFile("/h/lll.toml")), url).is_none()
  assert adopt_refusal(url, Some(config.Source.Env("LLL_URL")), "").is_none()
  assert adopt_refusal(url, Some(config.Source.Flag("--url")), "").is_none()
  assert adopt_refusal(url, Some(config.Source.Default), "").is_none()
}
