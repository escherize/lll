import "display"
import "go:strings"

import "flags"
import "models"
import "output"
import "pb"
import "writes"
import "records"

/// Every finding verb, as a value. Neither verb had a hand-written page, so
/// `page` is "" and help is generated from `spec` - and dispatch parses args
/// against `spec` before `run`, so a trailing -h never reaches the verb body.
pub fn finding_commands() -> Slice<flags.Command> {
  [
    flags.Command {
      name: "near",
      access: flags.Access.Read,
      summary: "findings about a file or directory, exact path matches first",
      spec: flags.with_team([flags.Flag { name: "--json", help: "print the findings as a JSON list", .. }]),
      positional: "<path>",
      run: finding_near,
      ..
    },
    flags.Command {
      name: "create", alias: "new",
      access: flags.Access.Write,
      summary: "file a finding: 'lll doc create -k finding' with the kind already set",
      spec: finding_new_spec(),
      positional: "[\"slug\"]",
      run: finding_new,
      ..
    },
    flags.Command {
      name: "list",
      access: flags.Access.Read,
      summary: "every finding, or one area's, one line each (slug, area, title)",
      spec: finding_list_spec(),
      run: finding_list,
      ..
    },
    flags.Command {
      name: "confirm",
      access: flags.Access.Write,
      summary: "assert a finding is fact; clears any refutation's reason",
      spec: flags.with_team([json_after_flag("the finding")]),
      positional: "SLUG",
      run: finding_confirm,
      ..
    },
    flags.Command {
      name: "refute",
      access: flags.Access.Write,
      summary: "mark a finding refuted and record why: -b why ('-b -' reads stdin)",
      spec: finding_refute_spec(),
      positional: "SLUG",
      run: finding_refute,
      ..
    },
    // Hidden (LLL-505): a finding is a doc, so 'lll doc view' is the
    // documented read. Fleet task 9 had 6/30 agents guess 'finding view', so
    // it keeps working without a help row or completion, and so does 'read'
    // (5 of 20 workers in the 1.0 fleet typed it).
    flags.Command {
      name: "view", hidden: true, hidden_alias: "read",
      access: flags.Access.Read,
      summary: "show one finding by slug; the documented spelling is 'lll doc view'",
      spec: doc_view_spec(),
      positional: "SLUG",
      run: doc_view,
      ..
    },
  ]
}

/// Prose that belongs to the noun rather than to any one verb; dispatch
/// prints it under the verb table for `lll finding --help`.
fn finding_intro() -> string {
  "Retrieve findings (docs with kind=finding) by area or path.

'near' matches by directory containment in both directions: a finding filed
on 'src/pb' answers both 'near src' and 'near src/pb/records.lis'.

Every verb accepts --team KEY for this invocation, overriding LLL_TEAM or
.lll.toml without rewriting configuration. They answer for ONE team. Every
project has a src/, so an unscoped answer would be another codebase's.

Read a finding with 'lll doc view SLUG'; --raw and --json are available.

Author findings with 'lll finding create SLUG -t \"title\" -a <area> --paths \"<paths>\"'.
`area` is conventionally the NAME of an existing label: an issue whose labels
contain the area surfaces the finding, on its web page and in
'lll issue view'. `paths` is comma-separated file or directory paths, the
coordinates 'lll finding near' matches by.

A finding is asserted (confirmed) unless you say otherwise: file a guess with
'--confidence suspected', and settle it later with 'lll finding confirm SLUG'
or 'lll finding refute SLUG -b why'. Suspected and refuted findings say so
wherever they print: a guess must not read as fact."
}

// ------------------------------------------------------------------ specs

fn finding_list_spec() -> Slice<flags.Flag> {
  flags.with_team([
    flags.Flag {
      name: "-a",
      alias: "--area",
      value: true,
      hint: "area",
      help: "only findings whose area equals this",
      ..
    },
    flags.Flag {
      name: "--search",
      alias: "",
      value: true,
      hint: "text",
      help: "only findings whose slug or title contains text",
      ..,
    },
    flags.Flag {
      name: "--path",
      value: true,
      hint: "path",
      help: "only findings about this file or directory (what 'finding near' answers)",
      ..,
    },
    flags.Flag {
      name: "--limit",
      alias: "-l",
      value: true,
      hint: "N",
      help: "list at most N findings (positive integer)",
      ..,
    },
    flags.Flag { name: "--json", help: "print the raw record list as JSON", .. },
  ])
}

// ----------------------------------------------------------------- shared

/// Does the doc's stored paths list touch the path being asked about?
fn doc_paths_touch(d: models.Doc, path: string) -> bool {
  d.paths.split(",").any(|entry| path_touches(entry, path))
}

/// Stable relevance partition: exact coordinates precede directory matches.
/// Input is already ordered by slug/id; preserve that order within each tier.
fn findings_near(findings: Slice<models.Doc>, path: string) -> Slice<models.Doc> {
  let normalized = norm_path(path)
  if normalized == "" { return [] }
  let mut exact: Slice<models.Doc> = []
  let mut nearby: Slice<models.Doc> = []
  for finding in findings {
    if finding.paths.split(",").any(|entry| norm_path(entry) == normalized) {
      exact = exact.append(finding)
    } else if doc_paths_touch(finding, normalized) {
      nearby = nearby.append(finding)
    }
  }
  exact.append(nearby...)
}

// ------------------------------------------------------------------ verbs

fn finding_near(input: flags.CommandInput) -> Result<output.Output, pb.CliError> {
  let ctx = input.ctx
  let p = input.parsed
  let path = p.first()
  if path == "" { return Err(flags.usage_error("usage: lll finding near <path>")) }
  let findings = records.fetch_findings(ctx, current_team(ctx)?.id)?
  let hits = findings_near(findings, path)
  if p.given("--json") { return list_json(docs_json(hits)?, whole_list(hits.length()), "findings") }
  // The empty state is a notice, as every list's is (LLL-645): stdout stays
  // empty for a pipe.
  if hits.is_empty() { return Ok(output.notice(f"No findings for {path}.")) }
  Ok(finding_lines(hits))
}

fn finding_list(input: flags.CommandInput) -> Result<output.Output, pb.CliError> {
  let ctx = input.ctx
  let p = input.parsed
  let area = strings.TrimSpace(p.one("-a"))
  // --search and --path exist because eight of thirty fleet agents asked
  // list for them and none reached for 'near' from here.
  let search = strings.ToLower(strings.TrimSpace(p.one("--search")))
  let path = strings.TrimSpace(p.one("--path"))
  // Issue list's --limit validation, run before any server call; the slice
  // itself happens after the filters below (LLL-313).
  let limit = limit_flag(p)?
  let mut findings = records.fetch_findings(ctx, current_team(ctx)?.id)?
  if area != "" {
    findings = findings.filter(|d| strings.TrimSpace(d.area) == area)
  }
  if search != "" {
    findings = findings.filter(|d| strings.Contains(strings.ToLower(d.slug), search) || strings.Contains(strings.ToLower(d.title), search))
  }
  if path != "" {
    findings = findings_near(findings, path)
  }
  // The fetch already pulls every finding and the filters run client-side,
  // so a limit is a post-filter slice — honest here because there is no
  // server-side page to ask for.
  if limit > 0 { findings = findings[..limit] }
  if p.given("--json") { return list_json(docs_json(findings)?, whole_list(findings.length()), "findings") }
  if findings.is_empty() { return Ok(empty_list("findings")) }
  Ok(finding_lines(findings))
}

/// One line per finding, tab-separated like 'lll doc list': slug, area,
/// title. An empty area prints as "-" so columns stay aligned. Every line
/// carries its confidence, confirmed included (1.0 fleet), so a guess cannot
/// read as fact and a fact is not left to be inferred from a missing tag.
fn finding_lines(docs: Slice<models.Doc>) -> output.Output {
  let mut out = output.none()
  for d in docs {
    let mut area = d.area
    if area == "" { area = "-" }
    out = out.line(f"{d.slug}\t{display.table_cell(area)}\t{display.table_cell(d.title)}{display.table_cell(confidence_tag(d.confidence, d.confidence_note))}")
  }
  out
}

/// A finding's confidence. Empty is confirmed: every finding written before
/// the field existed was an assertion.
fn confidence_word(confidence: string) -> string {
  if confidence == "" { "confirmed" } else { confidence }
}

/// The list tag: confidence_suffix, which leaves confirmed unmarked for the
/// board and issue view, plus " [confirmed]".
fn confidence_tag(confidence: string, note: string) -> string {
  let suffix = display.confidence_suffix(confidence, note)
  if suffix != "" { return suffix }
  f" [{confidence_word(confidence)}]"
}

/// Finding creation shares the parsed document input and supplies a domain
/// default; it does not rewrite argv and ask the parser to interpret it
/// again. The slug may arrive as the bare argument (four create verbs take
/// a positional name and finding is where the guess happened), so it is
/// resolved here, positional-or-flag, and handed to create_doc.
fn finding_new(input: flags.CommandInput) -> Result<output.Output, pb.CliError> {
  let ctx = input.ctx
  let p = input.parsed
  let verb = input.args.get(2).unwrap_or("new")
  let usage = flags.usage(f"lll finding {verb}", finding_new_spec(), "[\"slug\"]")
  let slug = flags.entity_name(p, "-s", usage)?
  create_doc(ctx, p, "finding", slug)
}

// ------------------------------------------------------------------ LLL-396

fn finding_refute_spec() -> Slice<flags.Flag> {
  flags.with_team([
    flags.Flag {
      name: "-b",
      alias: "--body",
      value: true,
      required: true,
      hint: "\"why\"",
      help: "the why it failed: what a later reader was wrong to trust\n('-b -' reads it from stdin)",
      ..,
    },
    json_after_flag("the finding"),
  ])
}

/// 'finding confirm SLUG' — a later agent asserts a guess is fact. Clearing
/// the note is the point: a confirmation carrying a refutation's reason
/// would contradict itself.
fn finding_confirm(input: flags.CommandInput) -> Result<output.Output, pb.CliError> {
  let ctx = input.ctx
  let p = input.parsed
  let slug = p.first()
  if slug == "" { return Err(flags.usage_error("usage: lll finding confirm SLUG")) }
  let team = current_team(ctx)?
  let Some(d) = records.find_doc(ctx, team, slug)? else {
    return Err(records.unknown_doc(team, slug))
  }
  patch_confidence(ctx, d, "confirmed", "")?
  doc_ending(ctx, p, d.id, f"Confirmed {d.slug}")
}

/// 'finding refute SLUG -b why' — the counterpart, and the only path that
/// sets 'refuted': a refutation is a later agent's judgement with a reason,
/// not a creation option.
fn finding_refute(input: flags.CommandInput) -> Result<output.Output, pb.CliError> {
  let ctx = input.ctx
  let p = input.parsed
  let slug = p.first()
  if slug == "" { return Err(flags.usage_error("usage: lll finding refute SLUG -b why")) }
  let why = strings.TrimSpace(value_or_stdin(p.one("-b"), "-b")?)
  if why == "" {
    return Err(pb.failed("a refutation needs the why: 'lll finding refute SLUG -b why' ('-b -' reads it from stdin)"))
  }
  let team = current_team(ctx)?
  let Some(d) = records.find_doc(ctx, team, slug)? else {
    return Err(records.unknown_doc(team, slug))
  }
  patch_confidence(ctx, d, "refuted", why)?
  doc_ending(ctx, p, d.id, f"Refuted {d.slug}")
}

/// One PATCH, two fields, on purpose nothing else: confirm/refute is a
/// judgement about the finding, never an edit of it.
fn patch_confidence(ctx: pb.Client, d: models.Doc, confidence: string, note: string) -> Result<(), pb.CliError> {
  writes.update_doc(ctx, d.id, writes.DocPatch {
    confidence: Some(confidence),
    confidence_note: Some(note),
    ..
  })
}
