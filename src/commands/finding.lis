import "go:encoding/json"
import "go:fmt"
import "go:net/url"
import "go:strings"

import "flags"
import "models"
import "pb"
import "query"

/// `lll finding` (TASK-103) — the retrieval side of docs. A finding is a doc
/// with kind=finding; `lll doc new -k finding` stays the authoring path, and
/// these verbs answer "what do we know about THIS file / area". Surfacing is
/// by area and path — a filter over kind='finding' — never full-text luck.
///
/// Dispatched through the noun's Command table (TASK-307): dispatch, `lll
/// finding --help` and shell completions all read it, so none can drift.
pub fn finding(args: Slice<string>) -> Result<(), string> {
  flags.dispatch("finding", "retrieve findings near a path", finding_intro(), finding_commands(), args)
}

/// Every finding verb, as a value. Neither verb had a hand-written page, so
/// `page` is "" and help is generated from `spec` - and dispatch parses args
/// against `spec` before `run`, so a trailing -h never reaches the verb body.
pub fn finding_commands() -> Slice<flags.Command> {
  [
    flags.Command {
      name: "near",
      summary: "findings about a file or directory",
      page: "",
      spec: [],
      positional: "<path>",
      run: finding_near,
    },
    flags.Command {
      name: "view",
      summary: "show one finding by slug - a finding is a doc, so this is 'lll doc view'",
      page: "",
      spec: doc_view_spec(),
      positional: "SLUG",
      run: doc_view,
    },
    flags.Command {
      name: "read",
      summary: "the same command as 'view'",
      page: "",
      spec: doc_view_spec(),
      positional: "SLUG",
      run: doc_view,
    },
    flags.Command {
      name: "new",
      summary: "file a finding: 'lll doc new -k finding' with the kind already set",
      page: "",
      spec: doc_new_spec(),
      positional: "",
      run: finding_new,
    },
    flags.Command {
      name: "create",
      summary: "the same command as 'new'",
      page: "",
      spec: doc_new_spec(),
      positional: "",
      run: finding_new,
    },
    flags.Command {
      name: "list",
      summary: "every finding, or one area's, one line each (slug, area, title)",
      page: "",
      spec: finding_list_spec(),
      positional: "",
      run: finding_list,
    },
  ]
}

/// Prose that belongs to the noun rather than to any one verb; dispatch
/// prints it under the verb table for `lll finding --help`.
fn finding_intro() -> string {
  "Retrieve findings (docs with kind=finding) by area or path.

'near' matches by directory containment in both directions: a finding filed
on 'src/pb' answers both 'near src' and 'near src/pb/records.lis'.

Both verbs answer for ONE team — the one LLL_TEAM or .lll.toml names. Every
project has a src/, so an unscoped answer would be another codebase's.

Author findings with 'lll doc new -k finding -a <area> -p \"<paths>\"'.
`area` is conventionally the NAME of an existing label: an issue whose labels
contain the area surfaces the finding — on its web page and in
'lll issue view'. `paths` is comma-separated file or directory paths, the
coordinates 'lll finding near' matches by."
}

// ------------------------------------------------------------------ specs

fn finding_list_spec() -> Slice<flags.Flag> {
  [
    flags.Flag {
      name: "-a",
      alias: "--area",
      value: true,
      hint: "area",
      help: "only findings whose area equals this",
      ..
    },
    flags.Flag {
      name: "--search",
      alias: "--query",
      value: true,
      hint: "text",
      help: "only findings whose slug or title contains text",
      ..,
    },
    flags.Flag {
      name: "-p",
      alias: "--path",
      value: true,
      hint: "path",
      help: "only findings about this file or directory (what 'finding near' answers)",
      ..,
    },
    flags.Flag { name: "--json", help: "print the raw record list as JSON", .. },
  ]
}

// ----------------------------------------------------------------- shared

/// One team's findings, slug order. Two clauses and no more — retrieval
/// never searches bodies or titles, it filters coordinates.
///
/// The team clause is not optional (TASK-173). Every project has a `src/`,
/// so an unscoped `finding near src/` answers with another codebase's notes,
/// formatted identically to a correct hit. Findings exist to say what is
/// known about THIS file; confidently answering about a different repo is
/// worse than answering nothing.
pub fn fetch_findings(team_id: string) -> Result<Slice<models.Doc>, string> {
  let filter = url.QueryEscape(f"kind='finding' && team={query.quote(team_id)}")
  let mut docs = models.DocList { .. }
  pb.fetch(
    f"/api/collections/docs/records?filter={filter}&sort=slug&perPage=500",
    "docs",
    &docs,
  )?
  Ok(docs.items)
}

/// Does the doc's stored paths list touch the path being asked about?
fn doc_paths_touch(d: models.Doc, path: string) -> bool {
  d.paths.split(",").any(|entry| path_touches(entry, path))
}

/// The findings related to one issue: every finding explicitly linked to it
/// (the issues relation always shows), plus every finding whose `area` names
/// one of the issue's labels. Shared by 'lll issue view' and the issue page.
pub fn findings_for_issue(issue: models.Issue) -> Result<Slice<models.Doc>, string> {
  // The ISSUE's team, not the configured one: this answers for one issue,
  // and the board can be showing an issue from a team nobody configured.
  let findings = fetch_findings(issue.team)?
  Ok(findings.filter(|d| {
    let linked = d.issues.find(|x| x == issue.id).is_some()
    let area_hit = d.area != "" && issue.expand.labels.any(|l| l.name == d.area)
    linked || area_hit
  }))
}

// ------------------------------------------------------------------ verbs

fn finding_near(args: Slice<string>) -> Result<(), string> {
  let p = flags.parse([], args, 3, true, "")?
  let path = p.first()
  if path == "" { return Err("usage: lll finding near <path>") }
  let findings = fetch_findings(current_team()?.id)?
  let hits = findings.filter(|d| doc_paths_touch(d, path))
  if hits.is_empty() {
    fmt.Println(f"No findings for {path}.")
    return Ok(())
  }
  print_finding_lines(hits)
  Ok(())
}

fn finding_list(args: Slice<string>) -> Result<(), string> {
  let spec = finding_list_spec()
  let usage = flags.usage("lll finding list", spec, "")
  let p = flags.parse(spec, args, 3, false, usage)?
  let area = strings.TrimSpace(p.one("-a"))
  // --search and -p exist because eight of thirty fleet agents asked list
  // for them and none reached for 'near' from here.
  let search = strings.ToLower(strings.TrimSpace(p.one("--search")))
  let path = strings.TrimSpace(p.one("-p"))
  let mut findings = fetch_findings(current_team()?.id)?
  if area != "" {
    findings = findings.filter(|d| strings.TrimSpace(d.area) == area)
  }
  if search != "" {
    findings = findings.filter(|d| strings.Contains(strings.ToLower(d.slug), search) || strings.Contains(strings.ToLower(d.title), search))
  }
  if path != "" {
    findings = findings.filter(|d| doc_paths_touch(d, path))
  }
  if p.given("--json") {
    let body = match json.Marshal(findings) {
      Ok(b) => b as string,
      Err(e) => return Err(f"encoding findings: {e}"),
    }
    fmt.Println(body)
    return Ok(())
  }
  if findings.is_empty() {
    fmt.Println("No findings.")
    return Ok(())
  }
  print_finding_lines(findings)
  Ok(())
}

/// One line per finding, tab-separated like 'lll doc list': slug, area,
/// title. An empty area prints as "-" so columns stay aligned.
fn print_finding_lines(docs: Slice<models.Doc>) {
  for d in docs {
    let mut area = d.area
    if area == "" { area = "-" }
    fmt.Println(f"{d.slug}\t{area}\t{d.title}")
  }
}

/// `lll finding new ...` is `lll doc new -k finding ...`: five of thirty
/// fleet agents typed the former, since the noun they were working in was
/// finding. The kind is appended unless the caller spelled one.
fn finding_new(args: Slice<string>) -> Result<(), string> {
  let mut has_kind = false
  for a in args {
    if a == "-k" || a == "--kind" || a.starts_with("-k=") || a.starts_with("--kind=") { has_kind = true }
  }
  let mut forwarded = args
  if !has_kind { forwarded = forwarded.append("-k").append("finding") }
  doc_new(forwarded)
}
