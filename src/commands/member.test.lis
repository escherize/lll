import "go:strings"

import "flags"

// Unit cover for the pure helpers in member.lis. Everything here is a
// function of its arguments alone — no PocketBase, no config.
//
// invite_lines is what the inviter forwards verbatim (TASK-217), so its
// literal shape IS the feature: a colleague who gets a paste missing --url,
// or carrying a placeholder email, comes straight back to the inviter. That
// round trip is the thing being prevented, and only an assertion on the text
// prevents it.

// ---------------------------------------------------------- invite_lines

fn joined(email: string, password: string, base: string, team: string) -> string {
  strings.Join(invite_lines(email, password, base, team), "\n")
}

#[test]
fn invite_lines_carry_the_password_url_and_email() {
  let out = joined("kim@example.com", "SECRET26", "https://tracker.example.com:8091", "ENG")
  assert strings.Contains(out, "temporary password: SECRET26")
  assert strings.Contains(
    out,
    "lll login --url https://tracker.example.com:8091 --email kim@example.com",
  )
}

/// The port is the part people drop (TASK-213's whole failure), so the login
/// line must reproduce the configured url exactly, not a tidied-up host.
#[test]
fn invite_lines_do_not_rewrite_the_configured_url() {
  let out = joined("kim@example.com", "pw", "http://127.0.0.1:8090", "ENG")
  assert strings.Contains(out, "--url http://127.0.0.1:8090 ")
}

#[test]
fn invite_lines_name_the_team_when_the_inviter_has_one() {
  let out = joined("kim@example.com", "pw", "http://127.0.0.1:8090", "ENG")
  assert strings.Contains(out, "lll attach -k ENG")
}

/// An unattached inviter must not paste a blank key: 'lll attach -k ' is a
/// command the colleague would run and be confused by.
#[test]
fn invite_lines_omit_the_key_when_no_team_is_configured() {
  let out = joined("kim@example.com", "pw", "http://127.0.0.1:8090", "")
  assert !strings.Contains(out, "-k ")
  assert strings.Contains(out, "lll attach")
}

/// The whole handoff is two commands for the colleague. Counting them is how
/// that promise stays true if the text is edited later.
#[test]
fn invite_lines_are_exactly_two_commands_for_the_colleague() {
  let lines = invite_lines("kim@example.com", "pw", "http://127.0.0.1:8090", "ENG")
  let commands = lines.filter(|l| strings.Contains(l, "lll "))
  assert commands.length() == 2
}

// ------------------------------------------------------------- real_email

#[test]
fn real_email_rejects_the_synthesized_placeholder() {
  assert !real_email(synthesize_email("Kim Ng"))
  assert !real_email("")
  assert real_email("kim@example.com")
}

#[test]
fn login_notice_distinguishes_authentication_from_comment_identity() {
  let note = login_identity_notice("alice", "bob", "file:/home/config", "/home/config")
  assert note.contains("authenticated as bob")
  assert note.contains("configured me is alice")
  assert note.contains("lll config set me bob")
  assert login_identity_notice("bob", "bob", "env:LLL_ME", "/home/config") == ""
  let env_note = login_identity_notice("alice", "bob", "env:LLL_ME", "/home/config")
  assert env_note.contains("unset LLL_ME; lll config set me bob")
  let repo_note = login_identity_notice("alice", "bob", "file:.lll.toml", "/home/config")
  assert repo_note.contains("remove or change 'me' in .lll.toml")
}

#[test]
fn identity_recovery_quotes_display_names() {
  assert cli_argument("Alice Smith") == "'Alice Smith'"
  assert cli_argument("O'Brien") == "'O'\\''Brien'"
}

// -------------------------------------------------------- member_commands

/// TASK-307: the Command table is the one declaration of every member verb.
/// Both alias spellings (TASK-130's `create`, TASK-245's `delete`) must be
/// rows of their own, or dispatch answers them "unknown member command".
#[test]
fn member_commands_declare_every_verb_and_alias() {
  let names = member_commands().map(|c| c.name)
  for want in ["list", "add", "create", "invite", "remove", "delete", "set-password"] {
    assert names.find(|n| n == want).is_some()
  }
  assert names.length() == 7
}

/// A summary is the verb's row in `lll member --help`; an empty one is a
/// blank row, which the table cannot tell from a missing verb.
#[test]
fn member_commands_all_carry_a_summary() {
  for c in member_commands() {
    assert c.summary != ""
    assert !c.summary.contains("\n")
  }
}

/// The three verbs that had hand-written pages keep them; the rest generate
/// usage + flags from spec. A page invented for `list` or `add` would replace
/// the flags block that already documents them.
#[test]
fn member_commands_keep_only_the_hand_written_pages() {
  for c in member_commands() {
    let want_page = match c.name {
      "invite" | "remove" | "delete" | "set-password" => true,
      _ => false,
    }
    assert (c.page != "") == want_page
  }
}

/// The table's spec and the completions lookup are the same flag tables, so
/// what dispatch parses is exactly what the shell completes.
#[test]
fn member_commands_specs_match_the_completion_lookup() {
  for c in member_commands() {
    assert flags.tokens(c.spec).equals(flags.tokens(member_verb_spec(c.name)))
  }
}

// TASK-309, fleet run 2: two of thirty agents typed `lll member add shard-23`
// and were refused for a bare word, while `issue create` takes a bare title.
// The table entries now admit one positional and the body falls back to it.

#[test]
fn member_add_takes_a_bare_name_and_n_still_wins() {
  let spec = member_add_spec()
  // The positional alone parses and is the name.
  let assert Ok(p) = flags.parse(spec, ["lll", "member", "add", "shard-23"], 3, true, "")
  assert p.first() == "shard-23"
  assert p.one("-n") == ""
  // -n alone still parses; the spec no longer marks it required, because the
  // body refuses only when BOTH are absent.
  let assert Ok(q) = flags.parse(spec, ["lll", "member", "add", "-n", "ada"], 3, true, "")
  assert q.one("-n") == "ada"
  // Neither: parse succeeds (nothing is required at the flag layer) and the
  // body is what says usage. Pinned here so a future 'required' does not
  // quietly reject the bare form.
  let assert Ok(r) = flags.parse(spec, ["lll", "member", "add"], 3, true, "")
  assert r.first() == "" && r.one("-n") == ""
}
