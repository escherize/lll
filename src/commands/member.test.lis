import "config"
import "pb"

import "go:strings"

import "flags"
import "models"
import "records"

// Unit cover for the pure helpers in member.lis. Everything here is a
// function of its arguments alone — no PocketBase, no config.
//
// invite_lines is what the inviter forwards verbatim (TASK-217), so its
// literal shape IS the feature: a colleague who gets a paste missing --url,
// or carrying a placeholder email, comes straight back to the inviter. That
// round trip is the thing being prevented, and only an assertion on the text
// prevents it.

// ---------------------------------------------------------- invite_base

/// The invitee's login names the board when it is known, so it discovers
/// both endpoints; an explicit --url still wins.
#[test]
fn invite_base_prefers_the_board_then_the_api() {
  assert invite_base("", "http://127.0.0.1:8090", "http://127.0.0.1:8100/") == "http://127.0.0.1:8100"
  assert invite_base("", "http://127.0.0.1:8090", "") == "http://127.0.0.1:8090"
  assert invite_base("https://host/", "http://127.0.0.1:8090", "http://127.0.0.1:8100") == "https://host"
}

// ---------------------------------------------------------- invite_lines

fn joined(email: string, password: string, base: string, team: string) -> string {
  strings.Join(invite_lines("kim", email, password, base, team), "\n")
}

#[test]
fn invite_lines_carry_the_password_url_and_email() {
  let out = joined("kim@example.com", "SECRET26", "https://tracker.example.com:8091", "ENG")
  assert strings.Contains(out, "temporary password: SECRET26")
  assert strings.Contains(
    out,
    "lll login --url https://tracker.example.com:8091 --email kim@example.com",
  )
}

/// The port is the part people drop (TASK-213's whole failure), so the login
/// line must reproduce the configured url exactly, not a tidied-up host.
#[test]
fn invite_lines_do_not_rewrite_the_configured_url() {
  let out = joined("kim@example.com", "pw", "http://127.0.0.1:8090", "ENG")
  assert strings.Contains(out, "--url http://127.0.0.1:8090 ")
}

#[test]
fn invite_lines_name_the_team_when_the_inviter_has_one() {
  let out = joined("kim@example.com", "pw", "http://127.0.0.1:8090", "ENG")
  assert strings.Contains(out, "lll attach --key ENG")
}

/// An unattached inviter must not paste a blank key: 'lll attach --key ' is a
/// command the colleague would run and be confused by.
#[test]
fn invite_lines_omit_the_key_when_no_team_is_configured() {
  let out = joined("kim@example.com", "pw", "http://127.0.0.1:8090", "")
  assert !strings.Contains(out, "-k ")
  assert strings.Contains(out, "lll attach")
}

/// The whole handoff is two commands for the colleague, plus the optional
/// password change (LLL-648). Counting them is how that promise stays true
/// if the text is edited later.
#[test]
fn invite_lines_are_two_commands_and_the_optional_password_change() {
  let lines = invite_lines("kim", "kim@example.com", "pw", "http://127.0.0.1:8090", "ENG")
  let commands = lines.filter(|l| strings.Contains(l, "lll "))
  assert commands.length() == 3
  assert lines[lines.length() - 1] == "  # to choose your own password: lll member set-password kim --old-password pw"
}

// ------------------------------------------------------------- real_email

#[test]
fn real_email_rejects_the_synthesized_placeholder() {
  assert !real_email(records.synthesize_email("Kim Ng"))
  assert !real_email("")
  assert real_email("kim@example.com")
}

#[test]
fn identity_recovery_quotes_display_names() {
  assert cli_argument("Alice Smith") == "'Alice Smith'"
  assert cli_argument("O'Brien") == "'O'\\''Brien'"
}

// -------------------------------------------------------- member_commands

/// TASK-307: the Command table is the one declaration of every member verb.
/// Both alias spellings (TASK-130's `create`, TASK-245's `delete`) must be
/// accepted aliases, without duplicate rows in help.
#[test]
fn member_commands_declare_every_verb_and_alias() {
  let names = flags.command_names(member_commands())
  for want in ["list", "add", "create", "invite", "passes", "remove", "delete", "access", "set-password"] {
    assert names.find(|n| n == want).is_some()
  }
  assert names.length() == 9
}

/// A summary is the verb's row in `lll member --help`; an empty one is a
/// blank row, which the table cannot tell from a missing verb.
#[test]
fn member_commands_all_carry_a_summary() {
  for c in member_commands() {
    assert c.summary != ""
    assert !c.summary.contains("\n")
  }
}

/// The verbs with hand-written pages keep them. `add` and `create` joined
/// them in LLL-500: the member-token prerequisite is prose the generated
/// usage+flags block never said, and their page still ends with
/// flags.section, so the flags block this test used to protect is preserved.
#[test]
fn member_commands_keep_only_the_hand_written_pages() {
  for c in member_commands() {
    let want_page = match c.name {
      "create" | "invite" | "passes" | "delete" | "access" | "set-password" => true,
      _ => false,
    }
    assert (c.page != "") == want_page
  }
}

/// The table's spec and the completions lookup are the same flag tables, so
/// what dispatch parses is exactly what the shell completes.

// TASK-309, fleet run 2: two of thirty agents typed `lll member add shard-23`
// and were refused for a bare word, while `issue create` takes a bare title.
// The table entries now admit one positional and the body falls back to it.

#[test]
fn member_add_takes_a_bare_name_and_n_still_wins() {
  let spec = member_add_spec()
  // The positional alone parses and is the name.
  let assert Ok(p) = flags.parse(spec, ["lll", "member", "add", "shard-23"], 3, true, "")
  assert p.first() == "shard-23"
  assert p.one("-n") == ""
  // -n alone still parses; the spec no longer marks it required, because the
  // body refuses only when BOTH are absent.
  let assert Ok(q) = flags.parse(spec, ["lll", "member", "add", "-n", "ada"], 3, true, "")
  assert q.one("-n") == "ada"
  // Neither: parse succeeds (nothing is required at the flag layer) and the
  // body is what says usage. Pinned here so a future 'required' does not
  // quietly reject the bare form.
  let assert Ok(r) = flags.parse(spec, ["lll", "member", "add"], 3, true, "")
  assert r.first() == "" && r.one("-n") == ""
}

// ------------------------------------------------------ set-password page

// LLL-499 (fleet case B08): a password reset retires every token minted
// before it, and the reset output said nothing about it, so an operator
// silently revoked a working person token. Help has to name the revocation
// and the re-mint; the page is pure, so its text is asserted here.
#[test]
fn set_password_page_warns_that_the_reset_revokes_earlier_tokens() {
  let page = member_set_password_page()
  assert strings.Contains(page, "rotates the member's token key")
  assert strings.Contains(page, "'lll token create NAME'")
}

// LLL-500 (fleet case B03/B06): the page has to say what the generated help
// never did, and the error has to name the working paths when the call 401s
// on an administrator-only machine.
#[test]
fn member_add_page_names_the_member_token_prerequisite() {
  let page = member_add_page()
  assert page.contains("authenticates as a MEMBER")
  assert page.contains("'lll member invite NAME --email EMAIL'")
  assert page.contains("'lll login --create'")
  // The page keeps the flags block the generated help used to be.
  assert page.contains("Flags:")
  assert page.contains("-e, --email")
}

#[test]
fn member_create_error_names_the_requirement_and_the_paths() {
  let e = pb.http_error("GET http://x/api/collections/members/records", 401, "401 Unauthorized", "nope")
  let msg = member_create_error(e)
  assert msg.message.contains("creating a member needs a member token")
  assert msg.message.contains("do not authenticate member creation")
  assert msg.message.contains("'lll login --create'")
  assert msg.message.contains("'lll member invite NAME --email EMAIL'")
  assert msg.message.contains("'lll token create NAME'")
  // A non-401 failure keeps its original message: only auth is reclassified.
  let other = pb.http_error("POST http://x", 400, "400 Bad Request", "validation")
  assert member_create_error(other) == other
}

/// LLL-679: a token the server refuses keeps its exit-6 text through
/// set-password --old-password; any other failure is not an auth failure.
#[test]
fn own_password_change_passes_auth_failures_through() {
  assert is_auth_failure(pb.fail(pb.ErrorKind.Auth, "the token in LLL_TOKEN was rejected"))
  assert !is_auth_failure(pb.fail(pb.ErrorKind.NotFound, "no such record"))
  assert !is_auth_failure(pb.failed("dial tcp: connection refused"))
}

/// Two 1.0 fleet agents (case 19) filtered 'member list' by --team: the
/// filter keeps server-wide members, pre-scope members and those scoped to it.
#[test]
fn member_list_team_filter_keeps_who_can_reach_it() {
  let fleet = models.TeamId("t1")
  let ops = models.TeamId("t2")
  assert reaches_team(None, fleet)
  assert reaches_team(Some(models.Access { reach: models.Reach.Every, mode: models.Mode.ReadOnly }), fleet)
  assert reaches_team(Some(models.Access { reach: models.Reach.Teams([fleet]), mode: models.Mode.ReadWrite }), fleet)
  assert !reaches_team(Some(models.Access { reach: models.Reach.Teams([ops]), mode: models.Mode.ReadWrite }), fleet)
}

// LLL-688: the invite probes web_url with the superuser token, so only a
// board saved for this server is ever probed or printed.
#[test]
fn an_invite_trusts_only_a_board_saved_for_its_server() {
  let a = "http://127.0.0.1:8090"
  let board = "http://127.0.0.1:8100"
  let home = Some(config.Source.HomeFile("/h/lll.toml"))
  assert board_for_server(board, home, a, a) == board
  assert board_for_server(board, Some(config.Source.Flag("--web-url")), a, "") == board
  // The home board while the url is another server's.
  assert board_for_server(board, home, "http://127.0.0.1:9999", a) == ""
  assert board_for_server(board, Some(config.Source.RepoFile("/r/.lll.toml")), a, a) == ""
  assert board_for_server(board, Some(config.Source.Env("LLL_WEB_URL")), a, a) == ""
  assert invite_base("", a, board_for_server(board, Some(config.Source.RepoFile("/r/.lll.toml")), a, a)) == a
}
