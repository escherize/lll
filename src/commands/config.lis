import "go:fmt"
import "go:encoding/json"
import "go:net/url"
import "go:os"
import "go:path/filepath"
import "go:strings"

import "config"
import "flags"
import "pb"
import "query"

/// Dispatch `lll config <verb>` through the noun's Command table (TASK-307).
/// Dispatch parses args against the verb's spec BEFORE calling it, which is
/// what stops `lll config check -h` from RUNNING the check - a network call -
/// the way the old `match verb` did when it handed a zero-arg fn nothing.
pub fn config_cmd(ctx: pb.Client, args: Slice<string>) -> Result<(), pb.CliError> {
  flags.dispatch(ctx, "config", "manage configuration", config_intro(), config_commands(), args)
}

/// Every config verb, as a value. `list` keeps `--list` as an alias: it was
/// the verb before 1.0, after `git config --list`. No verb here has a
/// hand-written page; each `page` is "" and help is the usage line plus
/// flags, generated from `spec`.
pub fn config_commands() -> Slice<flags.Command> {
  [
    flags.Command {
      name: "list",
      alias: "--list",
      summary: "every effective value and the file it came from",
      spec: [flags.Flag { name: "--json", help: "print the values as a JSON list of key, value and source", .. }],
      run: config_list,
      ..
    },
    flags.Command {
      name: "get",
      summary: "print one effective value: url, web_url, team or sort",
      spec: [],
      positional: "KEY",
      run: config_get,
      ..,
    },
    flags.Command {
      name: "check",
      summary: "check the configured lll server API",
      spec: [],
      run: config_check,
      ..
    },
    flags.Command {
      name: "init",
      summary: "write a commented .lll.toml template to the current directory",
      spec: [],
      run: config_init,
      ..
    },
    flags.Command {
      name: "set",
      summary: "save url or web_url in ~/.config/lll/lll.toml",
      spec: [],
      positional: "<url|web_url> VALUE",
      run: config_set,
      ..
    },
  ]
}

/// Prose that belongs to the noun rather than to any one verb; dispatch
/// prints it under the verb table for `lll config --help`.
fn config_intro() -> string {
  "Your token determines the member that authors comments and holds claims.
Use 'lll whoami' to check it. Save API and board endpoints with
'lll config set url URL' and 'lll config set web_url URL'.
url / LLL_URL: API base for reads and writes.
web_url / LLL_WEB_URL: board base for browser links; login discovers it when
the server advertises it. Both may use the same address.

Precedence: env vars (LLL_URL, LLL_TEAM, LLL_SORT, LLL_WEB_URL,
LLL_TOKEN) > the repo's .lll.toml > ~/.config/lll/lll.toml. The files layer:
each supplies the keys it names, so the committed repo file carries 'team' and
nothing else while 'url' and 'token' stay per-machine. 'lll attach' writes the
repo file."
}

/// Set a machine-level endpoint, without changing repo config.
fn config_set(input: flags.CommandInput) -> Result<(), pb.CliError> {
  let ctx = input.ctx
  let usage = "usage: lll config set <url|web_url> VALUE"
  if input.parsed.positional_count() != 2 { return Err(flags.usage_error(usage)) }
  let key = input.parsed.first()
  let value = strings.TrimSpace(input.parsed.nth(1))
  if value == "" { return Err(flags.usage_error(usage)) }
  if key == "url" || key == "web_url" {
    let endpoint = checked_endpoint(key, value)?
    let path = set_home_key(ctx.settings, key, endpoint)?
    fmt.Println(f"{key} = {endpoint} in {path}")
    // Re-read: the file just changed, and the note is about what wins now.
    let (cfg, src) = ctx.settings.reload().traced().map_err(pb.failed)?
    let effective = if key == "url" { cfg.url } else { cfg.web_url }
    let origin = if key == "url" { src.url } else { src.web_url }
    if effective != endpoint {
      fmt.Println(f"note: {origin} overrides this setting; 'lll config list' shows the effective configuration")
    }
    return Ok(())
  }
  Err(flags.usage_error(f"cannot set '{key}'; supported keys: url, web_url"))
}

/// Set a repo-level key in the repo's .lll.toml — the one already in play,
/// else a new one at the git root. Returns the path written. `team` is the
/// only key that belongs here: it is a fact about the repo, and so the only
/// one worth committing.
pub fn set_repo_key(settings: config.Settings, key: string, value: string) -> Result<string, pb.CliError> {
  let path = settings.repo_path()
  set_key_in(path, key, value, false)?
  Ok(path)
}

/// Set a machine-level key in ~/.config/lll/lll.toml, creating the directory
/// if needed. Returns the path written. `url` and `token` belong here: the repo
/// file is committed, and neither of those travels.
pub fn set_home_key(settings: config.Settings, key: string, value: string) -> Result<string, pb.CliError> {
  let path = settings.home_path().map_err(pb.failed)?
  let dir = filepath.Dir(path)
  if let Err(e) = os.MkdirAll(dir, 0o755) {
    return Err(pb.failed(f"creating {dir}: {e}"))
  }
  set_key_in(path, key, value, true)?
  Ok(path)
}

/// Remove every `key = ...` line from the home config — the inverse of
/// set_home_key, and exactly as narrow: `lll logout` clears the token and
/// unsets nothing else. Returns true when a line was removed. Only the home
/// file is touched — the repo's .lll.toml is committed and must never hold a
/// token, and an env var is not ours to unset.
pub fn clear_home_key(settings: config.Settings, key: string) -> Result<bool, pb.CliError> {
  let path = settings.home_path().map_err(pb.failed)?
  if !os.Stat(path).is_ok() { return Ok(false) }
  let Ok(data) = os.ReadFile(path) else {
    return Err(pb.failed(f"reading {path}"))
  }
  let mut lines: Slice<string> = []
  let mut removed = false
  for l in (data as string).split("\n") {
    if assigns(l, key) {
      removed = true
    } else {
      lines = lines.append(l)
    }
  }
  if !removed { return Ok(false) }
  let out = strings.Join(lines, "\n")
  write_home_config(path, out)?
  Ok(true)
}

/// Set `key = "value"` in `path`, creating the file if needed. Replaces an
/// existing assignment instead of appending a second one — duplicate keys
/// make the file unparseable, and the whole point of these keys is that they
/// get edited more than once.
fn set_key_in(path: string, key: string, value: string, private: bool) -> Result<(), pb.CliError> {
  let Ok(encoded) = json.Marshal(value) else { return Err(pb.failed("could not encode config value")) }
  let line = f"{key} = {encoded as string}"
  let mut text = ""
  if os.Stat(path).is_ok() {
    let Ok(data) = os.ReadFile(path) else {
      return Err(pb.failed(f"reading {path}"))
    }
    text = data as string
  }

  let mut lines: Slice<string> = []
  let mut replaced = false
  for l in text.split("\n") {
    if !replaced && assigns(l, key) {
      lines = lines.append(line)
      replaced = true
    } else {
      lines = lines.append(l)
    }
  }
  let mut out = strings.Join(lines, "\n")
  if !replaced {
    if out != "" && !strings.HasSuffix(out, "\n") { out += "\n" }
    out += line + "\n"
  }
  if private {
    write_home_config(path, out)?
  } else if let Err(e) = os.WriteFile(path, out.bytes(), 0o644) {
    return Err(pb.failed(f"writing {path}: {e}"))
  }
  Ok(())
}

/// Replace the machine config with a private (0600) temp file renamed into
/// place, so a concurrent reader sees the old file or the new one, never an
/// empty or half-written one. Login renewal (LLL-441) runs before ordinary
/// commands, so parallel agents can write here at the same moment; an
/// in-place truncate let one read an empty file and save only its token,
/// dropping url, web_url and team. Repository config does not use this.
///
/// A symlinked config (stow, chezmoi) is written through: the rename targets
/// the link's resolved file, so the link survives and its target gets the
/// new contents. A path that does not exist yet resolves to itself.
fn write_home_config(link: string, out: string) -> Result<(), pb.CliError> {
  let path = filepath.EvalSymlinks(link).unwrap_or(link)
  let file = match os.CreateTemp(filepath.Dir(path), ".lll.toml.*") {
    Ok(file) => file,
    Err(e) => return Err(pb.failed(f"creating a temp file beside {path}: {e}")),
  }
  let tmp = file.Name()
  // After a successful rename there is nothing at tmp, so this only cleans
  // up a failed write.
  defer { let _ = os.Remove(tmp) }
  defer file.Close()
  if let Err(e) = file.Chmod(0o600) {
    return Err(pb.failed(f"restricting permissions on {tmp}: {e}"))
  }
  match file.WriteString(out) {
    Partial.Ok(_) => (),
    Partial.Err(e) | Partial.Both(_, e) => return Err(pb.failed(f"writing {tmp}: {e}")),
  }
  if let Err(e) = file.Close() {
    return Err(pb.failed(f"closing {tmp}: {e}"))
  }
  if let Err(e) = os.Rename(tmp, path) {
    return Err(pb.failed(f"replacing {path}: {e}"))
  }
  Ok(())
}

/// `lll config list` — every effective value and where it came from, after
/// `git config --list --show-origin`. The failure this answers is silent: a
/// repo reading the wrong team lists the wrong issues and reports nothing, so
/// being able to ask which file won is the whole debugging affordance.
fn config_list(input: flags.CommandInput) -> Result<(), pb.CliError> {
  let ctx = input.ctx
  let (cfg, src) = ctx.settings.traced().map_err(pb.failed)?
  if input.parsed.given("--json") {
    // The token's value is a secret here too: only whether it is set.
    let tok = if cfg.token == "" { "" } else { "set" }
    let values = [
      ConfigValue { key: "url", value: cfg.url, source: src.url },
      ConfigValue { key: "team", value: cfg.team, source: src.team },
      ConfigValue { key: "sort", value: cfg.sort, source: src.sort },
      ConfigValue { key: "web_url", value: cfg.web_url, source: src.web_url },
      ConfigValue { key: "token", value: tok, source: src.token },
    ]
    return print_list_json(values, whole_list(values.length()), "config")
  }
  print_origin(src.url, "url", cfg.url)
  print_origin(src.team, "team", cfg.team)
  print_origin(src.sort, "sort", cfg.sort)
  print_origin(src.web_url, "web_url", cfg.web_url)
  // The token is a secret, so --list answers where it came from, never what
  // it is. The origin column is the debugging affordance; the value would
  // only leak into terminals and scrollback.
  let tok = if cfg.token == "" { "" } else { "••••" }
  print_origin(src.token, "token", tok)
  if let Some(warning) = committed_token_warning(ctx, src.token) {
    fmt.Println(warning)
  }
  Ok(())
}

/// One `config list --json` item. `source` is "" when the key is unset.
#[json]
struct ConfigValue { key: string, value: string, source: string }

/// `lll config get KEY` — the effective value alone, for a script to read.
/// The token is a secret, so it is refused here as in `config list`.
fn config_get(input: flags.CommandInput) -> Result<(), pb.CliError> {
  let ctx = input.ctx
  let key = input.parsed.first()
  if key == "" { return Err(flags.usage_error(f"usage: {input.usage}")) }
  let (cfg, src) = ctx.settings.traced().map_err(pb.failed)?
  let (value, origin) = match key {
    "url" => (cfg.url, src.url),
    "web_url" => (cfg.web_url, src.web_url),
    "team" => (cfg.team, src.team),
    "sort" => (cfg.sort, src.sort),
    "token" => return Err(
      pb.failed("the token is a secret and is not printed; 'lll config list' shows where it comes from"),
    ),
    other => return Err(
      flags.usage_error(f"unknown config key '{other}'; keys: url, web_url, team, sort"),
    ),
  }
  if origin == "" { return Err(pb.failed(f"{key} is not set (see 'lll config list')")) }
  fmt.Println(value)
  Ok(())
}

/// `lll config check` — one line saying whether the configured url answers as
/// a PocketBase API. The failure it exists for is a url with no port: the
/// hosted board answers on 443, so every command 404s and nothing tells you
/// the host you reached is the wrong one of the two things at that address.
/// /api/health is the endpoint because it needs no auth and no collection, so
/// a failure here is about reachability alone.
/// `_args` is unread: dispatch already parsed it (TASK-307).
fn config_check(input: flags.CommandInput) -> Result<(), pb.CliError> {
  let ctx = input.ctx
  let (cfg, src) = ctx.settings.traced().map_err(pb.failed)?
  match ctx.get("/api/health") {
    Ok(_) => fmt.Println(f"ok\t{cfg.url} answers as an lll server"),
    // The error already names the url, the status, and (for a board-shaped
    // 404) the port hint from pb.read_body. Prefixing it is all that is left.
    Err(e) => return Err(e.with_message(f"{cfg.url} is not a reachable lll server API: {e.message}")),
  }
  if let Some(warning) = committed_token_warning(ctx, src.token) {
    fmt.Println(warning)
  }
  Ok(())
}

/// The warning for a token that came from a repo `.lll.toml`, else None.
/// That file is committed, so a token in it is a secret in everyone's clone
/// and in every future checkout of the history. Naming the home config makes
/// the warning actionable rather than a scold.
fn committed_token_warning(ctx: pb.Client, source: string) -> Option<string> {
  if !strings.HasPrefix(source, "file:") { return None }
  let path = strings.TrimPrefix(source, "file:")
  let Ok(home) = ctx.settings.home_path() else {
    return None
  }
  if path == home { return None }
  Some(
    f"warning: the token comes from {path}, which is committed - move it to {home} (or LLL_TOKEN) and mint a fresh one, since this one is in the repo's history",
  )
}

fn print_origin(source: string, key: string, value: string) {
  let from = if source == "" { "unset" } else { source }
  let role = match key {
    "url" => "\tAPI base (reads and writes)",
    "web_url" => "\tboard base (browser links)",
    _ => "",
  }
  fmt.Println(f"{from}\t{key}={value}{role}")
}

/// True for an uncommented `key = ...` line. The commented keys the template
/// ships with must be left alone, or setting one would silently uncomment it.
fn assigns(line: string, key: string) -> bool {
  let trimmed = strings.TrimSpace(line)
  if !strings.HasPrefix(trimmed, key) { return false }
  strings.HasPrefix(strings.TrimSpace(strings.TrimPrefix(trimmed, key)), "=")
}

/// `lll config init`. `_args` is unread: dispatch already parsed it (TASK-307).
fn config_init(_input: flags.CommandInput) -> Result<(), pb.CliError> {
  if os.Stat(".lll.toml").is_ok() {
    return Err(pb.failed(".lll.toml already exists; not overwriting"))
  }
  let template = f"# lll configuration
# Precedence: env vars (LLL_URL, LLL_TEAM, LLL_SORT, LLL_WEB_URL,
# LLL_TOKEN) > this file > ~/.config/lll/lll.toml. The files layer: each
# supplies the keys it names, so a key left commented out here is inherited
# from the home config. 'lll config list' shows every effective value and
# the file it came from.
#
# Committed at a repo root this file should carry 'team' and nothing else.
# 'lll attach' writes exactly that. 'url' and 'token' are facts about a machine
# and its login: set them once in ~/.config/lll/lll.toml.

# lll server URL.
# url = \"http://127.0.0.1:8090\"

# Default team key. Scopes 'lll issue list' and is required by 'lll issue create'.
# team = \"ENG\"

# Default sort for 'lll issue list': {strings.Join(query.sort_fields(), ", ")};
# prefix - for descending (e.g. \"-updated\").
# sort = \"created\"

# Web board base URL, used by 'lll board' and 'lll issue url' / 'view -w'.
# web_url = \"http://127.0.0.1:8100\"

# Server auth token, sent as Authorization: Bearer on every request.
# A secret: set it in ~/.config/lll/lll.toml or LLL_TOKEN, never here:
# this file gets committed.
# token = \"\"
"
  if let Err(e) = os.WriteFile(".lll.toml", template.bytes(), 0o644) {
    return Err(pb.failed(f"writing .lll.toml: {e}"))
  }
  fmt.Println("Wrote .lll.toml")
  Ok(())
}

/// API and board base URLs must be explicit HTTP(S) endpoints, with no credentials.
fn checked_web_url(value: string) -> Result<string, pb.CliError> {
  checked_endpoint("web_url", value)
}

fn checked_endpoint(key: string, value: string) -> Result<string, pb.CliError> {
  let parsed = url.Parse(value)
  let Ok(u) = parsed else { return Err(flags.usage_error(f"{key} must be an absolute http:// or https:// URL")) }
  if (u.Scheme != "http" && u.Scheme != "https") || u.Hostname() == "" || u.User.is_some() || u.RawQuery != "" || u.Fragment != "" {
    return Err(flags.usage_error(f"{key} must be an absolute http:// or https:// URL without credentials, query or fragment"))
  }
  Ok(strings.TrimRight(value, "/"))
}
