import "go:encoding/json"
import "go:fmt"
import "go:os"
import "go:strings"

import "display"
import "models"
import "pb"

/// Print a value as JSON, the end of every `--json` command that prints one
/// record. Timestamps come out in RFC3339 (contract_json).
///
/// `what` names the value in the encoding error, the only thing that varied
/// between the commands that used to repeat these lines.
fn print_json(value: Unknown, what: string) -> Result<(), pb.CliError> {
  let raw = encode_json(value, what)?
  fmt.Println(contract_json(raw, 0) as string)
  Ok(())
}

/// The empty-state line every list prints when it has nothing to show
/// (LLL-645): "no labels" on stderr, so stdout stays empty for pipes and
/// `| wc -l`, and a person can tell an empty list from a broken read.
fn say_empty(what: string) -> Result<(), pb.CliError> {
  let _ = fmt.Fprintln(os.Stderr, f"no {what}")
  Ok(())
}

/// Where a list's items sit in the whole result, for the list envelope.
struct ListPage {
  page: int,
  per_page: int,
  total_items: int,
  total_pages: int,
}

/// A list that is fetched whole and filtered here: one page holding all of
/// it. PocketBase answers an empty list with totalPages 0; so does this.
fn whole_list(count: int) -> ListPage {
  let pages = if count == 0 { 0 } else { 1 }
  ListPage { page: 1, per_page: count, total_items: count, total_pages: pages }
}

/// One page of `per_page` from a list of `total` items, page counted from 1.
fn page_of_total(page: int, per_page: int, total: int) -> ListPage {
  let pages = if per_page < 1 { 0 } else { (total + per_page - 1) / per_page }
  ListPage { page, per_page, total_items: total, total_pages: pages }
}

#[json]
struct ListEnvelope {
  items: json.RawMessage,
  page: int,
  #[json("perPage")]
  per_page: int,
  #[json("totalItems")]
  total_items: int,
  #[json("totalPages")]
  total_pages: int,
}

/// Print a list in the one envelope every `list --json` uses (LLL-645, D2):
/// {items, page, perPage, totalItems, totalPages}, whatever the flags.
/// `items` is always an array, never null.
fn print_list_json(items: Unknown, at: ListPage, what: string) -> Result<(), pb.CliError> {
  let mut encoded = encode_json(items, what)?
  if encoded as string == "null" { encoded = "[]".bytes() as json.RawMessage }
  let envelope = ListEnvelope {
    items: contract_json(encoded, 0),
    page: at.page,
    per_page: at.per_page,
    total_items: at.total_items,
    total_pages: at.total_pages,
  }
  fmt.Println(encode_json(envelope, what)? as string)
  Ok(())
}

fn encode_json(value: Unknown, what: string) -> Result<json.RawMessage, pb.CliError> {
  match json.Marshal(value) {
    Ok(b) => Ok(b as json.RawMessage),
    Err(e) => Err(pb.failed(f"encoding {what}: {e}")),
  }
}

/// The record fields that hold a timestamp. PocketBase stores and sends them
/// as "2026-10-08 03:02:11.982Z"; the contract prints RFC3339.
fn timestamp_fields() -> Slice<string> {
  ["created", "updated", "expires", "redeemed"]
}

/// `raw` with every timestamp field, at any depth, rewritten to RFC3339.
/// Other values, and anything that does not decode, pass through unchanged.
fn contract_json(raw: json.RawMessage, depth: int) -> json.RawMessage {
  if depth > 16 { return raw }
  let text = strings.TrimSpace(raw as string)
  let mut fields = Map.new<string, json.RawMessage>()
  if text.starts_with("{") && json.Unmarshal(raw, &fields).is_ok() {
    let mut out = Map.new<string, json.RawMessage>()
    for (name, value) in fields {
      out[name] = if timestamp_fields().contains(name) { rfc3339_value(value) } else { contract_json(value, depth + 1) }
    }
    return json.Marshal(out).map_or(raw, |b| b as json.RawMessage)
  }
  let mut items: Slice<json.RawMessage> = []
  let decoded = text.starts_with("[") && json.Unmarshal(raw, &items).is_ok()
  if decoded && items.length() > 0 {
    let converted = items.map(|item| contract_json(item, depth + 1))
    return json.Marshal(converted).map_or(raw, |b| b as json.RawMessage)
  }
  raw
}

fn rfc3339_value(value: json.RawMessage) -> json.RawMessage {
  let mut stamp = ""
  if json.Unmarshal(value, &stamp).is_err() { return value }
  json.Marshal(display.rfc3339(stamp)).map_or(value, |b| b as json.RawMessage)
}

/// The claim on an issue as --json prints it (LLL-651): who holds it, under
/// which agent label, since when, and when it was last renewed.
#[json]
struct ClaimJson {
  id: models.ClaimId,
  member: models.MemberId,
  holder: string,
  agent: string,
  claimed: string,
  renewed: string,
}

fn claim_json(held: models.Claim) -> ClaimJson {
  ClaimJson {
    id: held.id,
    member: held.member,
    holder: held.expand.member.name,
    agent: held.agent,
    claimed: display.rfc3339(held.created),
    renewed: display.rfc3339(held.updated),
  }
}

/// One issue record as every issue --json prints it (LLL-645, D2): the
/// server's record with `key` ("ENG-12") and `claim` (null when unclaimed)
/// added, and timestamps in RFC3339. `record` must expand team.
fn issue_json(record: json.RawMessage, claim: Option<models.Claim>) -> Result<Map<string, json.RawMessage>, pb.CliError> {
  let mut issue = models.Issue { .. }
  if let Err(e) = json.Unmarshal(record, &issue) { return Err(pb.failed(f"decoding issue: {e}")) }
  let mut fields = Map.new<string, json.RawMessage>()
  if let Err(e) = json.Unmarshal(contract_json(record, 0), &fields) { return Err(pb.failed(f"decoding issue JSON: {e}")) }
  fields["key"] = encode_json(f"{issue.expand.team.key}-{issue.number}", "issue key")?
  fields["claim"] = match claim {
    Some(held) => encode_json(claim_json(held), "claim")?,
    None => "null".bytes() as json.RawMessage,
  }
  Ok(fields)
}

/// issue_json, printed.
fn print_issue_json(record: string, claim: Option<models.Claim>) -> Result<(), pb.CliError> {
  let fields = issue_json(record.bytes() as json.RawMessage, claim)?
  fmt.Println(encode_json(fields, "issue")? as string)
  Ok(())
}
