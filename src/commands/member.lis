/// Dispatch `lll member <verb>` through the noun's Command table (TASK-307).
/// The table is the one place a verb is declared: dispatch, `lll member
/// --help` and shell completions all read it, so none of the three can drift.
pub fn member(ctx: pb.Client, args: Slice<string>) -> Result<output.Output, pb.CliError> {
  // 1.0 fleet: one member's details live under access.
  if args.get(2) == Some("view") || args.get(2) == Some("show") {
    return Err(flags.usage_error(
      f"unknown member command: '{args.get(2).unwrap_or("")}'; did you mean 'lll member access NAME'? (it shows one member's teams and mode; 'lll member list' shows them all)",
    ))
  }
  flags.dispatch(
    ctx,
    "member",
    "work with members",
    member_intro(),
    member_commands(),
    args,
  )
}

/// Every member verb, as a value. `page` is the hand-written help invite,
/// remove and set-password already had; their former pre-parse `--help`
/// checks are gone because dispatch answers them now, and parses args against
/// `spec` before `run` so a trailing -h can never reach the verb body.
///
/// TASK-130 and TASK-245 spellings remain accepted aliases. The canonical
/// rows own help, parsing and completion flags; aliases add no help rows.
pub fn member_commands() -> Slice<flags.Command> {
  [
    flags.Command {
      name: "list",
      summary: "list members (name, email, access)",
      spec: member_list_spec(),
      run: |i| printed(member_list(i)),
      ..,
    },
    flags.Command {
      name: "create",
      alias: "add",
      summary: "add a member",
      page: member_add_page(),
      spec: member_add_spec(),
      positional: "[\"name\"]",
      run: |i| printed(member_add(i)),
      ..,
    },
    flags.Command {
      name: "invite",
      summary: "add + temp password + the lines they run (any member; the admin credentials work too)",
      page: member_invite_page(),
      spec: member_invite_spec(),
      positional: "NAME",
      run: |i| printed(member_invite(i)),
      ..,
    },
    flags.Command {
      name: "passes",
      summary: "make private, copyable human teammate tokens for a local board",
      page: member_passes_page(),
      spec: member_passes_spec(),
      run: |i| printed(member_passes(i)),
      ..,
    },
    flags.Command {
      name: "delete",
      alias: "remove",
      summary: "delete a member record ('remove' is the same command); to revoke access and keep it: member access NAME --no-teams",
      page: member_remove_page(),
      spec: member_remove_spec(),
      positional: "NAME",
      run: |i| printed(member_remove(i)),
      ..,
    },
    flags.Command {
      name: "access",
      summary: "show or change what a member can see and whether they can write; --no-teams revokes, deleting nothing",
      page: member_access_page(),
      spec: member_access_spec(),
      positional: "NAME",
      run: |i| printed(member_access_cmd(i)),
      ..,
    },
    flags.Command {
      name: "set-password",
      summary: "set a member's login password (superuser), or your own with --old-password",
      page: member_set_password_page(),
      spec: set_password_spec(),
      positional: "NAME",
      run: |i| printed(member_set_password(i)),
      ..,
    },
  ]
}

/// Prose that belongs to the noun rather than to any one verb; dispatch
/// prints it under the verb table for `lll member --help`.
fn member_intro() -> string {
  "Members authenticate with email + password. Adding one
without -e synthesizes <name>@members.invalid as its identity. Your token identifies the
member that authors your comments and holds claims.

A freshly added or imported member has a random password nobody knows;
'lll member set-password' is how a superuser gives them one, after which
'lll login' works. 'lll member invite' is those two steps plus the handoff
text, for onboarding somebody who is not here to type a password.

Who sees whom. A member with access to every team sees every member and
every email. A member limited to some teams sees only:
  - itself;
  - members that share one of its teams;
  - people (not bots) with access to every team.
It sees no email but its own. A member it cannot see answers exactly like a
member that does not exist, and issues, comments, claims and docs name them
\"hidden member\". Names stay unique across the server, so creating a member
or bot with a taken name is refused even when the owner of the name is
hidden. Because people with access to every team stay visible, a limited
member can tell that wider access exists; it cannot tell which other teams
exist ('lll team --help')."
}

fn member_list(input: flags.CommandInput) -> Result<(), pb.CliError> {
  let ctx = input.ctx
  let p = input.parsed
  let mut members = models.MemberList { items: records.fetch_members(ctx)? }
  // Team ids become keys. Ids of teams the caller cannot see stay hidden
  // and are only counted.
  let keys: mut Map<models.TeamId, string> = Map.new()
  for team in records.list_teams(ctx)?.items {
    keys[team.id] = team.key
  }
  // --team narrows to who can reach that team; two 1.0 fleet agents (case 19)
  // reached for it to find the colleague they had just scoped.
  if p.given("--team") {
    let wanted = records.normalize_team_key(p.one("--team"))
    let Some(team) = records.find_team(ctx, wanted)? else {
      return Err(pb.fail(
        pb.ErrorKind.NotFound,
        f"team {wanted} not found; 'lll team list' shows the teams you can see",
      ))
    }
    members = models.MemberList {
      items: members.items.filter(|m| reaches_team(m.access(), team.id)),
    }
  }
  if p.given("--json") {
    // team_keys beside the ids, for the teams the caller can see
    // (fleet case 12, LLL-552); the ids stay as PocketBase sent them.
    let mut items: Slice<models.Member> = []
    for m in members.items {
      let mut withkeys = m
      withkeys.team_keys = m.teams
        .filter(|id| keys.get(id).is_some())
        .map(|id| keys.get(id).unwrap_or(""))
      items = items.append(withkeys)
    }
    return print_list_json(items, whole_list(items.length()), "member list")
  }
  if members.items.is_empty() { return say_empty("members") }
  for listed in members.items {
    // A bot shows what it can do now: within its owner's access (LLL-543).
    let (effective, cap) = records.effective_access_in(listed, members.items)
    let m = listed
    let capped = cap.map_or("", |o| f" (capped by its owner, {o.name})")
    let access = member_access(effective, keys)
    let access = if access == "" { access } else { access + capped }
    if access == "" {
      fmt.Println(
        f"{display.table_cell(m.name)}\t{display.table_cell(shown_email(m))}",
      )
    } else {
      fmt.Println(
        f"{display.table_cell(m.name)}\t{display.table_cell(shown_email(m))}\t{access}",
      )
    }
  }
  Ok(())
}

/// A member's email as the caller may read it. Every member has one, so an
/// empty field means the server withheld it: a team-scoped caller reads only
/// its own (LLL-551).
fn shown_email(m: models.Member) -> string {
  if m.email == "" { "(hidden)" } else { m.email }
}

/// "rw every team (server-wide)", "ro ALPHA", "rw ALPHA, GAMMA +1 hidden", or "" when the
/// server does not report access (fleet case 03: 7 of 10 agents went to
/// 'lll api' to see a member's teams).
fn member_access(
  access: Option<models.Access>,
  keys: Map<models.TeamId, string>,
) -> string {
  let Some(a) = access else {
    return ""
  }
  if a.every_team() { return f"{a.mode.wire()} every team (server-wide)" }
  let mut named: Slice<string> = []
  let mut hidden = 0
  for id in a.team_ids() {
    match keys.get(id) {
      Some(k) => named = named.append(k),
      None => hidden += 1,
    }
  }
  let mut shown = if named.is_empty() {
    "no teams"
  } else {
    strings.Join(named, ", ")
  }
  if hidden > 0 { shown = f"{shown} +{hidden} hidden" }
  f"{a.mode.wire()} {shown}"
}

fn member_list_spec() -> Slice<flags.Flag> {
  [
    flags.Flag {
      name: "--team",
      value: true,
      hint: "KEY",
      help: "only members who can reach this team (server-wide members included)",
      ..,
    },
    flags.Flag { name: "--json", help: "print the raw record list as JSON", .. },
  ]
}

/// Whether a member's access covers `team`. A member with no recorded scope
/// predates scoped access and reaches every team.
fn reaches_team(access: Option<models.Access>, team: models.TeamId) -> bool {
  match access {
    None => true,
    Some(a) => a.every_team() || a.team_ids().contains(team),
  }
}

fn member_add_spec() -> Slice<flags.Flag> {
  [
    flags.Flag {
      name: "-n",
      alias: "--name",
      value: true,
      hint: "\"name\"",
      help: "member name",
      ..,
    },
    flags.Flag {
      name: "-e",
      alias: "--email",
      value: true,
      hint: "email",
      help: "member email",
      ..,
    },
    flags.Flag {
      name: "--password",
      value: true,
      hint: "pw",
      help: "set a usable login password with a real --email ('-' reads it from stdin);\notherwise creates a record only",
      ..,
    },
  ]
}

/// `lll member delete NAME` — delete a member nothing points at (TASK-245).
///
/// There was no removal verb at all, so every mistyped name, every test
/// account and every departed colleague stayed on the list forever. Refuses a
/// member holding assigned issues: PocketBase's relation would blank the
/// assignee silently, and "remove the account I created by accident" does not
/// mean "quietly unassign somebody's work".
///
/// Superuser-gated like set-password, because it is destructive and because
/// deleting an auth record is not something one member should do to another
/// on a shared board.
fn member_remove(input: flags.CommandInput) -> Result<(), pb.CliError> {
  let ctx = input.ctx
  let usage = input.usage
  let p = input.parsed
  let name = p.first()
  if name == "" { return Err(flags.usage_error(f"usage: {usage}")) }

  let ctx = point_at_url(ctx, p.one("--url"))?
  // Require an explicit admin login before lookup/counting. The backend also
  // restricts member deletion to superusers (LLL-341), so direct API clients
  // cannot bypass the same account boundary.
  // Env credentials count only when no token is configured (D7): otherwise
  // superuser_auth would use the member token and the server would answer a
  // bare 403.
  let login = given_admin_login(ctx.settings, p, bufio.NewReader(os.Stdin))?
  let usable = match login {
    AdminLogin.Explicit(_) => true,
    AdminLogin.Env(_) => ctx.settings.config().map_err(pb.failed)?.token == "",
    AdminLogin.Absent => false,
  }
  if !usable {
    return Err(pb.failed(
      "removing a member needs the server's admin credentials
" +
      tokens.admin_hint(),
    ))
  }
  let su = superuser_auth(ctx, login)?
  let Some(member) = records.find_member_as(ctx, su, name)? else {
    return Err(pb.fail(
      pb.ErrorKind.NotFound,
      f"no member named '{name}'; see 'lll member list'",
    ))
  }

  let references = records.count_member_references(ctx, member.id, su)?
  let assigned = references.assigned
  let authored = references.authored
  let created = references.created
  if (assigned > 0 || authored > 0 || created > 0) && !p.given("--force") {
    return Err(pb.failed(
      f"{member.name} has {assigned} issue(s) assigned and {authored} comment(s) authored, and created {created} issue(s)
reassign first: lll issue update <KEY> --assignee <somebody>
or use --force to clear assignments, comment authorship and issue creator references; issue and comment bodies are kept",
    ))
  }

  if !confirmed_on_terminal(p.given("--yes"), f"delete member {member.name}?") {
    return Err(aborted())
  }
  writes.delete_member(ctx, pb.Caller.Member(su), member.id)?
  fmt.Println(f"removed member {member.name}")
  if assigned > 0 || authored > 0 || created > 0 {
    fmt.Println(
      f"cleared {assigned} issue assignment(s) and {authored} comment author reference(s), plus {created} issue creator reference(s); issue and comment bodies kept",
    )
  }
  Ok(())
}

fn member_remove_spec() -> Slice<flags.Flag> {
  with_admin_flags([
    flags.Flag {
      name: "--force",
      help: "clear assignments, comment authorship and creator references; keep issue/comment bodies",
      ..,
    },
    flags.Flag {
      name: "--yes",
      help: "skip the delete confirmation (asked only on a terminal)",
      ..,
    },
    flags.Flag {
      name: "--url",
      value: true,
      hint: "url",
      help: "server base url; without it the configured one",
      ..,
    },
  ])
}

/// The hand-written page for `lll member delete` (and its `delete` alias).
/// The usage line is generated from the spec so it cannot drift from what
/// the parser accepts.
fn member_remove_page() -> string {
  let usage = flags.usage("lll member delete", member_remove_spec(), "NAME")
  "lll member delete - remove a member with reference checks

Usage:
  " +
  usage +
  "

Refuses a member with assigned issues, authored comments or issue creator references. Reassign issues
first ('lll issue update KEY --assignee SOMEBODY'), or use --force to clear
assignments, comment authorship and creator references. Issue and comment bodies are kept.
Authenticates as the superuser, exactly like 'lll member set-password'." +
  flags.section(member_remove_spec())
}

/// The hand-written page for `lll member create` and `create` (LLL-500). The
/// member-token prerequisite is the part a first-time operator cannot guess:
/// the admin bootstrap pair authenticates the admin UI and the superuser
/// verbs, not this one. Ends with flags.section so the flags block that used
/// to be the whole help is still there.
fn member_add_page() -> string {
  let spec = member_add_spec()
  let usage = flags.usage("lll member create", spec, "[NAME]")
  f"lll member create - add a member record

Usage:
  {usage}

Creates a member with a real --email, or a synthesized @members.invalid one.
This call authenticates as a MEMBER: the token in LLL_TOKEN or the home
config. The server's administrator credentials (LLL_ADMIN_EMAIL/
LLL_ADMIN_PASSWORD) do not authenticate it. From an administrator-only
machine, use 'lll member invite NAME --email EMAIL' (it accepts
--admin-email/--admin-password), or make a first member login with
'lll login --create'. With --password the member can log in at once;
otherwise an administrator enables login later with 'lll member set-password'.

This makes people, not bots: the bot- prefix is reserved. For an agent, run
'lll bot create bot-NAME', which makes a bot member you own and prints its
token once in a prompt to paste into the agent. A bot cannot create bots;
agents sharing one bot tell their sessions apart with --agent NAME." +
  flags.section(spec)
}

/// The refusal when member add/create cannot authenticate (LLL-500). The
/// members collection's createRule needs a member token, and the machines
/// that hit this hold only the admin bootstrap pair: name the requirement,
/// then the two paths that actually work from there. The boundary is
/// PocketBase's; this only says what it is.
fn member_create_error(e: pb.CliError) -> pb.CliError {
  // Scoped and read-only members fail the members create rule, which
  // PocketBase answers with a bare 400 (scoped-access fleet case 09: 4 of
  // 10 got nothing more). A validation failure carries field data, and a
  // gopb refusal (the bot- prefix) its own message; both pass through.
  if e.status == 400 && e.message == "Failed to create record." {
    return pb.fail(
      pb.ErrorKind.Refused,
      "your token cannot add members: only a member with read-write access to every team, or administrator credentials ('lll member invite NAME --email E' with LLL_ADMIN_EMAIL/LLL_ADMIN_PASSWORD), can
for your own agent, a read-write member runs 'lll bot create bot-NAME' (a bot it owns); a read-only member cannot, so ask whoever invited you",
    )
  }
  if e.status == 401 {
    return pb.fail(
      pb.ErrorKind.Auth,
      "creating a member needs a member token: the one configured here is missing or was refused
administrator credentials (LLL_ADMIN_EMAIL/LLL_ADMIN_PASSWORD) do not authenticate member creation
paths forward: 'lll login --create' makes a first member login with the admin credentials; 'lll member invite NAME --email EMAIL' creates the member from the admin side; 'lll token create NAME' mints an agent token for an existing member",
    )
  }
  e
}

fn member_add(input: flags.CommandInput) -> Result<(), pb.CliError> {
  let ctx = input.ctx
  let args = input.args
  let spec = member_add_spec()
  // The usage line echoes the verb the user actually typed, so somebody who
  // reached this through the TASK-130 `create` alias is not told to rerun a
  // command they did not run.
  let verb = args.get(2).unwrap_or("create")
  let usage = flags.usage(f"lll member {verb}", spec, "[NAME]")
  let p = input.parsed
  let name = flags.entity_name(p, "-n", usage)?
  let email = p.one("-e")
  // The server reserves bot- names to bots (gopb checkMemberKind); a
  // scoped member trying this got a bare 400 (fleet case 09). Name the
  // command that makes one before any server call.
  if strings.HasPrefix(name, "bot-") {
    return Err(pb.failed(
      f"'{name}' is a bot name: the bot- prefix is reserved to bot members
a read-write member creates it with 'lll bot create {name}' (owned by you, never more access than you have); a read-only member cannot create bots, so ask whoever invited you",
    ))
  }

  // LLL-500 (fleet case B03/B06): a first-time LAN operator's only
  // credentials are the admin bootstrap pair, and this call's 401 arrived as
  // a raw PocketBase dump that never said member creation authenticates as a
  // MEMBER. Classify here, where the verb is known; the boundary itself is
  // unchanged, only the message.
  let found = match records.find_member(ctx, name) {
    Ok(found) => found,
    Err(e) => return Err(member_create_error(e)),
  }
  if let Some(existing) = found {
    return Err(pb.failed(
      f"a member named '{name}' already exists <{existing.email}>; pick another name",
    ))
  }
  let password = if p.given("--password") {
    let mut input = bufio.NewReader(os.Stdin)
    let typed = secret.Secret.read(p, "--password", f"Password for {name}: ", input)?
    Some(typed.confirmed(p, "--password", input)?)
  } else {
    None
  }
  if password.map_or(false, |pw| pw.is_empty() || !real_email(email)) {
    return Err(flags.usage_error(
      "--password requires a nonempty password and a real --email; use 'lll member invite NAME --email EMAIL' for a generated login handoff",
    ))
  }
  let created = if let Some(pw) = password {
    match create_member_as(ctx, ctx.token(), name, email, pw.reveal(), [], None) {
      Ok(created) => created,
      Err(e) => return Err(member_create_error(e)),
    }
  } else {
    match create_member(ctx, name, email) {
      Ok(created) => created,
      Err(e) => return Err(member_create_error(e)),
    }
  }
  fmt.Println(f"Added member {created.name}")
  if p.given("--password") {
    fmt.Println(
      f"login enabled: lll login --email {email} --url {(ctx.settings.config().map_err(pb.failed)?).url} (use the supplied password)",
    )
  } else {
    fmt.Println(
      f"record only: no known login password. An administrator can enable login with 'lll member set-password {name} --email EMAIL --password PASSWORD'. For a new colleague, use 'lll member invite NAME --email EMAIL' instead.",
    )
  }
  Ok(())
}

/// Create a member. Names are unique server-side, so callers that may race
/// or repeat check with find_member first. Email is required by the auth
/// collection: without -e, one is synthesized from the name — the same
/// @members.invalid rule the TASK-180 migration used to backfill. The random
/// password satisfies PB's create validation; it is never shown or reused.
pub fn create_member(
  ctx: pb.Client,
  name: string,
  email: string,
) -> Result<models.Member, pb.CliError> {
  create_member_as(ctx, ctx.token(), name, email, rand.Text(), [], None)
}

/// create_member, riding `tok` and a caller-chosen password. Invite needs
/// both: it authenticates as the superuser before it creates anything (the
/// members collection's createRule is `@request.auth.id != ""`, so an inviter
/// whose only credential is LLL_ADMIN_* would otherwise POST anonymously and
/// get a bare 400), and the password it hands the colleague has to be the one
/// the record is created with.
fn create_member_as(
  ctx: pb.Client,
  tok: string,
  name: string,
  email: string,
  password: string,
  teams: Slice<models.TeamId>,
  mode: Option<models.Mode>,
) -> Result<models.Member, pb.CliError> {
  let member_email = if email == "" {
    records.synthesize_email(name)
  } else {
    email
  }
  // Unscoped creates send no scope and get the creator's ("all").
  let scope = if teams.is_empty() { "" } else { "teams" }
  let new_member = models.NewMember {
    name,
    email: member_email,
    password,
    password_confirm: password,
    email_visibility: true,
    // PB selects have no schema-level default, so the CLI states the kind:
    // everything but `lll bot` is a person (LLL-407).
    kind: models.MemberKind.Person.wire(),
    owner: None,
    scope,
    teams,
    // None lets the server fill in the creator's ("rw").
    mode: mode.map_or("", |m| m.wire()),
  }
  let body = writes.create_member(ctx, pb.Caller.Member(tok), new_member)?

  let mut created = models.Member { .. }
  if let Err(e) = json.Unmarshal(body.bytes(), &created) {
    return Err(pb.failed(f"decoding created member: {e}"))
  }
  Ok(created)
}

/// True when the server already has a member by that name.
pub fn member_exists(ctx: pb.Client, name: string) -> Result<bool, pb.CliError> {
  Ok(records.find_member(ctx, name)?.is_some())
}

/// Create the member if the server does not have one by that name. Returns
/// true when it created one.
///
/// Used by up while it still holds superuser authority. Normal configuration
/// never creates a member. The board receives a member token after this step.
pub fn ensure_member(ctx: pb.Client, name: string) -> Result<bool, pb.CliError> {
  if name == "" { return Ok(false) }
  let existing = records.find_member(ctx, name)?
  if existing.is_some() { return Ok(false) }
  // Two actors seeding the same fresh server race here: both find nothing,
  // both POST. The unique name (and now email) indexes admit one and reject
  // the other, and the loser re-looks-up whoever won instead of failing the
  // boot — the same bargain ensure_team and e2e.sh's seed_team run.
  match create_member(ctx, name, "") {
    Ok(_) => Ok(true),
    Err(_) => {
      let raced = records.find_member(ctx, name)?
      if raced.is_some() { return Ok(false) }
      Err(pb.failed(
        f"could not create member '{name}' and none exists to reuse",
      ))
    },
  }
}

/// "read-only, team ALPHA", "read-write, teams ALPHA, GAMMA",
/// "read-write, every team (server-wide)", "read-only, no teams". One wording for whoami,
/// invite and access.
fn describe_access(access: models.Access, keys: Slice<string>) -> string {
  let m = if access.mode.writes() { "read-write" } else { "read-only" }
  if access.every_team() { return f"{m}, every team (server-wide)" }
  if keys.is_empty() { return f"{m}, no teams" }
  let noun = if keys.length() == 1 { "team" } else { "teams" }
  f"{m}, {noun} {strings.Join(keys, ", ")}"
}

fn member_access_spec() -> Slice<flags.Flag> {
  with_admin_flags([
    flags.Flag {
      name: "--team",
      value: true,
      hint: "KEY",
      repeat: true,
      help: "limit them to exactly these teams (repeat for more); replaces their teams",
      ..,
    },
    flags.Flag {
      name: "--add-team",
      value: true,
      hint: "KEY",
      repeat: true,
      help: "also give them this team, keeping the others",
      ..,
    },
    flags.Flag {
      name: "--remove-team",
      value: true,
      hint: "KEY",
      repeat: true,
      help: "take this team away, keeping the others; removing the last leaves them seeing nothing",
      ..,
    },
    flags.Flag { name: "--all-teams", help: "let them see every team", .. },
    flags.Flag {
      name: "--no-teams",
      help: "revoke: they see nothing, and their comments and issues stay",
      ..,
    },
    flags.Flag {
      name: "--read-only",
      alias: "--ro",
      help: "they can read but not change anything",
      ..,
    },
    flags.Flag {
      name: "--read-write",
      help: "they can change things in the teams they see",
      ..,
    },
  ])
}

fn member_access_page() -> string {
  "lll member access - show or change what a member can see and whether they can write

Usage:
  lll member access NAME                       show it
  lll member access NAME --team ALPHA          limit them to ALPHA
  lll member access NAME --add-team GAMMA      also GAMMA
  lll member access NAME --remove-team GAMMA   no longer GAMMA
  lll member access NAME --read-only           reads only
  lll member access NAME --no-teams            revoke (nothing is deleted)
  lll member access NAME --all-teams --read-write

Showing access works with any token. Changing it needs administrator
credentials (--admin-email/--admin-password, or LLL_ADMIN_EMAIL and
LLL_ADMIN_PASSWORD when no token is configured), the same gate as 'lll member invite': no member or bot
token can change anyone's access, its own included. Revoking keeps the member
and everything they wrote; 'lll member delete' deletes the member instead.
" +
  flags.section(member_access_spec())
}

/// `lll member access NAME [changes]`. Fleet case 04: 10 of 10 agents could
/// not make a member read-only with any lll command, and 7 patched the
/// record through 'lll api' instead. Cases 06-08 (narrow, widen, revoke)
/// need the same verb.
fn member_access_cmd(input: flags.CommandInput) -> Result<(), pb.CliError> {
  let ctx = input.ctx
  let p = input.parsed
  let name = p.first()
  if name == "" {
    return Err(flags.usage_error(
      "usage: lll member access NAME [--team KEY]... [--add-team KEY] [--remove-team KEY] [--all-teams|--no-teams] [--read-only|--read-write]",
    ))
  }
  let Some(m) = records.find_member(ctx, name)? else {
    return Err(pb.fail(
      pb.ErrorKind.NotFound,
      f"no member named '{name}'; see 'lll member list'",
    ))
  }
  let teams = records.list_teams(ctx)?.items
  let key_of = |id: models.TeamId| teams
    .find(|t| t.id == id)
    .map_or(id.string(), |t| t.key)
  let before = describe_access(
    recorded_access(m),
    recorded_access(m).team_ids().map(key_of),
  )
  let set_teams = p.given("--team") || p.given("--all-teams") ||
  p.given("--no-teams")
  let edit_teams = p.given("--add-team") || p.given("--remove-team")
  let set_mode = p.given("--read-only") || p.given("--read-write")
  if !set_teams && !edit_teams && !set_mode {
    fmt.Println(f"{m.name}: {before}")
    print_owner_cap(ctx, m, key_of)?
    return Ok(())
  }
  let given = [
      p.given("--team"),
      p.given("--all-teams"),
      p.given("--no-teams"),
      edit_teams,
    ].filter(
    |g| g,
  )
  if given.length() > 1 {
    return Err(flags.usage_error(
      "give one of --team, --all-teams, --no-teams, or --add-team/--remove-team",
    ))
  }
  if p.given("--read-only") && p.given("--read-write") {
    return Err(flags.usage_error("give --read-only or --read-write, not both"))
  }
  let id_of = |key: string| -> Result<models.TeamId, pb.CliError> {
    let k = records.normalize_team_key(key)
    let Some(t) = teams.find(|t| t.key == k) else {
      return Err(records.unknown_team(ctx, k))
    }
    Ok(t.id)
  }
  // Administrator credentials only: the members rules refuse every member
  // and bot token, so an agent on someone's token cannot widen a guest or
  // narrow its owner.
  let su = superuser_auth(ctx, given_admin_login(ctx.settings, p, bufio.NewReader(os.Stdin))?)?
  // The record as the administrator reads it: a team-scoped configured token
  // reads a member without the teams it cannot see (LLL-551), and editing
  // that copy would drop them.
  let m = records.find_member_as(ctx, su, name)?.unwrap_or(m)
  let current = recorded_access(m)
  let before = describe_access(current, current.team_ids().map(key_of))
  let mut reach = current.reach
  if p.given("--all-teams") {
    reach = models.Reach.Every
  } else if p.given("--no-teams") {
    reach = models.Reach.Teams([])
  } else if p.given("--team") {
    let mut ids: Slice<models.TeamId> = []
    for k in p.all("--team") {
      ids = ids.append(id_of(k)?)
    }
    reach = models.Reach.Teams(ids)
  } else if edit_teams {
    if current.every_team() {
      return Err(pb.failed(
        f"{m.name} sees every team; limit them first with --team KEY, then add or remove",
      ))
    }
    let mut ids = current.team_ids()
    for k in p.all("--add-team") {
      let id = id_of(k)?
      if !ids.contains(id) { ids = ids.append(id) }
    }
    for k in p.all("--remove-team") {
      let id = id_of(k)?
      ids = ids.filter(|x| x != id)
    }
    reach = models.Reach.Teams(ids)
  }
  let mut mode = current.mode
  if p.given("--read-only") { mode = models.Mode.ReadOnly }
  if p.given("--read-write") { mode = models.Mode.ReadWrite }
  let wanted = models.Access { reach, mode }
  let patch = writes.MemberPatch {
    scope: Some(wanted.scope_wire()),
    teams: Some(wanted.team_ids()),
    mode: Some(wanted.mode.wire()),
    ..,
  }
  if let Err(e) = writes.update_member(ctx, pb.Caller.Member(su), m.id, patch) {
    // gopb checkOwner's refusal names its own fix (LLL-543).
    if e.has_code(pb.ServerCode.BotExceedsOwner) { return Err(e) }
    let status = e.status
    if status == 400 || status == 403 || status == 404 {
      return Err(pb.fail(
        pb.ErrorKind.Refused,
        "changing access needs administrator credentials: " +
        tokens.admin_hint() +
        ". A member or bot token cannot change anyone's access, its own included.",
      ))
    }
    return Err(e)
  }
  let after = describe_access(wanted, wanted.team_ids().map(key_of))
  if after == before {
    fmt.Println(f"{m.name}: {after} (unchanged)")
  } else {
    fmt.Println(f"{m.name}: {after} (was {before})")
  }
  print_owner_cap(ctx, m.with_access(wanted), key_of)
}

/// A member's recorded access. A record from a server before scoped
/// members (LLL-542) carries none, which that server meant as read-write
/// with no team list to show.
fn recorded_access(m: models.Member) -> models.Access {
  m
    .access()
    .unwrap_or(
      models.Access {
        reach: models.Reach.Teams([]),
        mode: models.Mode.ReadWrite,
      },
    )
}

/// For a bot whose owner's access is narrower than its own, the access it
/// actually has and why (LLL-543). Prints nothing otherwise.
/// A team-scoped caller may see a bot but not its owner (LLL-551): the owner
/// then reads as missing, and the cap is not this caller's to know.
fn print_owner_cap(
  ctx: pb.Client,
  m: models.Member,
  key_of: fn(models.TeamId) -> string,
) -> Result<(), pb.CliError> {
  let (eff, cap) = match records.effective_access(ctx, m) {
    Ok(found) => found,
    Err(e) => {
      if e.status == 404 { return Ok(()) }
      return Err(e)
    },
  }
  if let (Some(owner), Some(e)) = (cap, eff) {
    fmt.Println(
      f"  effective: {describe_access(e, e.team_ids().map(key_of))} (capped by its owner, {owner.name})",
    )
  }
  Ok(())
}

/// A line for the inviter, not the colleague: stderr, so that
/// 'lll member invite ... > handoff.txt' captures exactly what to send
/// (fleet case 11: 8 of 10 agents retyped the handoff, password included,
/// because the status lines were mixed into it).
fn status(line: string) {
  let _ = fmt.Fprintln(os.Stderr, line)
}
