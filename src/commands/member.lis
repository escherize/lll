import "go:bufio"
import "go:encoding/json"
import "go:crypto/rand"
import "go:fmt"
import "go:net/url"
import "go:os"
import "go:strings"

import "models"
import "pb"
import "flags"
import "config"
import "query"

/// Dispatch `lll member <verb>` through the noun's Command table (TASK-307).
/// The table is the one place a verb is declared: dispatch, `lll member
/// --help` and shell completions all read it, so none of the three can drift.
pub fn member(args: Slice<string>) -> Result<(), string> {
  flags.dispatch("member", "work with members", member_intro(), member_commands(), args)
}

/// Every member verb, as a value. `page` is the hand-written help invite,
/// remove and set-password already had; their former pre-parse `--help`
/// checks are gone because dispatch answers them now, and parses args against
/// `spec` before `run` so a trailing -h can never reach the verb body.
///
/// `create` and `delete` are second entries onto the same run fn. TASK-130:
/// every sibling noun creates with `create` (label create -n, project create
/// -n, team create -k, issue create -t), so member was the odd one out and a
/// seed script guesses `create` every time. `add` and `remove` stay the
/// documented spellings.
pub fn member_commands() -> Slice<flags.Command> {
  [
    flags.Command {
      name: "list",
      summary: "list members (name, email)",
      page: "",
      spec: member_list_spec(),
      positional: "",
      run: member_list,
    },
    flags.Command {
      name: "add",
      summary: "add a member ('create' is the same command)",
      page: "",
      spec: member_add_spec(),
      positional: "[\"name\"]",
      run: member_add,
    },
    flags.Command {
      name: "create",
      summary: "add a member (the same command as 'add')",
      page: "",
      spec: member_add_spec(),
      positional: "[\"name\"]",
      run: member_add,
    },
    flags.Command {
      name: "invite",
      summary: "add + temp password + the lines they run (any member; the admin credentials work too)",
      page: member_invite_page(),
      spec: member_invite_spec(),
      positional: "NAME",
      run: member_invite,
    },
    flags.Command {
      name: "remove",
      summary: "remove a member; guard assignments and comments ('delete' is the same command)",
      page: member_remove_page(),
      spec: member_remove_spec(),
      positional: "NAME",
      run: member_remove,
    },
    flags.Command {
      name: "delete",
      summary: "remove a member; guard assignments and comments (the same command as 'remove')",
      page: member_remove_page(),
      spec: member_remove_spec(),
      positional: "NAME",
      run: member_remove,
    },
    flags.Command {
      name: "set-password",
      summary: "set a member's login password (superuser only)",
      page: member_set_password_page(),
      spec: set_password_spec(),
      positional: "NAME",
      run: member_set_password,
    },
  ]
}

/// Prose that belongs to the noun rather than to any one verb; dispatch
/// prints it under the verb table for `lll member --help`.
fn member_intro() -> string {
  "Members are PocketBase auth records (email + password; TASK-180). Adding one
without -e synthesizes <name>@members.invalid as its identity. Your token identifies the
member that authors your comments; configured 'me' must agree.

A freshly added or imported member has a random password nobody knows;
'lll member set-password' is how a superuser gives them one, after which
'lll login' works. 'lll member invite' is those two steps plus the handoff
text, for onboarding somebody who is not here to type a password."
}

fn member_list(input: flags.CommandInput) -> Result<(), string> {
  let p = input.parsed
  let mut members = models.MemberList { .. }
  pb.fetch(
    "/api/collections/members/records?perPage=200&sort=name",
    "members",
    &members,
  )?
  if p.given("--json") {
    let body = match json.Marshal(members) {
      Ok(b) => b as string,
      Err(e) => return Err(f"encoding member list: {e}"),
    }
    fmt.Println(body)
    return Ok(())
  }
  for m in members.items {
    fmt.Println(f"{m.name}\t{m.email}")
  }
  Ok(())
}

fn member_list_spec() -> Slice<flags.Flag> {
  [flags.Flag { name: "--json", help: "print the raw record list as JSON", .. }]
}

fn member_add_spec() -> Slice<flags.Flag> {
  [
    flags.Flag { name: "-n", alias: "--name", value: true, hint: "\"name\"", help: "member name", .. },
    flags.Flag { name: "-e", alias: "--email", value: true, hint: "email", help: "member email", .. },
    flags.Flag { name: "--password", value: true, hint: "pw", help: "set a usable login password with a real --email; otherwise creates a record only", .. },
  ]
}

fn member_invite_spec() -> Slice<flags.Flag> {
  with_admin_flags([
    flags.Flag {
      name: "--url",
      value: true,
      hint: "url",
      help: "server base url; without it the configured one (LLL_URL, 'url' in .lll.toml)",
      ..,
    },
    flags.Flag {
      name: "--email",
      alias: "-e",
      value: true,
      hint: "email",
      required: true,
      help: "the colleague's real email; it is the identity 'lll login' asks for",
      ..,
    },
  ])
}

fn set_password_spec() -> Slice<flags.Flag> {
  with_admin_flags([
    flags.Flag {
      name: "--password",
      alias: "-p",
      value: true,
      hint: "pw",
      help: "the new password; omit to be prompted twice",
      ..,
    },
    flags.Flag {
      name: "--url",
      value: true,
      hint: "url",
      help: "server base url; without it the configured one (LLL_URL, 'url' in .lll.toml)",
      ..,
    },
    flags.Flag {
      name: "--email",
      value: true,
      hint: "email",
      help: "real email to set alongside the password; required when the member has only a synthesized one",
      ..,
    },
  ])
}


/// `lll member remove NAME` — delete a member nothing points at (TASK-245).
///
/// There was no removal verb at all, so every mistyped name, every test
/// account and every departed colleague stayed on the list forever. Refuses a
/// member holding assigned issues: PocketBase's relation would blank the
/// assignee silently, and "remove the account I created by accident" does not
/// mean "quietly unassign somebody's work".
///
/// Superuser-gated like set-password, because it is destructive and because
/// deleting an auth record is not something one member should do to another
/// on a shared board.
fn member_remove(input: flags.CommandInput) -> Result<(), string> {
  let spec = member_remove_spec()
  let usage = flags.usage("lll member remove", spec, "NAME")
  let p = input.parsed
  let name = p.first()
  if name == "" { return Err(f"usage: {usage}") }

  point_at_url(p.one("--url"))?
  apply_admin_flags(p.one("--admin-email"), p.one("--admin-password"))?
  // Require an explicit admin login before lookup/counting. The backend also
  // restricts member deletion to superusers (LLL-341), so direct API clients
  // cannot bypass the same account boundary.
  if os.Getenv("LLL_ADMIN_EMAIL") == "" || os.Getenv("LLL_ADMIN_PASSWORD") == "" {
    return Err(
      "removing a member needs the server's admin credentials
pass --admin-email and --admin-password, or set LLL_ADMIN_EMAIL/LLL_ADMIN_PASSWORD",
    )
  }
  let su = superuser_auth()?
  let Some(member) = find_member_as(su, name)? else {
    return Err(f"no member named '{name}' — see 'lll member list'")
  }

  let references = member_references(member.id, su)?
  let assigned = references.assigned
  let authored = references.authored
  if (assigned > 0 || authored > 0) && !p.given("--force") {
    return Err(
      f"{member.name} has {assigned} issue(s) assigned and {authored} comment(s) authored
reassign first: lll issue update <KEY> --assignee <somebody>
or use --force to clear assignments and comment authorship; comment bodies are kept",
    )
  }

  let _ = pb.delete_as(f"/api/collections/members/records/{member.id}", su)?
  fmt.Println(f"removed member {member.name}")
  if assigned > 0 || authored > 0 {
    fmt.Println(f"cleared {assigned} issue assignment(s) and {authored} comment author reference(s); comment bodies kept")
  }
  Ok(())
}

fn member_remove_spec() -> Slice<flags.Flag> {
  with_admin_flags([
    flags.Flag { name: "--force", help: "clear assignments and comment authorship; keep comment bodies", .. },
    flags.Flag {
      name: "--url",
      value: true,
      hint: "url",
      help: "server base url; without it the configured one",
      ..,
    },
  ])
}

/// The hand-written page for `lll member remove` (and its `delete` alias).
/// The usage line is generated from the spec so it cannot drift from what
/// the parser accepts.
fn member_remove_page() -> string {
  let usage = flags.usage("lll member remove", member_remove_spec(), "NAME")
  "lll member remove - remove a member with reference checks

Usage:
  " + usage + "

Refuses a member with assigned issues or authored comments. Reassign issues
first ('lll issue update KEY --assignee SOMEBODY'), or use --force to clear
assignments and comment authorship. Comment bodies are kept.
Authenticates as the superuser, exactly like 'lll member set-password'." + flags.section(member_remove_spec())
}

/// Point this process at `url` for the rest of the command, when one was
/// given. The gated helpers all read the configured url; setting the env var
/// is how a flag reaches them without threading a base argument through
/// superuser_auth, find_member_as and create_member_as.
fn point_at_url(given: string) -> Result<(), string> {
  let base = strings.TrimSuffix(strings.TrimSpace(given), "/")
  if base == "" { return Ok(()) }
  if !strings.HasPrefix(base, "http://") && !strings.HasPrefix(base, "https://") {
    return Err(
      f"--url must be a full base url starting with http:// or https:// (got '{base}')",
    )
  }
  if let Err(e) = os.Setenv("LLL_URL", base) {
    return Err(f"pointing at {base}: {e}")
  }
  Ok(())
}

/// `lll member set-password NAME` — the superuser gives a member login
/// credentials (TASK-203). Needed because created and imported members carry
/// a random password nobody knows, so 'lll login' is a dead door until this
/// runs. Gated exactly like token create: LLL_ADMIN_* env credentials, or a
/// configured superuser token.
fn member_set_password(input: flags.CommandInput) -> Result<(), string> {
  let spec = set_password_spec()
  let usage = flags.usage("lll member set-password", spec, "NAME")
  let p = input.parsed
  let name = p.first()
  if name == "" {
    return Err(f"usage: {usage}")
  }

  point_at_url(p.one("--url"))?
  apply_admin_flags(p.one("--admin-email"), p.one("--admin-password"))?
  let su = superuser_auth()?
  let found = find_member_as(su, name)?
  let Some(member) = found else {
    return Err(f"no member named '{name}' — see 'lll member add'")
  }

  // The email IS the login identity. A member carrying only the synthesized
  // @members.invalid placeholder has nothing a human can honestly type, so
  // setting a password without fixing the email would leave login broken —
  // the exact dead end this command exists to remove.
  let email = strings.TrimSpace(p.one("--email"))
  if email == "" && !real_email(member.email) {
    return Err(
      f"member '{name}' has no real email (only the synthesized {member.email}), and the email is what 'lll login' asks for
rerun with --email <email> to set one alongside the password",
    )
  }

  // A flag, not only the two prompts: provisioning a colleague from a script
  // or a deploy step had no non-interactive path at all (TASK-246), and the
  // pipe form was documented only in this command's own --help.
  let password = if p.given("--password") {
    p.one("--password")
  } else {
    let mut input = bufio.NewReader(os.Stdin)
    let typed = read_password(input, f"New password for {member.name}: ")?
    let confirm = read_password(input, "Confirm password: ")?
    if typed != confirm { return Err("the passwords do not match") }
    typed
  }
  if password == "" {
    return Err("no password — pass --password <pw>, or answer the two prompts")
  }
  if password.length() < 8 {
    return Err(
      f"PocketBase requires at least 8 characters (got {password.length()})",
    )
  }

  let payload = match json.Marshal(models.PasswordPatch {
    password,
    password_confirm: password,
    email,
  }) {
    Ok(b) => b,
    Err(e) => return Err(f"encoding the patch: {e}"),
  }
  if let Err(e) = pb.patch_as(
    f"/api/collections/members/records/{member.id}",
    payload as string,
    su,
  ) {
    // A member token (or a guest) is refused by PocketBase — 401/403 outright,
    // or a 400 demanding oldPassword, which only a superuser may omit. All
    // three mean the same thing here: say what to set.
    if strings.Contains(e, "403") || strings.Contains(e, "401") || strings.Contains(e, "oldPassword") {
      return Err(
        "member set-password is superuser-only and the configured token is not one
set LLL_ADMIN_EMAIL/LLL_ADMIN_PASSWORD to the credentials 'lll up' prints",
      )
    }
    return Err(f"setting {name}'s password: {e}")
  }

  let identity = if email == "" { member.email } else { email }
  if email != "" && email != member.email {
    fmt.Println(f"email set to {email}")
  }
  fmt.Println(f"password set for {member.name}")
  fmt.Println(f"they log in with: lll login --email {identity} (plus --url <server> on a fresh machine)")
  Ok(())
}

/// `lll member invite NAME --email E` — the whole colleague handoff in one
/// command (TASK-217). It was three: member add, a superuser-env token create,
/// and a hand-written config carried by hand along with a token that expired
/// in days. Nothing here is new machinery; it is create_member and the same
/// superuser gate set-password runs, plus the part that actually got skipped —
/// telling the inviter the literal lines to paste to the colleague.
fn member_invite(input: flags.CommandInput) -> Result<(), string> {
  let spec = member_invite_spec()
  let usage = flags.usage("lll member invite", spec, "NAME")
  let p = input.parsed
  let name = p.first()
  if name == "" {
    return Err(f"usage: {usage}")
  }
  let email = strings.TrimSpace(p.one("--email"))
  if !real_email(email) {
    return Err(
      f"--email must be a real address the colleague can type into 'lll login', not '{email}'",
    )
  }

  // --url before the gate: superuser_auth and every call under it read the
  // CONFIGURED url, so on a machine that has never been set up they went to
  // the default and answered "Failed to authenticate" for credentials that
  // were perfectly good. Four of the six usability runs lost commands to
  // exactly that, and half of them guessed LLL_URL rather than being told.
  point_at_url(p.one("--url"))?
  apply_admin_flags(p.one("--admin-email"), p.one("--admin-password"))?
  // Superuser first: the create rides it, and an existing name is caught here
  // rather than as PocketBase's bare 400 on the unique index.
  let su = superuser_auth()?
  if let Some(existing) = find_member_as(su, name)? {
    return Err(
      f"member '{name}' already exists ({existing.email}) — run 'lll member set-password {name} --email {email} --password PASSWORD' with administrator credentials to enable login; existing credentials are unchanged",
    )
  }

  // Generated, not prompted: an invite is written down and sent, so the
  // inviter never types it, and a password nobody chose is one nobody reuses.
  // rand.Text is 26 base32 characters (~130 bits), the same source the board
  // token and create_member's throwaway use. It goes in on the create rather
  // than as a follow-up patch, so a failure leaves no member behind holding a
  // password nobody knows — the exact dead record set-password exists to fix.
  let password = rand.Text()
  let created = create_member_as(su, name, email, password)?

  let cfg = config.load()?
  fmt.Println(f"invited {created.name} <{email}>")
  fmt.Println("")
  fmt.Println("send them this — the password is shown once and stored nowhere:")
  fmt.Println("")
  for line in invite_lines(email, password, cfg.url, cfg.team) {
    fmt.Println(line)
  }
  Ok(())
}

/// The literal text the inviter forwards: the temp password, then the two
/// commands the colleague runs. Pure, so the handoff can be asserted without
/// a server — and it is the part worth pinning, because a wrong url or a
/// missing --url is exactly the paste that sends them back to the inviter.
/// `team` is "" when the inviter is not attached to one; the attach line then
/// says so rather than printing a blank key.
fn invite_lines(
  email: string,
  password: string,
  base: string,
  team: string,
) -> Slice<string> {
  let attach = if team == "" {
    "  # then, in the repo you both work in: lll attach"
  } else {
    f"  # then, in a clone of the repo: lll attach -k {team} (skip attach only if the clone already contains a committed .lll.toml)"
  }
  [
    f"  temporary password: {password}",
    "",
    f"  lll login --url {base} --email {email}",
    attach,
  ]
}

/// True for an email a human can log in with — anything but empty and the
/// synthesized @members.invalid placeholder.
fn real_email(email: string) -> bool {
  email != "" && !strings.HasSuffix(email, "@members.invalid")
}

/// The hand-written page for `lll member invite`; dispatch prints it for
/// --help/-h before parse, which would otherwise trip the required --email.
fn member_invite_page() -> string {
  "lll member invite - add a colleague and hand them a working login

Usage:
  lll member invite NAME --email email

One command for you, two for them. Creates NAME as a member with the email
given, sets a generated temporary password, and prints that password once
together with the exact 'lll login --url ...' line the colleague runs. The
password is stored nowhere else: lose it and reissue with
'lll member set-password NAME'.

--email is required and must be a real address — it is the identity
'lll login' asks for, so the synthesized @members.invalid placeholder
'lll member add' falls back to would be a dead door.

Uses the configured member token to create a new colleague, or administrator
credentials from --admin-email/--admin-password or LLL_ADMIN_EMAIL and
LLL_ADMIN_PASSWORD when supplied. An existing member is refused rather than
overwritten; resetting an existing password with 'lll member set-password'
requires administrator credentials." + flags.section(member_invite_spec())
}

/// The hand-written page for `lll member set-password`.
fn member_set_password_page() -> string {
  let spec = set_password_spec()
  let usage = flags.usage("lll member set-password", spec, "NAME")
  f"lll member set-password - set a member's login password (superuser only)

Usage:
  {usage}

Authenticates as the PocketBase superuser using --admin-email/--admin-password,
LLL_ADMIN_EMAIL/LLL_ADMIN_PASSWORD, or a configured superuser token.
Sets NAME's password to --password (alias -p) when supplied. Otherwise prompts
twice with echo off when stdin is a terminal, or reads two lines when piped.
The replacement password must contain at least 8 characters.

--email also sets the member's email, and is required when the member only
has a synthesized @members.invalid one: the email is the identity
'lll login' asks for. After this, the member logs in with
'lll login --url <server>'." + flags.section(spec)
}

fn member_add(input: flags.CommandInput) -> Result<(), string> {
  let args = input.args
  let spec = member_add_spec()
  // The usage line echoes the verb the user actually typed, so somebody who
  // reached this through the TASK-130 `create` alias is not told to rerun a
  // command they did not run.
  let verb = args.get(2).unwrap_or("add")
  let usage = flags.usage(f"lll member {verb}", spec, "[NAME]")
  let p = input.parsed
  let name = flags.entity_name(p, "-n", usage)?
  let email = p.one("-e")

  if let Some(existing) = find_member(name)? {
    return Err(f"a member named '{name}' already exists <{existing.email}> — pick another name")
  }
  let password = p.one("--password")
  if p.given("--password") && (password == "" || !real_email(email)) {
    return Err("--password requires a nonempty password and a real --email; use 'lll member invite NAME --email EMAIL' for a generated login handoff")
  }
  let created = if p.given("--password") {
    let cfg = config.load()?
    create_member_as(cfg.token, name, email, password)?
  } else { create_member(name, email)? }
  fmt.Println(f"Added member {created.name}")
  if p.given("--password") {
    fmt.Println(f"login enabled: lll login --email {email} --url {(config.load()?).url} (use the supplied password)")
  } else {
    fmt.Println(f"record only: no known login password. An administrator can enable login with 'lll member set-password {name} --email EMAIL --password PASSWORD'. For a new colleague, use 'lll member invite NAME --email EMAIL' instead.")
  }
  Ok(())
}

/// Create a member. Names are unique server-side, so callers that may race
/// or repeat check with find_member first. Email is required by the auth
/// collection: without -e, one is synthesized from the name — the same
/// @members.invalid rule the TASK-180 migration used to backfill. The random
/// password satisfies PB's create validation; it is never shown or reused.
pub fn create_member(name: string, email: string) -> Result<models.Member, string> {
  let cfg = config.load()?
  create_member_as(cfg.token, name, email, rand.Text())
}

/// create_member, riding `tok` and a caller-chosen password. Invite needs
/// both: it authenticates as the superuser before it creates anything (the
/// members collection's createRule is `@request.auth.id != ""`, so an inviter
/// whose only credential is LLL_ADMIN_* would otherwise POST anonymously and
/// get a bare 400), and the password it hands the colleague has to be the one
/// the record is created with.
fn create_member_as(
  tok: string,
  name: string,
  email: string,
  password: string,
) -> Result<models.Member, string> {
  let member_email = if email == "" { synthesize_email(name) } else { email }
  let new_member = models.NewMember {
    name,
    email: member_email,
    password,
    password_confirm: password,
    email_visibility: true,
  }
  let payload = match json.Marshal(new_member) {
    Ok(p) => p,
    Err(e) => return Err(f"encoding member: {e}"),
  }
  let body = pb.post_as(
    "/api/collections/members/records",
    payload as string,
    tok,
  )?

  let mut created = models.Member { .. }
  if let Err(e) = json.Unmarshal(body.bytes(), &created) {
    return Err(f"decoding created member: {e}")
  }
  Ok(created)
}

/// The deterministic identity a member without an email gets. Same rule as
/// the TASK-180 migration's backfill, so both paths agree on one shape.
pub fn synthesize_email(name: string) -> string {
  let slug = strings.ReplaceAll(strings.ToLower(name), " ", "-")
  f"{slug}@members.invalid"
}

/// Find a member by exact name, or None.
/// Create the member if the server does not have one by that name. Returns
/// true when it created one. Shared by `lll up`'s first-boot seeding and
/// `lll config set me`, which both need an identity to exist before it can be
/// assigned to.
pub fn ensure_member(name: string) -> Result<bool, string> {
  if name == "" { return Ok(false) }
  let existing = find_member(name)?
  if existing.is_some() { return Ok(false) }
  // Two actors seeding the same fresh server race here: both find nothing,
  // both POST. The unique name (and now email) indexes admit one and reject
  // the other, and the loser re-looks-up whoever won instead of failing the
  // boot — the same bargain ensure_team and e2e.sh's seed_team run.
  match create_member(name, "") {
    Ok(_) => Ok(true),
    Err(_) => {
      let raced = find_member(name)?
      if raced.is_some() { return Ok(false) }
      Err(f"could not create member '{name}' and none exists to reuse")
    },
  }
}

/// Find a member by exact name, riding the configured token.
fn find_member(name: string) -> Result<Option<models.Member>, string> {
  let cfg = config.load()?
  find_member_as(cfg.token, name)
}

/// Find a member by exact name, riding `tok` instead of the configured
/// token — token create looks its member up as the superuser it has just
/// authenticated, not as whoever happens to be configured.
pub fn find_member_as(tok: string, name: string) -> Result<Option<models.Member>, string> {
  // `name` arrives unsanitized from the board's `/issues?assignee=` query
  // parameter, so it goes through `quote` and not into the filter raw: the
  // QueryEscape below makes it safe in a URL, which is a different layer and
  // does nothing about a `'` closing the clause early (TASK-134).
  let filter = url.QueryEscape(f"name={query.quote(name)}")
  let mut result = models.MemberList { .. }
  let body = pb.get_as(
    f"/api/collections/members/records?filter={filter}",
    tok,
  )?
  if let Err(e) = json.Unmarshal(body.bytes(), &result) {
    return Err(f"decoding members: {e}")
  }
  Ok(result.items.find(|m| m.name == name))
}
