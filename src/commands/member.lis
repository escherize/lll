import "go:encoding/json"
import "go:fmt"
import "go:net/url"

import "models"
import "pb"
import "flags"

/// Dispatch `lll member <verb>`.
pub fn member(args: Slice<string>) -> Result<(), string> {
  let Some(verb) = args.get(2) else {
    member_usage()
    return Ok(())
  }
  match verb {
    "list" => member_list(),
    "add" => member_add(args),
    "--help" => {
      member_usage()
      Ok(())
    },
    "-h" => {
      member_usage()
      Ok(())
    },
    other => Err(f"unknown member command: '{other}' (see 'lll member --help')"),
  }
}

fn member_usage() {
  fmt.Println(
    "lll member - work with members

Usage:
  lll member list                       list members (name, email)
  lll member add -n \"name\" [-e email]   add a member

Members are honor-system identities (no auth). 'me' in .lll.toml names the
member that authors your comments.",
  )
}

fn member_list() -> Result<(), string> {
  let mut members = models.MemberList { .. }
  pb.fetch(
    "/api/collections/members/records?perPage=200&sort=name",
    "members",
    &members,
  )?
  for m in members.items {
    fmt.Println(f"{m.name}\t{m.email}")
  }
  Ok(())
}

fn member_add_spec() -> Slice<flags.Flag> {
  [
    flags.Flag { name: "-n", value: true, hint: "\"name\"", required: true, help: "member name", .. },
    flags.Flag { name: "-e", value: true, hint: "email", help: "member email", .. },
  ]
}

/// The flag table of one member verb; empty for verbs without flags. Read by
/// `lll completions` so the scripts complete exactly what the parser accepts.
pub fn member_verb_spec(verb: string) -> Slice<flags.Flag> {
  match verb {
    "add" => member_add_spec(),
    _ => [],
  }
}

fn member_add(args: Slice<string>) -> Result<(), string> {
  let spec = member_add_spec()
  let usage = flags.usage("lll member add", spec, "")
  let p = flags.parse(spec, args, 3, false, usage)?
  let name = p.one("-n")
  let email = p.one("-e")

  let created = create_member(name, email)?
  fmt.Println(f"Added member {created.name}")
  Ok(())
}

/// Create a member. Names are unique server-side, so callers that may race
/// or repeat check with find_member first.
pub fn create_member(name: string, email: string) -> Result<models.Member, string> {
  let new_member = models.NewMember { name, email }
  let payload = match json.Marshal(new_member) {
    Ok(p) => p,
    Err(e) => return Err(f"encoding member: {e}"),
  }
  let body = pb.post("/api/collections/members/records", payload as string)?

  let mut created = models.Member { .. }
  if let Err(e) = json.Unmarshal(body.bytes(), &created) {
    return Err(f"decoding created member: {e}")
  }
  Ok(created)
}

/// Find a member by exact name, or None.
/// Create the member if the server does not have one by that name. Returns
/// true when it created one. Shared by `lll up`'s first-boot seeding and
/// `lll config set me`, which both need an identity to exist before it can be
/// assigned to.
pub fn ensure_member(name: string) -> Result<bool, string> {
  if name == "" { return Ok(false) }
  let existing = find_member(name)?
  if existing.is_some() { return Ok(false) }
  let _ = create_member(name, "")?
  Ok(true)
}

fn find_member(name: string) -> Result<Option<models.Member>, string> {
  let filter = url.QueryEscape(f"name='{name}'")
  let mut result = models.MemberList { .. }
  pb.fetch(
    f"/api/collections/members/records?filter={filter}",
    "members",
    &result,
  )?
  Ok(result.items.find(|m| m.name == name))
}
