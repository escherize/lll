// The web board — a server-rendered board with realtime updates, started by
// `lll up`.
//
// Architecture: browsers hold ONE SSE connection to /events. The server holds
// one unfiltered (team-scoped at most) PB realtime subscription to issues +
// comments; on any event it re-renders the affected fragments and broadcasts
// them as datastar-patch-elements SSE events, which Datastar morphs into the
// DOM by element id. Actions (@post) write to PB and return 204 — the UI
// updates via the same broadcast as CLI-driven changes, so there is no
// swap-on-POST double-update race.
//
// Templates and static assets are compiled into the binary (see web/embed.go),
// so the board serves from any working directory. Markup edits need a rebuild:
// edit, `mise run dev`, refresh.

/// View model for one label chip.
pub struct LabelVM {
  pub name: string,
  pub color: string,
}

/// A state <option>: slug value, humanized label.
pub struct StateOpt {
  pub value: string,
  pub label: string,
}

/// View model for an avatar: initials plus a stable per-name color class.
pub struct AvatarVM {
  pub initials: string,
  pub class: string,
}

/// View model for one issue: a board card, or one row of the /issues table.
pub struct CardVM {
  pub id: string,
  pub key: string,
  pub title: string,
  pub state: string,
  // Humanized state for the hover preview ("in-progress" -> "In progress").
  pub state_label: string,
  pub prio: string,
  // Priority for display: "No priority" for none, else capitalized slug.
  pub prio_label: string,
  pub assignee: string,
  pub avatar: AvatarVM,
  pub labels: Slice<LabelVM>,
  // The author's marker, or "" for most issues.
  pub emoji: string,
  // Relative created age ("3h ago") for the card's bottom row.
  pub created: string,
  // Relative updated age. Board cards do not show it; the /issues table
  // sorts on it by default, so the column has to exist somewhere.
  pub updated: string,
  // First ~2 lines of the description, truncated, for the hover preview.
  pub snippet: string,
}

/// One selectable filter value (chooser option / chip).
pub struct FilterOptVM {
  pub value: string,
  pub label: string,
}

/// One filter dimension with its distinct values on the board. `dim` matches
/// the card data-* attribute the client-side filter compares against.
pub struct FilterGroupVM {
  pub dim: string,
  pub label: string,
  pub opts: Slice<FilterOptVM>,
}

/// View model for one board column (a state).
pub struct ColumnVM {
  pub state: string,
  pub label: string,
  pub glyph: string,
  // State as a Datastar signal name ("in-progress" -> "in_progress").
  // template.JS so data-on:* (a JS context to html/template) gets the bare
  // identifier instead of a quoted JS string.
  pub sig: template.JS,
  pub cards: Slice<CardVM>,
}

/// View model for the board.
pub struct BoardVM {
  pub states: Slice<StateOpt>,
  pub columns: Slice<ColumnVM>,
  pub filter_groups: Slice<FilterGroupVM>,
  // The filter chips the page opens with, as a JS array literal — set only
  // by the rail's "My issues" link (?mine=1). Empty means "restore whatever
  // the browser saved", which is every other board load, broadcasts
  // included: the filter bar lives outside #board and is never re-rendered.
  pub flt_seed: template.JS,
}

/// View model for the app shell's left rail.
///
/// Shell data lives here and nowhere else. The SSE bridge broadcasts
/// FRAGMENTS rendered straight from BoardVM / IssueVM / CommentsVM, so
/// hanging the rail off those view models would make every broadcast
/// construct a rail it must never render. Page handlers compose the two
/// halves into a PageVM instead; a fragment cannot carry shell by accident.
pub struct RailVM {
  // Which row reads as current: "board", "mine", "issues" or "settings".
  pub active: string,
  // Config's `me`. Empty means there is no member to be, so no "My issues"
  // row — a rail link that leads nowhere is worse than no rail link.
  pub me: string,
  pub version: string,
  // The team's accent as the body of a `:root` rule, or "" for DESIGN.md's
  // canonical orange (theme.css already holds those exact values). It rides
  // the shell because every page wears it, and it renders into the head as
  // <style id="accent">, so /settings can morph a new colour into an open
  // page without a reload.
  pub accent_css: template.CSS,
  // The tab icon in the same colour, as a data: URL. template.URL for the
  // same reason ColumnVM.sig is template.JS: html/template will not emit a
  // data: URL typed as a plain string.
  pub favicon: template.URL,
  // The starred issues, newest first. The one part of the rail that is also
  // broadcast on its own (see favorites_broadcast).
  pub favorites: Slice<FavVM>,
}

/// One starred issue in the rail's FAVORITES group.
pub struct FavVM {
  pub key: string,
  pub title: string,
  pub state: string,
}

/// A whole page: the shell plus that page's own view model. Page templates
/// take one of these and reach the page through `.Page`; adding a page means
/// a handler and a `{{define}}`, never an edit to another page's template.
pub struct PageVM {
  pub rail: RailVM,
  pub page: Unknown,
}

/// View model for one comment.
pub struct CommentVM {
  pub id: string,
  pub author: string,
  pub avatar: AvatarVM,
  pub age: string,
  pub body: template.HTML,
}

/// View model for the comments fragment alone (broadcast re-renders).
pub struct CommentsVM {
  pub comments: Slice<CommentVM>,
}

/// View model for the issue page / issue-detail fragment.
pub struct IssueVM {
  pub deleted: bool,
  pub id: string,
  pub key: string,
  pub title: string,
  pub state: string,
  pub prio: string,
  pub assignee: string,
  pub avatar: AvatarVM,
  pub project: string,
  pub labels: Slice<LabelVM>,
  // The author's marker, or "" for most issues.
  pub emoji: string,
  pub description: template.HTML,
  pub created: string,
  pub updated: string,
  pub states: Slice<StateOpt>,
  pub prios: Slice<StateOpt>,
  pub comments: Slice<CommentVM>,
  // Seeds the topbar star's $fav signal. Only the page handler sets it: the
  // star lives outside #issue-detail, so no broadcast re-renders it.
  pub favorited: bool,
}

/// One column heading in the /issues table. `href` empty means the column has
/// no PB field behind it and does not sort; `dir` is "asc" or "desc" only on
/// the column currently doing the sorting.
pub struct IssueColVM {
  pub label: string,
  pub href: string,
  pub dir: string,
  pub cls: string,
}

/// View model for the /issues table.
///
/// Everything the page can be is in the URL, so this is a pure projection of
/// four query params. `shown` and `total` are kept apart on purpose: PB is
/// asked for 200 rows and reports how many matched, so the page can say
/// "showing 200 of 340" instead of silently ending at 200.
pub struct IssuesVM {
  // Header cells, in the order the row cells below them are written.
  pub cols: Slice<IssueColVM>,
  pub rows: Slice<CardVM>,
  pub shown: int,
  pub total: int,
  pub truncated: bool,
  // The per-request row ceiling, named in the count when it bites.
  pub limit: int,
  // Filter chooser contents and the values currently selected.
  pub states: Slice<StateOpt>,
  pub members: Slice<string>,
  pub label_names: Slice<string>,
  pub state: string,
  pub assignee: string,
  pub label: string,
  pub sort: string,
  // URL with every filter dropped and the sort kept, for "Clear".
  pub clear_href: string,
  // A rejected query param, said out loud in the flash strip rather than
  // served as a 500 or silently ignored.
  pub error: string,
}

/// The /issues URL state: three filters plus the sort spec. Held together so
/// a header link can rebuild the URL with only the sort changed.
struct IssuesQuery {
  state: string,
  assignee: string,
  label: string,
  sort: string,
}

/// One label row on /settings. `scope` is the owning team's key, or
/// "workspace" — shown, never edited: which team owns a label is a CLI
/// decision (`lll label create --team`), and a settings page that silently
/// moved records between teams would be worse than one that says where they
/// live.
pub struct SetLabelVM {
  pub id: string,
  pub name: string,
  pub color: string,
  pub scope: string,
}

/// One member row on /settings. Members are honor-system identities (ADR-1:
/// no auth), so this list is the workspace's — never "your account".
pub struct SetMemberVM {
  pub id: string,
  pub name: string,
  pub email: string,
}

/// One project row on /settings.
pub struct SetProjectVM {
  pub id: string,
  pub name: string,
  pub status: string,
  pub scope: string,
}

/// View model for /settings, and for the #settings fragment its actions patch
/// back.
///
/// Everything here passes one filter: server-side, shared between everyone,
/// and reachable only from the CLI today. Deliberately absent: hidden columns
/// and filter chips (per-browser, and already live on the board where they
/// are used), anything PocketBase's own admin UI does better, and
/// url/port/pb-dir — a page cannot change the address of the process serving
/// it without restarting that process.
pub struct SettingsVM {
  // "" when no team is configured; the team card then says so instead.
  pub team_key: string,
  pub team_name: string,
  // The accent as "#rrggbb", falling back to the canonical orange:
  // <input type="color"> has no empty state, so the swatch always shows one.
  pub accent: string,
  // Whether that colour is the team's own choice or just the default.
  pub accent_set: bool,
  pub labels: Slice<SetLabelVM>,
  pub members: Slice<SetMemberVM>,
  pub projects: Slice<SetProjectVM>,
  pub statuses: Slice<StateOpt>,
}

/// One connected browser: its scope ("board" or "issue:KEY-1") and the
/// channel its /events handler drains.
struct SseClient { id: int, scope: string, ch: Channel<string> }

/// A rendered SSE payload for every client with a matching scope.
struct Broadcast { scope: string, payload: string }

/// Fan-out hub. A single owner task holds the client registry and is fed
/// exclusively through these channels — no shared mutable state.
struct Hub {
  register: Channel<SseClient>,
  unregister: Channel<int>,
  broadcast: Channel<Broadcast>,
  ids: Channel<int>,
}

fn new_hub() -> Hub {
  let hub = Hub { 
    register: Channel.new<SseClient>(),
    unregister: Channel.new<int>(),
    broadcast: Channel.new<Broadcast>(),
    ids: Channel.new<int>(),
  }
  // Client-id allocator: unique ids without shared counters.
  task {
    let mut n = 1
    loop {
      if !hub.ids.send(n) { break }
      n += 1
    }
  }
  // Registry owner.
  task {
    let mut clients: Slice<SseClient> = []
    let mut running = true
    while running {
      select {
        match hub.register.receive() {
          Some(c) => clients = clients.append(c),
          None => running = false,
        },
        match hub.unregister.receive() {
          Some(id) => clients = clients.filter(|c| c.id != id),
          None => running = false,
        },
        match hub.broadcast.receive() {
          Some(msg) => deliver(clients, msg),
          None => running = false,
        },
      }
    }
  }
  hub
}

/// Send a broadcast to every matching client, dropping the payload for any
/// client whose buffer is full (a stuck browser must not stall the hub).
///
/// Scope "*" matches every client. The rail is on every page, so its
/// favorites group is the one fragment with no single scope to belong to.
fn deliver(clients: Slice<SseClient>, msg: Broadcast) {
  for c in clients {
    if msg.scope != "*" && c.scope != msg.scope { continue }
    select {
      c.ch.send(msg.payload) => (),
      _ => continue,
    }
  }
}

/// Start the board server on `port`. The board is `lll up`'s web half.
pub fn run_server(port: int) -> Result<(), string> {
  // Resolve the team scope once; card/board fetches and the realtime
  // subscription share it. No configured team means an unscoped board.
  let cfg = config.load()?
  let mut team_id = ""
  if cfg.team != "" {
    let Some(team) = find_team(cfg.team)? else {
      return Err(unknown_team(cfg.team))
    }
    team_id = team.id
  }

  // Fail fast on broken templates before accepting connections — both
  // pages, because they share the rail and a typo in it breaks every page.
  let shell = rail_vm("board", cfg.me, models.Team { .. })
  let _ = render(
    "board-page",
    PageVM { rail: shell, page: BoardVM { states: state_opts(), columns: [], .. } },
  )?
  let _ = render("issue-page", PageVM { rail: shell, page: IssueVM { .. } })?
  let _ = render("issues-page", PageVM { rail: shell, page: IssuesVM { .. } })?
  let _ = render("settings-page", PageVM { rail: shell, page: SettingsVM { .. } })?

  // One PB subscription for everything. Issues are team-scoped at most —
  // never state-filtered: PB emits nothing when an update moves a record out
  // of a subscription filter, so filtered board columns would go stale.
  let issues_topic = realtime.topic_with_options(
    "issues",
    query.filter(team_id, "", "", "", "", ""),
    "team,assignee,labels,project",
  )?
  let comments_topic = realtime.topic_with_options("comments", "", "author")?
  // Favorites drive the rail's FAVORITES group, which every page shows, so
  // this topic is unfiltered too.
  let events = realtime.subscribe(
    pb.base_url()?,
    [issues_topic, comments_topic, "favorites"],
  )?

  let hub = new_hub()
  task {
    bridge(events, hub, team_id)
  }

  http.HandleFunc(
    "GET /{$}",
    |w: http.ResponseWriter, r: Ref<http.Request>| {
      board_page(w, r, team_id, cfg.me)
    },
  )
  http.HandleFunc(
    "GET /issues",
    |w: http.ResponseWriter, r: Ref<http.Request>| {
      issues_page(w, r, team_id, cfg.me)
    },
  )
  http.HandleFunc(
    "GET /issue/{key}",
    |w: http.ResponseWriter, r: Ref<http.Request>| {
      issue_page(w, r, team_id, cfg.me)
    },
  )
  http.HandleFunc(
    "GET /settings",
    |w: http.ResponseWriter, r: Ref<http.Request>| {
      settings_page(w, r, team_id, cfg.me)
    },
  )
  http.HandleFunc(
    "POST /settings/{kind}",
    |w: http.ResponseWriter, r: Ref<http.Request>| {
      settings_action(w, r, team_id, cfg.me)
    },
  )
  http.HandleFunc(
    "GET /events",
    |w: http.ResponseWriter, r: Ref<http.Request>| {
      events_stream(w, r, hub)
    },
  )
  http.HandleFunc(
    "POST /create",
    |w: http.ResponseWriter, r: Ref<http.Request>| {
      create_action(w, r, team_id)
    },
  )
  http.HandleFunc(
    "POST /state",
    |w: http.ResponseWriter, r: Ref<http.Request>| {
      state_action(w, r, team_id)
    },
  )
  http.HandleFunc("POST /favorite", favorite_action)
  http.HandleFunc("POST /priority", priority_action)
  http.HandleFunc("POST /title", title_action)
  http.HandleFunc("POST /comment", comment_action)
  // The embedded tree keeps its repo paths, so "/static/theme.css" resolves to
  // "static/theme.css" with no prefix surgery.
  http.Handle("GET /static/", http.FileServerFS(web.Assets()))

  fmt.Println(f"board  http://127.0.0.1:{port}")
  match http.ListenAndServe(f"127.0.0.1:{port}", http.DefaultServeMux) {
    Ok(_) => Ok(()),
    Err(e) => Err(f"server: {e}"),
  }
}

// ---------- rendering ----------

/// Render a named template from the embedded web/templates/ tree.
fn render(name: string, data: Unknown) -> Result<string, string> {
  let tmpl = match template.ParseFS(web.Assets(), "templates/*.html") {
    Ok(t) => t,
    Err(e) => return Err(f"parsing web/templates: {e}"),
  }
  let mut buf = bytes.Buffer { .. }
  if let Err(e) = tmpl.ExecuteTemplate(&buf, name, data) {
    return Err(f"rendering {name}: {e}")
  }
  Ok(buf.String())
}

/// Wrap a rendered fragment as a datastar-patch-elements SSE event. Each
/// line of HTML becomes its own `data: elements` line; Datastar morphs the
/// fragment into the DOM by element id (default mode `outer`).
fn patch_event(html: string) -> string {
  let lines = html.split("\n").map(|l| f"data: elements {l}")
  f"event: datastar-patch-elements\n{strings.Join(lines, "\n")}\n\n"
}

/// "in-progress" -> "In progress".
fn state_label(state: string) -> string {
  let words = strings.ReplaceAll(state, "-", " ")
  strings.ToUpper(words.substring(0..1)) + words.substring(1..)
}

fn state_opts() -> Slice<StateOpt> {
  query.states().map(|s| StateOpt { value: s, label: state_label(s) })
}

/// Web-facing priority label: the web reads priority 0 as "No priority"
/// (CLI output keeps "none").
fn prio_label(name: string) -> string {
  if name == "none" { return "No priority" }
  state_label(name)
}

/// Priority <option>s in Linear order, slug values, web labels.
fn prio_opts() -> Slice<StateOpt> {
  ["none", "urgent", "high", "medium", "low"]
    .map(|p| StateOpt { value: p, label: prio_label(p) })
}

/// Priority slug -> Linear int (inverse of display.priority_name).
fn prio_value(slug: string) -> Option<int> {
  match slug {
    "none" => Some(0),
    "urgent" => Some(1),
    "high" => Some(2),
    "medium" => Some(3),
    "low" => Some(4),
    _ => None,
  }
}

/// Initials plus a stable per-name color class (av-0..av-3), so different
/// members scan differently on the board.
fn avatar_vm(name: string) -> AvatarVM {
  let words = strings.Fields(name)
  let first = words.map(|w| strings.ToUpper(w.substring(0..1)))
  let mut sum = 0
  for b in name.bytes() {
    sum += b as int
  }
  AvatarVM {
    initials: strings.Join(first[..min(2, first.length())], ""),
    class: f"av-{sum % 4}",
  }
}

fn label_vms(labels: Slice<models.Label>) -> Slice<LabelVM> {
  labels.map(|l| LabelVM { name: l.name, color: l.color })
}

fn card_vm(issue: models.Issue) -> CardVM {
  let prio = display.priority_name(issue.priority)
  CardVM {
    id: issue.id,
    key: f"{issue.expand.team.key}-{issue.number}",
    title: issue.title,
    state: issue.state,
    state_label: state_label(issue.state),
    prio,
    prio_label: prio_label(prio),
    assignee: issue.expand.assignee.name,
    avatar: avatar_vm(issue.expand.assignee.name),
    labels: label_vms(issue.expand.labels),
    emoji: issue.emoji,
    created: display.relative(issue.created),
    updated: display.relative(issue.updated),
    snippet: snippet(issue.description),
  }
}

/// Description -> hover-preview snippet: the first two non-empty lines
/// joined, capped at 160 chars with an ellipsis. The popover's CSS
/// line-clamp handles the visual "~2 lines"; this keeps payloads small.
fn snippet(desc: string) -> string {
  let lines = desc.split("\n").map(strings.TrimSpace).filter(|l| l != "")
  let text = strings.Join(lines[..min(2, lines.length())], " ")
  if text.length() > 160 { return text.substring(0..159) + "…" }
  text
}

/// First-seen-order distinct non-empty strings.
fn distinct(vals: Slice<string>) -> Slice<string> {
  let mut out: Slice<string> = []
  for v in vals {
    if v != "" && !out.contains(v) { out = out.append(v) }
  }
  out
}

/// The filter chooser's contents: distinct assignees, labels, priorities and
/// states present on the board. Dimensions with no values are dropped.
fn filter_groups(issues: Slice<models.Issue>) -> Slice<FilterGroupVM> {
  let assignees = distinct(issues.map(|i| i.expand.assignee.name))
  let mut label_names: Slice<string> = []
  for i in issues {
    label_names = label_names.append(i.expand.labels.map(|l| l.name)...)
  }
  let labels = distinct(label_names)
  let present_prios = distinct(issues.map(|i| display.priority_name(i.priority)))
  let prios = ["urgent", "high", "medium", "low", "none"]
    .filter(|p| present_prios.contains(p))
  let states = query.states().filter(|s| issues.any(|i| i.state == s))
  let groups = [
    FilterGroupVM {
      dim: "assignee",
      label: "Assignee",
      opts: assignees.map(|a| FilterOptVM { value: a, label: a }),
    },
    FilterGroupVM {
      dim: "label",
      label: "Label",
      opts: labels.map(|l| FilterOptVM { value: l, label: l }),
    },
    FilterGroupVM {
      dim: "prio",
      label: "Priority",
      opts: prios.map(|p| FilterOptVM { value: p, label: prio_label(p) }),
    },
    FilterGroupVM {
      dim: "state",
      label: "State",
      opts: states.map(|s| FilterOptVM { value: s, label: state_label(s) }),
    },
  ]
  groups.filter(|g| g.opts.length() > 0)
}

/// The full board, freshly fetched: six columns in workflow order.
fn board_vm(team_id: string) -> Result<BoardVM, string> {
  let issues = fetch_board_issues(team_id)?
  let columns = query
    .states()
    .map(|s| ColumnVM {
      state: s,
      label: state_label(s),
      glyph: display.glyph(s),
      sig: strings.ReplaceAll(s, "-", "_") as template.JS,
      cards: issues.filter(|i| i.state == s).map(card_vm),
    })
  Ok(BoardVM { states: state_opts(), columns, filter_groups: filter_groups(issues), .. })
}

fn fetch_board_issues(team_id: string) -> Result<Slice<models.Issue>, string> {
  let mut path = "/api/collections/issues/records?perPage=200&expand=team,assignee,labels&sort=sort,created"
  let filter = query.filter(team_id, "", "", "", "", "")
  if filter != "" { path = f"{path}&filter={url.QueryEscape(filter)}" }
  let body = pb.get(path)?
  let mut issues = models.IssueList { .. }
  if let Err(e) = json.Unmarshal(body.bytes(), &issues) {
    return Err(f"decoding issues: {e}")
  }
  Ok(issues.items)
}

fn comment_vm(c: models.Comment) -> CommentVM {
  let mut author = c.expand.author.name
  if author == "" { author = "anon" }
  CommentVM {
    id: c.id,
    author,
    avatar: avatar_vm(author),
    age: display.relative(c.created),
    body: md_html(c.body),
  }
}

/// Markdown -> HTML for comment bodies and issue descriptions. GitHub-flavored
/// (tables, strikethrough, autolinks, task lists) with hard wraps on, so every
/// newline becomes a <br> the way GitHub comments do and pasted plain text
/// keeps its shape. WithUnsafe stays off, so the renderer still drops raw HTML
/// in user input; on parse failure fall back to escaped text.
///
/// Fenced code is tokenized server-side by chroma. WithClasses(true) makes it
/// emit bare class names instead of inline hex, so the colors come from
/// theme.css tokens and DESIGN.md's ladder stays the only palette.
///
/// A ```mermaid fence has no chroma lexer, and guessing is off, so highlighting
/// hands it back to goldmark's plain renderer as
/// <pre><code class="language-mermaid">. web/static/mermaid-init.js finds those
/// and draws them. That is the whole mermaid integration on this side.
///
/// The renderer is rebuilt per call because lis has no package-level composite
/// bindings. Measured at 13.5us/call for prose and 70us when the body carries a
/// code fence (chroma builds its lexer each time). A page renders a description
/// and its comments, so that is microseconds against a PocketBase round trip.
fn md_html(src: string) -> template.HTML {
  let mut buf = bytes.Buffer { .. }
  // WithHardWraps() returns an anonymous Go interface, which binds as Unknown,
  // so it needs narrowing before WithRendererOptions will take it.
  let Some(hard_wraps) = assert_type<renderer.Option>(mdhtml.WithHardWraps()) else {
    return template.HTMLEscapeString(src) as template.HTML
  }
  // extension.GFM is a package var of an unexported type, so lis binds it as
  // Unit; assert_type narrows it back to the interface goldmark wants.
  let Some(gfm) = assert_type<goldmark.Extender>(extension.GFM) else {
    return template.HTMLEscapeString(src) as template.HTML
  }
  let code = highlighting.NewHighlighting(
    highlighting.WithFormatOptions(chromahtml.WithClasses(true)),
  )
  let md = goldmark.New(
    goldmark.WithExtensions(gfm, code),
    goldmark.WithRendererOptions(hard_wraps),
  )
  if let Err(_) = md.Convert(src.bytes(), &buf) {
    return template.HTMLEscapeString(src) as template.HTML
  }
  buf.String() as template.HTML
}

/// Issue view model from a full record (expand: team, assignee, labels,
/// project) — shared by the issue page and broadcast re-renders.
fn issue_vm(issue: models.Issue, comments: Slice<models.Comment>) -> IssueVM {
  let assignee = issue.expand.assignee.name
  let mut project = issue.expand.project.name
  if project == "" { project = "none" }
  IssueVM {
    deleted: false,
    id: issue.id,
    key: f"{issue.expand.team.key}-{issue.number}",
    title: issue.title,
    state: issue.state,
    prio: display.priority_name(issue.priority),
    assignee,
    avatar: avatar_vm(assignee),
    project,
    labels: label_vms(issue.expand.labels),
    emoji: issue.emoji,
    description: md_html(issue.description),
    created: display.relative(issue.created),
    updated: display.relative(issue.updated),
    states: state_opts(),
    prios: prio_opts(),
    comments: comments.map(comment_vm),
    // Left false here on purpose: only issue_page knows, and only it renders
    // the star. Broadcasts of #issue-detail must not carry a stale answer.
    favorited: false,
  }
}

// ---------- team accent ----------

/// "#RRGGBB" -> "#rrggbb"; anything else -> "", meaning DESIGN.md's canonical
/// orange. A stored value that cannot be parsed must fall back rather than
/// emit broken CSS into every page.
fn normalize_hex(raw: string) -> string {
  let v = strings.ToLower(strings.TrimSpace(raw))
  if v.length() != 7 || !strings.HasPrefix(v, "#") { return "" }
  for byte in v.substring(1..).bytes() {
    let c = byte as int
    if !((c >= 48 && c <= 57) || (c >= 97 && c <= 102)) { return "" }
  }
  v
}

/// One channel of "#rrggbb" as 0-255. Only ever called on a normalized hex.
fn hex_channel(hex: string, at: int) -> int {
  let Ok(n) = strconv.ParseInt(hex.substring(at..at + 2), 16, 64) else {
    return 0
  }
  n as int
}

/// Two-digit lowercase hex for a clamped channel.
fn hex2(n: int) -> string {
  let mut v = n
  if v < 0 { v = 0 }
  if v > 255 { v = 255 }
  let s = strconv.FormatInt(v as int64, 16)
  if s.length() < 2 { return "0" + s }
  s
}

/// Move one channel `amount` of the way toward `target` (0 black, 255 white).
/// Rounds rather than truncates: 240 mixed 90% toward black is 23.999999997
/// in float64, and a truncating cast would spend that whole rounding error on
/// the visible colour.
fn mix_channel(c: int, target: int, amount: float64) -> int {
  ((c as float64) + ((target - c) as float64) * amount + 0.5) as int
}

/// "#rrggbb" mixed `amount` of the way toward `target`.
fn mix_hex(r: int, g: int, b: int, target: int, amount: float64) -> string {
  "#"
    + hex2(mix_channel(r, target, amount))
    + hex2(mix_channel(g, target, amount))
    + hex2(mix_channel(b, target, amount))
}

/// The text colour that goes ON the accent. DESIGN.md's ember ink is the
/// accent kept at 10% of each channel, which reads only because the ember
/// orange is bright; a colour picker hands out dark colours too, and
/// near-black ink on a navy button is an unreadable button. Below the
/// perceptual midpoint the same 90% mix runs toward white instead.
fn ink_hex(r: int, g: int, b: int) -> string {
  let lum = (r * 299 + g * 587 + b * 114) / 1000
  if lum < 110 { return mix_hex(r, g, b, 255, 0.90) }
  mix_hex(r, g, b, 0, 0.90)
}

/// The team accent as a `:root` rule overriding theme.css's five accent
/// tokens; "" for the canonical orange, so the shipped tokens stay
/// byte-identical when nobody has chosen a colour.
///
/// One stored hex derives the whole family with plain channel maths: hover
/// mixes 12% white, deep 20% black, ink keeps 10% of each channel, dim is the
/// accent at 0.16 alpha. Fed DESIGN.md's own #f0883e it lands within a few
/// values of the shipped #f79b57 / #c96a25 / #1a0f06, so a chosen colour
/// behaves the way the original does — light-on-hover, dark ink on fills.
fn accent_css(hex: string) -> template.CSS {
  if hex == "" { return "" as template.CSS }
  let r = hex_channel(hex, 1)
  let g = hex_channel(hex, 3)
  let b = hex_channel(hex, 5)
  let hover = mix_hex(r, g, b, 255, 0.12)
  let deep = mix_hex(r, g, b, 0, 0.20)
  let ink = ink_hex(r, g, b)
  let body = f"--accent:{hex};--accent-hover:{hover};--accent-ink:{ink};--accent-deep:{deep};--accent-dim:rgba({r},{g},{b},0.16)"
  (":root{" + body + "}") as template.CSS
}

/// The mark's letter for the favicon: the team key's initial, or lll's own L.
/// One ASCII alphanumeric and nothing else — it lands inside an SVG document
/// that carries no escaping of its own.
fn mark_letter(key: string) -> string {
  if key == "" { return "L" }
  let c = strings.ToUpper(key.substring(0..1))
  let b = c.bytes()[0] as int
  if (b >= 65 && b <= 90) || (b >= 48 && b <= 57) { c } else { "L" }
}

/// The tab icon: the workspace mark redrawn as an inline SVG data: URL in the
/// team's accent, so two boards open side by side differ in the tab strip as
/// well as on the page.
fn favicon_url(hex: string, letter: string) -> template.URL {
  let mut fill = hex
  if fill == "" { fill = "#f0883e" }
  let r = hex_channel(fill, 1)
  let g = hex_channel(fill, 3)
  let b = hex_channel(fill, 5)
  let ink = ink_hex(r, g, b)
  let svg = "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'>"
    + "<rect width='32' height='32' rx='7' fill='" + fill + "'/>"
    + "<text x='16' y='23' text-anchor='middle' font-family='system-ui,sans-serif'"
    + " font-size='19' font-weight='800' fill='" + ink + "'>" + letter + "</text></svg>"
  f"data:image/svg+xml,{url.PathEscape(svg)}" as template.URL
}

/// The configured team record, re-read per page load. /settings can change
/// the accent at any moment, so a value cached at startup would leave every
/// open tab on a stale colour; this is one small GET beside the fetches the
/// page already makes. A missing or unreadable team yields a blank record,
/// which renders as the canonical orange.
fn shell_team(team_id: string) -> models.Team {
  let mut team = models.Team { .. }
  if team_id == "" { return team }
  let Ok(body) = pb.get(f"/api/collections/teams/records/{team_id}") else {
    return models.Team { .. }
  }
  if json.Unmarshal(body.bytes(), &team).is_err() { return models.Team { .. } }
  team
}

// ---------- page handlers ----------

/// The rail for one page: `active` names the current row, `me` decides
/// whether "My issues" has anywhere to point, and `team` carries the accent
/// every page wears.
fn rail_vm(active: string, me: string, team: models.Team) -> RailVM {
  let hex = normalize_hex(team.accent)
  RailVM {
    active,
    me,
    version: version(),
    accent_css: accent_css(hex),
    favicon: favicon_url(hex, mark_letter(team.key)),
    favorites: fav_vms(),
  }
}

/// The rail's FAVORITES group. A failed fetch renders an empty group rather
/// than a 500: a missing star list must not cost you the board.
fn fav_vms() -> Slice<FavVM> {
  let Ok(favs) = fetch_favorites() else {
    return []
  }
  favs.map(|f| {
    let issue = f.expand.issue
    FavVM {
      key: f"{issue.expand.team.key}-{issue.number}",
      title: issue.title,
      state: issue.state,
    }
  })
}

/// Every favorite, newest first, with its issue and that issue's team.
///
/// Unscoped by member on purpose: auth is deferred (task-32), so every row
/// carries member="" and a star belongs to the workspace. When members
/// arrive this grows a filter, not a new shape.
fn fetch_favorites() -> Result<Slice<models.Favorite>, string> {
  let body = pb.get(
    "/api/collections/favorites/records?perPage=200&sort=-created&expand=issue.team",
  )?
  let mut list = models.FavoriteList { .. }
  if let Err(e) = json.Unmarshal(body.bytes(), &list) {
    return Err(f"decoding favorites: {e}")
  }
  // A favorite whose issue expand came back empty (issue deleted between the
  // list and the expand) has no link to render.
  Ok(list.items.filter(|f| f.expand.issue.id != ""))
}

/// The workspace's favorite row for one issue, if it has one.
fn fetch_favorite(issue_id: string) -> Result<Option<models.Favorite>, string> {
  let filter = url.QueryEscape(f"issue='{issue_id}' && member=''")
  let body = pb.get(
    f"/api/collections/favorites/records?perPage=1&filter={filter}",
  )?
  let mut list = models.FavoriteList { .. }
  if let Err(e) = json.Unmarshal(body.bytes(), &list) {
    return Err(f"decoding favorites: {e}")
  }
  Ok(list.items.get(0))
}

/// One query parameter, or "" when there is no URL to ask.
fn query_param(r: Ref<http.Request>, name: string) -> string {
  let Some(u) = r.URL else {
    return ""
  }
  u.Query().Get(name)
}

/// The board, optionally opened on the rail's "My issues" filter (?mine=1).
/// The filter is a client-side chip, not a server-side query: /events
/// broadcasts one unfiltered #board fragment to every board client, so a
/// server-filtered page would be morphed back to the full board on the next
/// realtime event.
fn board_page(w: http.ResponseWriter, r: Ref<http.Request>, team_id: string, me: string) {
  let mut vm = match board_vm(team_id) {
    Ok(v) => v,
    Err(e) => {
      http.Error(w, e, 500)
      return
    },
  }
  let mut active = "board"
  if me != "" && query_param(r, "mine") != "" {
    active = "mine"
    vm.flt_seed = assignee_chip(me)
  }
  let rail = rail_vm(active, me, shell_team(team_id))
  let html = match render("board-page", PageVM { rail, page: vm }) {
    Ok(h) => h,
    Err(e) => {
      http.Error(w, e, 500)
      return
    },
  }
  w.Header().Set("Cache-Control", "no-store")
  w.Header().Set("Content-Type", "text/html; charset=utf-8")
  let _ = w.Write(html.bytes())
}

/// One filter chip, JSON-encoded, for the filter bar's opening signal. JSON
/// rather than string interpolation because the value is a member's name:
/// html/template escapes the attribute, the browser unescapes it, and a name
/// with an apostrophe in it would otherwise land as broken JS.
fn assignee_chip(name: string) -> template.JS {
  let Ok(json_bytes) = json.Marshal([f"assignee:{name}"]) else {
    return "" as template.JS
  }
  let text = json_bytes as string
  text as template.JS
}

fn issue_page(w: http.ResponseWriter, r: Ref<http.Request>, team_id: string, me: string) {
  let key = r.PathValue("key")
  let issue = match fetch_issue(key) {
    Ok(i) => i,
    Err(e) => {
      http.Error(w, e, 404)
      return
    },
  }
  let comments = match fetch_comments(issue.id) {
    Ok(c) => c,
    Err(e) => {
      http.Error(w, e, 500)
      return
    },
  }
  // An issue is a detail view under the board, so the board row stays
  // current — which also makes the rail byte-identical to the board's.
  let mut page = issue_vm(issue, comments)
  if let Ok(Some(_)) = fetch_favorite(issue.id) { page.favorited = true }
  let vm = PageVM { rail: rail_vm("board", me, shell_team(team_id)), page }
  let html = match render("issue-page", vm) {
    Ok(h) => h,
    Err(e) => {
      http.Error(w, e, 500)
      return
    },
  }
  w.Header().Set("Cache-Control", "no-store")
  w.Header().Set("Content-Type", "text/html; charset=utf-8")
  let _ = w.Write(html.bytes())
}

// ---------- /issues ----------

/// Rebuild the /issues URL from its four parts. Filters and sort travel
/// together, so a header link keeps the filters and "Clear" keeps the sort:
/// the URL is the whole page state, and every link on the page is this
/// function with one part changed.
fn issues_href(q: IssuesQuery) -> string {
  let mut parts: Slice<string> = []
  if q.state != "" { parts = parts.append(f"state={url.QueryEscape(q.state)}") }
  if q.assignee != "" {
    parts = parts.append(f"assignee={url.QueryEscape(q.assignee)}")
  }
  if q.label != "" { parts = parts.append(f"label={url.QueryEscape(q.label)}") }
  if q.sort != "" { parts = parts.append(f"sort={url.QueryEscape(q.sort)}") }
  if parts.is_empty() { return "/issues" }
  f"/issues?{strings.Join(parts, "&")}"
}

/// One column heading. `field` is the PB field the header sorts on, or "" for
/// a column with nothing to sort by (title, labels, assignee — none of them
/// are in query.sort_fields()). First click on a column sorts it descending;
/// clicking the column that is already sorting flips it.
fn issue_col(label: string, field: string, cls: string, q: IssuesQuery) -> IssueColVM {
  if field == "" {
    return IssueColVM { label, cls, .. }
  }
  let mut dir = ""
  let mut next = f"-{field}"
  if q.sort == field {
    dir = "asc"
  }
  if q.sort == f"-{field}" {
    dir = "desc"
    next = field
  }
  let mut nq = q
  nq.sort = next
  IssueColVM { label, cls, dir, href: issues_href(nq) }
}

/// The eight columns, in the order issues.html writes the row cells.
fn issue_cols(q: IssuesQuery) -> Slice<IssueColVM> {
  [
    issue_col("ID", "number", "c-id", q),
    issue_col("Title", "", "c-title", q),
    issue_col("State", "", "c-state", q),
    issue_col("Priority", "priority", "c-prio", q),
    issue_col("Labels", "", "c-labels", q),
    issue_col("Assignee", "", "c-assignee", q),
    issue_col("Created", "created", "c-age", q),
    issue_col("Updated", "updated", "c-age", q),
  ]
}

/// Rows per request. The same 200 the board and `lll issue list` use; the
/// table shows the number rather than pretending it is the whole set.
fn table_page_size() -> int {
  200
}

/// One page of the issues table: at most `table_page_size()` rows plus PB's
/// total for the same filter, so the count can be honest about the ceiling.
fn fetch_issue_rows(
  team_id: string,
  state: string,
  assignee_id: string,
  label_id: string,
  sort: string,
) -> Result<models.IssueList, string> {
  let mut path = f"/api/collections/issues/records?perPage={table_page_size()}&expand=team,assignee,labels&sort={url.QueryEscape(sort)}"
  let filter = query.filter(team_id, state, assignee_id, "", label_id, "")
  if filter != "" { path = f"{path}&filter={url.QueryEscape(filter)}" }
  let body = pb.get(path)?
  let mut issues = models.IssueList { .. }
  if let Err(e) = json.Unmarshal(body.bytes(), &issues) {
    return Err(f"decoding issues: {e}")
  }
  Ok(issues)
}

/// Every member's name, for the assignee chooser.
fn fetch_member_names() -> Result<Slice<string>, string> {
  let body = pb.get("/api/collections/members/records?perPage=200&sort=name")?
  let mut result = models.MemberList { .. }
  if let Err(e) = json.Unmarshal(body.bytes(), &result) {
    return Err(f"decoding members: {e}")
  }
  Ok(result.items.map(|m| m.name))
}

/// Every label name, for the label chooser. Unfiltered by team on purpose:
/// labels created without --team are workspace-wide, and resolve_label — the
/// same lookup the filter itself goes through — does not scope by team either.
fn fetch_label_names() -> Result<Slice<string>, string> {
  let body = pb.get("/api/collections/labels/records?perPage=200&sort=name")?
  let mut result = models.LabelList { .. }
  if let Err(e) = json.Unmarshal(body.bytes(), &result) {
    return Err(f"decoding labels: {e}")
  }
  Ok(result.items.map(|l| l.name))
}

/// The issues table: one sortable, filterable, bookmarkable list.
///
/// ZERO JavaScript. Column headers are <a href="?sort=-updated">, the filter
/// chooser is a plain GET <form>, and both land back here as query params fed
/// to query.sort() and query.filter(). So the URL is the entire page state:
/// bookmarkable in a browser, and `curl '/issues?state=todo&sort=-priority'`
/// gets an agent exactly what a person sees.
///
/// No SSE either. /events broadcasts ONE unfiltered #board fragment to every
/// board-scoped client, so a server-filtered page that subscribed would be
/// morphed into the full board on the next realtime event. A table whose
/// state lives in its URL reloads honestly instead.
///
/// A rejected query param is said out loud in the flash strip and dropped,
/// never served as a 500: a stale bookmark should still show issues.
fn issues_page(w: http.ResponseWriter, r: Ref<http.Request>, team_id: string, me: string) {
  let mut err = ""

  let mut sort = query_param(r, "sort")
  if sort == "" { sort = "-updated" }
  if let Err(e) = query.sort(sort) {
    err = e
    sort = "-updated"
  }

  let mut state = query_param(r, "state")
  if state != "" && query.states().find(|s| s == state).is_none() {
    err = f"unknown state '{state}' (use one of: {strings.Join(query.states(), ", ")})"
    state = ""
  }

  let mut assignee = query_param(r, "assignee")
  let mut assignee_id = ""
  if assignee != "" {
    match resolve_member(assignee) {
      Ok(m) => { assignee_id = m.id },
      Err(e) => {
        err = e
        assignee = ""
      },
    }
  }

  let mut label = query_param(r, "label")
  let mut label_id = ""
  if label != "" {
    match resolve_label(label) {
      Ok(l) => { label_id = l.id },
      Err(e) => {
        err = e
        label = ""
      },
    }
  }

  let q = IssuesQuery { state, assignee, label, sort }
  let list = match fetch_issue_rows(team_id, state, assignee_id, label_id, sort) {
    Ok(l) => l,
    Err(e) => {
      http.Error(w, e, 500)
      return
    },
  }
  // The choosers offer the whole workspace, not just what this filter
  // matched: a filter you cannot widen out of is a dead end.
  let members = fetch_member_names().unwrap_or([])
  let label_names = fetch_label_names().unwrap_or([])

  let rows = list.items.map(card_vm)
  let vm = IssuesVM {
    cols: issue_cols(q),
    rows,
    shown: rows.length(),
    total: list.total_items,
    truncated: rows.length() < list.total_items,
    limit: table_page_size(),
    states: state_opts(),
    members,
    label_names,
    state,
    assignee,
    label,
    sort,
    clear_href: issues_href(IssuesQuery { sort, .. }),
    error: err,
  }
  let html = match render("issues-page", PageVM { rail: rail_vm("issues", me, shell_team(team_id)), page: vm }) {
    Ok(h) => h,
    Err(e) => {
      http.Error(w, e, 500)
      return
    },
  }
  w.Header().Set("Cache-Control", "no-store")
  w.Header().Set("Content-Type", "text/html; charset=utf-8")
  let _ = w.Write(html.bytes())
}

// ---------- /settings ----------

/// The workspace's shared settings: labels, members, projects, and the team's
/// name and accent colour.
fn settings_page(
  w: http.ResponseWriter,
  // The page takes no parameters: everything on it is the workspace's, and
  // there is nothing here to scope by query string.
  _r: Ref<http.Request>,
  team_id: string,
  me: string,
) {
  let team = shell_team(team_id)
  let vm = match settings_vm(team) {
    Ok(v) => v,
    Err(e) => {
      http.Error(w, e, 500)
      return
    },
  }
  let page = PageVM { rail: rail_vm("settings", me, team), page: vm }
  let html = match render("settings-page", page) {
    Ok(h) => h,
    Err(e) => {
      http.Error(w, e, 500)
      return
    },
  }
  w.Header().Set("Cache-Control", "no-store")
  w.Header().Set("Content-Type", "text/html; charset=utf-8")
  let _ = w.Write(html.bytes())
}

fn settings_vm(team: models.Team) -> Result<SettingsVM, string> {
  let hex = normalize_hex(team.accent)
  let mut accent = hex
  if accent == "" { accent = "#f0883e" }
  let labels = fetch_labels()?
  let members = fetch_members()?
  let projects = fetch_projects()?
  Ok(SettingsVM {
    team_key: team.key,
    team_name: team.name,
    accent,
    accent_set: hex != "",
    labels: labels.map(|l| SetLabelVM {
      id: l.id,
      name: l.name,
      color: normalize_hex(l.color),
      scope: scope_label(l.expand.team.key),
    }),
    members: members.map(|m| SetMemberVM { id: m.id, name: m.name, email: m.email }),
    projects: projects.map(|p| SetProjectVM {
      id: p.id,
      name: p.name,
      status: p.status,
      scope: scope_label(p.expand.team.key),
    }),
    statuses: project_statuses().map(|s| StateOpt { value: s, label: state_label(s) }),
  })
}

/// A record's owning team key, or the word for "owned by no team".
fn scope_label(key: string) -> string {
  if key == "" { return "workspace" }
  key
}

fn fetch_labels() -> Result<Slice<models.Label>, string> {
  let body = pb.get(
    "/api/collections/labels/records?perPage=200&sort=name&expand=team",
  )?
  let mut list = models.LabelList { .. }
  if let Err(e) = json.Unmarshal(body.bytes(), &list) {
    return Err(f"decoding labels: {e}")
  }
  Ok(list.items)
}

fn fetch_members() -> Result<Slice<models.Member>, string> {
  let body = pb.get("/api/collections/members/records?perPage=200&sort=name")?
  let mut list = models.MemberList { .. }
  if let Err(e) = json.Unmarshal(body.bytes(), &list) {
    return Err(f"decoding members: {e}")
  }
  Ok(list.items)
}

fn fetch_projects() -> Result<Slice<models.Project>, string> {
  let body = pb.get(
    "/api/collections/projects/records?perPage=200&sort=name&expand=team",
  )?
  let mut list = models.ProjectList { .. }
  if let Err(e) = json.Unmarshal(body.bytes(), &list) {
    return Err(f"decoding projects: {e}")
  }
  Ok(list.items)
}

/// Patch bodies. Each carries exactly the fields the page edits and no
/// others: PocketBase replaces every field it is handed, so a struct wide
/// enough to include, say, a project description would blank descriptions the
/// page never showed.
#[json]
struct TeamPatch { name: string, accent: string }

#[json]
struct LabelPatch { name: string, color: string }

#[json]
struct MemberPatch { name: string, email: string }

#[json]
struct ProjectPatch { name: string, status: string }

/// One handler for every settings write: `kind` picks the section, an `id`
/// picks update over create, and `?del=1` picks removal.
///
/// The reply is the action's own SSE body — /settings opens no /events
/// connection at all. The bridge broadcasts one unfiltered #board to every
/// board-scoped client, so a settings page on that scope would have to defend
/// against fragments meant for a different view; answering in the response
/// needs no defence, and the page has no realtime story to get wrong.
fn settings_action(
  w: http.ResponseWriter,
  r: Ref<http.Request>,
  team_id: string,
  me: string,
) {
  if let Err(e) = settings_write(r, team_id) {
    flash_error(w, e)
    return
  }
  w.Header().Set("Content-Type", "text/event-stream")
  let _ = w.Write(
    patch_event("<div id=\"flash\" class=\"flash\" hidden></div>").bytes(),
  )
  let team = shell_team(team_id)
  if let Ok(vm) = settings_vm(team) {
    if let Ok(html) = render("settings", vm) {
      let _ = w.Write(patch_event(html).bytes())
    }
  }
  // The accent lives in <head>, outside #settings: patch it by id too, so a
  // new colour lands on the open page instead of waiting for a reload.
  if let Ok(html) = render("accent-head", rail_vm("settings", me, team)) {
    let _ = w.Write(patch_event(html).bytes())
  }
}

fn settings_write(r: Ref<http.Request>, team_id: string) -> Result<(), string> {
  let kind = r.PathValue("kind")
  let id = strings.TrimSpace(r.PostFormValue("id"))
  let name = strings.TrimSpace(r.PostFormValue("name"))

  // FormValue, not PostFormValue: delete travels as a query param so the row
  // form can post its own body unchanged.
  if r.FormValue("del") != "" {
    let coll = settings_collection(kind)?
    if id == "" { return Err("nothing to delete") }
    let _ = pb.delete(f"/api/collections/{coll}/records/{id}")?
    return Ok(())
  }

  match kind {
    "team" => {
      if team_id == "" {
        return Err("no team configured: set LLL_TEAM or 'team' in .lll.toml")
      }
      if name == "" { return Err("team name is required") }
      let accent = form_hex(r, "accent")?
      let payload = match json.Marshal(TeamPatch { name, accent }) {
        Ok(p) => p as string,
        Err(e) => return Err(f"encoding team: {e}"),
      }
      let _ = pb.patch(f"/api/collections/teams/records/{team_id}", payload)?
      Ok(())
    },
    "label" => {
      if name == "" { return Err("label name is required") }
      let color = form_hex(r, "color")?
      save_record("labels", id, LabelPatch { name, color })
    },
    "member" => {
      if name == "" { return Err("member name is required") }
      let email = strings.TrimSpace(r.PostFormValue("email"))
      save_record("members", id, MemberPatch { name, email })
    },
    "project" => {
      if name == "" { return Err("project name is required") }
      let status = r.PostFormValue("status")
      if project_statuses().find(|s| s == status).is_none() {
        return Err(f"unknown project status '{status}'")
      }
      save_record("projects", id, ProjectPatch { name, status })
    },
    other => Err(f"unknown settings section '{other}'"),
  }
}

/// A "#rrggbb" form field: "" clears the colour, anything unparseable is a
/// user error rather than a silent fallback — a typed hex that quietly did
/// nothing would be the worst of both.
fn form_hex(r: Ref<http.Request>, field: string) -> Result<string, string> {
  let raw = strings.TrimSpace(r.PostFormValue(field))
  if raw == "" { return Ok("") }
  let hex = normalize_hex(raw)
  if hex == "" { return Err(f"'{raw}' is not a #rrggbb colour") }
  // The canonical orange is stored as "no choice", so a team that picks it
  // back gets theme.css's exact tokens instead of a derived copy of them.
  if field == "accent" && hex == "#f0883e" { return Ok("") }
  Ok(hex)
}

/// Sections whose rows can be deleted. The team is not one: it owns every
/// issue's key, and `lll team` has no delete either.
fn settings_collection(kind: string) -> Result<string, string> {
  match kind {
    "label" => Ok("labels"),
    "member" => Ok("members"),
    "project" => Ok("projects"),
    other => Err(f"cannot delete from '{other}'"),
  }
}

/// Create (no id) or update (id) one record.
fn save_record(coll: string, id: string, value: Unknown) -> Result<(), string> {
  let payload = match json.Marshal(value) {
    Ok(p) => p as string,
    Err(e) => return Err(f"encoding {coll}: {e}"),
  }
  if id == "" {
    let _ = pb.post(f"/api/collections/{coll}/records", payload)?
  } else {
    let _ = pb.patch(f"/api/collections/{coll}/records/{id}", payload)?
  }
  Ok(())
}

// ---------- /events ----------

/// SSE endpoint: register with the hub under the page's scope and forward
/// broadcast payloads until the browser disconnects.
fn events_stream(w: http.ResponseWriter, r: Ref<http.Request>, hub: Hub) {
  let mut page = ""
  let mut key = ""
  if let Some(u) = r.URL {
    let q = u.Query()
    page = q.Get("page")
    key = q.Get("key")
  }
  let mut scope = "board"
  if page == "issue" && key != "" { scope = f"issue:{key}" }

  let Some(flusher) = assert_type<http.Flusher>(w) else {
    http.Error(w, "streaming unsupported", 500)
    return
  }
  w.Header().Set("Content-Type", "text/event-stream")
  w.Header().Set("Cache-Control", "no-cache")
  w.WriteHeader(200)
  flusher.Flush()

  let Some(id) = hub.ids.receive() else {
    return
  }
  let ch = Channel.buffered<string>(64)
  let _ = hub.register.send(SseClient { id, scope, ch })
  let done = r.Context().Done()
  loop {
    let quit = select {
      match ch.receive() {
        Some(payload) => {
          let _ = w.Write(payload.bytes())
          flusher.Flush()
          false
        },
        None => true,
      },
      match done.receive() {
        Some(_) => true,
        None => true,
      },
    }
    if quit {
      let _ = hub.unregister.send(id)
      return
    }
  }
}

// ---------- PB realtime bridge ----------

/// Consume PB realtime events forever; re-render and broadcast fragments.
fn bridge(events: Channel<realtime.Event>, hub: Hub, team_id: string) {
  loop {
    let Some(ev) = events.receive() else {
      return
    }
    if ev.topic == "comments" {
      comment_broadcast(ev, hub)
    } else if ev.topic == "favorites" {
      favorites_broadcast(hub)
    } else {
      issue_broadcast(ev, hub, team_id)
    }
  }
}

/// On any issues event: re-render the whole board fragment from a fresh
/// fetch (laziest correct — a state change moves a card between two columns,
/// and one #board morph covers create/update/delete alike), plus the
/// issue-detail fragment for that issue's page, from the event record.
fn issue_broadcast(ev: realtime.Event, hub: Hub, team_id: string) {
  if let Ok(vm) = board_vm(team_id) {
    if let Ok(html) = render("board", vm) {
      let _ = hub.broadcast.send(
        Broadcast { scope: "board", payload: patch_event(html) },
      )
    }
  }

  let mut event = IssueEvent { .. }
  if json.Unmarshal(ev.data.bytes(), &event).is_err() { return }
  let rec = event.record
  let key = f"{rec.expand.team.key}-{rec.number}"
  let mut vm = issue_vm(rec, [])
  if event.action == "delete" { vm = IssueVM { deleted: true, key, .. } }
  if let Ok(html) = render("issue-detail", vm) {
    let _ = hub.broadcast.send(
      Broadcast { scope: f"issue:{key}", payload: patch_event(html) },
    )
  }
}

/// On any favorites event: re-render the rail's FAVORITES group from a fresh
/// fetch and patch it into every open page.
///
/// This is the one fragment that reaches inside #rail. It is legal because
/// the group is its own morph boundary with its own id: the shell itself is
/// still never rendered into a broadcast, so a page keeps the rail it was
/// served and only this group is replaced. Everything else in the rail stays
/// frozen at page load, by design.
///
/// The event's own record is ignored — the group is the whole list, and one
/// fetch is cheaper than reconciling a create against a delete.
fn favorites_broadcast(hub: Hub) {
  if let Ok(html) = render("rail-favorites", fav_vms()) {
    let _ = hub.broadcast.send(
      Broadcast { scope: "*", payload: patch_event(html) },
    )
  }
}

/// On any comments event: re-render the comments fragment for the affected
/// issue's page. The board shows no comments, so it is left alone.
fn comment_broadcast(ev: realtime.Event, hub: Hub) {
  let mut event = CommentEvent { .. }
  if json.Unmarshal(ev.data.bytes(), &event).is_err() { return }
  // Resolve the issue for the page scope; a comment whose issue is already
  // deleted has no page to update.
  let Ok(body) = pb.get(
    f"/api/collections/issues/records/{event.record.issue}?expand=team",
  ) else {
    return
  }
  let mut issue = models.Issue { .. }
  if json.Unmarshal(body.bytes(), &issue).is_err() { return }
  let key = f"{issue.expand.team.key}-{issue.number}"
  let Ok(comments) = fetch_comments(issue.id) else {
    return
  }
  if let Ok(html) = render(
    "comments",
    CommentsVM { comments: comments.map(comment_vm) },
  ) {
    let _ = hub.broadcast.send(
      Broadcast { scope: f"issue:{key}", payload: patch_event(html) },
    )
  }
}

// ---------- actions (write to PB, return 204 — UI updates via broadcast) ----------

/// Respond to a Datastar action by patching the #flash strip. Always 200
/// with an SSE body: Datastar does not reliably process non-2xx bodies, so
/// errors travel in-band; success clears the strip and the data itself
/// arrives via the broadcast, same as CLI-driven changes.
fn flash_error(w: http.ResponseWriter, msg: string) {
  let safe = template.HTMLEscapeString(msg)
  respond_flash(w, f"<div id=\"flash\" class=\"flash\">{safe}</div>")
}

fn flash_clear(w: http.ResponseWriter) {
  respond_flash(w, "<div id=\"flash\" class=\"flash\" hidden></div>")
}

fn respond_flash(w: http.ResponseWriter, html: string) {
  w.Header().Set("Content-Type", "text/event-stream")
  let _ = w.Write(patch_event(html).bytes())
}

fn create_action(w: http.ResponseWriter, r: Ref<http.Request>, team_id: string) {
  let title = strings.TrimSpace(r.PostFormValue("title"))
  let state = r.PostFormValue("state")
  if title == "" {
    flash_error(w, "title is required")
    return
  }
  if query.states().find(|s| s == state).is_none() {
    flash_error(w, f"unknown state '{state}'")
    return
  }
  if team_id == "" {
    flash_error(w, "no team configured: set LLL_TEAM or 'team' in .lll.toml")
    return
  }
  let new_issue = models.NewIssue { team: team_id, title, state, .. }
  let payload = match json.Marshal(new_issue) {
    Ok(p) => p,
    Err(e) => {
      flash_error(w, f"encoding issue: {e}")
      return
    },
  }
  if let Err(e) = pb.post("/api/collections/issues/records", payload as string) {
    flash_error(w, e)
    return
  }
  flash_clear(w)
}

/// Patch payload for /state: target state plus manual board position.
#[json]
struct StatePatch { state: string, sort: float64 }

fn state_action(w: http.ResponseWriter, r: Ref<http.Request>, team_id: string) {
  // FormValue, not PostFormValue: drag-and-drop posts key/state as query params.
  let key = r.FormValue("key")
  let state = r.FormValue("state")
  // Record id of the card the drop lands before; "" means end of column.
  let before = r.FormValue("before")
  if query.states().find(|s| s == state).is_none() {
    flash_error(w, f"unknown state '{state}'")
    return
  }
  let issue = match fetch_issue(key) {
    Ok(i) => i,
    Err(e) => {
      flash_error(w, e)
      return
    },
  }
  let sort = match reorder_sort(issue, state, before, team_id) {
    Ok(s) => s,
    Err(e) => {
      flash_error(w, e)
      return
    },
  }
  let payload = match json.Marshal(StatePatch { state, sort }) {
    Ok(p) => p,
    Err(e) => {
      flash_error(w, f"encoding state change: {e}")
      return
    },
  }
  if let Err(e) = pb.patch(
    f"/api/collections/issues/records/{issue.id}",
    payload as string,
  ) {
    flash_error(w, e)
    return
  }
  flash_clear(w)
}

/// New manual position for `issue` landing in `state` before the record id
/// `before` ("" = end of column): the fractional midpoint of its neighbors'
/// sorts, so a reorder patches exactly one record.
fn reorder_sort(
  issue: models.Issue,
  state: string,
  before: string,
  team_id: string,
) -> Result<float64, string> {
  // Dropping a card onto itself moves nothing.
  if before == issue.id { return Ok(issue.sort) }
  let others = fetch_column_issues(team_id, state)?.filter(|i| i.id != issue.id)
  if others.is_empty() { return Ok(issue.sort) }
  let Some(target) = others.find(|i| i.id == before) else {
    // End of column — also the fallback when `before` went stale (moved or
    // deleted between the drop and this request).
    return Ok(others[others.length() - 1].sort + 1.0)
  }
  // Sort of the card just above the drop slot; before the first card, a
  // synthetic target.sort - 2 makes the midpoint land strictly first.
  let mut prev_sort = target.sort - 2.0
  for i in others {
    if i.id == before { break }
    prev_sort = i.sort
  }
  Ok((prev_sort + target.sort) / 2.0)
}

/// One column's issues in board order (no expands — reorder needs ids and
/// sorts only).
fn fetch_column_issues(team_id: string, state: string) -> Result<Slice<models.Issue>, string> {
  let filter = query.filter(team_id, state, "", "", "", "")
  let path = f"/api/collections/issues/records?perPage=200&sort=sort,created&filter={url.QueryEscape(filter)}"
  let body = pb.get(path)?
  let mut issues = models.IssueList { .. }
  if let Err(e) = json.Unmarshal(body.bytes(), &issues) {
    return Err(f"decoding issues: {e}")
  }
  Ok(issues.items)
}

/// Star or unstar an issue for the workspace: `on=true` adds, anything else
/// removes.
///
/// A set, not a toggle. The button posts the state it just moved to, so a
/// double click or a stale page converges on what the user sees instead of
/// flipping the row out from under them. Both directions are idempotent.
fn favorite_action(w: http.ResponseWriter, r: Ref<http.Request>) {
  let key = r.FormValue("key")
  let on = r.FormValue("on") == "true"
  let issue = match fetch_issue(key) {
    Ok(i) => i,
    Err(e) => {
      flash_error(w, e)
      return
    },
  }
  let existing = match fetch_favorite(issue.id) {
    Ok(f) => f,
    Err(e) => {
      flash_error(w, e)
      return
    },
  }
  if on {
    if existing.is_some() {
      flash_clear(w)
      return
    }
    // member stays empty: workspace-wide until auth (task-32) lands.
    let payload = match json.Marshal(models.NewFavorite { issue: issue.id, .. }) {
      Ok(p) => p,
      Err(e) => {
        flash_error(w, f"encoding favorite: {e}")
        return
      },
    }
    if let Err(e) = pb.post(
      "/api/collections/favorites/records",
      payload as string,
    ) {
      flash_error(w, e)
      return
    }
  } else if let Some(fav) = existing {
    if let Err(e) = pb.delete(f"/api/collections/favorites/records/{fav.id}") {
      flash_error(w, e)
      return
    }
  }
  flash_clear(w)
}

fn priority_action(w: http.ResponseWriter, r: Ref<http.Request>) {
  let key = r.FormValue("key")
  let slug = r.FormValue("priority")
  let Some(prio) = prio_value(slug) else {
    flash_error(w, f"unknown priority '{slug}'")
    return
  }
  let issue = match fetch_issue(key) {
    Ok(i) => i,
    Err(e) => {
      flash_error(w, e)
      return
    },
  }
  let payload = "{\"priority\":" + strconv.Itoa(prio) + "}"
  if let Err(e) = pb.patch(
    f"/api/collections/issues/records/{issue.id}",
    payload,
  ) {
    flash_error(w, e)
    return
  }
  flash_clear(w)
}

fn title_action(w: http.ResponseWriter, r: Ref<http.Request>) {
  let key = r.FormValue("key")
  let title = strings.TrimSpace(r.FormValue("title"))
  if title == "" {
    flash_error(w, "title is required")
    return
  }
  let issue = match fetch_issue(key) {
    Ok(i) => i,
    Err(e) => {
      flash_error(w, e)
      return
    },
  }
  // Marshal the title itself so quotes/backslashes in it stay valid JSON.
  let quoted = match json.Marshal(title) {
    Ok(q) => q,
    Err(e) => {
      flash_error(w, f"encoding title: {e}")
      return
    },
  }
  let payload = "{\"title\":" + (quoted as string) + "}"
  if let Err(e) = pb.patch(
    f"/api/collections/issues/records/{issue.id}",
    payload,
  ) {
    flash_error(w, e)
    return
  }
  flash_clear(w)
}

fn comment_action(w: http.ResponseWriter, r: Ref<http.Request>) {
  let key = r.PostFormValue("key")
  let body = strings.TrimSpace(r.PostFormValue("body"))
  if body == "" {
    flash_error(w, "comment body is required")
    return
  }
  let issue = match fetch_issue(key) {
    Ok(i) => i,
    Err(e) => {
      flash_error(w, e)
      return
    },
  }
  // Same honor-system authorship as `lll issue comment`: the member named by
  // 'me' in config, or authorless.
  let mut author = ""
  if let Ok(cfg) = config.load() {
    if cfg.me != "" {
      if let Ok(Some(m)) = find_member(cfg.me) { author = m.id }
    }
  }
  let new_comment = models.NewComment { issue: issue.id, author, body }
  let payload = match json.Marshal(new_comment) {
    Ok(p) => p,
    Err(e) => {
      flash_error(w, f"encoding comment: {e}")
      return
    },
  }
  if let Err(e) = pb.post(
    "/api/collections/comments/records",
    payload as string,
  ) {
    flash_error(w, e)
    return
  }
  flash_clear(w)
}
