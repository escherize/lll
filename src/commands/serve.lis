import "go:fmt"
import "go:github.com/escherize/lll/web"
import "go:net/http"
import "go:net"

import "config"
import "models"
import "pb"
import "query"
import "realtime"

// The web board — a server-rendered board with realtime updates, started by
// `lll up`.
//
// Architecture: browsers hold ONE SSE connection to /events. The server holds
// one unfiltered (team-scoped at most) PB realtime subscription to issues +
// comments; on any event it re-renders the affected fragments and broadcasts
// them as datastar-patch-elements SSE events, which Datastar morphs into the
// DOM by element id. Actions (@post) write to PB and return 204 — the UI
// updates via the same broadcast as CLI-driven changes, so there is no
// swap-on-POST double-update race.
//
// Templates and static assets are compiled into the binary (see web/embed.go),
// so the board serves from any working directory. Markup edits need a rebuild:
// edit, `mise run dev`, refresh.

/// Start the board server on `port`. The board is `lll up`'s web half.
///
/// `refresh` re-mints the process's PocketBase token after an auth-shaped
/// realtime reconnect failure (the boot passes its superuser credentials'
/// minter when it owns the token; None when the caller brought a member
/// token the process cannot renew). See realtime.subscribe.
pub fn run_server(port: int, refresh: Option<fn() -> Result<string, string>>) -> Result<(), string> {
  // The gate's env token, resolved (and generated when unset) before any
  // request can arrive — the handlers and the banner below must agree.
  let board_tok = resolve_board_token()
  // Resolve the team scope once; card/board fetches and the realtime
  // subscription share it. No configured team means an unscoped board.
  let cfg = config.load()?
  let team_id = configured_team_id()?

  // Fail fast on broken templates before accepting connections — both
  // pages, because they share the rail and a typo in it breaks every page.
  let shell = rail_vm("board", cfg.me, models.Team { .. })
  let _ = render(
    "board-page",
    PageVM { rail: shell, page: BoardVM { states: state_opts(), columns: [], .. } },
  )?
  let _ = render("issue-page", PageVM { rail: shell, page: IssueVM { .. } })?
  let _ = render("issues-page", PageVM { rail: shell, page: IssuesVM { .. } })?
  let _ = render("settings-page", PageVM { rail: shell, page: SettingsVM { .. } })?
  let _ = render("search-page", PageVM { rail: shell, page: SearchVM { .. } })?
  let _ = render("projects-page", PageVM { rail: shell, page: ProjectsVM { .. } })?

  // One PB subscription for everything. Issues are team-scoped at most —
  // never state-filtered: PB emits nothing when an update moves a record out
  // of a subscription filter, so filtered board columns would go stale.
  let issues_topic = realtime.topic_with_options(
    "issues",
    query.filter(team_id, "", "", "", "", ""),
    "team,assignee,labels,project",
  )?
  let comments_topic = realtime.topic_with_options("comments", "", "author")?
  // Favorites and saved views drive their own rail groups, which every
  // page shows, so these topics are unfiltered too.
  let events = realtime.subscribe(
    pb.base_url()?,
    [issues_topic, comments_topic, "favorites", "views"],
    refresh,
  )?

  let hub = new_hub()
  task {
    bridge(events, hub, team_id)
  }

  // Every route sits behind the board gate (serve_gate.lis): pages, writes,
  // the SSE stream and static assets alike answer only board-token requests.
  http.HandleFunc(
    "GET /{$}",
    gated(|w: http.ResponseWriter, r: Ref<http.Request>| {
      board_page(w, r, team_id, cfg.me)
    }),
  )
  http.HandleFunc(
    "GET /issues",
    gated(|w: http.ResponseWriter, r: Ref<http.Request>| {
      issues_page(w, r, team_id, cfg.me)
    }),
  )
  http.HandleFunc(
    "GET /issue/{key}",
    gated(|w: http.ResponseWriter, r: Ref<http.Request>| {
      issue_page(w, r, team_id, cfg.me)
    }),
  )
  http.HandleFunc(
    "GET /projects",
    gated(|w: http.ResponseWriter, r: Ref<http.Request>| {
      projects_page(w, r, team_id, cfg.me)
    }),
  )
  http.HandleFunc(
    "GET /settings",
    gated(|w: http.ResponseWriter, r: Ref<http.Request>| {
      settings_page(w, r, team_id, cfg.me)
    }),
  )
  // Every POST is a write returning Result; `flashing` (serve_actions.lis) is
  // the one place an Err becomes the flash strip.
  http.HandleFunc(
    "POST /settings/{kind}",
    gated(flashing(|r: Ref<http.Request>| settings_write(r, team_id, cfg.me))),
  )
  http.HandleFunc(
    "GET /search",
    gated(|w: http.ResponseWriter, r: Ref<http.Request>| {
      search_page(w, r, team_id, cfg.me)
    }),
  )
  http.HandleFunc(
    "GET /events",
    gated(|w: http.ResponseWriter, r: Ref<http.Request>| {
      events_stream(w, r, hub)
    }),
  )
  http.HandleFunc(
    "POST /create",
    gated(flashing(|r: Ref<http.Request>| create_write(r, team_id))),
  )
  http.HandleFunc(
    "POST /state",
    gated(flashing(|r: Ref<http.Request>| state_write(r, team_id))),
  )
  http.HandleFunc("POST /favorite", gated(flashing(favorite_write)))
  http.HandleFunc("POST /priority", gated(flashing(priority_write)))
  http.HandleFunc("POST /emoji", gated(flashing(emoji_write)))
  http.HandleFunc("POST /title", gated(flashing(title_write)))
  http.HandleFunc("POST /project", gated(flashing(project_write)))
  http.HandleFunc("POST /assignee", gated(flashing(assignee_write)))
  http.HandleFunc("POST /labels", gated(flashing(labels_write)))
  http.HandleFunc("POST /comment", gated(flashing(comment_write)))
  http.HandleFunc("POST /views/save", gated(flashing(views_save)))
  // The embedded tree keeps its repo paths, so "/static/theme.css" resolves to
  // "static/theme.css" with no prefix surgery.
  let assets = http.FileServerFS(web.Assets())
  http.HandleFunc("GET /static/", |w: http.ResponseWriter, r: Ref<http.Request>| {
    if admit(w, r) {
      assets.ServeHTTP(w, r)
    }
  })

  // Bind BEFORE announcing: "board <url>" is the promise that the board is
  // accepting connections, and e2e_web.sh curls the URL the moment the line
  // is printed — announcing before the listen made that a race that fast
  // runners lose (CI run 33343854995).
  let listener = match net.Listen("tcp", f"127.0.0.1:{port}") {
    Ok(l) => l,
    Err(e) => return Err(f"server: {e}"),
  }
  fmt.Println(f"board  http://127.0.0.1:{port}")
  fmt.Println(
    f"board  login http://127.0.0.1:{port}/?board_token={board_tok} (sets a cookie; LLL_BOARD_TOKEN pins it)",
  )
  match http.Serve(listener, http.DefaultServeMux) {
    Ok(_) => Ok(()),
    Err(e) => Err(f"server: {e}"),
  }
}
