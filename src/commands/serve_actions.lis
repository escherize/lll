import "records"
import "claims"
import "go:encoding/json"
import "go:html/template"
import "go:net/http"
import "go:strings"

import "display"
import "models"
import "pb"
import "query"

// Actions: the endpoints the board posts to. Each writes to PocketBase and
// answers with a flash; the data itself comes back through the broadcast, the
// same way a CLI-driven change does.

/// Turn a write into the handler that registration wants.
///
/// http.HandleFunc fixes the handler signature, so a write cannot return its
/// own Result to the mux — something has to consume one, and applying this
/// once per route is that something. It buys every action below the right to
/// spend a `?` where it used to spend a six-line match, and it puts the only
/// two answers an action can give, flash the error or clear the strip, in the
/// one place instead of once per fallible step.
///
/// The Ok value is any extra SSE the action owes the page past the cleared
/// flash. Almost none owes any and returns "".
fn flashing(
  write: fn(mut Ref<http.Request>) -> Result<string, string>,
) -> fn(http.ResponseWriter, Ref<http.Request>) {
  |w: http.ResponseWriter, r: Ref<http.Request>| {
    // The mux hands out read-only requests; parsing a form body is a write
    // (it caches into r.Form). Clone is the sanctioned upgrade: the copy is
    // ours to parse, and it shares the one Body stream each action reads once.
    let mut wr = r.Clone(r.Context())
    finish_action(w, wr, write(wr))
  }
}

/// The same, for the one write that must also touch the response headers
/// (LLL-375): /views/save hands the browser the saved view's cookie, and a
/// Set-Cookie has to be on the writer before the flash body is written.
fn flashing_with(
  write: fn(http.ResponseWriter, mut Ref<http.Request>) -> Result<string, string>,
) -> fn(http.ResponseWriter, Ref<http.Request>) {
  |w: http.ResponseWriter, r: Ref<http.Request>| {
    let mut wr = r.Clone(r.Context())
    finish_action(w, wr, write(w, wr))
  }
}

/// The only two answers an action can give — flash the error or clear the
/// strip — consumed in one place instead of once per fallible step.
fn finish_action(
  w: http.ResponseWriter,
  wr: mut Ref<http.Request>,
  result: Result<string, string>,
) {
  // Only known surfaces may choose an inline alert. The create dialog
  // must not send its errors behind the modal shade to the page strip.
  let target = if wr.PostFormValue("flash_target") == "ni-flash" { "ni-flash" } else { "flash" }
  match result {
    Ok(extra) => {
      action_flash(w, target, "")
      if extra != "" { let _ = w.Write(extra.bytes()) }
    },
    Err(e) => {
      action_flash(w, target, e)
      if wr.PostFormValue("property_edit") == "1" {
        let _ = w.Write(property_recovery(wr.FormValue("key"), board_viewer(wr)).bytes())
      }
    },
  }
}

/// A PocketBase request body, from a `#[json]` struct. Every write goes
/// through here, so no endpoint has to spell JSON by hand to save a line.
fn marshal(value: Unknown) -> Result<string, string> {
  match json.Marshal(value) {
    Ok(p) => Ok(p as string),
    Err(e) => Err(f"encoding request: {e}"),
  }
}

/// PATCH one field group onto an issue. Every caller knows the record id, so
/// this is a plain update, not a create-or-update.
fn patch_issue(caller: pb.Caller, id: string, value: Unknown) -> Result<string, string> {
  let _ = pb.send_as(caller, "PATCH", f"/api/collections/issues/records/{id}", marshal(value)?, "application/json")?
  Ok("")
}

/// Who a board write runs as (LLL-545). The board token writes as the
/// board's own member, as it always has. A read-write member viewer writes
/// with its own token, so PocketBase checks its teams and mode and records
/// it as the author; `scope` keeps the issue lookup inside its teams.
struct Acting {
  caller: pb.Caller,
  member: Option<ViewerMember>,
  scope: Option<ScopedViewer>,
}

/// The acting identity for this write. The gate already refused a read-only
/// viewer's POST; this refuses again rather than fall back to the process.
fn acting_as(r: Ref<http.Request>) -> Result<Acting, string> {
  match board_viewer(r) {
    Viewer.Full => Ok(Acting { caller: pb.Caller.Process, member: None, scope: None }),
    Viewer.Scoped(v) => {
      let Some(m) = v.member else { return Err(scoped_read_only()) }
      if !m.rw { return Err(scoped_read_only()) }
      Ok(Acting { caller: pb.Caller.Member(m.token), member: Some(m), scope: Some(v) })
    },
  }
}

fn scoped_read_only() -> string {
  "read-only board login: it can read its teams but not change them"
}

impl Acting {
  /// The issue `key` names, when this actor may see it. One it may not see
  /// answers exactly as a missing one does.
  fn issue(self, key: string) -> Result<models.Issue, string> {
    let issue = records.fetch_issue(key)?
    if let Some(v) = self.scope {
      if !v.sees(issue.expand.team.key) { return Err(records.issue_not_found(key)) }
    }
    Ok(issue)
  }

  /// The member a write names as its author or claimant: the viewer, or the
  /// board's own member for the board token.
  fn member_id(self) -> Result<Option<string>, string> {
    if let Some(m) = self.member { return Ok(Some(m.id)) }
    Ok(actor()?.map(|a| a.id))
  }
}

/// An archived team's board is read-only (TASK-210): every write that
/// mutates its records — creates and the issue editors alike — refuses with
/// the flash naming the way back. Free at the issue endpoints: each already
/// fetches the issue with its team expanded.
fn require_active_team(t: models.Team) -> Result<(), string> {
  if t.archived { return Err(archived_hint(t.key)) }
  Ok(())
}

/// One escaped alert response for the page strip and dialog-local errors.
/// Actions use 200/SSE for both outcomes; an empty message clears the alert.
fn action_flash(w: http.ResponseWriter, target: string, msg: string) {
  let presented = pb.display_error(msg)
  let safe = template.HTMLEscapeString(presented.summary)
  let details = if presented.details == "" { "" } else {
    f"<details class=\"error-details\"><summary>Technical details</summary><pre>{template.HTMLEscapeString(presented.details)}</pre></details>"
  }
  let hidden = if msg == "" { " hidden" } else { "" }
  respond_flash(w, f"<div id=\"{target}\" class=\"flash\"{hidden} role=\"alert\" aria-atomic=\"true\"><span class=\"error-summary\">{safe}</span>{details}</div>")
}

fn respond_flash(w: http.ResponseWriter, html: string) {
  w.Header().Set("Content-Type", "text/event-stream")
  let _ = w.Write(patch_event(html).bytes())
}

/// The board's one write path for new issues, shared by the topbar's
/// one-line composer and the full create dialog. Everything past `title` is
/// optional, so a request carrying only a title is byte-for-byte what it
/// always was and the fast path pays nothing for the dialog's existence.
///
/// Relation ids (assignee, project, labels) are handed to PocketBase
/// unchecked: the form only ever offers ids that exist, and PB rejects a
/// bogus one with a message the flash strip already knows how to show.
/// Re-validating here would mean three more fetches per create.
fn create_write(
  r: mut Ref<http.Request>,
  team_id: string,
) -> Result<string, string> {
  let title = strings.TrimSpace(r.PostFormValue("title"))
  if title == "" { return Err("title is required") }
  // Absent state means todo, the same default `lll issue create` uses, so
  // `curl -d title=...` is a complete request.
  let mut state = r.PostFormValue("state")
  if state == "" { state = "todo" }
  let _ = query.state(state)?
  // The board posts the team it is viewing (TASK-198); a request naming
  // none — a bare `curl -d title=...` — keeps landing in the boot team.
  let mut team = team_id
  let team_key = strings.TrimSpace(r.PostFormValue("team"))
  let who = acting_as(r)?
  // A scoped viewer names one of its own teams; the boot-team fallback is
  // not its to use, and a hidden team answers like a missing one.
  if let Some(v) = who.scope {
    if !v.sees(team_key) { return Err(unknown_team(team_key)) }
  }
  if team_key != "" {
    let Some(t) = records.find_team(team_key)? else {
      return Err(unknown_team(team_key))
    }
    // New issues do not land in an archived team (TASK-210), same refusal as
    // `lll issue create`. The boot-team fallback is checked fresh too: teams
    // archive from /settings while the server runs.
    require_active_team(t)?
    team = t.id
  } else {
    require_active_team(shell_team(team))?
  }
  if team == "" {
    return Err("no team configured: set LLL_TEAM or 'team' in .lll.toml")
  }
  let mut priority = 0
  let prio_slug = r.PostFormValue("priority")
  if prio_slug != "" {
    let Some(p) = display.priority_value(prio_slug) else {
      return Err(f"unknown priority '{prio_slug}'")
    }
    priority = p
  }
  // PostFormValue above has already parsed the body, so PostForm is populated;
  // labels is the one field that repeats (one checkbox per label).
  let labels = r.PostForm.map_or([], |form| {
    (form as Map<string, Slice<string>>)["labels"].filter(|id| id != "")
  })
  // A scoped viewer assigns only members of its roster for the team
  // (LLL-551), the ones its picker offered.
  let assignee = r.PostFormValue("assignee")
  if assignee != "" && who.scope.is_some() {
    let shown = roster_for(r, team)?
    if !shown.sees(assignee) {
      return Err(f"unknown member '{assignee}' — reload the page for the current list")
    }
  }
  let new_issue = models.NewIssue {
    creator: who.member_id()?.unwrap_or(""),
    origin: models.IssueOrigin { tool: "web", .. },
    team,
    title,
    state,
    priority,
    description: r.PostFormValue("description"),
    assignee,
    project: r.PostFormValue("project"),
    labels,
    ..,
  }
  let _ = pb.send_as(who.caller, "POST", "/api/collections/issues/records", marshal(new_issue)?, "application/json")?
  // Only a success closes the dialog and empties the composers, and the
  // server is what says so. If the client cleared optimistically, a rejected
  // create would take a typed description down with it — the field this whole
  // dialog exists for. Clearing new_title matters because the dialog opens
  // carrying the topbar's text: leaving it behind would arm a duplicate the
  // next time someone pressed Enter up there.
  Ok(signals_event("{\"ni_open\": false, \"new_title\": \"\"}"))
}

/// Patch bodies, one per editable field group. PocketBase replaces every
/// field it is handed, so each carries exactly what its endpoint edits and no
/// more. Going through a struct is also what keeps a quote, a backslash or a
/// multi-rune glyph in a title from having to be escaped by hand.
#[json]
struct StatePatch { state: string, sort: float64 }

#[json]
struct PriorityPatch { priority: int }

#[json]
struct EmojiPatch { emoji: string }

#[json]
struct TitlePatch { title: string }

/// Patch bodies for the issue page's Properties editors. `Issue` prefixed:
/// serve_settings.lis already owns ProjectPatch and friends for /settings.
#[json]
struct IssueProjectPatch { project: string }

#[json]
struct IssueAssigneePatch { assignee: string }

/// One label in, or one label out (LLL-519). PocketBase's relation
/// modifiers change only the named id, so a label another writer added after
/// the page rendered is kept.
#[json]
struct IssueLabelAddPatch {
  #[json("labels+")]
  add: Slice<string>,
}

#[json]
struct IssueLabelRemovePatch {
  #[json("labels-")]
  remove: Slice<string>,
}

fn state_write(r: mut Ref<http.Request>) -> Result<string, string> {
  // FormValue, not PostFormValue: drag-and-drop posts key/state as query params.
  let key = r.FormValue("key")
  let state = r.FormValue("state")
  // Record id of the card the drop lands before; "" means end of column.
  let before = r.FormValue("before")
  let _ = query.state(state)?
  let who = acting_as(r)?
  let issue = who.issue(key)?
  require_active_team(issue.expand.team)?
  // The issue's OWN team scopes the reorder (TASK-198): a drop on any
  // team's board must compute the midpoint against that team's column, not
  // the boot team's.
  let sort = reorder_sort(issue, state, before, issue.team)?
  patch_issue(who.caller, issue.id, StatePatch { state, sort })
}

/// New manual position for `issue` landing in `state` before the record id
/// `before` ("" = end of column): the fractional midpoint of its neighbors'
/// sorts, so a reorder patches exactly one record.
fn reorder_sort(
  issue: models.Issue,
  state: string,
  before: string,
  team_id: string,
) -> Result<float64, string> {
  // Dropping a card onto itself moves nothing.
  if before == issue.id { return Ok(issue.sort) }
  // Column-scoped fetch (LLL-428): only this column, board order, id+sort.
  let others = records.fetch_column_issues(team_id, state)?.filter(|i| i.id != issue.id)
  if others.is_empty() { return Ok(issue.sort) }
  let Some(target) = others.find(|i| i.id == before) else {
    // End of column — also the fallback when `before` went stale (moved or
    // deleted between the drop and this request).
    return Ok(others[others.length() - 1].sort + 1.0)
  }
  // Sort of the card just above the drop slot; before the first card, a
  // synthetic target.sort - 2 makes the midpoint land strictly first.
  let mut prev_sort = target.sort - 2.0
  for i in others {
    if i.id == before { break }
    prev_sort = i.sort
  }
  Ok((prev_sort + target.sort) / 2.0)
}

/// Star or unstar an issue for the workspace: `on=true` adds, anything else
/// removes.
///
/// A set, not a toggle. The button posts the state it just moved to, so a
/// double click or a stale page converges on what the user sees instead of
/// flipping the row out from under them. Both directions are idempotent.
fn favorite_write(r: mut Ref<http.Request>) -> Result<string, string> {
  let key = r.FormValue("key")
  let on = r.FormValue("on") == "true"
  let issue = records.fetch_issue(key)?
  let existing = fetch_favorite(issue.id)?
  if on {
    if existing.is_some() { return Ok("") }
    // member stays empty: workspace-wide until auth (task-32) lands.
    let payload = marshal(models.NewFavorite { issue: issue.id, .. })?
    let _ = pb.post("/api/collections/favorites/records", payload)?
  } else if let Some(fav) = existing {
    let _ = pb.delete(f"/api/collections/favorites/records/{fav.id}")?
  }
  Ok("")
}

fn priority_write(r: mut Ref<http.Request>) -> Result<string, string> {
  let key = r.FormValue("key")
  let slug = r.FormValue("priority")
  let Some(prio) = display.priority_value(slug) else {
    return Err(f"unknown priority '{slug}'")
  }
  let who = acting_as(r)?
  let issue = who.issue(key)?
  require_active_team(issue.expand.team)?
  patch_issue(who.caller, issue.id, PriorityPatch { priority: prio })
}

/// Set or clear the issue's marker from the web picker.
///
/// An empty `emoji` is the way back to "none" — a picker with no way to
/// unset would be a one-way trap — so this keys off the parameter being
/// present, exactly as `lll issue update --emoji ""` keys off the flag.
/// Validation is the CLI's `check_emoji`: the picker only ever posts one of
/// its own candidates, but the endpoint is curl-able like every other.
fn emoji_write(r: mut Ref<http.Request>) -> Result<string, string> {
  let key = r.FormValue("key")
  let Ok(emoji) = check_emoji(r.FormValue("emoji")) else {
    return Err("an issue takes one emoji, or none")
  }
  let who = acting_as(r)?
  let issue = who.issue(key)?
  require_active_team(issue.expand.team)?
  patch_issue(who.caller, issue.id, EmojiPatch { emoji })
}

fn title_write(r: mut Ref<http.Request>) -> Result<string, string> {
  let key = r.FormValue("key")
  let title = strings.TrimSpace(r.FormValue("title"))
  if title == "" { return Err("title is required") }
  let who = acting_as(r)?
  let issue = who.issue(key)?
  require_active_team(issue.expand.team)?
  patch_issue(who.caller, issue.id, TitlePatch { title })
}

fn project_write(r: mut Ref<http.Request>) -> Result<string, string> {
  let key = r.FormValue("key")
  let id = r.FormValue("project")
  // The issue first: its own team is what the posted id has to belong to,
  // and a project from another team is as unknown here as a deleted one
  // (TASK-173).
  let who = acting_as(r)?
  let issue = who.issue(key)?
  require_active_team(issue.expand.team)?
  if id != "" {
    let projects = records.fetch_projects(issue.team)?
    if projects.find(|p| p.id == id).is_none() {
      return Err(
        f"unknown project '{id}' — reload the page for the current list",
      )
    }
  }
  patch_issue(who.caller, issue.id, IssueProjectPatch { project: id })
}

fn assignee_write(r: mut Ref<http.Request>) -> Result<string, string> {
  let key = r.FormValue("key")
  let id = r.FormValue("assignee")
  let who = acting_as(r)?
  let issue = who.issue(key)?
  // The picker offers the viewer's roster for the issue's team (LLL-551); a
  // posted id outside it is as unknown as a deleted one.
  if id != "" {
    let members = roster_for(r, issue.team)?.members
    if members.find(|m| m.id == id).is_none() {
      return Err(
        f"unknown member '{id}' — reload the page for the current list",
      )
    }
  }
  require_active_team(issue.expand.team)?
  let observed = claims.observed_id(issue.id)?
  // Force, as the Release button sends it (LLL-516): a person who picks a new
  // assignee on a page that names the holder has decided to take the hold.
  // A forced clear comments on the issue, naming the board's member.
  let _ = claims.update_assignment(who.caller, issue.id, observed, marshal(IssueAssigneePatch { assignee: id })?, "", true, "")?
  Ok("")
}

/// Add or remove the one label whose chip was toggled: `label` is its id,
/// `on=true` adds, anything else removes. A set, not a toggle, like
/// favorite_write: the checkbox posts the state it just moved to.
///
/// Only the toggled label is written (LLL-519). Posting the whole checked set
/// replaced the field from the page's earlier read, which dropped a label
/// `lll issue update --add-label` added after the page rendered. The
/// server's per-issue lock serializes the modifiers.
fn labels_write(r: mut Ref<http.Request>) -> Result<string, string> {
  let key = r.FormValue("key")
  if key == "" {
    return Err(
      "labels_write got no issue key — reload the page; if it keeps happening, this is a bug in the labels form",
    )
  }
  let id = r.FormValue("label")
  if id == "" {
    return Err(
      "labels_write got no label — reload the page; if it keeps happening, this is a bug in the labels form",
    )
  }
  // The issue first, for its team: a label from another team is as unknown
  // here as a deleted one, which is what stops a POST crossing tenancy
  // however the checkbox got its id (TASK-173).
  let who = acting_as(r)?
  let issue = who.issue(key)?
  require_active_team(issue.expand.team)?
  let known = records.fetch_labels(issue.team)?
  if known.find(|l| l.id == id).is_none() {
    return Err(f"unknown label '{id}' — reload the page for the current list")
  }
  if r.FormValue("on") == "true" {
    patch_issue(who.caller, issue.id, IssueLabelAddPatch { add: [id] })
  } else {
    patch_issue(who.caller, issue.id, IssueLabelRemovePatch { remove: [id] })
  }
}

fn comment_write(r: mut Ref<http.Request>) -> Result<string, string> {
  let key = r.PostFormValue("key")
  let body = strings.TrimSpace(r.PostFormValue("body"))
  if body == "" { return Err("comment body is required") }
  let who = acting_as(r)?
  let issue = who.issue(key)?
  require_active_team(issue.expand.team)?
  let Some(author) = who.member_id()? else {
    return Err("commenting needs a member token — start the board with lll up")
  };
  let payload = marshal(models.NewComment { issue: issue.id, author, agent: "", body })?
  let _ = pb.send_as(who.caller, "POST", "/api/collections/comments/records", payload, "application/json")?
  // LLL-386/LLL-384: the comment arrives through the live stream, so the
  // composer was never told the write landed and kept the text - which reads
  // as "it did not send" and invites a second identical comment.
  //
  // Returned from the Ok branch ONLY, so a refusal (empty body, archived team)
  // leaves the draft exactly where it was. `mode replace` rather than a morph
  // because a morph retains the live value, which is the thing being cleared.
  let html = render("comment-composer", f"{issue.expand.team.key}-{issue.number}")?
  let lines = html.split("\n").map(|line| f"data: elements {line}")
  Ok(f"event: datastar-patch-elements\ndata: mode replace\ndata: selector #comment-form\n{strings.Join(lines, "\n")}\n\n")
}

/// Save the board's current view under a name (TASK-94, half two): one row
/// in `views` holding the query string it stands for. The rail renders the
/// row as the board URL that query string reproduces, so a saved view is a
/// name plus a query string and nothing else.
///
/// The query is canonicalized through the shared encoder before it is
/// stored — the form posts the board page's own rendering of the URL, but
/// the endpoint is curl-able like every other, and a view must always be
/// exactly the URL it will navigate to.
fn views_save(w: http.ResponseWriter, r: mut Ref<http.Request>) -> Result<string, string> {
  let name = strings.TrimSpace(r.PostFormValue("name"))
  if name == "" { return Err("a view needs a name") }
  if name.length() > 80 { return Err("view names are capped at 80 characters") }
  let raw_q = view_query_parse_raw(r.PostFormValue("query"))?
  let query_str = view_query_string(raw_q)
  if query_str.length() > 500 {
    return Err("this view's query string is too long to save")
  }
  // The unique index is the backstop; this pre-check is what makes the
  // flash strip say something a human can read.
  let mut existing = models.ViewList { .. }
  pb.fetch("/api/collections/views/records?perPage=200", "views", &existing)?
  if existing.items.any(|v| v.name == name) {
    return Err(f"a view named '{name}' already exists")
  }
  // member stays empty: workspace-wide until auth (task-32) lands.
  let payload = marshal(
    models.NewView { name, query: strings.TrimPrefix(query_str, "?"), .. },
  )?
  let _ = pb.post("/api/collections/views/records", payload)?
  // LLL-375: saving a view makes it this browser's view — the same cookie a
  // board GET would write, so a bare reload honors what was just saved even
  // if the page's own cookie went stale. The team key rides the form (the
  // endpoint stays curl-able without one); a cookie named for a team that
  // does not exist is never read, and the slugs are re-validated on every
  // read, so an unvalidated write here plants nothing a board would act on.
  let team_key = strings.TrimSpace(r.PostFormValue("team"))
  if team_key != "" {
    set_view_cookie(w, f"lll_view_{team_key}", raw_q.hide)
  }
  Ok("")
}

/// The board uses its process identity; the button names it explicitly.
fn claim_write(r: mut Ref<http.Request>) -> Result<string, string> {
  let who = acting_as(r)?
  let issue = who.issue(r.FormValue("key"))?
  require_active_team(issue.expand.team)?
  // A member viewer claims as itself, whatever name the shared live
  // fragment last rendered on the button (LLL-545).
  if let Some(m) = who.member {
    let _ = claims.acquire(who.caller, issue.id, m.id, "")?
    return Ok("")
  }
  let Some(member) = actor()? else { return Err("No member is configured for this board.") };
  if r.FormValue("member_id") != member.id { return Err("The board identity changed; refresh before claiming.") }
  let _ = claims.acquire(who.caller, issue.id, member.id, "")?
  Ok("")
}

/// Always forced (LLL-512): the button names whose claim it releases, so a
/// person clicking it has said so. The server skips the comment when the
/// board's own member is the holder, and otherwise records the release under
/// that member - the board login does not identify the person clicking.
fn release_write(r: mut Ref<http.Request>) -> Result<string, string> {
  let who = acting_as(r)?
  let issue = who.issue(r.FormValue("key"))?
  require_active_team(issue.expand.team)?
  let observed = r.FormValue("claim_id")
  if observed == "" { return Err("The claim changed; refresh before releasing it.") }
  let _ = claims.release(who.caller, issue.id, observed, "", true, "")?
  Ok("")
}
