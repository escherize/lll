import "go:strings"

import "query"

fn md(src: string) -> string {
  md_html(src) as string
}

#[test]
fn gfm_table_renders_as_a_table_not_literal_pipes() {
  let out = md("| a | b |
| --- | --- |
| 1 | 2 |
")
  assert strings.Contains(out, "<table>")
  assert strings.Contains(out, "<th>a</th>")
  assert strings.Contains(out, "<td>2</td>")
  assert !strings.Contains(out, "| a | b |")
}

#[test]
fn gfm_strikethrough_autolink_and_task_lists() {
  let out = md("~~gone~~ https://example.com/x

- [ ] todo
- [x] done
")
  assert strings.Contains(out, "<del>gone</del>")
  assert strings.Contains(out, "<a href=\"https://example.com/x\">")
  assert strings.Contains(out, "type=\"checkbox\"")
  assert strings.Contains(out, "checked=\"\"")
}

#[test]
fn fenced_code_is_tokenized_into_classes_not_inline_colors() {
  let out = md("```go
func f() {}
```
")
  assert strings.Contains(out, "class=\"chroma\"")
  assert strings.Contains(out, "class=\"kd\"")
  // WithClasses(true) means chroma never writes a hex color into the markup;
  // theme.css owns the palette.
  assert !strings.Contains(out, "style=\"color:")
}

#[test]
fn mermaid_fences_stay_plain_for_the_client_to_draw() {
  let out = md("```mermaid
graph TD; A-->B;
```
")
  assert strings.Contains(out, "<code class=\"language-mermaid\">")
  assert strings.Contains(out, "graph TD; A--&gt;B;")
  assert !strings.Contains(out, "class=\"chroma\"")
}

#[test]
fn hard_wraps_survive_the_gfm_and_highlighting_extensions() {
  assert strings.Contains(md("one
two
"), "one<br>")
}

#[test]
fn raw_html_is_still_dropped() {
  assert !strings.Contains(md("<script>alert(1)</script>"), "<script>")
}

// ---------- /issues: the URL is the page state ----------

#[test]
fn issues_href_omits_empty_parts_and_escapes_values() {
  assert issues_href(IssuesQuery { .. }) == "/issues"
  assert issues_href(IssuesQuery { sort: "-updated", .. }) == "/issues?sort=-updated"
  assert issues_href(
      IssuesQuery { state: "in-progress", assignee: "Ada L", sort: "created", .. },
    )
    == "/issues?state=in-progress&assignee=Ada+L&sort=created"
}

#[test]
fn a_header_link_changes_the_sort_and_keeps_the_filters() {
  let col = issue_col(
    "Created",
    "created",
    "c-age",
    IssuesQuery { state: "todo", sort: "-updated", .. },
  )
  assert col.href == "/issues?state=todo&sort=-created"
  assert col.dir == ""
}

#[test]
fn clicking_the_sorting_column_flips_its_direction() {
  let desc = issue_col(
    "Created",
    "created",
    "c-age",
    IssuesQuery { sort: "-created", .. },
  )
  assert desc.dir == "desc"
  assert desc.href == "/issues?sort=created"
  let asc = issue_col("Created", "created", "c-age", IssuesQuery { sort: "created", .. })
  assert asc.dir == "asc"
  assert asc.href == "/issues?sort=-created"
}

#[test]
fn a_column_with_no_pb_field_behind_it_does_not_sort() {
  let col = issue_col("Title", "", "c-title", IssuesQuery { sort: "-updated", .. })
  assert col.href == ""
  assert col.dir == ""
}

#[test]
fn every_sortable_column_asks_for_a_field_query_sort_accepts() {
  for col in issue_cols(IssuesQuery { sort: "-updated", .. }) {
    if col.href != "" {
      let spec = strings.Split(col.href, "sort=")[1]
      assert query.sort(spec).is_ok()
    }
  }
}
