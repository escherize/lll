import "go:strings"

import "query"

fn md(src: string) -> string {
  md_html(src) as string
}

#[test]
fn gfm_table_renders_as_a_table_not_literal_pipes() {
  let out = md("| a | b |
| --- | --- |
| 1 | 2 |
")
  assert strings.Contains(out, "<table>")
  assert strings.Contains(out, "<th>a</th>")
  assert strings.Contains(out, "<td>2</td>")
  assert !strings.Contains(out, "| a | b |")
}

#[test]
fn gfm_strikethrough_autolink_and_task_lists() {
  let out = md("~~gone~~ https://example.com/x

- [ ] todo
- [x] done
")
  assert strings.Contains(out, "<del>gone</del>")
  assert strings.Contains(out, "<a href=\"https://example.com/x\">")
  assert strings.Contains(out, "type=\"checkbox\"")
  assert strings.Contains(out, "checked=\"\"")
}

#[test]
fn fenced_code_is_tokenized_into_classes_not_inline_colors() {
  let out = md("```go
func f() {}
```
")
  assert strings.Contains(out, "class=\"chroma\"")
  assert strings.Contains(out, "class=\"kd\"")
  // WithClasses(true) means chroma never writes a hex color into the markup;
  // theme.css owns the palette.
  assert !strings.Contains(out, "style=\"color:")
}

#[test]
fn mermaid_fences_stay_plain_for_the_client_to_draw() {
  let out = md("```mermaid
graph TD; A-->B;
```
")
  assert strings.Contains(out, "<code class=\"language-mermaid\">")
  assert strings.Contains(out, "graph TD; A--&gt;B;")
  assert !strings.Contains(out, "class=\"chroma\"")
}

#[test]
fn hard_wraps_survive_the_gfm_and_highlighting_extensions() {
  assert strings.Contains(md("one
two
"), "one<br>")
}

#[test]
fn raw_html_is_still_dropped() {
  assert !strings.Contains(md("<script>alert(1)</script>"), "<script>")
}

// ---------- /issues: the URL is the page state ----------

#[test]
fn issues_href_omits_empty_parts_and_escapes_values() {
  assert issues_href(IssuesQuery { .. }) == "/issues"
  assert issues_href(IssuesQuery { sort: "-updated", .. }) == "/issues?sort=-updated"
  assert issues_href(
      IssuesQuery { state: "in-progress", assignee: "Ada L", sort: "created", .. },
    )
    == "/issues?state=in-progress&assignee=Ada+L&sort=created"
}

#[test]
fn a_header_link_changes_the_sort_and_keeps_the_filters() {
  let col = issue_col(
    "Created",
    "created",
    "c-age",
    IssuesQuery { state: "todo", sort: "-updated", .. },
  )
  assert col.href == "/issues?state=todo&sort=-created"
  assert col.dir == ""
}

#[test]
fn clicking_the_sorting_column_flips_its_direction() {
  let desc = issue_col(
    "Created",
    "created",
    "c-age",
    IssuesQuery { sort: "-created", .. },
  )
  assert desc.dir == "desc"
  assert desc.href == "/issues?sort=created"
  let asc = issue_col("Created", "created", "c-age", IssuesQuery { sort: "created", .. })
  assert asc.dir == "asc"
  assert asc.href == "/issues?sort=-created"
}

#[test]
fn a_column_with_no_pb_field_behind_it_does_not_sort() {
  let col = issue_col("Title", "", "c-title", IssuesQuery { sort: "-updated", .. })
  assert col.href == ""
  assert col.dir == ""
}

#[test]
fn every_sortable_column_asks_for_a_field_query_sort_accepts() {
  for col in issue_cols(IssuesQuery { sort: "-updated", .. }) {
    if col.href != "" {
      let spec = strings.Split(col.href, "sort=")[1]
      assert query.sort(spec).is_ok()
    }
  }
}

// ---------- team accent (task-83) ----------

#[test]
fn normalize_hex_accepts_a_six_digit_hex_in_either_case() {
  assert normalize_hex("#F0883E") == "#f0883e"
  assert normalize_hex("  #a1b2c3  ") == "#a1b2c3"
}

#[test]
fn normalize_hex_rejects_anything_that_is_not_rrggbb() {
  // Every one of these would otherwise reach a :root rule on every page.
  assert normalize_hex("") == ""
  assert normalize_hex("#abc") == ""
  assert normalize_hex("red") == ""
  assert normalize_hex("#12345g") == ""
  // ParseInt alone would take this one: "+12345" is a valid base-16 number.
  assert normalize_hex("#+12345") == ""
  assert normalize_hex("#f0883e; } body { display:none") == ""
}

#[test]
fn accent_css_is_empty_for_the_canonical_orange() {
  // No stored colour means theme.css's own tokens, untouched.
  assert (accent_css("") as string) == ""
}

#[test]
fn accent_css_derives_the_whole_family_from_one_hex() {
  let css = accent_css("#f0883e") as string
  assert strings.Contains(css, ":root{")
  assert strings.Contains(css, "--accent:#f0883e;")
  assert strings.Contains(css, "--accent-dim:rgba(240,136,62,0.16)")
  // Fed DESIGN.md's own orange, the derivation lands within a few values of
  // the shipped #f79b57 / #1a0f06 / #c96a25.
  assert strings.Contains(css, "--accent-hover:#f29655")
  assert strings.Contains(css, "--accent-ink:#180e06")
  assert strings.Contains(css, "--accent-deep:#c06d32")
}

#[test]
fn accent_css_keeps_two_digits_per_channel() {
  // A channel below 16 must not collapse to one digit and shift the hex:
  // "#18" + "17" + "1" would read as #18171 and swallow the next token.
  let css = accent_css("#f0e80d") as string
  assert strings.Contains(css, "--accent-ink:#181701")
  assert strings.Contains(css, "--accent-hover:#f2eb2a")
}

#[test]
fn accent_ink_flips_to_light_on_a_dark_accent() {
  // A colour picker hands out navy as readily as orange, and 10% of navy on
  // navy is an unreadable button.
  assert strings.Contains(accent_css("#102040") as string, "--accent-ink:#e7e9ec")
  assert strings.Contains(accent_css("#f0883e") as string, "--accent-ink:#180e06")
}

#[test]
fn mark_letter_takes_the_team_initial_or_falls_back() {
  assert mark_letter("ENG") == "E"
  assert mark_letter("") == "L"
  // The letter lands unescaped inside an SVG document, so only ASCII
  // alphanumerics get through.
  assert mark_letter("<script") == "L"
  assert mark_letter("'/>") == "L"
}

#[test]
fn favicon_url_is_an_escaped_data_url_in_the_accent() {
  let icon = favicon_url("#3ea0f0", "E") as string
  assert strings.HasPrefix(icon, "data:image/svg+xml,")
  // Raw angle brackets or a bare # would break the href.
  assert !strings.Contains(icon, "<")
  assert !strings.Contains(icon, ">")
  assert strings.Contains(icon, "%3Csvg")
  assert strings.Contains(icon, "%233ea0f0")
}

#[test]
fn favicon_url_falls_back_to_the_canonical_orange() {
  assert strings.Contains(favicon_url("", "L") as string, "%23f0883e")
}
