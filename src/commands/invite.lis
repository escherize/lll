import "go:encoding/json"
import "go:fmt"
import "go:strings"

import "flags"
import "models"
import "pb"
import "records"

// `lll invite create` (LLL-544; doc scoped-access-invites): a single-use,
// expiring link that lets one person join with the named teams and mode.
// The server mints it (gopb/invites.go) only for a full member or a
// superuser (LLL-629), and its refusal names who can; this command only
// resolves team keys and prints the link.

pub fn invite(ctx: pb.Client, args: Slice<string>) -> Result<(), pb.CliError> {
  flags.dispatch(ctx,
    "invite",
    "single-use join links",
    invite_intro(),
    invite_commands(),
    args,
  )
}

pub fn invite_commands() -> Slice<flags.Command> {
  [
    flags.Command {
      name: "create",
      summary: "print a single-use link that lets one person join with these teams",
      spec: invite_create_spec(),
      run: invite_create,
      ..,
    },
  ]
}

fn invite_intro() -> string {
  "An invite link lets one person join this board. Opening it shows a name
form; submitting it creates a member with exactly the invite's teams and mode
and signs that browser in. The link works once and expires after 7 days.

Only a person with read-write access to every team, or a superuser, can
create invites. A team-scoped or read-only member, a bot, and a member with
an owner are refused: ask a full member to create the link.

To give a colleague an email and password login for the CLI instead, use
'lll member invite NAME --email EMAIL'."
}

fn invite_create_spec() -> Slice<flags.Flag> {
  [
    flags.Flag {
      name: "--team",
      value: true,
      hint: "KEY",
      repeat: true,
      required: true,
      help: "a team the person joins (repeat for more)",
      ..,
    },
    flags.Flag {
      name: "--read-only",
      alias: "--ro",
      help: "they can read but not change anything (default: read-write)",
      ..,
    },
    flags.Flag { name: "--json", help: "print the invite as JSON: url, code, expires, mode, teams", .. },
    flags.Flag {
      name: "--help",
      alias: "-h",
      hidden: true,
      help: "show this help",
      ..,
    },
  ]
}

#[json]
struct InviteRequest { teams: Slice<models.TeamId>, mode: string }

#[json]
struct InviteResponse { code: string, expires: string }

/// `lll invite create --json` (LLL-645). `teams` are keys; `expires` is RFC3339.
#[json]
struct InviteJson { url: string, code: string, expires: string, mode: string, teams: Slice<string> }

fn invite_create(input: flags.CommandInput) -> Result<(), pb.CliError> {
  let ctx = input.ctx
  let p = input.parsed
  let keys = p.all("--team").map(records.normalize_team_key).filter(|k| k != "")
  if keys.is_empty() { return Err(flags.usage_error(f"usage: {input.usage}")) }
  let base = web_base(ctx)?
  let mut ids: Slice<models.TeamId> = []
  for key in keys {
    let Some(team) = records.find_team(ctx, key)? else {
      return Err(records.unknown_team(ctx, key))
    }
    ids = ids.append(team.id)
  }
  let mode = if p.given("--read-only") { models.Mode.ReadOnly } else { models.Mode.ReadWrite }
  let payload = match json.Marshal(InviteRequest { teams: ids, mode: mode.wire() }) {
    Ok(b) => b,
    Err(e) => return Err(pb.failed(f"encoding the invite: {e}")),
  }
  let body = ctx.post("/api/lll/invites", payload as string)?
  let mut made = InviteResponse { .. }
  if let Err(e) = json.Unmarshal(body.bytes(), &made) {
    return Err(pb.failed(f"decoding the invite: {e}"))
  }
  if made.code == "" { return Err(pb.failed("the server returned no invite code")) }
  if p.given("--json") {
    return print_json(InviteJson { url: f"{base}/join/{made.code}", code: made.code, expires: made.expires, mode: mode.wire(), teams: keys }, "invite")
  }
  fmt.Println(f"{base}/join/{made.code}")
  let access = if mode.writes() { "read-write" } else { "read-only" }
  status(
    f"single-use invite: {access}, {strings.Join(keys, ", ")}; expires {made.expires}. Send the link to one person; it is shown only here",
  )
  Ok(())
}
