import "go:bufio"
import "go:bytes"
import "go:encoding/json"
import "go:fmt"
import "go:github.com/escherize/lll/gopb"
import "go:io"
import "go:net"
import "go:net/http"
import "go:os"
import "go:path/filepath"
import "go:strconv"
import "go:strings"
import "go:time"
import "go:unicode"

import "config"
import "flags"

// `lll up` — one command for local use: PocketBase + the web board, one process.
//
// A PocketBase already healthy at the configured URL is reused (and never
// killed on exit). Otherwise one runs IN-PROCESS (via the gopb wrapper
// module) on the first free port from 8090 up, with the superuser upserted
// before it starts listening so the admin UI never shows the install wizard.
// PocketBase installs its own SIGINT/SIGTERM handler and shuts down
// gracefully; when its Serve returns we exit the process, which takes the
// board down too — Ctrl-C or a plain `kill <pid>` stops everything.
fn up_spec() -> Slice<flags.Flag> {
  [
    flags.Flag {
      name: "--port",
      value: true,
      hint: "8100",
      help: "preferred web-board port; taken ports auto-increment",
      ..,
    },
    flags.Flag {
      name: "--pb-dir",
      value: true,
      hint: "pb/pb_data",
      help: "PocketBase data directory (migrations ship in the binary)",
      ..,
    },
    flags.Flag {
      name: "--no-open",
      help: "do not open the board in the browser",
      ..,
    },
    flags.Flag {
      name: "--help",
      alias: "-h",
      hidden: true,
      help: "show this help",
      ..,
    },
  ]
}

/// The flag table of the up verb; read by `lll completions`.
pub fn up_verb_spec(_verb: string) -> Slice<flags.Flag> {
  up_spec()
}

pub fn up(args: Slice<string>) -> Result<(), string> {
  let spec = up_spec()
  let p = flags.parse(spec, args, 2, false, "")?
  if p.given("--help") {
    print_up_usage()
    return Ok(())
  }
  let mut web_port = 8100
  let raw_port = p.one("--port")
  if raw_port != "" {
    let Ok(pn) = strconv.Atoi(raw_port) else {
      return Err(f"--port must be a number, got '{raw_port}'")
    }
    web_port = pn
  }
  let pb_dir = p.one("--pb-dir")
  let pb_dir = if pb_dir == "" { "pb/pb_data" } else { pb_dir }
  let open = !p.given("--no-open")

  // Traced, not plain `load()`: TASK-115 needs to know not just WHICH team was
  // configured but where it came from. A team already written in a config file
  // needs no persisting; one that came from LLL_TEAM (or from the prompt) does,
  // or the next boot in this directory asks the same question again.
  let (cfg, src) = config.load_traced()?
  let mut db_url = cfg.url

  // A configured REMOTE url plus local-data flags is a contradiction, and the
  // silent reading of it wrote to production: `healthy()` answers "is something
  // running there", not "is that mine", so a live prod instance was adopted by
  // a boot that asked for a throwaway one and `--pb-dir` was never read
  // (TASK-218). Refuse instead of guessing which half the user meant.
  if db_url != "" && !is_loopback(db_url) {
    if p.one("--pb-dir") != "" {
      return Err(
        f"--pb-dir asks for a local instance but the configured url is {db_url}, which is remote
'lll up' would have served that remote database and written to it, not to '{pb_dir}'
run against it deliberately with 'lll up' and no --pb-dir, or pin a local one: LLL_URL=http://127.0.0.1:8090 lll up --pb-dir {pb_dir}",
      )
    }
    return Err(
      f"the configured url is {db_url}, which is not this machine
'lll up' serves and seeds a database — pointed at a remote one it writes there
check 'lll config --list', or pin a local url: LLL_URL=http://127.0.0.1:8090 lll up",
    )
  }

  let mut admin_line = f"admin  {db_url}/_/  (already running)"

  // The superuser identity: upserted on a fresh boot, and used for the
  // process token further down. The printed default keeps `lll up` from
  // ever showing PocketBase's install wizard.
  let mut email = os.Getenv("LLL_ADMIN_EMAIL")
  let mut pass = os.Getenv("LLL_ADMIN_PASSWORD")
  if email == "" || pass == "" {
    email = "admin@local.dev"
    pass = "admin-local-123"
  }

  if !healthy(db_url) {
    let db_port = free_port(port_of(db_url, 8090))
    db_url = f"http://{bind_addr()}:{db_port}"

    task {
      match gopb.Serve(pb_dir, f"{bind_addr()}:{db_port}", email, pass) {
        Err(e) => {
          fmt.Println(f"pocketbase failed to start: {e}")
          fmt.Println(
            f"check that the data dir '{pb_dir}' is writable, or pick another with --pb-dir",
          )
          os.Exit(1)
        },
        // Graceful shutdown (Ctrl-C / SIGTERM caught by PocketBase) — take
        // the board down with us; PocketBase's signal handler suppressed the
        // default process termination.
        Ok(_) => os.Exit(0),
      }
    }

    let mut ok = false
    for _ in 0..50 {
      if healthy(db_url) {
        ok = true
        break
      }
      time.Sleep(100 * time.Millisecond)
    }
    if !ok {
      return Err(
        f"pocketbase did not come up on {db_url} — check its output above",
      )
    }
    admin_line = f"admin  {db_url}/_/  {email} / {pass}"
  }
  // TASK-181: PocketBase's collection rules refuse unauthenticated requests
  // now, so the boot's seeding (team, member) and the board's own writes
  // both need a token. A caller-provided LLL_TOKEN — a member token — wins;
  // otherwise this process defaults to the superuser token, which the
  // credentials above can always get — and, owning those credentials, the
  // boot can re-mint the token if the realtime bridge ever sees it refused.
  // The board's BROWSER side is gated separately (serve_gate.lis): a board
  // token admits a browser, but web writes still author as this process's
  // identity until browser sessions exist (TASK-182's ADR).
  let mut refresh: Option<fn() -> Result<string, string>> = None
  if cfg.token == "" {
    match superuser_token(db_url, email, pass) {
      Ok(tok) => {
        let _ = os.Setenv("LLL_TOKEN", tok)
        refresh = Some(|| superuser_token(db_url, email, pass))
        fmt.Println(
          "auth   rules are authenticated-only; this process's PocketBase calls (seeding, the board) ride the superuser token, re-minted if refused",
        )
      },
      Err(e) => {
        return Err(
          f"could not authenticate as the PocketBase superuser at {db_url}: {e}
collection rules now refuse unauthenticated requests, so the boot cannot even
create its team. Point LLL_ADMIN_EMAIL/LLL_ADMIN_PASSWORD at this server's
superuser credentials, or set LLL_TOKEN to a member token.",
        )
      },
    }
  }

  // The in-process board (and its PB client) must talk to the db we chose.
  let _ = os.Setenv("LLL_URL", db_url)

  // An unscoped board cannot create issues, and a configured-but-missing
  // team is fatal further down, so settle the team here: `lll up` on a fresh
  // data dir must just work.
  // A boot that named its own data directory is a throwaway or a scratch board
  // (that is what e2e and `mise run scratch` pass), and the team it settles is
  // a fact about that database, not about this checkout - so it is not
  // persisted. Persisting it would put a .lll.toml into whatever directory the
  // scratch board ran in, which is the TASK-143 stray exactly.
  let throwaway = p.one("--pb-dir") != ""
  let team = ensure_team(cfg.team, src.team, throwaway)?
  let _ = os.Setenv("LLL_TEAM", team)
  let me = ensure_me(cfg.me)?
  let chosen = free_port(web_port)
  if chosen != web_port {
    fmt.Println(f"port {web_port} taken — board moving to {chosen}")
  }
  fmt.Println(admin_line)
  fmt.Println(f"team   {team}")
  if me != "" { fmt.Println(f"me     {me}") }
  // The board binds in microseconds; a browser takes far longer to launch,
  // so opening before run_server blocks is not a race worth guarding.
  let board_url = f"http://127.0.0.1:{chosen}"
  if open {
    if let Err(e) = open_url(board_url) {
      fmt.Println(f"could not open a browser: {e}")
    }
  }
  run_server(chosen, refresh)
}

fn print_up_usage() {
  fmt.Println(
    "lll up - start PocketBase and the web board together

Usage:
  lll up [--port 8100] [--pb-dir pb/pb_data] [--no-open]

Reuses a PocketBase already running at the configured URL; otherwise runs one
in-process (first free port from the configured port up) after upserting the
superuser from LLL_ADMIN_EMAIL/LLL_ADMIN_PASSWORD (a printed default is used
when unset). The board opens in your browser unless --no-open. Taken ports
auto-increment. Ctrl-C stops everything lll up started; an externally-started
PocketBase is left running.

The board needs a team. A configured team (LLL_TEAM or 'team' in .lll.toml)
is created on the server if it is missing. With none configured lll up asks
for one and writes the answer to the repo's .lll.toml, so the board and the
CLI always agree; with nothing on stdin to answer with (scripts, agents, CI)
it refuses to start rather than run on a team only this process knows about.
'lll attach' settles the same question up front, without a boot.

Whichever way the team was settled, it is written to .lll.toml unless a
config file already supplies it, so the NEXT boot in this directory needs no
LLL_TEAM and no prompt.

The board is gated: it answers only requests carrying its board token.
LLL_BOARD_TOKEN sets that token; otherwise one is generated per boot and
printed in the banner as a login URL — open it once and the browser keeps
access in a cookie. From a terminal, send the same cookie: curl
-H 'Cookie: lll_board=<token>' http://127.0.0.1:<port>/.

It also needs to know who you are. On first boot 'me' is guessed from $USER,
written to ~/.config/lll/lll.toml and seeded as a member so assignment and
comments work straight away — no second prompt. It goes to the home config,
not the repo's, because the repo's file is committed. That guess is wrong on
a shared machine: 'lll config set me <name>' fixes it.",
  )
}

/// The team the board writes to. A team the config names is created if the
/// server lacks it. With none configured we ask and write the answer to
/// .lll.toml — the board and the CLI must not disagree about the team, so a
/// team that lives only in this process is not an option. No one to ask
/// (stdin is not a terminal: scripts, agents, CI) means no boot.
///
/// `source` is where `want` came from, as `config.load_traced` reports it;
/// `throwaway` is true when the boot named its own --pb-dir.
///
/// TASK-115: a boot that settles a team must leave it settled. `LLL_TEAM=X
/// lll up` used to create the team, boot happily and persist NOTHING - the
/// env var satisfied the config, so the code that writes .lll.toml was never
/// reached, and the next boot without that env var failed with "no team
/// configured" all over again. Persisting closes that loop, under two
/// conditions that keep it from becoming TASK-143's stray-file bug:
///
///   - a `file:` source has persisted it already, so there is nothing to do
///     and rewriting a committed .lll.toml on every boot would be churn;
///   - a --pb-dir boot is a throwaway or a scratch board, and the team it
///     settled is a fact about that database rather than about this
///     directory. It is also the one kind of boot that runs in directories
///     nobody attached on purpose, which is where a stray .lll.toml hurts.
fn ensure_team(
  want: string,
  source: string,
  throwaway: bool,
) -> Result<string, string> {
  if want != "" {
    let key = resolve_team(want)?
    if should_save_team(source, throwaway) { save_team(key)? }
    return Ok(key)
  }

  let teams = list_teams()?
  let mut suggested = default_team_key()
  if let Some(t) = teams.items.get(0) { suggested = t.key }

  let key = ask_team(suggested)?
  let existing = find_team(key)?
  if existing.is_none() {
    match create_team(key, key) {
      Ok(created) => {
        let _ = fmt.Println(
          f"created team {created.key} — issues will be {created.key}-1, {created.key}-2, ...",
        )
      },
      Err(_) => {
        let existing = find_team(key)?
        if existing.is_none() {
          return Err(f"could not create team '{key}' and none exists to reuse")
        }
      },
    }
  }
  // Same bargain as the configured branch above. The source is "" here — the
  // key was just typed, so no file supplies it yet and it is worth writing
  // unless this is a scratch board (TASK-143).
  if should_save_team("", throwaway) { save_team(key)? }
  Ok(key)
}

/// Whether a settled team key is worth writing to .lll.toml (TASK-115).
/// Pure, and split out from ensure_team because it is the whole of the
/// TASK-143 guard: a wrong answer here is a config file appearing in a
/// directory nobody attached, which is a bug that shows up hours later
/// somewhere else entirely.
fn should_save_team(source: string, throwaway: bool) -> bool {
  // A --pb-dir boot's team belongs to that database, not to this directory.
  if throwaway { return false }
  // A file already carries it; rewriting it every boot is churn.
  !strings.HasPrefix(source, "file:")
}

/// A configured team key, created on the server if it is missing. Another
/// lll up pointed at the same fresh server may create the team between our
/// find and our create; the unique index rejects the loser, and the loser
/// re-looks-up whoever won rather than failing the boot (the same bargain
/// e2e.sh's seed_team runs on).
fn resolve_team(want: string) -> Result<string, string> {
  if let Some(t) = find_team(want)? { return Ok(t.key) }
  match create_team(want, want) {
    Ok(created) => {
      fmt.Println(f"created team {created.key}")
      Ok(created.key)
    },
    Err(_) => {
      if let Some(t) = find_team(want)? { return Ok(t.key) }
      Err(f"could not create team '{want}' and none exists to reuse")
    },
  }
}

/// Who the board and the CLI think you are. `lll up` already asks for a team
/// and a second prompt is worse than a wrong default, so a missing 'me' is
/// taken from $USER, written to .lll.toml where it is visible, and changed
/// with 'lll config set me <name>'. Wrong on a shared machine; one command to
/// fix. The matching member is seeded either way, so assignment and comment
/// authorship work on the first boot rather than the second.
/// (ADR-1: this all goes away when members becomes an auth collection.)
fn ensure_me(want: string) -> Result<string, string> {
  let mut name = strings.TrimSpace(want)
  if name == "" {
    name = strings.TrimSpace(os.Getenv("USER"))
    // No $USER to guess from is not worth failing a boot over: comments go
    // authorless and 'lll config set me' still works.
    if name == "" { return Ok("") }
    // The home config, never the repo's: .lll.toml is committed, and booting
    // a server is no reason to put your username in someone else's checkout.
    let path = set_home_key("me", name)?
    fmt.Println(
      f"guessed me = \"{name}\" from $USER, wrote it to {path} — 'lll config set me <name>' to change it",
    )
  }
  let created = ensure_member(name)?
  if created { fmt.Println(f"created member {name}") }
  Ok(name)
}

/// Ask for a team key on stdin, defaulting to `suggested`. Errs when stdin
/// has no answer to give (scripts, agents, CI).
fn ask_team(suggested: string) -> Result<string, string> {
  fmt.Print(f"no team configured — team key [{suggested}]: ")
  let newline = 10 as byte
  let Partial.Ok(line) = bufio.NewReader(os.Stdin).ReadString(newline) else {
    fmt.Println("")
    return Err(
      f"no team configured and no answer on stdin — set LLL_TEAM={suggested}, or add team = \"{suggested}\" to .lll.toml (see 'lll config init')",
    )
  }
  let typed = clean_key(strings.TrimSpace(line))
  if typed == "" { Ok(suggested) } else { Ok(typed) }
}

/// Persist the team to the repo's .lll.toml so the next boot and the CLI
/// agree. The team is the one key that belongs in the repo — `lll attach`
/// writes the same line, deliberately.
fn save_team(key: string) -> Result<(), string> {
  let path = set_repo_key("team", key)?
  fmt.Println(f"wrote team = \"{key}\" to {path}")
  Ok(())
}

/// Team key for a first boot: the working directory's name, letters and
/// digits only, uppercased, at most 5 characters.
fn default_team_key() -> string {
  let Ok(dir) = os.Getwd() else {
    return "TEAM"
  }
  let key = clean_key(filepath.Base(dir))
  if key == "" { "TEAM" } else { key }
}

/// A team key: letters and digits only, uppercased, at most 5 characters.
fn clean_key(raw: string) -> string {
  let mut key = ""
  for r in raw.runes() {
    if unicode.IsLetter(r) || unicode.IsDigit(r) {
      key += strings.ToUpper(r as string)
    }
    if key.length() == 5 { break }
  }
  key
}

fn healthy(base_url: string) -> bool {
  // Bounded: a non-PB listener on the port must fail fast, not hang us.
  let client = http.Client { Timeout: 2 * time.Second, .. }
  let Ok(resp) = client.Get(f"{base_url}/api/health") else {
    return false
  }
  if let Some(body) = resp.Body { let _ = body.Close() }
  resp.StatusCode == 200
}

/// Whether `base_url` names this machine. The question `healthy()` cannot
/// answer: production answers /api/health perfectly, which is exactly why an
/// already-configured remote url gets adopted by a boot that meant to be local.
pub fn is_loopback(base_url: string) -> bool {
  // SplitN throughout, not Index + substring: strings.Index returns a BYTE
  // offset while substring takes rune indices (see realtime.split_field).
  let after_scheme = strings.SplitN(base_url, "://", 2)
  let mut host = after_scheme[after_scheme.length() - 1]
  host = strings.SplitN(host, "/", 2)[0]
  // An IPv6 literal wears brackets: "[::1]:8090".
  if host.starts_with("[") {
    let inner = strings.SplitN(strings.TrimPrefix(host, "["), "]", 2)[0]
    return inner == "::1"
  }
  let name = strings.SplitN(host, ":", 2)[0]
  name == "127.0.0.1" || name == "localhost" || name == "::1" || name == ""
}

/// First free TCP port at or above `start`.
fn free_port(start: int) -> int {
  let mut p = start
  loop {
    match net.Listen("tcp", f"127.0.0.1:{p}") {
      Ok(l) => {
        let _ = l.Close()
        return p
      },
      Err(_) => p += 1,
    }
  }
}

/// Port from "http://127.0.0.1:8090", or `fallback`.
fn port_of(base_url: string, fallback: int) -> int {
  // Split, not LastIndex + substring; see realtime.split_field.
  let parts = strings.Split(base_url, ":")
  let Ok(p) = strconv.Atoi(parts[parts.length() - 1]) else {
    return fallback
  }
  p
}

#[json]
struct AuthRequest { identity: string, password: string }

#[json]
struct AuthToken { token: string }

/// Authenticate as the PocketBase superuser and return the auth token.
/// The same credentials Serve upserted, through PocketBase's own
/// auth-with-password endpoint — the admin API, not a shortcut past the
/// rules, so what the boot does is exactly what a member with a token does.
fn superuser_token(
  base: string,
  email: string,
  pass: string,
) -> Result<string, string> {
  let payload = match json.Marshal(
    AuthRequest { identity: email, password: pass },
  ) {
    Ok(b) => b,
    Err(e) => return Err(f"encoding credentials: {e}"),
  }
  let mut req = match http.NewRequest(
    "POST",
    base + "/api/collections/_superusers/auth-with-password",
    bytes.NewReader(payload),
  ) {
    Ok(r) => r,
    Err(e) => return Err(f"building the request: {e}"),
  }
  // NewRequest always populates Header; the unwrap is the Option field's toll.
  if let Some(h) = req.Header {
    let mut h = h
    h.Set("Content-Type", "application/json")
  }
  let resp = match http.DefaultClient.Do(req) {
    Ok(r) => r,
    Err(e) => return Err(f"{e}"),
  }
  let Some(stream) = resp.Body else {
    return Err("empty response body")
  }
  defer stream.Close()
  let body = match io.ReadAll(stream) {
    Partial.Ok(b) => b,
    Partial.Both(b, _) => b,
    Partial.Err(e) => return Err(f"reading response: {e}"),
  }
  if resp.StatusCode >= 300 { return Err(f"{resp.Status}: {body as string}") }
  let mut out = AuthToken { .. }
  if let Err(e) = json.Unmarshal(body, &out) {
    return Err(f"decoding the auth response: {e}")
  }
  if out.token == "" { return Err("the response carried no token") }
  Ok(out.token)
}
