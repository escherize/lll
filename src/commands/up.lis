import "go:encoding/json"
import "go:fmt"
import "go:github.com/escherize/lll/gopb"
import "go:net"
import "go:os"
import "go:path/filepath"
import "go:strconv"
import "go:strings"
import "go:time"

import "config"
import "flags"
import "output"
import "pb"
import "buildinfo"
import "serve"

#[json]
struct LocalShareAdmin { url: string, email: string, password: string }

// `lll up` — one command for local use: PocketBase + the web board, one process.
//
// A PocketBase already healthy at the configured URL is reused (and never
// killed on exit). Otherwise one runs IN-PROCESS (via the gopb wrapper
// module) on the first free port from 8090 up, with the superuser upserted
// before it starts listening so the admin UI never shows the install wizard.
// PocketBase installs its own SIGINT/SIGTERM handler and shuts down
// gracefully; when its Serve returns we exit the process, which takes the
// board down too — Ctrl-C or a plain `kill <pid>` stops everything.
pub fn up_spec() -> Slice<flags.Flag> {
  [
    flags.Flag {
      name: "--port",
      value: true,
      hint: "8100",
      help: "preferred web-board port; taken ports auto-increment",
      ..,
    },
    flags.Flag {
      name: "--pb-dir",
      value: true,
      hint: "pb/pb_data",
      help: "server data directory (migrations ship in the binary)",
      ..,
    },
    flags.Flag {
      name: "--no-open",
      help: "do not open the board in the browser",
      ..,
    },
    flags.Flag {
      name: "--admin-ui",
      help: "enable the administration UI at the board's /_/ path",
      ..,
    },
    flags.Flag {
      name: "--demo",
      help: "seed a DEMO team with issues and docs to try, on a board with no\nissues yet",
      ..,
    },
    flags.Flag {
      name: "--scratch",
      help: "start a throwaway local board, ignoring inherited config and LLL_* values",
      ..,
    },
    flags.Flag {
      name: "--bind",
      value: true,
      hint: "LAN_OR_TAILSCALE_IP",
      help: "start a shareable local board on this reachable address",
      ..,
    },
    flags.Flag {
      name: "--help",
      alias: "-h",
      hidden: true,
      help: "show this help",
      ..,
    },
  ]
}

/// `lll up` writes its banner as it boots and then serves until stopped: a
/// stream, so everything after --help prints directly (the banner has to be
/// on screen while the server runs).
pub fn up(ctx: pb.Client, args: Slice<string>) -> Result<output.Output, pb.CliError> {
  let spec = up_spec()
  let p = flags.parse(spec, args, 2, false, flags.usage("lll up", spec, ""))?
  if p.given("--help") {
    return Ok(output.line(up_usage()))
  }
  let scratch = p.given("--scratch")
  let share_bind = p.one("--bind")
  if scratch && share_bind != "" {
    return Err(flags.usage_error("--scratch is loopback-only; omit --bind for a throwaway board"))
  }
  if share_bind == "0.0.0.0" || share_bind == "::" {
    return Err(
      flags.usage_error("--bind needs the actual LAN or Tailscale IP teammates can reach, not a wildcard address"),
    )
  }
  if scratch && p.one("--pb-dir") != "" {
    return Err(flags.usage_error("--scratch owns its temporary data directory; omit --pb-dir"))
  }
  // A scratch boot runs on settings of its own, built from nothing it
  // inherited (setup_scratch); a shared one listens on the address it named.
  let (scratch_dir, ctx) = if scratch {
    let (dir, settings) = setup_scratch()?
    (dir, pb.Client.new(settings))
  } else {
    ("", ctx)
  }
  // LLL-680: a scratch boot writes only inside its own directory. Checked
  // before anything is written, so no later change to setup_scratch or to how
  // the config root resolves can point it at the user's home config.
  if scratch {
    let home = ctx.settings.home_path().map_err(pb.failed)?
    if !strings.HasPrefix(home, scratch_dir + "/") {
      return Err(pb.failed(f"refusing a scratch boot whose config path {home} is outside {scratch_dir}"))
    }
  }
  let ctx = if share_bind != "" { ctx.with_settings(ctx.settings.with_bind(share_bind)) } else { ctx }
  let mut web_port = if scratch { available_port()? } else { 8100 }
  let raw_port = p.one("--port")
  if raw_port != "" {
    let Ok(pn) = strconv.Atoi(raw_port) else {
      return Err(flags.usage_error(f"--port must be a number, got '{raw_port}'"))
    }
    web_port = pn
  }
  let pb_dir = p.one("--pb-dir")
  let pb_dir = if scratch {
    filepath.Join(scratch_dir, "pb_data")
  } else if pb_dir == "" { "pb/pb_data" } else { pb_dir }
  let open = !p.given("--no-open")

  // Traced, not plain `load()`: TASK-115 needs to know not just WHICH team was
  // configured but where it came from. A team already written in a config file
  // needs no persisting; one that came from LLL_TEAM (or from the prompt) does,
  // or the next boot in this directory asks the same question again.
  let (cfg, src) = ctx.settings.traced().map_err(pb.failed)?
  // A shareable local boot is explicit intent to use THIS machine even when
  // the home config still points at a hosted board. Give its embedded API a
  // fresh local port; the public board port proxies /api/ for teammates.
  let mut db_url = if share_bind != "" {
    f"http://127.0.0.1:{available_port()?}"
  } else {
    cfg.url
  }

  // A configured REMOTE url plus local-data flags is a contradiction, and the
  // silent reading of it wrote to production: `healthy()` answers "is something
  // running there", not "is that mine", so a live prod instance was adopted by
  // a boot that asked for a throwaway one and `--pb-dir` was never read
  // (TASK-218). Refuse instead of guessing which half the user meant.
  if db_url != "" && !is_loopback(db_url) {
    if p.one("--pb-dir") != "" {
      return Err(
        pb.failed(f"--pb-dir asks for a local instance but the configured url is {db_url}, which is remote
'lll up' would have served that remote database and written to it, not to '{pb_dir}'
for a throwaway board: lll up --scratch
to keep this data directory: LLL_CONFIG_HOME=$(mktemp -d) LLL_URL=http://127.0.0.1:8090 lll up --pb-dir {pb_dir}
or run against the remote deliberately, with no --pb-dir"),
      )
    }
    // LLL-488: naming LLL_URL alone is a dead end. It is the first of three
    // values that must all change — the home config still supplies a token
    // minted by the remote, and the local boot then has no team — so the
    // advice stalled two steps later having written a stray pb/ directory.
    // --scratch (LLL-487) is the whole answer in one command.
    return Err(
      pb.failed(f"the configured url is {db_url}, which is not this machine
'lll up' serves and seeds a database; pointed at a remote one it writes there
for a throwaway board: lll up --scratch
to serve this directory instead: LLL_CONFIG_HOME=$(mktemp -d) LLL_URL=http://127.0.0.1:8090 lll up
check what is configured with 'lll config list'"),
    )
  }

  let ctx = if share_bind != "" {
    ctx.with_settings(ctx.settings.with_board_token(pin_local_board_token(ctx.settings, pb_dir)?))
  } else {
    ctx
  }
  require_board_token_off_loopback(ctx.settings)?
  // The superuser identity: upserted on a fresh boot, and used for the
  // process token further down. LLL-676: with no LLL_ADMIN_* pair it is a
  // random password kept 0600 in the data directory, never a well-known
  // one: PocketBase is reachable from any web page the user visits.
  let generated_admin = ctx.settings.admin().is_none()
  // Only a boot that starts the server generates a password: a boot that
  // reuses a running one would leave a file matching no server in this
  // directory, so it only reads a pair that is already there.
  let starting = !healthy(db_url)
  let ctx = if share_bind != "" || generated_admin {
    pin_local_admin(ctx.settings, pb_dir, starting)?
      .map_or(ctx, |admin| ctx.with_settings(ctx.settings.with_admin(admin)))
  } else {
    ctx
  }

  let mut api_line = f"api    {db_url} (already running)"

  let (email, pass) = ctx.settings.admin().map_or(("", ""), |admin| (admin.email, admin.password))
  // Whether this boot proved the administrator pair works: it upserted the
  // pair into the server it started, or signed in with it. The banner names
  // the pair only then (LLL-648).
  let mut admin_ok = false

  if starting {
    let db_port = free_port(port_of(db_url, 8090))
    db_url = f"http://{ctx.settings.bind()}:{db_port}"

    task {
      match gopb.Serve(
        pb_dir,
        f"{ctx.settings.bind()}:{db_port}",
        email,
        pass,
        buildinfo.version(),
        ctx.settings.env.allowed_origins,
        ctx.settings.env.web_url,
      ) {
        Err(e) => {
          fmt.Println(f"lll server failed to start: {e}")
          // A bad LLL_ALLOWED_ORIGINS is the caller's input (exit 2), not
          // a server or data-dir failure.
          if f"{e}".starts_with("LLL_ALLOWED_ORIGINS") {
            os.Exit(pb.exit_code(pb.ErrorKind.Usage))
          }
          fmt.Println(
            f"check that the data dir '{pb_dir}' is writable, or pick another with --pb-dir",
          )
          os.Exit(pb.exit_code(pb.ErrorKind.Server))
        },
        // Graceful shutdown (Ctrl-C / SIGTERM caught by PocketBase) — take
        // the board down with us; PocketBase's signal handler suppressed the
        // default process termination.
        Ok(_) => os.Exit(0),
      }
    }

    let mut ok = false
    for _ in 0..50 {
      if healthy(db_url) {
        ok = true
        break
      }
      time.Sleep(100 * time.Millisecond)
    }
    if !ok {
      return Err(
        pb.failed(f"lll server did not come up on {db_url}; check its output above"),
      )
    }
    api_line = f"api    {db_url}"
    admin_ok = true
  }
  // TASK-181: PocketBase's collection rules refuse unauthenticated requests
  // now, so the boot's seeding (team, member) and the board's own writes
  // both need a token. A caller-provided LLL_TOKEN — a member token — wins;
  // otherwise this process bootstraps with a superuser token, then mints
  // a member token for the board. Renewals keep that member identity.
  // The board's BROWSER side is gated separately (serve/gate.lis): a board
  // token admits a browser, but web writes still author as this process's
  // identity until browser sessions exist (TASK-182's ADR).
  //
  // LLL-443: "a caller-provided token wins" used to mean a token that merely
  // EXISTS wins, so a home config holding a token for another server (the
  // hosted board, say) aborted a local boot that was holding working superuser
  // credentials the whole time — and the abort said to run `lll login`, which
  // needs the server this boot was refusing to start. The member token is an
  // optimisation here (it decides who the board's writes author as), never a
  // requirement: absent OR unusable, fall through to the superuser.
  // The fallback must never make a boot WORSE than it was: a configured token
  // that this cannot verify is still the credential the caller chose, and an
  // unreachable superuser is not a reason to refuse a boot that used to work.
  // So an unusable token only LOSES to a superuser pair that actually
  // authenticates; when neither works, the token stays and whatever it does
  // next reports honestly. (Caught by the gate: an e2e boot reusing a running
  // PocketBase has a valid member token and default admin creds that do not
  // match that server, and refusing it was a regression this change caused.)
  //
  // The boot decides for itself whether its board may renew its token
  // (board_identity): a renewal inherited from LLL_REMINT is dropped here.
  let ctx = ctx.renewing(None)
  // An explicit local share boot owns a new database, so an opaque token from
  // the user's hosted config cannot be allowed to win by the normal
  // conservative "maybe usable" rule.
  let mut using_token = share_bind == "" && cfg.token != "" &&
  pb.token_usable(db_url, cfg.token)
  // The in-process board (and its PB client) must talk to the db we chose.
  let mut ctx = ctx.with_url(db_url)
  if !using_token {
    match superuser_token(db_url, email, pass) {
      Ok(tok) => {
        admin_ok = true
        if cfg.token != "" && share_bind != "" {
          fmt.Println(
            "auth   ignoring the inherited token for this new local board",
          )
        } else if cfg.token != "" {
          fmt.Println(
            f"auth   the token from {config.origin(src.token)} is not valid for {db_url}; booting on the superuser credentials instead; the cli line below says what the CLI does",
          )
        }
        ctx = ctx.with_token(tok, None)
        fmt.Println(
          "auth   rules are authenticated-only; bootstrapping with superuser credentials before signing in the board as a member",
        )
      },
      Err(e) => {
        if cfg.token == "" || share_bind != "" {
          return Err(
            e.with_message(f"could not authenticate as the server administrator at {db_url}: {e.message}
collection rules now refuse unauthenticated requests, so the boot cannot even
create its team. Point LLL_ADMIN_EMAIL/LLL_ADMIN_PASSWORD at this server's
superuser credentials, or set LLL_TOKEN to a member token valid for this server.
An 'lll up' that started that server without LLL_ADMIN_* keeps its generated
password in its own data directory's .lll-admin.json."),
          )
        }
        using_token = true
      },
    }
  }
  let member_token_ok = using_token

  // An unscoped board cannot create issues, and a configured-but-missing
  // team is fatal further down, so settle the team here: `lll up` on a fresh
  // data dir must just work.
  // A boot that named its own data directory is a throwaway or a scratch board
  // (that is what e2e and `mise run scratch` pass), and the team it settles is
  // a fact about that database, not about this checkout - so it is not
  // persisted. Persisting it would put a .lll.toml into whatever directory the
  // scratch board ran in, which is the TASK-143 stray exactly.
  let throwaway = p.one("--pb-dir") != "" || scratch
  // A demo boot must not stop to ask for a team key: "show me the tool" is the
  // whole request. DEMO unless the caller already chose something.
  let demo = p.given("--demo")
  let want_team = if demo && cfg.team == "" { "DEMO" } else { cfg.team }
  let team = match ensure_team(ctx, want_team, src.team, throwaway) {
    Ok(team) => team,
    Err(e) => {
      let credential = if member_token_ok {
        f"token from {config.origin(src.token)}"
      } else {
        "superuser token generated for this startup"
      }
      return Err(e.with_message(f"{e.message}\nstartup credential: {credential}"))
    },
  }
  let ctx = ctx.with_settings(ctx.settings.with_team(team))
  let (member, refresh, ctx) = board_identity(ctx, db_url, email, pass)?
  if scratch {
    let _ = set_home_key(ctx.settings, "url", db_url)?
    let _ = set_home_key(ctx.settings, "team", team)?
    let _ = set_home_key(ctx.settings, "token", ctx.token())?
    fmt.Println(f"scratch data   {scratch_dir}")
    fmt.Println(f"scratch config {filepath.Join(scratch_dir, "config")}")
    fmt.Println(f"scratch admin  {email} / {pass} (shown once)")
    fmt.Println(
      f"scratch CLI    cd {scratch_dir} && env -u LLL_URL -u LLL_TOKEN -u LLL_TEAM LLL_CONFIG_HOME={filepath.Join(scratch_dir, "config")} lll issue list",
    )
  }
  if demo {
    let token_in_file = match src.token {
      Some(config.Source.RepoFile(_)) | Some(config.Source.HomeFile(_)) => true,
      Some(config.Source.Flag(_)) | Some(config.Source.Env(_)) | Some(config.Source.Default) | None => false,
    }
    seed_demo(ctx, team, member.name, db_url, token_in_file)?
  }
  let chosen = free_port(web_port)
  if chosen != web_port {
    fmt.Println(f"port {web_port} taken; board moving to {chosen}")
  }
  fmt.Println(f"lll    {buildinfo.version()}")
  fmt.Println(api_line)
  fmt.Println(f"team   {team}")
  fmt.Println(f"member {member.name}")
  if let Some(line) = admin_line(
    generated_admin,
    admin_ok,
    scratch || share_bind != "",
    email,
    local_admin_path(pb_dir),
  ) {
    fmt.Println(line)
  }
  // A demo boot points the CLI at itself (demo.lis), and scratch and shared
  // boots write their own CLI config.
  if !scratch && share_bind == "" && !demo {
    let home = ctx.settings.load_home().map_err(pb.failed)?
    let plan = cli_login_plan(
      CliState {
        rides: member_token_ok,
        throwaway,
        loopback: loopback_bind(ctx.settings),
        token_source: src.token,
        home_token: home.token,
        home_url: home.url,
        db_url,
      },
    )
    for line in log_cli_in(ctx, member.name, db_url, plan, src.token)? {
      fmt.Println(line)
    }
  }
  // The board binds in microseconds; a browser takes far longer to launch,
  // so opening before run_server blocks is not a race worth guarding.
  let board_url = serve.advertised_board_url(ctx.settings, chosen)
  // The board token, settled once: the link saved below, the browser opened
  // below and the gate run_server builds all read it from these settings.
  let ctx = ctx.with_settings(ctx.settings.with_board_token(serve.resolve_board_token(ctx.settings)))
  if share_bind != "" {
    let _ = set_home_key(ctx.settings, "url", board_url)?
    let _ = set_home_key(ctx.settings, "team", team)?
    let _ = set_home_key(ctx.settings, "token", ctx.token())?
  }
  // LLL-680: web_url is saved only into a home config whose url names this
  // board's server, or no server. A boot run beside another server's login (a
  // hosted url and its token) once replaced that file's web_url with this
  // board's address, so url and web_url named two different servers.
  let home = ctx.settings.load_home().map_err(pb.failed)?
  // Writing web_url also creates the config directory the login link below
  // goes into; a kept web_url means the home config already exists.
  if home_names_board(home.url, db_url, board_url) {
    let _ = set_home_key(ctx.settings, "web_url", board_url)?
  } else {
    fmt.Println(
      f"board  web_url unchanged: the home config's url is {home.url}, not this board's server",
    )
  }
  // Every boot, loopback included (LLL-648): 'lll board' and 'lll member
  // invite --team' read the login link from here, so the machine running the
  // board prints links that open it. Private (0600) and rewritten each boot,
  // so it follows a per-boot token. It names its own board url, and readers
  // use it only for that url, so it is written even when web_url is kept.
  let login_file = filepath.Join(
    filepath.Dir(ctx.settings.home_path().map_err(pb.failed)?),
    "board-login-url",
  )
  write_home_config(
    login_file,
    f"{board_url}/?board_token={ctx.settings.board_token()}\n",
  )?
  if share_bind != "" {
    let admin_file = filepath.Join(
      filepath.Dir(ctx.settings.home_path().map_err(pb.failed)?),
      "local-admin.json",
    )
    let admin_json = match json.Marshal(
      LocalShareAdmin { url: board_url, email, password: pass },
    ) {
      Ok(b) => b,
      Err(e) => return Err(pb.failed(f"encoding local admin connection: {e}")),
    }
    write_home_config(admin_file, admin_json as string)?
    fmt.Println(f"share  board login and member passes use {board_url}")
    fmt.Println(
      "share  lll member passes --count 10 writes ten private teammate handoffs",
    )
  }
  if open {
    // Open the LOGIN url, not the bare one (LLL-444). Opening the bare url
    // landed the user on the gate's 401 page and sent them back to the
    // terminal to copy a token by hand — the whole of "i just want my
    // localhost, it's me, let me in". The gate sets the cookie and redirects
    // to the clean url, so the token never lingers in the address bar.
    // The same token run_server's gate checks: both read these settings.
    let login_url = f"{board_url}/?board_token={ctx.settings.board_token()}"
    if let Err(e) = open_url(login_url) {
      fmt.Println(f"could not open a browser: {e.message}")
    }
  }
  streamed(serve.run_server(ctx, chosen, refresh, p.given("--admin-ui")))
}

/// The banner's administrator line (LLL-648), or None. A boot with no
/// LLL_ADMIN_* pair names the generated administrator and the 0600 file that
/// holds its password (LLL-676): 'lll member invite' and the board's admin
/// forms ask for it. The password itself stays off the banner, and a pair
/// from the environment is the deployer's secret and is never named.
/// Scratch and shared boots print or store their own random pair. The tag
/// is "admin", which the --admin-ui line also uses; that line carries a URL,
/// this one an email.
fn admin_line(
  generated: bool,
  proved: bool,
  own_pair: bool,
  email: string,
  path: string,
) -> Option<string> {
  if !generated || !proved || own_pair { return None }
  Some(
    f"admin  {email}; generated password in {path} (set LLL_ADMIN_EMAIL and LLL_ADMIN_PASSWORD to choose your own)",
  )
}

/// Pure. Whether a home config whose url is `home_url` may hold this board's
/// address as its web_url (LLL-680): only when that url names no server, or
/// names this board's API (`db_url`) or the board itself, which serves the
/// same API under /api/. Any other url is another server's login, and the
/// web_url beside it stays that server's.
fn home_names_board(home_url: string, db_url: string, board_url: string) -> bool {
  strings.TrimSpace(home_url) == "" || same_server_url(home_url, db_url) ||
  same_server_url(home_url, board_url)
}

/// Pure. Whether two base urls name one server: equal after trimming
/// trailing slashes, with the loopback spellings (localhost, 127.0.0.1,
/// [::1]) counted as one host.
fn same_server_url(a: string, b: string) -> bool {
  server_key(a) == server_key(b)
}

fn server_key(url: string) -> string {
  let mut u = strings.TrimRight(strings.TrimSpace(url), "/")
  for alias in ["://localhost", "://[::1]"] {
    for scheme in ["http", "https"] {
      if let Some(rest) = strings.CutPrefix(u, scheme + alias) {
        if rest == "" || rest.starts_with(":") || rest.starts_with("/") {
          u = scheme + "://127.0.0.1" + rest
        }
      }
    }
  }
  u
}

fn loopback_bind(settings: config.Settings) -> bool {
  let bind = settings.bind()
  bind == "localhost" || net.ParseIP(bind).IsLoopback()
}

/// What the boot knows when it decides about the CLI's login (LLL-648).
struct CliState {
  /// The board rides the CLI's configured token.
  rides: bool,
  /// A --pb-dir boot.
  throwaway: bool,
  /// The board listens on loopback only.
  loopback: bool,
  /// Where the configured token came from (config.Sources.token).
  token_source: Option<config.Source>,
  /// The token and url in the home config file, "" when absent.
  home_token: string,
  home_url: string,
  /// This boot's API url.
  db_url: string,
}

/// What a boot does about the CLI's own login (LLL-648).
enum CliLogin {
  /// The board already rides the CLI's configured token.
  Already,
  /// The home config holds neither a token nor another server's url: save
  /// this board's url and member token there, so the next command works.
  Save,
  /// This kind of boot never touches the CLI's login; the payload says why.
  Untouched(string),
  /// Configuration that may belong to another server stands in the way. It
  /// is kept; the payload is how to switch.
  Keep(string),
}

/// Pure. Only an empty slot is written, the rule the demo boot follows too:
/// url and token layer independently, so a token or a url this server does
/// not recognise may be another server's login.
fn cli_login_plan(s: CliState) -> CliLogin {
  if s.rides { return CliLogin.Already }
  if s.throwaway {
    return CliLogin.Untouched(
      "a --pb-dir boot leaves the CLI's login and team alone; boot without --pb-dir to log the CLI in",
    )
  }
  if !s.loopback {
    return CliLogin.Untouched(
      "a board bound beyond this machine leaves the CLI's login alone",
    )
  }
  match s.token_source {
    Some(config.Source.Env(name)) => {
      if s.home_token != "" {
        return CliLogin.Keep(
          f"{name} in this shell is not valid for this server: unset it (the home config keeps its own token)",
        )
      }
    },
    // A repo file's token outranks the home config's, and 'lll logout' clears
    // only the home one, so the repo line is named first.
    Some(config.Source.RepoFile(path)) => {
      let home = if s.home_token != "" {
        "; if the home config's token is not valid here either, also run 'lll logout'"
      } else { "" }
      return CliLogin.Keep(
        f"the token in {path} is not valid for this server: remove that line{home}, then restart lll up",
      )
    },
    Some(config.Source.HomeFile(_)) | Some(config.Source.Flag(_)) | Some(config.Source.Default) | None => (),
  }
  if s.home_token != "" {
    return CliLogin.Keep(
      "the token in the home config is not valid for this server: to log in here instead, run 'lll logout', then restart lll up",
    )
  }
  if s.home_url != "" && !is_loopback(s.home_url) {
    return CliLogin.Keep(
      f"the home config points the CLI at {s.home_url}: to use this board instead, run 'lll config set url {s.db_url}', then restart lll up",
    )
  }
  CliLogin.Save
}

/// Carry out the plan and return the banner lines. The member token to save
/// is the one board_identity handed `ctx`.
fn log_cli_in(
  ctx: pb.Client,
  name: string,
  db_url: string,
  plan: CliLogin,
  token_source: Option<config.Source>,
) -> Result<Slice<string>, pb.CliError> {
  match plan {
    CliLogin.Already => Ok([f"cli    unchanged: the CLI uses its token from {config.origin(token_source)}"]),
    CliLogin.Untouched(why) => Ok([f"cli    unchanged: {why}"]),
    CliLogin.Keep(how) => Ok([f"cli    not logged in to this board: {how}"]),
    CliLogin.Save => {
      let _ = set_home_key(ctx.settings, "url", db_url)?
      let path = set_home_key(ctx.settings, "token", ctx.token())?
      let mut lines = [f"cli    logged in as {name}; url and token saved to {path}"]
      match token_source {
        Some(config.Source.Env(name)) => {
          lines = lines.append(
            f"cli    {name} in this shell overrides that login, and this server does not accept it: unset {name}",
          )
        },
        Some(config.Source.RepoFile(_)) | Some(config.Source.HomeFile(_)) | Some(config.Source.Flag(_)) |
          Some(config.Source.Default) | None => (),
      }
      Ok(lines)
    },
  }
}

fn up_usage() -> string {
  "lll up - start the lll server and web board together

Usage:
  lll up [--port 8100] [--pb-dir pb/pb_data] [--no-open] [--demo] [--admin-ui]
  lll up --scratch [--no-open]
  lll up --bind LAN_OR_TAILSCALE_IP [--no-open]

Reuses a server API already running at the configured URL; otherwise runs one
in-process (first free port from the configured port up) after upserting the
administrator from LLL_ADMIN_EMAIL/LLL_ADMIN_PASSWORD (a generated password is
used when unset). The board opens in your browser unless --no-open. Taken ports
auto-increment. Ctrl-C stops everything lll up started; an externally-started
server API is left running.

The administration UI at the board's /_/ path is disabled by default.
--admin-ui enables it and prints its address. Sign in with the server's
administrator credentials; LLL_ADMIN_EMAIL/LLL_ADMIN_PASSWORD set them when
starting a local API. With neither set, the administrator is admin@local.dev
with a random password generated on the first boot and kept in the data
directory's .lll-admin.json (0600); the banner's admin line names that file.
A data directory that still had the old well-known password admin-local-123
loses it on the next boot, with a warning. A pair from the environment is
never printed.

The API answers browsers from other origins only when LLL_ALLOWED_ORIGINS
lists them (exact origins, comma-separated, e.g. http://localhost:5173). The
board itself needs none: its pages call the API through its own /api/. On a
loopback bind, the board and the API answer only loopback host names
(localhost, 127.0.0.1, [::1]).

The board needs a team. A configured team (LLL_TEAM or 'team' in .lll.toml)
is created on the server if it is missing. With none configured lll up asks
for one and writes the answer to the repo's .lll.toml, so the board and the
CLI always agree; with nothing on stdin to answer with (scripts, agents, CI)
it refuses to start rather than run on a team only this process knows about.
'lll attach' settles the same question up front, without a boot.

--scratch starts a fresh local board in a temporary directory, ignoring all
inherited LLL_* values, home/repo config, and XDG_CONFIG_HOME. Its banner gives
the directory and a CLI command to reach that board; delete the directory when
finished. It never writes to the original directory's config.

--bind starts a local board for teammates on the named LAN or Tailscale IP.
It chooses a local API port, serves the API through the board URL, saves this
machine's CLI connection, and keeps its board login token in the data directory
so a restart with the same directory preserves shared links. Run 'lll member
passes --count 10' in another terminal to create distinct human credentials.

Whichever way the team was settled, it is written to .lll.toml unless a
config file already supplies it, so the NEXT boot in this directory needs no
LLL_TEAM and no prompt.

The board is gated: it answers only requests carrying its board token.
LLL_BOARD_TOKEN sets that token; otherwise a loopback boot generates one
per boot (a non-loopback LLL_BIND refuses to start without it) and prints it
in the banner as a login URL. Open it once and the browser keeps
access in a cookie. 'lll board' prints the same link on this machine. From a
terminal, send the same cookie: curl
-H 'Cookie: lll_board=<token>' http://127.0.0.1:<port>/.

A valid member token selects the board's identity. Otherwise the superuser
credentials bootstrap a member from $USER (local when absent), then mint a
member token for this process. Board writes and token renewal use that member.
Use LLL_TOKEN to run the board as another authenticated member; 'lll whoami'
shows the CLI's login.

On a loopback boot whose home config holds no token, lll up logs the CLI in
as the board's member: it saves url and token to the home config, so the next
'lll issue list' works. An existing token is never replaced; when this server
does not accept it, the banner's cli line says how to switch. A --pb-dir boot
is a throwaway and leaves the CLI's login alone, as it does the team.

Environment:
  LLL_URL           server API to serve or reuse; a remote one is refused
  LLL_CONFIG_HOME   directory the config is read from and written to
  LLL_TEAM          team to boot on, created on the server if missing
  LLL_TOKEN         member token selecting the board's identity
  LLL_BIND          address the board and API listen on (default 127.0.0.1)
  LLL_BOARD_TOKEN   pins the board's access token instead of generating one
  LLL_ADMIN_EMAIL   superuser used to start a local API (both or neither;
  LLL_ADMIN_PASSWORD  neither generates one, kept in the data directory)
  LLL_ALLOWED_ORIGINS  browser origins, besides the board, the API answers

--scratch ignores every one of these."
}

