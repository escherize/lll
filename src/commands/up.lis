import "go:bufio"
import "go:crypto/rand"
import "go:encoding/json"
import "go:fmt"
import "go:github.com/escherize/lll/gopb"
import "go:net"
import "go:net/http"
import "go:os"
import "go:path/filepath"
import "go:strconv"
import "go:strings"
import "go:time"
import "go:unicode"

import "config"
import "flags"
import "models"
import "pb"
import "records"

#[json]
struct LocalShareAdmin { url: string, email: string, password: string }

// `lll up` — one command for local use: PocketBase + the web board, one process.
//
// A PocketBase already healthy at the configured URL is reused (and never
// killed on exit). Otherwise one runs IN-PROCESS (via the gopb wrapper
// module) on the first free port from 8090 up, with the superuser upserted
// before it starts listening so the admin UI never shows the install wizard.
// PocketBase installs its own SIGINT/SIGTERM handler and shuts down
// gracefully; when its Serve returns we exit the process, which takes the
// board down too — Ctrl-C or a plain `kill <pid>` stops everything.
fn up_spec() -> Slice<flags.Flag> {
  [
    flags.Flag {
      name: "--port",
      value: true,
      hint: "8100",
      help: "preferred web-board port; taken ports auto-increment",
      ..,
    },
    flags.Flag {
      name: "--pb-dir",
      value: true,
      hint: "pb/pb_data",
      help: "server data directory (migrations ship in the binary)",
      ..,
    },
    flags.Flag {
      name: "--no-open",
      help: "do not open the board in the browser",
      ..,
    },
    flags.Flag {
      name: "--admin-ui",
      help: "enable the administration UI at the board's /_/ path",
      ..,
    },
    flags.Flag {
      name: "--demo",
      help: "seed a DEMO team with issues and docs to try, on a board with no\nissues yet (LLL-433)",
      ..,
    },
    flags.Flag {
      name: "--scratch",
      alias: "--local",
      help: "start a throwaway local board, ignoring inherited config and LLL_* values",
      ..,
    },
    flags.Flag {
      name: "--bind",
      value: true,
      hint: "LAN_OR_TAILSCALE_IP",
      help: "start a shareable local board on this reachable address",
      ..,
    },
    flags.Flag {
      name: "--help",
      alias: "-h",
      hidden: true,
      help: "show this help",
      ..,
    },
  ]
}

/// The flag table of the up verb; read by `lll completions`.
pub fn up_verb_spec(_verb: string) -> Slice<flags.Flag> {
  up_spec()
}

pub fn up(args: Slice<string>) -> Result<(), string> {
  let spec = up_spec()
  let p = flags.parse(spec, args, 2, false, "")?
  if p.given("--help") {
    print_up_usage()
    return Ok(())
  }
  let scratch = p.given("--scratch")
  let share_bind = p.one("--bind")
  if scratch && share_bind != "" {
    return Err("--scratch is loopback-only; omit --bind for a throwaway board")
  }
  if share_bind == "0.0.0.0" || share_bind == "::" {
    return Err(
      "--bind needs the actual LAN or Tailscale IP teammates can reach, not a wildcard address",
    )
  }
  if scratch && p.one("--pb-dir") != "" {
    return Err("--scratch owns its temporary data directory; omit --pb-dir")
  }
  let scratch_dir = if scratch { setup_scratch()? } else { "" }
  if share_bind != "" { let _ = os.Setenv("LLL_BIND", share_bind) }
  let mut web_port = if scratch { available_port()? } else { 8100 }
  let raw_port = p.one("--port")
  if raw_port != "" {
    let Ok(pn) = strconv.Atoi(raw_port) else {
      return Err(f"--port must be a number, got '{raw_port}'")
    }
    web_port = pn
  }
  let pb_dir = p.one("--pb-dir")
  let pb_dir = if scratch {
    filepath.Join(scratch_dir, "pb_data")
  } else if pb_dir == "" { "pb/pb_data" } else { pb_dir }
  let open = !p.given("--no-open")

  // Traced, not plain `load()`: TASK-115 needs to know not just WHICH team was
  // configured but where it came from. A team already written in a config file
  // needs no persisting; one that came from LLL_TEAM (or from the prompt) does,
  // or the next boot in this directory asks the same question again.
  let (cfg, src) = config.load_traced()?
  // A shareable local boot is explicit intent to use THIS machine even when
  // the home config still points at a hosted board. Give its embedded API a
  // fresh local port; the public board port proxies /api/ for teammates.
  let mut db_url = if share_bind != "" {
    f"http://127.0.0.1:{available_port()?}"
  } else {
    cfg.url
  }

  // A configured REMOTE url plus local-data flags is a contradiction, and the
  // silent reading of it wrote to production: `healthy()` answers "is something
  // running there", not "is that mine", so a live prod instance was adopted by
  // a boot that asked for a throwaway one and `--pb-dir` was never read
  // (TASK-218). Refuse instead of guessing which half the user meant.
  if db_url != "" && !is_loopback(db_url) {
    if p.one("--pb-dir") != "" {
      return Err(
        f"--pb-dir asks for a local instance but the configured url is {db_url}, which is remote
'lll up' would have served that remote database and written to it, not to '{pb_dir}'
run against it deliberately with 'lll up' and no --pb-dir, or pin a local one: LLL_URL=http://127.0.0.1:8090 lll up --pb-dir {pb_dir}",
      )
    }
    return Err(
      f"the configured url is {db_url}, which is not this machine
'lll up' serves and seeds a database — pointed at a remote one it writes there
check 'lll config --list', or pin a local url: LLL_URL=http://127.0.0.1:8090 lll up",
    )
  }

  if share_bind != "" {
    pin_local_board_token(pb_dir)?
    pin_local_admin(pb_dir)?
  }

  let mut api_line = f"api    {db_url} (already running)"

  // The superuser identity: upserted on a fresh boot, and used for the
  // process token further down. The local fallback initializes the server
  // before it can show an install wizard; credentials stay off the banner.
  let mut email = os.Getenv("LLL_ADMIN_EMAIL")
  let mut pass = os.Getenv("LLL_ADMIN_PASSWORD")
  if email == "" || pass == "" {
    email = "admin@local.dev"
    pass = "admin-local-123"
  }

  if !healthy(db_url) {
    let db_port = free_port(port_of(db_url, 8090))
    db_url = f"http://{bind_addr()}:{db_port}"

    task {
      match gopb.Serve(pb_dir, f"{bind_addr()}:{db_port}", email, pass) {
        Err(e) => {
          fmt.Println(f"lll server failed to start: {e}")
          fmt.Println(
            f"check that the data dir '{pb_dir}' is writable, or pick another with --pb-dir",
          )
          os.Exit(1)
        },
        // Graceful shutdown (Ctrl-C / SIGTERM caught by PocketBase) — take
        // the board down with us; PocketBase's signal handler suppressed the
        // default process termination.
        Ok(_) => os.Exit(0),
      }
    }

    let mut ok = false
    for _ in 0..50 {
      if healthy(db_url) {
        ok = true
        break
      }
      time.Sleep(100 * time.Millisecond)
    }
    if !ok {
      return Err(
        f"lll server did not come up on {db_url} — check its output above",
      )
    }
    api_line = f"api    {db_url}"
  }
  // TASK-181: PocketBase's collection rules refuse unauthenticated requests
  // now, so the boot's seeding (team, member) and the board's own writes
  // both need a token. A caller-provided LLL_TOKEN — a member token — wins;
  // otherwise this process bootstraps with a superuser token, then mints
  // a member token for the board. Renewals keep that member identity.
  // The board's BROWSER side is gated separately (serve_gate.lis): a board
  // token admits a browser, but web writes still author as this process's
  // identity until browser sessions exist (TASK-182's ADR).
  //
  // LLL-443: "a caller-provided token wins" used to mean a token that merely
  // EXISTS wins, so a home config holding a token for another server (the
  // hosted board, say) aborted a local boot that was holding working superuser
  // credentials the whole time — and the abort said to run `lll login`, which
  // needs the server this boot was refusing to start. The member token is an
  // optimisation here (it decides who the board's writes author as), never a
  // requirement: absent OR unusable, fall through to the superuser.
  // The fallback must never make a boot WORSE than it was: a configured token
  // that this cannot verify is still the credential the caller chose, and an
  // unreachable superuser is not a reason to refuse a boot that used to work.
  // So an unusable token only LOSES to a superuser pair that actually
  // authenticates; when neither works, the token stays and whatever it does
  // next reports honestly. (Caught by the gate: an e2e boot reusing a running
  // PocketBase has a valid member token and default admin creds that do not
  // match that server, and refusing it was a regression this change caused.)
  let _ = os.Unsetenv("LLL_REMINT")
  let _ = os.Unsetenv("LLL_REMINT_MEMBER")
  let _ = os.Unsetenv("LLL_REALTIME_SUBSCRIPTION")
  // An explicit local share boot owns a new database, so an opaque token from
  // the user's hosted config cannot be allowed to win by the normal
  // conservative "maybe usable" rule.
  let mut using_token = share_bind == "" && cfg.token != "" &&
  pb.token_usable(db_url, cfg.token)
  if !using_token {
    match superuser_token(db_url, email, pass) {
      Ok(tok) => {
        if cfg.token != "" && share_bind != "" {
          fmt.Println(
            "auth   ignoring the inherited token for this new local board",
          )
        } else if cfg.token != "" {
          fmt.Println(
            f"auth   the token from {src.token} is not valid for {db_url} — booting on the superuser credentials instead; 'lll login' once the board is up replaces it",
          )
        }
        let _ = os.Setenv("LLL_TOKEN", tok)
        fmt.Println(
          "auth   rules are authenticated-only; bootstrapping with superuser credentials before signing in the board as a member",
        )
      },
      Err(e) => {
        if cfg.token == "" || share_bind != "" {
          return Err(
            f"could not authenticate as the server administrator at {db_url}: {e}
collection rules now refuse unauthenticated requests, so the boot cannot even
create its team. Point LLL_ADMIN_EMAIL/LLL_ADMIN_PASSWORD at this server's
superuser credentials, or set LLL_TOKEN to a member token valid for this server.",
          )
        }
        using_token = true
      },
    }
  }
  let member_token_ok = using_token

  // The in-process board (and its PB client) must talk to the db we chose.
  let _ = os.Setenv("LLL_URL", db_url)

  // An unscoped board cannot create issues, and a configured-but-missing
  // team is fatal further down, so settle the team here: `lll up` on a fresh
  // data dir must just work.
  // A boot that named its own data directory is a throwaway or a scratch board
  // (that is what e2e and `mise run scratch` pass), and the team it settles is
  // a fact about that database, not about this checkout - so it is not
  // persisted. Persisting it would put a .lll.toml into whatever directory the
  // scratch board ran in, which is the TASK-143 stray exactly.
  let throwaway = p.one("--pb-dir") != "" || scratch
  // A demo boot must not stop to ask for a team key: "show me the tool" is the
  // whole request. DEMO unless the caller already chose something.
  let demo = p.given("--demo")
  let want_team = if demo && cfg.team == "" { "DEMO" } else { cfg.team }
  let team = match ensure_team(want_team, src.team, throwaway) {
    Ok(team) => team,
    Err(e) => {
      let credential = if member_token_ok {
        f"token from {src.token}"
      } else {
        "superuser token generated for this startup"
      }
      return Err(f"{e}\nstartup credential: {credential}")
    },
  }
  let _ = os.Setenv("LLL_TEAM", team)
  let (member, refresh) = board_identity(db_url, email, pass)?
  if scratch {
    let _ = set_home_key("url", db_url)?
    let _ = set_home_key("team", team)?
    let _ = set_home_key("token", os.Getenv("LLL_TOKEN"))?
    fmt.Println(f"scratch data   {scratch_dir}")
    fmt.Println(f"scratch config {filepath.Join(scratch_dir, "config")}")
    fmt.Println(f"scratch admin  {email} / {pass} (shown once)")
    fmt.Println(
      f"scratch CLI    cd {scratch_dir} && env -u LLL_URL -u LLL_TOKEN -u LLL_TEAM LLL_CONFIG_HOME={filepath.Join(scratch_dir, "config")} lll issue list",
    )
  }
  if demo {
    seed_demo(team, member.name, db_url, strings.HasPrefix(src.token, "file:"))?
  }
  let chosen = free_port(web_port)
  if chosen != web_port {
    fmt.Println(f"port {web_port} taken — board moving to {chosen}")
  }
  fmt.Println(f"lll    {version()}")
  fmt.Println(api_line)
  fmt.Println(f"team   {team}")
  fmt.Println(f"member {member.name}")
  // The board binds in microseconds; a browser takes far longer to launch,
  // so opening before run_server blocks is not a race worth guarding.
  let board_url = advertised_board_url(chosen)
  let _ = set_home_key("web_url", board_url)?
  if share_bind != "" {
    let _ = set_home_key("url", board_url)?
    let _ = set_home_key("team", team)?
    let _ = set_home_key("token", os.Getenv("LLL_TOKEN"))?
    let login_file = filepath.Join(
      filepath.Dir(config.home_path()?),
      "board-login-url",
    )
    write_home_config(
      login_file,
      f"{board_url}/?board_token={resolve_board_token()}\n",
    )?
    let admin_file = filepath.Join(
      filepath.Dir(config.home_path()?),
      "local-admin.json",
    )
    let admin_json = match json.Marshal(
      LocalShareAdmin { url: board_url, email, password: pass },
    ) {
      Ok(b) => b,
      Err(e) => return Err(f"encoding local admin connection: {e}"),
    }
    write_home_config(admin_file, admin_json as string)?
    fmt.Println(f"share  board login and member passes use {board_url}")
    fmt.Println(
      "share  lll member passes --count 10 writes ten private teammate handoffs",
    )
  }
  if open {
    // Open the LOGIN url, not the bare one (LLL-444). Opening the bare url
    // landed the user on the gate's 401 page and sent them back to the
    // terminal to copy a token by hand — the whole of "i just want my
    // localhost, it's me, let me in". The gate sets the cookie and redirects
    // to the clean url, so the token never lingers in the address bar.
    // resolve_board_token pins its answer into the environment, so the
    // run_server below resolves the same token rather than a second one.
    let login_url = f"{board_url}/?board_token={resolve_board_token()}"
    if let Err(e) = open_url(login_url) {
      fmt.Println(f"could not open a browser: {e}")
    }
  }
  run_server(chosen, refresh, p.given("--admin-ui"))
}

/// Scratch is a PROCESS boundary: clear the inherited LLL_* values and move
/// away from any repo before the first config load. Only this lll process is
/// changed; the invoking shell and its real tracker stay untouched.
fn setup_scratch() -> Result<string, string> {
  let root = match os.MkdirTemp("", "lll-scratch-") {
    Ok(path) => path,
    Err(e) => return Err(f"creating scratch directory: {e}"),
  }
  for entry in os.Environ() {
    let key = strings.SplitN(entry, "=", 2)[0]
    if key.starts_with("LLL_") { let _ = os.Unsetenv(key) }
  }
  let _ = os.Unsetenv("XDG_CONFIG_HOME")
  if let Err(e) = os.Chdir(root) {
    return Err(f"entering scratch directory {root}: {e}")
  }
  let home = filepath.Join(root, "home")
  if let Err(e) = os.MkdirAll(home, 0o700) {
    return Err(f"creating scratch home {home}: {e}")
  }
  let db_port = available_port()?
  let _ = os.Setenv("HOME", home)
  let _ = os.Setenv("USER", "scratch")
  let _ = os.Setenv("LLL_CONFIG_HOME", filepath.Join(root, "config"))
  let _ = os.Setenv("LLL_URL", f"http://127.0.0.1:{db_port}")
  let _ = os.Setenv("LLL_TEAM", "SCRAT")
  let _ = os.Setenv("LLL_BIND", "127.0.0.1")
  let _ = os.Setenv("LLL_ADMIN_EMAIL", "admin@local.invalid")
  let _ = os.Setenv("LLL_ADMIN_PASSWORD", rand.Text() + rand.Text())
  Ok(root)
}

/// The local data directory owns the browser gate secret. A restart with the
/// same --bind and --pb-dir preserves every link already sent to teammates.
fn pin_local_board_token(pb_dir: string) -> Result<(), string> {
  if let Err(e) = os.MkdirAll(pb_dir, 0o700) {
    return Err(f"creating local board data directory {pb_dir}: {e}")
  }
  let path = filepath.Join(pb_dir, ".lll-board-token")
  let provided = os.Getenv("LLL_BOARD_TOKEN")
  let saved = match os.ReadFile(path) {
    Ok(b) => strings.TrimSpace(b as string),
    Err(e) => {
      if !os.IsNotExist(e) {
        return Err(f"reading local board token {path}: {e}")
      }
      ""
    },
  }
  let token = if provided != "" {
    provided
  } else if saved != "" { saved } else { rand.Text() }
  if saved != token { write_home_config(path, token + "\n")? }
  if let Err(e) = os.Setenv("LLL_BOARD_TOKEN", token) {
    return Err(f"using local board token: {e}")
  }
  Ok(())
}

/// A LAN board must never expose the loopback-only fallback administrator
/// password. Keep one random pair with its data directory, and copy it to the
/// machine's private config after startup for later member-pass minting.
fn pin_local_admin(pb_dir: string) -> Result<(), string> {
  let path = filepath.Join(pb_dir, ".lll-admin.json")
  let supplied_email = os.Getenv("LLL_ADMIN_EMAIL")
  let supplied_pass = os.Getenv("LLL_ADMIN_PASSWORD")
  if (supplied_email == "") != (supplied_pass == "") {
    return Err(
      "a shareable board needs both LLL_ADMIN_EMAIL and LLL_ADMIN_PASSWORD, or neither",
    )
  }
  let mut saved = LocalShareAdmin { .. }
  match os.ReadFile(path) {
    Ok(b) => {
      if let Err(e) = json.Unmarshal(b, &saved) {
        return Err(f"decoding local admin credentials in {path}: {e}")
      }
      if saved.email == "" || saved.password == "" {
        return Err(f"local admin credentials in {path} are incomplete")
      }
    },
    Err(e) => if !os.IsNotExist(e) {
      return Err(f"reading local admin credentials in {path}: {e}")
    },
  }
  let email = if supplied_email != "" {
    supplied_email
  } else if saved.email != "" { saved.email } else { "admin@local.invalid" }
  let pass = if supplied_pass != "" {
    supplied_pass
  } else if saved.password != "" {
    saved.password
  } else {
    rand.Text() + rand.Text()
  }
  if saved.email != email || saved.password != pass {
    let encoded = match json.Marshal(
      LocalShareAdmin { url: "", email, password: pass },
    ) {
      Ok(b) => b,
      Err(e) => return Err(f"encoding local admin credentials: {e}"),
    }
    write_home_config(path, encoded as string)?
  }
  if let Err(e) = os.Setenv("LLL_ADMIN_EMAIL", email) {
    return Err(f"using local admin email: {e}")
  }
  if let Err(e) = os.Setenv("LLL_ADMIN_PASSWORD", pass) {
    return Err(f"using local admin password: {e}")
  }
  Ok(())
}

/// The kernel chooses a free port while the listener is bound. The normal up
/// path still checks it again before serving, including a collision fallback.
fn available_port() -> Result<int, string> {
  let listener = match net.Listen("tcp", "127.0.0.1:0") {
    Ok(l) => l,
    Err(e) => return Err(f"selecting a scratch port: {e}"),
  }
  let Some(addr) = listener.Addr() else {
    let _ = listener.Close()
    return Err("the scratch listener did not report an address")
  }
  let port = port_of(addr.String(), 0)
  let _ = listener.Close()
  if port == 0 { return Err("the scratch listener did not report its port") }
  Ok(port)
}

fn print_up_usage() {
  fmt.Println(
    "lll up - start the lll server and web board together

Usage:
  lll up [--port 8100] [--pb-dir pb/pb_data] [--no-open] [--demo] [--admin-ui]
  lll up --scratch [--no-open]   (--local is an alias)
  lll up --bind LAN_OR_TAILSCALE_IP [--no-open]

Reuses a server API already running at the configured URL; otherwise runs one
in-process (first free port from the configured port up) after upserting the
administrator from LLL_ADMIN_EMAIL/LLL_ADMIN_PASSWORD (a local fallback is used
when unset). The board opens in your browser unless --no-open. Taken ports
auto-increment. Ctrl-C stops everything lll up started; an externally-started
server API is left running.

The administration UI at the board's /_/ path is disabled by default.
--admin-ui enables it and prints its address. Sign in with the server's
administrator credentials; LLL_ADMIN_EMAIL/LLL_ADMIN_PASSWORD set them when
starting a local API. Administrator credentials are never printed.

The board needs a team. A configured team (LLL_TEAM or 'team' in .lll.toml)
is created on the server if it is missing. With none configured lll up asks
for one and writes the answer to the repo's .lll.toml, so the board and the
CLI always agree; with nothing on stdin to answer with (scripts, agents, CI)
it refuses to start rather than run on a team only this process knows about.
'lll attach' settles the same question up front, without a boot.

--scratch starts a fresh local board in a temporary directory, ignoring all
inherited LLL_* values, home/repo config, and XDG_CONFIG_HOME. Its banner gives
the directory and a CLI command to reach that board; delete the directory when
finished. It never writes to the original directory's config.

--bind starts a local board for teammates on the named LAN or Tailscale IP.
It chooses a local API port, serves the API through the board URL, saves this
machine's CLI connection, and keeps its board login token in the data directory
so a restart with the same directory preserves shared links. Run 'lll member
passes --count 10' in another terminal to create distinct human credentials.

Whichever way the team was settled, it is written to .lll.toml unless a
config file already supplies it, so the NEXT boot in this directory needs no
LLL_TEAM and no prompt.

The board is gated: it answers only requests carrying its board token.
LLL_BOARD_TOKEN sets that token; otherwise one is generated per boot and
printed in the banner as a login URL — open it once and the browser keeps
access in a cookie. From a terminal, send the same cookie: curl
-H 'Cookie: lll_board=<token>' http://127.0.0.1:<port>/.

A valid member token selects the board's identity. Otherwise the superuser
credentials bootstrap a member from $USER (local when absent), then mint a
member token for this process. Board writes and token renewal use that member.
Use LLL_TOKEN to run the board as another authenticated member; 'lll whoami'
shows the CLI's login. Existing CLI credentials are left alone.",
  )
}

/// The team the board writes to. A team the config names is created if the
/// server lacks it. With none configured we ask and write the answer to
/// .lll.toml — the board and the CLI must not disagree about the team, so a
/// team that lives only in this process is not an option. No one to ask
/// (stdin is not a terminal: scripts, agents, CI) means no boot.
///
/// `source` is where `want` came from, as `config.load_traced` reports it;
/// `throwaway` is true when the boot named its own --pb-dir.
///
/// TASK-115: a boot that settles a team must leave it settled. `LLL_TEAM=X
/// lll up` used to create the team, boot happily and persist NOTHING - the
/// env var satisfied the config, so the code that writes .lll.toml was never
/// reached, and the next boot without that env var failed with "no team
/// configured" all over again. Persisting closes that loop, under two
/// conditions that keep it from becoming TASK-143's stray-file bug:
///
///   - a `file:` source has persisted it already, so there is nothing to do
///     and rewriting a committed .lll.toml on every boot would be churn;
///   - a --pb-dir boot is a throwaway or a scratch board, and the team it
///     settled is a fact about that database rather than about this
///     directory. It is also the one kind of boot that runs in directories
///     nobody attached on purpose, which is where a stray .lll.toml hurts.
fn ensure_team(
  want: string,
  source: string,
  throwaway: bool,
) -> Result<string, string> {
  if want != "" {
    let key = resolve_team(want)?
    if should_save_team(source, throwaway) { save_team(key)? }
    return Ok(key)
  }

  let teams = records.list_teams()?
  let mut suggested = default_team_key()
  if let Some(t) = teams.items.get(0) { suggested = t.key }

  let key = ask_team(suggested)?
  let existing = records.find_team(key)?
  if existing.is_none() {
    match create_team(key, key) {
      Ok(created) => {
        let _ = fmt.Println(
          f"created team {created.key} — issues will be {created.key}-1, {created.key}-2, ...",
        )
      },
      Err(e) => {
        let existing = records.find_team(key)?
        if existing.is_none() { return Err(f"creating team '{key}': {e}") }
      },
    }
  }
  // Same bargain as the configured branch above. The source is "" here — the
  // key was just typed, so no file supplies it yet and it is worth writing
  // unless this is a scratch board (TASK-143).
  if should_save_team("", throwaway) { save_team(key)? }
  Ok(key)
}

/// Whether a settled team key is worth writing to .lll.toml (TASK-115).
/// Pure, and split out from ensure_team because it is the whole of the
/// TASK-143 guard: a wrong answer here is a config file appearing in a
/// directory nobody attached, which is a bug that shows up hours later
/// somewhere else entirely.
fn should_save_team(source: string, throwaway: bool) -> bool {
  // A --pb-dir boot's team belongs to that database, not to this directory.
  if throwaway { return false }
  // A file already carries it; rewriting it every boot is churn.
  !strings.HasPrefix(source, "file:")
}

/// A configured team key, created on the server if it is missing. Another
/// lll up pointed at the same fresh server may create the team between our
/// find and our create; the unique index rejects the loser, and the loser
/// re-looks-up whoever won rather than failing the boot (the same bargain
/// e2e.sh's seed_team runs on).
fn resolve_team(want: string) -> Result<string, string> {
  if let Some(t) = records.find_team(want)? { return Ok(t.key) }
  match create_team(want, want) {
    Ok(created) => {
      fmt.Println(f"created team {created.key}")
      Ok(created.key)
    },
    Err(e) => {
      if let Some(t) = records.find_team(want)? { return Ok(t.key) }
      Err(f"creating team '{want}': {e}")
    },
  }
}

/// Bootstrap with admin authority, then serve as an actual member. Renewals
/// keep that same identity rather than upgrading normal board calls to admin.
fn board_identity(
  base: string,
  email: string,
  pass: string,
) -> Result<(Actor, Option<fn() -> Result<string, string>>), string> {
  if let Some(member) = actor()? { return Ok((member, None)) }
  let cfg = config.load()?
  let guessed = strings.TrimSpace(os.Getenv("USER"))
  let name = if guessed == "" { "local" } else { guessed }
  let created = ensure_member(name)?
  if created { fmt.Println(f"created member {name}") }
  let Some(member) = records.find_member(name)? else {
    return Err(f"could not resolve the board member {name}")
  }
  let token = pb.impersonate_member(
    base,
    cfg.token,
    member.id,
    default_token_duration(),
  )?
  let _ = os.Setenv("LLL_TOKEN", token)
  let _ = os.Setenv("LLL_ADMIN_EMAIL", email)
  let _ = os.Setenv("LLL_ADMIN_PASSWORD", pass)
  let _ = os.Setenv("LLL_REMINT", "1")
  let _ = os.Setenv("LLL_REMINT_MEMBER", member.id)
  let id = member.id
  let refresh: fn() -> Result<string, string> = || {
    let admin = superuser_token(base, email, pass)?
    pb.impersonate_member(base, admin, id, default_token_duration())
  }
  fmt.Println(
    f"auth   board signed in as {name}; token renewal keeps this member",
  )
  Ok((Actor { id: member.id, name }, Some(refresh)))
}

/// Ask for a team key on stdin, defaulting to `suggested`. Errs when stdin
/// has no answer to give (scripts, agents, CI).
fn ask_team(suggested: string) -> Result<string, string> {
  fmt.Print(f"no team configured — team key [{suggested}]: ")
  let newline = 10 as byte
  let Partial.Ok(line) = bufio.NewReader(os.Stdin).ReadString(newline) else {
    fmt.Println("")
    return Err(
      f"no team configured and no answer on stdin — set LLL_TEAM={suggested}, or add team = \"{suggested}\" to .lll.toml (see 'lll config init')",
    )
  }
  // Only directory-derived suggestions are shortened/normalized. Explicit
  // input follows team create and attach -k: preserve the identifier.
  let typed = strings.TrimSpace(line)
  if typed == "" { Ok(suggested) } else { Ok(typed) }
}

/// Persist the team to the repo's .lll.toml so the next boot and the CLI
/// agree. The team is the one key that belongs in the repo — `lll attach`
/// writes the same line, deliberately.
fn save_team(key: string) -> Result<(), string> {
  let path = set_repo_key("team", key)?
  fmt.Println(f"wrote team = \"{key}\" to {path}")
  Ok(())
}

/// Team key for a first boot: the working directory's name, letters and
/// digits only, uppercased, at most 5 characters.
fn default_team_key() -> string {
  let Ok(dir) = os.Getwd() else {
    return "TEAM"
  }
  let key = clean_key(filepath.Base(dir))
  if key == "" { "TEAM" } else { key }
}

/// A team key: letters and digits only, uppercased, at most 5 characters.
fn clean_key(raw: string) -> string {
  let mut key = ""
  for r in raw.runes() {
    if unicode.IsLetter(r) || unicode.IsDigit(r) {
      key += strings.ToUpper(r as string)
    }
    if key.length() == 5 { break }
  }
  key
}

fn healthy(base_url: string) -> bool {
  // Bounded: a non-PB listener on the port must fail fast, not hang us.
  let client = http.Client { Timeout: 2 * time.Second, .. }
  let Ok(resp) = client.Get(f"{base_url}/api/health") else {
    return false
  }
  if let Some(body) = resp.Body { let _ = body.Close() }
  resp.StatusCode == 200
}

/// Whether `base_url` names this machine. The question `healthy()` cannot
/// answer: production answers /api/health perfectly, which is exactly why an
/// already-configured remote url gets adopted by a boot that meant to be local.
pub fn is_loopback(base_url: string) -> bool {
  // SplitN throughout, not Index + substring: strings.Index returns a BYTE
  // offset while substring takes rune indices (see realtime.split_field).
  let after_scheme = strings.SplitN(base_url, "://", 2)
  let mut host = after_scheme[after_scheme.length() - 1]
  host = strings.SplitN(host, "/", 2)[0]
  // An IPv6 literal wears brackets: "[::1]:8090".
  if host.starts_with("[") {
    let inner = strings.SplitN(strings.TrimPrefix(host, "["), "]", 2)[0]
    return inner == "::1"
  }
  let name = strings.SplitN(host, ":", 2)[0]
  name == "127.0.0.1" || name == "localhost" || name == "::1" || name == ""
}

/// First free TCP port at or above `start`.
fn free_port(start: int) -> int {
  let mut p = start
  loop {
    match net.Listen("tcp", f"127.0.0.1:{p}") {
      Ok(l) => {
        let _ = l.Close()
        return p
      },
      Err(_) => p += 1,
    }
  }
}

/// Port from "http://127.0.0.1:8090", or `fallback`.
fn port_of(base_url: string, fallback: int) -> int {
  // Split, not LastIndex + substring; see realtime.split_field.
  let parts = strings.Split(base_url, ":")
  let Ok(p) = strconv.Atoi(parts[parts.length() - 1]) else {
    return fallback
  }
  p
}

/// Authenticate as the PocketBase superuser and return the auth token.
/// The same credentials Serve upserted, through PocketBase's own
/// auth-with-password endpoint — the admin API, not a shortcut past the
/// rules, so what the boot does is exactly what a member with a token does.
///
/// Through pb.post_anon_to, which is this exact request: POST to an explicit
/// base, no Authorization header, body read and non-2xx turned into an error.
/// This function used to spell all of that out again, down to repeating
/// client.lis's comment about Header being an Option. Going through the shared
/// path also picks up its unreachable-server hint, which the copy did not have.
fn superuser_token(
  base: string,
  email: string,
  pass: string,
) -> Result<string, string> {
  let payload = match json.Marshal(
    models.AuthRequest { identity: email, password: pass },
  ) {
    Ok(b) => b as string,
    Err(e) => return Err(f"encoding credentials: {e}"),
  }
  let body = pb.post_anon_to(
    base,
    "/api/collections/_superusers/auth-with-password",
    payload,
  )?
  let mut out = models.AuthResponse { .. }
  if let Err(e) = json.Unmarshal(body.bytes(), &out) {
    return Err(f"decoding the auth response: {e}")
  }
  if out.token == "" { return Err("the response carried no token") }
  Ok(out.token)
}
