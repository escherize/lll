import "config"
import "pb"

#[test]
fn description_delivery_tracks_each_connection_and_retries_after_backpressure() {
  let ready = Channel.buffered<string>(4)
  let slow = Channel.buffered<string>(1)
  let _ = slow.send("occupied")
  let clients = [
    SseClient { id: 1, scope: "issue:T-1", ch: ready, reader: reader("board"), .. },
    SseClient { id: 2, scope: "issue:T-1", ch: slow, reader: reader("board"), .. },
  ]
  let msg = Broadcast { scope: "issue:T-1", reader: "board", payload: "metadata", description: Some("unique description"), .. }
  let delivered = deliver(clients, msg)
  assert delivered[0].description_hash != ""
  assert delivered[1].description_hash == ""
  assert ready.receive().unwrap_or("").contains("unique description")
  assert slow.receive().unwrap_or("") == "occupied"
  let retried = deliver(delivered, msg)
  assert ready.receive().unwrap_or("") == "metadata"
  assert slow.receive().unwrap_or("").contains("unique description")
  assert retried[0].description_hash == retried[1].description_hash
  let cleared = deliver(retried, Broadcast { description: Some(""), ..msg })
  assert ready.receive().unwrap_or("").contains("hidden")
  assert slow.receive().unwrap_or("").contains("hidden")
  assert cleared[0].description_hash != delivered[0].description_hash
}

#[test]
fn fresh_description_snapshots_are_targeted_and_scope_is_respected() {
  let a = Channel.buffered<string>(4)
  let b = Channel.buffered<string>(4)
  let clients = [
    SseClient { id: 1, scope: "issue:T-1", ch: a, reader: reader("board"), .. },
    SseClient { id: 2, scope: "issue:T-1", ch: b, reader: reader("board"), .. },
  ]
  let msg = Broadcast { scope: "issue:T-1", reader: "board", payload: "metadata", description: Some("fresh"), client_id: 2, .. }
  let delivered = deliver(clients, msg)
  assert delivered[0].description_hash == ""
  assert delivered[1].description_hash != ""
  assert b.receive().unwrap_or("").contains("fresh")
  let mut leaked = false
  select { a.receive() => { leaked = true }, _ => () }
  assert !leaked
  let _ = deliver(delivered, Broadcast { scope: "issue:T-2", ..msg })
  select { b.receive() => { leaked = true }, _ => () }
  assert !leaked
}

/// A reader that never reaches a server: delivery and the hub's books do
/// not read.
fn reader(key: string) -> Reader {
  let settings = config.given(config.Config { url: "http://127.0.0.1:1", .. }, config.Sources { .. }, config.Env { .. })
  Reader { key, client: pb.Client.new(settings), scoped: key != "board", writes: true }
}

// LLL-658: a client gets only what was read as its own reader, whatever
// its scope string says.
#[test]
fn clients_receive_only_what_was_read_as_them() {
  let full = Channel.buffered<string>(4)
  let member = Channel.buffered<string>(4)
  let clients = [
    SseClient { id: 1, scope: "board:BBB:manual", ch: full, reader: reader("board"), .. },
    SseClient { id: 2, scope: "board:BBB:manual", ch: member, reader: reader("member:tok"), .. },
  ]
  let delivered = deliver(clients, Broadcast { scope: "board:BBB:manual", reader: "board", payload: "bbb", .. })
  assert full.receive().unwrap_or("") == "bbb"
  let mut leaked = false
  select { member.receive() => { leaked = true }, _ => () }
  assert !leaked
  // Workspace-wide rows are the board login's alone.
  let _ = deliver(delivered, Broadcast { scope: "*", reader: "board", payload: "favorites", .. })
  assert full.receive().unwrap_or("") == "favorites"
  select { member.receive() => { leaked = true }, _ => () }
  assert !leaked
  // Its own read arrives, and only to it.
  let _ = deliver(delivered, Broadcast { scope: "board:BBB:manual", reader: "member:tok", payload: "mine", .. })
  assert member.receive().unwrap_or("") == "mine"
  select { full.receive() => { leaked = true }, _ => () }
  assert !leaked
}

// One read per (view, reader): two tabs of one member share a read, and an
// issue's exact scope does not match its longer-numbered sibling.
#[test]
fn open_views_are_counted_once_per_reader() {
  let ch = Channel.buffered<string>(1)
  let clients = [
    SseClient { id: 1, scope: "board:AAA:manual", ch, reader: reader("member:a"), .. },
    SseClient { id: 2, scope: "board:AAA:manual", ch, reader: reader("member:a"), .. },
    SseClient { id: 3, scope: "board:AAA:updated", ch, reader: reader("member:a"), .. },
    SseClient { id: 4, scope: "board:AAA:manual", ch, reader: reader("board"), .. },
    SseClient { id: 5, scope: "board:AAAB:manual", ch, reader: reader("board"), .. },
    SseClient { id: 6, scope: "issue:AAA-10", ch, reader: reader("link:AAA"), .. },
  ]
  let board = watches(clients, WatchQuery { scope: "board:AAA:", exact: false, client_id: 0, reply: Channel.new<Slice<OpenView>>() })
  assert board.length() == 3
  assert readers_of(board).map(|r| r.key).equals(["member:a", "board"])
  let one = watches(clients, WatchQuery { scope: "board:AAA:", exact: false, client_id: 4, reply: Channel.new<Slice<OpenView>>() })
  assert readers_of(one).map(|r| r.key).equals(["board"])
  let issue = watches(clients, WatchQuery { scope: "issue:AAA-1", exact: true, client_id: 0, reply: Channel.new<Slice<OpenView>>() })
  assert issue.is_empty()
}

fn board_job(team: string, order: string, client_id: int) -> Refresh {
  Refresh.Board(BoardRefresh { team_key: team, team_id: "", order, client_id })
}

#[test]
fn refresh_queue_bounds_workers_and_serializes_each_view() {
  let mut q = RefreshQueue.new()
  q.submit(board_job("AAA", "", 0))
  q.submit(board_job("BBB", "", 0))
  q.submit(Refresh.Favorites)
  let started = q.start(2)
  assert started.length() == 2
  assert started[0].key == "board:AAA"
  assert started[1].key == "board:BBB"
  // A refresh of a running view waits for it, merged with the next one.
  q.submit(board_job("AAA", "manual", 7))
  q.submit(board_job("AAA", "updated", 7))
  assert q.start(2).is_empty()
  q.finished(RunEnd { key: "board:AAA", id: started[0].id })
  let next = q.start(2)
  assert next.length() == 1
  assert next[0].key == "favorites"
  q.finished(RunEnd { key: "board:BBB", id: started[1].id })
  let again = q.start(2)
  assert again.length() == 1
  assert again[0].key == "board:AAA"
  let assert Refresh.Board(merged) = again[0].job
  assert merged.order == ""
  assert merged.client_id == 7
}

#[test]
fn refresh_queue_frees_the_worker_of_an_overdue_run_once() {
  let mut q = RefreshQueue.new()
  q.submit(board_job("SLOW", "", 0))
  q.submit(board_job("FAST", "", 0))
  let first = q.start(1)
  assert first.length() == 1
  let slow = RunEnd { key: "board:SLOW", id: first[0].id }
  assert q.overdue(slow)
  assert !q.overdue(slow)
  // The worker went to the next view; the slow one's own views still wait.
  let second = q.start(1)
  assert second.length() == 1
  assert second[0].key == "board:FAST"
  q.submit(board_job("SLOW", "", 0))
  q.finished(RunEnd { key: "board:FAST", id: second[0].id })
  assert q.start(1).is_empty()
  q.finished(slow)
  let third = q.start(1)
  assert third.length() == 1
  assert third[0].key == "board:SLOW"
  // A stale report about an earlier run changes nothing.
  q.finished(slow)
  assert !q.overdue(slow)
}

#[test]
fn merging_board_refreshes_keeps_the_key_with_its_id_and_widens() {
  // A snapshot's key is the URL's spelling; an event's is the stored one.
  let snapshot = Refresh.Board(BoardRefresh { team_key: "live", team_id: "", order: "manual", client_id: 4 })
  let event = Refresh.Board(BoardRefresh { team_key: "LIVE", team_id: "t1", order: "", client_id: 0 })
  let assert Refresh.Board(merged) = merge_refresh(snapshot, event)
  assert merged.team_key == "LIVE"
  assert merged.team_id == "t1"
  assert merged.order == ""
  assert merged.client_id == 0
  let assert Refresh.Resolve(r) = merge_refresh(
    Refresh.Resolve(ResolveRefresh { issue_id: "i", board: false }),
    Refresh.Resolve(ResolveRefresh { issue_id: "i", board: true }),
  )
  assert r.board
  let assert Refresh.Board(snap) = snapshot_refresh(PageSnapshot { team: "live", order: "manual", client_id: 4, .. })
  assert snap.team_key == "LIVE"
}

#[test]
fn a_reconnect_rereads_every_open_view_and_the_rail() {
  let jobs = resync_refreshes(["board:ENG:manual", "issue:ENG-3", "board:OPS-2:updated", "something:else"])
  let keys = jobs.map(refresh_key)
  assert keys.equals(["favorites", "views", "board:ENG", "issue:ENG-3", "board:OPS-2"])
  let assert Refresh.Board(ops) = jobs[4]
  assert ops.order == "updated"
  assert ops.client_id == 0
}

#[test]
fn replace_event_names_its_selector_and_every_line() {
  let ev = replace_event("#comment-form", "<a>\n</a>")
  assert ev == "event: datastar-patch-elements\ndata: mode replace\ndata: selector #comment-form\ndata: elements <a>\ndata: elements </a>\n\n"
  assert patch_event("<a>") == "event: datastar-patch-elements\ndata: elements <a>\n\n"
}
