import "go:fmt"
import "go:os/exec"
import "go:strings"
import "config"
import "flags"
import "records"
import "pb"

/// `lll board` — print the web board URL; `-w` opens it in the browser.
pub fn board_spec() -> Slice<flags.Flag> {
  [
    flags.Flag { name: "-w", alias: "--web", help: "open the board in the browser", .. },
    flags.Flag { name: "--team", value: true, hint: "KEY", help: "print a view-only link to one team's board, for someone without an account", .. },
    flags.Flag { name: "--help", alias: "-h", hidden: true, help: "show this help", .. },
  ]
}

pub fn board(ctx: pb.Client, args: Slice<string>) -> Result<(), string> {
  let spec = board_spec()
  let p = flags.parse(spec, args, 2, false, "lll board [-w] [--team KEY] (prints the URL; no subcommand is needed)")?
  if p.given("--help") {
    print_board_usage()
    return Ok(())
  }
  let open = p.given("-w")
  let mut base = web_base(ctx)?
  if p.given("--team") {
    base = team_link(ctx, base, p.one("--team"))?
  } else if (base.starts_with("http://") || base.starts_with("https://")) && is_loopback(base) {
    // The board is gated: a bare url answers 401 (LLL-648). On the machine
    // serving a loopback board, the printed link signs the browser in. Only
    // loopback: an LLL_BOARD_TOKEN must never ride to whatever other host
    // web_url names.
    if let Some(tok) = known_board_token(ctx, base) { base = f"{base}/?board_token={tok}" }
  }
  if open {
    fmt.Println(f"Opening {base}")
    return open_url(base)
  }
  fmt.Println(base)
  Ok(())
}

fn print_board_usage() {
  fmt.Println(
    "lll board - the web board URL

Usage:
  lll board              print the board URL
  lll board -w           open the board in the browser
  lll board --team KEY   print a view-only link to one team's board

The board answers only browsers that carry its board token. On the machine
running a loopback 'lll up', the printed URL carries the token as
?board_token=..., and opening it once signs the browser in with a cookie.
That link opens every team: do not share it. Elsewhere the URL is bare; sign
in with the link your deployer or an invite gave you.

--team is how you share one team with someone who has no account: the link
opens only that team's board, read-only, and creates no member. It works on
the machine that knows the board token (the one running 'lll up', or with
LLL_BOARD_TOKEN set), and stops working when the server's LLL_BOARD_TOKEN
changes; it does not expire on its own. To give someone their own login
instead, use 'lll member invite NAME --email E --team KEY --read-only'.

Set the board endpoint with 'lll config set web_url URL'. LLL_WEB_URL
and repo configuration override the machine setting. 'lll up' saves its
actual local endpoint, unless the home config's url names another server.
The API URL alone does not identify a board URL.",
  )
}

/// Web board base URL (env > config > default), without a trailing slash.
fn web_base(ctx: pb.Client) -> Result<string, string> {
  let cfg = ctx.settings.config()?
  if cfg.web_url == "" {
    return Err("board URL is not configured; run 'lll config set web_url URL' with the board address supplied by your deployer (or set LLL_WEB_URL)")
  }
  Ok(strings.TrimRight(cfg.web_url, "/"))
}

/// Open a URL in the default browser (macOS `open`, else `xdg-open`).
/// Shared with `lll up`.
pub fn open_url(url: string) -> Result<(), string> {
  let mut opener = ""
  if let Partial.Ok(path) = exec.LookPath("open") { opener = path }
  if opener == "" {
    if let Partial.Ok(path) = exec.LookPath("xdg-open") { opener = path }
  }
  if opener == "" {
    return Err("no browser opener found (need 'open' or 'xdg-open')")
  }
  if let Err(e) = exec.Command(opener, url).Start() {
    return Err(f"opening {url}: {e}")
  }
  Ok(())
}

/// The view-only link for team `key` (fleet case 05: 10 of 10 agents asked
/// for a client's board link had to create a member through 'lll member
/// invite' to get one).
fn team_link(ctx: pb.Client, base: string, key: string) -> Result<string, string> {
  let wanted = records.normalize_team_key(key)
  let found = records.find_team(ctx, wanted)?
  if found.is_none() {
    return Err(records.unknown_team(ctx, wanted))
  }
  let Some(link) = scoped_board_link(ctx, base, wanted) else {
    return Err(
      "no board token on this machine: run this where 'lll up' runs, or set LLL_BOARD_TOKEN to the server's board token",
    )
  }
  Ok(link)
}
