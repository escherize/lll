import "records"
import "go:bufio"
import "go:encoding/json"
import "go:fmt"
import "go:golang.org/x/term"
import "go:os"
import "go:strings"
import "go:time"

import "config"
import "flags"
import "models"
import "pb"

// `lll login` / `lll logout` (TASK-183) — the human entry point for auth.
// A human authenticates with email + password through PocketBase's own
// auth-with-password endpoint and keeps the token in the home config, where
// TASK-179's layered plumbing picks it up on every later request.

pub fn login_spec() -> Slice<flags.Flag> {
  [
    flags.Flag {
      name: "--email",
      alias: "-e",
      value: true,
      hint: "email",
      help: "member email; omit to be prompted",
      ..,
    },
    flags.Flag {
      name: "--url",
      value: true,
      hint: "url",
      help: "server base url; authenticated against and persisted to the home config",
      ..,
    },
    flags.Flag { name: "--web-url", value: true, hint: "URL", help: "board endpoint to persist separately from the API URL", .. },
    flags.Flag {
      name: "--password",
      value: true,
      hint: "pw",
      help: "password; omit to be prompted (a terminal reads it with echo off)",
      ..,
    },
    flags.Flag {
      name: "--token",
      value: true,
      hint: "token",
      help: "log in with a member token instead of a password; - prompts for it",
      ..,
    },
    flags.Flag {
      name: "--admin-email",
      value: true,
      hint: "email",
      help: "superuser email for --create (else LLL_ADMIN_EMAIL)",
      ..,
    },
    flags.Flag {
      name: "--admin-password",
      value: true,
      hint: "pw",
      help: "superuser password for --create (else LLL_ADMIN_PASSWORD)",
      ..,
    },
    flags.Flag {
      name: "--create",
      help: "no account yet: create the member first, using LLL_ADMIN_EMAIL/LLL_ADMIN_PASSWORD",
      ..,
    },
    flags.Flag {
      name: "--name",
      value: true,
      hint: "name",
      help: "member name for --create (default: the part of the email before @)",
      ..,
    },
    flags.Flag {
      name: "--help",
      alias: "-h",
      hidden: true,
      help: "show this help",
      ..,
    },
  ]
}

/// Dispatch `lll login`.
pub fn login(ctx: pb.Client, args: Slice<string>) -> Result<(), pb.CliError> {
  let spec = login_spec()
  let usage = flags.usage("lll login", spec, "")
  let p = flags.parse(spec, args, 2, false, usage)?

  if p.given("--help") {
    print_login_usage()
    return Ok(())
  }

  let before_login = ctx.settings.config().map_err(pb.failed)?
  let saved_before_login = ctx.settings.load_home().map_err(pb.failed)?
  let board_endpoint = if p.given("--web-url") { checked_web_url(p.one("--web-url"))? } else { "" }

  // --url is the fresh-machine path (TASK-195): authenticate against the url
  // given, then persist it next to the token, so machine setup is exactly one
  // command. Without it, login rides whatever url is already configured.
  // Read for the whole command, not just --create: login_failed compares
  // the admin email to recognise the admin identity, and it has to see the
  // flags too or the flag-users get the generic advice.
  let admin = given_admin_login(ctx.settings, p)?
  let admin_email = admin_login_email(admin)
  let target = strings.TrimSuffix(strings.TrimSpace(p.one("--url")), "/")
  if p.given("--url") && !strings.HasPrefix(target, "http://") && !strings.HasPrefix(target, "https://") {
    return Err(
      flags.usage_error("--url must be a full base url starting with http:// or https:// (e.g. https://tracker.example.com)"),
    )
  }
  if let Some(why) = login_target_conflict(target, saved_before_login.url, before_login.url) {
    return Err(pb.failed(why))
  }

  // One reader for the whole flow: a second bufio.Reader would race the
  // first's read-ahead and could lose the password line behind the email.
  let mut input = bufio.NewReader(os.Stdin)
  if p.given("--token") {
    if p.given("--email") || p.given("--password") || p.given("--create") {
      return Err(pb.failed("--token logs in with a member token: drop --email, --password and --create"))
    }
    let raw = p.one("--token")
    let given = if raw == "-" { read_password(input, "Token: ")? } else { raw }
    let tok = strings.TrimSpace(given)
    // The rest of a --url login talks to that server: --url is a flag
    // override of the configured one for this command.
    let ctx = if target != "" { ctx.with_url(target) } else { ctx }
    let (name, read_only) = token_identity(ctx, tok)?
    return finish_login(ctx, target, before_login, saved_before_login, board_endpoint, tok, name, read_only)
  }
  // Nothing to prompt at: say what is missing in one go rather than one
  // refusal per flag. Scripts, CI and agents are exactly the callers with no
  // terminal, and they are the ones who cannot answer a prompt.
  let interactive = term.IsTerminal(os.Stdin.Fd() as int)
  if !interactive && p.one("--email") == "" && !p.given("--password") {
    return Err(
      pb.failed("no email and no password, and no terminal to prompt at; pass both:
  lll login --url <server> --email <your email> --password <pw>"),
    )
  }
  let mut email = p.one("--email")
  if email == "" {
    fmt.Print("Email: ")
    email = read_line(input)?
  }
  email = strings.TrimSpace(email)
  if email == "" {
    return Err(pb.failed("no email: pass --email <email> or answer the prompt"))
  }
  // A flag, not only a prompt: setting up an agent or a CI machine is exactly
  // the case with no terminal to type into, and every usability run reached
  // for --password before finding that piping stdin was the only way.
  let prompt = if p.given("--create") {
    f"New password for {email}: "
  } else {
    f"Password for {email}: "
  }
  let password = if p.given("--password") {
    p.one("--password")
  } else {
    read_password(input, prompt)?
  }
  if password == "" {
    let whose = if p.given("--create") {
      f"no password: --create needs one to give {email}"
    } else {
      "no password"
    }
    return Err(
      pb.failed(f"{whose}; pass --password <pw>, or pipe it: printf '%s\\n' \"$PW\" | lll login ..."),
    )
  }

  // --create is the fresh-server path: the operator holds the superuser
  // credentials and no member record exists yet, which is the dead end every
  // usability run hit — 'Failed to authenticate' with nothing naming the
  // command that makes an account. The provisioning is 'lll member invite'
  // minus the paperwork, and it runs BEFORE the auth below so the same
  // command that creates the account is the one that logs into it.
  if p.given("--create") {
    // The admin identity is not a member identity. A dumber-model run logged
    // in with the ADMIN email, hit "no member with that email", added
    // --create as the message suggested, and minted a member shadowing the
    // superuser — same address, and whatever password it typed. Nothing in
    // the flow objected. Refuse it: this is the one email --create must not
    // take, and the person running it already has a real one.
    if email == admin_email && admin_email != "" {
      return Err(
        pb.failed(f"{email} is the server's admin identity, not a member. Creating a member with it
would put a second account on that address. --create makes YOUR login: pass
--email <your own address>. The admin credentials stay in the environment."),
      )
    }
    // PocketBase's own minimum, checked here so a too-short password is one
    // sentence rather than a raw validation blob from the create round trip.
    if password.length() < 8 {
      return Err(
        flags.usage_error(f"--create needs a password of at least 8 characters (got {password.length()})"),
      )
    }
    let name = if p.one("--name") != "" {
      p.one("--name")
    } else {
      strings.Split(email, "@")[0]
    }
    create_for_login(ctx, name, email, password, target, admin)?
    fmt.Println(f"created member {name} <{email}>")
  }

  let payload = match json.Marshal(
    models.AuthRequest { identity: email, password },
  ) {
    Ok(b) => b,
    Err(e) => return Err(pb.failed(f"encoding credentials: {e}")),
  }
  // post_anon, not post: a stale token in the config must not ride on a
  // request whose whole job is to mint a fresh one.
  let auth_path = "/api/collections/members/auth-with-password"
  let sent = if target == "" {
    ctx.post_anon(auth_path, payload as string)
  } else {
    pb.post_anon_to(target, auth_path, payload as string)
  }
  let body = match sent {
    Ok(b) => b,
    Err(e) => return Err(login_failed(ctx, e, email, target, admin_email)),
  }
  let mut auth = models.AuthResponse { .. }
  if let Err(e) = json.Unmarshal(body.bytes(), &auth) {
    return Err(pb.failed(f"decoding the auth response: {e}"))
  }
  if auth.token == "" { return Err(pb.failed("the response carried no token")) }
  finish_login(ctx,
    target,
    before_login,
    saved_before_login,
    board_endpoint,
    auth.token,
    auth.record.name,
    auth.record.access().map_or(false, |a| !a.mode.writes()),
  )
}

/// The member a token names and whether it is read-only, asked of the
/// server it will be saved for (`ctx` is pointed at --url when one was
/// given). The access route answers only a valid member token, so a
/// superuser token, a revoked one or a typo stops here instead of being saved.
fn token_identity(ctx: pb.Client, tok: string) -> Result<(string, bool), pb.CliError> {
  if tok == "" {
    return Err(pb.failed("--token needs a member token: paste it after --token, or pass --token - and pipe it in"))
  }
  let body = match ctx.get_as("/api/lll/access", tok) {
    Ok(b) => b,
    Err(e) => {
      let status = e.status
      if status == 401 || status == 403 {
        return Err(pb.fail(
          pb.ErrorKind.Auth,
          "the server did not accept that token as a member token (expired, revoked, mistyped, or an administrator token); get a fresh one from the board's /me page ('Show my CLI login') or 'lll token create NAME'",
        ))
      }
      return Err(e)
    },
  }
  let mut reply = models.AccessReply { .. }
  let decoded = json.Unmarshal(body.bytes(), &reply)
  if decoded.is_err() || reply.name == "" {
    return Err(pb.failed("the server answered, but not with a member: is --url this board's address?"))
  }
  Ok((reply.name, !reply.access().mode.writes()))
}

/// Pure. Why a login without --url must not run, or None (LLL-680). A login
/// saves its token, and the board endpoint it finds, into the home config.
/// When LLL_URL or a repo file points it at a server other than the one that
/// file's url names, those would land beside the other server's url: a token
/// and web_url for one server under a url for another.
fn login_target_conflict(target: string, home_url: string, effective_url: string) -> Option<string> {
  if target != "" { return None }
  let home = strings.TrimRight(strings.TrimSpace(home_url), "/")
  let effective = strings.TrimRight(strings.TrimSpace(effective_url), "/")
  if home == "" || same_server_url(home, effective) { return None }
  Some(
    f"this login would authenticate at {effective}, but the home config's url is {home}; saving the token there would pair it with the other server
to switch the home config to this server: lll login --url {effective} ...
to keep the home config and log in elsewhere: point LLL_CONFIG_HOME at another directory",
  )
}

/// Save a login that just authenticated: url, board endpoint, token, then
/// the team when the server leaves no choice.
fn finish_login(
  ctx: pb.Client,
  target: string,
  before_login: config.Config,
  saved_before_login: config.Config,
  board_endpoint: string,
  token: string,
  name: string,
  read_only: bool,
) -> Result<(), pb.CliError> {
  // The home config, never the repo's: .lll.toml is committed (TASK-168) and
  // a token must not travel with it. The value is written here and printed
  // nowhere — even success output names the member and the file, not the key.
  if target != "" {
    let url_path = set_home_key(ctx.settings, "url", target)?
    fmt.Println(f"url = \"{target}\" in {url_path}")
  }
  let authenticated_url = if target != "" { target } else { before_login.url }
  let previous_url = if saved_before_login.url != "" { saved_before_login.url } else { before_login.url }
  if strings.TrimRight(authenticated_url, "/") != strings.TrimRight(previous_url, "/") && board_endpoint == "" {
    let _ = clear_home_key(ctx.settings, "web_url")?
  }
  if board_endpoint != "" {
    let _ = set_home_key(ctx.settings, "web_url", board_endpoint)?
  } else {
    // Re-read: the url and web_url lines above may have just changed.
    let cfg = ctx.settings.reload().config().map_err(pb.failed)?
    if cfg.web_url == "" {
      let discovery_base = if target != "" { target } else { cfg.url }
      if let Some(endpoint) = discover_board_url(discovery_base) {
        let _ = set_home_key(ctx.settings, "web_url", endpoint)?
        fmt.Println(f"board endpoint discovered: {endpoint}")
      }
    }
  }
  let path = set_home_key(ctx.settings, "token", token)?
  fmt.Println(f"logged in as {name}")
  fmt.Println(f"token saved to {path}")
  if ctx.settings.env.token != "" {
    fmt.Println(
      "note: LLL_TOKEN is set in this shell and overrides the saved token until it is unset",
    )
  }
  // A team is what 'issue create' asks for next, and every usability run hit
  // it as a fresh dead end several commands after logging in. When the server
  // leaves no choice — exactly one team — settle it here so the machine is
  // actually set up when this command says it is.
  //
  // The HOME config, not the repo's .lll.toml: that file is committed and
  // belongs to 'lll attach'. Config layers rather than shadows (TASK-179), so
  // a home 'team' is a machine-wide default that any attached repo overrides
  // — which is what the layering documents it for.
  // Both on the configuration as this login just saved it: the new token
  // is the one the team lookup must send.
  settle_team(pb.Client.new(ctx.settings.reload()), read_only)
  let saved_cfg = ctx.settings.reload().config().map_err(pb.failed)?
  if saved_cfg.web_url == "" {
    fmt.Println("board endpoint: run 'lll config set web_url URL' with the board address supplied by your deployer")
  }
  Ok(())
}

/// Settle a team on the home config when there is nothing to decide, and say
/// what to run when there is. Never an error: the login itself succeeded, and
/// a server that cannot answer about teams does not un-log-you-in.
fn settle_team(ctx: pb.Client, read_only: bool) {
  // A read-only member's first write answers 403, so its ready line names a
  // read (LLL-648).
  let ready = if read_only {
    "ready (read-only): lll issue list"
  } else {
    "ready: lll issue create \"a title\""
  }
  let Ok(cfg) = ctx.settings.config() else { return }
  let teams = match records.list_teams(ctx) {
    Ok(teams) => teams,
    Err(e) => {
      fmt.Println(f"authenticated, but could not verify team setup: {e.message}\nnext: lll team list, then lll attach --key KEY")
      return
    },
  }
  if cfg.team != "" {
    match teams.items.find(|t| t.key == cfg.team) {
      Some(team) => {
        if team.archived {
          fmt.Println(f"authenticated, but team {cfg.team} is archived; run 'lll team unarchive {cfg.team}' to restore it, or attach to another team")
        } else {
          fmt.Println(f"team {cfg.team}: {ready}")
        }
      },
      None => fmt.Println(f"authenticated, but team {cfg.team} is missing on this server. Check 'lll team list --archived' and reattach with 'lll attach --key EXISTING_KEY'. Only if you intend a new team, run 'lll attach --key {cfg.team}'."),
    }
    return
  }
  let live = teams.items.filter(|t| !t.archived)
  if live.length() == 1 {
    let key = live[0].key
    let Ok(path) = set_home_key(ctx.settings, "team", key) else {
      fmt.Println(f"next: lll attach --key {key} (the only team you can see)")
      return
    }
    // "you can see": a team-scoped member is shown only its teams, so "the
    // server's only team" was false for it (verification fleet, LLL-552).
    fmt.Println(f"team = \"{key}\" in {path} (the only team you can see)")
    fmt.Println(ready)
    fmt.Println("in a shared repo, 'lll attach' writes .lll.toml; commit that file with Git if clones should inherit the team")
    return
  }
  if live.length() > 1 {
    let keys = live.map(|t| t.key).join(", ")
    fmt.Println(f"next: lll attach --key KEY (the server has {live.length()} teams: {keys})")
    return
  }
  fmt.Println("next: lll attach --key KEY (the server has no teams yet; this creates one)")
}

/// The "you are not set up yet" block for `lll --help`, or "" once a token is
/// configured. Two thirds of a fifty-agent onboarding run opened with `lll`,
/// `lll --help` or `lll --version` rather than a real command, so they never
/// saw the refusal that carries the setup recipe. Help is where they looked;
/// the recipe belongs there too.
pub fn setup_hint(ctx: pb.Client) -> string {
  let Ok((cfg, src)) = ctx.settings.traced() else { return "" }
  if cfg.token != "" { return "" }
  // A defaulted url is not an answer, it is the absence of one. Printing it
  // into a runnable line is the same mistake three usability rounds caught in
  // the not-logged-in refusal: it reads as discovered fact and pastes into a
  // failure against a server nobody named.
  let url = if src.url == "default" { "<your server url>" } else { cfg.url }
  f"
Not set up on a server yet: nothing here holds a login token.
  lll login --url {url} --email <your email> --password <pw>
No account on it, but you hold the server's admin credentials?
  lll login --url {url} --email <your email> --create --password <pick one> \\
    --admin-email <admin email> --admin-password <admin password>
Someone else deployed it? Ask them for 'lll member invite <name> --email <you>'."
}

/// Provision the member `lll login --create` is about to authenticate as.
///
/// Rides the same superuser gate as 'lll member invite' and 'lll token
/// create' - --admin-email/--admin-password, the credentials 'lll up'
/// prints and a deployment sets as secrets. The password is the caller's, not
/// a generated one, because unlike invite there is nobody to hand it to: the
/// person creating this account is the person about to log into it.
///
/// `base` is --url's server when given, so --create works on a machine that
/// has never been configured: the client it runs on is pointed there.
fn create_for_login(
  ctx: pb.Client,
  name: string,
  email: string,
  password: string,
  base: string,
  admin: AdminLogin,
) -> Result<(), pb.CliError> {
  let ctx = if base != "" { ctx.with_url(base) } else { ctx }
  create_as_superuser(ctx, name, email, password, admin)
}

/// The superuser-gated half.
fn create_as_superuser(
  ctx: pb.Client,
  name: string,
  email: string,
  password: string,
  admin: AdminLogin,
) -> Result<(), pb.CliError> {
  let su = superuser_auth(ctx, admin)?
  if let Some(existing) = records.find_member_as(ctx, su, name)? {
    return Err(
      pb.failed(f"member '{name}' already exists ({existing.email}); drop --create and log in, or reset it with 'lll member set-password {name}'"),
    )
  }
  let _ = create_member_as(ctx, su, name, email, password, [], None)?
  Ok(())
}

/// What a failed login should say. PocketBase answers the same 400 for "no
/// such account" and "wrong password", and the raw body says only "Failed to
/// authenticate" — three usability runs read it as a password problem when
/// the account had never existed, and none of them found 'member invite' or
/// --create from it. Both branches are named here because the server does not
/// tell us which one it is.
fn login_failed(ctx: pb.Client, e: pb.CliError, email: string, target: string, admin_email: string) -> pb.CliError {
  let status = e.status
  // A 403 whose body is a PocketBase envelope is the server refusing this
  // identity by name — a bot member at a password door (LLL-407) — and its
  // own wording is the answer. A bare 403 (or any other non-400) keeps the
  // raw detail: unexpected statuses are diagnostics, not prose.
  if status == 403 {
    let presented = pb.display_error(e)
    if presented.details == "" {
      let base = if target != "" {
        target
      } else {
        ctx.url().unwrap_or("the configured server")
      }
      return pb.failed(f"login failed at {base}: {presented.summary}")
    }
  }
  if status != 400 {
    return e.with_message(f"login failed: {e.message}")
  }
  // The server is named on every failure (TASK-203 AC#4): "wrong password"
  // against the wrong host is the transcript that rule exists for, and it is
  // exactly the shape of the 400 being rewritten here.
  let base = if target != "" {
    target
  } else {
    ctx.url().unwrap_or("the configured server")
  }
  let url_flag = if target == "" { "" } else { f" --url {target}" }
  // 29 of 50 agents in the fleet run wasted a command putting the ADMIN email
  // in --email, and this message is why: it recommended --create with
  // whatever address had just failed, the admin's included. The guard in
  // login() then refused it — catching a mistake this text had handed them.
  // A superuser is not a member, so say that instead of the generic advice.
  if email == admin_email && email != "" {
    return pb.failed(f"login failed at {base}: {email} is the server's admin identity, not a member
'lll login' authenticates MEMBERS; the superuser has no board account to log into.
log in as yourself, and let the admin credentials create that account:
  lll login{url_flag} --email <your own address> --create --password <pick one>
they ride the environment (LLL_ADMIN_EMAIL/LLL_ADMIN_PASSWORD) or the flags
--admin-email/--admin-password.")
  }
  pb.fail(pb.ErrorKind.Auth, f"login failed at {base}: no member with email {email}, or the password is wrong
if the account exists, check the password; a superuser can reset it:
  lll member set-password <name> --email {email}
if it does not exist yet, and you hold the server's admin credentials
(LLL_ADMIN_EMAIL/LLL_ADMIN_PASSWORD), create it as you log in:
  lll login{url_flag} --email {email} --create")
}

/// Renew a `lll login` token in the home config before it lapses (LLL-441).
/// The token says refreshable: true, but nothing used to call auth-refresh,
/// so five days after login every agent session holding one stopped mid-work.
///
/// Only the home config's token is rewritten: an LLL_TOKEN is not ours to
/// persist, and a repo file must never hold a token. No request is made
/// unless the token's own payload says it is inside the refresh window. A
/// failed refresh leaves the command to run on the old token and says why.
///
/// Returns the settings the command runs with: re-resolved after a renewal,
/// so the command sends the token it just saved.
pub fn renew_login_token(settings: config.Settings) -> config.Settings {
  let Ok((cfg, src)) = settings.traced() else { return settings }
  let Ok(home) = settings.home_path() else { return settings }
  let Ok(saved) = settings.load_home() else { return settings }
  // The url compared and the token sent must come from one read of the home
  // file: a login rewriting it between the two reads would otherwise pair
  // the old token with the new url.
  if saved.token != cfg.token { return settings }
  if !renews_home_login(src, home, saved.url, cfg.url) { return settings }
  if !pb.token_needs_refresh(cfg.token, time.Now().Unix() as int) { return settings }
  match pb.refresh_token(cfg.url, cfg.token) {
    Ok(fresh) => {
      if let Err(e) = set_home_key(settings, "token", fresh) {
        fmt.Fprintln(os.Stderr, f"note: could not save the renewed login token: {e.message}")
        return settings
      }
      settings.reload()
    },
    Err(e) => {
      fmt.Fprintln(os.Stderr, f"note: could not renew the login token in {home}: {e.message}")
      settings
    },
  }
}

/// Whether the effective token comes from the home config at `home` and the
/// effective `url` is exactly the home config's url, whatever set it (or the
/// url is the default and the home config names none). The refresh request
/// carries the token, so it must go to the server that issued it: an LLL_URL
/// or a repo url naming any other server would send the saved login there,
/// and the answer would be written back as the login. LLL-653: automation
/// that sets LLL_URL to the home url on every call still renews.
///
/// The comparison is byte-exact on purpose. Normalising (a trailing slash,
/// case, localhost for 127.0.0.1) could only widen the set of urls that
/// receive the token; a near-miss skips one renewal, which is the safe way
/// to be wrong.
fn renews_home_login(src: config.Sources, home: string, home_url: string, url: string) -> bool {
  if src.token != f"file:{home}" { return false }
  if home_url == "" { return src.url == "default" }
  url == home_url
}

/// Dispatch `lll logout`: forget the token the home config holds. Env vars
/// and the repo file are not ours to touch, and nothing else gets unset.
pub fn logout(ctx: pb.Client, args: Slice<string>) -> Result<(), pb.CliError> {
  if let Some(verb) = args.get(2) {
    if verb == "--help" || verb == "-h" {
      print_logout_usage()
      return Ok(())
    }
    return Err(flags.usage_error(f"unknown logout command: '{verb}' (see 'lll logout --help')"))
  }
  let path = ctx.settings.home_path().map_err(pb.failed)?
  let cleared = clear_home_key(ctx.settings, "token")?
  if cleared {
    fmt.Println(f"token cleared from {path}")
  } else {
    fmt.Println(f"no token in {path}; nothing to clear")
  }
  Ok(())
}

/// A password, prompted with `prompt`. With echo off when stdin is a terminal
/// — term.ReadPassword, so it never lands in scrollback; as a plain line
/// otherwise, because piped input (scripts, agents, e2e) has nothing to hide
/// it from. The newline is not part of the password on either path. Shared
/// with `lll member set-password`, which prompts twice.
fn read_password(input: mut Ref<bufio.Reader>, prompt: string) -> Result<string, pb.CliError> {
  fmt.Print(prompt)
  let fd = os.Stdin.Fd() as int
  if term.IsTerminal(fd) {
    let bytes = match term.ReadPassword(fd) {
      Ok(b) => b,
      Err(e) => return Err(pb.failed(f"reading the password: {e}")),
    }
    fmt.Println("")
    return Ok(bytes as string)
  }
  let line = read_line(input)?
  fmt.Println("")
  Ok(line)
}

/// One line from stdin, EOL stripped. Partial.Both (data, then EOF with no
/// newline) is an answer too — `printf 'pw' | lll login` ships one.
fn read_line(input: mut Ref<bufio.Reader>) -> Result<string, pb.CliError> {
  let newline = 10 as byte
  match input.ReadString(newline) {
    Partial.Ok(line) => Ok(strip_eol(line)),
    Partial.Both(line, _) => Ok(strip_eol(line)),
    Partial.Err(_) => Err(pb.failed("no answer on stdin")),
  }
}

/// The line ReadString returned, without its end-of-line — "\n" as piped, or
/// "\r\n" when the source writes Windows endings.
fn strip_eol(line: string) -> string {
  let line = strings.TrimSuffix(line, "\n")
  strings.TrimSuffix(line, "\r")
}

fn print_login_usage() {
  fmt.Println(
    "lll login - authenticate as a member

Usage:
  " +
    flags.usage("lll login", login_spec(), "") +
    "

Prompts for the email (unless --email) and the password (unless
--password), reading it with echo off when stdin is a terminal; piped
input is read as a plain line. --password is what scripts, CI and agents use. On success
the auth token is stored in ~/.config/lll/lll.toml, never in the
repo's shareable .lll.toml, and every later lll call rides it.
An LLL_TOKEN in the environment still wins (see 'lll config list').

--url is the fresh-machine setup: it authenticates against that server and
persists url next to the token, so

  lll login --url https://tracker.example.com --email you@example.com

authenticates this machine. Without --url, login uses the configured API URL.
When no board endpoint is configured, login discovers and saves it if the
server advertises one. Discovery is optional: an unavailable advertisement
does not fail login. Existing explicit settings take precedence. Supply
--web-url URL to save a specific board endpoint, including one hosted at a
different address, or use 'lll config set web_url URL'. Login reports any
remaining setup, such as a missing team or board endpoint. 'lll attach'
writes the team to the directory's .lll.toml.

--token logs in with a member token instead of an email and password: the
one the board's /me page ('Show my CLI login') shows a member who joined by invite link,
or one from 'lll token create NAME'. --token - prompts for it with echo off
(or reads one line from a pipe), which keeps it out of shell history:

  lll login --url https://tracker.example.com --token -

On the machine running a loopback 'lll up', no login is needed: the boot logs
the CLI in as the board's member when no token is configured.

No account on the server yet? If you hold the admin credentials
(LLL_ADMIN_EMAIL/LLL_ADMIN_PASSWORD as a deployment sets them; an 'lll up'
without them uses admin@local.dev with a generated password, kept in the data
directory's .lll-admin.json, which its banner names), --create makes the member and logs into it in one
command:

  lll login --url https://tracker.example.com --email you@example.com --create \\
    --password <pick one>

The member is named after the part of the email before @ unless --name says
otherwise, and the password is the one you will log in with from then on --
not the admin password.

Otherwise ask whoever deployed the server for an account; they run
'lll member invite <name> --email <you>' and send you what it prints. An
existing account whose password is lost is reset by a superuser with
'lll member set-password <name>'. To change your own password, run
'lll member set-password <your name> --old-password <current>'.

'lll logout' clears the token again.",
  )
}

fn print_logout_usage() {
  fmt.Println(
    "lll logout - clear the stored token

Usage:
  lll logout

Removes token = \"...\" from ~/.config/lll/lll.toml (the file 'lll login'
wrote) and unsets nothing else. An LLL_TOKEN in the environment is not
affected: unset it in the shell that has it.",
  )
}

/// Render a literal argument for the recovery command, including display names.
fn cli_argument(value: string) -> string {
  flags.shell_argument(value)
}
