import "go:crypto/hmac"
import "go:crypto/rand"
import "go:crypto/sha256"
import "go:crypto/subtle"
import "go:encoding/hex"
import "go:encoding/json"
import "go:html"
import "go:net/http"
import "go:net/url"
import "go:strings"

import "pb"
import "records"
import "config"

// The board gate (TASK-182): every route the board serves — pages, POSTs,
// /events, /static — answers only requests that carry the board token.
//
// The token is a boot-local secret, not a PocketBase credential: it admits a
// BROWSER to the board, while the board's own PocketBase identity rides the
// process token (the ADR in TASK-182's report — option (b), service identity,
// until browser sessions exist). LLL_BOARD_TOKEN sets it; otherwise one is
// generated per boot and `lll up` prints the login URL in its banner.
//
// A browser presents the token as the `lll_board` cookie, set once by
// visiting the banner's login URL; a terminal presents it as the same cookie
// or as ?board_token=… on the URL. A valid query token always wins over a
// stale cookie and refreshes it: one login per
// browser, the token stays out of URLs, history and Referer, and EventSource
// picks the cookie up automatically — the query param is only the bootstrap
// handoff, and a GET that logs in with it is redirected to the same URL
// without the token so it does not linger in the address bar.

/// The board token, resolved once per boot: the one the settings carry
/// (LLL_BOARD_TOKEN, or a --bind boot's pinned token) wins, else a fresh
/// random one. `lll up` puts the answer into the settings it hands the
/// board, so the gate's checks and the banner's login URL agree.
pub fn resolve_board_token(settings: config.Settings) -> string {
  let set = settings.board_token()
  if set != "" { return set }
  // crypto/rand.Text: 26 base32 characters, ~130 bits. A board token is
  // compared against every anonymous request that arrives, so it must not be
  // guessable.
  rand.Text()
}

/// Wrap a page handler with the gate. The gate resolves who is asking once
/// per request and hands the page that answer, with the client its reads go
/// through (LLL-658). When it says no it has already written the response:
/// a 401 page, a login redirect, or a 403 for a scoped viewer.
pub fn gated(
  ctx: pb.Client,
  page: fn(http.ResponseWriter, Ref<http.Request>, Viewing),
) -> fn(http.ResponseWriter, Ref<http.Request>) {
  |w: http.ResponseWriter, r: Ref<http.Request>| {
    let Some(viewer) = admit(ctx, w, r) else { return }
    if let Some(v) = viewing(ctx, w, viewer) { page(w, r, v) }
  }
}

/// The viewer this request may proceed as, or None when the response is
/// already written: a 401 page naming how to get in, a 403 for a route a
/// scoped viewer does not get, or (a GET that logged in with the query
/// param) the 303 that hands the browser its cookie and cleans the token out
/// of the address bar.
///
/// Resolution order (LLL-545): the board token, then a team-scoped link
/// ("KEY.MAC"), then a member's own token. Anything else is refused. A
/// member token costs one /api/lll/access round trip here, and nothing
/// later in the request asks again.
fn admit(ctx: pb.Client, w: http.ResponseWriter, r: Ref<http.Request>) -> Option<Viewer> {
  let want = ctx.settings.board_token()
  let mut cookie = ""
  if let Some(c) = cookie_named(r, "lll_board") { cookie = c }
  let query = query_param(r, "board_token")
  // A VALID credential admits, wherever it lives. The cookie is only ever a
  // convenience copy of the token, so a stale one must never veto a fresh
  // ?board_token= link (TASK-202: rotated tokens locked out every saved
  // cookie until the browser was cleared).
  if is_board_token(query, want) {
    if r.Method == "GET" {
      set_board_cookie(w, want, 7 * 24 * 3600)
      http.Redirect(w, r, without_board_token(r), 303)
      return None
    }
    return Some(Viewer.Full)
  }
  if is_board_token(cookie, want) {
    // An already signed-in browser may reopen an old login link. Strip its
    // token too, before page rendering can preserve it in a saved view.
    if r.Method == "GET" && query != "" {
      http.Redirect(w, r, without_board_token(r), 303)
      return None
    }
    return Some(Viewer.Full)
  }
  // A team-scoped link or a member token logs in the same way, then answers
  // only for its teams. A member's cookie lasts a year (the join contract);
  // revoking it is deleting or narrowing the member, read on every request.
  if query != "" {
    if let Some(login) = cookie_viewer(ctx, query, want) {
      if r.Method != "GET" {
        refused(w, r)
        return None
      }
      // Login CSRF (LLL-545 review): Lax cookies ride cross-site GETs, so a
      // link from any page could swap a signed-in browser onto another
      // member and collect its writes. A query login never replaces a
      // cookie that still resolves to a viewer: the browser stays who it is.
      if cookie != query && cookie_viewer(ctx, cookie, want).is_some() {
        http.Redirect(w, r, without_board_token(r), 303)
        return None
      }
      // A link sets a cookie only on positive evidence that this browser's
      // user opened it: Sec-Fetch-Site "none" (typed, pasted, bookmarked)
      // or "same-origin". Anything else, including no header at all, which
      // is what browsers send to a plain-HTTP LAN or Tailscale board, gets
      // a confirm page whose same-origin POST to /login sets the cookie.
      if !direct_navigation(r) {
        confirm_login(w, r, query, login_identity(login))
        return None
      }
      let age = if login.member.is_none() { 7 * 24 * 3600 } else { 365 * 24 * 3600 }
      set_board_cookie(w, query, age)
      http.Redirect(w, r, without_board_token(r), 303)
      return None
    }
  }
  let Some(viewer) = cookie_viewer(ctx, cookie, want) else {
    refused(w, r)
    return None
  }
  if r.Method == "GET" && query != "" {
    http.Redirect(w, r, without_board_token(r), 303)
    return None
  }
  if !admit_scoped(w, r, viewer) { return None }
  Some(Viewer.Scoped(viewer))
}

/// True when the gate admits the request: for /static, which reads nothing,
/// so a team link's reader is not minted for it.
pub fn admitted(ctx: pb.Client, w: http.ResponseWriter, r: Ref<http.Request>) -> bool {
  admit(ctx, w, r).is_some()
}

/// True when the browser says the user opened this URL directly or from the
/// board itself. Browsers send Sec-Fetch-Site only to trustworthy origins,
/// so a missing header is not evidence of anything.
fn direct_navigation(r: Ref<http.Request>) -> bool {
  let site = r.Header.map_or("", |h| h.Get("Sec-Fetch-Site"))
  site == "none" || site == "same-origin"
}

/// Who a sign-in link would make this browser, in words for the confirm
/// page, so someone who opened another person's link can notice.
fn login_identity(v: ScopedViewer) -> string {
  let Some(m) = v.member else { return f"a read-only viewer of team {v.teams.get(0).unwrap_or("")}" }
  let mode = if m.rw { "read-write" } else { "read-only" }
  let teams = if v.teams.is_empty() { "no teams" } else { strings.Join(v.teams, ", ") }
  f"{m.name} ({mode}, {teams})"
}

/// The sign-in confirm page for a link that arrived without positive
/// evidence. It sets nothing: its button POSTs the token to /login, which
/// checks Origin, so a page on another site cannot complete it.
fn confirm_login(w: http.ResponseWriter, r: Ref<http.Request>, tok: string, who: string) {
  w.Header().Set("Content-Type", "text/html; charset=utf-8")
  w.Header().Set("Cache-Control", "no-store")
  // same-origin, not no-referrer: the token in this URL stays off every
  // other origin, and the form's POST carries a real Origin. Under
  // no-referrer browsers send `Origin: null`, which /login refuses.
  w.Header().Set("Referrer-Policy", "same-origin")
  w.Header().Set("Content-Security-Policy", "frame-ancestors 'none'")
  w.Header().Set("X-Frame-Options", "DENY")
  let token = html.EscapeString(tok)
  let next = html.EscapeString(without_board_token(r))
  let page = f"<!doctype html>
<html lang='en'>
<head><meta charset='utf-8'><meta name='viewport' content='width=device-width, initial-scale=1'><title>lll board: sign in</title></head>
<body style='font-family: ui-sans-serif, system-ui, sans-serif; max-width: 42rem; margin: 4rem auto; padding: 0 1rem; color: #1c1c1e; line-height: 1.5;'>
<h1 style='font-size: 1.4rem;'>Sign in to this board?</h1>
<p>This link signs this browser in to the lll board as <strong>{html.EscapeString(who)}</strong>. Continue only if you opened it yourself and that is you.</p>
<form method='post' action='/login'>
<input type='hidden' name='board_token' value='{token}'>
<input type='hidden' name='next' value='{next}'>
<button type='submit' style='padding: .55rem 1rem; font: inherit; border: 1px solid #1c1c1e; border-radius: .35rem; background: #1c1c1e; color: #fff; cursor: pointer;'>Sign in</button>
</form>
</body>
</html>
"
  let _ = w.Write(page.bytes())
}

/// POST /login: the confirm page's sign-in. Ungated; it is its own gate.
/// Origin must name this board's own host (browsers send Origin on POSTs,
/// plain HTTP included), so only the board's own page can set a cookie
/// here. The cookie-replace rule holds: a scoped login never replaces a
/// cookie that still resolves to a viewer.
pub fn board_login(ctx: pb.Client, w: http.ResponseWriter, r: Ref<http.Request>) {
  let mut rc = r.Clone(r.Context())
  if !same_origin_post(rc) {
    http.Error(w, "sign-in must come from this board's own page; open the link again", 403)
    return
  }
  let tok = rc.PostFormValue("board_token")
  let next = local_path(rc.PostFormValue("next"))
  let want = ctx.settings.board_token()
  let cookie = cookie_named(rc, "lll_board").unwrap_or("")
  if is_board_token(tok, want) {
    set_board_cookie(w, tok, 7 * 24 * 3600)
    http.Redirect(w, rc, next, 303)
    return
  }
  let age = if team_scope(tok, want).is_some() {
    7 * 24 * 3600
  } else if member_viewer(ctx, tok).is_some() {
    365 * 24 * 3600
  } else {
    refused(w, rc)
    return
  }
  let signed_in = is_board_token(cookie, want) || cookie_viewer(ctx, cookie, want).is_some()
  if cookie == tok || !signed_in { set_board_cookie(w, tok, age) }
  http.Redirect(w, rc, next, 303)
}

/// The board's cross-origin guard (LLL-630): every request that is not a
/// GET or HEAD must name the board itself as its Origin, or it is refused
/// with 403 before any route, gate or handler sees it. It wraps the whole
/// router, so a route added later is covered without opting in.
///
/// The lll_board cookie is SameSite=Lax, which stops only cross-SITE
/// requests. Another port on the same host (127.0.0.1:9999, beside the
/// default `lll up` bind) or a sibling subdomain is the same site, so a
/// page it serves could otherwise POST to the board with the viewer's
/// cookie. Sec-Fetch-Site "same-site" is therefore refused too.
///
/// A request with no Origin is refused, although Go's
/// CrossOriginProtection would pass it as a non-browser client: board
/// writes are a browser surface, browsers always send Origin on them, and
/// scripts and the CLI use /api/ instead.
///
/// The one exemption is the route matched by /api/, the PocketBase API.
/// It authenticates by an Authorization header, never a cookie, so another
/// page cannot borrow the viewer's credential there.
pub fn same_origin_writes(mux: Ref<http.ServeMux>) -> http.Handler {
  http.HandlerFunc(|w: http.ResponseWriter, r: Ref<http.Request>| {
    let mut rc = r.Clone(r.Context())
    let safe = r.Method == "GET" || r.Method == "HEAD"
    if !safe && !api_route(mux, rc) && !same_origin_post(r) {
      http.Error(w, foreign_origin(), 403)
      return
    }
    mux.ServeHTTP(w, rc)
  })
}

fn foreign_origin() -> string {
  "this board accepts changes only from its own pages (the request's Origin is not this board); reload the board and try again"
}

/// True when the router sends this request to the /api/ reverse proxy.
/// Asked of the router itself, not of the path's prefix, so an unclean path
/// such as /api/../state is judged by where it actually lands.
fn api_route(mux: Ref<http.ServeMux>, r: Ref<http.Request>) -> bool {
  let (_, pattern) = mux.Handler(r)
  pattern == "/api/"
}

/// True when the POST's Origin is exactly this request's own host over http
/// or https, and the browser does not call it cross-origin. A browser
/// serializes Origin as scheme://host[:port] with nothing after it, so any
/// other spelling (a path, a trailing slash, userinfo) is refused.
fn same_origin_post(r: Ref<http.Request>) -> bool {
  let origin = r.Header.map_or("", |h| h.Get("Origin"))
  let site = r.Header.map_or("", |h| h.Get("Sec-Fetch-Site"))
  if site != "" && site != "same-origin" { return false }
  r.Host != "" &&
  (origin == "http://" + r.Host || origin == "https://" + r.Host)
}

/// A redirect target that stays on this board: a path, never another host.
fn local_path(next: string) -> string {
  if !strings.HasPrefix(next, "/") || strings.HasPrefix(next, "//") || strings.Contains(next, "\\") {
    return "/"
  }
  // Control bytes and DEL: browsers strip tab and newline from URLs, so
  // "/\t/evil.example" would become "//evil.example".
  if strings.IndexFunc(next, |c: rune| c < 0x20 || c == 0x7f).is_some() { return "/" }
  next
}

fn is_board_token(tok: string, want: string) -> bool {
  want != "" && subtle.ConstantTimeCompare(tok.bytes(), want.bytes()) == 1
}

// Team-scoped viewers (LLL-545). Two credentials scope the board:
//
// - A team-scoped link (`lll member invite --team`): the token is "KEY.MAC",
//   where MAC is an HMAC of the key under the board token, so the server
//   stores nothing and rotating the board token revokes every link with it.
//   It opens one team, read-only.
// - A member's own PocketBase token in the cookie (what /join sets): it opens
//   the member's EFFECTIVE teams, read from the server on every request, and
//   writes only when the member is read-write.
//
// The board READS as its viewer (LLL-658): every page, raw view, search and
// live fragment is fetched with the viewer's own credential, so PocketBase's
// collection rules (and gopb) decide what a scoped viewer sees, and records
// it may not see never arrive. A member reads with its own token; a team
// link reads as that team's link viewer, a server-side read-only identity
// (gopb/link_viewers.go); the board token reads as the board's own member,
// which sees every team. A member viewer's WRITES run with its own token too
// (pb.Caller.Member), so PocketBase checks its teams and mode and records it
// as the author.
//
// The allowlist below decides which ROUTES a scoped viewer gets (settings and
// the workspace-wide rows stay closed, a read-only login never writes). It
// filters no data: a hidden team or issue answers 404 because the viewer's
// own read of it finds nothing.

/// One request's viewer, resolved once by the gate and passed down
/// (LLL-658). `reads` is the client every read for this request goes
/// through: the viewer's own credential, never the board's for a scoped
/// viewer.
pub struct Viewing {
  pub viewer: Viewer,
  pub reads: pb.Client,
}

/// Who is looking at the board.
pub enum Viewer {
  /// The board token: every team; writes run as the board's member.
  Full,
  /// A team-scoped link or a member token: only its teams.
  Scoped(ScopedViewer),
}

pub struct ScopedViewer {
  /// The keys of the teams this viewer may see. Empty sees nothing: scope is
  /// explicit, and no teams never means every team.
  pub teams: Slice<string>,
  /// The member behind a member-token cookie; None for a team-scoped link,
  /// which has no identity and never writes.
  pub member: Option<ViewerMember>,
}

pub struct ViewerMember {
  pub id: string,
  pub name: string,
  /// The member's own token: the credential its writes ride.
  pub token: string,
  /// Effective read-write (a bot's within its owner's).
  pub rw: bool,
  /// Effective access to every team: such a member sees the whole roster
  /// and every page as the board token does (LLL-551).
  pub all: bool,
}

impl ScopedViewer {
  /// Whether this viewer may see the team with this key.
  pub fn sees(self, key: string) -> bool {
    self.teams.contains(records.normalize_team_key(key))
  }

  /// Whether this viewer may see the issue with this key ("ABC-12").
  pub fn sees_issue(self, issue: string) -> bool {
    self.teams.any(|key| issue_of_team(issue, key))
  }
}

/// The viewer this request's credentials name, read again: an open /events
/// stream re-checks it (LLL-626), so a credential that stopped resolving
/// since the stream opened (the member was deleted) sees nothing rather
/// than everything.
pub fn board_viewer(ctx: pb.Client, r: Ref<http.Request>) -> Viewer {
  let want = ctx.settings.board_token()
  let cookie = cookie_named(r, "lll_board").unwrap_or("")
  if is_board_token(query_param(r, "board_token"), want) || is_board_token(cookie, want) {
    return Viewer.Full
  }
  let none = ScopedViewer { teams: [], member: None }
  Viewer.Scoped(cookie_viewer(ctx, cookie, want).unwrap_or(none))
}

/// True unless this viewer sees every team: the board token, or a member
/// cookie whose effective access is every team (LLL-551). Rendering uses it
/// to drop label and project ids its reads could not expand (shown_refs).
pub fn viewer_is_scoped(v: Viewer) -> bool {
  match v {
    Viewer.Full => false,
    Viewer.Scoped(s) => !s.member.map_or(false, |m| m.all),
  }
}

/// True when this viewer may write: the board token, or a read-write member.
pub fn viewer_writes(v: Viewer) -> bool {
  match v {
    Viewer.Full => true,
    Viewer.Scoped(s) => s.member.map_or(false, |m| m.rw),
  }
}

/// The viewer with the client its reads go through, or None when a team
/// link's reader cannot be had (the response is then written: the 404 a
/// missing team gets, or a 503).
fn viewing(ctx: pb.Client, w: http.ResponseWriter, viewer: Viewer) -> Option<Viewing> {
  match reader_for(ctx, viewer) {
    Ok(reads) => Some(Viewing { viewer, reads }),
    Err(e) => {
      if pb.classify(e).status == 404 {
        let key = match viewer {
          Viewer.Scoped(v) => v.teams.get(0).unwrap_or(""),
          Viewer.Full => "",
        }
        http.Error(w, hidden_team(key), 404)
      } else {
        http.Error(w, f"this board cannot read for that link right now: {pb.plain(e)}", 503)
      }
      None
    },
  }
}

/// The client a viewer reads with (LLL-658): the board's own for the board
/// token, the member's own token for a member, and for a team link the
/// token of that team's link viewer, which gopb mints for the board's
/// member and the board keeps server-side.
pub fn reader_for(ctx: pb.Client, viewer: Viewer) -> Result<pb.Client, string> {
  let Viewer.Scoped(v) = viewer else { return Ok(ctx) }
  if let Some(m) = v.member { return Ok(ctx.reading_as(m.token)) }
  let key = records.normalize_team_key(v.teams.get(0).unwrap_or(""))
  let Ok(payload) = json.Marshal(LinkTeam { team: key }) else { return Err("encoding the team link") }
  let body = ctx.post("/api/lll/link-token", payload as string)?
  let mut reply = LinkToken { .. }
  let decoded = json.Unmarshal(body.bytes(), &reply)
  if decoded.is_err() || reply.token == "" {
    return Err("the server did not hand over the team link's reader")
  }
  Ok(ctx.reading_as(reply.token))
}

#[json]
struct LinkTeam { team: string }

#[json]
struct LinkToken { token: string }

/// A cookie that is a team-scoped link or a member token, as its viewer.
fn cookie_viewer(ctx: pb.Client, cookie: string, want: string) -> Option<ScopedViewer> {
  if let Some(key) = team_scope(cookie, want) {
    return Some(ScopedViewer { teams: [key], member: None })
  }
  member_viewer(ctx, cookie)
}

#[json]
struct AccessTeam { id: string, key: string }

#[json]
struct AccessReply { id: string, name: string, rw: bool, all: bool, teams: Slice<AccessTeam> }

/// A member token's viewer, or None when the server does not accept it.
/// PocketBase checks the token (signature, expiry, a deleted member's token
/// fails), and /api/lll/access answers the member's effective access, so a
/// bot token used as a cookie gets its owner's intersection. Only something
/// shaped like an unexpired auth JWT costs the round trip.
fn member_viewer(ctx: pb.Client, tok: string) -> Option<ScopedViewer> {
  if pb.token_subject(tok).is_none() || pb.token_expired(tok) { return None }
  let Ok(body) = ctx.get_as("/api/lll/access", tok) else { return None }
  let mut reply = AccessReply { .. }
  if json.Unmarshal(body.bytes(), &reply).is_err() { return None }
  if reply.id == "" { return None }
  Some(ScopedViewer {
    teams: reply.teams.map(|t| t.key),
    member: Some(ViewerMember { id: reply.id, name: reply.name, token: tok, rw: reply.rw, all: reply.all }),
  })
}

/// The board token for one team: what `lll member invite --team` hands out.
pub fn scoped_board_token(board_token: string, key: string) -> string {
  let mac = hmac.New(sha256.New, board_token.bytes())
  let _ = mac.Write(key.bytes())
  f"{key}.{hex.EncodeToString(mac.Sum([]))}"
}

/// The team a scoped board token opens, or None when the token is not a
/// valid scoped token for this board.
fn team_scope(token: string, board_token: string) -> Option<string> {
  if board_token == "" { return None }
  let (key, _, found) = strings.Cut(token, ".")
  if !found || key == "" { return None }
  let want = scoped_board_token(board_token, key)
  if subtle.ConstantTimeCompare(token.bytes(), want.bytes()) != 1 { return None }
  Some(key)
}

/// Admit a scoped viewer to the routes it gets. The bare root sends it to
/// its first team's board; any route outside the allowlist is a 403. Which
/// teams and issues it sees is not decided here: its pages read as the
/// viewer, so a hidden team or issue answers 404 exactly like a missing one.
fn admit_scoped(w: http.ResponseWriter, r: Ref<http.Request>, v: ScopedViewer) -> bool {
  let Some(u) = r.URL else {
    http.Error(w, "bad request", 400)
    return false
  }
  if r.Method == "GET" && u.Path == "/" {
    match v.teams.get(0) {
      Some(key) => http.Redirect(w, r, f"/t/{key}/", 303),
      None => http.Error(w, "this board login opens no teams; ask the person who invited you", 403),
    }
    return false
  }
  let writes = v.member.map_or(false, |m| m.rw)
  match scoped_route(r.Method, u.Path, writes) {
    ScopedVerdict.Open => true,
    ScopedVerdict.Closed(message) => {
      http.Error(w, message, 403)
      false
    },
  }
}

/// What the gate does with one scoped viewer's request.
pub enum ScopedVerdict {
  Open,
  /// 403: a route scoped viewers do not get (settings, workspace-wide rows,
  /// writes for a read-only viewer).
  Closed(string),
}

/// The writes a read-write member viewer may post. Each action reads its
/// issue or team with the viewer's token and writes with it; /bot (LLL-546)
/// mints a bot owned by the viewer, with the viewer's token.
fn scoped_writes() -> Slice<string> {
  [
    "/create", "/state", "/priority", "/emoji", "/title", "/project", "/assignee",
    "/labels", "/comment", "/claim", "/release", "/attachments/upload", "/attachments/remove",
    "/bot",
  ]
}

/// Whether a scoped viewer may make this request. An allowlist, so a route
/// added later stays closed to scoped viewers until someone opens it here.
pub fn scoped_route(method: string, path: string, writes: bool) -> ScopedVerdict {
  // A viewer's own page (LLL-648): it shows only this viewer's own login,
  // so read-only viewers get it too, the POST that reveals it included.
  if path == "/me" && (method == "GET" || method == "HEAD" || method == "POST") {
    return ScopedVerdict.Open
  }
  if method == "POST" && scoped_writes().contains(path) {
    if writes { return ScopedVerdict.Open }
    return ScopedVerdict.Closed("read-only board login: it can read its teams but not change them")
  }
  let closed = ScopedVerdict.Closed("this page is not open to a team-scoped board login")
  if method != "GET" { return closed }
  if strings.HasPrefix(path, "/static/") { return ScopedVerdict.Open }
  // The stream, the attachment download and the bare /issue/KEY address
  // (cards, search rows and doc links use it) each read their issue or team
  // as the viewer before answering.
  if path == "/events" || path == "/attachments/file" { return ScopedVerdict.Open }
  if let Some(bare) = strings.CutPrefix(path, "/issue/") {
    if bare != "" && !strings.Contains(bare, "/") { return ScopedVerdict.Open }
  }
  let Some(routed) = strings.CutPrefix(path, "/t/") else { return closed }
  let (_, rest, slash) = strings.Cut(routed, "/")
  if !slash || rest == "" || rest == "issues" || rest == "projects" || rest == "docs" || rest == "search" {
    return ScopedVerdict.Open
  }
  for prefix in ["issue/", "doc/"] {
    if let Some(name) = strings.CutPrefix(rest, prefix) {
      if name != "" && !strings.Contains(name, "/") { return ScopedVerdict.Open }
    }
  }
  closed
}

/// The 404 body a team that does not exist gets (routed_team's words).
fn hidden_team(key: string) -> string {
  f"no team with key '{key}' on this server; see the rail's team switcher"
}

/// True when an issue key such as "ABC-12" belongs to team "ABC". The rest
/// must be the number alone: team keys may contain hyphens, so "ABC-X-1"
/// belongs to team "ABC-X", not "ABC".
pub fn issue_of_team(issue: string, key: string) -> bool {
  let Some(number) = strings.CutPrefix(strings.ToUpper(issue), key + "-") else { return false }
  number != "" && strings.Trim(number, "0123456789") == ""
}
/// The named cookie's value, or None when absent.
fn cookie_named(r: Ref<http.Request>, name: string) -> Option<string> {
  for c in r.Cookies() {
    if c.Name == name { return Some(c.Value) }
  }
  None
}

/// One query parameter: the helper lives in serve_pages.lis; the gate shares
/// it rather than growing a second dialect.
/// Hand the browser its board cookie, `max_age` seconds long: a week for the
/// board token and team links, a year for a member's token. HttpOnly: the
/// page's scripts never need the token, so none of them can leak it.
fn set_board_cookie(w: http.ResponseWriter, tok: string, max_age: int) {
  let cookie = http.Cookie {
    Name: "lll_board",
    Value: tok,
    Path: "/",
    HttpOnly: true,
    MaxAge: max_age,
    // Stated, not inherited. Lax is what a zero SameSite already got from
    // browsers, but it is load-bearing rather than incidental: the board
    // serves POST writes (state, priority, title, attachments, and the
    // token-minting route under /settings/access), and Lax is what keeps a
    // page the user happens to be visiting from POSTing to their board on
    // 127.0.0.1 with the cookie attached. A security property should not
    // rest on a default that a browser is free to change.
    SameSite: http.SameSiteLaxMode,
    ..,
  }
  http.SetCookie(w, &cookie)
}

/// Hand the browser the saved-view cookie for one team (LLL-375): the hidden
/// columns of the browser's last view, comma-joined and query-escaped, so a
/// bare board URL paints them on the FIRST render instead of after a
/// localStorage redirect. NOT HttpOnly: the page's own Clear and
/// unhide-the-last-column handlers clear it, exactly what the old
/// localStorage key let them do. The value is query-escaped because cookie
/// values may not carry the comma the join uses; reads unescape it before
/// the slugs are re-validated. SameSite zero-fills to the default, which
/// browsers treat as Lax.
fn set_view_cookie(w: http.ResponseWriter, name: string, value: string) {
  let cookie = http.Cookie {
    Name: name,
    Value: url.QueryEscape(value),
    Path: "/",
    MaxAge: 365 * 24 * 3600,
    ..,
  }
  http.SetCookie(w, &cookie)
}

/// The request path and query with board_token stripped — the redirect
/// target after a query-param login, so the token is not re-sent on every
/// navigation or pasted into a bookmark.
fn without_board_token(r: Ref<http.Request>) -> string {
  let Some(u) = r.URL else {
    return "/"
  }
  // Query() hands out a read-only Values; clone the underlying map to get a
  // copy this function may edit.
  let mut q = (u.Query() as Map<string, Slice<string>>).clone()
  q.delete("board_token")
  let qs = (q as url.Values).Encode()
  if qs == "" { return u.Path }
  f"{u.Path}?{qs}"
}

/// The 401 page. Self-contained (inline styles, no /static — the gate refuses
/// that too), and it says how to get in: the rule-as-filter spirit — an
/// anonymous viewer is told the fix, not just refused. HTML attributes are
/// single-quoted so the lis string stays a plain multi-line literal.
///
/// The form is the whole of LLL-370 and needs no route of its own: a GET with
/// no action submits ?board_token=… to the very path the viewer was refused
/// at, which is the handoff admit() already accepts — it sets the cookie and
/// 303s back without the token. One way in, reachable by paste as well as by
/// hand-edited URL.
fn refused(w: http.ResponseWriter, r: Ref<http.Request>) {
  w.Header().Set("Content-Type", "text/html; charset=utf-8")
  w.Header().Set("Cache-Control", "no-store")
  w.WriteHeader(401)
  // Reaching here with a token in the query means that token did not match.
  // Saying so is what separates a wrong paste from a dead button.
  let wrong = if query_param(r, "board_token") == "" { "" } else {
    "<p style='margin: 1.5rem 0 0; padding: .6rem .8rem; border-left: 3px solid #b3261e; background: #fdeded; color: #7f1d1b;'>That token was not accepted. Check for a missing character or a trailing space, then paste it again.</p>"
  }
  let page = f"<!doctype html>
<html lang='en'>
<head>
<meta charset='utf-8'>
<meta name='viewport' content='width=device-width, initial-scale=1'>
<title>lll board: 401</title>
</head>
<body style='font-family: ui-sans-serif, system-ui, sans-serif; max-width: 42rem; margin: 4rem auto; padding: 0 1rem; color: #1c1c1e; line-height: 1.5;'>
<h1 style='font-size: 1.4rem;'>401: this board is gated</h1>
<p>The lll board only answers requests that carry its board token.</p>
{wrong}
<form method='get' style='margin: 1.5rem 0; display: flex; gap: .6rem; flex-wrap: wrap; align-items: flex-end;'>
<label for='board_token' style='flex: 1 1 20rem; display: flex; flex-direction: column; gap: .3rem;'>
<span>Paste your board token</span>
<input id='board_token' name='board_token' type='text' required autofocus
autocomplete='off' autocapitalize='off' autocorrect='off' spellcheck='false'
style='padding: .5rem .6rem; font: inherit; color: inherit; border: 1px solid #bbb; border-radius: .35rem;'>
</label>
<button type='submit' style='padding: .55rem 1rem; font: inherit; border: 1px solid #1c1c1e; border-radius: .35rem; background: #1c1c1e; color: #fff; cursor: pointer;'>Open the board</button>
</form>
<p>Where to find it: on the machine running <code>lll up</code>, run
<code>lll board</code>, or copy the <code>board  login</code> line from the
banner. Both print a link carrying <code>?board_token=&hellip;</code>, and
opening it hands your browser a cookie instead. The token comes from
<code>LLL_BOARD_TOKEN</code>, or <code>lll up</code> generates one each boot.
Invited? Open the invite or board link you were sent.</p>
<p style='color: #666;'>From a terminal:
<code>curl -H 'Cookie: lll_board=&lt;token&gt;' &lt;board-url&gt;</code></p>
</body>
</html>
"
  let _ = w.Write(page.bytes())
}
