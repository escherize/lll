import "go:net/http"
import "go:net/url"
import "go:strconv"
import "go:strings"

import "models"
import "pb"

pub struct SettingsDeleteVM {
  pub kind: string,
  pub id: string,
  pub name: string,
  pub used: int,
  pub changed: bool,
}

/// A review replaces the clicked row, so its impact and confirmation stay
/// beside the record. Recount on submission; stale counts require a new review.
fn settings_delete(r: mut Ref<http.Request>, team_id: string) -> Result<Option<string>, string> {
  let kind = r.PathValue("kind")
  let coll = settings_collection(kind)?
  let id = strings.TrimSpace(r.PostFormValue("id"))
  if id == "" { return Err("nothing to delete") }
  let path = f"/api/collections/{coll}/records/{url.PathEscape(id)}"
  // Account removal has its own authorization follow-up, LLL-341.
  if kind == "member" {
    let _ = pb.delete(path)?
    return Ok(None)
  }
  let (name, owner) = if kind == "label" {
    let mut label = models.Label { .. }
    pb.fetch(path, "label", &label)?
    (label.name, label.team)
  } else {
    let mut project = models.Project { .. }
    pb.fetch(path, "project", &project)?
    (project.name, project.team)
  }
  if team_id == "" || owner != team_id {
    return Err(f"the {kind} is not in this team — reload settings")
  }
  let used = entity_issue_count(kind, id)?
  let confirmed = r.PostFormValue("confirmed") == "1"
  if !confirmed || r.PostFormValue("expected") != strconv.Itoa(used) {
    let vm = SettingsDeleteVM { kind, id, name, used, changed: confirmed }
    return Ok(Some(patch_event(render("set-delete-review", vm)?)))
  }
  let _ = pb.delete(path)?
  Ok(None)
}
