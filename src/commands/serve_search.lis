import "go:net/http"
import "go:strings"

import "models"
import "query"
import "search"

// GET /search - a search over every issue in the team, served as a page or as
// the results fragment alone.

/// GET /search?q=… — a search over every issue in the team, which is the
/// whole difference from the board's search box: that one filters the cards
/// already rendered, this one asks PocketBase.
///
/// The query is the URL, so a result is shareable and an agent can curl it.
/// `?fragment=1` asks the same handler for the #search-results fragment
/// alone, as one datastar-patch-elements event: that is what the field's
/// debounced @get calls on every keystroke, and the browser rewrites its
/// address bar to the plain URL for the same q, so typing never separates
/// what is on screen from what the URL serves.
///
/// The page still opens no /events subscription: issue_broadcast sends one
/// unfiltered #board to every board-scoped client, and a server-filtered
/// list must never be a client it can reach. A one-shot answer to the page's
/// own request is not that.
/// `team` is the ROUTED team (TASK-198): /t/{team}/search resolved it before
/// this handler ran, so the search runs over that team's issues.
fn search_page(
  w: http.ResponseWriter,
  r: Ref<http.Request>,
  team: models.Team,
  me: string,
) {
  let q = strings.TrimSpace(query_param(r, "q"))
  let mut results: Slice<SearchHitVM> = []
  if q != "" {
    match search_hits(team, q) {
      Ok(hits) => results = hits,
      Err(e) => {
        http.Error(w, e, 500)
        return
      },
    }
  }
  let page = SearchVM { q, results }
  // ?raw beats ?fragment: a raw fetch is a one-shot answer, not a datastar
  // event, so it short-circuits before the fragment branch.
  if wants_raw(r) {
    write_raw(w, search_raw(page))
    return
  }
  if query_param(r, "fragment") == "1" {
    let frag = match render("search-results", page) {
      Ok(h) => h,
      Err(e) => {
        http.Error(w, e, 500)
        return
      },
    }
    w.Header().Set("Cache-Control", "no-store")
    w.Header().Set("Content-Type", "text/event-stream")
    let _ = w.Write(patch_event(frag).bytes())
    return
  }
  let vm = PageVM { rail: rail_vm("search", me, team), page }
  let html = match render("search-page", vm) {
    Ok(h) => h,
    Err(e) => {
      http.Error(w, e, 500)
      return
    },
  }
  w.Header().Set("Cache-Control", "no-store")
  w.Header().Set("Content-Type", "text/html; charset=utf-8")
  let _ = w.Write(html.bytes())
}

/// The team's issues and comments ranked for `q` by the same engine
/// `lll search` uses (LLL-96), so the page and the CLI agree on what a
/// match is and why. Docs are not on this page: it is the issue board's
/// search, and a doc hit has nowhere here to land yet.
fn search_hits(team: models.Team, q: string) -> Result<Slice<SearchHitVM>, string> {
  let issues = fetch_team_issues_where(team.id, candidate_clause(q, ["title", "description"]))?
  let comments = fetch_team_comments_where(team.id, candidate_clause(q, ["body"]))?
  // A comment's issue must be in the candidate set for the hit to have a
  // card; fetch the parents the comment filter found that the issue one did not.
  let mut have = Map.new<string, bool>()
  for i in issues { have[i.id] = true }
  let mut extra_ids: Slice<string> = []
  for c in comments { if have.get(c.issue).is_none() { have[c.issue] = true; extra_ids = extra_ids.append(c.issue) } }
  let mut all = issues
  if !extra_ids.is_empty() {
    let mut ors: Slice<string> = []
    for id in extra_ids { ors = ors.append(f"id={query.quote(id)}") }
    all = all.append(fetch_team_issues_where(team.id, "(" + strings.Join(ors, " || ") + ")")?...)
  }
  let issues = all
  let corpus = issue_documents(team.key, issues, comments)
  let mut by_key = Map.new<string, models.Issue>()
  for i in issues { by_key[f"{team.key}-{i.number}"] = i }
  let mut out: Slice<SearchHitVM> = []
  for h in search.rank(corpus, q, 50) {
    let Some(i) = by_key.get(h.group) else { continue }
    out = out.append(SearchHitVM { card: card_vm(i), snippets: h.snippets })
  }
  Ok(out)
}
