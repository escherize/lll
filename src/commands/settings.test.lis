import "go:net/http"
import "go:net/http/httptest"
import "go:strings"

import "config"
import "flags"
import "pb"
import "records"

// LLL-486: commands take their configuration as a value. These build that
// value from literals - no config file, no environment variable - and hand
// it to the command code the CLI runs.

/// A client for `url` sending `token`, scoped to `team`, from values alone.
fn test_client(url: string, token: string, team: string) -> pb.Client {
  pb.Client.new(
    config.given(
      config.Config { url, token, team, .. },
      config.Sources { url: "test", token: "test", team: "file:/test/.lll.toml", .. },
      config.Env { .. },
    ),
  )
}

/// A PocketBase stand-in whose teams collection holds `keys`, recording the
/// Authorization header of every request it answers.
fn teams_handler(keys: Slice<string>, seen: Channel<string>) -> http.HandlerFunc {
  let items = keys.map(|k| f"{{\"id\":\"id-{k}\",\"key\":\"{k}\",\"name\":\"{k}\"}}")
  let body = f"{{\"page\":1,\"perPage\":200,\"totalItems\":{keys.length()},\"totalPages\":1,\"items\":[{strings.Join(items, ",")}]}}"
  http.HandlerFunc(|w, r| {
    if let Some(h) = r.Header { let _ = seen.send(h.Get("Authorization")) }
    w.Header().Set("Content-Type", "application/json")
    let _ = w.Write(body.bytes())
  })
}

#[test]
fn a_command_reads_the_team_and_token_from_the_value_it_is_given() {
  let seen = Channel.buffered<string>(64)
  let mut server = httptest.NewServer(teams_handler(["ENG"], seen))
  defer server.Close()
  let ctx = test_client(server.URL, "tok-from-value", "ENG")
  let assert Ok(Some(team)) = records.configured_team(ctx)
  assert team.key == "ENG"
  let assert Some(auth) = seen.receive()
  assert auth == "Bearer tok-from-value"
}

#[test]
fn a_team_flag_is_named_as_the_flag_in_an_unknown_team_refusal() {
  // T7: the attribution comes from the value. With --team the refusal says
  // "(from --team)"; with the same key inherited from LLL_TEAM it says that,
  // whatever any other variable claims.
  let seen = Channel.buffered<string>(64)
  let mut server = httptest.NewServer(teams_handler([], seen))
  defer server.Close()
  let base = test_client(server.URL, "tok", "")
  let flagged = base.with_settings(base.settings.with_team("OPS"))
  let assert Err(e) = records.configured_team(flagged)
  assert e.message.contains("no team with key 'OPS' (from --team)")
  let env = config.Env { url: server.URL, token: "tok", team: "NOPE", .. }
  let inherited = pb.Client.new(config.resolve(env, config.no_overrides()))
  let assert Err(e2) = records.configured_team(inherited)
  assert e2.message.contains("no team with key 'NOPE' (from LLL_TEAM)")
}

#[test]
fn team_given_twice_is_a_usage_error() {
  let assert Err(e) = scoped_args(["lll", "issue", "list", "--team", "OPS", "--team", "ENG"])
  assert pb.exit_code(e.kind) == 2
  assert e.message.contains("--team may only be given once (got 2)")
  let assert Err(e2) = scoped_args(["lll", "issue", "list", "--team=OPS", "--team", "ENG"])
  assert e2.message.contains("--team may only be given once")
}

#[test]
fn the_team_flag_is_returned_not_applied() {
  let assert Ok((args, team)) = scoped_args(["lll", "issue", "list", "--team", "OPS", "--state", "todo"])
  assert team == Some("OPS")
  assert strings.Join(args, " ") == strings.Join(["lll", "issue", "list", "--state", "todo"], " ")
  // After `--`, a literal --team is an argument, not a selection.
  let assert Ok((rest, none)) = scoped_args(["lll", "issue", "create", "--", "--team", "X"])
  assert none.is_none()
  assert strings.Join(rest, " ") == strings.Join(["lll", "issue", "create", "--", "--team", "X"], " ")
  // Unscoped nouns keep their arguments.
  let assert Ok((same, nothing)) = scoped_args(["lll", "whoami"])
  assert nothing.is_none()
  assert strings.Join(same, " ") == strings.Join(["lll", "whoami"], " ")
}

#[test]
fn a_url_override_sends_the_same_token_to_the_named_server() {
  let seen = Channel.buffered<string>(64)
  let mut server = httptest.NewServer(teams_handler(["ENG"], seen))
  defer server.Close()
  let ctx = test_client("http://127.0.0.1:1", "tok", "ENG").with_url(server.URL)
  let assert Ok(_) = ctx.get("/api/collections/teams/records")
  let assert Some(auth) = seen.receive()
  assert auth == "Bearer tok"
}

#[test]
fn the_agent_label_comes_from_the_settings_unless_a_flag_names_one() {
  let env = config.Env { agent: "claude-1", .. }
  let ctx = pb.Client.new(config.given(config.Config { .. }, config.Sources { .. }, env))
  let spec = [flags.Flag { name: "--agent", value: true, .. }]
  let assert Ok(none) = flags.parse(spec, ["lll", "issue", "claim"], 3, false, "usage")
  let assert Ok(label) = agent_label(ctx, none)
  assert label == "claude-1"
  let assert Ok(flagged) = flags.parse(spec, ["lll", "issue", "claim", "--agent", "other"], 3, false, "usage")
  let assert Ok(chosen) = agent_label(ctx, flagged)
  assert chosen == "other"
}
