import "models"

// LLL-551, LLL-658: a page names the members its viewer's own read of the
// roster returned; any other member on a record renders as "hidden member".

fn people() -> Slice<models.Member> {
  [
    models.Member { id: "alice", name: "alice", kind: "person", scope: "teams", teams: ["t-a"], .. },
    models.Member { id: "carol", name: "carol", kind: "person", scope: "all", .. },
    models.Member { id: "abot", name: "bot-alpha", kind: "bot", scope: "teams", teams: ["t-a"], .. },
  ]
}

#[test]
fn a_rendering_hides_assignee_creator_author_owner_and_holder_outside_the_roster() {
  let shown = Roster { members: people() }
  let mut issue = models.Issue { team: "t-a", assignee: "garden", creator: "bob", .. }
  issue.expand.assignee = models.Member { id: "garden", name: "bot-garden", kind: "bot", .. }
  issue.expand.creator = models.Member { id: "bob", name: "bob", .. }
  let seen = shown.issue(issue)
  assert seen.expand.assignee.name == "hidden member" && seen.expand.assignee.kind == ""
  assert seen.expand.creator.name == "hidden member"
  assert seen.assignee == "garden"
  // An id that did not expand (what a scoped read returns) is hidden too.
  let bare = shown.issue(models.Issue { team: "t-a", assignee: "garden", .. })
  assert bare.expand.assignee.name == "hidden member"

  // A visible bot author keeps its name but not an owner outside the roster.
  let owner = models.MemberOwner { id: "bob", name: "bob" }
  let mut c = models.Comment { author: "abot", .. }
  c.expand.author = models.Member { id: "abot", name: "bot-alpha", kind: "bot", expand: Some(models.MemberExpand { owner: Some(owner) }), .. }
  let cs = shown.comment(c)
  assert cs.expand.author.name == "bot-alpha" && cs.expand.author.owner_name() == ""

  let mut held = models.Claim { member: "garden", .. }
  held.expand.member = models.Member { id: "garden", name: "bot-garden", .. }
  assert shown.claim(held).expand.member.name == "hidden member"

  // Pickers offer only the roster.
  assert shown.picks().map(|p| p.name).equals(["alice", "carol", "bot-alpha"])
  assert roster_member(shown, "bot-garden").is_err() && roster_member(shown, "carol").is_ok()
}

#[test]
fn a_full_roster_names_everyone_on_the_record() {
  let garden = models.Member { id: "garden", name: "bot-garden", kind: "bot", scope: "all", .. }
  let shown = Roster { members: people().append(garden) }
  let mut issue = models.Issue { assignee: "garden", .. }
  issue.expand.assignee = garden
  assert shown.issue(issue).expand.assignee.name == "bot-garden"
  assert shown.sees("garden") && shown.sees("")
}
