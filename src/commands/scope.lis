import "go:os"
import "flags"

/// --team selects this process's default scope. No configuration file is
/// rewritten, and explicit issue identifiers still resolve their own team.
pub fn scoped_args(args: Slice<string>) -> Result<Slice<string>, string> {
  let noun = args.get(1).unwrap_or("")
  let verb = args.get(2).unwrap_or("")
  let (start, spec) = match noun {
    "issue" => (3, issue_verb_spec(verb)),
    "project" => (3, flags.command_spec(project_commands(), verb)),
    "label" => (3, flags.command_spec(label_commands(), verb)),
    "doc" => (3, flags.command_spec(doc_commands(), verb)),
    "finding" => (3, flags.command_spec(finding_commands(), verb)),
    "watch" => (2, watch_verb_spec("")),
    _ => return Ok(args),
  }
  if args.length() < start { return Ok(args) }
  let (cleaned, team) = flags.extract_team(args, start, spec)?
  if let Some(key) = team {
    if let Err(e) = os.Setenv("LLL_TEAM", key) { return Err(f"setting command team: {e}") }
  }
  Ok(cleaned)
}
