import "flags"
import "pb"

/// --team selects this invocation's default scope. It is returned, not
/// applied: main puts it in the Settings it builds (LLL-486), so it reaches
/// every command as a value and no child process inherits it. No
/// configuration file is rewritten, and explicit issue identifiers still
/// resolve their own team. The table says which nouns are scoped.
pub fn scoped_args(args: Slice<string>) -> Result<(Slice<string>, Option<string>), pb.CliError> {
  let Some(noun) = noun_named(args.get(1).unwrap_or("")) else { return Ok((args, None)) }
  if !noun.scoped { return Ok((args, None)) }
  let (start, spec) = match noun.shape {
    flags.Shape.Single(c) => (2, c.spec),
    flags.Shape.Verbs(cmds) | flags.Shape.VerbsOr(cmds, _) => (3, flags.command_spec(cmds, args.get(2).unwrap_or(""))),
    flags.Shape.Topics => return Ok((args, None)),
  }
  if args.length() < start { return Ok((args, None)) }
  flags.extract_team(args, start, spec)
}
