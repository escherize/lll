import "go:encoding/json"
import "go:strings"
import "models"

// The web's two priority orders are derived from display.priorities() rather
// than written out, so these pin the order and the labels a reader sees.

#[test]
fn scoped_rendering_drops_other_teams_labels_and_project() {
  let mut issue = models.Issue { team: "t-a", labels: ["l-a", "l-z"], project: "p-z", .. }
  issue.expand.labels = [models.Label { id: "l-a", team: "t-a", name: "own", .. },
                         models.Label { id: "l-z", team: "t-z", name: "zlabelhidden", .. }]
  issue.expand.project = models.Project { id: "p-z", team: "t-z", name: "zprojhidden", .. }
  assert has_foreign_refs(issue)
  let seen = without_foreign_refs(issue)
  assert seen.labels.equals(["l-a"]) && seen.expand.labels.map(|l| l.name).equals(["own"])
  assert seen.project == "" && seen.expand.project.name == ""
  assert !has_foreign_refs(seen)
  // The issue's own team's project stays.
  let mut own = models.Issue { team: "t-a", project: "p-a", .. }
  own.expand.project = models.Project { id: "p-a", team: "t-a", name: "mine", .. }
  assert !has_foreign_refs(own) && without_foreign_refs(own).expand.project.name == "mine"
  // Fail closed: an id with no expanded record cannot be shown to be own.
  let bare = models.Issue { team: "t-a", labels: ["l-?"], project: "p-?", .. }
  assert has_foreign_refs(bare)
  let cleared = without_foreign_refs(bare)
  assert cleared.project == "" && cleared.labels.is_empty()
}

#[test]
fn priority_options_are_the_linear_scale_with_web_labels() {
  let opts = prio_opts()
  assert opts
    .map(|o| o.value)
    .equals(["none", "urgent", "high", "medium", "low"])
  assert opts
    .map(|o| o.label)
    .equals(["No priority", "Urgent", "High", "Medium", "Low"])
}

#[test]
fn the_filter_chooser_lists_priorities_most_urgent_first() {
  assert prios_by_urgency().equals(["urgent", "high", "medium", "low", "none"])
}

// LLL-419: snippet() gated on bytes and sliced runes. The two agree only for
// ASCII, which is all the board's own fixtures ever carried.
#[test]
fn snippet_caps_on_runes_not_bytes() {
  // 100 precomposed e-acute: 100 runes, 200 bytes. A byte gate sees 200 > 160,
  // enters the branch, and asks for 159 runes that do not exist.
  let accented = strings.Repeat("é", 100)
  assert snippet(accented) == accented

  // 60 emoji: 60 runes, 240 bytes. Same trap, further from the boundary.
  let emoji = strings.Repeat("✨", 60)
  assert snippet(emoji) == emoji
}

#[test]
fn snippet_truncates_at_160_runes_keeping_characters_whole() {
  // Past the cap it still truncates - and cuts on runes, so no character is
  // sliced in half on its way to the hover preview.
  let long = strings.Repeat("é", 200)
  assert snippet(long) == strings.Repeat("é", 159) + "…"
}

// LLL-523: the board filters projects by record id, because its fetch does
// not expand the relation; the chooser still speaks names and counts by id.
#[test]
fn the_board_project_filter_matches_by_id_and_counts_by_name() {
  let alpha = models.Issue { id: "i1", project: "p-alpha", .. }
  let loose = models.Issue { id: "i2", project: "", .. }
  let flt = BoardFilter { projects: ["p-alpha"], .. }
  assert issue_matches(alpha, flt)
  assert !issue_matches(loose, flt)
  assert issue_matches(loose, BoardFilter { .. })

  let groups = filter_groups(
    "/t/TST/",
    [alpha, loose],
    ViewQuery { project: "Alpha", .. },
    [],
    [],
    [models.Project { id: "p-alpha", name: "Alpha", .. }, models.Project { id: "p-beta", name: "Beta", .. }],
  )
  let Some(g) = groups.find(|g| g.dim == "project") else {
    assert false
    return
  }
  assert g.opts.map(|o| f"{o.value}={o.count}").equals(["Alpha=1", "Beta=0"])
  assert g.opts.map(|o| o.active).equals([true, false])
  assert g.opts.map(|o| o.href).equals(["/t/TST/", "/t/TST/?project=Alpha%2CBeta"])
}

// LLL-523 review: a ?project= value the catalogue fetch did not return (it
// fails soft to []) still gets its chip, counted 0, rather than filtering
// the board with no affordance to undo it (TASK-116).
#[test]
fn a_project_filter_keeps_its_chip_when_the_catalogue_is_missing() {
  let groups = filter_groups("/t/TST/", [], ViewQuery { project: "Alpha", .. }, [], [], [])
  let Some(g) = groups.find(|g| g.dim == "project") else {
    assert false
    return
  }
  assert g.opts.map(|o| f"{o.value}={o.count}={o.active}").equals(["Alpha=0=true"])
}

/// A comment as PocketBase answers `expand=author.owner` (LLL-610).
fn decoded_comment(record: string) -> models.Comment {
  let mut c = models.Comment { .. }
  let _ = json.Unmarshal(record.bytes(), &c)
  c
}

#[test]
fn bot_comment_shows_via_owner_only_when_the_owner_was_expanded() {
  let owned = comment_vm(decoded_comment(
    "{\"id\":\"c1\",\"author\":\"b1\",\"body\":\"hi\",\"expand\":{\"author\":{\"id\":\"b1\",\"name\":\"bot-ci\",\"kind\":\"bot\",\"owner\":\"m1\",\"expand\":{\"owner\":{\"id\":\"m1\",\"name\":\"alice\",\"email\":\"a@x.invalid\"}}}}}",
  ))
  // The owner the caller may not read: PocketBase drops it from expand.
  let hidden = comment_vm(decoded_comment(
    "{\"id\":\"c2\",\"author\":\"b1\",\"body\":\"hi\",\"expand\":{\"author\":{\"id\":\"b1\",\"name\":\"bot-ci\",\"kind\":\"bot\",\"owner\":\"m1\"}}}",
  ))
  let person = comment_vm(decoded_comment(
    "{\"id\":\"c3\",\"author\":\"m1\",\"body\":\"hi\",\"expand\":{\"author\":{\"id\":\"m1\",\"name\":\"alice\",\"kind\":\"person\"}}}",
  ))
  assert owned.via == "alice" && owned.avatar.bot
  assert hidden.via == "" && hidden.avatar.bot
  assert person.via == "" && !person.avatar.bot

  let assert Ok(html) = render("comments", CommentsVM { comments: [owned, hidden, person] })
  assert html.contains("<b>bot-ci</b> · via alice · ")
  assert strings.Count(html, "via ") == 1
  assert strings.Count(html, "title=\"bot member\"") == 2

  let raw = issue_raw(IssueVM { key: "T-1", comments: [owned, hidden, person], .. })
  assert raw.contains("- **bot-ci** [bot via alice] (")
  assert raw.contains("- **bot-ci** [bot] (")
  assert raw.contains("- **alice** (")
}
