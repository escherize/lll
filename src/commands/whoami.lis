import "records"
import "go:encoding/json"
import "go:fmt"
import "go:strings"

import "flags"
import "models"
import "pb"

// `lll whoami`: which member, server and team the CLI is acting as.

#[json]
struct WhoamiIdentity {
  id: string,
  name: string,
  // "person" or "bot" for a member; "" for an administrator (LLL-407).
  kind: string,
  email: string,
  #[json("collectionName")]
  collection: string,
  // Access (LLL-542): "all" | "teams" and "rw" | "ro". Empty on a server
  // that predates scoped members, and for administrators.
  scope: string,
  mode: string,
  expand: WhoamiExpand,
}

#[json]
struct WhoamiExpand {
  teams: Slice<models.Team>,
}

/// The access line: what this identity may see and whether it may write.
/// None when the server does not report access (older server, superuser).
/// A bot with an owner shows its access within the owner's (LLL-543), and
/// names the owner when that is narrower than the bot's own.
fn access_line(ctx: pb.Client, me: WhoamiIdentity, body: string) -> Result<Option<string>, pb.CliError> {
  let Some(own) = models.Access.parse(me.scope, [], me.mode) else { return Ok(None) }
  let own_keys = me.expand.teams.map(|t| t.key)
  let mut record = models.Member { .. }
  let decoded = json.Unmarshal(body.bytes(), &record)
  if decoded.is_err() || record.owner == "" {
    return Ok(Some(describe_access(own, own_keys)))
  }
  let (effective, cap) = records.effective_access(ctx, record)?
  let Some(owner) = cap else { return Ok(Some(describe_access(own, own_keys))) }
  let Some(eff) = effective else { return Ok(Some(describe_access(own, own_keys))) }
  // A scoped caller lists exactly the teams it can see.
  let keys = if eff.every_team() { [] } else { records.list_teams(ctx)?.items.map(|t| t.key) }
  Ok(Some(f"{describe_access(eff, keys)} (capped by its owner, {owner.name})"))
}

/// `lll whoami --json` (LLL-645): the facts the text prints, by name.
/// `access` is the text's access line, "" when the server reports none.
#[json]
struct WhoamiJson {
  id: string,
  name: string,
  email: string,
  kind: string,
  server: string,
  team: string,
  token_source: string,
  scope: string,
  mode: string,
  access: string,
}

/// The refusal for an argument `lll whoami` does not take. A `--team` here is
/// a guess about how context works (LLL-493, fleet case 05): the answer names
/// the bare invocation that DOES report context, and the house one-command
/// override for inspecting another team. Other arguments keep the short form.
fn whoami_arg_error(flag: string, args: Slice<string>) -> string {
  let refusal = f"unknown whoami argument: '{flag}' (see 'lll whoami --help')"
  if flag != "--team" && !flag.starts_with("--team=") {
    return refusal
  }
  let raw = if flag.starts_with("--team=") {
    strings.TrimPrefix(flag, "--team=")
  } else {
    args.get(3).unwrap_or("KEY")
  }
  let key = if strings.TrimSpace(raw) == "" { "KEY" } else { raw }
  f"{refusal}
'whoami' takes no flags: run it bare to see the identity, server and team this machine is acting as.
For a one-command team override, prefix your command with LLL_TEAM={flags.shell_argument(key)}.
This leaves the saved attachment unchanged (see 'lll config --help')."
}

/// `lll whoami` — the member or administrator identity, confirmed by a
/// record lookup against the server rather than read off the config.
pub fn whoami(ctx: pb.Client, args: Slice<string>) -> Result<(), pb.CliError> {
  if let Some(flag) = args.get(2) {
    if flag == "--help" || flag == "-h" {
      fmt.Println(
        "lll whoami - show which member or administrator, server and team this machine is acting as

Usage:
  lll whoami [--json]

--json prints the same facts as one JSON object.

Confirms the stored token against the server, including administrator tokens.
'lll config list' shows where each value came from; 'lll login' replaces the
token with a member session, and 'lll bot create bot-NAME' provisions a bot identity.",
      )
      return Ok(())
    }
    if flag != "--json" { return Err(flags.usage_error(whoami_arg_error(flag, args))) }
    if let Some(extra) = args.get(3) { return Err(flags.usage_error(whoami_arg_error(extra, args))) }
  }
  let json_mode = args.get(2) == Some("--json")
  let (cfg, src) = ctx.settings.traced().map_err(pb.failed)?
  // NOT auth-refresh, which this used to POST. A refresh is refused for every
  // non-refreshable token - and `lll token create` mints exactly those, the
  // whole agent credential - so `lll whoami` answered "401 Unauthorized" to
  // every agent that ever ran it, which is the first command an agent reaches
  // for when it is unsure who it is. Fleet run 3 (TASK-309) hit it. The record
  // the token names is fetched by its JWT id and collection instead, which
  // works for members and administrators. pb.get refuses an untokened call with the message that
  // names the fix, so there is no second copy of it here.
  // No token at all is its own answer, the same one every read gives; the
  // classification below is for a token that IS set but cannot be read.
  if cfg.token == "" {
    return Err(ctx.not_logged_in_message())
  }
  // Same classification the reads use, so a corrupted token gets the same
  // words here as everywhere else, instead of a third phrasing.
  let Some(id) = pb.token_subject(cfg.token) else {
    if strings.Split(cfg.token, ".").length() == 3 {
      return Err(ctx.corrupted_token_message())
    }
    return Err(pb.failed("the configured token is not an lll auth token; use 'lll login', or 'lll token create' for an agent"))
  }
  if pb.token_expired(cfg.token) {
    return Err(ctx.expired_token_message())
  }
  let collection = pb.token_collection(cfg.token).unwrap_or("members")
  let body = ctx.get(f"/api/collections/{collection}/records/{id}?expand=teams")?
  let mut me = WhoamiIdentity { .. }
  if let Err(e) = json.Unmarshal(body.bytes(), &me) {
    return Err(pb.failed(f"decoding the identity response: {e}"))
  }
  let administrator = me.collection == "_superusers"
  let name = if administrator { "superuser" } else { me.name }
  if json_mode {
    let kind = if administrator { "administrator" } else { me.kind }
    let access = access_line(ctx, me, body)?.unwrap_or("")
    return print_json(WhoamiJson {
      id: me.id, name, email: me.email, kind, server: cfg.url, team: cfg.team,
      token_source: src.token, scope: me.scope, mode: me.mode, access,
    }, "whoami")
  }
  fmt.Println(f"{name} <{me.email}>")
  fmt.Println(f"server  {cfg.url}")
  let team = if cfg.team == "" { "(none; run 'lll attach')" } else { cfg.team }
  fmt.Println(f"team    {team}")
  fmt.Println(f"token   {src.token}")
  if let Some(access) = access_line(ctx, me, body)? {
    fmt.Println(f"access  {access}")
  }
  if administrator {
    fmt.Println("Administrator tokens do not name a member. Use 'lll login' for a member session or 'lll bot create bot-NAME' for a bot identity.")
  }
  Ok(())
}
