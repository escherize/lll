import "records"
import "go:encoding/json"
import "go:fmt"
import "go:os"
import "go:strconv"
import "go:net/url"
import "go:strings"
import "go:time"

import "display"
import "models"
import "output"
import "pb"
import "query"
import "realtime"
import "flags"

/// Dispatch `lll watch` — a live event stream for a query, one line per
/// create/update/delete, filtered server-side with the same criteria as
/// `lll issue list`. Runs until interrupted (Ctrl-C).
pub fn watch_spec() -> Slice<flags.Flag> {
  flags.with_team(filter_spec(FilterUse.Watch).append([
    flags.Flag { name: "--search", value: true, hint: "q", help: "only issues whose title contains q", .. },
    flags.Flag {
      name: "--ready",
      help: "stream only the ready agenda: open issues whose\nblockers are all done, computed client-side against the ready set\nfetched at startup and refreshed from each event; an empty agenda\nkeeps the stream alive until something becomes ready",
      ..,
    },
    flags.Flag { name: "--json", help: "NDJSON: one raw server event object per line, with a\n\"topic\" field added", .. },
  ]...))
}

pub fn watch_command() -> flags.Command {
  flags.Command {
    name: "watch",
    access: flags.Access.Read,
    summary: "live event stream for a query; --ready streams the ready agenda",
    page: watch_usage(),
    spec: watch_spec(),
    run: watch,
    ..,
  }
}

fn watch(input: flags.CommandInput) -> Result<output.Output, pb.CliError> {
  streamed(watch_stream(input.ctx, input.parsed))
}

/// The stream `lll watch` writes, one line per event as it arrives, until
/// interrupted.
fn watch_stream(ctx: pb.Client, p: flags.Parsed) -> Result<(), pb.CliError> {
  let filters = filters_from(p, p.one("--search"))?
  let json_mode = p.given("--json")
  if p.given("--ready") { return watch_ready(ctx, filters, p.given("--json")) }
  // A configured team (LLL_TEAM or .lll.toml) scopes the stream by default,
  // same as `issue list`, and with it the label and project names.
  let scope = configured_scope(ctx)?

  let filter = resolve_filter_query(ctx, scope, filters)?
  let topic = realtime.topic_with_options("issues", filter, "team,assignee")?
  let ch = realtime.subscribe(ctx, [topic], realtime.DeadToken.Exit)?
  fmt.Fprintln(os.Stderr, "watch: ready (query subscription accepted)")

  // Last-seen records, keyed by record id, for rendering updates as field
  // transitions. Seeded lazily: the first sight of a record is a plain
  // "changed" line.
  let mut last = Map.new<models.IssueId, Snapshot>()
  loop {
    let Some(arrived) = ch.receive() else {
      return Ok(())
    }
    let realtime.Event.Record(ev) = arrived else { continue }
    if json_mode {
      fmt.Println(ndjson_line(ev))
      continue
    }
    let rec = issue_change(ev)?
    let stamp = time.Now().Format("15:04:05")
    let key = f"{rec.expand.team.key}-{rec.number}"
    match ev.action {
      realtime.Action.Create => {
        last[rec.id] = snapshot(rec)
        fmt.Println(f"{stamp} {key} created: {rec.title}")
      },
      realtime.Action.Delete => {
        last.delete(rec.id)
        fmt.Println(f"{stamp} {key} deleted")
      },
      realtime.Action.Update => {
        let cur = snapshot(rec)
        let mut described = false
        if let Some(prev) = last.get(rec.id) {
          let diff = issue_diff(prev, cur)
          if diff != "" {
            fmt.Println(f"{stamp} {key} update {diff}")
            described = true
          }
        }
        if !described { fmt.Println(f"{stamp} {key} changed") }
        last[rec.id] = cur
      },
      realtime.Action.Other(other) => fmt.Println(f"{stamp} {key} {other}"),
    }
  }
}

/// The issue an event on an issues subscription carries. Any other payload
/// on it fails the watch, naming why, as an undecodable one always has.
fn issue_change(ev: realtime.RecordEvent) -> Result<models.Issue, pb.CliError> {
  match ev.change {
    realtime.Change.Issue(rec) => Ok(rec),
    realtime.Change.Malformed(why) => Err(pb.failed(f"decoding realtime event: {why}")),
    _ => Err(pb.failed(f"decoding realtime event: an event on '{ev.topic}' is not an issue")),
  }
}

fn watch_usage() -> string {
  "lll watch - live event stream for a query

Usage:
  " + flags.usage("lll watch", watch_spec(), "") + "

Streams create/update/delete events for issues matching the criteria
(filtered server-side; scoped to the configured team like 'lll issue list'),
one timestamped line per event, until interrupted:

  10:42:01 ENG-12 created: Fix login flow
  10:42:07 ENG-12 update state: todo -> in-progress
  10:42:09 ENG-12 deleted

Updates are shown as field transitions (state, priority, title, assignee) by
diffing against the last event seen for that record; a record's first update
prints as 'changed'. Note: an update that moves a record out of the filter
(e.g. state todo -> done under --state todo) emits nothing: the server only
delivers events for records matching the filter after the change.

An update that changes none of those four fields prints only the key:

  10:42:11 ENG-12 changed

That covers labels, project, description and emoji. Use --json for the record.

The stream carries issue records only: no comment or claim events. A claim
shows up only when it writes the issue. Claiming an issue assigned to someone
else or to nobody assigns you, which is an update; a release that clears the
assignee is another. Claiming an issue already assigned to you, claiming one
you already hold, and 'lll issue claim --renew' print nothing.

Status lines go to stderr, never stdout, in text and --json mode alike:

  watch: ready (query subscription accepted)
  realtime: lll server stream lost; reconnecting
  realtime: reconnect failed: <error>
  realtime: reconnected to the lll server (subscriptions accepted)

'watch: ready' prints once, after the server accepts the subscription.
With --ready it reads 'watch: ready (agenda subscription accepted)'. After a
lost stream, watch retries every second and prints each distinct failure once.
The server closes a stream that has carried no event for 5 minutes, and any
stream after 30 minutes, so a quiet watch prints a lost/reconnected pair every
few minutes. The pair is routine.

Every connect and reconnect checks the token with one read. When the server
rejects it (rotated, revoked or expired), the stream could carry no events, so
watch prints one line naming the fix and exits 1:

  realtime: the server rejected this token (401 Unauthorized): ...

At startup the same refusal is the command's error. A token rotated while the
stream is up is caught at the next reconnect; on a stream with no events that
is within 5 minutes.

The stream is live-only: it delivers events from the moment the server
accepts the subscription, and a reconnect resubscribes without replaying
what changed while disconnected. A gap looks exactly like a quiet board.
If you need every change, note the time of the last event you handled and,
on start and after each reconnect, catch up with
'lll issue list --since <that time>' (see its help for overlap and limits).

With --ready, the stream shows only the ready agenda: open issues
(todo or backlog) whose blockers are all done or cancelled. Readiness is
computed client-side against a snapshot of the team's issues taken at startup
and refreshed from every event, so an issue becomes ready when its LAST open
blocker is closed (an event that arrives on the blocker, not on the blocked
issue), and that transition is announced as:

  10:43:00 ENG-12 ready: Fix login flow

An empty agenda at startup does NOT end the stream: it stays alive and
announces the first issue that becomes ready, then keeps streaming. Updates
to issues that are already ready stream as usual; events for issues that are
not ready are suppressed. With --json, a transition is an NDJSON event object
with action 'ready' and the full issue record.

" + flags.section(watch_spec())
}

/// Dispatch `lll issue watch [KEY-123]` — a live event stream for one issue
/// and its comments. Runs until interrupted or the issue is deleted.
pub fn issue_watch(input: flags.CommandInput) -> Result<(), pb.CliError> {
  let ctx = input.ctx
  let usage = "lll issue watch [KEY-123] [--until text] [--timeout seconds] [--json]"
  let p = input.parsed
  let id = p.first()
  let json_mode = p.given("--json")
  let until = p.one("--until")
  let mut timeout = 0
  if p.given("--timeout") {
    let Ok(t) = strconv.Atoi(p.one("--timeout")) else {
      return Err(flags.usage_error(f"--timeout takes seconds, got '{p.one("--timeout")}'"))
    }
    if t <= 0 { return Err(flags.usage_error("--timeout must be a positive number of seconds")) }
    if time.ParseDuration(f"{t}s").is_err() { return Err(flags.usage_error("--timeout is too large")) }
    timeout = t
  }
  if p.given("--until") && until == "" { return Err(flags.usage_error("--until requires nonempty text")) }
  if timeout > 0 && until == "" {
    return Err(flags.usage_error("--timeout only means something with --until"))
  }
  if timeout == 0 { return run_issue_watch(ctx, id, json_mode, until, usage) }

  // The CLI owns this worker's lifetime. A deadline covers reads and the
  // subscription handshake too, not just the final receive loop. Returning
  // ends the one-command process, closing its stream and pending requests.
  let completed = Channel.new<Result<(), pb.CliError>>()
  let deadline = Channel.new<bool>()
  task { let _ = completed.send(run_issue_watch(ctx, id, json_mode, until, usage)) }
  task {
    time.Sleep(time.Duration(timeout as int64) * time.Second)
    let _ = deadline.send(true)
  }
  let target = if id == "" { "the inferred issue" } else { id }
  let mut outcome: Result<(), pb.CliError> = Err(pb.failed(f"no comment containing '{until}' on {target} within {timeout}s"))
  select {
    match completed.receive() {
      Some(result) => outcome = result,
      None => (),
    },
    match deadline.receive() {
      Some(_) => (),
      None => (),
    },
  }
  outcome
}

fn run_issue_watch(ctx: pb.Client, id: string, json_mode: bool, until: string, usage: string) -> Result<(), pb.CliError> {
  let resolved = resolve_id(ctx, id, usage)?
  let issue = records.fetch_issue(ctx, resolved)?
  let key = f"{issue.expand.team.key}-{issue.number}"

  let issue_topic = realtime.topic_with_options(
    f"issues/{issue.id}",
    "",
    "team,assignee",
  )?
  // Comments are a collection-level subscription filtered server-side to
  // this issue; record ids are alphanumeric, so inlining is quote-safe.
  let comments_topic = realtime.topic_with_options(
    "comments",
    f"issue='{issue.id}'",
    "author",
  )?
  // Watch rides the operator's LLL_TOKEN and cannot re-mint anything, so a
  // rejected token ends it with the fix instead of a silent stream (LLL-617).
  let ch = realtime.subscribe(ctx, [issue_topic, comments_topic], realtime.DeadToken.Exit)?
  // Subscribe before reading the initial snapshot: comments created during
  // setup are either in this snapshot or queued on the accepted stream.
  if until != "" {
    let existing = records.fetch_comments(ctx, issue.id)?
    let mut n = 0
    for c in existing {
      n += 1
      if comment_matches_until(until, "snapshot", c.body) {
        if json_mode {
          let data = match json.Marshal(realtime.CommentEvent { action: "snapshot", record: c }) {
            Ok(data) => data as string,
            Err(e) => return Err(pb.failed(f"encoding comment snapshot: {e}")),
          }
          fmt.Println(ndjson_line(realtime.decode("comments", data)))
        } else {
          let author = display.member_name(c.author, c.expand.author.name, "anon")
          fmt.Println(f"already there: #{n} by {author}: {first_line(c.body)}")
        }
        return Ok(())
      }
    }
  }
  fmt.Fprintln(os.Stderr, f"watch: ready for {key} (issue and comment subscriptions accepted)")
  if !json_mode && until != "" {
    fmt.Println(f"Watching {key} until a comment contains '{until}'")
  } else if !json_mode {
    fmt.Println(f"Watching {key}: {issue.title}")
  }

  // The fetched issue seeds the diff, so the very first update already
  // renders as a transition.
  let mut prev = snapshot(issue)
  loop {
    let Some(arrived) = ch.receive() else { return Ok(()) }
    let realtime.Event.Record(ev) = arrived else { continue }
    let stamp = time.Now().Format("15:04:05")
    if let realtime.Change.Comment(comment) = ev.change {
      let matched = comment_matches_until(until, ev.action.wire(), comment.body)
      if json_mode {
        fmt.Println(ndjson_line(ev))
      } else if ev.action == realtime.Action.Create || matched {
        let author = display.member_name(comment.author, comment.expand.author.name, "anon")
        fmt.Println(f"{stamp} comment by {author}: {first_line(comment.body)}")
      }
      if matched { return Ok(()) }
      continue
    }
    if let realtime.Change.Malformed(why) = ev.change {
      return Err(pb.failed(f"decoding realtime event: {why}"))
    }
    let rec = issue_change(ev)?
    if json_mode {
      fmt.Println(ndjson_line(ev))
      if ev.action == realtime.Action.Delete { return Ok(()) }
      continue
    }
    match ev.action {
      realtime.Action.Delete => {
        fmt.Println(f"{stamp} {key} deleted")
        return Ok(())
      },
      realtime.Action.Update => {
        let cur = snapshot(rec)
        let diff = issue_diff(prev, cur)
        if diff == "" {
          fmt.Println(f"{stamp} changed")
        } else {
          fmt.Println(f"{stamp} {diff}")
        }
        prev = cur
      },
      other => (),
    }
  }
}

/// The narrated fields of an issue, copied out to plain scalars so cached
/// values own their data (whole records alias their slices/expand).
struct Snapshot {
  state: Option<models.IssueState>,
  priority: Option<models.Priority>,
  title: string,
  assignee: models.MemberId,
  assignee_name: string,
}

fn snapshot(issue: models.Issue) -> Snapshot {
  Snapshot { 
    state: issue.state(),
    priority: issue.priority(),
    title: issue.title,
    assignee: issue.assignee,
    assignee_name: display.member_name(issue.assignee, issue.expand.assignee.name, ""),
  }
}

/// Comma-joined transitions for the narrated fields (state, priority, title,
/// assignee); empty when none of them changed.
fn issue_diff(prev: Snapshot, cur: Snapshot) -> string {
  let mut parts: Slice<string> = []
  if prev.state != cur.state {
    parts = parts.append(f"state: {display.state_name(prev.state)} -> {display.state_name(cur.state)}")
  }
  if prev.priority != cur.priority {
    parts = parts.append(
      f"priority: {display.priority_name(prev.priority)} -> {display.priority_name(cur.priority)}",
    )
  }
  if prev.title != cur.title {
    parts = parts.append(f"title: {prev.title} -> {cur.title}")
  }
  if prev.assignee != cur.assignee {
    parts = parts.append(
      f"assignee: {assignee_display(prev)} -> {assignee_display(cur)}",
    )
  }
  strings.Join(parts, ", ")
}

fn assignee_display(snap: Snapshot) -> string {
  if snap.assignee_name == "" { "none" } else { snap.assignee_name }
}

/// The event's raw PB payload as one NDJSON line, with a "topic" field
/// spliced in after the opening brace. Topics are collection names and
/// record ids — no JSON escaping needed.
fn ndjson_line(ev: realtime.RecordEvent) -> string {
  if !ev.data.starts_with("{") { return ev.data }
  // TrimPrefix, not substring(1..length()): length() counts BYTES and substring
  // indexes RUNES, so the two agree only while the payload is pure ASCII. One
  // emoji in a record put the end bound past the last rune and panicked the
  // whole stream (LLL-417). The prefix is the single byte "{", already checked.
  // RFC3339 timestamps, like every --json output (LLL-645).
  let data = contract_json(ev.data.bytes() as json.RawMessage, 0) as string
  "{\"topic\":\"" + ev.topic + "\"," + strings.TrimPrefix(data, "{")
}

fn first_line(body: string) -> string {
  body.split("\n")[0]
}

/// One completion policy for initial snapshots, text streams and JSON streams.
fn comment_matches_until(text: string, action: string, body: string) -> bool {
  text != "" && ["snapshot", "create", "update"].contains(action) && strings.Contains(body, text)
}

/// `lll watch --ready` (LLL-395): stream the ready agenda. The readiness
/// decision is client-side (PocketBase cannot filter on an expanded
/// relation's state), against a snapshot of the team's issues taken at
/// startup and refreshed from every event that arrives. The event that makes
/// an issue ready lands on the BLOCKER (its state flips to done) — the
/// blocked issue emits nothing — so a readiness transition is announced from
/// the snapshot, not from the event's own record. An empty agenda at startup
/// does NOT exit: the stream stays alive and announces the first issue that
/// becomes ready. Events for issues that are ready keep streaming, as the
/// plain query watch does.
fn watch_ready(ctx: pb.Client, filters: query.Criteria, json_mode: bool) -> Result<(), pb.CliError> {
  let scope = configured_scope(ctx)?
  let filter = resolve_filter_query(ctx, scope, filters)?
  // blocked_by expand, so each event record carries its blockers' states.
  let topic = realtime.topic_with_options("issues", filter, "team,assignee,blocked_by")?
  let ch = realtime.subscribe(ctx, [topic], realtime.DeadToken.Exit)?
  // blocked_by expanded on every page, so readiness can be decided locally.
  let mut tail = "&expand=team,assignee,blocked_by,labels&sort=created,id"
  if filter != "" { tail = f"{tail}&filter={url.QueryEscape(filter)}" }
  let mut issues = records.fetch_all_issues(ctx, tail)?
  let mut ready = ready_keys(issues)
  fmt.Fprintln(os.Stderr, "watch: ready (agenda subscription accepted)")
  loop {
    let Some(arrived) = ch.receive() else { return Ok(()) }
    let realtime.Event.Record(ev) = arrived else { continue }
    let rec = issue_change(ev)?
    let deleted = ev.action == realtime.Action.Delete
    let mut kept: Slice<models.Issue> = []
    let mut known = false
    for i in issues {
      if i.id == rec.id {
        known = true
        if !deleted { kept = kept.append(rec) }
        continue
      }
      kept = kept.append(i)
    }
    // A create for a record the snapshot has not seen: it joins the cache
    // here, or its readiness would never be computed.
    if !known && !deleted { kept = kept.append(rec) }
    issues = kept
    let fresh = ready_keys(issues)
    let stamp = time.Now().Format("15:04:05")
    // Announce every issue the event made ready, oldest first for ties.
    let mut became: Slice<models.Issue> = []
    for issue in issues {
      if fresh.contains(issue.id) && !ready.contains(issue.id) { became = became.append(issue) }
    }
    ready = fresh
    for issue in became {
      let key = f"{issue.expand.team.key}-{issue.number}"
      if json_mode {
        // Marshaled with the topic inline: ndjson_line would splice the
        // topic in with a rune-indexed substring, which panics on any
        // multi-byte byte in the record (LLL-417).
        let data = match json.Marshal(ReadyEvent { topic: "issues", action: "ready", record: issue }) {
          Ok(data) => data as string,
          Err(e) => return Err(pb.failed(f"encoding ready event: {e}")),
        }
        fmt.Println(contract_json(data.bytes() as json.RawMessage, 0) as string)
      } else {
        fmt.Println(f"{stamp} {key} ready: {issue.title}")
      }
    }
    // Ordinary events for issues that are already ready keep flowing.
    if !deleted && ready.contains(rec.id) && !became.find(|b| b.id == rec.id).is_some() {
      if json_mode {
        fmt.Println(ndjson_line(ev))
      } else {
        let key = f"{rec.expand.team.key}-{rec.number}"
        fmt.Println(f"{stamp} {key} {ev.action.wire()}: {rec.title}")
      }
    }
  }
}

/// The ids of every issue in the cache that is ready, by is_ready: the rule
/// `issue list --ready` and `issue next` use (LLL-672). Blocker states come
/// from the cache first, which every event refreshes, so a blocker finishing
/// flips its dependents ready on the blocker's own event; then from the
/// issue's own expand, for a blocker the cache does not hold (another team's
/// issue the reader can see). A blocker in neither is hidden, and not ready.
///
/// Known limit: the subscription is filtered to the configured team, so a
/// cross-team blocker changing state sends no event, and its expanded state
/// is as old as the dependent's last event. The dependent's next event
/// catches up; `issue list --ready` sees the change at once. The same holds
/// for archiving a team: it sends no issue event, so its issues change
/// readiness on their next event.
fn ready_keys(issues: Slice<models.Issue>) -> Slice<models.IssueId> {
  // Built once per call: the cache first, so its fresher record wins.
  let mut seen = issues
  for issue in issues { seen = seen.append(issue.expand.blocked_by...) }
  let mut out: Slice<models.IssueId> = []
  for issue in issues {
    if records.is_ready(issue, seen) { out = out.append(issue.id) }
  }
  out
}

/// A ready transition as NDJSON, topic included so the line matches the
/// shape ndjson_line produces for raw PocketBase events.
#[json]
struct ReadyEvent {
  topic: string,
  action: string,
  record: models.Issue,
}
