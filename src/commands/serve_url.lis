import "go:net/http"
import "go:net/url"
import "go:strings"

// The one query-param encoding for view state, shared by the board (GET /)
// and the /issues table (TASK-94 AC#3). One param per dimension, values are
// the names and slugs the rest of lll speaks, several values in one dimension
// are comma-joined ("state=todo,done"), and parts are emitted in a fixed
// order so the same view always builds the same URL. `prio` and `hide`
// (hidden lanes) are board-only today, but they ride the same struct and the
// same encoder so /issues can never grow a second dialect.

/// View state as the URL carries it: raw, still comma-joined, unvalidated.
/// Empty means "not filtering on this dimension".
struct ViewQuery {
  state: string,
  assignee: string,
  label: string,
  prio: string,
  project: string,
  sort: string,
  hide: string,
}

/// Read the view state off a request's query string.
fn view_query(r: Ref<http.Request>) -> ViewQuery {
  let Some(u) = r.URL else {
    return ViewQuery { .. }
  }
  let q = u.Query()
  ViewQuery {
    state: q.Get("state"),
    assignee: q.Get("assignee"),
    label: q.Get("label"),
    prio: q.Get("prio"),
    project: q.Get("project"),
    sort: q.Get("sort"),
    hide: q.Get("hide"),
  }
}

/// Parse a raw query string (with or without the leading "?") into view
/// state. Unknown keys are ignored — the encoder decides what a URL can say.
/// A malformed escape is an error, which the caller turns into the flash.
fn view_query_parse_raw(raw: string) -> Result<ViewQuery, string> {
  let mut q = ViewQuery { .. }
  for pair in strings.Split(strings.TrimPrefix(raw, "?"), "&") {
    if pair == "" { continue }
    let mut key = pair
    let mut value = ""
    if let Some(i) = strings.Index(pair, "=") {
      key = pair.substring(0..i)
      value = pair.substring(i + 1..)
    }
    let v = url.QueryUnescape(value).map_err(|e| f"bad query escape: {e}")?
    match key {
      "state" => q.state = v,
      "assignee" => q.assignee = v,
      "label" => q.label = v,
      "prio" => q.prio = v,
      "project" => q.project = v,
      "sort" => q.sort = v,
      "hide" => q.hide = v,
      _ => (),
    }
  }
  Ok(q)
}

/// The canonical query string for `q`: "" or "?a=b&c=d" in the fixed order.
fn view_query_string(q: ViewQuery) -> string {
  let mut parts: Slice<string> = []
  if q.state != "" { parts = parts.append(f"state={url.QueryEscape(q.state)}") }
  if q.assignee != "" {
    parts = parts.append(f"assignee={url.QueryEscape(q.assignee)}")
  }
  if q.label != "" { parts = parts.append(f"label={url.QueryEscape(q.label)}") }
  if q.prio != "" { parts = parts.append(f"prio={url.QueryEscape(q.prio)}") }
  if q.project != "" {
    parts = parts.append(f"project={url.QueryEscape(q.project)}")
  }
  if q.sort != "" { parts = parts.append(f"sort={url.QueryEscape(q.sort)}") }
  if q.hide != "" { parts = parts.append(f"hide={url.QueryEscape(q.hide)}") }
  if parts.is_empty() { return "" }
  f"?{strings.Join(parts, "&")}"
}

/// Build a URL: the path plus the non-empty parts. An empty view state is
/// just the path.
fn view_query_href(path: string, q: ViewQuery) -> string {
  f"{path}{view_query_string(q)}"
}

/// Add `value` to — or, if it is already there, remove it from — one
/// dimension of `q`, keeping every other dimension. This one function is
/// what a filter chip, a menu entry and a Clear link are all made of: each
/// is the current URL with one value toggled.
fn view_query_toggle(q: ViewQuery, dim: string, value: string) -> ViewQuery {
  let mut nq = q
  match dim {
    "state" => { nq.state = toggle_csv(q.state, value) },
    "assignee" => { nq.assignee = toggle_csv(q.assignee, value) },
    "label" => { nq.label = toggle_csv(q.label, value) },
    "prio" => { nq.prio = toggle_csv(q.prio, value) },
    "project" => { nq.project = toggle_csv(q.project, value) },
    "hide" => { nq.hide = toggle_csv(q.hide, value) },
    _ => (),
  }
  nq
}

/// True when `value` is one of the values `dim` carries in `q`.
fn view_query_has(q: ViewQuery, dim: string, value: string) -> bool {
  csv(view_query_field(q, dim)).contains(value)
}

/// The raw comma-joined value of one dimension, for callers that read a dim
/// the toggle wrote.
fn view_query_field(q: ViewQuery, dim: string) -> string {
  match dim {
    "state" => q.state,
    "assignee" => q.assignee,
    "label" => q.label,
    "prio" => q.prio,
    "project" => q.project,
    "sort" => q.sort,
    "hide" => q.hide,
    _ => "",
  }
}

/// True when any filter dimension of `q` is set. `hide` and `sort` are
/// presentation, not filters, so they do not count.
fn view_query_filtered(q: ViewQuery) -> bool {
  q.state != "" || q.assignee != "" || q.label != "" || q.prio != "" || q.project != ""
}

/// Split a comma-joined dimension into its values. "" splits to nothing.
fn csv(value: string) -> Slice<string> {
  if value == "" { return [] }
  strings.Split(value, ",").filter(|v| v != "")
}

/// The values joined back into one comma-joined dimension.
fn join_csv(vals: Slice<string>) -> string {
  strings.Join(vals, ",")
}

/// One toggle of a comma-joined dimension: add the value, or drop it if it
/// is already there.
fn toggle_csv(list: string, value: string) -> string {
  let vals = csv(list)
  if vals.contains(value) {
    return join_csv(vals.filter(|v| v != value))
  }
  join_csv(vals.append(value))
}
