// `lll member invite` and `lll member passes`: the board link, login
// and token block a new member (or a batch of them) is handed.

fn member_invite_spec() -> Slice<flags.Flag> {
  with_admin_flags([
    flags.Flag {
      name: "--url",
      value: true,
      hint: "url",
      help: "server base url; without it the configured one (LLL_URL, 'url' in .lll.toml)",
      ..,
    },
    flags.Flag {
      name: "--email",
      alias: "-e",
      value: true,
      hint: "email",
      required: true,
      help: "the colleague's real email; it is the identity 'lll login' asks for",
      ..,
    },
    flags.Flag {
      name: "--team",
      value: true,
      hint: "KEY",
      repeat: true,
      help: "limit the colleague to this team (repeat for more): they see only its issues, and their board link opens only its board",
      ..,
    },
    flags.Flag {
      name: "--read-only",
      alias: "--ro",
      help: "they can read but not change anything (default: read-write)",
      ..,
    },
  ])
}

fn member_passes_spec() -> Slice<flags.Flag> {
  with_admin_flags([
    flags.Flag {
      name: "--count",
      value: true,
      hint: "10",
      help: "number of distinct people (1..50; default 10)",
      ..,
    },
    flags.Flag {
      name: "--prefix",
      value: true,
      hint: "hack",
      help: "name prefix for the new people (default guest)",
      ..,
    },
    flags.Flag {
      name: "--out",
      value: true,
      hint: "path",
      help: "private handoff file (default machine config directory)",
      ..,
    },
    flags.Flag {
      name: "--duration",
      value: true,
      hint: "seconds",
      help: "token lifetime (default one year)",
      ..,
    },
    flags.Flag {
      name: "--url",
      value: true,
      hint: "url",
      help: "API URL; defaults to the local board's saved URL",
      ..,
    },
  ])
}

fn member_passes_page() -> string {
  "lll member passes - make copyable credentials for a local team board

Usage:
  lll member passes [--count 10] [--prefix hack] [--out PATH]

Run after 'lll up --bind LAN_OR_TAILSCALE_IP'. Creates distinct person members
with long-lived API tokens, then writes a mode-0600 handoff file containing
each person's name, token, team, API URL, and the board login link. Share only
one person's block with that person. The browser link admits them to the board;
their personal token authenticates CLI/API calls. Browser edits currently use
the board process identity, not the person's API token. The output file is
the only copy of the minted tokens; keep it private. If the batch stops early,
the error names the partial file and the exact number completed." +
  flags.section(member_passes_spec())
}

/// `lll member invite NAME --email E` — the whole colleague handoff in one
/// command (TASK-217). It was three: member add, a superuser-env token create,
/// and a hand-written config carried by hand along with a token that expired
/// in days. Nothing here is new machinery; it is create_member and the same
/// superuser gate set-password runs, plus the part that actually got skipped —
/// telling the inviter the literal lines to paste to the colleague.
fn member_invite(input: flags.CommandInput) -> Result<(), pb.CliError> {
  let ctx = input.ctx
  let usage = input.usage
  let p = input.parsed
  let name = p.first()
  if name == "" { return Err(flags.usage_error(f"usage: {usage}")) }
  let email = strings.TrimSpace(p.one("--email"))
  if !real_email(email) {
    return Err(
      flags.usage_error(f"--email must be a real address the colleague can type into 'lll login', not '{email}'"),
    )
  }

  // --url before the gate: superuser_auth and every call under it read the
  // CONFIGURED url, so on a machine that has never been set up they went to
  // the default and answered "Failed to authenticate" for credentials that
  // were perfectly good. Four of the six usability runs lost commands to
  // exactly that, and half of them guessed LLL_URL rather than being told.
  let ctx = point_at_url(ctx, p.one("--url"))?
  // Superuser first: the create rides it, and an existing name is caught here
  // rather than as PocketBase's bare 400 on the unique index.
  let su = superuser_auth(ctx, given_admin_login(ctx.settings, p, bufio.NewReader(os.Stdin))?)?
  if let Some(existing) = records.find_member_as(ctx, su, name)? {
    return Err(
      pb.failed(f"member '{name}' already exists ({existing.email}); run 'lll member set-password {name} --email {email} --password PASSWORD' with administrator credentials to enable login; existing credentials are unchanged"),
    )
  }

  // Generated, not prompted: an invite is written down and sent, so the
  // inviter never types it, and a password nobody chose is one nobody reuses.
  // rand.Text is 26 base32 characters (~130 bits), the same source the board
  // token and create_member's throwaway use. It goes in on the create rather
  // than as a follow-up patch, so a failure leaves no member behind holding a
  // password nobody knows — the exact dead record set-password exists to fix.
  let password = rand.Text()
  let (cfg, src) = ctx.settings.traced().map_err(pb.failed)?
  let home = ctx.settings.load_home().map_err(pb.failed)?
  let own_board = board_for_server(cfg.web_url, src.web_url, cfg.url, home.url)
  let base = invite_base(p.one("--url"), cfg.url, same_server_board(own_board, su))
  let keys = p.all("--team").map(records.normalize_team_key).filter(|k| k != "")
  let mode = if p.given("--read-only") { models.Mode.ReadOnly } else { models.Mode.ReadWrite }
  if keys.is_empty() && !mode.writes() {
    return Err(flags.usage_error("--read-only needs --team KEY: say which teams they may read"))
  }
  if keys.is_empty() {
    let created = create_member_as(ctx, su, name, email, password, [], None)?
    status(f"invited {created.name} <{email}>: {describe_access(models.Access { reach: models.Reach.Every, mode: models.Mode.ReadWrite }, [])}")
    status("send them this (below, on stdout); the password is shown once and stored nowhere")
    for line in invite_lines(created.name, email, password, base, cfg.team) {
      fmt.Println(line)
    }
    return Ok(())
  }

  // A scoped invite (--team): the member record carries the scope, so the
  // collection rules keep this colleague's own token inside its teams, and
  // each board link opens only one team's board.
  let mut team_ids: Slice<models.TeamId> = []
  for key in keys {
    let Some(team) = find_team_as(ctx, su, key)? else {
      return Err(pb.failed(f"no team with key '{key}' on this server; teams: {team_keys_as(ctx, su)} (see 'lll team list')"))
    }
    team_ids = team_ids.append(team.id)
  }
  let created = create_member_as(ctx, su, name, email, password, team_ids, Some(mode))?
  status(f"invited {created.name} <{email}>: {describe_access(models.Access { reach: models.Reach.Teams(team_ids), mode }, keys)}")
  status("send them this (below, on stdout); the password is shown once and stored nowhere")
  for line in invite_lines(created.name, email, password, base, keys[0]) {
    fmt.Println(line)
  }
  fmt.Println("")
  for key in keys {
    match scoped_board_link(ctx, board_for_link(cfg.web_url, src.web_url), key) {
      Some(link) => fmt.Println(f"  view-only web board for {key} (separate from their CLI access; stops working when the server's LLL_BOARD_TOKEN changes): {link}"),
      None => status(f"no web board link for {key}: run this invite on the machine running 'lll up' to print one"),
    }
  }
  Ok(())
}

/// Every team key, comma-joined, for an unknown-team refusal (fleet case
/// 10: 8 of 10 agents ranked "no team with key 'NOPE'" the least helpful
/// error because it named no valid team). Best effort: "?" on failure.
fn team_keys_as(ctx: pb.Client, tok: string) -> string {
  let Ok(body) = ctx.get_as("/api/collections/teams/records?perPage=200&sort=key", tok) else { return "?" }
  let mut result = models.TeamList { .. }
  if json.Unmarshal(body.bytes(), &result).is_err() { return "?" }
  strings.Join(result.items.map(|t| t.key), ", ")
}

/// The team by key, read with `tok` rather than the configured token: an
/// invite may run on administrator credentials alone.
fn find_team_as(ctx: pb.Client, tok: string, key: string) -> Result<Option<models.Team>, pb.CliError> {
  let filter = url.QueryEscape(f"key={query.quote(key)}")
  let body = ctx.get_as(f"/api/collections/teams/records?filter={filter}", tok)?
  let mut result = models.TeamList { .. }
  if let Err(e) = json.Unmarshal(body.bytes(), &result) {
    return Err(pb.failed(f"decoding teams: {e}"))
  }
  Ok(result.items.find(|t| t.key == key))
}

/// A board link that opens only team `key`, or None when this machine does
/// not know the board token: LLL_BOARD_TOKEN, else the login link `lll up`
/// saved beside the home config.
fn scoped_board_link(ctx: pb.Client, web_url: string, key: string) -> Option<string> {
  let base = strings.TrimRight(web_url, "/")
  let Some(board_token) = known_board_token(ctx, base) else { return None }
  Some(f"{base}/t/{key}/?board_token={serve.scoped_board_token(board_token, key)}")
}

/// The board token for the board at `base`, when this machine knows it:
/// LLL_BOARD_TOKEN, else the login link `lll up` saved beside the home
/// config for that same board url. Shared with `lll board`.
fn known_board_token(ctx: pb.Client, base: string) -> Option<string> {
  if base == "" { return None }
  let mut board_token = ctx.settings.board_token()
  if board_token == "" {
    let Ok(home) = ctx.settings.home_path() else { return None }
    let Ok(saved) = os.ReadFile(filepath.Join(filepath.Dir(home), "board-login-url")) else { return None }
    let Some(tok) = strings.CutPrefix(strings.TrimSpace(saved as string), base + "/?board_token=") else { return None }
    board_token = tok
  }
  if board_token == "" { return None }
  Some(board_token)
}

/// A single private handoff for a group. The file is reserved before the
/// first member is created, then each minted credential is appended. A failed
/// later step leaves the exact completed subset in that file for recovery.
fn member_passes(input: flags.CommandInput) -> Result<(), pb.CliError> {
  let ctx = input.ctx
  let p = input.parsed
  let count = if p.one("--count") == "" {
    10
  } else {
    let Ok(value) = strconv.Atoi(p.one("--count")) else {
      return Err(
        flags.usage_error(f"--count must be a number from 1 to 50, got '{p.one("--count")}'"),
      )
    }
    value
  }
  if count < 1 || count > 50 { return Err(flags.usage_error("--count must be from 1 to 50")) }
  let prefix = if p.one("--prefix") == "" {
    "guest"
  } else {
    strings.TrimSpace(p.one("--prefix"))
  }
  if prefix == "" { return Err(flags.usage_error("--prefix cannot be blank")) }
  let duration = parse_token_duration(p.one("--duration"))?
  let admin_file = filepath.Join(
    filepath.Dir(ctx.settings.home_path().map_err(pb.failed)?),
    "local-admin.json",
  )
  let bytes = match os.ReadFile(admin_file) {
    Ok(b) => b,
    Err(e) => return Err(
      pb.failed(f"no local board admin connection at {admin_file}: {e}\nrun 'lll up --bind LAN_OR_TAILSCALE_IP' first"),
    ),
  }
  let mut local = LocalShareAdmin { .. }
  if let Err(e) = json.Unmarshal(bytes, &local) {
    return Err(pb.failed(f"decoding local board admin connection: {e}"))
  }
  if local.url == "" || local.email == "" || local.password == "" {
    return Err(pb.failed("saved local board admin connection is incomplete"))
  }
  // The saved local share is authoritative for this verb: an inherited hosted
  // LLL_URL or LLL_WEB_URL must not redirect credential creation elsewhere.
  let requested_url = p.one("--url")
  if requested_url != "" && strings.TrimSuffix(requested_url, "/") != local.url {
    return Err(pb.failed("--url disagrees with the saved local board URL"))
  }
  let ctx = point_at_url(ctx, local.url)?
  let ctx = ctx.with_settings(ctx.settings.with_web_url(local.url))
  let given = given_admin_login(ctx.settings, p, bufio.NewReader(os.Stdin))?
  let cfg = ctx.settings.config().map_err(pb.failed)?
  if cfg.team == "" {
    return Err(
      pb.failed("no team is configured; run 'lll up --bind LAN_OR_TAILSCALE_IP' from the team directory"),
    )
  }
  if cfg.web_url == "" {
    return Err(
      pb.failed("no board URL is configured; run 'lll up --bind LAN_OR_TAILSCALE_IP' first"),
    )
  }
  let login_file = filepath.Join(
    filepath.Dir(ctx.settings.home_path().map_err(pb.failed)?),
    "board-login-url",
  )
  let login_bytes = match os.ReadFile(login_file) {
    Ok(b) => b,
    Err(e) => return Err(
      pb.failed(f"no saved board login link at {login_file}: {e}\nrun 'lll up --bind LAN_OR_TAILSCALE_IP' first"),
    ),
  }
  let login_url = strings.TrimSpace(login_bytes as string)
  if !strings.HasPrefix(
    login_url,
    strings.TrimRight(cfg.web_url, "/") + "/?board_token=",
  ) {
    return Err(
      pb.failed("the saved board login link disagrees with web_url; restart with 'lll up --bind LAN_OR_TAILSCALE_IP'"),
    )
  }
  if local.url != cfg.url {
    return Err(pb.failed("saved local board admin connection disagrees with this API URL"))
  }
  // The saved local share's administrator is authoritative here, unless the
  // flags name one: an inherited LLL_ADMIN_* or configured token is ignored.
  let login = match given {
    AdminLogin.Explicit(creds) => AdminLogin.Explicit(creds),
    _ => AdminLogin.Explicit(config.AdminCreds { email: local.email, password: local.password }),
  }
  let su = superuser_auth(ctx, login)?
  let run_id = strings.ToLower(rand.Text())
  let out = if p.one("--out") != "" {
    p.one("--out")
  } else {
    filepath.Join(filepath.Dir(ctx.settings.home_path().map_err(pb.failed)?), f"handoffs-{run_id}.txt")
  }
  if let Err(e) = os.MkdirAll(filepath.Dir(out), 0o700) {
    return Err(pb.failed(f"creating handoff directory: {e}"))
  }
  let file = match os.OpenFile(
    out,
    os.O_WRONLY | os.O_CREATE | os.O_EXCL,
    0o600,
  ) {
    Ok(f) => f,
    Err(e) => return Err(
      pb.failed(f"creating private handoff file {out}: {e}; choose a new --out path"),
    ),
  }
  defer file.Close()
  let header = f"Team: {cfg.team}\nAPI: {cfg.url}\nBoard login: {login_url}\n\nSend only one person's block to that person. Browser access uses the board link; CLI/API access uses that person's LLL_TOKEN.\n{tokens.expiry_line(duration, time.Now(), "lll token create")}\n\n"
  match file.WriteString(header) {
    Partial.Ok(n) => if n != header.bytes().length() {
      return Err(pb.failed(f"short write to handoff file {out}"))
    },
    Partial.Err(e) | Partial.Both(_, e) => return Err(
      pb.failed(f"writing handoff file {out}: {e}"),
    ),
  }
  let mut completed = 0
  for i in 0..count {
    let name = f"{prefix}-{run_id}-{i + 1}"
    let member = match create_member_as(ctx, su, name, "", rand.Text(), [], None) {
      Ok(m) => m,
      Err(e) => return Err(
        e.with_message(f"created {completed} of {count} credentials in {out}; creating {name} failed: {e.message}"),
      ),
    }
    let token = match pb.impersonate_member(cfg.url, su, member.id.string(), duration) {
      Ok(tok) => tok,
      Err(e) => return Err(
        e.with_message(f"created person {name} but could not mint its token; {completed} complete credentials are in {out}: {e.message}"),
      ),
    }
    let block = f"Person {i + 1}: {name}\nLLL_URL={cfg.url}\nLLL_TEAM={cfg.team}\nLLL_TOKEN={token}\nBoard login: {login_url}\n\n"
    match file.WriteString(block) {
      Partial.Ok(n) => if n != block.bytes().length() {
        return Err(
          pb.failed(f"created person {name} but its token was only partly written to {out}; {completed} earlier credentials are complete"),
        )
      },
      Partial.Err(e) | Partial.Both(_, e) => return Err(
        pb.failed(f"created person {name} but could not write its token; {completed} complete credentials are in {out}: {e}"),
      ),
    }
    completed += 1
  }
  if let Err(e) = file.Close() {
    return Err(pb.failed(f"closing private handoff file {out}: {e}"))
  }
  fmt.Println(
    f"created {completed} distinct human credentials in {out} (mode 0600)",
  )
  fmt.Println(
    "send each person only their block; the board login link works on the selected LAN or Tailscale IP",
  )
  Ok(())
}

/// The literal text the inviter forwards: the temp password, then the two
/// commands the colleague runs. Pure, so the handoff can be asserted without
/// a server — and it is the part worth pinning, because a wrong url or a
/// missing --url is exactly the paste that sends them back to the inviter.
/// `team` is "" when the inviter is not attached to one; the attach line then
/// says so rather than printing a blank key.
fn invite_lines(
  name: string,
  email: string,
  password: string,
  base: string,
  team: string,
) -> Slice<string> {
  let attach = if team == "" {
    "  # then, in the repo you both work in: lll attach"
  } else {
    f"  # then, in a clone of the repo: lll attach --key {team} (skip attach only if the clone already contains a committed .lll.toml)"
  }
  [
    f"  temporary password: {password}",
    "",
    f"  lll login --url {base} --email {email}",
    attach,
    f"  # to choose your own password: lll member set-password {cli_argument(name)} --old-password {password}",
  ]
}

/// The configured board url, or "" unless it fronts the server this invite
/// runs against. url and web_url resolve independently (env, repo file, home
/// file), and 'lll up' saves web_url beside another server's url, so the
/// board must prove it: the invite's own token, asked through the board's
/// /api/, identifies itself only on the server that signed it. The probe
/// sends that token to the configured web_url, a host the user chose.
fn same_server_board(web_url: string, tok: string) -> string {
  let board = strings.TrimRight(strings.TrimSpace(web_url), "/")
  if board == "" || !pb.token_usable(board, tok) { return "" }
  board
}

/// Pure. The web_url this invite may send a token to or print, or "" (LLL-688).
/// Only one saved for this server: the home config's, while the url is the
/// home config's own, or one a flag named. A repo file or LLL_WEB_URL may
/// name any host, and the probe below carries the superuser token.
fn board_for_server(web_url: string, web_source: Option<config.Source>, api_url: string, home_url: string) -> string {
  match web_source {
    Some(config.Source.HomeFile(_)) => if config.same_url(api_url, home_url) { web_url } else { "" },
    Some(config.Source.Flag(_)) => web_url,
    Some(config.Source.RepoFile(_)) | Some(config.Source.Env(_)) | Some(config.Source.Default) | None => "",
  }
}

/// Pure. The web_url a scoped board link may name, or "". The link carries a
/// token derived from the board token, which LLL_BOARD_TOKEN or the saved
/// login link (only for its own board url) supplies; a repo file must not
/// choose the host it is printed for (LLL-688).
fn board_for_link(web_url: string, web_source: Option<config.Source>) -> string {
  match web_source {
    Some(config.Source.RepoFile(_)) => "",
    Some(config.Source.HomeFile(_)) | Some(config.Source.Env(_)) | Some(config.Source.Flag(_)) |
      Some(config.Source.Default) | None => web_url,
  }
}

/// The url the colleague's 'lll login --url' names. The board's address
/// when this machine knows it: the board serves the API under /api/ and
/// advertises itself at /.well-known/lll, so a login against it saves both
/// endpoints, where a login against the API listener finds no board. An
/// explicit --url is the inviter naming the server, and wins.
fn invite_base(given: string, api_url: string, web_url: string) -> string {
  let explicit = strings.TrimRight(strings.TrimSpace(given), "/")
  if explicit != "" { return explicit }
  let board = strings.TrimRight(web_url, "/")
  if board != "" { board } else { api_url }
}

/// True for an email a human can log in with — anything but empty and the
/// synthesized @members.invalid placeholder.
fn real_email(email: string) -> bool {
  email != "" && !strings.HasSuffix(email, "@members.invalid")
}

/// The hand-written page for `lll member invite`; dispatch prints it for
/// --help/-h before parse, which would otherwise trip the required --email.
fn member_invite_page() -> string {
  "lll member invite - add a colleague and hand them a working login

Usage:
  lll member invite NAME --email email

One command for you, two for them. Creates NAME as a member with the email
given, sets a generated temporary password, and prints that password once
together with the exact 'lll login --url ...' line the colleague runs. That
url is the board's when this machine knows it (web_url, which 'lll up' and
'lll login' save) and that board serves this same server, so their login
finds both the board and its API; --url names a different one. The
password is stored nowhere else: lose it and reissue with
'lll member set-password NAME'.

--email is required and must be a real address: it is the identity
'lll login' asks for, so the synthesized @members.invalid placeholder
'lll member create' falls back to would be a dead door.

Uses the configured member token to create a new colleague, or administrator
credentials from --admin-email/--admin-password (LLL_ADMIN_EMAIL and
LLL_ADMIN_PASSWORD only when no token is configured). An existing member is refused rather than
overwritten; resetting an existing password with 'lll member set-password'
requires administrator credentials.

--team KEY limits the colleague to that team (repeat for more); --read-only
lets them look but not change anything. Their own token sees only those teams'
issues, comments, docs and claims, and cannot widen its scope or create
members. When this machine knows the board token (LLL_BOARD_TOKEN, or the link
'lll up --bind' saved), the invite also prints a view-only web board link per
team; it stops working when the server's LLL_BOARD_TOKEN changes.

Only need someone to watch a team's board, with no login of their own?
'lll board --team KEY' prints that view-only link and creates no member." +
  flags.section(member_invite_spec())
}
