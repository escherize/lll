import "go:encoding/json"
import "go:fmt"
import "go:net/url"

import "config"
import "flags"
import "models"
import "pb"

/// Dispatch `lll team <verb>`.
pub fn team(args: Slice<string>) -> Result<(), string> {
  let Some(verb) = args.get(2) else {
    team_usage()
    return Ok(())
  }
  match verb {
    "list" => team_list(args),
    "create" => team_create(args),
    "view" => team_view(args),
    "archive" => team_set_archived(args, true),
    "unarchive" => team_set_archived(args, false),
    "--help" => {
      team_usage()
      Ok(())
    },
    "-h" => {
      team_usage()
      Ok(())
    },
    other => Err(f"unknown team command: '{other}' (see 'lll team --help')"),
  }
}

fn team_usage() {
  fmt.Println(
    "lll team - work with teams

Usage:
  lll team list [--archived]         list teams (KEY, name); --archived includes archived ones
  lll team create -k KEY -n \"Name\"   create a team
  lll team view KEY                  show a team and its issue count
  lll team archive KEY               hide the team from lists and the board rail (data kept)
  lll team unarchive KEY             bring an archived team back",
  )
}

fn team_list(args: Slice<string>) -> Result<(), string> {
  let p = flags.parse(team_list_spec(), args, 3, false, "")?
  let mut teams = list_teams()?
  // Archived teams are hidden by default — everywhere a team list renders
  // (here, the rail switcher) an archived team is finished work, not a
  // choice. --archived includes them, marked.
  if !p.given("--archived") {
    teams.items = teams.items.filter(|t| !t.archived)
  }
  if p.given("--json") {
    let body = match json.Marshal(teams) {
      Ok(b) => b as string,
      Err(e) => return Err(f"encoding team list: {e}"),
    }
    fmt.Println(body)
    return Ok(())
  }
  for t in teams.items {
    let mut mark = ""
    if t.archived { mark = "\t(archived)" }
    fmt.Println(f"{t.key}\t{t.name}{mark}")
  }
  Ok(())
}

fn team_list_spec() -> Slice<flags.Flag> {
  [
    flags.Flag { name: "--json", help: "print the raw record list as JSON", .. },
    flags.Flag { name: "--archived", help: "include archived teams (marked)", .. },
  ]
}

fn team_create_spec() -> Slice<flags.Flag> {
  [
    flags.Flag {
      name: "-k",
      value: true,
      hint: "KEY",
      required: true,
      help: "team key (e.g. ENG)",
      ..
    },
    flags.Flag {
      name: "-n",
      value: true,
      hint: "\"Name\"",
      required: true,
      help: "team name",
      ..
    },
  ]
}

/// The flag table of one team verb; empty for verbs without flags. Read by
/// `lll completions` so the scripts complete exactly what the parser accepts.
pub fn team_verb_spec(verb: string) -> Slice<flags.Flag> {
  match verb {
    "create" => team_create_spec(),
    "list" => team_list_spec(),
    _ => [],
  }
}

fn team_create(args: Slice<string>) -> Result<(), string> {
  let spec = team_create_spec()
  let usage = flags.usage("lll team create", spec, "")
  let p = flags.parse(spec, args, 3, false, usage)?
  let key = p.one("-k")
  let name = p.one("-n")

  let created = create_team(key, name)?
  fmt.Println(f"Created team {created.key}: {created.name}")
  Ok(())
}

/// Create a team. Shared by `lll team create` and `lll up`'s first-boot
/// bootstrap.
pub fn create_team(key: string, name: string) -> Result<models.Team, string> {
  let new_team = models.NewTeam { key, name }
  let payload = match json.Marshal(new_team) {
    Ok(p) => p,
    Err(e) => return Err(f"encoding team: {e}"),
  }
  let body = pb.post("/api/collections/teams/records", payload as string)?

  let mut created = models.Team { .. }
  if let Err(e) = json.Unmarshal(body.bytes(), &created) {
    return Err(f"decoding created team: {e}")
  }
  Ok(created)
}

/// Every team, key-sorted. Shared by `lll team list` and `lll up`.
pub fn list_teams() -> Result<models.TeamList, string> {
  let mut teams = models.TeamList { .. }
  pb.fetch(
    "/api/collections/teams/records?perPage=200&sort=key",
    "teams",
    &teams,
  )?
  Ok(teams)
}

/// The team `LLL_TEAM` (or `team` in .lll.toml) names, or None when no key
/// is set. A key naming a team the server does not have is an error either
/// way — silently falling back to "every team" is how a scoped command ends
/// up answering for all of them.
fn configured_team() -> Result<Option<models.Team>, string> {
  let cfg = config.load()?
  if cfg.team == "" { return Ok(None) }
  let Some(t) = find_team(cfg.team)? else {
    return Err(unknown_team(cfg.team))
  }
  Ok(Some(t))
}

/// The configured team, insisted upon. Docs, findings, labels and projects
/// each belong to exactly one team (TASK-173), so the verbs that write or
/// read them cannot proceed without a key and must not guess one.
fn current_team() -> Result<models.Team, string> {
  let Some(t) = configured_team()? else {
    return Err(no_team())
  }
  Ok(t)
}

/// The team a `--team KEY` flag names, or the configured one when the flag
/// is absent. Labels and projects each belong to exactly one team, so
/// neither `create` may leave it unset.
fn team_flag_or_current(key: string) -> Result<models.Team, string> {
  if key == "" { return current_team() }
  let Some(t) = find_team(key)? else {
    return Err(unknown_team(key))
  }
  Ok(t)
}

/// The configured team's id, or "" for "every team". Only the listing verbs
/// and the unscoped web board tolerate that second answer; anything that
/// writes a team-owned record uses current_team.
fn configured_team_id() -> Result<string, string> {
  Ok(configured_team()?.map_or("", |t| t.id))
}

/// Missing-team message naming the fix. Shared by every command that needs a
/// team and was given none (same package: src/commands).
fn no_team() -> string {
  "set LLL_TEAM or 'team' in .lll.toml to your team key (e.g. ENG)"
}

/// Unknown-team message naming the fix. Shared by every command that
/// resolves a team key (same package: src/commands).
fn unknown_team(key: string) -> string {
  f"no team with key '{key}' on the server — see 'lll team list', or create it with 'lll team create -k {key} -n \"Name\"'"
}

/// Archived-team refusal naming the fix. Shared by everything that refuses
/// to write into an archived team (same package: src/commands): the CLI's
/// attach and issue create, and the web board's write endpoints.
fn archived_hint(key: string) -> string {
  f"team {key} is archived — 'lll team unarchive {key}' first"
}

/// The one PATCH body the archive lifecycle needs: PocketBase replaces every
/// field it is handed, so the patch carries `archived` and nothing else.
#[json]
struct TeamArchivedPatch { archived: bool }

/// `lll team archive KEY` / `lll team unarchive KEY` — the team lifecycle.
/// Archiving hides, never deletes: issues, comments and the /t/KEY/ board
/// all stay, so the command can afford to be one word with no confirm.
fn team_set_archived(args: Slice<string>, archived: bool) -> Result<(), string> {
  let mut verb = "archive"
  if !archived { verb = "unarchive" }
  let Some(key) = args.get(3) else {
    return Err(f"usage: lll team {verb} KEY")
  }
  let Some(t) = find_team(key)? else {
    return Err(unknown_team(key))
  }
  let payload = match json.Marshal(TeamArchivedPatch { archived }) {
    Ok(p) => p as string,
    Err(e) => return Err(f"encoding team patch: {e}"),
  }
  let _ = pb.patch(f"/api/collections/teams/records/{t.id}", payload)?
  if archived {
    fmt.Println(
      f"Archived team {t.key} — hidden from team lists and the board rail; /t/{t.key}/ stays readable. 'lll team unarchive {t.key}' brings it back.",
    )
  } else {
    fmt.Println(f"Unarchived team {t.key}")
  }
  Ok(())
}

fn team_view(args: Slice<string>) -> Result<(), string> {
  let Some(key) = args.get(3) else {
    return Err("usage: lll team view KEY")
  }
  let Some(t) = find_team(key)? else {
    return Err(unknown_team(key))
  }

  let filter = url.QueryEscape(f"team='{t.id}'")
  let mut issues = models.IssueList { .. }
  pb.fetch(
    f"/api/collections/issues/records?filter={filter}&perPage=1",
    "issues",
    &issues,
  )?

  fmt.Println(f"Key:    {t.key}")
  fmt.Println(f"Name:   {t.name}")
  fmt.Println(f"Issues: {issues.total_items}")
  if t.archived {
    fmt.Println("Archived: yes ('lll team unarchive' brings it back)")
  }
  Ok(())
}
