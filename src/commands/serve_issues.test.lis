import "go:io/fs"
import "go:github.com/escherize/lll/web"
import "go:strings"

import "query"

#[test]
fn view_query_href_omits_empty_parts_and_escapes_values() {
  assert view_query_href("/issues", ViewQuery { .. }) == "/issues"
  assert view_query_href("/issues", ViewQuery { sort: "-updated", .. })
    == "/issues?sort=-updated"
  assert view_query_href(
      "/issues",
      ViewQuery { state: "in-progress", assignee: "Ada L", sort: "created", .. },
    )
    == "/issues?state=in-progress&assignee=Ada+L&sort=created"
}

#[test]
fn the_board_and_the_table_share_one_encoding() {
  // Same encoder, same param names, same fixed part order — the board only
  // adds the dimensions /issues does not have (prio, hide).
  assert view_query_href("/", ViewQuery { state: "todo", assignee: "bcm", .. })
    == "/?state=todo&assignee=bcm"
  assert view_query_href("/issues", ViewQuery { state: "todo", assignee: "bcm", .. })
    == "/issues?state=todo&assignee=bcm"
}

#[test]
fn several_values_in_one_dimension_are_comma_joined() {
  assert view_query_string(ViewQuery { state: "todo,done", .. })
    == "?state=todo%2Cdone"
  assert view_query_string(ViewQuery { hide: "done,cancelled", .. })
    == "?hide=done%2Ccancelled"
}

#[test]
fn a_header_link_changes_the_sort_and_keeps_the_filters() {
  let col = issue_col(
    "Created",
    "created",
    "c-age",
    ViewQuery { state: "todo", sort: "-updated", .. },
  )
  assert col.href == "/issues?state=todo&sort=-created"
  assert col.dir == ""
}

#[test]
fn clicking_the_sorting_column_flips_its_direction() {
  let desc = issue_col(
    "Created",
    "created",
    "c-age",
    ViewQuery { sort: "-created", .. },
  )
  assert desc.dir == "desc"
  assert desc.href == "/issues?sort=created"
  let asc = issue_col("Created", "created", "c-age", ViewQuery { sort: "created", .. })
  assert asc.dir == "asc"
  assert asc.href == "/issues?sort=-created"
}

#[test]
fn a_column_with_no_pb_field_behind_it_does_not_sort() {
  let col = issue_col("Title", "", "c-title", ViewQuery { sort: "-updated", .. })
  assert col.href == ""
  assert col.dir == ""
}

#[test]
fn every_sortable_column_asks_for_a_field_query_sort_accepts() {
  for col in issue_cols(ViewQuery { sort: "-updated", .. }) {
    if col.href != "" {
      let spec = strings.Split(col.href, "sort=")[1]
      assert query.sort(spec).is_ok()
    }
  }
}

// TASK-164: issue_cols() is the one ordered table of the table's columns, and
// three places copy it by hand — the ?raw body cells, the HTML row cells, and
// the empty state's colspan. Every one of them drifts SILENTLY: a ninth column
// gives ?raw a 9-cell header over 8-cell bodies (a malformed markdown table,
// from the surface whose whole promise is that an agent can parse it), and
// gives the HTML short rows under a wide header.
//
// The link is these three assertions rather than a generator. Two of the three
// copies CANNOT be derived: each <td> carries its own markup, and Go templates
// have no way to count a slice into an attribute. So the cheapest thing that
// actually goes red is a test that reads the copies and counts them, and it
// stays readable in six months, which a generator would not.

/// The column count every copy has to agree with.
fn expected_col_count() -> int {
  issue_cols(ViewQuery { sort: "-updated", .. }).length()
}

/// The text of the embedded issues.html — the same bytes render() parses, so
/// this reads the template that actually ships, not a file on disk.
fn issues_template_text() -> string {
  let data = fs.ReadFile(web.Assets(), "templates/issues.html").unwrap_or([])
  data as string
}

#[test]
fn the_raw_markdown_row_has_one_cell_per_column() {
  // issues_raw derives its header and its rule row from vm.cols and writes
  // the body by hand. Unequal lengths here IS the malformed table.
  let cells = issue_row_cells(CardVM { key: "TST-1", title: "t", .. })
  assert cells.length() == expected_col_count()
}

#[test]
fn the_html_row_has_one_td_per_column() {
  let text = issues_template_text()
  // The row block is everything the range over .Rows emits before the empty
  // state. Split rather than index arithmetic, because strings.Index gives
  // byte offsets and substring takes runes. The closing "</tr>" is the
  // boundary, NOT the range's own {{else}}: the label and assignee cells
  // carry {{else}}es of their own, and splitting on the bare token stops
  // inside the row and counts 5.
  let after_range = strings.SplitN(text, "{{range .Rows}}", 2)
  assert after_range.length() == 2
  let row_block = strings.SplitN(after_range[1], "</tr>", 2)[0]
  assert strings.Count(row_block, "<td ") == expected_col_count()
}

#[test]
fn the_empty_state_spans_every_column() {
  let text = issues_template_text()
  let after = strings.SplitN(text, "<td colspan=\"", 2)
  assert after.length() == 2
  let n = strings.SplitN(after[1], "\"", 2)[0]
  assert n == f"{expected_col_count()}"
}

#[test]
fn toggle_adds_and_removes_one_value_keeping_the_rest() {
  let q = ViewQuery { state: "todo", label: "web", .. }
  let added = view_query_toggle(q, "state", "done")
  assert added.state == "todo,done"
  assert added.label == "web"
  let removed = view_query_toggle(added, "state", "todo")
  assert removed.state == "done"
  assert removed.label == "web"
  // A value that is already there toggles OFF, so a chip removes itself.
  assert view_query_toggle(removed, "state", "done").state == ""
  // An unknown dimension is a no-op, not a second encoding.
  assert view_query_toggle(q, "bogus", "x") == q
}

#[test]
fn parse_raw_round_trips_through_the_encoder() {
  let q = view_query_parse_raw("?state=todo&hide=done%2Ccancelled&junk=1").unwrap_or(ViewQuery { .. })
  assert q.state == "todo"
  assert q.hide == "done,cancelled"
  // Unknown keys are ignored, not stored.
  assert view_query_string(q) == "?state=todo&hide=done%2Ccancelled"
  // A leading "?" is optional; "" is an empty view.
  assert view_query_string(view_query_parse_raw("").unwrap_or(ViewQuery { .. })) == ""
}
