import "records"
import "go:bufio"
import "go:encoding/json"
import "go:os"
import "go:regexp"
import "go:strconv"
import "go:strings"
import "go:time"

import "config"
import "flags"
import "models"
import "output"
import "pb"
import "secret"
import "tokens"

// `lll token` (TASK-183) — the agent entry point for auth. Agents do not
// have passwords to type; a superuser mints them a non-refreshable
// PocketBase token (the impersonate endpoint, verified in v0.40.1), which the
// agent sends as LLL_TOKEN or persists in the home config.
//
// TASK-214: these tokens used to ride PocketBase's collection duration (5
// days) while the help called them "static". The failure was silent and
// delayed — a colleague onboarded on Monday, worked all week, and hit a bare
// 401 the following week with nothing connecting it to the mint. So the
// duration is now explicit and long by default, the expiry is printed next
// to the token, and a 401 here names expiry as the likely cause.

/// Every token verb, as a value. `page` is the hand-written help `token
/// create` already had; its former pre-parse `--help` check is gone because
/// dispatch answers it now, and parses args against `spec` before `run` so a
/// trailing -h can never reach the verb body.
pub fn token_commands() -> Slice<flags.Command> {
  [
    flags.Command {
      name: "create",
      access: flags.Access.Write,
      summary: "mint a long-lived agent token for <member> (superuser only)",
      page: token_create_page(),
      spec: token_create_spec(),
      positional: "<member>",
      run: token_create,
      ..
    },
  ]
}

/// Prose that belongs to the noun rather than to any one verb; dispatch
/// prints it under the verb table for `lll token --help`.
fn token_intro() -> string {
  "Mints a long-lived, non-refreshable auth token that authenticates as
<member> - the agent credential, superuser-only. It lasts a year unless
--duration says otherwise, and the expiry is printed with it. The token is
printed once, when it is created; nothing else ever shows it. Use it as
LLL_TOKEN=<token>, or persist it as token = \"...\" in ~/.config/lll/lll.toml
(never the repo's .lll.toml, which is committed).
On the receiving machine, save the API endpoint with 'lll config set url URL', or supply LLL_URL." + flags.section(token_create_spec())
}

fn token_create_spec() -> Slice<flags.Flag> {
  with_admin_flags([
    flags.Flag { name: "--duration", value: true, hint: "seconds", help: "token lifetime in seconds (default one year);\n0 uses the members collection's duration", .. },
    flags.Flag { name: "--url", value: true, hint: "url", help: "server base url for this invocation (otherwise the configured server)", .. },
  ])
}

/// The --duration value as token create, `lll bot` and `lll bot rotate` all
/// read it: absent means the explicit one-year default, 0 means PocketBase's
/// collection duration, and a negative is refused here rather than
/// round-tripped into a 400 (PocketBase validates duration >= 0,
/// v0.40.1 impersonateForm).
fn parse_token_duration(raw: string) -> Result<int, pb.CliError> {
  if raw == "" { return Ok(tokens.default_token_duration()) }
  let Ok(d) = strconv.Atoi(raw) else {
    return Err(flags.usage_error(f"--duration must be a number of seconds, got '{raw}'"))
  }
  if d < 0 {
    return Err(flags.usage_error("--duration must be 0 or more; 0 uses the members collection's duration"))
  }
  Ok(d)
}

fn token_create(input: flags.CommandInput) -> Result<output.Output, pb.CliError> {
  let ctx = input.ctx
  let usage = input.usage
  let p = input.parsed
  let name = p.first()
  if name == "" {
    return Err(flags.usage_error(f"usage: {usage}"))
  }
  // Absent --duration means the explicit default, not PocketBase's: leaving
  // it at 0 is what silently handed out 5-day tokens. 0 stays reachable, but
  // only by asking for it.
  let duration = parse_token_duration(p.one("--duration"))?

  let ctx = point_at_url(ctx, p.one("--url"))?
  let su = superuser_auth(ctx, given_admin_login(ctx.settings, p, bufio.NewReader(os.Stdin))?)?
  let found = records.find_member_as(ctx, su, name)?
  let Some(member) = found else {
    return Err(pb.fail(pb.ErrorKind.NotFound, f"no member named '{name}'; see 'lll member create'"))
  }
  let payload = match json.Marshal(models.ImpersonateRequest { duration }) {
    Ok(b) => b,
    Err(e) => return Err(pb.failed(f"encoding the request: {e}")),
  }
  let body = match ctx.post_as(
    f"/api/collections/members/impersonate/{member.id}",
    payload as string,
    su,
  ) {
    Ok(b) => b,
    Err(e) => return Err(impersonate_error(name, e)),
  }
  let tok = tokens.decode_auth(body, "the impersonate response")?

  // The one place a token is ever printed: it is the agent's credential,
  // delivered exactly once, in the env form it is used in. Every other
  // surface — login, config list, the board — redacts it.
  let out = output.line(f"LLL_TOKEN={tok}").line(
    f"one-time agent token for {member.name}, shown only here; to persist it, put token = \"...\" in ~/.config/lll/lll.toml (never .lll.toml, which is committed)",
  )
  // The expiry belongs next to the token because it is the only moment
  // anyone will ever see it: impersonate tokens are stateless, so nothing
  // records the mint and no later command can answer "when does this die?".
  let lost = f"a token for {member.name} was minted but not written anywhere; mint another with 'lll token create {member.name}'"
  Ok(out.line(tokens.expiry_line(duration, time.Now(), "lll token create")).if_lost(lost))
}

/// What to say when the impersonate call is refused. `e` is the pb client's
/// error string, which carries the status line.
///
/// 401 and 403 are different refusals and used to share one message. 403 is
/// PocketBase saying "authenticated, but not a superuser" — a member token in
/// the gate. 401 is the token being rejected outright, and the way that
/// happens to someone who was working yesterday is expiry, which the old
/// shared wording never named (TASK-214). Anything else keeps the raw error.
fn impersonate_error(name: string, e: pb.CliError) -> pb.CliError {
  let status = e.status
  if status == 401 {
    return pb.fail(pb.ErrorKind.Auth, "the token this ran with was rejected (401) - most likely it expired
mint a new one with 'lll token create', or " + tokens.admin_hint())
  }
  if status == 403 {
    return pb.fail(pb.ErrorKind.Refused, "token create is superuser-only and the configured token is not one
" + tokens.admin_hint())
  }
  e.with_message(f"impersonating {name}: {e.message}")
}

/// A superuser token for the superuser-gated commands (token create, member
/// set-password). Env credentials win and authenticate fresh through
/// PocketBase's own endpoint; without them the configured token is tried
/// as-is — if it is not a superuser token, the gated call itself refuses,
/// and the caller's error names what to set.
/// The two flags every superuser-gated command accepts, so the credentials can
/// ride the command line instead of the environment (TASK-249). Four of six
/// agents in the round-4/5 usability runs reached for them.
pub fn admin_flags() -> Slice<flags.Flag> {
  [
    flags.Flag {
      name: "--admin-email",
      value: true,
      hint: "email",
      help: "superuser email (else LLL_ADMIN_EMAIL, only when no token is configured)",
      ..,
    },
    flags.Flag {
      name: "--admin-password",
      value: true,
      hint: "pw",
      help: "superuser password (else LLL_ADMIN_PASSWORD, only when no token is configured);\n'-' reads it from stdin",
      ..,
    },
  ]
}

/// `spec` plus the two admin flags. Slices append one element at a time here,
/// so the concatenation lives in one place rather than in every caller.
pub fn with_admin_flags(spec: Slice<flags.Flag>) -> Slice<flags.Flag> {
  let mut out = spec
  for fl in admin_flags() { out = out.append(fl) }
  out
}

/// Administrator credentials and where they came from (D7, LLL-646). They
/// are passed to the call that uses them and never written to the
/// environment, which every child process (gh, git, a browser opener) would
/// inherit.
pub enum AdminLogin {
  /// --admin-email/--admin-password, or a saved local share: the superuser,
  /// whatever token is configured. The only way a command with a member
  /// token configured acts as the administrator.
  Explicit(config.AdminCreds),
  /// LLL_ADMIN_EMAIL/LLL_ADMIN_PASSWORD: used only when no token is
  /// configured. A configured member token outranks them, so an inherited
  /// environment cannot silently turn a member's command into an ownerless
  /// administrator one.
  Env(config.AdminCreds),
  Absent,
}

/// The admin login a command was given: both --admin-* flags, else both
/// LLL_ADMIN_* variables (as the settings carry them), else none. One flag
/// without the other is refused.
pub fn given_admin_login(
  settings: config.Settings,
  p: flags.Parsed,
  input: mut Ref<bufio.Reader>,
) -> Result<AdminLogin, pb.CliError> {
  let email = p.one("--admin-email")
  // Only one flag can read stdin (secret.from_stdin says why).
  if secret.from_stdin(p, "--admin-password") && (secret.from_stdin(p, "--password") || secret.from_stdin(p, "--old-password") || secret.from_stdin(p, "--token")) {
    return Err(flags.usage_error("only one password flag can read stdin ('-'); pass the other as a value"))
  }
  let pass = if p.given("--admin-password") {
    Some(secret.Secret.read(p, "--admin-password", "Superuser password: ", input)?)
  } else {
    None
  }
  let has_pass = pass.map_or(false, |s| !s.is_empty())
  if (email == "") == has_pass {
    return Err(flags.usage_error("--admin-email and --admin-password go together; give both"))
  }
  // Revealed into the credentials superuser_login sends.
  if let Some(pw) = pass {
    if email != "" { return Ok(AdminLogin.Explicit(config.AdminCreds { email, password: pw.reveal() })) }
  }
  match settings.admin() {
    Some(creds) => Ok(AdminLogin.Env(creds)),
    None => Ok(AdminLogin.Absent),
  }
}

/// The administrator email a login carries, "" for none.
pub fn admin_login_email(login: AdminLogin) -> string {
  match login {
    AdminLogin.Explicit(creds) => creds.email,
    AdminLogin.Env(creds) => creds.email,
    AdminLogin.Absent => "",
  }
}

/// A token for a superuser-gated command (token create, member set-password
/// and the rest). Explicit credentials authenticate fresh through
/// PocketBase's own endpoint. Otherwise the configured token is used as-is -
/// if it is not a superuser token, the gated call itself refuses and the
/// caller's error names the flags. Env credentials authenticate only when no
/// token is configured.
pub fn superuser_auth(ctx: pb.Client, login: AdminLogin) -> Result<string, pb.CliError> {
  let cfg = ctx.settings.config().map_err(pb.failed)?
  match login {
    AdminLogin.Explicit(creds) => superuser_login(ctx, creds),
    AdminLogin.Env(creds) => {
      if cfg.token != "" { Ok(cfg.token) } else { superuser_login(ctx, creds) }
    },
    AdminLogin.Absent => {
      if cfg.token != "" { return Ok(cfg.token) }
      Err(
        pb.failed("this command is superuser-only and nothing here can authenticate as one
pass --admin-email and --admin-password (the credentials used to start the server),
or set LLL_ADMIN_EMAIL/LLL_ADMIN_PASSWORD (read only when no token is configured),
or put a superuser token in LLL_TOKEN - and name the server with --url if it is
not the configured one"),
      )
    },
  }
}

fn superuser_login(ctx: pb.Client, creds: config.AdminCreds) -> Result<string, pb.CliError> {
  let payload = match json.Marshal(models.AuthRequest { identity: creds.email, password: creds.password }) {
    Ok(b) => b,
    Err(e) => return Err(pb.failed(f"encoding credentials: {e}")),
  }
  let body = match ctx.post_anon(
    "/api/collections/_superusers/auth-with-password",
    payload as string,
  ) {
    Ok(b) => b,
    Err(e) => return Err(superuser_auth_failed(ctx, e)),
  }
  tokens.decode_auth(body, "the superuser auth response")
}

/// A failed superuser auth, with the wrong-server reading spelled out.
///
/// PocketBase answers 400 "Failed to authenticate" for bad credentials AND
/// for correct credentials sent to a server that has no such superuser. Four
/// usability runs read it the first way, re-checked an admin password that
/// was perfectly good, and lost commands — the real fault was the default
/// url, printed mid-line as incidental request detail. So when the url was
/// nobody's choice, say that first.
fn superuser_auth_failed(ctx: pb.Client, e: pb.CliError) -> pb.CliError {
  let msg = f"authenticating as the superuser: {e.message}"
  if e.status != 400 { return e.with_message(msg) }
  let Ok((_, src)) = ctx.settings.traced() else { return e.with_message(msg) }
  // LLL-687: the url's source names what to check. This used to say --url
  // whatever set it, and an agent with no --url on its command line had
  // nowhere to look.
  let line = match src.url {
    Some(config.Source.Default) => "that url is the built-in default: nothing here configured one, so the credentials
were almost certainly sent to the wrong server. Name it: --url <your server url>",
    Some(config.Source.Flag(spelling)) => wrong_server(spelling),
    Some(config.Source.Env(name)) => wrong_server(name),
    Some(config.Source.RepoFile(path)) | Some(config.Source.HomeFile(path)) => wrong_server(path),
    None => wrong_server("--url"),
  }
  e.with_message(f"{msg}\n{line}")
}

/// The superuser-auth hint for a url somebody chose, naming where they chose it.
fn wrong_server(named: string) -> string {
  f"if the administrator credentials are right, check the server: {named} names another one"
}

fn token_create_page() -> string {
  let spec = token_create_spec()
  let usage = flags.usage("lll token create", spec, "<member>")
  f"lll token create - mint a long-lived agent token (superuser only)

Usage:
  {usage}

Authenticates as the server administrator - from --admin-email/--admin-password,
else the configured token when it already is one, else
LLL_ADMIN_EMAIL/LLL_ADMIN_PASSWORD when no token is configured - and asks the
server to impersonate <member>: a
non-refreshable token sent as LLL_TOKEN. It does expire. --duration sets the
lifetime in seconds and defaults to one year; 0 hands the decision to the
members collection's own duration (5 days out of the box).

The expiry is printed with the token, because nothing records the mint and no
later command can tell you when it dies. When it does, the 401 says so and the
fix is another 'lll token create'.

The token is printed exactly once. Agents persist it with
token = \"...\" in ~/.config/lll/lll.toml, never .lll.toml, which is committed.
On the receiving machine, save the API endpoint with 'lll config set url URL', or supply LLL_URL." + flags.section(spec)
}

/// `lll bot create bot-NAME [--duration s]`: an agent identity in one command
/// (LLL-392, after veans init; LLL-407 made bots a member kind). Creates a
/// bot-kind member named NAME - the bot- prefix is reserved for bots and
/// enforced server-side - records the calling member as its owner, and
/// prints its token once. The human's own session is never the agent's
/// credential: the bot's token is scoped to the bot. `lll bot rotate NAME`
/// re-mints it while invalidating the previous token, which stops working at
/// its next request.
///
/// Create refuses a bot that already exists (D7, LLL-646): rerunning a setup
/// script used to rotate silently and strand the running agent's token.
/// Rotation is only ever `lll bot rotate`. Bare `lll bot bot-NAME` is create.
///
/// Creation rides the calling member's own token when there is one, so the
/// bot is owned by whoever ran the command. Administrator credentials name
/// no member, so a bot created with them has no owner.
pub fn bot_commands() -> Slice<flags.Command> {
  [
    flags.Command {
      name: "create",
      access: flags.Access.Write,
      summary: "an agent identity in one command: member + token, printed once in a prompt to paste into the agent (--env: only the exports); the name must start with bot-",
      page: bot_page(false),
      spec: bot_spec(),
      positional: "bot-NAME",
      missing: "  bot-NAME is the agent's member name, e.g. bot-myrepo; bot names are reserved to the bot- prefix",
      run: bot_create,
      ..,
    },
    flags.Command {
      name: "rotate",
      access: flags.Access.Write,
      summary: "a new token for a bot; the previous one stops working",
      page: bot_page(true),
      spec: bot_spec(),
      positional: "bot-NAME",
      missing: "  bot-NAME is the bot member's name, e.g. bot-myrepo",
      run: bot_rotate,
      ..,
    },
  ]
}

fn bot_create(input: flags.CommandInput) -> Result<output.Output, pb.CliError> {
  let ctx = input.ctx
  let p = input.parsed
  let name = strings.TrimSpace(p.first())
  if name == "" {
    return Err(
      flags.usage_error(f"usage: {input.usage}\n  bot-NAME is the agent's member name, e.g. bot-myrepo; bot names are reserved to the bot- prefix"),
    )
  }
  require_bot_prefix("lll bot create", name)?
  let ctx = point_at_url(ctx, p.one("--url"))?
  let (tok, caller) = bot_caller(ctx, given_admin_login(ctx.settings, p, bufio.NewReader(os.Stdin))?)?
  let duration = parse_token_duration(p.one("--duration"))?
  let env_only = p.given("--env")
  // Resolved before anything is created or minted, so a refusal leaves the
  // bot and its current token as they were.
  let team = prompt_team(ctx, tok, env_only, p.one("--team"))?
  let url = ctx.settings.config().map_err(pb.failed)?.url
  tokens.check_prompt_values(url, team, name)?
  let existing = records.find_member_as(ctx, tok, name)?
  if let Some(member) = existing {
    if !member.is_bot() {
      return Err(
        pb.failed(f"member '{name}' exists and is not a bot member
'lll bot create' only provisions bot members; use 'lll token create {name}' to mint its token directly"),
      )
    }
    return Err(pb.fail(
      pb.ErrorKind.Refused,
      f"bot {name} already exists; nothing was changed
'lll bot rotate {name}' mints a new token (the previous one stops working)"),
    )
  }
  let owner = caller.map(|me| me.id)
  let created = tokens.create_bot_member_as(ctx, tok, name, owner)?
  let owned = caller.map_or(
    "no owner (administrator credentials created it)",
    |me| f"owned by {me.name}",
  )
  let made = bot_status(
    env_only,
    f"created bot member {created.name} (kind=bot, {owned})",
  )
  let minted = tokens.bot_mint(ctx, tok, name, duration).map_err(|e| e.after(made))?
  let lost = f"bot {created.name} was created, but its one-time token was not written anywhere; 'lll bot rotate {name}' mints a new one"
  Ok(made.then(bot_credential(name, minted, url, team, duration, env_only)?).if_lost(lost))
}

/// `lll bot rotate bot-NAME [--duration s]`: re-mint the bot's token and strand
/// the previous one. The server admits the superuser or the bot's owner —
/// the human who created it is the one who sees a token leak.
fn bot_rotate(input: flags.CommandInput) -> Result<output.Output, pb.CliError> {
  let ctx = input.ctx
  let p = input.parsed
  let name = strings.TrimSpace(p.first())
  if name == "" {
    return Err(
      flags.usage_error(f"usage: {input.usage}\n  bot-NAME is the bot member's name, e.g. bot-myrepo"),
    )
  }
  require_bot_prefix("lll bot rotate", name)?
  let ctx = point_at_url(ctx, p.one("--url"))?
  let (tok, _) = bot_caller(ctx, given_admin_login(ctx.settings, p, bufio.NewReader(os.Stdin))?)?
  let duration = parse_token_duration(p.one("--duration"))?
  let env_only = p.given("--env")
  let team = prompt_team(ctx, tok, env_only, p.one("--team"))?
  let url = ctx.settings.config().map_err(pb.failed)?.url
  tokens.check_prompt_values(url, team, name)?
  let minted = tokens.bot_mint(ctx, tok, name, duration)?
  let lost = f"the previous token for {name} has stopped working, and the new one was not written anywhere; 'lll bot rotate {name}' mints another"
  Ok(bot_credential(name, minted, url, team, duration, env_only)?.if_lost(lost))
}

/// token create's flags plus the two that shape the bot's handoff.
fn bot_spec() -> Slice<flags.Flag> {
  let mut spec = token_create_spec()
  spec = spec.append(
    flags.Flag {
      name: "--team",
      value: true,
      hint: "KEY",
      help: "team the agent prompt attaches to (default: the configured team)",
      ..,
    },
  )
  spec = spec.append(
    flags.Flag {
      name: "--env",
      help: "print only the two export lines (LLL_URL, LLL_TOKEN), e.g. > agent.env",
      ..,
    },
  )
  spec
}

/// The team the agent prompt names, checked against the credential that
/// creates (and so owns) the bot. A bot never sees more than its owner
/// (slice 2), so a team its owner cannot see would hand the agent a prompt
/// whose 'lll attach' fails. --env prints no team, so it needs none.
fn prompt_team(
  ctx: pb.Client,
  tok: string,
  env_only: bool,
  flag: string,
) -> Result<string, pb.CliError> {
  if env_only {
    // --team only shapes the prompt, which --env does not print; taking it
    // silently let a typo pass unchecked (#340 review).
    if flag != "" {
      return Err(flags.usage_error("--team names the team the agent prompt attaches to, and --env prints no prompt; drop one of them"))
    }
    return Ok("")
  }
  let key = if flag != "" { flag } else { ctx.settings.config().map_err(pb.failed)?.team }
  let wanted = records.normalize_team_key(key)
  if wanted == "" {
    // Usage, exit 2, like every no-team refusal that --team fixes (LLL-679).
    return Err(flags.usage_error(
      "name the team the agent joins: --team KEY (no team is configured here)
or pass --env to print only the LLL_URL and LLL_TOKEN export lines",
    ))
  }
  let Some(team) = records.find_team_as(ctx, tok, wanted)? else {
    return Err(
      pb.failed(f"no team '{wanted}' among the teams this credential can see - a bot gets no more access than its owner, so the agent could not open it
'lll team list' shows the teams you can see"),
    )
  }
  Ok(team.key)
}

/// A progress line, for the prompt form only. With --env nothing but the
/// export lines is printed anywhere: agents capture `2>&1`, and a status line
/// in that capture broke `source` (1.0 fleet: four of ten, one of whom then
/// ran as the bot's owner without noticing).
fn bot_status(env_only: bool, line: string) -> output.Output {
  if env_only { output.none() } else { output.line(line) }
}

/// A freshly minted bot token, printed: the one place it is ever shown. The
/// default is the agent prompt from the design (doc scoped-access-invites,
/// Decision step 3); --env is its two export lines alone.
fn bot_credential(
  name: string,
  tok: string,
  url: string,
  team: string,
  duration: int,
  env_only: bool,
) -> Result<output.Output, pb.CliError> {
  // The server minted it, but it is printed into a shell all the same.
  if !regexp.MustCompile("^[A-Za-z0-9._-]+$").MatchString(tok) {
    return Err(pb.failed("the minted token contains characters lll cannot paste safely into a shell; nothing was printed"))
  }
  let expiry = tokens.expiry_line(duration, time.Now(), f"lll bot rotate {name}")
  if env_only { return Ok(output.env(tokens.agent_env(url, tok))) }
  Ok(
    output.line(f"one-time bot token for {name}, shown only here; {expiry}")
      .line("paste this into the agent:")
      .line("")
      .text(tokens.agent_prompt(url, team, tok)),
  )
}

fn bot_page(rotating: bool) -> string {
  let command = if rotating { "lll bot rotate" } else { "lll bot create" }
  let spec = bot_spec()
  let description = if rotating {
    "Rotate a bot's token; the previous token stops working. Requires the bot's owner or administrator credentials."
  } else {
    "Create a bot member and print its token once. An existing bot is refused; 'lll bot rotate' re-mints its token. Uses your configured token; administrator credentials only through --admin-email and --admin-password. 'lll bot bot-NAME' is the same command."
  }
  let see_rotate = if rotating {
    "

Who may rotate: a superuser, or the bot's owner while the owner's access
covers the bot's. The owner is the member whose token ran 'lll bot create'
to create it; a bot created with administrator credentials has none. Other
members and the bot itself are refused, unless they first make themselves the
owner, which the server does not yet prevent.

What rotation strands: every earlier token for the bot, including ones from
'lll token create', at its next request. This is the only command that
rotates; 'lll bot create' refuses an existing bot. 'lll token create bot-NAME'
adds a token and strands none."
  } else {
    "

Access: a bot created with your member token starts with your teams and mode,
and can never do more than you can: narrowing you narrows it at once, and a
read-only owner makes its bots read-only. 'lll whoami' with the bot's token
shows what it can do. A bot created with administrator credentials has no
owner and keeps its own access.

See 'lll bot rotate --help' for token rotation."
  }
  let rotate_usage = if rotating { "" } else { "\n  " + flags.usage("lll bot rotate", spec, "bot-NAME") }
  f"{command} - {description}\n\nUsage:\n  {flags.usage(command, spec, "bot-NAME")}{rotate_usage}\n\nThe name must start with the reserved bot- prefix, e.g. '{command} bot-myrepo'."
    + "

The token is printed once, inside a prompt to paste into the agent: its
LLL_URL and LLL_TOKEN exports, 'lll attach --key KEY' for --team (default: the
configured team, which you must be able to see), and where to read the
workflow. --env prints only the two export lines on stdout:
  "
    + command
    + " bot-myrepo --env > agent.env"
    + flags.section(spec)
    + see_rotate
}

/// The server reserves bot- names to bots (gopb checkMemberKind), so a name
/// without the prefix can never be a bot. Refuse it here, before any
/// credential or server call, with the spelling that would work.
fn require_bot_prefix(command: string, name: string) -> Result<(), pb.CliError> {
  if strings.HasPrefix(name, "bot-") { return Ok(()) }
  Err(flags.usage_error(f"bot names are reserved to the bot- prefix - got '{name}'; try '{command} bot-{name}'"))
}

/// The credential `lll bot` creates and rotates with, and the member it
/// names. The configured token comes first (D7, LLL-646): a member token
/// creates on the caller's own behalf, so the caller owns the bot (the
/// members create rule is authenticated-only, TASK-181), and a configured
/// superuser token creates ownerless. Only explicit --admin-* flags act as
/// the administrator over a configured token; LLL_ADMIN_* is read only when
/// no token is configured. Before this, inherited admin variables silently
/// outranked a member's token and the bot came out ownerless.
fn bot_caller(ctx: pb.Client, login: AdminLogin) -> Result<(string, Option<models.Member>), pb.CliError> {
  let cfg = ctx.settings.config().map_err(pb.failed)?
  let explicit = match login {
    AdminLogin.Explicit(_) => true,
    _ => false,
  }
  if explicit || cfg.token == "" {
    return Ok((superuser_auth(ctx, login)?, None))
  }
  let me = token_member(ctx, cfg.token)?
  Ok((cfg.token, me))
}

/// The member a token names, or None when it names nobody: a superuser
/// token's JWT id has no members record, and PocketBase answers 404. The
/// same probe `lll whoami` makes — the id out of the JWT, then that record.
fn token_member(ctx: pb.Client, tok: string) -> Result<Option<models.Member>, pb.CliError> {
  let Some(id) = pb.token_subject(tok) else { return Ok(None) }
  match ctx.get_as(f"/api/collections/members/records/{id}", tok) {
    Ok(body) => {
      let mut me = models.Member { .. }
      if let Err(e) = json.Unmarshal(body.bytes(), &me) {
        return Err(pb.failed(f"decoding the identity response: {e}"))
      }
      Ok(Some(me))
    },
    Err(e) => {
      if e.status == 404 { return Ok(None) }
      Err(e)
    },
  }
}

