import "records"
import "go:encoding/json"
import "go:fmt"
import "go:os"
import "go:crypto/rand"
import "go:strconv"
import "go:strings"
import "go:time"

import "config"
import "flags"
import "models"
import "pb"

// `lll token` (TASK-183) — the agent entry point for auth. Agents do not
// have passwords to type; a superuser mints them a non-refreshable
// PocketBase token (the impersonate endpoint, verified in v0.40.1), which the
// agent sends as LLL_TOKEN or persists in the home config.
//
// TASK-214: these tokens used to ride PocketBase's collection duration (5
// days) while the help called them "static". The failure was silent and
// delayed — a colleague onboarded on Monday, worked all week, and hit a bare
// 401 the following week with nothing connecting it to the mint. So the
// duration is now explicit and long by default, the expiry is printed next
// to the token, and a 401 here names expiry as the likely cause.

/// Dispatch `lll token <verb>` through the noun's Command table (TASK-307).
/// The table is the one place a verb is declared: dispatch, `lll token --help`
/// and shell completions all read it, so none of the three can drift.
pub fn token(args: Slice<string>) -> Result<(), string> {
  flags.dispatch("token", "work with agent tokens", token_intro(), token_commands(), args)
}

/// Every token verb, as a value. `page` is the hand-written help `token
/// create` already had; its former pre-parse `--help` check is gone because
/// dispatch answers it now, and parses args against `spec` before `run` so a
/// trailing -h can never reach the verb body.
pub fn token_commands() -> Slice<flags.Command> {
  [
    flags.Command {
      name: "create",
      summary: "mint a long-lived agent token for <member> (superuser only)",
      page: token_create_page(),
      spec: token_create_spec(),
      positional: "<member>",
      run: token_create,
    },
  ]
}

/// Prose that belongs to the noun rather than to any one verb; dispatch
/// prints it under the verb table for `lll token --help`.
fn token_intro() -> string {
  "Mints a long-lived, non-refreshable auth token that authenticates as
<member> - the agent credential, superuser-only. It lasts a year unless
--duration says otherwise, and the expiry is printed with it. The token is
printed once, when it is created; nothing else ever shows it. Use it as
LLL_TOKEN=<token>, or persist it as token = \"...\" in ~/.config/lll/lll.toml
(never the repo's .lll.toml, which is committed).
On the receiving machine, save the API endpoint with 'lll config set url URL', or supply LLL_URL." + flags.section(token_create_spec())
}

/// The lifetime a mint gets when --duration is not given: one year in
/// seconds. Long on purpose. An agent credential has no refresh path and no
/// human watching it, so the only thing a short life buys is an outage
/// nobody can attribute; rotation is a deliberate re-mint, not an expiry.
fn default_token_duration() -> int {
  365 * 24 * 60 * 60
}

fn token_create_spec() -> Slice<flags.Flag> {
  with_admin_flags([
    flags.Flag { name: "--duration", value: true, hint: "seconds", help: "token lifetime in seconds (default one year);\n0 uses the members collection's duration", .. },
    flags.Flag { name: "--url", value: true, hint: "url", help: "server base url for this invocation (otherwise the configured server)", .. },
    flags.Flag { name: "--help", alias: "-h", hidden: true, help: "show this help", .. },
  ])
}

/// The --duration value as token create, `lll bot` and `lll bot rotate` all
/// read it: absent means the explicit one-year default, 0 means PocketBase's
/// collection duration, and a negative is refused here rather than
/// round-tripped into a 400 (PocketBase validates duration >= 0,
/// v0.40.1 impersonateForm).
fn parse_token_duration(raw: string) -> Result<int, string> {
  if raw == "" { return Ok(default_token_duration()) }
  let Ok(d) = strconv.Atoi(raw) else {
    return Err(f"--duration must be a number of seconds, got '{raw}'")
  }
  if d < 0 {
    return Err("--duration must be 0 or more; 0 uses the members collection's duration")
  }
  Ok(d)
}

fn token_create(input: flags.CommandInput) -> Result<(), string> {
  let spec = token_create_spec()
  let usage = flags.usage("lll token create", spec, "<member>")
  let p = input.parsed
  let name = p.first()
  if name == "" {
    return Err(f"usage: {usage}")
  }
  // Absent --duration means the explicit default, not PocketBase's: leaving
  // it at 0 is what silently handed out 5-day tokens. 0 stays reachable, but
  // only by asking for it.
  let duration = parse_token_duration(p.one("--duration"))?

  point_at_url(p.one("--url"))?
  apply_admin_flags(p.one("--admin-email"), p.one("--admin-password"))?
  let su = superuser_auth()?
  let found = records.find_member_as(su, name)?
  let Some(member) = found else {
    return Err(f"no member named '{name}' — see 'lll member add'")
  }
  let payload = match json.Marshal(models.ImpersonateRequest { duration }) {
    Ok(b) => b,
    Err(e) => return Err(f"encoding the request: {e}"),
  }
  let body = match pb.post_as(
    f"/api/collections/members/impersonate/{member.id}",
    payload as string,
    su,
  ) {
    Ok(b) => b,
    Err(e) => return Err(impersonate_error(name, e)),
  }
  let tok = decode_auth(body, "the impersonate response")?

  // The one place a token is ever printed: it is the agent's credential,
  // delivered exactly once, in the env form it is used in. Every other
  // surface — login, config --list, the board — redacts it.
  fmt.Println(f"LLL_TOKEN={tok}")
  fmt.Println(
    f"one-time agent token for {member.name} — shown only here; to persist it, put token = \"...\" in ~/.config/lll/lll.toml (never .lll.toml, which is committed)",
  )
  // The expiry belongs next to the token because it is the only moment
  // anyone will ever see it: impersonate tokens are stateless, so nothing
  // records the mint and no later command can answer "when does this die?".
  fmt.Println(expiry_line(duration, time.Now()))
  Ok(())
}

/// The "expires ..." line printed under a freshly minted token. `now` is
/// passed in so the formatting is a function of its arguments alone.
///
/// A 0 duration hands the decision to the members collection, which this
/// process cannot read the value of, so the line says that instead of
/// guessing a date.
fn expiry_line(duration: int, now: time.Time) -> string {
  if duration == 0 {
    return "expires: whenever the members collection's token duration says — pass --duration to pin it"
  }
  let at = now.Add(time.Duration(duration as int64) * time.Second)
  let day = at.Format("2006-01-02")
  f"expires {day} ({duration}s from now) — re-mint with 'lll token create'"
}

/// What to say when the impersonate call is refused. `e` is the pb client's
/// error string, which carries the status line.
///
/// 401 and 403 are different refusals and used to share one message. 403 is
/// PocketBase saying "authenticated, but not a superuser" — a member token in
/// the gate. 401 is the token being rejected outright, and the way that
/// happens to someone who was working yesterday is expiry, which the old
/// shared wording never named (TASK-214). Anything else keeps the raw error.
fn impersonate_error(name: string, e: string) -> string {
  let status = pb.response_status(e)
  if status == 401 {
    return "the token this ran with was rejected (401) - most likely it expired
mint a new one with 'lll token create', or set LLL_ADMIN_EMAIL/LLL_ADMIN_PASSWORD
to this server's administrator credentials"
  }
  if status == 403 {
    return "token create is superuser-only and the configured token is not one
set LLL_ADMIN_EMAIL/LLL_ADMIN_PASSWORD to this server's administrator credentials"
  }
  f"impersonating {name}: {e}"
}

/// A superuser token for the superuser-gated commands (token create, member
/// set-password). Env credentials win and authenticate fresh through
/// PocketBase's own endpoint; without them the configured token is tried
/// as-is — if it is not a superuser token, the gated call itself refuses,
/// and the caller's error names what to set.
/// The two flags every superuser-gated command accepts, so the credentials can
/// ride the command line instead of the environment (TASK-249). Four of six
/// agents in the round-4/5 usability runs reached for them.
pub fn admin_flags() -> Slice<flags.Flag> {
  [
    flags.Flag {
      name: "--admin-email",
      value: true,
      hint: "email",
      help: "superuser email (else LLL_ADMIN_EMAIL)",
      ..,
    },
    flags.Flag {
      name: "--admin-password",
      value: true,
      hint: "pw",
      help: "superuser password (else LLL_ADMIN_PASSWORD)",
      ..,
    },
  ]
}

/// `spec` plus the two admin flags. Slices append one element at a time here,
/// so the concatenation lives in one place rather than in every caller.
pub fn with_admin_flags(spec: Slice<flags.Flag>) -> Slice<flags.Flag> {
  let mut out = spec
  for fl in admin_flags() { out = out.append(fl) }
  out
}

/// Apply --admin-email/--admin-password for the rest of this process, so
/// superuser_auth and everything under it see them the same way they see the
/// environment. Same shape and same reason as member.lis's point_at_url.
pub fn apply_admin_flags(email: string, pass: string) -> Result<(), string> {
  if email != "" {
    if let Err(e) = os.Setenv("LLL_ADMIN_EMAIL", email) {
      return Err(f"reading --admin-email: {e}")
    }
  }
  if pass != "" {
    if let Err(e) = os.Setenv("LLL_ADMIN_PASSWORD", pass) {
      return Err(f"reading --admin-password: {e}")
    }
  }
  Ok(())
}

fn superuser_auth() -> Result<string, string> {
  let email = os.Getenv("LLL_ADMIN_EMAIL")
  let pass = os.Getenv("LLL_ADMIN_PASSWORD")
  if email != "" && pass != "" {
    let payload = match json.Marshal(models.AuthRequest { identity: email, password: pass }) {
      Ok(b) => b,
      Err(e) => return Err(f"encoding credentials: {e}"),
    }
    let body = match pb.post_anon(
      "/api/collections/_superusers/auth-with-password",
      payload as string,
    ) {
      Ok(b) => b,
      Err(e) => return Err(superuser_auth_failed(e)),
    }
    return decode_auth(body, "the superuser auth response")
  }
  let cfg = config.load()?
  if cfg.token != "" {
    return Ok(cfg.token)
  }
  Err(
    "this command is superuser-only and nothing here can authenticate as one
pass --admin-email and --admin-password, or set LLL_ADMIN_EMAIL/LLL_ADMIN_PASSWORD
(the credentials used to start the server), or put a superuser token in LLL_TOKEN — and name the server with
--url if it is not the configured one",
  )
}

/// A failed superuser auth, with the wrong-server reading spelled out.
///
/// PocketBase answers 400 "Failed to authenticate" for bad credentials AND
/// for correct credentials sent to a server that has no such superuser. Four
/// usability runs read it the first way, re-checked an admin password that
/// was perfectly good, and lost commands — the real fault was the default
/// url, printed mid-line as incidental request detail. So when the url was
/// nobody's choice, say that first.
fn superuser_auth_failed(e: string) -> string {
  let msg = f"authenticating as the superuser: {e}"
  if pb.response_status(e) != 400 { return msg }
  let Ok((_, src)) = config.load_traced() else { return msg }
  if src.url != "default" {
    return msg + "
if LLL_ADMIN_EMAIL/LLL_ADMIN_PASSWORD are right, check the server: --url names another one"
  }
  msg + "
that url is the built-in default — nothing here configured one, so the credentials
were almost certainly sent to the wrong server. Name it: --url <your server url>"
}

/// Pull the token out of an auth-with-password / impersonate response body
/// (both answer {token, record}; verified in v0.40.1 apis/record_helpers.go).
fn decode_auth(body: string, what: string) -> Result<string, string> {
  let mut auth = models.AuthResponse { .. }
  if let Err(e) = json.Unmarshal(body.bytes(), &auth) {
    return Err(f"decoding {what}: {e}")
  }
  if auth.token == "" {
    return Err(f"{what} carried no token")
  }
  Ok(auth.token)
}

fn token_create_page() -> string {
  let spec = token_create_spec()
  let usage = flags.usage("lll token create", spec, "<member>")
  f"lll token create - mint a long-lived agent token (superuser only)

Usage:
  {usage}

Authenticates as the server administrator — from --admin-email/--admin-password,
LLL_ADMIN_EMAIL/LLL_ADMIN_PASSWORD, or the configured token
when it already is one — and asks the server to impersonate <member>: a
non-refreshable token sent as LLL_TOKEN. It does expire. --duration sets the
lifetime in seconds and defaults to one year; 0 hands the decision to the
members collection's own duration (5 days out of the box).

The expiry is printed with the token, because nothing records the mint and no
later command can tell you when it dies. When it does, the 401 says so and the
fix is another 'lll token create'.

The token is printed exactly once. Agents persist it with
token = \"...\" in ~/.config/lll/lll.toml — never .lll.toml, which is committed.
On the receiving machine, save the API endpoint with 'lll config set url URL', or supply LLL_URL." + flags.section(spec)
}

/// `lll bot NAME [--duration s]`: an agent identity in one command (LLL-392,
/// after veans init; LLL-407 made bots a member kind). Creates a bot-kind
/// member named NAME — the bot- prefix is reserved for bots and enforced
/// server-side — records the calling member as its owner, and prints its
/// token once. The human's own session is never the agent's credential: the
/// bot's token is scoped to the bot, and both this command and `lll bot
/// rotate NAME` re-mint it while invalidating the previous token, which
/// stops working at its next request.
///
/// Creation rides the calling member's own token when there is one, so the
/// bot is owned by whoever ran the command. Administrator credentials name
/// no member, so a bot created with them has no owner.
pub fn bot(args: Slice<string>) -> Result<(), string> {
  // `args` is the full argv ("lll", "bot", ...), so the verb rides index 2
  // — where a bot's NAME would sit. A bot cannot be named "rotate": the
  // server reserves bot- * names, so the two forms cannot collide.
  if args.get(2).unwrap_or("") == "rotate" { return bot_rotate(args) }
  bot_create(args)
}

fn bot_create(args: Slice<string>) -> Result<(), string> {
  let spec = token_create_spec()
  let usage = flags.usage("lll bot", spec, "NAME")
  let p = flags.parse_n(spec, args, 2, 1, usage)?
  if p.given("--help") {
    fmt.Println(bot_page(false))
    return Ok(())
  }
  let name = strings.TrimSpace(p.first())
  if name == "" {
    return Err(f"usage: {usage}\n  NAME is the agent's member name, e.g. bot-myrepo — bot names are reserved to the bot- prefix")
  }
  point_at_url(p.one("--url"))?
  apply_admin_flags(p.one("--admin-email"), p.one("--admin-password"))?
  let (tok, caller) = bot_caller()?
  let duration = parse_token_duration(p.one("--duration"))?
  let existing = records.find_member_as(tok, name)?
  if let Some(member) = existing {
    if member.kind != "bot" {
      return Err(
        f"member '{name}' exists and is not a bot member
'lll bot' only provisions bot members; use 'lll token create {name}' to mint its token directly",
      )
    }
    fmt.Println(f"member {name} exists; rotating its token (the previous one stops working)")
  } else {
    let owner = caller.map_or("", |me| me.id)
    let created = create_bot_member_as(tok, name, owner)?
    let owned = caller.map_or("no owner (the superuser created it)", |me| f"owned by {me.name}")
    fmt.Println(f"created bot member {created.name} (kind=bot, {owned})")
  }
  bot_mint(tok, name, duration)
}

/// `lll bot rotate NAME [--duration s]`: re-mint the bot's token and strand
/// the previous one. The server admits the superuser or the bot's owner —
/// the human who created it is the one who sees a token leak.
fn bot_rotate(args: Slice<string>) -> Result<(), string> {
  let spec = token_create_spec()
  let usage = flags.usage("lll bot rotate", spec, "NAME")
  let p = flags.parse_n(spec, args, 3, 1, usage)?
  if p.given("--help") {
    fmt.Println(bot_page(true))
    return Ok(())
  }
  let name = strings.TrimSpace(p.first())
  if name == "" {
    return Err(f"usage: {usage}\n  NAME is the bot member's name, e.g. bot-myrepo")
  }
  point_at_url(p.one("--url"))?
  apply_admin_flags(p.one("--admin-email"), p.one("--admin-password"))?
  let (tok, _) = bot_caller()?
  let duration = parse_token_duration(p.one("--duration"))?
  bot_mint(tok, name, duration)
}

fn bot_page(rotating: bool) -> string {
  let command = if rotating { "lll bot rotate" } else { "lll bot" }
  let spec = token_create_spec()
  let description = if rotating {
    "Rotate a bot's token; the previous token stops working. Requires the bot's owner or administrator credentials."
  } else {
    "Create a bot member and print its token once. An existing bot's token is rotated. Uses your member token or administrator credentials."
  }
  let see_rotate = if rotating { "" } else { "\nSee 'lll bot rotate --help' for token rotation." }
  f"{command} - {description}\n\nUsage:\n  {flags.usage(command, spec, "NAME")}\n\nNAME must use the reserved bot- prefix, e.g. bot-myrepo."
    + flags.section(spec)
    + see_rotate
}

/// creates. Administrator credentials authenticate as the superuser, which
/// names no member; a configured member token creates on the caller's own
/// behalf (the members create rule is authenticated-only, TASK-181); a
/// configured superuser token falls back to that, ownerless.
fn bot_caller() -> Result<(string, Option<models.Member>), string> {
  if os.Getenv("LLL_ADMIN_EMAIL") != "" && os.Getenv("LLL_ADMIN_PASSWORD") != "" {
    return Ok((superuser_auth()?, None))
  }
  let cfg = config.load()?
  if cfg.token == "" {
    return Ok((superuser_auth()?, None))
  }
  let me = token_member(cfg.token)?
  Ok((cfg.token, me))
}

/// The member a token names, or None when it names nobody: a superuser
/// token's JWT id has no members record, and PocketBase answers 404. The
/// same probe `lll whoami` makes — the id out of the JWT, then that record.
fn token_member(tok: string) -> Result<Option<models.Member>, string> {
  let Some(id) = pb.token_subject(tok) else { return Ok(None) }
  match pb.get_as(f"/api/collections/members/records/{id}", tok) {
    Ok(body) => {
      let mut me = models.Member { .. }
      if let Err(e) = json.Unmarshal(body.bytes(), &me) {
        return Err(f"decoding the identity response: {e}")
      }
      Ok(Some(me))
    },
    Err(e) => {
      if pb.response_status(e) == 404 { return Ok(None) }
      Err(e)
    },
  }
}

/// Create the bot-kind member record: a random password nobody knows (the
/// login door is closed server-side regardless), the synthesized email every
/// record-only member gets, kind = bot, and `owner` pointing at the calling
/// member when there is one.
fn create_bot_member_as(tok: string, name: string, owner: string) -> Result<models.Member, string> {
  let password = rand.Text()
  let new_bot = models.NewMember {
    name,
    email: synthesize_email(name),
    password,
    password_confirm: password,
    email_visibility: true,
    kind: "bot",
    owner,
  }
  let payload = match json.Marshal(new_bot) {
    Ok(p) => p,
    Err(e) => return Err(f"encoding bot member: {e}"),
  }
  let body = pb.post_as("/api/collections/members/records", payload as string, tok)?
  let mut created = models.Member { .. }
  if let Err(e) = json.Unmarshal(body.bytes(), &created) {
    return Err(f"decoding created bot member: {e}")
  }
  Ok(created)
}

/// Mint the bot's token through the rotate route: it re-mints and — by
/// refreshing the record's tokenKey — strands every earlier token at its
/// next request. The server checks owner or superuser; the response is the
/// same {token, record} shape impersonate answers with. The one place a bot
/// token is ever printed, like token create's.
fn bot_mint(tok: string, name: string, duration: int) -> Result<(), string> {
  let payload = match json.Marshal(models.BotRotate { name, duration }) {
    Ok(b) => b,
    Err(e) => return Err(f"encoding the rotation request: {e}"),
  }
  let body = match pb.post_as("/api/lll/bots/rotate", payload as string, tok) {
    Ok(b) => b,
    Err(e) => return Err(bot_mint_error(name, e)),
  }
  let mut auth = models.AuthResponse { .. }
  if let Err(e) = json.Unmarshal(body.bytes(), &auth) {
    return Err(f"decoding the rotation response: {e}")
  }
  if auth.token == "" { return Err("the rotation response carried no token") }
  fmt.Println(f"LLL_TOKEN={auth.token}")
  fmt.Println(
    f"one-time bot token for {name} — shown only here; to persist it, put token = \"...\" in ~/.config/lll/lll.toml (never .lll.toml, which is committed)",
  )
  fmt.Println(expiry_line(duration, time.Now()))
  Ok(())
}

/// What to say when the rotate route refuses. 403 is the owner check — the
/// configured credential neither owns the bot nor is a superuser; 401 is a
/// dead token, the same shape token create's refusal names. Anything else
/// keeps the raw error.
fn bot_mint_error(name: string, e: string) -> string {
  let status = pb.response_status(e)
  if status == 403 {
    return f"rotating {name}'s token: only the bot's owner or a superuser can do that
the configured token does not own this bot — pass --admin-email/--admin-password (or set LLL_ADMIN_EMAIL/LLL_ADMIN_PASSWORD) to rotate as the superuser"
  }
  if status == 401 {
    return "the token this ran with was rejected (401) - most likely it expired
mint a new one with 'lll token create', or set LLL_ADMIN_EMAIL/LLL_ADMIN_PASSWORD
to this server's administrator credentials"
  }
  f"rotating {name}'s token: {e}"
}
