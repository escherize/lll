import "go:github.com/escherize/lll/docs"
import "go:strings"

import "flags"
import "pb"

// The command table (LLL-684): one parser, and one rule for every wrong
// guess. Pure functions of argv, so every branch is pinned without a board.

/// The usage error a command line gets, "" when it parses.
fn refusal(args: Slice<string>) -> string {
  match flags.parse_command_line(nouns(), args) {
    Err(e) => if pb.exit_code(e.kind) == 2 { e.message } else { f"exit {pb.exit_code(e.kind)}: {e.message}" },
    Ok(_) => "",
  }
}

/// The page a help request prints, "" when it is not one.
fn help_page(args: Slice<string>) -> string {
  match flags.parse_command_line(nouns(), args) {
    Ok(flags.Invocation.Help(flags.Topic.Page(page))) => page,
    _ => "",
  }
}

fn runs(args: Slice<string>) -> bool {
  match flags.parse_command_line(nouns(), args) {
    Ok(flags.Invocation.Run(_)) => true,
    _ => false,
  }
}

#[test]
fn unknown_command_names_the_typed_verb_for_issue_verbs() {
  // 'lll comment create' is the most common misplaced command (three of
  // thirty fleet agents); the pointer must carry the half the user had
  // right (LLL-313), the way the plural branch does.
  let msg = refusal(["lll", "comment", "create"])
  assert msg.contains("'comment create'")
  assert msg.contains("lll issue comment")
  // A verb that is really a positional rides along too: 'lll comment
  // ENG-1 "hi"' points at the same place with the key named.
  assert refusal(["lll", "comment", "ENG-1"]).contains("'comment ENG-1'")
  // A flag-like second word is not a verb; the message quotes the noun alone.
  assert refusal(["lll", "comment", "-b"]).contains("'comment'")
  assert refusal(["lll", "comment"]).contains("'comment'")
}

#[test]
fn unknown_command_keeps_the_plural_and_generic_branches() {
  assert refusal(["lll", "issues", "list"]).contains("'lll issue list'")
  assert refusal(["lll", "webhooks"]).contains("did you mean 'lll webhook'?")
  assert refusal(["lll", "wibble", "create"]) == "unknown command: 'wibble' (see 'lll --help')"
}

/// 1.0 fleet case 20: five of ten agents typed 'lll read KEY', one 'lll FLEET-4'.
#[test]
fn an_issue_alias_or_key_as_the_command_names_the_issue_verb() {
  assert refusal(["lll", "read", "FLEET-4"]).contains("it is an issue verb: 'lll issue view FLEET-4'")
  assert refusal(["lll", "show", "FLEET-4"]).contains("'lll issue view FLEET-4'")
  assert refusal(["lll", "FLEET-4"]).contains("is an issue ID; to see it use 'lll issue view FLEET-4'")
  assert refusal(["lll", "frobnicate"]) == "unknown command: 'frobnicate' (see 'lll --help')"
}

/// 1.0 fleet case 20, run 3: 'lll send KEY' and 'lll note KEY' ask the guess
/// table too.
#[test]
fn an_issue_synonym_as_the_command_names_the_issue_form() {
  assert refusal(["lll", "send", "FLEET-4"]).contains("--state in-review")
  assert refusal(["lll", "note", "FLEET-4"]).contains("lll issue comment FLEET-4")
  assert refusal(["lll", "move", "FLEET-4"]).contains("--state in-review")
}

/// Case 20: 'lll comment add KEY' must not suggest the refused 'issue comment add'.
#[test]
fn a_non_key_second_word_is_not_carried_into_the_suggestion() {
  assert refusal(["lll", "comment", "add"]).contains("'lll issue comment ...'")
}

/// Every noun's verbs are searched, not only the issue's: fleet case 11 was
/// 'lll invite' when invite was a member verb.
#[test]
fn another_nouns_verb_as_the_command_names_its_noun() {
  assert refusal(["lll", "access", "ada"]).contains("it is a member verb: 'lll member access ...'")
  assert refusal(["lll", "rotate", "bot-x"]).contains("it is a bot verb: 'lll bot rotate ...'")
}

/// An update field typed as a verb names the update flag (1.0 fleet, case
/// 18), with its values when it has a closed set (case 20).
#[test]
fn an_update_field_typed_as_a_verb_names_the_flag() {
  assert refusal(["lll", "issue", "priority"]).starts_with("unknown issue command 'priority'; to change it use 'lll issue update KEY-123 --priority <name>' (one of: none, urgent")
  assert refusal(["lll", "issue", "state", "FLEET-4"]).contains("--state <name>' (one of: backlog, todo, in-progress, in-review, done, cancelled)")
  // 'title' is a verb of its own.
  assert refusal(["lll", "issue", "title"]) == ""
}

/// 1.0 fleet case 20: 'issue note' and 'issue review' name the real verbs.
#[test]
fn note_and_review_point_at_comment_and_in_review() {
  assert refusal(["lll", "issue", "note"]).contains("lll issue comment KEY-123")
  assert refusal(["lll", "issue", "review"]).contains("--state in-review")
  assert refusal(["lll", "issue", "assign"]).contains("lll issue claim KEY-123")
}

/// 1.0 fleet case 20, run 3: a key in the verb slot names the verb-first form.
#[test]
fn a_key_where_the_verb_goes_names_the_verb_first_form() {
  assert refusal(["lll", "issue", "FLEET-4", "review"]).contains("put the verb first: 'lll issue view FLEET-4'")
}

/// 'lll issue comment list KEY': the sub-verbs are edit and delete.
#[test]
fn a_comment_sub_verb_guess_names_the_form_that_does_it() {
  assert refusal(["lll", "issue", "comment", "list", "FLEET-4"]).contains("'lll issue comment FLEET-4' lists the comments, numbered; the sub-verbs are edit and delete")
  assert refusal(["lll", "issue", "comment", "add", "FLEET-4"]).contains("adds one")
  assert runs(["lll", "issue", "comment", "FLEET-4", "hello"])
  assert runs(["lll", "issue", "comment", "edit", "FLEET-4", "1", "-b", "x"])
}

/// 1.0 fleet: claiming by update was guessed three times. That one guess
/// is in the table; another verb's name as a flag is not read as a verb
/// (PR #348 review: '--delete' on a comment pointed at deleting the issue).
#[test]
fn only_the_guessed_flag_names_another_verb() {
  assert refusal(["lll", "issue", "update", "FLEET-4", "--claim"]) == "update does not claim; to claim, run: lll issue claim FLEET-4"
  assert refusal(["lll", "issue", "update", "--claim"]) == "update does not claim; to claim, run: lll issue claim KEY"
  // A declared flag is never refused: 'issue next --claim' claims.
  assert runs(["lll", "issue", "next", "--claim"])
  for args in [
    ["lll", "issue", "comment", "FLEET-4", "1", "--delete"],
    ["lll", "issue", "comment", "FLEET-4", "--edit"],
    ["lll", "label", "edit", "bug", "--delete"],
    ["lll", "issue", "view", "FLEET-4", "--id"],
  ] {
    let msg = refusal(args)
    assert msg.starts_with("unknown flag: '--")
    assert !msg.contains("run: lll")
  }
  // The --url teaching survives on every issue verb.
  assert refusal(["lll", "issue", "list", "--url", "http://x"]).contains("This command takes no --url")
}

/// Server-wide and offline commands get no LLL_TEAM override hint, offline
/// ones no endpoint text; whoami names its bare form (LLL-493).
#[test]
fn scope_hints_fit_the_command() {
  for args in [["lll", "version", "--team", "X"], ["lll", "completions", "bash", "--team", "X"]] {
    assert refusal(args).contains("is server-wide: no team applies to it")
  }
  assert !refusal(["lll", "version", "--url", "http://x"]).contains("endpoint")
  assert !refusal(["lll", "completions", "bash", "--url", "http://x"]).contains("endpoint")
  assert refusal(["lll", "whoami", "--team", "X"]).contains("run it bare to see the identity, server and team")
}

/// Value refusals outside the parser speak through the rule too.
#[test]
fn value_refusals_share_one_shape() {
  assert flags.not_in("confidence", "maybe", ["suspected", "confirmed"]) == "unknown confidence 'maybe' (use one of: suspected, confirmed; 'finding refute SLUG -b why' is how a finding becomes refuted)"
  assert refusal(["lll", "issue", "create", "-t", "x", "--priority", "9"]).starts_with("unknown priority '9' (use one of: none, urgent, high, medium, low, 0, 1, 2, 3, 4)")
  assert runs(["lll", "issue", "create", "-t", "x", "--priority", "HIGH"])
  assert refusal(["lll", "team", "set-emoji", "ENG"]).starts_with("the emoji is one emoji; an empty '' clears it")
}

/// The 1.0 fleet: one member's details live under access; 'lll bot list'
/// suggested creating a bot named "list".
#[test]
fn member_view_and_bot_list_name_where_the_answer_lives() {
  assert refusal(["lll", "member", "view", "ada"]).contains("did you mean 'lll member access NAME'?")
  for verb in ["list", "read"] {
    let msg = refusal(["lll", "bot", verb, "bot-x"])
    assert msg.contains(f"unknown bot command: '{verb}'; bot has create and rotate; see one bot with 'lll member access bot-NAME', all of them with 'lll member list'")
    assert !msg.contains("bot create bot-")
  }
  // Any other word is the bot's name.
  assert runs(["lll", "bot", "claude-main"])
  assert runs(["lll", "bot", "bot-x", "--env"])
}

/// --help exits 0 everywhere, version --zz is a usage error (1.0 fleet).
#[test]
fn help_is_a_page_and_stray_arguments_are_usage_errors() {
  assert help_page(["lll", "version", "--help"]).starts_with("lll version - print the version")
  assert help_page(["lll", "-v", "-h"]).starts_with("lll version - print the version")
  assert refusal(["lll", "version", "--zz"]).starts_with("unknown flag: '--zz'")
  assert refusal(["lll", "--version", "extra"]).starts_with("unexpected argument: 'extra'")
  assert help_page(["lll", "config", "show", "--help"]).starts_with("usage: lll config list")
  assert help_page(["lll", "bot", "--help"]) == help_page(["lll", "bot", "create", "--help"])
  assert help_page(["lll", "invite", "create", "--help"]) != ""
}

/// 'lll whoami --team X' (LLL-493, fleet case 05): the refusal teaches the
/// one-command override.
#[test]
fn a_team_flag_on_an_unscoped_command_teaches_the_override() {
  let msg = refusal(["lll", "whoami", "--team", "FLEET"])
  assert msg.contains("unknown flag: '--team'")
  assert msg.contains("LLL_TEAM=FLEET")
  assert msg.contains("saved attachment unchanged")
  assert refusal(["lll", "whoami", "--zz"]).starts_with("unknown flag: '--zz'")
  assert runs(["lll", "whoami", "--json"])
}

/// Enum values are checked before any handler runs, and the usage line
/// shows them.
#[test]
fn a_value_outside_a_closed_set_is_refused_with_the_set() {
  assert refusal(["lll", "issue", "list", "--state", "review"]) == "unknown state 'review'; did you mean 'in-review'? (use one of: backlog, todo, in-progress, in-review, done, cancelled)"
  assert refusal(["lll", "doc", "create", "--kind", "memo"]).starts_with("unknown kind 'memo' (use one of: wiki, finding, decision, prd)")
  assert runs(["lll", "issue", "list", "--state", "In-Review"])
  assert help_page(["lll", "project", "create", "-h"]).contains("[--status planned|started|paused|completed|cancelled]")
}

/// A missing required positional is a usage error before the handler runs.
#[test]
fn a_missing_argument_is_a_usage_error() {
  assert refusal(["lll", "issue", "attach", "FLEET-4"]).starts_with("usage: lll issue attach KEY-123 FILE")
  assert refusal(["lll", "skill", "get"]).starts_with("skills: ")
  assert runs(["lll", "skill", "get", "lll"])
}

/// `lll help contract` ends with a reference generated from the table, and
/// the prose contract's permanent spellings are the table's.
#[test]
fn the_contract_reference_is_the_table() {
  let reference = flags.contract_commands(nouns())
  assert reference.contains("| `lll issue view` | no | yes | `show`, `read` (hidden) |")
  assert reference.contains("| `lll issue comment edit` | yes | no |  |")
  assert reference.contains("| `lll version` | no | no | `lll --version`, `lll -v` |")
  assert !reference.contains("`lll finding view`")
  let spellings = strings.SplitN(docs.Contract(), "## Spellings", 2).get(1).unwrap_or("")
  for n in nouns() {
    for c in flags.verbs_of(n) {
      for alias in [c.alias, c.hidden_alias].filter(|a| a != "") {
        assert strings.Contains(spellings, f"`{alias}`")
      }
    }
  }
}

/// Every verb that reads and prints structured data takes --json (LLL-684);
/// the rest print one scalar, a script, raw bytes or markdown.
#[test]
fn every_structured_read_takes_json() {
  let scalar = ["lll issue download", "lll issue url", "lll issue id", "lll issue title", "lll issue branch-name", "lll board", "lll config get", "lll config check", "lll skill get", "lll completions bash", "lll completions zsh", "lll completions fish", "lll version"]
  for n in nouns() {
    let rows = match n.shape {
      flags.Shape.Single(c) => [(f"lll {n.name}", c)],
      flags.Shape.Verbs(cmds) | flags.Shape.VerbsOr(cmds, _) => cmds.map(|c| (f"lll {n.name} {c.name}", c)),
      flags.Shape.Topics => [],
    }
    for (path, c) in rows {
      let reads = match c.access { flags.Access.Read => true, flags.Access.Write => false }
      if reads && !flags.takes_json(c) && !scalar.contains(path) {
        assert path == "a read verb without --json"
      }
    }
  }
}

/// Wording the fleet tuned and e2e pins: a stray argument to 'skill list'
/// names 'skill get', and an unknown shell is called one.
#[test]
fn a_stray_argument_or_shell_names_what_was_meant() {
  assert refusal(["lll", "skill", "list", "lll"]).contains("use 'lll skill get NAME' to read one skill")
  assert refusal(["lll", "completions", "tcsh"]).contains("unknown shell (expected bash, zsh, or fish)")
  assert !refusal(["lll", "issue", "list", "x"]).contains("skill")
}

/// Final 1.0 replay, case 20: the word after a key typed as the command says
/// which verb was meant, and a redirected comment or update shows its full
/// form.
#[test]
fn a_key_first_command_names_the_meant_verb() {
  for next in ["status", "review", "--state", "mark"] {
    assert refusal(["lll", "FLEET-4", next, "x"]).contains("to change its state use 'lll issue update FLEET-4 --state in-review'")
  }
  assert refusal(["lll", "FLEET-4", "comment", "x"]).contains("to comment use 'lll issue comment FLEET-4 \"text\"'")
  assert refusal(["lll", "FLEET-4", "frob"]).contains("put the verb first: 'lll issue view FLEET-4', to change its state")
  assert refusal(["lll", "FLEET-4"]).contains("to see it use 'lll issue view FLEET-4'")
  assert refusal(["lll", "comment", "FLEET-4", "x"]).contains("'lll issue comment FLEET-4 \"text\"'")
  assert refusal(["lll", "update", "FLEET-4"]).contains("'lll issue update FLEET-4 --state <name>'")
  assert refusal(["lll", "comment", "add"]).contains("'lll issue comment ...'")
  assert refusal(["lll", "mark", "FLEET-4"]).contains("--state in-review")
}

/// Final 1.0 replay, case 20: set, mark and any review word name the state
/// change; `issue comments` reads comments (case 18).
#[test]
fn state_guesses_name_update_state() {
  for word in ["set", "mark", "send-review", "to-review", "review"] {
    assert refusal(["lll", "issue", word, "FLEET-4"]).contains("'lll issue update FLEET-4 --state in-review'")
  }
  assert runs(["lll", "issue", "comments", "FLEET-4"])
}

/// Final 1.0 replay: a stray status word names --state (case 20), a second
/// key says one key per call (cases 13 and 09).
#[test]
fn a_stray_argument_names_what_was_meant() {
  assert refusal(["lll", "issue", "update", "FLEET-4", "status", "review"]).starts_with("unexpected argument: 'status'; to change the state use --state <name>")
  assert refusal(["lll", "issue", "view", "FLEET-4", "FLEET-5"]).starts_with("unexpected argument: 'FLEET-5'; this takes one issue key")
  assert refusal(["lll", "issue", "view", "FLEET-4", "extra"]).starts_with("unexpected argument: 'extra'")
  assert !refusal(["lll", "issue", "view", "FLEET-4", "extra"]).contains("one issue key")
}

/// Final 1.0 replay, cases 04 and 15: a read verb a noun lacks points at
/// its list; member read/get point at access.
#[test]
fn a_read_verb_the_noun_lacks_points_at_its_list() {
  for word in ["view", "read", "ls"] {
    assert refusal(["lll", "config", word]).starts_with(f"unknown config command: '{word}'; did you mean 'lll config list'?")
  }
  for word in ["read", "get"] {
    assert refusal(["lll", "member", word, "ada"]).contains("did you mean 'lll member access NAME'?")
  }
  assert runs(["lll", "config", "show"])
}

/// A noun with few verbs names them: 'lll skill frob' said "expected list
/// or get" in 1.0.
#[test]
fn a_noun_with_few_verbs_names_them() {
  assert refusal(["lll", "skill", "frob"]) == "unknown skill command: 'frob'; expected list or get (see 'lll skill --help')"
  assert refusal(["lll", "webhook", "frob"]).contains("expected add, list or remove")
}

/// #348 merge review: a flag where the verb goes is an unknown flag, not a
/// verb guess ('lll completions --bogus' is no unknown shell).
#[test]
fn a_flag_after_a_noun_is_an_unknown_flag() {
  for noun in ["completions", "skill", "webhook", "issue"] {
    assert refusal(["lll", noun, "--bogus"]) == f"unknown flag: '--bogus' (see 'lll {noun} --help')"
  }
  // bot's flags belong to its bare create form.
  assert refusal(["lll", "bot", "--bogus"]).starts_with("unknown flag: '--bogus'\nusage: lll bot bot-NAME")
}

/// A review word with a slash keeps the review hint, as 1.0's contains test did.
#[test]
fn a_review_word_with_a_slash_names_in_review() {
  assert refusal(["lll", "issue", "send/review", "FLEET-4"]).contains("'lll issue update FLEET-4 --state in-review'")
  assert refusal(["lll", "send/review", "FLEET-4"]).contains("--state in-review")
}

/// --token excludes --password, so login's own refusal names the mistake
/// instead of the parser calling it a stdin conflict (1.0 wording).
#[test]
fn an_exclusive_pair_is_not_a_stdin_conflict() {
  assert runs(["lll", "login", "--password", "-", "--token", "-"])
  assert refusal(["lll", "login", "--token", "-", "--admin-password", "-"]).starts_with("only one of --token and --admin-password can read stdin")
}

/// LLL-695: a hint echoes the key the user typed, not a KEY-123
/// placeholder, wherever the guess came from.
#[test]
fn a_guess_hint_echoes_the_typed_key() {
  assert refusal(["lll", "issue", "assign", "DEMO-4"]).contains("'lll issue claim DEMO-4'; assign someone else with 'lll issue update DEMO-4 --assignee NAME'")
  assert refusal(["lll", "issue", "depends", "DEMO-4"]).contains("'lll issue block DEMO-4 BLOCKER' records that DEMO-4 waits on BLOCKER")
  assert refusal(["lll", "issue", "review", "DEMO-4"]).contains("'lll issue update DEMO-4 --state in-review'")
  assert refusal(["lll", "issue", "priority", "DEMO-4"]).contains("'lll issue update DEMO-4 --priority <name>'")
  assert refusal(["lll", "issue", "comment", "list", "DEMO-4"]).contains("'lll issue comment DEMO-4' lists the comments")
  assert refusal(["lll", "send", "DEMO-4"]).contains("'lll issue start DEMO-4' sets in-progress")
  // No key typed, or a word that is no key: the placeholder stays.
  assert refusal(["lll", "issue", "assign"]).contains("'lll issue claim KEY-123'")
  assert refusal(["lll", "issue", "assign", "bob"]).contains("'lll issue claim KEY-123'")
}

/// LLL-695: 'lll comment add KEY' names the runnable form, key and body
/// included; a real sub-verb keeps its place.
#[test]
fn a_misplaced_comment_add_names_key_and_text() {
  assert refusal(["lll", "comment", "add", "DEMO-4"]).contains("it is an issue verb: 'lll issue comment DEMO-4 \"text\"'")
  assert refusal(["lll", "comment", "add", "DEMO-4", "hi"]).contains("'lll issue comment DEMO-4 \"text\"'")
  assert refusal(["lll", "comment", "edit", "DEMO-4", "2"]).contains("'lll issue comment edit DEMO-4 ...' (see 'lll issue comment edit -h')")
  assert refusal(["lll", "comment", "frob", "DEMO-4"]).contains("'lll issue comment ...'")
}

/// LLL-702: a verb's example is the last thing its help prints, under
/// Example:, whether the page is generated or hand-written.
#[test]
fn a_verb_example_ends_its_help() {
  assert help_page(["lll", "issue", "claim", "--help"]).ends_with("\n\nExample:\n  lll issue claim DEMO-4 --agent worker-1")
  assert help_page(["lll", "issue", "close", "-h"]).ends_with("\n\nExample:\n  lll issue close DEMO-3")
  assert help_page(["lll", "search", "--help"]).ends_with("\n\nExample:\n  lll search \"login redirect\" --issues")
  assert help_page(["lll", "bot", "--help"]).ends_with("\n\nExample:\n  lll bot create bot-myrepo")
  assert help_page(["lll", "issue", "update", "--help"]).contains("'lll issue block KEY-123 BLOCKER' records one")
  assert !help_page(["lll", "issue", "view", "--help"]).contains("Example:")
}
