import "records"
import "go:net/http"
import "go:net/url"

import "models"
import "query"

// GET /projects - the project list, with each issue count linking to the
// /issues filter that produced it.

/// The projects list: the read path a project has never had.
///
/// A project is created by `lll project create` or the Projects section of
/// /settings, and until now that settings row was the only place one was ever
/// shown — the relation was write-only, which is worse than no relation
/// because it accumulates data nobody can check. This page is the cheapest
/// honest read path: name, status, scope, and the issue count, with the count
/// linking to /issues pre-filtered to that project.
///
/// No SSE, for the reason /issues and /settings have none: the bridge
/// broadcasts one unfiltered #board to every board-scoped client, so a page
/// that subscribed would be morphed into the board. Nothing here changes
/// often enough to pay for a second scope.
fn projects_page(
  w: http.ResponseWriter,
  // The server scopes this page to its selected team.
  r: Ref<http.Request>,
  team_id: string,
  me: string,
) {
  let team = shell_team(team_id)
  let vm = match projects_vm(team_id, team.key) {
    Ok(v) => v,
    Err(e) => {
      http.Error(w, e, 500)
      return
    },
  }
  if wants_raw(r) {
    write_raw(w, projects_raw(vm, team.key))
    return
  }
  let page = PageVM { rail: rail_for(r, "projects", me, team), page: vm }
  let html = match render("projects-page", page) {
    Ok(h) => h,
    Err(e) => {
      http.Error(w, e, 500)
      return
    },
  }
  w.Header().Set("Cache-Control", "no-store")
  w.Header().Set("Content-Type", "text/html; charset=utf-8")
  let _ = w.Write(html.bytes())
}

fn projects_vm(team_id: string, team_key: string) -> Result<ProjectsVM, string> {
  let projects = records.fetch_projects(team_id)?
  // LLL-426: into THIS team's table, not the configured team's.
  let base = issues_base(team_key)
  Ok(ProjectsVM {
    projects: projects.map(|p| ProjectVM {
      name: p.name,
      description: snippet(p.description),
      status: p.status,
      status_label: state_label(p.status),
      tone: project_tone(p.status),
      count: project_count(team_id, p.id),
      href: f"{base}?project={url.QueryEscape(p.name)}",
    }),
  })
}

/// The state hue a project status borrows for its dot. It reuses the six
/// --st-* tokens rather than minting five more: a project lifecycle is the
/// issue lifecycle at a coarser grain, and DESIGN.md rations colour hard.
fn project_tone(status: string) -> string {
  match status {
    "started" => "in-progress",
    "completed" => "done",
    "cancelled" => "cancelled",
    "paused" => "backlog",
    _ => "todo",
  }
}

/// How many issues point at one project. Scoped by the same team the table
/// scopes by, so the count and the /issues link it labels always agree — a
/// project owned by another team reads 0 rather than a number no page shows.
///
/// A project's issue count, or 0 when the count cannot be had: the projects
/// page would rather render with a zero than not render.
fn project_count(team_id: string, project_id: string) -> int {
  issue_count(query.filter(team_id, "", "", project_id, "", "")).unwrap_or(0)
}
