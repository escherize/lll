    flags.Flag { name: "--json", help: "print the comments as a JSON list, or with a body the new comment's record", .. },
    flags.Flag {
      name: "--agent",
      value: true,
      hint: "NAME",
      help: "self-asserted session label, for agents sharing one member token\n(default: LLL_AGENT)",
      ..,
    },
  ])
}

