}

fn title_cmd(args: Slice<string>) -> Result<(), string> {
  let usage = "lll issue title [KEY-123]"
  let id = positional_id(args, usage)?
  let resolved = resolve_id(id, usage)?
  let issue = fetch_issue(resolved)?
  fmt.Println(issue.title)
  Ok(())
}

/// Thin wrapper over the GitHub CLI: gh owns pushing checks, prompts, and
/// errors — we only supply the KEY-prefixed title and an issue-linking body.
fn pr_cmd(args: Slice<string>) -> Result<(), string> {
  let usage = "lll issue pr [KEY-123]"
  let id = positional_id(args, usage)?
  let resolved = resolve_id(id, usage)?

  let mut gh = ""
  match exec.LookPath("gh") {
    Partial.Ok(path) => gh = path,
    _ => return Err(
      "gh not found on PATH — install the GitHub CLI (brew install gh)",
    ),
  }

  let issue = fetch_issue(resolved)?
  let key = f"{issue.expand.team.key}-{issue.number}"
  let mut body = issue_url(issue)?
  if issue.description != "" { body = f"{body}\n\n{issue.description}" }

  let cmd = exec.Command(
    gh,
    "pr",
    "create",
    "--title",
    f"{key}: {issue.title}",
    "--body",
    body,
  )
  cmd.Stdin = Some(os.Stdin)
  cmd.Stdout = Some(os.Stdout)
  cmd.Stderr = Some(os.Stderr)
  if let Err(e) = cmd.Run() { return Err(f"gh pr create: {e}") }
  Ok(())
}

/// Web page URL for an issue: <web_url>/issue/KEY-123.
fn issue_url(issue: models.Issue) -> Result<string, string> {
  let base = web_base()?
  Ok(f"{base}/issue/{issue.expand.team.key}-{issue.number}")
}

/// An issue's comments, oldest first, author expanded.
fn fetch_comments(issue_id: string) -> Result<Slice<models.Comment>, string> {
  let filter = url.QueryEscape(f"issue='{issue_id}'")
  let mut comments = models.CommentList { .. }
  pb.fetch(
    f"/api/collections/comments/records?filter={filter}&sort=created&expand=author&perPage=200",
    "comments",
    &comments,
  )?
  Ok(comments.items)
}

/// Print comments as "author (3h ago)" then the indented body.
fn print_comments(comments: Slice<models.Comment>) {
  for c in comments {
    let mut author = c.expand.author.name
    if author == "" { author = "anon" }
    fmt.Println(f"{author} ({display.relative(c.created)})")
    fmt.Println(f"  {c.body}")
  }
}

/// Resolve a member by name; unknown names error with the fix.
fn resolve_member(name: string) -> Result<models.Member, string> {
  let Some(m) = find_member(name)? else {
    return Err(f"no member named '{name}' — see 'lll member list'")
  }
  Ok(m)
}

/// Parse `[KEY-123]` as the only allowed argument (verbs without flags).
fn positional_id(args: Slice<string>, usage: string) -> Result<string, string> {
  let mut id = ""
  let mut i = 3
  while i < args.length() {
    let arg = args[i]
    if arg.starts_with("-") {
      return Err(f"unknown flag: '{arg}'\nusage: {usage}")
    }
    if id != "" { return Err(f"unexpected argument: '{arg}'") }
    id = arg
    i += 1
  }
  Ok(id)
}

/// Resolution order: explicit arg > current git branch (eng-12-slug -> ENG-12)
/// > error with a hint.
/// Accept a pasted board URL anywhere a KEY-123 is expected — the same courtesy
/// mb-shares' `share` extends to its slugs. Strips `scheme://host/`, an
/// `issue/` path prefix and a trailing slash; anything that is not shaped like
/// a URL is returned untouched, so a bare key stays a bare key and a bad value
/// still fails downstream with the usual "not an issue ID" message.
fn deslug(arg: string) -> string {
  // All splitting, no index arithmetic: byte offsets and rune indices disagree
  // on non-ASCII input and panic. See realtime.split_field.
  let mut a = arg
  if strings.Contains(a, "://") {
    let after_scheme = strings.SplitN(a, "://", 2)[1]
    if !strings.Contains(after_scheme, "/") { return arg }
    a = strings.SplitN(after_scheme, "/", 2)[1]
  } else if !strings.Contains(a, "/") { return arg }
  a = strings.TrimSuffix(a, "/")
  a = strings.TrimPrefix(a, "issue/")
  if strings.Contains(a, "/") { return arg }
  if a == "" { return arg }
  a
}

fn resolve_id(explicit: string, usage: string) -> Result<string, string> {
  if explicit != "" { return Ok(deslug(explicit)) }
  let Some(branch) = gitctx.current_branch() else {
    return Err(
      f"no issue ID given and no git branch to infer one from\nusage: {usage}",
    )
  }
  let Some(id) = gitctx.issue_id_from_branch(branch) else {
    return Err(
      f"no issue ID given and current branch '{branch}' doesn't look like eng-123-...\nusage: {usage}",
    )
  }
  Ok(id)
}

/// Split a KEY-123 identifier into its team key and issue number. The key may
/// itself contain hyphens (`ENG-DEV-12` is team `ENG-DEV`, issue 12), so the
/// number is the last segment and the key is everything before it.
fn split_issue_key(id: string) -> Result<(string, int), string> {
  let bad_id = f"'{id}' is not an issue ID (expected KEY-123, e.g. ENG-1)"
  // Split, not LastIndex + substring: index arithmetic mixes byte offsets with
  // rune indices and panics on non-ASCII input. See realtime.split_field.
  let parts = strings.Split(id, "-")
  if parts.length() < 2 { return Err(bad_id) }
  let number_part = parts[parts.length() - 1]
  let team_key = strings.TrimSuffix(id, f"-{number_part}")
  if team_key == "" || number_part == "" { return Err(bad_id) }
  let Ok(number) = strconv.Atoi(number_part) else {
    return Err(bad_id)
  }
  Ok((team_key, number))
}

/// Fetch an issue by KEY-123 and return the raw PB record JSON (team,
/// assignee, labels, project expanded).
fn fetch_issue_record(id: string) -> Result<string, string> {
  let (team_key, number) = split_issue_key(id)?

  let not_found = f"issue {id} not found — check 'lll issue list' or LLL_TEAM"
  let Some(team) = find_team(team_key)? else {
    return Err(not_found)
  }

  let filter = url.QueryEscape(
    f"{query.filter(team.id, "", "", "", "", "")} && number={number}",
  )
  let mut issues = models.IssueList { .. }
  pb.fetch(
    f"/api/collections/issues/records?filter={filter}&perPage=1",
    "issues",
    &issues,
  )?
  let Some(item) = issues.items.get(0) else {
    return Err(not_found)
  }

  pb.get(
    f"/api/collections/issues/records/{item.id}?expand=team,assignee,labels,project",
  )
}

/// fetch_issue_record, decoded.
fn fetch_issue(id: string) -> Result<models.Issue, string> {
  let record = fetch_issue_record(id)?
  let mut full = models.Issue { .. }
  if let Err(e) = json.Unmarshal(record.bytes(), &full) {
    return Err(f"decoding issue: {e}")
  }
  Ok(full)
}

/// JSON-encode a string value (quotes + escaping).
fn json_quote(value: string) -> Result<string, string> {
  match json.Marshal(value) {
    Ok(b) => Ok(b as string),
    Err(e) => Err(f"encoding value: {e}"),
  }
}

fn find_team(key: string) -> Result<Option<models.Team>, string> {
  let filter = url.QueryEscape(f"key='{key}'")
  let mut result = models.TeamList { .. }
  pb.fetch(f"/api/collections/teams/records?filter={filter}", "teams", &result)?
  Ok(result.items.find(|t| t.key == key))
}

// ------------------------------------------------------------- doc links

/// Parse the two positional arguments `KEY SLUG` (link/unlink take no
/// flags; positional_id handles only one).
fn two_positional(
  args: Slice<string>,
  usage: string,
) -> Result<(string, string), string> {
  let mut first = ""
  let mut second = ""
  let mut i = 3
  while i < args.length() {
    let arg = args[i]
    if arg.starts_with("-") {
      return Err(f"unknown flag: '{arg}'\nusage: {usage}")
    }
    if second != "" { return Err(f"unexpected argument: '{arg}'") }
    if first == "" { first = arg } else { second = arg }
    i += 1
  }
  Ok((first, second))
}

/// Docs linked to an issue. The issue -> doc direction is not stored: it is
/// one `?=` filter over docs.issues, which is the whole reason links are a
/// relation and not a write-once reference on the issue.
fn fetch_issue_docs(issue_id: string) -> Result<Slice<models.Doc>, string> {
  let filter = url.QueryEscape(f"issues.id ?= '{issue_id}'")
  let mut docs = models.DocList { .. }
  pb.fetch(
    f"/api/collections/docs/records?filter={filter}&sort=slug&perPage=200",
    "docs",
    &docs,
  )?
  Ok(docs.items)
}

fn set_doc_issues(
  doc: models.Doc,
  issue_ids: Slice<string>,
) -> Result<(), string> {
  let encoded = match json.Marshal(issue_ids) {
    Ok(b) => b as string,
    Err(e) => return Err(f"encoding issues: {e}"),
  }
  let _ = pb.patch(
    f"/api/collections/docs/records/{doc.id}",
    "{\"issues\":" + encoded + "}",
  )?
  Ok(())
}

/// Refuse a link whose two ends live in different teams (TASK-173). The doc
/// is looked up in the CONFIGURED team, the issue is whatever KEY-123 names,
/// so `LLL_TEAM=LLL lll issue link GRDN-4 index` would otherwise quietly
/// stitch the two boards' link graphs together.
fn cross_team_link(
  issue: models.Issue,
  team: models.Team,
  d: models.Doc,
) -> Result<(), string> {
  if d.team == issue.team { return Ok(()) }
  let key = f"{issue.expand.team.key}-{issue.number}"
  Err(
    f"{key} is in {issue.expand.team.key} and doc '{d.slug}' is in {team.key} — a link stays inside one team",
  )
}

fn link(args: Slice<string>) -> Result<(), string> {
  let usage = "lll issue link KEY-123 SLUG"
  let (id, slug) = two_positional(args, usage)?
  if id == "" || slug == "" { return Err(f"usage: {usage}") }
  let resolved = resolve_id(id, usage)?
  let issue = fetch_issue(resolved)?
  let key = f"{issue.expand.team.key}-{issue.number}"
  let team = current_team()?
  let d = fetch_doc(team, slug)?
  cross_team_link(issue, team, d)?

  if d.issues.find(|x| x == issue.id).is_some() {
    fmt.Println(f"{key} is already linked to {d.slug}")
    return Ok(())
  }
  set_doc_issues(d, d.issues.append(issue.id))?
  fmt.Println(f"Linked {key} -> {d.slug}")
  Ok(())
}

fn unlink(args: Slice<string>) -> Result<(), string> {
  let usage = "lll issue unlink KEY-123 SLUG"
  let (id, slug) = two_positional(args, usage)?
  if id == "" || slug == "" { return Err(f"usage: {usage}") }
  let resolved = resolve_id(id, usage)?
  let issue = fetch_issue(resolved)?
  let key = f"{issue.expand.team.key}-{issue.number}"
  let team = current_team()?
  let d = fetch_doc(team, slug)?
  cross_team_link(issue, team, d)?

  let mut remaining: Slice<string> = []
  for x in d.issues {
    if x != issue.id { remaining = remaining.append(x) }
  }
  if remaining.length() == d.issues.length() {
    return Err(f"{key} is not linked to {d.slug} — see 'lll doc view {d.slug}'")
  }
  set_doc_issues(d, remaining)?
  fmt.Println(f"Unlinked {key} from {d.slug}")
  Ok(())
}
