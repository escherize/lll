    flags.Flag { name: "--json", help: "print the comments as a JSON list, or with a body the new comment's record", .. },
    flags.Flag {
      name: "--agent",
      value: true,
      hint: "NAME",
      help: "self-asserted session label, for agents sharing one member token\n(default: LLL_AGENT)",
      ..,
    },
  ])
}

pub fn issue_watch_spec() -> Slice<flags.Flag> {
  flags.with_team([
    flags.Flag {
      name: "--json",
      help: "NDJSON: one raw server event object per line, with a\n\"topic\" field added",
      ..,
    },
    flags.Flag {
      name: "--until",
      alias: "",
      value: true,
      hint: "text",
      help: "exit 0 once a comment containing text arrives (or is already\nthere); --json reports an existing match as action=snapshot",
      ..,
    },
    flags.Flag {
      name: "--timeout",
      value: true,
      hint: "seconds",
      help: "with --until: give up after this many seconds, exit non-zero",
      ..,
    },
