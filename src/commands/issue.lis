}

/// Dispatch `lll issue <verb>` through the noun's Command table (TASK-307).
/// The table is the one place a verb is declared: dispatch, `lll issue --help`
/// and shell completions all read it, so none of the three can drift.
pub fn issue(ctx: pb.Client, args: Slice<string>) -> Result<(), pb.CliError> {
  let cmds = issue_commands()
  if let Some(hint) = issue_synonym(args.get(2).unwrap_or("")) {
    return Err(flags.usage_error(hint))
  }
  if args.get(2) == Some("comment") && ["edit", "delete"].contains(args.get(3).unwrap_or("")) {
    let subargs = args[..2].append(args[3..]...)
    return flags.dispatch(ctx, "issue comment", "change a comment", "", comment_commands(), subargs)
  }
  if args.get(2) == Some("comment") {
    if let Some(hint) = comment_verb_hint(args.get(3).unwrap_or("")) {
      return Err(flags.usage_error(hint))
    }
  }
  flags.dispatch(ctx, "issue", "work with issues", issue_intro(), cmds, args)
}

/// `lll issue comment list KEY` and its kin: the only sub-verbs are edit and
/// delete, so name what each guessed word is spelled as instead of letting
/// the word fail as an issue ID.
fn comment_verb_hint(word: string) -> Option<string> {
  let hint = match word {
    "list" | "ls" | "view" | "show" => "'lll issue comment KEY-123' lists the comments, numbered",
    "add" | "create" | "new" => "'lll issue comment KEY-123 \"body\"' adds one (or -b \"body\")",
    "update" | "rm" | "remove" => "'lll issue comment edit KEY-123 N -b \"body\"' and 'lll issue comment delete KEY-123 N' change one",
    _ => "",
  }
  if hint == "" { return None }
  Some(
    f"unknown issue comment command: '{word}' - {hint}; the sub-verbs are edit and delete (see 'lll issue comment -h')",
  )
}

/// Verbs agents reach for that are not verbs here, each pointed at the
/// one that is. Counts are from the fleet replay: 'assign' five times in
/// thirty-shard runs, the rest once or twice.
fn issue_synonym(verb: string) -> Option<string> {
  let hint = match verb {
    "assign" => "take it for yourself with 'lll issue claim KEY-123'; assign someone else with 'lll issue update KEY-123 --assignee NAME'",
    "unassign" => "'lll issue release KEY-123' gives a claim back; 'lll issue update KEY-123 --assignee none' clears the assignee",
    "move" | "transition" => "'lll issue start KEY-123' sets in-progress; any state: 'lll issue update KEY-123 --state s'",
    "status" => "'lll issue view KEY-123' shows the state; 'lll issue update KEY-123 --state s' sets it",
    "get" => "'lll issue view KEY-123'",
    "find" | "search" => "'lll search text' ranks every issue, comment and doc with context; 'lll issue list --search text' filters titles",
    "ls" => "'lll issue list'",
    "rm" | "remove" => "'lll issue delete KEY-123'",
    "comments" => "'lll issue comment KEY-123' lists them; add one with a body after the key",
    "depends" | "dep" | "blocked-by" | "blockedby" => "'lll issue block KEY-123 BLOCKER' records that KEY-123 waits on BLOCKER; 'lll issue list --ready' lists what can start",
    _ => "",
  }
  if hint == "" { return None }
  Some(f"unknown issue command: '{verb}'; {hint} (see 'lll issue -h')")
}

/// Every issue verb, as a value. `page` is the hand-written help `issue
/// create` already had; its former pre-parse `--help` check is gone because
/// dispatch answers it now, and parses args against `spec` before `run` so a
/// trailing -h can never reach the verb body. The summaries are the old
/// print_usage rows, one line each.
pub fn issue_commands() -> Slice<flags.Command> {
  [
    flags.Command {
      name: "attach", summary: "upload a file to an issue; appends without replacing existing attachments",
      spec: flags.with_team([json_after_flag("the issue")]), positional: "KEY-123 FILE", run: issue_attach,
      ..
    },
    flags.Command {
      name: "detach", summary: "remove an attachment by its stored filename (see issue view)",
      spec: flags.with_team([json_after_flag("the issue")]), positional: "KEY-123 FILENAME", run: issue_detach,
      ..
    },
    flags.Command {
      name: "download", summary: "write attachment bytes to stdout; redirect to a file",
      spec: flags.with_team([]), positional: "KEY-123 FILENAME", run: issue_download,
      ..
    },
    flags.Command {
      name: "create", alias: "new",
      summary: "create an issue in the configured team; -b - reads the description from stdin; without --state it starts in todo",
      page: issue_create_page(),
      spec: issue_create_spec(),
      positional: "[\"title\"]",
      run: create,
      ..
    },
    flags.Command {
      name: "list",
      summary: "list issues; scoped to the configured team",
      spec: issue_list_spec(),
      run: list,
      ..
    },
    flags.Command {
      name: "next",
      summary: "print the key of the one issue to work next - ready and unclaimed, then priority (urgent first), then oldest, then most-unblocking; --claim takes it",
      spec: issue_next_spec(),
      run: issue_next,
      ..
    },
    flags.Command {
      name: "view", alias: "show", hidden_alias: "read",
      summary: "show one issue in full, with comments; --raw prints it as plain markdown; -w opens its web page instead",
      spec: issue_view_spec(),
      positional: "[KEY-123]",
      run: view,
      ..
    },
    flags.Command {
      name: "update",
      alias: "edit",
      summary: "change fields (at least one flag)",
      spec: issue_update_spec(),
      positional: "[KEY-123]",
      run: update,
      ..
    },
    flags.Command {
      name: "close",
      summary: "set state done and release your claim (--keep-claim keeps it); another member's claimed issue needs --force, which comments why",
      spec: issue_close_spec(),
      positional: "[KEY-123]",
      run: close_issue,
      ..
    },
    flags.Command {
      name: "start",
      summary: "set state in-progress; --branch also git-switches to key-number-slug and records the work site",
      spec: issue_start_spec(),
      positional: "[KEY-123]",
      run: start,
      ..
    },
    flags.Command {
      name: "claim",
      summary: "take it exclusively for the authenticated member and assign it; exits non-zero, changing nothing, when someone already holds it; --renew restarts your hold's 24h expiry",
      spec: issue_claim_spec(),
      positional: "[KEY-123]",
      run: claim,
      ..
    },
    flags.Command {
      name: "release",
      summary: "remove your claim; clear assignee if it still matches the holder; --force takes another member's or another agent label's and comments why",
      spec: issue_release_spec(),
      positional: "[KEY-123]",
      run: release,
      ..
    },
    flags.Command {
      name: "delete",
      summary: "delete; asks [y/N] unless --yes; a claimed issue needs --force, which releases the claim first",
      spec: issue_delete_spec(),
      positional: "KEY-123",
      run: delete_issue,
      ..
    },
    flags.Command {
      name: "comment",
      summary: "add a comment (bare body or -b); 'comment KEY' lists them numbered; 'comment edit KEY N -b' and 'comment delete KEY N' change your own",
      spec: issue_comment_spec(),
      positional: "[KEY-123] [\"body\"]",
      run: comment,
      ..
    },
    flags.Command {
      name: "watch",
      summary: "stream live events for the issue and its comments until interrupted",
      spec: issue_watch_spec(),
      positional: "[KEY-123]",
      run: issue_watch,
      ..
    },
    flags.Command {
      name: "url",
      summary: "print the issue's web page URL",
      spec: flags.with_team([]),
      positional: "[KEY-123]",
      run: url_cmd,
      ..
    },
    flags.Command {
      name: "id",
      summary: "print the issue's KEY-123 identifier",
      spec: flags.with_team([]),
      positional: "[KEY-123]",
      run: id_cmd,
      ..
    },
    flags.Command {
      name: "title",
      summary: "print the issue's title",
      spec: flags.with_team([]),
      positional: "[KEY-123]",
      run: title_cmd,
      ..
    },
    flags.Command { name: "branch-name", summary: "print a suggested Git branch name; read-only", spec: flags.with_team([]), positional: "[KEY-123]", run: branch_name_cmd, .. },
    flags.Command {
      name: "pr",
      summary: "open a GitHub PR via 'gh pr create' and record gh#N; body links the issue and includes its description when it fits",
      spec: flags.with_team([]),
      positional: "[KEY-123]",
      run: pr_cmd,
      ..
    },
    flags.Command {
      name: "ref", summary: "append an external reference once (gh#42, linear:ENG-118)",
      spec: flags.with_team([json_after_flag("the issue")]), positional: "KEY-123 REF", run: ref_cmd,
      ..
    },
    flags.Command {
      name: "link",
      summary: "link the issue to a doc (see 'lll doc --help')",
      spec: flags.with_team([json_after_flag("the doc")]),
      positional: "KEY-123 SLUG",
      run: link,
      ..
    },
    flags.Command {
      name: "unlink",
      summary: "remove that link",
      spec: flags.with_team([json_after_flag("the doc")]),
      positional: "KEY-123 SLUG",
      run: unlink,
      ..
    },
    flags.Command {
      name: "block",
      summary: "record that KEY-123 cannot start until BLOCKER is done; view shows it, list --ready honours it",
      spec: flags.with_team([json_after_flag("the issue")]),
      positional: "KEY-123 BLOCKER",
      run: block,
      ..
    },
    flags.Command {
      name: "unblock",
      summary: "remove BLOCKER from KEY-123's blockers",
      spec: flags.with_team([json_after_flag("the issue")]),
      positional: "KEY-123 BLOCKER",
      run: unblock,
      ..
    },
  ]
}

/// Every flag across the issue verbs, deduplicated by canonical name
/// (first wording wins), in the order the table declares them. This is the
/// Flags: block `lll issue --help` renders under the verb rows.
fn issue_union_spec() -> Slice<flags.Flag> {
  let mut out: Slice<flags.Flag> = []
  for c in issue_commands() {
    for fl in c.spec {
      // Keyed by name AND aliases: -b is the description on create and
      // update, an alias of --reason on release, and every row belongs here.
      if out.find(|f| f.name == fl.name && f.alias == fl.alias).is_none() { out = out.append(fl) }
    }
  }
  out
}

/// Prose that belongs to the noun rather than to any one verb; dispatch
/// prints it under the verb table for `lll issue --help`. The union Flags:
/// block leads, as it did before the table, so no flag's help line is lost
/// from the noun page.
fn issue_intro() -> string {
  strings.TrimPrefix(flags.section(issue_union_spec()), "\n") +
    "

Web URLs come from LLL_WEB_URL, then 'web_url' in the repo or home config.
Set the deployed board address with 'lll config set web_url URL';
'lll up' saves the actual endpoint when it starts the board.

Full view --json preserves the issue record and adds comments (oldest first,
author expanded; a bot author's owner under author.expand.owner when you can
read it), claim ({id, member, holder, agent, claimed, renewed}, or null), docs
(explicit links), and findings (linked or label-area matches). Docs and findings
include their bodies and use slug order; empty collections are [].
Close releases the closer's own claim and keeps the assignee; --keep-claim
keeps the claim. Other state changes (including review) retain claims.
Release ends the hold; an assignment to someone other than the holder is
preserved. Forcing another holder's claim takes --force, with --reason for
the comment it leaves.

When KEY-123 is omitted (except for delete), it is inferred from the current
git branch: eng-12-fix-login resolves to ENG-12.

State glyphs: ◌ backlog  ○ todo  ◐ in-progress  ◉ in-review  ● done  ⊗ cancelled

The team comes from LLL_TEAM or 'team' in .lll.toml (see 'lll config --help')."
}

fn issue_create_page() -> string {
  "lll issue create - create an issue in the configured team

Usage:
  " +
    flags.usage("lll issue create", issue_create_spec(), "[\"title\"]") +
    "
" +
    flags.section(issue_create_spec()) +
    "

The title is the bare argument or -t; give either, not both.

The team comes from 'lll attach' ('team' in .lll.toml), or LLL_TEAM.
Without --state the issue starts in todo; --label may be repeated."
}

fn deslug(arg: string) -> string {
  // All splitting, no index arithmetic: byte offsets and rune indices disagree
  // on non-ASCII input and panic. See realtime.split_field.
  let mut a = arg
  if strings.Contains(a, "://") {
    let after_scheme = strings.SplitN(a, "://", 2)[1]
    if !strings.Contains(after_scheme, "/") { return arg }
    a = strings.SplitN(after_scheme, "/", 2)[1]
  } else if !strings.Contains(a, "/") { return arg }
  // TASK-144: a URL copied out of a browser carries `?utm_source=...` and
  // `#comment-3`, and neither names the issue. Cut them here, after the host
  // is gone (so a `?` cannot be read as path) and before the trailing slash
  // is trimmed (a share link puts the slash between the key and the query).
  // Fragment first: it may itself contain a `?`, and everything after `#` is
  // fragment.
  a = strings.SplitN(a, "#", 2)[0]
  a = strings.SplitN(a, "?", 2)[0]
  a = strings.TrimSuffix(a, "/")
  // Team-routed board URLs (TASK-198): /t/KEY/issue/ENG-12. The /t/KEY/
  // prefix carries nothing the issue key does not — drop it.
  if strings.HasPrefix(a, "t/") {
    let parts = strings.SplitN(a, "/", 3)
    if parts.length() == 3 { a = parts[2] }
  }
  a = strings.TrimPrefix(a, "issue/")
  if strings.Contains(a, "/") { return arg }
  if a == "" { return arg }
  a
}

fn resolve_id(ctx: pb.Client, explicit: string, usage: string) -> Result<string, pb.CliError> {
  if explicit != "" { return Ok(deslug(explicit)) }
  let Some(branch) = gitctx.current_branch() else {
    return Err(
      flags.usage_error(f"no issue ID given and no git branch to infer one from\nusage: {usage}"),
    )
  }
  let teams = records.list_teams(ctx)?
  let mut matches: Slice<string> = []
  for team in teams.items {
    if let Some(id) = gitctx.issue_id_for_team(branch, team.key) { matches = matches.append(id) }
  }
  if matches.length() > 1 {
    return Err(pb.failed(f"branch '{branch}' is ambiguous between {strings.Join(matches, ", ")}; pass the issue ID explicitly"))
  }
  if matches.length() == 1 { return Ok(matches[0]) }
  let Some(id) = gitctx.issue_id_from_branch(branch) else {
    return Err(
      flags.usage_error(f"no issue ID given and current branch '{branch}' doesn't look like eng-123-...\nusage: {usage}"),
    )
  }
  Ok(id)
}
