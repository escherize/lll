/// A flag value of `-` means "read it from stdin", the convention `gh gist` and
/// mb-shares' `share -f` use. Reading from a terminal would hang until Ctrl-D,
/// so that is refused with a message instead. `< /dev/null` also reads as a
/// character device, and an empty body is not what anyone meant either way.
fn value_or_stdin(val: string, flag: string) -> Result<string, string> {
  if val != "-" { return Ok(val) }

  if let Ok(info) = os.Stdin.Stat() {
    if info.Mode() & os.ModeCharDevice != 0 {
      return Err(
        f"{flag} - reads the body from stdin, but nothing is piped in (try: echo \"text\" | lll issue ... {flag} -)",
      )
    }
  }

  let Ok(data) = io.ReadAll(os.Stdin) else {
    return Err(f"{flag} -: reading stdin")
  }
  // One trailing newline is the shell's, not the author's: `echo hi` means "hi".
  let text = strings.TrimSuffix(data as string, "\n")
  if text == "" { return Err(f"{flag} -: nothing on stdin") }
  Ok(text)
}

/// Dispatch `lll issue <verb>`.
pub fn issue(args: Slice<string>) -> Result<(), string> {
  let Some(verb) = args.get(2) else {
    print_usage()
    return Ok(())
  }
  match verb {
    "create" => create(args),
    "list" => list(args),
    "view" => view(args),
    "update" => update(args),
    "close" => close_issue(args),
    "start" => start(args),
    "delete" => delete_issue(args),
    "comment" => comment(args),
    "watch" => issue_watch(args),
    "url" => url_cmd(args),
    "id" => id_cmd(args),
    "title" => title_cmd(args),
    "pr" => pr_cmd(args),
    "--help" => {
      print_usage()
      Ok(())
    },
    "-h" => {
      print_usage()
      Ok(())
    },
    other => Err(f"unknown issue command: '{other}' (see 'lll issue --help')"),
  }
}

fn print_usage() {
  fmt.Println(
    "lll issue - work with issues

Usage:
  lll issue create -t \"title\" [-d desc] [--priority 0-4] [--assignee name]
                   [--label name]... [--project name]
                                                  create an issue in the configured team;
                                                  -d - reads the description from stdin
  lll issue list [--state s] [--assignee name] [--label name] [--project name]
                 [--search q] [--sort f] [--limit N] [--json]
                                                  list issues; scoped to the configured team
  lll issue view [KEY-123] [--json] [--raw] [-w]  show one issue in full, with comments;
                                                  --raw prints it as plain markdown;
                                                  -w opens its web page instead
  lll issue update [KEY-123] <flags>              change fields (at least one flag)
  lll issue close [KEY-123]                       set state done
  lll issue start [KEY-123]                       set state in-progress; print/create the
                                                  branch key-number-slug (git switch)
  lll issue delete KEY-123 [--force]              delete; asks [y/N] unless --force
  lll issue comment [KEY-123] [-b \"body\"]         add a comment (authored by 'me' in
                                                  .lll.toml); without -b, list comments
  lll issue watch [KEY-123] [--json]              stream live events for the issue and
                                                  its comments until interrupted
  lll issue url [KEY-123]                         print the issue's web page URL
  lll issue id [KEY-123]                          print the issue's KEY-123 identifier
  lll issue title [KEY-123]                       print the issue's title
  lll issue pr [KEY-123]                          open a GitHub PR for the issue via
                                                  'gh pr create' (title \"KEY-123: title\",
                                                  body links the issue)

Flags:
  --state        one of: backlog, todo, in-progress, in-review, done, cancelled
  --assignee     member name (see 'lll member list'); filters on list
  --label        label name (see 'lll label list'); repeatable on create/update
                 (update replaces the set); filters on list
  --project      project name (see 'lll project list'); filters on list
  --search       list only issues whose title contains q
  --sort         created, updated, priority, or number; prefix - for descending
                 (default: LLL_SORT or 'sort' in .lll.toml, else created)
  --limit        list at most N issues (positive integer)
  --priority     0 none, 1 urgent (!!!), 2 high (!!), 3 medium (!), 4 low (·)
  --title        new title (update)
  --description  new description (update)
  --json         raw PocketBase JSON (team, assignee, labels, project
                 expanded), pipe-friendly
  --force        skip the delete confirmation
  -w             open the issue's web page in the browser (view)

Web URLs come from LLL_WEB_URL, 'web_url' in .lll.toml, or the default
http://127.0.0.1:8100 (where 'lll up' serves the board).

When KEY-123 is omitted (except for delete), it is inferred from the current
git branch: eng-12-fix-login resolves to ENG-12.

State glyphs: ◌ backlog  ○ todo  ◐ in-progress  ◉ in-review  ● done  ⊗ cancelled

The team comes from LLL_TEAM or 'team' in .lll.toml (see 'lll config --help').",
  )
}

fn create(args: Slice<string>) -> Result<(), string> {
  let mut title = ""
  let mut description = ""
  let mut priority = 0
  let mut assignee_name = ""
  let mut label_names: Slice<string> = []
  let mut project_name = ""
  let mut i = 3
  while i < args.length() {
    match args[i] {
      "-t" => {
        let Some(val) = args.get(i + 1) else {
          return Err("-t requires a value")
        }
        title = val
        i += 2
      },
      "-d" => {
        let Some(val) = args.get(i + 1) else {
          return Err("-d requires a value")
        }
        description = value_or_stdin(val, "-d")?
        i += 2
      },
      "--description" => {
        let Some(val) = args.get(i + 1) else {
          return Err("--description requires a value")
        }
        description = value_or_stdin(val, "--description")?
        i += 2
      },
      "--assignee" => {
        let Some(val) = args.get(i + 1) else {
          return Err("--assignee requires a value")
        }
        assignee_name = val
        i += 2
      },
      "--label" => {
        let Some(val) = args.get(i + 1) else {
          return Err("--label requires a value")
        }
        label_names = label_names.append(val)
        i += 2
      },
      "--project" => {
        let Some(val) = args.get(i + 1) else {
          return Err("--project requires a value")
        }
        project_name = val
        i += 2
      },
      "--priority" => {
        let Some(val) = args.get(i + 1) else {
          return Err("--priority requires a value")
        }
        let Ok(p) = strconv.Atoi(val) else {
          return Err(f"--priority must be a number 0-4, got '{val}'")
        }
        if p < 0 || p > 4 {
          return Err(
            f"--priority must be 0-4 (0 none, 1 urgent, 2 high, 3 medium, 4 low), got {p}",
          )
        }
        priority = p
        i += 2
      },
      other => return Err(f"unknown flag: '{other}'"),
    }
  }
  if title == "" {
    return Err(
      "usage: lll issue create -t \"title\" [-d desc] [--priority 0-4] [--assignee name] [--label name]... [--project name]",
    )
  }

  let mut assignee = ""
  if assignee_name != "" { assignee = resolve_member(assignee_name)?.id }

  let mut project = ""
  if project_name != "" { project = resolve_project(project_name)?.id }

  let mut labels: Slice<string> = []
  for name in label_names {
    labels = labels.append(resolve_label(name)?.id)
  }

  let team_key = config.load()?.team
  if team_key == "" {
    return Err(
      "set LLL_TEAM or 'team' in .lll.toml to your team key (e.g. ENG)",
    )
  }
  let Some(team) = find_team(team_key)? else {
    return Err(unknown_team(team_key))
  }

  let new_issue = models.NewIssue { 
    team: team.id,
    title,
    description,
    state: "todo",
    priority,
    assignee,
    project,
    labels,
  }
  let payload = match json.Marshal(new_issue) {
    Ok(p) => p,
    Err(e) => return Err(f"encoding issue: {e}"),
  }
  let body = pb.post("/api/collections/issues/records", payload as string)?

  let mut created = models.Issue { .. }
  if let Err(e) = json.Unmarshal(body.bytes(), &created) {
    return Err(f"decoding created issue: {e}")
  }
  fmt.Println(f"Created {team.key}-{created.number}: {created.title}")
  Ok(())
}

fn list(args: Slice<string>) -> Result<(), string> {
  let mut state = ""
  let mut assignee_name = ""
  let mut label_name = ""
  let mut project_name = ""
  let mut search = ""
  let mut sort_flag = ""
  let mut limit = 0
  let mut json_mode = false
  let mut i = 3
  while i < args.length() {
    match args[i] {
      "--assignee" => {
        let Some(val) = args.get(i + 1) else {
          return Err("--assignee requires a value")
        }
        assignee_name = val
        i += 2
      },
      "--label" => {
        let Some(val) = args.get(i + 1) else {
          return Err("--label requires a value")
        }
        label_name = val
        i += 2
      },
      "--project" => {
        let Some(val) = args.get(i + 1) else {
          return Err("--project requires a value")
        }
        project_name = val
        i += 2
      },
      "--search" => {
        let Some(val) = args.get(i + 1) else {
          return Err("--search requires a value")
        }
        search = val
        i += 2
      },
      "--state" => {
        let Some(val) = args.get(i + 1) else {
          return Err("--state requires a value")
        }
        if query.states().find(|s| s == val).is_none() {
          return Err(
            f"unknown state '{val}' (use one of: {strings.Join(query.states(), ", ")})",
          )
        }
        state = val
        i += 2
      },
      "--sort" => {
        let Some(val) = args.get(i + 1) else {
          return Err("--sort requires a value")
        }
        sort_flag = val
        i += 2
      },
      "--limit" => {
        let Some(val) = args.get(i + 1) else {
          return Err("--limit requires a value")
        }
        let Ok(n) = strconv.Atoi(val) else {
          return Err(f"--limit must be a positive integer, got '{val}'")
        }
        if n < 1 { return Err(f"--limit must be a positive integer, got {n}") }
        limit = n
        i += 2
      },
      "--json" => {
        json_mode = true
        i += 1
      },
      other => return Err(f"unknown flag: '{other}'"),
    }
  }

  let cfg = config.load()?

  // A configured team (LLL_TEAM or .lll.toml) scopes the list by default.
  let mut team_id = ""
  if cfg.team != "" {
    let Some(team) = find_team(cfg.team)? else {
      return Err(unknown_team(cfg.team))
    }
    team_id = team.id
  }

  let mut assignee_id = ""
  if assignee_name != "" { assignee_id = resolve_member(assignee_name)?.id }

  let mut label_id = ""
  if label_name != "" { label_id = resolve_label(label_name)?.id }

  let mut project_id = ""
  if project_name != "" { project_id = resolve_project(project_name)?.id }

  let mut sort_spec = sort_flag
  if sort_spec == "" { sort_spec = cfg.sort }
  if sort_spec == "" { sort_spec = "created" }
  let sort = query.sort(sort_spec)?

  // --limit applies server-side via PB's perPage (capped by PB at 500).
  let mut per_page = 200
  if limit > 0 { per_page = limit }
  let mut path = f"/api/collections/issues/records?perPage={per_page}&expand=team,assignee,labels,project&sort={url.QueryEscape(sort)}"
  let filter = query.filter(
    team_id,
    state,
    assignee_id,
    project_id,
    label_id,
    search,
  )
  if filter != "" { path = f"{path}&filter={url.QueryEscape(filter)}" }

  let body = pb.get(path)?
  if json_mode {
    fmt.Println(body)
    return Ok(())
  }

  let mut issues = models.IssueList { .. }
  if let Err(e) = json.Unmarshal(body.bytes(), &issues) {
    return Err(f"decoding issues: {e}")
  }
  print_issue_table(issues.items)
}

/// The standard issue table (ID, state, priority, title, assignee, age),
/// shared by `issue list` and `project view`.
fn print_issue_table(issues: Slice<models.Issue>) -> Result<(), string> {
  let w = tabwriter.NewWriter(os.Stdout, 0, 4, 2, ' ', 0)
  for item in issues {
    let key = item.expand.team.key
    let line = f"{key}-{item.number}\t{display.glyph(item.state)} {item.state}\t{display.priority_marker(item.priority)}\t{item.title}\t{item.expand.assignee.name}\t{display.relative(item.updated)}"
    if let Err(e) = fmt.Fprintln(w, line) { return Err(f"writing output: {e}") }
  }
  if let Err(e) = w.Flush() { return Err(f"writing output: {e}") }
  Ok(())
}

fn view(args: Slice<string>) -> Result<(), string> {
  let mut id = ""
  let mut json_mode = false
  let mut raw_mode = false
  let mut open_web = false
  let mut i = 3
  while i < args.length() {
    match args[i] {
      "--json" => {
        json_mode = true
        i += 1
      },
      "--raw" => {
        raw_mode = true
        i += 1
      },
      "-w" => {
        open_web = true
        i += 1
      },
      other => {
        if id != "" { return Err(f"unexpected argument: '{other}'") }
        id = other
        i += 1
      },
    }
  }
  let resolved = resolve_id(id, "lll issue view [KEY-123] [--json] [--raw] [-w]")?

  if open_web {
    let target = issue_url(fetch_issue(resolved)?)?
    fmt.Println(f"Opening {target}")
    return open_url(target)
  }

  let record = fetch_issue_record(resolved)?
  if json_mode {
    fmt.Println(record)
    return Ok(())
  }

  let mut full = models.Issue { .. }
  if let Err(e) = json.Unmarshal(record.bytes(), &full) {
    return Err(f"decoding issue: {e}")
  }

  // --raw: the issue as markdown, no chrome. For piping, and for an agent that
  // wants the text rather than a rendered table.
  if raw_mode {
    fmt.Println(f"# {full.expand.team.key}-{full.number}: {full.title}")
    if full.description != "" {
      fmt.Println("")
      fmt.Println(full.description)
    }
    return Ok(())
  }

  let mut assignee = full.expand.assignee.name
  if assignee == "" { assignee = "none" }

  let mut project = full.expand.project.name
  if project == "" { project = "none" }

  let mut labels = strings.Join(full.expand.labels.map(|l| l.name), ", ")
  if labels == "" { labels = "none" }

  fmt.Println(f"{full.expand.team.key}-{full.number} {full.title}")
  fmt.Println("")
  fmt.Println(f"State:     {display.glyph(full.state)} {full.state}")
  fmt.Println(f"Priority:  {display.priority_name(full.priority)}")
  fmt.Println(f"Assignee:  {assignee}")
  fmt.Println(f"Project:   {project}")
  fmt.Println(f"Labels:    {labels}")
  fmt.Println(f"Created:   {display.relative(full.created)}")
  fmt.Println(f"Updated:   {display.relative(full.updated)}")
  if full.description != "" {
    fmt.Println("")
    fmt.Println(full.description)
  }

  let comments = fetch_comments(full.id)?
  if comments.length() > 0 {
    fmt.Println("")
    fmt.Println("Comments:")
    fmt.Println("")
    print_comments(comments)
  }
  Ok(())
}

fn update(args: Slice<string>) -> Result<(), string> {
  let usage = "lll issue update [KEY-123] [--state s] [--priority 0-4] [--assignee name] [--label name]... [--project name] [--title t] [--description d]"
  let mut id = ""
  let mut state = ""
  let mut priority = -1
  let mut assignee_name = ""
  let mut label_names: Slice<string> = []
  let mut project_name = ""
  let mut title = ""
  let mut title_set = false
  let mut description = ""
  let mut description_set = false
  let mut i = 3
  while i < args.length() {
    match args[i] {
      "--assignee" => {
        let Some(val) = args.get(i + 1) else {
          return Err("--assignee requires a value")
        }
        assignee_name = val
        i += 2
      },
      "--label" => {
        let Some(val) = args.get(i + 1) else {
          return Err("--label requires a value")
        }
        label_names = label_names.append(val)
        i += 2
      },
      "--project" => {
        let Some(val) = args.get(i + 1) else {
          return Err("--project requires a value")
        }
        project_name = val
        i += 2
      },
      "--state" => {
        let Some(val) = args.get(i + 1) else {
          return Err("--state requires a value")
        }
        if query.states().find(|s| s == val).is_none() {
          return Err(
            f"unknown state '{val}' (use one of: {strings.Join(query.states(), ", ")})",
          )
        }
        state = val
        i += 2
      },
      "--priority" => {
        let Some(val) = args.get(i + 1) else {
          return Err("--priority requires a value")
        }
        let Ok(p) = strconv.Atoi(val) else {
          return Err(f"--priority must be a number 0-4, got '{val}'")
        }
        if p < 0 || p > 4 {
          return Err(
            f"--priority must be 0-4 (0 none, 1 urgent, 2 high, 3 medium, 4 low), got {p}",
          )
        }
        priority = p
        i += 2
      },
      "--title" => {
        let Some(val) = args.get(i + 1) else {
          return Err("--title requires a value")
        }
        if val == "" { return Err("--title cannot be empty") }
        title = val
        title_set = true
        i += 2
      },
      "--description" => {
        let Some(val) = args.get(i + 1) else {
          return Err("--description requires a value")
        }
        description = value_or_stdin(val, "--description")?
        description_set = true
        i += 2
      },
      other => {
        if other.starts_with("-") { return Err(f"unknown flag: '{other}'") }
        if id != "" { return Err(f"unexpected argument: '{other}'") }
        id = other
        i += 1
      },
    }
  }
  if state == "" && priority < 0 && assignee_name == "" &&
  label_names.is_empty() &&
  project_name == "" &&
  !title_set &&
  !description_set {
    return Err(f"nothing to update — pass at least one flag\nusage: {usage}")
  }

  let resolved = resolve_id(id, usage)?
  let issue = fetch_issue(resolved)?

  let mut fields: Slice<string> = []
  if state != "" { fields = fields.append("\"state\":" + json_quote(state)?) }
  if priority >= 0 { fields = fields.append(f"\"priority\":{priority}") }
  if assignee_name != "" {
    let member = resolve_member(assignee_name)?
    fields = fields.append("\"assignee\":" + json_quote(member.id)?)
  }
  if project_name != "" {
    let project = resolve_project(project_name)?
    fields = fields.append("\"project\":" + json_quote(project.id)?)
  }
  if !label_names.is_empty() {
    let mut label_ids: Slice<string> = []
    for name in label_names {
      label_ids = label_ids.append(resolve_label(name)?.id)
    }
    let encoded = match json.Marshal(label_ids) {
      Ok(b) => b as string,
      Err(e) => return Err(f"encoding labels: {e}"),
    }
    fields = fields.append(f"\"labels\":{encoded}")
  }
  if title_set { fields = fields.append("\"title\":" + json_quote(title)?) }
  if description_set {
    fields = fields.append("\"description\":" + json_quote(description)?)
  }
  let _ = pb.patch(
    f"/api/collections/issues/records/{issue.id}",
    "{" + strings.Join(fields, ",") + "}",
  )?
  fmt.Println(f"Updated {issue.expand.team.key}-{issue.number}")
  Ok(())
}

fn close_issue(args: Slice<string>) -> Result<(), string> {
  let usage = "lll issue close [KEY-123]"
  let id = positional_id(args, usage)?
  let resolved = resolve_id(id, usage)?
  let issue = fetch_issue(resolved)?
  let _ = pb.patch(
    f"/api/collections/issues/records/{issue.id}",
    "{\"state\":\"done\"}",
  )?
  fmt.Println(f"Closed {issue.expand.team.key}-{issue.number} ● done")
  Ok(())
}

fn start(args: Slice<string>) -> Result<(), string> {
  let usage = "lll issue start [KEY-123]"
  let id = positional_id(args, usage)?
  let resolved = resolve_id(id, usage)?
  let issue = fetch_issue(resolved)?
  let _ = pb.patch(
    f"/api/collections/issues/records/{issue.id}",
    "{\"state\":\"in-progress\"}",
  )?
  let key = issue.expand.team.key
  fmt.Println(f"Started {key}-{issue.number}: {issue.title} (◐ in-progress)")

  let branch = gitctx.branch_name(key, issue.number, issue.title)
  fmt.Println(f"Branch: {branch}")
  if gitctx.in_repo() {
    let created = gitctx.switch_branch(branch)?
    if created {
      fmt.Println(f"Created and switched to branch '{branch}'")
    } else {
      fmt.Println(f"Switched to existing branch '{branch}'")
    }
  }
  Ok(())
}

fn delete_issue(args: Slice<string>) -> Result<(), string> {
  let mut id = ""
  let mut force = false
  let mut i = 3
  while i < args.length() {
    match args[i] {
      "--force" => {
        force = true
        i += 1
      },
      other => {
        if other.starts_with("-") { return Err(f"unknown flag: '{other}'") }
        if id != "" { return Err(f"unexpected argument: '{other}'") }
        id = other
        i += 1
      },
    }
  }
  // Deleting by inferred branch is too dangerous; the ID must be explicit.
  if id == "" { return Err("usage: lll issue delete KEY-123 [--force]") }

  let issue = fetch_issue(id)?
  let label = f"{issue.expand.team.key}-{issue.number}"
  if !force {
    fmt.Print(f"delete {label}? [y/N] ")
    let scanner = bufio.NewScanner(os.Stdin)
    let mut answer = ""
    if scanner.Scan() { answer = strings.TrimSpace(scanner.Text()) }
    let a = strings.ToLower(answer)
    if a != "y" && a != "yes" {
      fmt.Println("Aborted.")
      return Ok(())
    }
  }
  let _ = pb.delete(f"/api/collections/issues/records/{issue.id}")?
  fmt.Println(f"Deleted {label}")
  Ok(())
}

fn comment(args: Slice<string>) -> Result<(), string> {
  let usage = "lll issue comment [KEY-123] [-b \"body\"]"
  let mut id = ""
  let mut body = ""
  let mut body_set = false
  let mut i = 3
  while i < args.length() {
    match args[i] {
      "-b" => {
        let Some(val) = args.get(i + 1) else {
          return Err("-b requires a value")
        }
        body = value_or_stdin(val, "-b")?
        body_set = true
        i += 2
      },
      other => {
        if other.starts_with("-") { return Err(f"unknown flag: '{other}'") }
        if id != "" { return Err(f"unexpected argument: '{other}'") }
        id = other
        i += 1
      },
    }
  }

  let resolved = resolve_id(id, usage)?
  let issue = fetch_issue(resolved)?

  if !body_set {
    let comments = fetch_comments(issue.id)?
    if comments.is_empty() {
      fmt.Println("No comments.")
      return Ok(())
    }
    print_comments(comments)
    return Ok(())
  }
  if body == "" { return Err(f"-b cannot be empty\nusage: {usage}") }

  // Author is the member named by 'me' in config; unset or unmatched 'me'
  // makes the comment authorless (honor system, no auth).
  let mut author = ""
  let me = config.load()?.me
  if me != "" { if let Some(m) = find_member(me)? { author = m.id } }

  let new_comment = models.NewComment { issue: issue.id, author, body }
  let payload = match json.Marshal(new_comment) {
    Ok(p) => p,
    Err(e) => return Err(f"encoding comment: {e}"),
  }
  let _ = pb.post("/api/collections/comments/records", payload as string)?
  fmt.Println(f"Commented on {issue.expand.team.key}-{issue.number}")
  Ok(())
}

fn url_cmd(args: Slice<string>) -> Result<(), string> {
  let usage = "lll issue url [KEY-123]"
  let id = positional_id(args, usage)?
  let resolved = resolve_id(id, usage)?
  let target = issue_url(fetch_issue(resolved)?)?
  fmt.Println(target)
  Ok(())
}

fn id_cmd(args: Slice<string>) -> Result<(), string> {
  let usage = "lll issue id [KEY-123]"
  let id = positional_id(args, usage)?
  let resolved = resolve_id(id, usage)?
  let issue = fetch_issue(resolved)?
  fmt.Println(f"{issue.expand.team.key}-{issue.number}")
  Ok(())
}

fn title_cmd(args: Slice<string>) -> Result<(), string> {
  let usage = "lll issue title [KEY-123]"
  let id = positional_id(args, usage)?
  let resolved = resolve_id(id, usage)?
  let issue = fetch_issue(resolved)?
  fmt.Println(issue.title)
  Ok(())
}

/// Thin wrapper over the GitHub CLI: gh owns pushing checks, prompts, and
/// errors — we only supply the KEY-prefixed title and an issue-linking body.
fn pr_cmd(args: Slice<string>) -> Result<(), string> {
  let usage = "lll issue pr [KEY-123]"
  let id = positional_id(args, usage)?
  let resolved = resolve_id(id, usage)?

  let mut gh = ""
  match exec.LookPath("gh") {
    Partial.Ok(path) => gh = path,
    _ => return Err(
      "gh not found on PATH — install the GitHub CLI (brew install gh)",
    ),
  }

  let issue = fetch_issue(resolved)?
  let key = f"{issue.expand.team.key}-{issue.number}"
  let mut body = issue_url(issue)?
  if issue.description != "" { body = f"{body}\n\n{issue.description}" }

  let cmd = exec.Command(
    gh,
    "pr",
    "create",
    "--title",
    f"{key}: {issue.title}",
    "--body",
    body,
  )
  cmd.Stdin = Some(os.Stdin)
  cmd.Stdout = Some(os.Stdout)
  cmd.Stderr = Some(os.Stderr)
  if let Err(e) = cmd.Run() { return Err(f"gh pr create: {e}") }
  Ok(())
}

/// Web page URL for an issue: <web_url>/issue/KEY-123.
fn issue_url(issue: models.Issue) -> Result<string, string> {
  let base = web_base()?
  Ok(f"{base}/issue/{issue.expand.team.key}-{issue.number}")
}

/// An issue's comments, oldest first, author expanded.
fn fetch_comments(issue_id: string) -> Result<Slice<models.Comment>, string> {
  let filter = url.QueryEscape(f"issue='{issue_id}'")
  let body = pb.get(
    f"/api/collections/comments/records?filter={filter}&sort=created&expand=author&perPage=200",
  )?
  let mut comments = models.CommentList { .. }
  if let Err(e) = json.Unmarshal(body.bytes(), &comments) {
    return Err(f"decoding comments: {e}")
  }
  Ok(comments.items)
}

/// Print comments as "author (3h ago)" then the indented body.
fn print_comments(comments: Slice<models.Comment>) {
  for c in comments {
    let mut author = c.expand.author.name
    if author == "" { author = "anon" }
    fmt.Println(f"{author} ({display.relative(c.created)})")
    fmt.Println(f"  {c.body}")
  }
}

/// Resolve a member by name; unknown names error with the fix.
fn resolve_member(name: string) -> Result<models.Member, string> {
  let Some(m) = find_member(name)? else {
    return Err(f"no member named '{name}' — see 'lll member list'")
  }
  Ok(m)
}

/// Parse `[KEY-123]` as the only allowed argument (verbs without flags).
fn positional_id(args: Slice<string>, usage: string) -> Result<string, string> {
  let mut id = ""
  let mut i = 3
  while i < args.length() {
    let arg = args[i]
    if arg.starts_with("-") {
      return Err(f"unknown flag: '{arg}'\nusage: {usage}")
    }
    if id != "" { return Err(f"unexpected argument: '{arg}'") }
    id = arg
    i += 1
  }
  Ok(id)
}

/// Resolution order: explicit arg > current git branch (eng-12-slug -> ENG-12)
/// > error with a hint.
/// Accept a pasted board URL anywhere a KEY-123 is expected — the same courtesy
/// mb-shares' `share` extends to its slugs. Strips `scheme://host/`, an
/// `issue/` path prefix and a trailing slash; anything that is not shaped like
/// a URL is returned untouched, so a bare key stays a bare key and a bad value
/// still fails downstream with the usual "not an issue ID" message.
fn deslug(arg: string) -> string {
  let mut a = arg
  if let Some(idx) = strings.Index(a, "://") {
    a = a.substring(idx + 3..)
    let Some(slash) = strings.Index(a, "/") else {
      return arg
    }
    a = a.substring(slash + 1..)
  } else if strings.Contains(a, "/") {
    // a bare path like issue/ENG-1, but never a Windows-ish or odd value
    a = a
  } else {
    return arg
  }
  a = strings.TrimSuffix(a, "/")
  a = strings.TrimPrefix(a, "issue/")
  if strings.Contains(a, "/") { return arg }
  if a == "" { return arg }
  a
}

fn resolve_id(explicit: string, usage: string) -> Result<string, string> {
  if explicit != "" { return Ok(deslug(explicit)) }
  let Some(branch) = gitctx.current_branch() else {
    return Err(
      f"no issue ID given and no git branch to infer one from\nusage: {usage}",
    )
  }
  let Some(id) = gitctx.issue_id_from_branch(branch) else {
    return Err(
      f"no issue ID given and current branch '{branch}' doesn't look like eng-123-...\nusage: {usage}",
    )
  }
  Ok(id)
}

/// Fetch an issue by KEY-123 and return the raw PB record JSON (team,
/// assignee, labels, project expanded).
fn fetch_issue_record(id: string) -> Result<string, string> {
  let bad_id = f"'{id}' is not an issue ID (expected KEY-123, e.g. ENG-1)"
  let Some(dash) = strings.LastIndex(id, "-") else {
    return Err(bad_id)
  }
  if dash == 0 || dash == id.length() - 1 { return Err(bad_id) }
  let team_key = id.substring(0..dash)
  let Ok(number) = strconv.Atoi(id.substring(dash + 1..id.length())) else {
    return Err(bad_id)
  }

  let not_found = f"issue {id} not found — check 'lll issue list' or LLL_TEAM"
  let Some(team) = find_team(team_key)? else {
    return Err(not_found)
  }

  let filter = url.QueryEscape(
    f"{query.filter(team.id, "", "", "", "", "")} && number={number}",
  )
  let body = pb.get(
    f"/api/collections/issues/records?filter={filter}&perPage=1",
  )?
  let mut issues = models.IssueList { .. }
  if let Err(e) = json.Unmarshal(body.bytes(), &issues) {
    return Err(f"decoding issues: {e}")
  }
  let Some(item) = issues.items.get(0) else {
    return Err(not_found)
  }

  pb.get(
    f"/api/collections/issues/records/{item.id}?expand=team,assignee,labels,project",
  )
}

/// fetch_issue_record, decoded.
fn fetch_issue(id: string) -> Result<models.Issue, string> {
  let record = fetch_issue_record(id)?
  let mut full = models.Issue { .. }
  if let Err(e) = json.Unmarshal(record.bytes(), &full) {
    return Err(f"decoding issue: {e}")
  }
  Ok(full)
}

/// JSON-encode a string value (quotes + escaping).
fn json_quote(value: string) -> Result<string, string> {
  match json.Marshal(value) {
    Ok(b) => Ok(b as string),
    Err(e) => Err(f"encoding value: {e}"),
  }
}

fn find_team(key: string) -> Result<Option<models.Team>, string> {
  let filter = url.QueryEscape(f"key='{key}'")
  let body = pb.get(f"/api/collections/teams/records?filter={filter}")?
  let mut result = models.TeamList { .. }
  if let Err(e) = json.Unmarshal(body.bytes(), &result) {
    return Err(f"decoding teams: {e}")
  }
  Ok(result.items.find(|t| t.key == key))
}
