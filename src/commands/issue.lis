fn branch_name_cmd(input: flags.CommandInput) -> Result<(), string> {
  let usage = "lll issue branch-name [KEY-123]"
  let p = input.parsed
  let resolved = resolve_id(p.first(), usage)?
  let issue = records.fetch_issue(resolved)?
  fmt.Println(gitctx.branch_name(
    issue.expand.team.key,
    issue.number,
    issue.title,
  ))
  Ok(())
}

/// Thin wrapper over the GitHub CLI: gh owns pushing checks, prompts, and
/// errors. Record the returned PR only after gh confirms successful creation.
fn pr_cmd(input: flags.CommandInput) -> Result<(), string> {
  let usage = "lll issue pr [KEY-123]"
  let id = input.parsed.first()
  let resolved = resolve_id(id, usage)?

  let mut gh = ""
  match exec.LookPath("gh") {
    Partial.Ok(path) => gh = path,
    _ => return Err(
      "gh not found on PATH; install the GitHub CLI (brew install gh)",
    ),
  }

  let issue = records.fetch_issue(resolved)?
  let key = f"{issue.expand.team.key}-{issue.number}"
  let (body, linked_only) = pr_body(issue_url(issue)?, issue.description)?
  if issue.expand.team.archived { return Err(archived_hint(issue.expand.team.key)) }
  if linked_only {
    let _ = fmt.Fprintln(os.Stderr, "issue description exceeds the PR body limit; linking to the full description instead")
  }

  let mut cmd = exec.Command(
    gh,
    "pr",
    "create",
    "--title",
    f"{key}: {issue.title}",
    "--body-file",
    "-",
  )
  cmd.Stdin = Some(strings.NewReader(body))
  // Two buffers, not one shared by both streams: exec runs a goroutine per
  // writer, so a single bytes.Buffer behind Stdout and Stderr would be written
  // from two goroutines at once.
  let mut captured = bytes.Buffer { .. }
  let mut captured_err = bytes.Buffer { .. }
  cmd.Stdout = Some(io.MultiWriter(os.Stdout, &captured))
  cmd.Stderr = Some(io.MultiWriter(os.Stderr, &captured_err))
  if let Err(e) = cmd.Run() {
    // gh refuses to open a second PR for a branch that already has one, and
    // prints the URL of the one that does - on stderr, which is why that is
    // captured now. Recording the PR is the whole point of this verb, so adopt
    // the existing one instead of failing with the URL sitting right there in
    // the output. `lll issue claim` already answers "it exists and it is
    // already yours" with success rather than a refusal (LLL-415).
    //
    // Gated on gh's own "already exists" wording, deliberately narrow: a create
    // that failed for any OTHER reason must stay a failure, or a reference gets
    // recorded for a PR that was never opened. If gh ever changes the wording
    // this falls back to the old error, which is the safe direction.
    let combined = captured_err.String() + "\n" + captured.String()
    if !strings.Contains(combined, "already exists") { return Err(f"gh pr create: {e}") }
    let Some((existing_url, existing_ref)) = references.from_pr_output(combined) else {
      return Err(f"gh pr create: {e}")
    };
    if let Err(save) = references.append(issue.id, existing_ref) {
      return Err(f"A pull request already exists: {existing_url}\nCould not confirm {existing_ref} on {key}: {save}\nRetry only the reference save: lll issue ref {key} {existing_ref}")
    }
    let _ = fmt.Fprintln(os.Stderr, f"a pull request already existed for this branch; recorded {existing_ref} on {key}")
    return Ok(())
  }
  let Some((pr_url, reference)) = references.from_pr_output(captured.String()) else {
    return Err("gh pr create succeeded but did not report one unambiguous PR URL; the issue was not changed. Inspect the gh output before retrying; do not create a duplicate PR.")
  };
  if let Err(e) = references.append(issue.id, reference) {
    return Err(f"PR created: {pr_url}\nCould not confirm {reference} on {key}: {e}\nRetry only the reference save: lll issue ref {key} {reference}")
  }
  Ok(())
}

/// Both positionals are required, unlike the verbs that infer the issue from the
/// branch: a lone `ref linear:ENG-118` is shaped exactly like a KEY, so guessing
/// which one it is would silently append a wrong ref, and there is no unref.
fn ref_cmd(input: flags.CommandInput) -> Result<(), string> {
  let usage = "lll issue ref KEY-123 REF"
  let p = input.parsed
  let reference = p.nth(1)
  if p.first() == "" || reference == "" { return Err(flags.usage_error(f"usage: {usage}")) }
  let resolved = resolve_id(p.first(), usage)?
  let issue = records.fetch_issue(resolved)?
  let outcome = references.append(issue.id, reference)?
  let action = if outcome.added { "Added" } else { "Already recorded" }
  fmt.Println(f"{action} {reference} on {issue.expand.team.key}-{issue.number}")
  Ok(())
}

/// Keep the issue as the authoritative full text when its description is
/// larger than GitHub accepts. Never silently publish a truncated excerpt.
fn pr_body(link: string, description: string) -> Result<(string, bool), string> {
  let body = if description == "" { link } else { f"{link}\n\n{description}" }
  if utf8.RuneCountInString(body) <= 65536 { return Ok((body, false)) }
  let fallback = f"{link}\n\nThe full description is on the linked issue; it exceeds the pull request body limit."
  if utf8.RuneCountInString(fallback) > 65536 {
    return Err("the issue URL exceeds the PR body limit; check the configured web_url")
  }
  Ok((fallback, true))
}

/// Web page URL for an issue: <web_url>/issue/KEY-123.
fn issue_url(issue: models.Issue) -> Result<string, string> {
  let base = web_base()?
  Ok(f"{base}/issue/{issue.expand.team.key}-{issue.number}")
}


/// Print comments as "author (3h ago)", or "author [bot via OWNER] (3h ago)",
/// then the indented body.
fn print_comments(comments: Slice<models.Comment>) {
  // Numbered so 'comment edit KEY N' and 'comment delete KEY N' have a
  // handle (TASK-320): position in creation order, not the record id.
  let mut n = 0
  for c in comments {
    n += 1
    let author = display.comment_byline(c.author_kind, c.author, c.expand.author.name, c.agent, "anon")
    let tag = if c.author_kind == "system" { "" } else { display.author_tag(c.expand.author.kind == "bot", c.expand.author.owner_name()) }
    fmt.Println(f"#{n} {author}{tag} ({display.relative(c.created)})")
    fmt.Println(f"  {c.body}")
  }
}

/// `lll issue comment edit KEY N -b "body"` and `... delete KEY N`. N is the
/// position 'comment KEY' prints. Your own comments only, unless --force:
/// the author is the token's member. A superuser token may change anything.
fn comment_commands() -> Slice<flags.Command> {
  [
    flags.Command { name: "edit", summary: "edit a numbered comment", spec: comment_mutate_spec("edit"), positional: "KEY N", run: |input| comment_mutate("edit", input.parsed), .. },
    flags.Command { name: "delete", summary: "delete a numbered comment", spec: comment_mutate_spec("delete"), positional: "KEY N", run: |input| comment_mutate("delete", input.parsed), .. },
  ]
}

fn comment_mutate(verb: string, p: flags.Parsed) -> Result<(), string> {
  let spec = comment_mutate_spec(verb)
  let usage = flags.usage(f"lll issue comment {verb}", spec, "KEY-123 N")
  if p.first() == "" || p.nth(1) == "" { return Err(flags.usage_error(f"usage: {usage}")) }
  let resolved = resolve_id(p.first(), usage)?
  let issue = records.fetch_issue(resolved)?
  let key = f"{issue.expand.team.key}-{issue.number}"
  let Ok(n) = strconv.Atoi(p.nth(1)) else {
    return Err(f"'{p.nth(1)}' is not a comment number; 'lll issue comment {key}' numbers them")
  }
  let comments = records.fetch_comments(issue.id)?
  if n < 1 || n > comments.length() {
    return Err(f"{key} has {comments.length()} comments; there is no #{n}; 'lll issue comment {key}' numbers them")
  }
  let c = comments[n - 1]
  let whose = display.member_name(c.author, c.expand.author.name, "anon")
  if !p.given("--force") {
    if let Some(a) = actor()? {
      if c.author != a.id {
        return Err(pb.fail(pb.ErrorKind.Refused, f"comment #{n} on {key} is {whose}'s, not yours; only its author changes it (a superuser token can, with --force)"))
      }
    }
  }
  if verb == "delete" {
    if !confirmed_on_terminal(
      p.given("--yes"),
      f"delete comment #{n} on {key}?",
    ) {
      return Err(aborted())
    }
    let _ = pb.delete(f"/api/collections/comments/records/{c.id}")?
    fmt.Println(f"Deleted comment #{n} on {key} (was {whose}'s)")
    return Ok(())
  }
  let mut body = ""
  if p.given("-b") {
    body = value_or_stdin(p.one("-b"), "-b")?
  } else if p.nth(2) != "" {
    body = p.nth(2)
  }
  if strings.TrimSpace(body) == "" {
    return Err(flags.usage_error(f"comment edit needs the new body: -b \"...\" (or '-b -' from stdin)\nusage: {usage}"))
  }
  let _ = pb.patch(
    f"/api/collections/comments/records/{c.id}",
    "{\"body\":" + json_quote(body)? + "}",
  )?
  fmt.Println(f"Edited comment #{n} on {key}")
  Ok(())
}

fn comment_mutate_spec(verb: string) -> Slice<flags.Flag> {
  let mut spec = [
    flags.Flag { name: "--force", help: "with a superuser token: change a comment that is not yours (the server refuses members)", .. },
  ]
  if verb == "delete" {
    spec = spec.append(
      flags.Flag { name: "--yes", help: "skip the delete confirmation", .. },
    )
  }
  if verb == "edit" {
    spec = spec.append(flags.Flag {
      name: "-b",
      alias: "--body",
      value: true,
      hint: "\"body\"",
      help: "the new body ('-b -' reads it from stdin)",
      ..,
    })
  }
  spec
}


fn deslug(arg: string) -> string {
  // All splitting, no index arithmetic: byte offsets and rune indices disagree
  // on non-ASCII input and panic. See realtime.split_field.
  let mut a = arg
  if strings.Contains(a, "://") {
    let after_scheme = strings.SplitN(a, "://", 2)[1]
    if !strings.Contains(after_scheme, "/") { return arg }
    a = strings.SplitN(after_scheme, "/", 2)[1]
  } else if !strings.Contains(a, "/") { return arg }
  // TASK-144: a URL copied out of a browser carries `?utm_source=...` and
  // `#comment-3`, and neither names the issue. Cut them here, after the host
  // is gone (so a `?` cannot be read as path) and before the trailing slash
  // is trimmed (a share link puts the slash between the key and the query).
  // Fragment first: it may itself contain a `?`, and everything after `#` is
  // fragment.
  a = strings.SplitN(a, "#", 2)[0]
  a = strings.SplitN(a, "?", 2)[0]
  a = strings.TrimSuffix(a, "/")
  // Team-routed board URLs (TASK-198): /t/KEY/issue/ENG-12. The /t/KEY/
  // prefix carries nothing the issue key does not — drop it.
  if strings.HasPrefix(a, "t/") {
    let parts = strings.SplitN(a, "/", 3)
    if parts.length() == 3 { a = parts[2] }
  }
  a = strings.TrimPrefix(a, "issue/")
  if strings.Contains(a, "/") { return arg }
  if a == "" { return arg }
  a
}

fn resolve_id(explicit: string, usage: string) -> Result<string, string> {
  if explicit != "" { return Ok(deslug(explicit)) }
  let Some(branch) = gitctx.current_branch() else {
    return Err(
      f"no issue ID given and no git branch to infer one from\nusage: {usage}",
    )
  }
  let teams = records.list_teams()?
  let mut matches: Slice<string> = []
  for team in teams.items {
    if let Some(id) = gitctx.issue_id_for_team(branch, team.key) { matches = matches.append(id) }
  }
  if matches.length() > 1 {
    return Err(f"branch '{branch}' is ambiguous between {strings.Join(matches, ", ")}; pass the issue ID explicitly")
  }
  if matches.length() == 1 { return Ok(matches[0]) }
  let Some(id) = gitctx.issue_id_from_branch(branch) else {
    return Err(
      f"no issue ID given and current branch '{branch}' doesn't look like eng-123-...\nusage: {usage}",
    )
  }
  Ok(id)
}




/// JSON-encode a string value (quotes + escaping).
fn json_quote(value: string) -> Result<string, string> {
  match json.Marshal(value) {
    Ok(b) => Ok(b as string),
    Err(e) => Err(f"encoding value: {e}"),
  }
}

/// JSON-encode a list of record ids.
fn json_ids(ids: Slice<string>) -> Result<string, string> {
  match json.Marshal(ids) {
    Ok(b) => Ok(b as string),
    Err(e) => Err(f"encoding ids: {e}"),
  }
}


// ------------------------------------------------------------- doc links

/// Docs linked to an issue. The issue -> doc direction is not stored: it is
/// one `?=` filter over docs.issues, which is the whole reason links are a
/// relation and not a write-once reference on the issue.
fn fetch_issue_docs(issue_id: string) -> Result<Slice<models.Doc>, string> {
  fetch_docs(f"issues.id ?= {query.quote(issue_id)}", "slug", "")
}

/// Send one edge as a relation modifier ("issues+" or "issues-"), never the
/// whole array (LLL-513). Writing back a locally edited copy of the array let
/// two concurrent links to one doc drop an edge. The server applies the
/// modifier under a per-record lock (gopb serializeRecordUpdates).
fn modify_doc_issues(doc: models.Doc, modifier: string, issue_id: string) -> Result<(), string> {
  let _ = pb.patch(
    f"/api/collections/docs/records/{doc.id}",
    "{" + json_quote(modifier)? + ":[" + json_quote(issue_id)? + "]}",
  )?
  Ok(())
}

/// Refuse a link whose two ends live in different teams (TASK-173). The doc
/// is looked up in the CONFIGURED team, the issue is whatever KEY-123 names,
/// so `LLL_TEAM=LLL lll issue link GRDN-4 index` would otherwise quietly
/// stitch the two boards' link graphs together.
fn cross_team_link(
  issue: models.Issue,
  team: models.Team,
  d: models.Doc,
) -> Result<(), string> {
  if d.team == issue.team { return Ok(()) }
  let key = f"{issue.expand.team.key}-{issue.number}"
  Err(
    f"{key} is in {issue.expand.team.key} and doc '{d.slug}' is in {team.key}; a link stays inside one team",
  )
}

fn link(input: flags.CommandInput) -> Result<(), string> {
  let usage = "lll issue link KEY-123 SLUG"
  let id = input.parsed.first()
  let slug = input.parsed.nth(1)
  if id == "" || slug == "" { return Err(flags.usage_error(f"usage: {usage}")) }
  link_issue(id, slug, usage)
}

/// The write path behind 'lll issue link KEY-123 SLUG'. The relation is
/// stored once on docs.issues. 'lll doc link' was removed at 1.0 (D5).
fn link_issue(id: string, slug: string, usage: string) -> Result<(), string> {
  let resolved = resolve_id(id, usage)?
  let issue = records.fetch_issue(resolved)?
  let key = f"{issue.expand.team.key}-{issue.number}"
  let team = issue_link_team(issue)?
  let d = fetch_doc(team, slug)?
  cross_team_link(issue, team, d)?

  if d.issues.find(|x| x == issue.id).is_some() {
    fmt.Println(f"{key} is already linked to {d.slug}")
    return Ok(())
  }
  modify_doc_issues(d, "issues+", issue.id)?
  fmt.Println(f"Linked {key} -> {d.slug}")
  Ok(())
}

fn unlink(input: flags.CommandInput) -> Result<(), string> {
  let usage = "lll issue unlink KEY-123 SLUG"
  let id = input.parsed.first()
  let slug = input.parsed.nth(1)
  if id == "" || slug == "" { return Err(flags.usage_error(f"usage: {usage}")) }
  unlink_issue(id, slug, usage)
}

/// The write path behind 'lll issue unlink KEY-123 SLUG'.
fn unlink_issue(id: string, slug: string, usage: string) -> Result<(), string> {
  let resolved = resolve_id(id, usage)?
  let issue = records.fetch_issue(resolved)?
  let key = f"{issue.expand.team.key}-{issue.number}"
  let team = issue_link_team(issue)?
  let d = fetch_doc(team, slug)?
  cross_team_link(issue, team, d)?

  if d.issues.find(|x| x == issue.id).is_none() {
    return Err(f"{key} is not linked to {d.slug}; see 'lll doc view {d.slug}'")
  }
  modify_doc_issues(d, "issues-", issue.id)?
  fmt.Println(f"Unlinked {key} from {d.slug}")
  Ok(())
}

/// An explicit issue identifies its document namespace outside an attached
/// directory. Configured scope remains authoritative, including a mismatch.
fn issue_link_team(issue: models.Issue) -> Result<models.Team, string> {
  Ok(configured_team()?.unwrap_or(issue.expand.team))
}

/// `lll issue block KEY BLOCKER`: KEY cannot start until BLOCKER is done.
/// Refuses a self-block and a cycle (BLOCKER already waits on KEY, at any
/// depth), since a cycle would make both un-ready forever. The dependency
/// lives on the blocked issue: one relation field, no second collection.
fn block(input: flags.CommandInput) -> Result<(), string> {
  let usage = "lll issue block KEY-123 BLOCKER"
  let id = input.parsed.first()
  let blocker_id = input.parsed.nth(1)
  if id == "" || blocker_id == "" { return Err(flags.usage_error(f"usage: {usage}")) }
  let issue = records.fetch_issue(resolve_id(id, usage)?)?
  let blocker = records.fetch_issue(resolve_id(blocker_id, usage)?)?
  let key = f"{issue.expand.team.key}-{issue.number}"
  let bkey = f"{blocker.expand.team.key}-{blocker.number}"
  if issue.id == blocker.id { return Err(f"{key} cannot block itself") }
  if issue.blocked_by.find(|x| x == blocker.id).is_some() {
    fmt.Println(f"{key} is already blocked by {bkey}")
    return Ok(())
  }
  let cyclic = depends_on(blocker, issue.id, 0)?
  if cyclic {
    return Err(f"{bkey} already waits on {key} (directly or through others); blocking {key} by {bkey} would be a cycle")
  }
  set_blocked_by(issue, issue.blocked_by.append(blocker.id))?
  let mut note = ""
  if blocker.state == "done" || blocker.state == "cancelled" { note = f" ({bkey} is already {blocker.state}, so this does not hold {key} back)" }
  fmt.Println(f"{key} is blocked by {bkey}{note}")
  Ok(())
}

fn unblock(input: flags.CommandInput) -> Result<(), string> {
  let usage = "lll issue unblock KEY-123 BLOCKER"
  let id = input.parsed.first()
  let blocker_id = input.parsed.nth(1)
  if id == "" || blocker_id == "" { return Err(flags.usage_error(f"usage: {usage}")) }
  let issue = records.fetch_issue(resolve_id(id, usage)?)?
  let blocker = records.fetch_issue(resolve_id(blocker_id, usage)?)?
  let key = f"{issue.expand.team.key}-{issue.number}"
  let bkey = f"{blocker.expand.team.key}-{blocker.number}"
  let mut remaining: Slice<string> = []
  let mut found = false
  for x in issue.blocked_by {
    if x == blocker.id { found = true } else { remaining = remaining.append(x) }
  }
  if !found {
    fmt.Println(f"{key} was not blocked by {bkey}")
    return Ok(())
  }
  set_blocked_by(issue, remaining)?
  fmt.Println(f"{key} is no longer blocked by {bkey}")
  Ok(())
}

fn set_blocked_by(issue: models.Issue, ids: Slice<string>) -> Result<(), string> {
  let encoded = match json.Marshal(ids) {
    Ok(b) => b as string,
    Err(e) => return Err(f"encoding blockers: {e}"),
  }
  let _ = pb.patch(f"/api/collections/issues/records/{issue.id}", f"{{\"blocked_by\":{encoded}}}")?
  Ok(())
}

/// True when `issue` waits on `target` at any depth. Bounded at eight
/// levels: deeper chains are not a thing a tracker should have.
fn depends_on(issue: models.Issue, target: string, depth: int) -> Result<bool, string> {
  if depth > 8 { return Ok(false) }
  for b in issue.expand.blocked_by {
    if b.id == target { return Ok(true) }
    let full = fetch_issue_by_id(b.id)?
    let deeper = depends_on(full, target, depth + 1)?
    if deeper { return Ok(true) }
  }
  Ok(false)
}

fn fetch_issue_by_id(id: string) -> Result<models.Issue, string> {
  let body = pb.get(f"/api/collections/issues/records/{id}?expand=team,blocked_by")?
  let mut full = models.Issue { .. }
  if let Err(e) = json.Unmarshal(body.bytes(), &full) {
    return Err(f"decoding issue: {e}")
  }
  Ok(full)
}

/// What stands between an issue and "ready" for this reader (LLL-672).
struct Blockers {
  /// Blockers the reader can see that are not done or cancelled.
  open: Slice<models.Issue>,
  /// Blocker ids with no record the reader can see: another team's issue,
  /// hidden from a team-scoped member. Counted as open, because nothing
  /// proves them finished, and their state is not this reader's to learn.
  hidden: int,
}

impl Blockers {
  fn any(self) -> bool {
    !self.open.is_empty() || self.hidden > 0
  }
}

/// The one blocker rule, for list --ready and --blocked, issue next, issue
/// view and watch --ready (LLL-672). Decided from the `blocked_by` ids, not
/// from the expanded records: PocketBase drops a blocker the reader may not
/// see from the expand, and deciding from the expand called that issue ready
/// while watch, deciding from the ids, did not. `seen` is every blocker record
/// the caller has, freshest first: the expand, or watch's snapshot.
fn blockers_of(issue: models.Issue, seen: Slice<models.Issue>) -> Blockers {
  let mut open: Slice<models.Issue> = []
  let mut hidden = 0
  for id in issue.blocked_by {
    match seen.find(|s| s.id == id) {
      Some(b) => { if b.state != "done" && b.state != "cancelled" { open = open.append(b) } },
      None => { hidden += 1 },
    }
  }
  Blockers { open, hidden }
}

/// Ready: open (todo or backlog), in a team that is not archived, and no
/// blocker that is open or hidden. An archived team is read-only (LLL-660),
/// so its open issues are not work anyone can pick up; with no team
/// configured, `issue next` offered them (LLL-679).
fn is_ready(issue: models.Issue, seen: Slice<models.Issue>) -> bool {
  (issue.state == "todo" || issue.state == "backlog")
    && !issue.expand.team.archived
    && !blockers_of(issue, seen).any()
}

/// Issues that name `issue` as a blocker, for the "Blocks:" line.
fn fetch_blocks(issue_id: string) -> Result<Slice<models.Issue>, string> {
  let filter = url.QueryEscape(f"blocked_by.id ?= {query.quote(issue_id)}")
  let mut list = models.IssueList { .. }
  pb.fetch(f"/api/collections/issues/records?perPage=200&sort=number&expand=team&filter={filter}", "issues", &list)?
  Ok(list.items)
}

fn issue_next_spec() -> Slice<flags.Flag> {
  // The list command's --project and --label (LLL-307), so a filtered queue
  // speaks the same dialect; state and assignee are fixed by "ready, unclaimed".
  let shared = filter_spec(FilterUse.List).filter(|f| f.name == "--project" || f.name == "--label")
  flags.with_team(shared.append([
    flags.Flag {
      name: "--exclude-label",
      value: true,
      hint: "name",
      repeat: true,
      help: "skip issues carrying this label; repeatable, skipping any of them",
      ..,
    },
    flags.Flag {
      name: "--json",
      help: "print the chosen issue as the 'lll issue view --json' object instead\nof just its key: the record with key, claim, expand.blocked_by (blockers),\ncomments, docs and findings",
      ..,
    },
    flags.Flag {
      name: "--claim",
      help: "atomically claim the chosen issue before printing it; if another\nmember wins the race, exit non-zero and print no key",
      ..,
    },
    flags.Flag {
      name: "--agent",
      value: true,
      hint: "NAME",
      help: "self-asserted session label, for agents sharing one member token\n(default: LLL_AGENT)",
      ..,
    },
  ]...))
}

/// Dispatch `lll issue next` (LLL-395) — the agenda verb. Prints ONE key so a
/// shell loop can compose it (`next=$(lll issue next)`): the best unclaimed
/// ready issue, ranked by rank_agenda. An empty agenda is an error, the same
/// bargain `claim` makes: the command either hands out work or says there is
/// none. With --claim the printed key is always secured first.
fn issue_next(input: flags.CommandInput) -> Result<(), string> {
  let p = input.parsed
  let agent = if p.given("--claim") { agent_label(p)? } else { "" }
  let filters = filters_from(p)?
  let scope = configured_scope()?
  // Names resolve before any fetch, so a typo fails naming the fix instead of
  // reporting an empty agenda.
  let mut excluded: Slice<string> = []
  for name in p.all("--exclude-label") {
    excluded = excluded.append(records.label_ids(scope, name)?...)
  }
  let candidates = ready_issues(resolve_filter_query(scope, filters)?)?
    .filter(|i| !i.labels.any(|l| excluded.contains(l)))
  let unblocks = unblocks_map(scope.filter_team(), candidates)?
  // A claimed ready issue is someone's work in progress, not an invitation -
  // including my own claims. The agenda is what an agent can pick up NOW.
  // The claims themselves are read, not only the assignee (LLL-662): the
  // holder may set the assignee to someone else or clear it, and an issue
  // offered here that 'claim' then refuses is a lie to the loop.
  let held = claims.for_team(scope.filter_team())?.map(|c| c.issue)
  let agenda = rank_agenda(candidates, unblocks).filter(|i| i.assignee == "" && !held.contains(i.id))
  if agenda.is_empty() {
    return Err(pb.fail(pb.ErrorKind.NothingToDo, "no unclaimed ready issues: the agenda is empty; 'lll issue list --ready' shows what is claimed, 'lll issue create' makes new work"))
  }
  let best = agenda[0]
  let key = f"{best.expand.team.key}-{best.number}"
  if p.given("--claim") {
    let Some(member) = actor()? else {
      return Err(
        "claiming needs a member token: 'lll login' as a person, or 'lll token create <member>' with admin credentials",
      )
    }
    // Acquire before printing: a key this command did not secure is a lie to
    // the shell loop that composed it. A lost race exits non-zero, keyless.
    let result = claims.acquire(pb.Caller.Process, best.id, member.id, agent).map_err(|e| {
      if pb.classify(e).code == "claim_held" {
        f"{key}: {e}; {held_elsewhere_hint(key)}"
      } else { e }
    })?
    fmt.Fprintln(os.Stderr, f"Claimed {key} for {result.member_name}")
  }
  if p.given("--json") {
    // One packet replaces next-then-view: the 'lll issue view --json' object,
    // read after any claim so the record carries the new assignee. One shape
    // with or without --claim (LLL-645).
    let record = records.fetch_issue_record(key)?
    let mut full = models.Issue { .. }
    if let Err(e) = json.Unmarshal(record.bytes(), &full) {
      return Err(f"decoding issue: {e}")
    }
    let reads = begin_issue_view_reads(full, true, false)
    fmt.Println(issue_view_json(
      record,
      await_issue_view(reads.comments, "comments")?,
      await_issue_view(reads.claim, "claim")?,
      await_issue_view(reads.docs, "docs")?,
      await_issue_view(reads.findings, "findings")?,
    )?)
    return Ok(())
  }
  fmt.Println(key)
  Ok(())
}

/// The `list --ready` candidate set (LLL-175), reused as the `issue next`
/// agenda input: open, every blocker done or cancelled, within `scope` (a PB
/// filter: the configured team plus any --project/--label). PocketBase cannot
/// filter on an expanded relation's state, so readiness is decided here,
/// after the fetch.
fn ready_issues(scope: string) -> Result<Slice<models.Issue>, string> {
  let filter = url.QueryEscape(scope)
  let items = fetch_all_issues(f"&sort=created,id&expand=team,assignee,labels,blocked_by,project&filter={filter}")?
  Ok(items.filter(|i| is_ready(i, i.expand.blocked_by)))
}

/// Every page of an issues query, for the callers that must see the whole set
/// before they can order or filter it: readiness (PB cannot filter on an
/// expanded relation) and priority order (PB cannot express "none last").
/// `tail` carries the sort, expand and filter parameters, already escaped.
fn fetch_all_issues(tail: string) -> Result<Slice<models.Issue>, string> {
  let mut items: Slice<models.Issue> = []
  let mut page = 1
  loop {
    let body = pb.get(f"/api/collections/issues/records?perPage=500&page={page}{tail}")?
    let mut issues = NextPage { .. }
    if let Err(e) = json.Unmarshal(body.bytes(), &issues) {
      return Err(f"decoding issues: {e}")
    }
    for i in issues.items { items = items.append(i) }
    if page >= issues.total_pages || issues.items.is_empty() { break }
    page += 1
  }
  Ok(items)
}

/// Triage order (LLL-382). prio_rank is the house answer to "how urgent is
/// this" - 1 urgent .. 4 low, none last - shared with the board's priority
/// ordering and `issue next`. Descending reverses the prioritised ones and
/// still leaves none last: none is the ABSENCE of a priority, not one below
/// low, so it belongs at the end of a triage list whichever way it runs.
/// Stable insertion sort, so the PB order (priority,id) breaks ties.
fn rank_by_priority(items: Slice<models.Issue>, descending: bool) -> Slice<models.Issue> {
  let mut out = items.clone()
  for i in 1..out.length() {
    let mut j = i
    while j > 0 && prio_before(out[j], out[j - 1], descending) {
      let tmp = out[j - 1]
      out[j - 1] = out[j]
      out[j] = tmp
      j -= 1
    }
  }
  out
}

fn prio_before(a: models.Issue, b: models.Issue, descending: bool) -> bool {
  let ra = prio_rank(a.priority)
  let rb = prio_rank(b.priority)
  if ra == rb { return false }
  if ra == none_rank() || rb == none_rank() { return rb == none_rank() }
  if descending { return ra > rb }
  ra < rb
}

/// What prio_rank gives an issue with no priority.
fn none_rank() -> int { prio_rank(0) }

/// One --page window of a locally ordered list, the slice PB's perPage/page
/// would have returned had it been able to produce this order itself.
fn page_of(items: Slice<models.Issue>, page: int, per_page: int) -> Slice<models.Issue> {
  let start = (page - 1) * per_page
  if start >= items.length() { return [] }
  let mut end = start + per_page
  if end > items.length() { end = items.length() }
  items[start..end]
}

/// How many issues each candidate unblocks: the open issues that name it as
/// a blocker. A tie-break, not a goal — the more work one issue frees, the
/// sooner it should go.
fn unblocks_map(team_id: string, candidates: Slice<models.Issue>) -> Result<Map<string, int>, string> {
  let mut out = Map.new<string, int>()
  for c in candidates { out[c.id] = 0 }
  let scope = query.filter(team_id, "", "", "", "", "")
  let open = "state != 'done' && state != 'cancelled'"
  let clause = if scope == "" { open } else { f"{scope} && {open}" }
  let filter = url.QueryEscape(clause)
  let issues = fetch_all_issues(f"&sort=created,id&fields=id,blocked_by&filter={filter}")?
  for i in issues {
    for b in i.blocked_by {
      if let Some(n) = out.get(b) { out[b] = n + 1 }
    }
  }
  Ok(out)
}

/// Orders the agenda the way `issue next` hands out work: unclaimed first,
/// then more urgent (prio_rank, so none sorts after low), then older, then
/// the issue that unblocks more others. Insertion sort over a few hundred
/// ready issues at most, stable on the four keys' ties (import.lis's
/// sort_by_number is the house shape).
fn rank_agenda(items: Slice<models.Issue>, unblocks: Map<string, int>) -> Slice<models.Issue> {
  let mut out = items.clone()
  for i in 1..out.length() {
    let mut j = i
    while j > 0 && agenda_before(out[j], out[j - 1], unblocks) {
      let tmp = out[j - 1]
      out[j - 1] = out[j]
      out[j] = tmp
      j -= 1
    }
  }
  out
}

fn agenda_before(a: models.Issue, b: models.Issue, unblocks: Map<string, int>) -> bool {
  if (a.assignee == "") != (b.assignee == "") { return a.assignee == "" }
  let pa = prio_rank(a.priority)
  let qb = prio_rank(b.priority)
  if pa != qb { return pa < qb }
  let ta = parse_created(a.created)
  let tb = parse_created(b.created)
  if ta != tb { return ta < tb }
  unblocks.get(a.id).unwrap_or(0) > unblocks.get(b.id).unwrap_or(0)
}

/// A PB timestamp as seconds so age can compare. Unparseable strings sort as
/// 0 (oldest) — a malformed date should surface as "very old", not panic.
fn parse_created(stamp: string) -> int {
  let Ok(t) = time.Parse("2006-01-02 15:04:05.999Z", stamp) else { return 0 }
  t.Unix() as int
}
