/// Dispatch `lll issue <verb>` through the noun's Command table (TASK-307).
/// The table is the one place a verb is declared: dispatch, `lll issue --help`
/// and shell completions all read it, so none of the three can drift.
pub fn issue(args: Slice<string>) -> Result<(), string> {
  let cmds = issue_commands()
  if let Some(hint) = issue_synonym(args.get(2).unwrap_or("")) {
    return Err(flags.usage_error(hint))
  }
  if args.get(2) == Some("comment") && ["edit", "delete"].contains(args.get(3).unwrap_or("")) {
    let subargs = args[..2].append(args[3..]...)
    return flags.dispatch("issue comment", "change a comment", "", comment_commands(), subargs)
  }
  if args.get(2) == Some("comment") {
    if let Some(hint) = comment_verb_hint(args.get(3).unwrap_or("")) {
      return Err(flags.usage_error(hint))
    }
  }
  flags.dispatch("issue", "work with issues", issue_intro(), cmds, args)
}

/// `lll issue comment list KEY` and its kin: the only sub-verbs are edit and
/// delete, so name what each guessed word is spelled as instead of letting
/// the word fail as an issue ID.
fn comment_verb_hint(word: string) -> Option<string> {
  let hint = match word {
    "list" | "ls" | "view" | "show" => "'lll issue comment KEY-123' lists the comments, numbered",
    "add" | "create" | "new" => "'lll issue comment KEY-123 \"body\"' adds one (or -b \"body\")",
    "update" | "rm" | "remove" => "'lll issue comment edit KEY-123 N -b \"body\"' and 'lll issue comment delete KEY-123 N' change one",
    _ => "",
  }
  if hint == "" { return None }
  Some(
    f"unknown issue comment command: '{word}' - {hint}; the sub-verbs are edit and delete (see 'lll issue comment -h')",
  )
}

/// Verbs agents reach for that are not verbs here, each pointed at the
/// one that is. Counts are from the fleet replay: 'assign' five times in
/// thirty-shard runs, the rest once or twice.
fn issue_synonym(verb: string) -> Option<string> {
  let hint = match verb {
    "assign" => "take it for yourself with 'lll issue claim KEY-123'; assign someone else with 'lll issue update KEY-123 --assignee NAME'",
    "unassign" => "'lll issue release KEY-123' gives a claim back; 'lll issue update KEY-123 --assignee none' clears the assignee",
    "move" | "transition" => "'lll issue start KEY-123' sets in-progress; any state: 'lll issue update KEY-123 --state s'",
    "status" => "'lll issue view KEY-123' shows the state; 'lll issue update KEY-123 --state s' sets it",
    "get" => "'lll issue view KEY-123'",
    "find" | "search" => "'lll search text' ranks every issue, comment and doc with context; 'lll issue list --search text' filters titles",
    "ls" => "'lll issue list'",
    "rm" | "remove" => "'lll issue delete KEY-123'",
    "comments" => "'lll issue comment KEY-123' lists them; add one with a body after the key",
    "depends" | "dep" | "blocked-by" | "blockedby" => "'lll issue block KEY-123 BLOCKER' records that KEY-123 waits on BLOCKER; 'lll issue list --ready' lists what can start",
    _ => "",
  }
  if hint == "" { return None }
  Some(f"unknown issue command: '{verb}'; {hint} (see 'lll issue -h')")
}

/// Every issue verb, as a value. `page` is the hand-written help `issue
/// create` already had; its former pre-parse `--help` check is gone because
/// dispatch answers it now, and parses args against `spec` before `run` so a
/// trailing -h can never reach the verb body. The summaries are the old
/// print_usage rows, one line each.
pub fn issue_commands() -> Slice<flags.Command> {
  [
    flags.Command {
      name: "attach", summary: "upload a file to an issue; appends without replacing existing attachments",
      spec: flags.with_team([]), positional: "KEY-123 FILE", run: issue_attach,
      ..
    },
    flags.Command {
      name: "detach", summary: "remove an attachment by its stored filename (see issue view)",
      spec: flags.with_team([]), positional: "KEY-123 FILENAME", run: issue_detach,
      ..
    },
    flags.Command {
      name: "download", summary: "write attachment bytes to stdout; redirect to a file",
      spec: flags.with_team([]), positional: "KEY-123 FILENAME", run: issue_download,
      ..
    },
    flags.Command {
      name: "create", alias: "new",
      summary: "create an issue in the configured team; -b - reads the description from stdin; without --state it starts in todo",
      page: issue_create_page(),
      spec: issue_create_spec(),
      positional: "[\"title\"]",
      run: create,
      ..
    },
    flags.Command {
      name: "list",
      summary: "list issues; scoped to the configured team",
      spec: issue_list_spec(),
      run: list,
      ..
    },
    flags.Command {
      name: "next",
      summary: "print the key of the one issue to work next - ready and unclaimed, then priority (urgent first), then oldest, then most-unblocking; --claim takes it",
      spec: issue_next_spec(),
      run: issue_next,
      ..
    },
    flags.Command {
      name: "view", alias: "show",
      summary: "show one issue in full, with comments; --raw prints it as plain markdown; -w opens its web page instead",
      spec: issue_view_spec(),
      positional: "[KEY-123]",
      run: view,
      ..
    },
    flags.Command {
      name: "update",
      alias: "edit",
      summary: "change fields (at least one flag)",
      spec: issue_update_spec(),
      positional: "[KEY-123]",
      run: update,
      ..
    },
    flags.Command {
      name: "close",
      summary: "set state done and release your claim (--keep-claim keeps it); another member's claimed issue needs --force, which comments why",
      spec: issue_close_spec(),
      positional: "[KEY-123]",
      run: close_issue,
      ..
    },
    flags.Command {
      name: "start",
      summary: "set state in-progress; --branch also git-switches to key-number-slug and records the work site",
      spec: issue_start_spec(),
      positional: "[KEY-123]",
      run: start,
      ..
    },
    flags.Command {
      name: "claim",
      summary: "take it exclusively for the authenticated member and assign it; exits non-zero, changing nothing, when someone already holds it; --renew restarts your hold's 24h expiry",
      spec: issue_claim_spec(),
      positional: "[KEY-123]",
      run: claim,
      ..
    },
    flags.Command {
      name: "release",
      summary: "remove your claim; clear assignee if it still matches the holder; --force takes another member's or another agent label's and comments why",
      spec: issue_release_spec(),
      positional: "[KEY-123]",
      run: release,
      ..
    },
    flags.Command {
      name: "delete",
      summary: "delete; asks [y/N] unless --yes; a claimed issue needs --force, which releases the claim first",
      spec: issue_delete_spec(),
      positional: "KEY-123",
      run: delete_issue,
      ..
    },
    flags.Command {
      name: "comment",
      summary: "add a comment (bare body or -b); 'comment KEY' lists them numbered; 'comment edit KEY N -b' and 'comment delete KEY N' change your own",
      spec: issue_comment_spec(),
      positional: "[KEY-123] [\"body\"]",
      run: comment,
      ..
    },
    flags.Command {
      name: "watch",
      summary: "stream live events for the issue and its comments until interrupted",
      spec: issue_watch_spec(),
      positional: "[KEY-123]",
      run: issue_watch,
      ..
    },
    flags.Command {
      name: "url",
      summary: "print the issue's web page URL",
      spec: flags.with_team([]),
      positional: "[KEY-123]",
      run: url_cmd,
      ..
    },
    flags.Command {
      name: "id",
      summary: "print the issue's KEY-123 identifier",
      spec: flags.with_team([]),
      positional: "[KEY-123]",
      run: id_cmd,
      ..
    },
    flags.Command {
      name: "title",
      summary: "print the issue's title",
      spec: flags.with_team([]),
      positional: "[KEY-123]",
      run: title_cmd,
      ..
    },
    flags.Command { name: "branch-name", summary: "print a suggested Git branch name; read-only", spec: flags.with_team([]), positional: "[KEY-123]", run: branch_name_cmd, .. },
    flags.Command {
      name: "pr",
      summary: "open a GitHub PR via 'gh pr create' and record gh#N; body links the issue and includes its description when it fits",
      spec: flags.with_team([]),
      positional: "[KEY-123]",
      run: pr_cmd,
      ..
    },
    flags.Command {
      name: "ref", summary: "append an external reference once (gh#42, linear:ENG-118)",
      spec: flags.with_team([]), positional: "KEY-123 REF", run: ref_cmd,
      ..
    },
    flags.Command {
      name: "link",
      summary: "link the issue to a doc (see 'lll doc --help')",
      spec: flags.with_team([]),
      positional: "KEY-123 SLUG",
      run: link,
      ..
    },
    flags.Command {
      name: "unlink",
      summary: "remove that link",
      spec: flags.with_team([]),
      positional: "KEY-123 SLUG",
      run: unlink,
      ..
    },
    flags.Command {
      name: "block",
      summary: "record that KEY-123 cannot start until BLOCKER is done; view shows it, list --ready honours it",
      spec: flags.with_team([]),
      positional: "KEY-123 BLOCKER",
      run: block,
      ..
    },
    flags.Command {
      name: "unblock",
      summary: "remove BLOCKER from KEY-123's blockers",
      spec: flags.with_team([]),
      positional: "KEY-123 BLOCKER",
      run: unblock,
      ..
    },
  ]
}

/// Every flag across the issue verbs, deduplicated by canonical name
/// (first wording wins), in the order the table declares them. This is the
/// Flags: block `lll issue --help` renders under the verb rows.
fn issue_union_spec() -> Slice<flags.Flag> {
  let mut out: Slice<flags.Flag> = []
  for c in issue_commands() {
    for fl in c.spec {
      // Keyed by name AND aliases: -b is the description on create and
      // update, an alias of --reason on release, and every row belongs here.
      if out.find(|f| f.name == fl.name && f.alias == fl.alias).is_none() { out = out.append(fl) }
    }
  }
  out
}

/// Prose that belongs to the noun rather than to any one verb; dispatch
/// prints it under the verb table for `lll issue --help`. The union Flags:
/// block leads, as it did before the table, so no flag's help line is lost
/// from the noun page.
fn issue_intro() -> string {
  strings.TrimPrefix(flags.section(issue_union_spec()), "\n") +
    "

Web URLs come from LLL_WEB_URL, then 'web_url' in the repo or home config.
Set the deployed board address with 'lll config set web_url URL';
'lll up' saves the actual endpoint when it starts the board.

Full view --json preserves the issue record and adds comments (oldest first,
author expanded; a bot author's owner under author.expand.owner when you can
read it), claim ({id, member, holder, agent, claimed, renewed}, or null), docs
(explicit links), and findings (linked or label-area matches). Docs and findings
include their bodies and use slug order; empty collections are [].
Close releases the closer's own claim and keeps the assignee; --keep-claim
keeps the claim. Other state changes (including review) retain claims.
Release ends the hold; an assignment to someone other than the holder is
preserved. Forcing another holder's claim takes --force, with --reason for
the comment it leaves.

When KEY-123 is omitted (except for delete), it is inferred from the current
git branch: eng-12-fix-login resolves to ENG-12.

State glyphs: ◌ backlog  ○ todo  ◐ in-progress  ◉ in-review  ● done  ⊗ cancelled

The team comes from LLL_TEAM or 'team' in .lll.toml (see 'lll config --help')."
}

fn issue_create_page() -> string {
  "lll issue create - create an issue in the configured team

Usage:
  " +
    flags.usage("lll issue create", issue_create_spec(), "[\"title\"]") +
    "
" +
    flags.section(issue_create_spec()) +
    "

The title is the bare argument or -t; give either, not both.

The team comes from 'lll attach' ('team' in .lll.toml), or LLL_TEAM.
Without --state the issue starts in todo; --label may be repeated."
}

fn create(input: flags.CommandInput) -> Result<(), string> {
  let usage = input.usage
  // A bare title is accepted alongside -t: `gh issue create`, `linear` and
  // `jira` all take one, and every usability run reached for it first and got
  // "unknown flag: 'Hello'". -t stays the documented spelling, so no script
  // breaks; the positional is the guess that now lands.
  let p = input.parsed
  let key = strings.TrimSpace(p.one("--idempotency-key"))
  if p.given("--idempotency-key") && key == "" {
    return Err(flags.usage_error("--idempotency-key must not be empty"))
  }
  let title = if p.one("-t") != "" { p.one("-t") } else { p.first() }
  if title == "" {
    return Err(f"no title: give it as the bare argument or with -t\n{usage}")
  }
  let mut description = ""
  if p.given("-b") { description = value_or_stdin(p.one("-b"), "-b")? }
  let emoji = check_emoji(p.one("--emoji"))?
  let mut priority = 0
  if p.given("--priority") { priority = check_priority(p.one("--priority"))? }
  // Same validator update calls, so create and update cannot disagree about
  // what a state is; the list itself lives once in query.states().
  let mut state = "todo"
  if p.given("--state") { state = query.state(p.one("--state"))? }
  let assignee_name = p.one("--assignee")
  let label_names = p.all("--label")
  let project_name = p.one("--project")

  // The team first: it scopes the label and project names below, which are
  // unique per team and not across them (TASK-173).
  let team = current_team()?
  // New issues do not land in an archived team (TASK-210): archived is the
  // lifecycle's end, and reviving it is a deliberate one-command act.
  if team.archived { return Err(archived_hint(team.key)) }

  let mut assignee = ""
  if assignee_name != "" { assignee = records.resolve_member(assignee_name)?.id }

  let mut project = ""
  if project_name != "" { project = records.resolve_project(team.id, project_name)?.id }

  let mut labels: Slice<string> = []
  for name in label_names {
    labels = labels.append(records.resolve_label(team.id, name)?.id)
  }

  // --agent names the session as the other claim verbs do; without it the
  // origin tool stays LLL_AGENT, as capture() reads it.
  let mut origin = provenance.capture()
  if p.given("--agent") { origin.tool = agent_label(p)? }
  let new_issue = models.NewIssue {
    creator: actor()?.map_or("", |member| member.id),
    origin,
    team: team.id,
    title,
    description,
    emoji,
    state,
    priority,
    assignee,
    project,
    labels,
    ..
  }
  let payload = match json.Marshal(new_issue) {
    Ok(p) => p,
    Err(e) => return Err(f"encoding issue: {e}"),
  }
  let path = if p.given("--json") {
    "/api/collections/issues/records?expand=team,assignee,labels,project,creator"
  } else {
    "/api/collections/issues/records"
  }
  let body = if key == "" {
    pb.post(path, payload as string)?
  } else {
    let supported = pb.get("/api/lll/issues/idempotency").map_err(|e| {
      if pb.classify(e).status == 404 {
        "this server does not support --idempotency-key; upgrade the server before retrying this creation"
      } else { e }
    })?
    let mut support = IdempotencySupport { .. }
    if let Err(e) = json.Unmarshal(supported.bytes(), &support) {
      return Err(f"decoding creation support: {e}")
    }
    if !support.supported { return Err("this server does not support --idempotency-key; upgrade the server before retrying this creation") }
    pb.post_idempotent(path, payload as string, key)?
  }

  let mut created = models.Issue { .. }
  if let Err(e) = json.Unmarshal(body.bytes(), &created) {
    return Err(f"decoding created issue: {e}")
  }
  // PocketBase expands the create response itself. A later read must not
  // turn a successful write into an apparent failure and invite retries.
  if p.given("--json") {
    return print_issue_json(body, None)
  }
  let mut reuse = CreationReuse { .. }
  if let Err(e) = json.Unmarshal(body.bytes(), &reuse) {
    return Err(f"decoding creation reuse: {e}")
  }
  let action = if reuse.reused { "Reused" } else { "Created" }
  fmt.Println(f"{action} {team.key}-{created.number}: {created.title}")
  Ok(())
}

#[json]
struct IdempotencySupport { supported: bool }

/// The hint a title-only search prints when nothing matched (LLL-484). The
/// contract ("titles only") is the part a fresh reader cannot see from an
/// empty result, and 'lll search' is the escape hatch into descriptions,
/// comments and docs.
fn empty_search_hint(search: string) -> string {
  f"no issues with '{search}' in the title; --search matches titles only: 'lll search {search}' also looks in descriptions, comments and docs"
}

#[json]
struct CreationReuse { reused: bool }

fn list(input: flags.CommandInput) -> Result<(), string> {
  let p = input.parsed
  let filters = filters_from(p)?
  let since = if p.given("--since") { issue_since_stamp(p.one("--since"))? } else { "" }
  let sort_flag = p.one("--sort")
  let mut limit = 0
  if p.given("--limit") {
    let raw = p.one("--limit")
    let Ok(n) = strconv.Atoi(raw) else {
      return Err(flags.usage_error(f"--limit must be a positive integer, got '{raw}'"))
    }
    if n < 1 { return Err(flags.usage_error(f"--limit must be a positive integer, got {n}")) }
    limit = n
  }
  let mut page = 1
  if p.given("--page") {
    let raw = p.one("--page")
    let Ok(n) = strconv.Atoi(raw) else {
      return Err(flags.usage_error(f"--page must be a positive integer, got '{raw}'"))
    }
    if n < 1 { return Err(flags.usage_error(f"--page must be a positive integer, got {n}")) }
    page = n
  }
  let json_mode = p.given("--json")
  let ready_only = p.given("--ready")
  let blocked_only = p.given("--blocked")
  if ready_only && blocked_only { return Err(flags.usage_error("--ready and --blocked exclude each other")) }

  let cfg = config.load()?

  // A configured team (LLL_TEAM or .lll.toml) scopes the list by default,
  // and with it the label and project names the list filters by.
  let scope = configured_scope()?

  let mut sort_spec = sort_flag
  if sort_spec == "" { sort_spec = cfg.sort }
  if sort_spec == "" { sort_spec = "created" }
  let sort = query.sort(sort_spec)?

  // --limit applies server-side via PB's perPage (capped by PB at 500).
  let mut per_page = 200
  if limit > 0 { per_page = limit }
  let mut filter = resolve_filter_query(scope, filters)?
  if since != "" {
    let clause = f"updated >= {query.quote(since)}"
    filter = if filter == "" { clause } else { f"{filter} && {clause}" }
  }
  let mut tail = "&expand=team,assignee,labels,blocked_by,project"
  if filter != "" { tail = f"{tail}&filter={url.QueryEscape(filter)}" }

  // LLL-382: PocketBase can only sort priority as the number it stores, and
  // none is 0, so its ascending order leads with the unprioritised - the
  // opposite of what a triage list is for. No PB sort expression can say
  // "none last", so that order is decided here, over the WHOLE result set:
  // one page of the raw numeric order holds the wrong issues, not merely the
  // right ones in the wrong order, and urgent work past the page falls off.
  let by_priority = strings.TrimPrefix(sort_spec, "-") == "priority"
  // LLL-673: --ready and --blocked are decided here, after the fetch, so like
  // priority order they need the WHOLE result: filtering one page dropped
  // ready issues past it and reported the page's count as the total.
  let mode = if by_priority || ready_only || blocked_only { ListMode.Whole } else { ListMode.Page }
  let (fetched, raw_records, served) = match mode {
    ListMode.Whole => {
      let order = if by_priority { "&sort=priority,id" } else { f"&sort={url.QueryEscape(sort + ",id")}" }
      let (all, raw) = fetch_all_listed(f"{order}{tail}")?
      let ordered = if by_priority { rank_by_priority(all, strings.HasPrefix(sort_spec, "-")) } else { all }
      (ordered, raw, page_of_total(page, per_page, 0))
    },
    ListMode.Page => {
      let path = f"/api/collections/issues/records?perPage={per_page}{tail}&sort={url.QueryEscape(sort + ",id")}&page={page}"
      let listed = fetch_listed_page(path)?
      (listed.issues, listed.raw, page_of_total(page, per_page, listed.total_items))
    },
  }
  let mut items = fetched
  let mut at = served
  // LLL-175: --ready is what an agent can pick up now - open, and every
  // blocker done or cancelled; --blocked is the complement with at least
  // one open blocker. Decided here, after the fetch, because PocketBase
  // cannot filter on an expanded relation's state.
  if ready_only {
    items = items.filter(|i| is_ready(i, i.expand.blocked_by))
  }
  if blocked_only {
    items = items.filter(|i| blockers_of(i, i.expand.blocked_by).any())
  }
  if let ListMode.Whole = mode {
    at = page_of_total(page, per_page, items.length())
    items = page_of(items, page, per_page)
  }
  // LLL-651: the claim rides the list, so automation need not view each card.
  let held = if items.is_empty() { Map.new<string, models.Claim>() } else { claims_by_issue(scope.filter_team())? }
  if json_mode {
    let mut out: Slice<Map<string, json.RawMessage>> = []
    for i in items {
      out = out.append(issue_json(raw_records.get(i.id).unwrap_or("null".bytes() as json.RawMessage), held.get(i.id))?)
    }
    return print_list_json(out, at, "issues")
  }
  // LLL-484 (fleet case 01): --search matches TITLES, and seven of ten fresh
  // workers read the bare "no issues" as "the term is nowhere on the board"
  // when it sat in a description. When a title search came up empty, name
  // the narrower contract and the full-text escape hatch. STDERR, like the
  // plain empty message, so stdout stays empty for pipes and --json is
  // untouched.
  if items.is_empty() && filters.search != "" {
    let _ = fmt.Fprintln(os.Stderr, empty_search_hint(filters.search))
    return Ok(())
  }
  print_issue_table(items, held)
}

/// How `issue list` reads: one server page, or every page when the order or
/// the filter is decided here and a page of the server's answer would hold
/// the wrong issues (LLL-382 priority, LLL-673 ready and blocked).
enum ListMode {
  Page,
  Whole,
}

/// One page of issues, decoded for filtering and kept raw for --json, which
/// prints the server's record (plus key and claim), not the decoded subset.
struct ListedPage {
  issues: Slice<models.Issue>,
  raw: Map<string, json.RawMessage>,
  total_items: int,
  total_pages: int,
}

#[json]
struct RawIssuePage {
  items: Slice<json.RawMessage>,
  #[json("totalItems")]
  total_items: int,
  #[json("totalPages")]
  total_pages: int,
}

fn fetch_listed_page(path: string) -> Result<ListedPage, string> {
  let mut page = RawIssuePage { .. }
  pb.fetch(path, "issues", &page)?
  let mut issues: Slice<models.Issue> = []
  let mut by_id = Map.new<string, json.RawMessage>()
  for record in page.items {
    let mut issue = models.Issue { .. }
    if let Err(e) = json.Unmarshal(record, &issue) { return Err(f"decoding issues: {e}") }
    issues = issues.append(issue)
    by_id[issue.id] = record
  }
  Ok(ListedPage { issues, raw: by_id, total_items: page.total_items, total_pages: page.total_pages })
}

/// Every page of an issues query, decoded and raw (fetch_all_issues, for a
/// list that prints records).
fn fetch_all_listed(tail: string) -> Result<(Slice<models.Issue>, Map<string, json.RawMessage>), string> {
  let mut issues: Slice<models.Issue> = []
  let mut by_id = Map.new<string, json.RawMessage>()
  let mut page = 1
  loop {
    let listed = fetch_listed_page(f"/api/collections/issues/records?perPage=500&page={page}{tail}")?
    issues = issues.append(listed.issues...)
    for (id, record) in listed.raw { by_id[id] = record }
    if page >= listed.total_pages || listed.issues.is_empty() { break }
    page += 1
  }
  Ok((issues, by_id))
}

/// Every claim on the team's issues (every visible team's when `team_id` is
/// ""), by issue id. Claims are one per issue in progress, so this is small.
fn claims_by_issue(team_id: string) -> Result<Map<string, models.Claim>, string> {
  let filter = if team_id == "" { "" } else { f"&filter={url.QueryEscape(f"issue.team={query.quote(team_id)}")}" }
  let mut out = Map.new<string, models.Claim>()
  let mut page = 1
  loop {
    let mut list = models.ClaimList { .. }
    pb.fetch(f"/api/collections/claims/records?expand=member&sort=id&perPage=500&page={page}{filter}", "claims", &list)?
    for c in list.items { out[c.issue] = c }
    if page >= list.total_pages || list.items.is_empty() { break }
    page += 1
  }
  Ok(out)
}

/// Normalize an inclusive bound to the server's millisecond UTC stamps.
/// Round UP when the input falls between stored milliseconds, so an issue
/// updated just before the requested instant cannot slip into the result.
fn issue_since_stamp(given: string) -> Result<string, string> {
  let value = rfc3339_of(given)
  let invalid = flags.usage_error(f"--since takes an RFC3339 timestamp, e.g. 2026-09-18T00:00:00Z or 2026-09-18T02:00:00+02:00, or the space form older output printed; got '{given}'")
  // Go's parser also accepts comma fractions and malformed numeric offsets.
  // Keep the advertised RFC3339 grammar, then let Parse validate the date.
  let parts = regexp
    .MustCompile(
      r"^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\.[0-9]+)?(Z|[+-]([01][0-9]|2[0-3]):[0-5][0-9])$",
    )
    .FindStringSubmatch(value)
  if parts.is_empty() { return Err(invalid) }
  let Ok(parsed) = time.Parse(time.RFC3339, value) else {
    return Err(invalid)
  }
  let mut stamp = parsed.UTC().Truncate(time.Millisecond)
  let fraction = parts[1]
  // The regex guarantees ASCII, so these rune offsets also count digits.
  // Inspect the original fraction: Parse truncates precision beyond nanos.
  if fraction.length() > 4 && strings.Trim(fraction.substring(4..), "0") != "" {
    stamp = stamp.Add(time.Millisecond)
  }
  if stamp.Year() < 0 || stamp.Year() > 9999 {
    return Err(flags.usage_error("--since must fit a UTC year from 0000 to 9999"))
  }
  Ok(stamp.Format("2006-01-02 15:04:05.000Z"))
}

/// A time flag's value in RFC3339 (LLL-645). Time flags take RFC3339 and the
/// space form PocketBase stores ("2026-10-08 03:02:11.982Z"), which --json
/// printed before 1.0, so a stamp copied from either still works. Anything
/// else is returned unchanged for the caller's own validation.
fn rfc3339_of(value: string) -> string {
  let space_form = regexp.MustCompile(r"^[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}:[0-9]{2}(\.[0-9]+)?Z$")
  if space_form.MatchString(value) { return strings.Replace(value, " ", "T", 1) }
  value
}

/// --if-unchanged-since as the server's stamp. The instant is what matters:
/// RFC3339 in any offset and the space form name the same 'updated' when
/// they name the same millisecond, the precision the server stores.
fn unchanged_since_stamp(given: string) -> Result<string, string> {
  let Ok(parsed) = time.Parse(time.RFC3339Nano, rfc3339_of(given)) else {
    return Err(flags.usage_error(f"--if-unchanged-since takes the issue's 'updated' from 'lll issue view KEY --json' (RFC3339, or the space form older output printed); got '{given}'"))
  }
  Ok(parsed.UTC().Truncate(time.Millisecond).Format("2006-01-02 15:04:05.000Z"))
}

/// The standard issue table (ID, state, priority, title, assignee, age),
/// shared by `issue list` and `project view`. `held` is the claims by issue
/// id: a claimed issue names its holder, agent label and claim age where the
/// assignee goes (LLL-651).
fn print_issue_table(issues: Slice<models.Issue>, held: Map<string, models.Claim>) -> Result<(), string> {
  // An empty board printed zero bytes, which a newcomer cannot tell apart
  // from a silently broken read — the exact doubt the not-logged-in refusal
  // warns about, landing one command later. Says so on STDERR: stdout stays
  // empty so pipes and `| wc -l` are unchanged, and --json returns before
  // ever reaching here.
  if issues.is_empty() {
    let _ = fmt.Fprintln(os.Stderr, "no issues")
    return Ok(())
  }
  let mut rows: Slice<Slice<string>> = []
  for item in issues {
    let key = item.expand.team.key
    let assignee = match held.get(item.id) {
      Some(c) => f"{display.byline(display.member_name(c.member, c.expand.member.name, ""), c.agent)}, claimed {display.relative(c.updated)}",
      None => display.member_name(item.assignee, item.expand.assignee.name, ""),
    }
    let mut row = [f"{key}-{item.number}", f"{display.glyph(item.state)} {item.state}", display.priority_marker(item.priority), item.title, assignee, display.relative(item.updated)]
    if item.emoji != "" { row = row.append(item.emoji) }
    rows = rows.append(row)
  }
  if let Err(e) = fmt.Fprint(os.Stdout, display.table(rows)) { return Err(f"writing output: {e}") }
  Ok(())
}

struct IssueViewReads {
  claim: Channel<Result<Option<models.Claim>, string>>,
  docs: Channel<Result<Slice<models.Doc>, string>>,
  blocks: Channel<Result<Slice<models.Issue>, string>>,
  findings: Channel<Result<Slice<models.Doc>, string>>,
  comments: Channel<Result<Slice<models.Comment>, string>>,
}

/// Start only the reads this output mode already uses. Each result has room
/// to finish even when an earlier error makes the caller stop receiving.
fn begin_issue_view_reads(
  full: models.Issue,
  json_mode: bool,
  raw_mode: bool,
) -> IssueViewReads {
  let reads = IssueViewReads {
    claim: Channel.buffered<Result<Option<models.Claim>, string>>(1),
    docs: Channel.buffered<Result<Slice<models.Doc>, string>>(1),
    blocks: Channel.buffered<Result<Slice<models.Issue>, string>>(1),
    findings: Channel.buffered<Result<Slice<models.Doc>, string>>(1),
    comments: Channel.buffered<Result<Slice<models.Comment>, string>>(1),
  }
  // Every mode shows the claim; --raw too since LLL-638.
  task {
    let _ = reads.claim.send(fetch_claim(full.id))
  }
  if json_mode || !raw_mode {
    task {
      let _ = reads.docs.send(fetch_issue_docs(full.id))
    }
  }
  if !json_mode && !raw_mode {
    task {
      let _ = reads.blocks.send(fetch_blocks(full.id))
    }
  }
  task {
    let _ = reads.findings.send(findings_for_issue(full))
  }
  task {
    let _ = reads.comments.send(records.fetch_comments(full.id))
  }
  reads
}

fn await_issue_view<T>(
  answer: Channel<Result<T, string>>,
  what: string,
) -> Result<T, string> {
  let Some(result) = answer.receive() else {
    return Err(f"issue {what} fetch ended without an answer")
  }
  result
}

fn view(input: flags.CommandInput) -> Result<(), string> {
  let spec = issue_view_spec()
  let p = input.parsed
  let id = p.first()
  let json_mode = p.given("--json")
  let raw_mode = p.given("--raw")
  let open_web = p.given("-w")
  let resolved = resolve_id(
    id,
    flags.usage("lll issue view", spec, "[KEY-123]"),
  )?

  if open_web {
    let target = issue_url(records.fetch_issue(resolved)?)?
    fmt.Println(f"Opening {target}")
    return open_url(target)
  }

  let record = records.fetch_issue_record(resolved)?
  let mut full = models.Issue { .. }
  if let Err(e) = json.Unmarshal(record.bytes(), &full) {
    return Err(f"decoding issue: {e}")
  }
  let reads = begin_issue_view_reads(full, json_mode, raw_mode)
  if json_mode {
    fmt.Println(issue_view_json(
      record,
      await_issue_view(reads.comments, "comments")?,
      await_issue_view(reads.claim, "claim")?,
      await_issue_view(reads.docs, "docs")?,
      await_issue_view(reads.findings, "findings")?,
    )?)
    return Ok(())
  }

  // --raw: the issue as markdown, no chrome. For piping, and for an agent that
  // wants the text rather than a rendered table.
  if raw_mode {
    fmt.Println(f"# {full.expand.team.key}-{full.number}: {full.title}")
    let source = provenance.fields(full)
    // LLL-638: an agent reading --raw must see who holds the issue. Absolute
    // times, like the comments below: --raw output is stored and re-read.
    let claim_line = match await_issue_view(reads.claim, "claim")? {
      Some(held) => {
        let holder = display.byline(display.member_name(held.member, held.expand.member.name, "an unknown member"), held.agent)
        let renewed = if held.updated == "" || held.updated == held.created { "" } else { f", renewed {display.absolute(held.updated)}" }
        Some(f"- **Claimed:** {holder} (since {display.absolute(held.created)}{renewed})")
      },
      None => None,
    }
    if !source.is_empty() || claim_line.is_some() {
      fmt.Println("")
      for field in source { fmt.Println(f"- **{field.label}:** {field.value}") }
      if let Some(line) = claim_line { fmt.Println(line) }
    }
    if full.description != "" {
      fmt.Println("")
      fmt.Println(full.description)
    }
    let comments = await_issue_view(reads.comments, "comments")?
    if !full.attachments.is_empty() {
      fmt.Println("\n## Attachments")
      for name in full.attachments { fmt.Println(f"- {name}") }
    }
    if comments.length() > 0 {
      fmt.Println("")
      fmt.Println("## Comments")
      for cm in comments {
        let author = display.comment_byline(cm.author_kind, cm.author, cm.expand.author.name, cm.agent, "ghost")
        // Absolute, not relative: --raw is machine output that gets stored
        // and re-read (an agent's brief, an exported mirror in Git), where
        // "5d ago" silently becomes a different string tomorrow.
        let tag = if cm.author_kind == "system" { "" } else { display.author_tag(cm.expand.author.kind == "bot", cm.expand.author.owner_name()) }
        fmt.Println(
          f"- **{author}**{tag} ({display.absolute(cm.created)}): {cm.body}",
        )
      }
    }
    print_findings_raw(await_issue_view(reads.findings, "findings")?)?
    return Ok(())
  }

  let assignee = display.member_name(full.assignee, full.expand.assignee.name, "none")

  let mut project = full.expand.project.name
  if project == "" { project = "none" }

  let mut labels = strings.Join(full.expand.labels.map(|l| l.name), ", ")
  if labels == "" { labels = "none" }

  fmt.Println(f"{full.expand.team.key}-{full.number} {full.title}")
  fmt.Println("")
  fmt.Println(f"State:     {display.glyph(full.state)} {full.state}")
  fmt.Println(f"Priority:  {display.priority_name(full.priority)}")
  fmt.Println(f"Assignee:  {assignee}")
  for field in provenance.fields(full) { fmt.Println(f"{field.label}: {field.value}") }
  // The one place the second collection is read on a plain view: assignee says
  // who it is for, Claimed says who is holding it right now, and only the
  // latter is exclusive.
  let claim = await_issue_view(reads.claim, "claim")?
  if let Some(held) = claim {
    let holder = display.member_name(held.member, held.expand.member.name, "an unknown member")
    fmt.Println(f"Claimed:   {display.byline(holder, held.agent)} ({display.relative(held.created)})")
  }
  // The work-site slot (TASK-205), under the claim holder: the claim says
  // who, this says where. "(last seen)" once the work is over.
  if full.work_branch != "" {
    let mut work = f"{full.work_branch} @ {full.work_host}:{full.work_path}"
    if work_site_stale(full.state, claim.is_some()) {
      work = f"{work} (last seen)"
    }
    fmt.Println(f"Work:      {work}")
  }
  fmt.Println(f"Project:   {project}")
  fmt.Println(f"Labels:    {labels}")
  if !full.attachments.is_empty() {
    fmt.Println("Attachments:")
    for name in full.attachments { fmt.Println(f"  {name}") }
  }
  let linked_docs = await_issue_view(reads.docs, "docs")?
  if linked_docs.length() > 0 {
    let slugs = linked_docs.map(|d| d.slug)
    fmt.Println(f"Docs:      {strings.Join(slugs, ", ")}")
  }
  if full.blocked_by.length() > 0 {
    // Each blocker under its OWN team's key (LLL-674): a cross-team blocker
    // printed with this issue's key named a different, real issue. One the
    // reader cannot see is only counted, never named (LLL-672).
    let mut parts: Slice<string> = []
    for id in full.blocked_by {
      match full.expand.blocked_by.find(|b| b.id == id) {
        Some(b) => { parts = parts.append(f"{b.expand.team.key}-{b.number} ({b.state})") },
        None => { parts = parts.append("a hidden issue") },
      }
    }
    let blockers = blockers_of(full, full.expand.blocked_by)
    let open = blockers.open.length()
    // is_ready's archived rule (LLL-679): an archived team's issue is not ready.
    let done = if full.expand.team.archived { "; all done, but the team is archived" } else { "; all done, ready" }
    let mut tail = if open == 0 { done } else { f"; {open} open, not ready" }
    if blockers.hidden > 0 {
      let counted = if open == 0 { "" } else { f"{open} open, " }
      tail = f"; {counted}{blockers.hidden} you cannot see, not ready"
    }
    fmt.Println(f"Blocked by: {strings.Join(parts, ", ")}{tail}")
  }
  let blocks = await_issue_view(reads.blocks, "blocks")?
  if blocks.length() > 0 {
    let keys = blocks.map(|b| f"{b.expand.team.key}-{b.number}")
    fmt.Println(f"Blocks:    {strings.Join(keys, ", ")}")
  }
  if full.emoji != "" { fmt.Println(f"Emoji:     {full.emoji}") }
  fmt.Println(f"Created:   {display.relative(full.created)}")
  fmt.Println(f"Updated:   {display.relative(full.updated)}")
  if full.description != "" {
    fmt.Println("")
    fmt.Println(full.description)
  }

  // The brief mechanism (TASK-103 AC#3): an agent's task brief carries the
  // findings for the work it is about to do without a human choosing them.
  // Fifteen of thirty fleet agents lost the two docs they had linked in a
  // list of ninety area matches. Linked findings come first and always show
  // (the brief contract, TASK-103 AC#3); the area matches stop at a handful
  // with a pointer. The --raw brief keeps the whole list on purpose.
  let linked = linked_docs.map(|d| d.slug)
  let findings = await_issue_view(reads.findings, "findings")?
  if findings.length() > 0 {
    fmt.Println("")
    fmt.Println("Related findings:")
    fmt.Println("")
    let mut area_matches = 0
    let mut hidden = 0
    for f in findings {
      let is_linked = linked.contains(f.slug)
      if !is_linked {
        area_matches += 1
        if area_matches > 5 {
          hidden += 1
          continue
        }
      }
      let mut area = f.area
      if area == "" { area = "-" }
      fmt.Println(f"{f.slug} ({area}): {f.title}{confidence_suffix(f.confidence, f.confidence_note)}")
    }
    if hidden > 0 {
      fmt.Println(f"... and {hidden} more by area; 'lll finding list -a AREA' lists an area, 'lll issue view --raw' prints them all")
    }
  }

  let comments = await_issue_view(reads.comments, "comments")?
  fmt.Println("")
  if comments.length() > 0 {
    fmt.Println("Comments:")
    fmt.Println("")
    print_comments(comments)
  } else {
    // Said, not omitted: an agent checking whether its comment landed
    // could not tell "none" from "not shown" (fleet: 2 of 10).
    fmt.Println("Comments: none")
  }
  Ok(())
}

/// Keep every server field intact while exposing the handoff context that
/// the normal view already shows. RawMessage preserves unknown fields and
/// exact numbers instead of decoding arbitrary records through float64.
fn issue_view_json(
  record: string,
  comments: Slice<models.Comment>,
  claim: Option<models.Claim>,
  docs: Slice<models.Doc>,
  findings: Slice<models.Doc>,
) -> Result<string, string> {
  // The list's issue object (key, claim, RFC3339 timestamps) plus what only
  // the view carries, so one parser reads every issue --json (LLL-645).
  let mut fields = issue_json(record.bytes() as json.RawMessage, claim)?.clone()
  let comments_json = match json.Marshal(comments) {
    Ok(data) => contract_json(data as json.RawMessage, 0),
    Err(e) => return Err(f"encoding comments: {e}"),
  }
  fields["comments"] = if comments.is_empty() { "[]".bytes() as json.RawMessage } else { comments_json }
  fields["docs"] = contract_json(doc_context_json(docs)?, 0)
  fields["findings"] = contract_json(doc_context_json(findings)?, 0)
  match json.Marshal(fields) {
    Ok(data) => Ok(data as string),
    Err(e) => Err(f"encoding issue JSON: {e}"),
  }
}

/// `--json` on the verbs that change an issue (update, close, start, claim):
/// the issue as it is after the write, in the list's per-item shape.
fn print_issue_after(key: string) -> Result<(), string> {
  let record = records.fetch_issue_record(key)?
  let mut full = models.Issue { .. }
  if let Err(e) = json.Unmarshal(record.bytes(), &full) { return Err(f"decoding issue: {e}") }
  print_issue_json(record, fetch_claim(full.id)?)
}

fn doc_context_json(docs: Slice<models.Doc>) -> Result<json.RawMessage, string> {
  if docs.is_empty() { return Ok("[]".bytes() as json.RawMessage) }
  match json.Marshal(docs) {
    Ok(data) => Ok(data as json.RawMessage),
    Err(e) => Err(f"encoding document context: {e}"),
  }
}

/// The '## Related findings' block of `lll issue view --raw` — same list
/// findings_for_issue serves the rendered view, as plain markdown so an
/// agent's piped brief carries the findings too.
fn print_findings_raw(findings: Slice<models.Doc>) -> Result<(), string> {
  if findings.is_empty() { return Ok(()) }
  fmt.Println("")
  fmt.Println("## Related findings")
  fmt.Println("")
  for f in findings {
    let mut area = f.area
    if area == "" { area = "-" }
    fmt.Println(f"- {f.slug} ({area}): {f.title}{confidence_suffix(f.confidence, f.confidence_note)}")
  }
  Ok(())
}

fn parse_description_replacement(
  value: string,
) -> Result<(string, string), string> {
  let parts = strings.SplitN(value, "=", 2)
  if parts.length() != 2 {
    return Err(flags.usage_error("--description-replace requires old=new"))
  }
  Ok((parts[0], parts[1]))
}

fn update(input: flags.CommandInput) -> Result<(), string> {
  let usage = input.usage
  let p = input.parsed
  let id = p.first()
  let mut state = ""
  if p.given("--state") { state = query.state(p.one("--state"))? }
  let mut priority = -1
  if p.given("--priority") { priority = check_priority(p.one("--priority"))? }
  let assignee_name = p.one("--assignee")
  let label_names = p.all("--label")
  let add_label_names = p.all("--add-label")
  let remove_label_names = p.all("--remove-label")
  let project_name = p.one("--project")
  let title = p.one("--title")
  let project_set = p.given("--project")
  let title_set = p.given("--title")
  // LLL-646: -b is the description, as on create. It used to be the reason
  // for a forced clear, so '--assignee none --force -b why' would now quietly
  // overwrite the description with the reason; that combination is refused
  // naming --reason instead.
  let force = p.given("--force")
  if force && p.given("-b") && !p.given("--reason") {
    return Err(flags.usage_error("-b is the new description, as on create; the reason for a forced clear is --reason \"why\""))
  }
  let mut description = ""
  if p.given("-b") {
    description = value_or_stdin(p.one("-b"), "-b")?
  }
  let mut description_set = p.given("-b")
  let replace_set = p.given("--description-replace")
  let (replace_old, replace_new) = if replace_set {
    parse_description_replacement(p.one("--description-replace"))?
  } else {
    ("", "")
  }
  let append_text = p.one("--description-append")
  let append_set = p.given("--description-append")
  if description_set && (replace_set || append_set) {
    return Err(flags.usage_error("-b replaces the whole description; it cannot be combined with --description-replace or --description-append"))
  }
  let since = if p.given("--if-unchanged-since") { unchanged_since_stamp(p.one("--if-unchanged-since"))? } else { "" }
  let emoji = check_emoji(p.one("--emoji"))?
  let emoji_set = p.given("--emoji")
  // An empty --assignee is the natural guess for "clear it" (two of thirty
  // fleet agents); the word is 'none', and this is where to say so.
  if p.given("--assignee") && assignee_name == "" {
    return Err(flags.usage_error("--assignee needs a member name, or 'none' to clear it"))
  }
  // LLL-516: clearing the assignee releases the claim, so it takes release's
  // --force, --reason and agent label, and nothing else does.
  if force && assignee_name != "none" {
    return Err(flags.usage_error("--force clears another holder's claim; it goes with --assignee none"))
  }
  let reason = forced_reason(p, force, "a forced clear")?
  let agent = if assignee_name != "" { agent_label(p)? } else { "" }
  // LLL-399: the stamp rides the direct PATCH. Assignment writes go through
  // the claim route, which carries no precondition header — honouring the
  // flag there would mean a guard that silently stops guarding. The claims
  // route arbitrates with its own observed-claim stamp instead.
  if since != "" && assignee_name != "" {
    return Err(flags.usage_error("--if-unchanged-since cannot be combined with --assignee: assignment writes go through the claim route, which arbitrates with its own claim stamp. Run them as two updates"))
  }
  // LLL-513: --label writes the whole set, the other two edit it. Together
  // there is no single answer to what the set should be.
  if !label_names.is_empty() && (!add_label_names.is_empty() || !remove_label_names.is_empty()) {
    return Err(flags.usage_error("--label replaces the whole label set, so it cannot be combined with --add-label/--remove-label. Use --add-label/--remove-label to change some labels and keep the rest, or --label alone to set the exact list"))
  }
  if state == "" && priority < 0 && assignee_name == "" && label_names.is_empty() && add_label_names.is_empty() && remove_label_names.is_empty() && !project_set && !title_set && !description_set && !replace_set && !append_set && !emoji_set {
    return Err(flags.usage_error(f"nothing to update: pass at least one flag\nusage: {usage}"))
  }

  let resolved = resolve_id(id, usage)?
  let issue = records.fetch_issue(resolved)?
  let key = f"{issue.expand.team.key}-{issue.number}"

  // LLL-391: optimistic concurrency for the fields nobody owns. The caller
  // passes the 'updated' it read; a record written since is refused with
  // the current stamp, and the caller reads again. Claims arbitrate who
  // owns an issue; this arbitrates edits. The local check gives the friendly
  // refusal before a doomed round trip; since LLL-399 the stamp also rides
  // the PATCH as If-Unmodified-Since, so the window this check cannot close
  // — a write landing between this read and the PATCH — is held at the
  // server and answers 412 instead of clobbering.
  if since != "" && issue.updated != since {
    return Err(pb.fail(pb.ErrorKind.Refused, f"{key} changed since {display.rfc3339(since)}: its 'updated' is now {display.rfc3339(issue.updated)}; read it again ('lll issue view {key} --json' carries updated) and retry with that stamp"))
  }
  // Surgical description edits (LLL-391, after veans): a replace must match
  // exactly once, or the caller is told how many times it matched, so a
  // common phrase never silently rewrites the wrong place.
  if replace_set {
    let n = strings.Count(issue.description, replace_old)
    if n != 1 {
      return Err(f"--description-replace matched {n} times in {key}'s description; it must match exactly once - widen the text")
    }
    description = strings.Replace(issue.description, replace_old, replace_new, 1)
    description_set = true
  }
  if append_set {
    let base = if replace_set { description } else { issue.description }
    description = if strings.TrimSpace(base) == "" { append_text } else { strings.TrimRight(base, "\n") + "\n" + append_text }
    description_set = true
  }

  let mut fields: Slice<string> = []
  // What this update set, for the success line: two fleet agents read
  // the issue back after 'Updated KEY' because it said nothing else.
  let mut changed: Slice<string> = []
  if state != "" { fields = fields.append("\"state\":" + json_quote(state)?); changed = changed.append(f"state={state}") }
  if priority >= 0 { fields = fields.append(f"\"priority\":{priority}"); changed = changed.append(f"priority={priority}") }
  if assignee_name == "none" {
    // 'none' is what view prints for no assignee; the same word clears it.
    // Nothing else could: an empty --assignee reads as the flag not given.
    fields = fields.append("\"assignee\":\"\"")
    changed = changed.append("assignee=none")
  } else if assignee_name != "" {
    let member = records.resolve_member(assignee_name)?
    fields = fields.append("\"assignee\":" + json_quote(member.id)?)
    changed = changed.append(f"assignee={member.name}")
  }
  // The ISSUE's team scopes both name lookups, not the configured one:
  // `lll issue update GRDN-4 --label bug` must mean GRDN's bug even when
  // LLL_TEAM says otherwise.
  if project_set {
    let project_id = if project_name == "" { "" } else { records.resolve_project(issue.team, project_name)?.id }
    fields = fields.append("\"project\":" + json_quote(project_id)?)
    let project_change = if project_name == "" { "project=none" } else { f"project={project_name}" }
    changed = changed.append(project_change)
  }
  if !label_names.is_empty() {
    let mut label_ids: Slice<string> = []
    for name in label_names {
      label_ids = label_ids.append(records.resolve_label(issue.team, name)?.id)
    }
    let encoded = match json.Marshal(label_ids) {
      Ok(b) => b as string,
      Err(e) => return Err(f"encoding labels: {e}"),
    }
    fields = fields.append(f"\"labels\":{encoded}")
    changed = changed.append(f"labels={strings.Join(label_names, "+")}")
  }
  // LLL-513: relation modifiers change only the named labels, so a label
  // another writer adds at the same time is kept. The server holds the
  // issue's lock across the request.
  let mut add_ids: Slice<string> = []
  for name in add_label_names {
    add_ids = add_ids.append(records.resolve_label(issue.team, name)?.id)
  }
  let mut remove_ids: Slice<string> = []
  for name in remove_label_names {
    let id = records.resolve_label(issue.team, name)?.id
    if add_ids.contains(id) {
      return Err(flags.usage_error(f"--add-label and --remove-label both name '{name}'; pass it to only one of them"))
    }
    remove_ids = remove_ids.append(id)
  }
  if !add_ids.is_empty() {
    fields = fields.append("\"labels+\":" + json_ids(add_ids)?)
    changed = changed.append(f"labels+={strings.Join(add_label_names, "+")}")
  }
  if !remove_ids.is_empty() {
    fields = fields.append("\"labels-\":" + json_ids(remove_ids)?)
    changed = changed.append(f"labels-={strings.Join(remove_label_names, "+")}")
  }
  if title_set { fields = fields.append("\"title\":" + json_quote(title)?); changed = changed.append("title") }
  if description_set {
    fields = fields.append("\"description\":" + json_quote(description)?)
    let how = if replace_set && append_set { "description (replaced, appended)" } else if replace_set { "description (replaced)" } else if append_set { "description (appended)" } else { "description" }
    changed = changed.append(how)
  }
  // `--emoji ""` clears the marker, so this one keys off the flag, not the value.
  if emoji_set { fields = fields.append("\"emoji\":" + json_quote(emoji)?); changed = changed.append(f"emoji={emoji}") }
  let payload = "{" + strings.Join(fields, ",") + "}"
  let mut released = ""
  if assignee_name != "" {
    let observed = claims.observed_id(issue.id)?
    let result = claims.update_assignment(pb.Caller.Process, issue.id, observed, payload, agent, force, reason).map_err(|e| {
      if pb.classify(e).code == "claim_held" {
        f"{key}: {e}; {held_elsewhere_hint(key)}"
      } else if pb.classify(e).code == "needs_force" {
        f"{key}: {pb.display_error(e).summary}; 'lll issue update {key} --assignee none --force --reason \"why\"' clears it anyway and comments on the issue"
      } else { f"{key}: {e}" }
    })?
    if result.claim_id != "" {
      let forced = if result.forced { "; forced, and commented on the issue" } else { "" }
      released = f" (released {result.member_name}'s claim{forced})"
    }
  } else {
    // The stamp rides the write (LLL-399): the precondition holds at the
    // server, so a write landing between this process's read and its PATCH
    // answers 412 instead of being clobbered.
    let patched = pb.patch_with_stamp(f"/api/collections/issues/records/{issue.id}", payload, since)
    if let Err(e) = patched {
      if pb.classify(e).status == 412 {
        let presented = pb.display_error(e)
        return Err(pb.fail(pb.ErrorKind.Refused, f"{key} changed under you: {presented.summary}\nread it again ('lll issue view {key} --json' carries updated) and retry with that stamp"))
      }
      return Err(e)
    }
  }
  if p.given("--json") { return print_issue_after(key) }
  fmt.Println(f"Updated {issue.expand.team.key}-{issue.number}: {strings.Join(changed, ", ")}{released}")
  Ok(())
}

/// D3 (LLL-640): close releases the closer's claim in the same server
/// transaction that sets the state, and keeps the assignee. --keep-claim
/// keeps the holder's hold. Closing an issue someone else holds follows the
/// release rule: refused without --force, and a forced close comments with
/// --reason.
fn close_issue(input: flags.CommandInput) -> Result<(), string> {
  let usage = "lll issue close [KEY-123] [--keep-claim] [--force [--reason \"why\"]]"
  let p = input.parsed
  let agent = agent_label(p)?
  let force = p.given("--force")
  let reason = forced_reason(p, force, "closing another holder's claimed issue")?
  let keep = p.given("--keep-claim")
  let resolved = resolve_id(p.first(), usage)?
  let issue = records.fetch_issue(resolved)?
  let key = f"{issue.expand.team.key}-{issue.number}"
  let observed = claims.observed_id(issue.id)?
  let result = claims.close(pb.Caller.Process, issue.id, observed, agent, force, reason, keep).map_err(|e| {
    if pb.classify(e).code == "needs_force" {
      f"{key}: {e} - 'lll issue close {key} --force --reason \"why\"' closes it anyway, releasing that claim and commenting on the issue"
    } else { f"{key}: {e}" }
  })?
  if p.given("--json") { return print_issue_after(key) }
  fmt.Println(f"Closed {key} ● done")
  if result.claim_id != "" {
    let holder = display.byline(result.member_name, result.agent)
    if keep {
      fmt.Println(f"Claim kept by {holder}; 'lll issue release {key}' gives it back.")
    } else if result.forced {
      fmt.Println(f"Released {holder}'s claim; forced, and commented on the issue.")
    } else {
      fmt.Println(f"Released {holder}'s claim; assignee unchanged.")
    }
  }
  Ok(())
}

/// `--branch` is opt-in (TASK-310). Fleet task 3b ran `start` from a checkout
/// that was not the work's and it switched that checkout's branch; agents whose
/// job is "record that I am on this" never wanted git touched. The state
/// change is the command; the branch and the work-site stamp are the extra.
fn issue_start_spec() -> Slice<flags.Flag> {
  flags.with_team([
    flags.Flag {
      name: "--branch",
      help: "also git switch -c key-number-slug in the current repo and\nrecord the work site (branch, host, path) on the issue",
      ..,
    },
    flags.Flag {
      name: "--agent",
      value: true,
      hint: "NAME",
      help: "self-asserted session label, on the comment a moved work site leaves\n(default: LLL_AGENT)",
      ..,
    },
    flags.Flag { name: "--json", help: "print the issue afterwards as JSON: the object 'lll issue list --json' prints per item", .. },
  ])
}

fn start(input: flags.CommandInput) -> Result<(), string> {
  let usage = input.usage
  let p = input.parsed
  let agent = agent_label(p)?
  let with_branch = p.given("--branch")
  if with_branch && !gitctx.in_repo() {
    return Err("--branch needs a git repository: run it from inside the one the work happens in; issue state unchanged")
  }
  let resolved = resolve_id(p.first(), usage)?
  let issue = records.fetch_issue(resolved)?
  let key = f"{issue.expand.team.key}-{issue.number}"
  let branch = gitctx.branch_name(issue.expand.team.key, issue.number, issue.title)

  // Git is a local prerequisite for the explicit combined operation. Do it
  // before the remote write so a refused switch cannot start the issue.
  if with_branch {
    let created = match gitctx.switch_branch(branch) {
      Ok(created) => created,
      Err(reason) => return Err(f"{reason}\nIssue {key} state unchanged; branch setup failed."),
    }
    // Under --json stdout is the issue alone; the Git lines move to stderr.
    let out = if p.given("--json") { os.Stderr } else { os.Stdout }
    fmt.Fprintln(out, f"Branch: {branch}")
    if created {
      fmt.Fprintln(out, f"Created and switched to branch '{branch}'")
    } else {
      fmt.Fprintln(out, f"Switched to existing branch '{branch}'")
    }
  }
  if let Err(reason) = pb.patch(
    f"/api/collections/issues/records/{issue.id}",
    "{\"state\":\"in-progress\"}",
  ) {
    if with_branch {
      // A lost response does not prove the server rejected the write. Never
      // undo Git automatically: report the known local outcome and how to
      // inspect the remote state before retrying.
      return Err(f"Git is on branch '{branch}', but starting {key} could not be confirmed: {reason}\nInspect with 'lll issue view {key}' before retrying.")
    }
    return Err(reason)
  }
  if !p.given("--json") { fmt.Println(f"Started {key}: {issue.title} (◐ in-progress)") }
  if with_branch {
    if let Err(reason) = record_work_site(issue, branch, agent) {
      return Err(f"{key} is in-progress and Git is on '{branch}', but recording the work site could not be confirmed: {reason}\nInspect with 'lll issue view {key}' before retrying.")
    }
  }
  if p.given("--json") { return print_issue_after(key) }
  Ok(())
}

/// TASK-205: stamp the work-site slot (work_branch/work_host/work_path) onto
/// the issue when starting on an existing matching branch. The slot holds the CURRENT site only:
/// a start from a different site overwrites it and leaves an auto-comment
/// recording the displaced one, a same-site restart is silent, and nothing
/// ever clears the slot — a done issue keeps which branch shipped it, and
/// views render a stale site as "(last seen)" instead.
///
/// Host comes from os.Hostname; LLL_WORK_HOST overrides it (a test seam —
/// e2e fakes a second machine without owning one). Path is the worktree
/// root, so multiple worktrees of one branch on one host stay distinct.
fn record_work_site(issue: models.Issue, branch: string, agent: string) -> Result<(), string> {
  let mut host = os.Getenv("LLL_WORK_HOST")
  if host == "" { host = os.Hostname().unwrap_or("") }
  let Some(path) = gitctx.repo_root() else {
    return Ok(())
  }
  if issue.work_branch == branch && issue.work_host == host && issue.work_path == path {
    return Ok(())
  }
  if issue.work_branch != "" {
    // Author resolution mirrors `issue comment`: the token's member,
    // authorless for a superuser credential. Member identity is not duplicated
    // into the slot; this comment (and the claim holder) carry the who.
    let mut author = ""
    if let Some(a) = actor()? { author = a.id }
    let moved = f"work moved: {issue.work_branch} @ {issue.work_host}:{issue.work_path} -> {branch} @ {host}:{path}"
    let payload = match json.Marshal(
      models.NewComment { issue: issue.id, author, agent, body: moved },
    ) {
      Ok(p) => p as string,
      Err(e) => return Err(f"encoding work-moved comment: {e}"),
    }
    let _ = pb.post("/api/collections/comments/records", payload)?
  }
  let fields = [
    "\"work_branch\":" + json_quote(branch)?,
    "\"work_host\":" + json_quote(host)?,
    "\"work_path\":" + json_quote(path)?,
  ]
  let _ = pb.patch(
    f"/api/collections/issues/records/{issue.id}",
    "{" + strings.Join(fields, ",") + "}",
  )?
  Ok(())
}

/// TASK-205's presentation rule: a work site is only "current" while the
/// issue is being worked — once the state is done/cancelled or the claim is
/// gone, the site renders as "(last seen)". A read, never a write: the slot
/// itself is not cleared.
fn work_site_stale(state: string, claimed: bool) -> bool {
  state == "done" || state == "cancelled" || !claimed
}

/// The member named by the current token. A superuser credential has no
/// member identity and leaves optional authorship empty.
struct Actor {
  id: string,
  name: string,
}

fn actor() -> Result<Option<Actor>, string> {
  let cfg = config.load()?
  if cfg.token == "" { return Ok(None) }
  let Some(id) = pb.token_subject(cfg.token) else { return Ok(None) }
  // Use the configured request path so the board can renew an expired token
  // before resolving its member. Explicit-token calls deliberately cannot heal.
  match pb.get(f"/api/collections/members/records/{id}") {
    Ok(body) => {
      let mut member = models.Member { .. }
      if let Err(e) = json.Unmarshal(body.bytes(), &member) {
        return Err(f"decoding the actor: {e}")
      }
      Ok(Some(Actor { id: member.id, name: member.name }))
    },
    Err(e) => {
      if pb.classify(e).status == 404 { Ok(None) } else { Err(e) }
    },
  }
}

/// The session label for claims and comments (LLL-521): --agent, else
/// LLL_AGENT. Self-asserted; it separates agents sharing one member token and
/// proves nothing about who they are. The server renders it into comments, so
/// it is refused here, before any request, unless it has the server's shape:
/// at most 64 of A-Z, a-z, 0-9, '.', '_' and '-'; empty means no label.
fn agent_label(p: flags.Parsed) -> Result<string, string> {
  let label = if p.given("--agent") { p.one("--agent") } else { os.Getenv("LLL_AGENT") }
  if !regexp.MustCompile(r"^[A-Za-z0-9._-]{0,64}$").MatchString(label) {
    return Err(flags.usage_error(f"invalid agent label {strconv.Quote(label)} (from --agent or LLL_AGENT): use at most 64 characters from A-Z, a-z, 0-9, '.', '_' and '-'"))
  }
  Ok(label)
}

/// The fix for a claim someone else holds. Plain release works only for the
/// holder (LLL-512), so the hint asks them first and names --force for a hold
/// whose agent is gone. On `update --assignee` the caller may be the holder,
/// which is why the plain release is still named.
fn held_elsewhere_hint(key: string) -> string {
  f"the holder releases it with 'lll issue release {key}'; ask them, or if the hold is dead, 'lll issue release {key} --force --reason \"why\"' takes it and comments on the issue"
}

/// Resolve the actor and delegate acquisition to the shared claims client.
/// The server transaction acquires the exclusive hold and assigns its holder
/// together; the unique issue index also protects against duplicate hold rows.
/// Assignment edits use their own observed-claim transaction and cannot replace
/// another holder. See gopb/claims.go and gopb/assignment.go for that policy.
fn claim(input: flags.CommandInput) -> Result<(), string> {
  let usage = "lll issue claim [KEY-123] [--renew]"
  let agent = agent_label(input.parsed)?
  let id = input.parsed.first()
  let resolved = resolve_id(id, usage)?
  let Some(member) = actor()? else {
    return Err(
      "claiming needs a member token: 'lll login' as a person, or 'lll token create <member>' with admin credentials",
    )
  }
  let issue = records.fetch_issue(resolved)?
  let key = f"{issue.expand.team.key}-{issue.number}"

  if input.parsed.given("--renew") {
    let Some(held) = claims.fetch(issue.id)? else {
      return Err(pb.fail(pb.ErrorKind.Refused, f"{key} is not claimed; 'lll issue claim {key}' takes it"))
    };
    let renewed = claims.renew(issue.id, held.id, agent).map_err(|e| f"{key}: {e}")?
    if input.parsed.given("--json") { return print_issue_after(key) }
    fmt.Println(f"Renewed {key} for {display.byline(renewed.member_name, renewed.agent)}; the expiry clock restarts now (held since {display.relative(renewed.created)})")
    return Ok(())
  }

  let result = claims.acquire(pb.Caller.Process, issue.id, member.id, agent).map_err(|e| {
    if pb.classify(e).code == "claim_held" {
      f"{key}: {e}; {held_elsewhere_hint(key)}"
    } else { e }
  })?
  if input.parsed.given("--json") { return print_issue_after(key) }
  if result.already_owned {
    fmt.Println(f"Claimed {key} for {display.byline(result.member_name, result.agent)} (already yours since {display.relative(result.created)})")
  } else {
    fmt.Println(f"Claimed {key} for {display.byline(result.member_name, result.agent)}")
  }
  Ok(())
}

/// The holder releases an observed hold; anyone else needs --force, and the
/// server records a forced release as a comment on the issue (LLL-512). The
/// server atomically removes that exact claim and clears only its assignment.
fn release(input: flags.CommandInput) -> Result<(), string> {
  let usage = "lll issue release [KEY-123] [--force [--reason \"why\"]]"
  let p = input.parsed
  let agent = agent_label(p)?
  let resolved = resolve_id(p.first(), usage)?
  let force = p.given("--force")
  let reason = forced_reason(p, force, "a forced release")?
  let issue = records.fetch_issue(resolved)?
  let key = f"{issue.expand.team.key}-{issue.number}"
  let Some(held) = claims.fetch(issue.id)? else { return Err(pb.fail(pb.ErrorKind.Refused, f"{key} is not claimed")) };
  let result = claims.release(pb.Caller.Process, issue.id, held.id, agent, force, reason).map_err(|e| {
    if pb.classify(e).code == "needs_force" {
      f"{key}: {e}; 'lll issue release {key} --force --reason \"why\"' takes it anyway and comments on the issue"
    } else { e }
  })?
  let assignment = if result.cleared_assignee { "cleared assignee" } else { "assignment unchanged" }
  let forced = if result.forced { "; forced, and commented on the issue" } else { "" }
  fmt.Println(f"Released {key} (was {result.member_name}'s); {assignment}{forced}")
  Ok(())
}

/// Compatibility name for command/page reads; storage ownership is in claims.
fn fetch_claim(issue_id: string) -> Result<Option<models.Claim>, string> {
  claims.fetch(issue_id)
}

fn delete_issue(input: flags.CommandInput) -> Result<(), string> {
  let p = input.parsed
  let id = p.first()
  // Deleting by inferred branch is too dangerous; the ID must be explicit.
  if id == "" { return Err(flags.usage_error("usage: lll issue delete KEY-123 [--yes] [--force]")) }

  let issue = records.fetch_issue(id)?
  let label = f"{issue.expand.team.key}-{issue.number}"
  // LLL-662: the server refuses to delete a claimed issue, because the
  // claim would go with it and nobody would be told. --force releases it
  // first, under the release rule, then deletes.
  // --force means "even if claimed", so on an unclaimed issue it is
  // unneeded, not wrong: whether a claim exists is server state the caller
  // may not know (a hold can lapse between two commands), and a usage error
  // that depends on it is not a usage error (LLL-679).
  let held = claims.fetch(issue.id)?
  if let Some(h) = held {
    if !p.given("--force") {
      let holder = display.byline(display.member_name(h.member, h.expand.member.name, "an unknown member"), h.agent)
      return Err(pb.fail(pb.ErrorKind.Refused, f"{label} is claimed by {holder}; 'lll issue delete {label} --force' releases the claim and deletes it"))
    }
  }
  if !p.given("--yes") && !confirmed(f"delete {label}?") {
    // D6: --force never skips the confirmation. A script that used it to
    // (before 1.0) is told which flag does.
    if p.given("--force") {
      return Err(pb.fail(pb.ErrorKind.Refused, "aborted: nothing was deleted; --force does not skip the confirmation, which is skipped by --yes"))
    }
    return Err(aborted())
  }
  if let Some(h) = held {
    let agent = agent_label(p)?
    let _ = claims.release(pb.Caller.Process, issue.id, h.id, agent, true, "deleting the issue").map_err(|e| f"{label}: {e}")?
  }
  let _ = pb.delete(f"/api/collections/issues/records/{issue.id}").map_err(|e| {
    if held.is_some() { f"{e}\nthe claim on {label} was released, but the issue was not deleted" } else { e }
  })?
  fmt.Println(f"Deleted {label}")
  Ok(())
}

fn comment(input: flags.CommandInput) -> Result<(), string> {
  let usage = input.usage
  let p = input.parsed
  let id = p.first()
  // A bare second word is the body, as `create` takes a bare title and
  // `member add` a bare name. Ten of thirty first-time agents in one fleet run
  // (TASK-309) typed `issue comment DEMO-1 "text"` and were refused for it. -b
  // stays the documented spelling and wins when both are given; `-b -` still
  // reads stdin, which a positional cannot express.
  let mut body = ""
  let mut body_set = false
  if p.given("-b") {
    body = value_or_stdin(p.one("-b"), "-b")?
    body_set = true
  } else if p.nth(1) != "" {
    body = p.nth(1)
    body_set = true
  }
  let agent = if body_set { agent_label(p)? } else { "" }

  let resolved = resolve_id(id, usage)?
  let issue = records.fetch_issue(resolved)?

  if !body_set {
    let comments = records.fetch_comments(issue.id)?
    if p.given("--json") { return print_list_json(comments, whole_list(comments.length()), "comments") }
    if comments.is_empty() { return say_empty("comments") }
    print_comments(comments)
    // Fleet tasks 4 and 5: every waiting agent re-read this list five times
    // ten seconds apart. The verb that blocks instead is named where the
    // polling happens.
    let key = f"{issue.expand.team.key}-{issue.number}"
    fmt.Println(f"(waiting for the next one? 'lll issue watch {key} --until TEXT' blocks until a comment containing TEXT arrives)")
    return Ok(())
  }
  if body == "" { return Err(flags.usage_error(f"-b cannot be empty\nusage: {usage}")) }

  // Authorship follows the authenticated member. Superuser comments are authorless.
  let mut author = ""
  let mut author_name = ""
  if let Some(a) = actor()? {
    author = a.id
    author_name = a.name
  }

  let new_comment = models.NewComment { issue: issue.id, author, agent, body }
  let payload = match json.Marshal(new_comment) {
    Ok(p) => p,
    Err(e) => return Err(f"encoding comment: {e}"),
  }
  let created = pb.post("/api/collections/comments/records", payload as string)?
  if p.given("--json") {
    fmt.Println(contract_json(created.bytes() as json.RawMessage, 0) as string)
    return Ok(())
  }
  // Show the authenticated author at the write, so token switches are visible.
  let as_who = if author_name == "" { "with no author; use a member token from 'lll login' or 'lll token create'" } else { f"as {display.byline(author_name, agent)}" }
  fmt.Println(f"Commented on {issue.expand.team.key}-{issue.number} {as_who}")
  Ok(())
}

fn url_cmd(input: flags.CommandInput) -> Result<(), string> {
  let usage = "lll issue url [KEY-123]"
  let id = input.parsed.first()
  let resolved = resolve_id(id, usage)?
  let target = issue_url(records.fetch_issue(resolved)?)?
  fmt.Println(target)
  Ok(())
}

