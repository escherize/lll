import "go:bufio"
import "go:encoding/json"
import "go:fmt"
import "go:net/url"
import "go:os"
import "go:strconv"
import "go:strings"
import "go:text/tabwriter"

import "config"
import "display"
import "gitctx"
import "models"
import "pb"
import "query"

/// Dispatch `lin issue <verb>`.
pub fn issue(args: Slice<string>) -> Result<(), string> {
  let Some(verb) = args.get(2) else {
    print_usage()
    return Ok(())
  }
  match verb {
    "create" => create(args),
    "list" => list(args),
    "view" => view(args),
    "update" => update(args),
    "close" => close_issue(args),
    "start" => start(args),
    "delete" => delete_issue(args),
    "comment" => comment(args),
    "--help" => {
      print_usage()
      Ok(())
    },
    "-h" => {
      print_usage()
      Ok(())
    },
    other => Err(f"unknown issue command: '{other}' (see 'lin issue --help')"),
  }
}

fn print_usage() {
  fmt.Println(
    "lin issue - work with issues

Usage:
  lin issue create -t \"title\" [--priority 0-4] [--assignee name]
                                                  create an issue in the configured team
  lin issue list [--state s] [--assignee name] [--sort f] [--json]
                                                  list issues; scoped to the configured team
  lin issue view [KEY-123] [--json]               show one issue in full, with comments
  lin issue update [KEY-123] <flags>              change fields (at least one flag)
  lin issue close [KEY-123]                       set state done
  lin issue start [KEY-123]                       set state in-progress; print/create the
                                                  branch key-number-slug (git switch)
  lin issue delete KEY-123 [--force]              delete; asks [y/N] unless --force
  lin issue comment [KEY-123] [-b \"body\"]         add a comment (authored by 'me' in
                                                  .lin.toml); without -b, list comments

Flags:
  --state        one of: backlog, todo, in-progress, in-review, done, cancelled
  --assignee     member name (see 'lin member list'); filters on list
  --sort         created, updated, priority, or number; prefix - for descending
                 (default: LIN_SORT or 'sort' in .lin.toml, else created)
  --priority     0 none, 1 urgent (!!!), 2 high (!!), 3 medium (!), 4 low (·)
  --title        new title (update)
  --description  new description (update)
  --json         raw PocketBase JSON (team, assignee expanded), pipe-friendly
  --force        skip the delete confirmation

When KEY-123 is omitted (except for delete), it is inferred from the current
git branch: eng-12-fix-login resolves to ENG-12.

State glyphs: ◌ backlog  ○ todo  ◐ in-progress  ◉ in-review  ● done  ⊗ cancelled

The team comes from LIN_TEAM or 'team' in .lin.toml (see 'lin config --help').",
  )
}

fn create(args: Slice<string>) -> Result<(), string> {
  let mut title = ""
  let mut priority = 0
  let mut assignee_name = ""
  let mut i = 3
  while i < args.length() {
    match args[i] {
      "-t" => {
        let Some(val) = args.get(i + 1) else {
          return Err("-t requires a value")
        }
        title = val
        i += 2
      },
      "--assignee" => {
        let Some(val) = args.get(i + 1) else {
          return Err("--assignee requires a value")
        }
        assignee_name = val
        i += 2
      },
      "--priority" => {
        let Some(val) = args.get(i + 1) else {
          return Err("--priority requires a value")
        }
        let Ok(p) = strconv.Atoi(val) else {
          return Err(f"--priority must be a number 0-4, got '{val}'")
        }
        if p < 0 || p > 4 {
          return Err(
            f"--priority must be 0-4 (0 none, 1 urgent, 2 high, 3 medium, 4 low), got {p}",
          )
        }
        priority = p
        i += 2
      },
      other => return Err(f"unknown flag: '{other}'"),
    }
  }
  if title == "" {
    return Err(
      "usage: lin issue create -t \"title\" [--priority 0-4] [--assignee name]",
    )
  }

  let mut assignee = ""
  if assignee_name != "" { assignee = resolve_member(assignee_name)?.id }

  let team_key = config.load()?.team
  if team_key == "" {
    return Err(
      "set LIN_TEAM or 'team' in .lin.toml to your team key (e.g. ENG)",
    )
  }
  let Some(team) = find_team(team_key)? else {
    return Err(f"no team with key '{team_key}' on the server")
  }

  let new_issue = models.NewIssue { 
    team: team.id,
    title,
    state: "todo",
    priority,
    assignee,
  }
  let payload = match json.Marshal(new_issue) {
    Ok(p) => p,
    Err(e) => return Err(f"encoding issue: {e}"),
  }
  let body = pb.post("/api/collections/issues/records", payload as string)?

  let mut created = models.Issue { .. }
  if let Err(e) = json.Unmarshal(body.bytes(), &created) {
    return Err(f"decoding created issue: {e}")
  }
  fmt.Println(f"Created {team.key}-{created.number}: {created.title}")
  Ok(())
}

fn list(args: Slice<string>) -> Result<(), string> {
  let mut state = ""
  let mut assignee_name = ""
  let mut sort_flag = ""
  let mut json_mode = false
  let mut i = 3
  while i < args.length() {
    match args[i] {
      "--assignee" => {
        let Some(val) = args.get(i + 1) else {
          return Err("--assignee requires a value")
        }
        assignee_name = val
        i += 2
      },
      "--state" => {
        let Some(val) = args.get(i + 1) else {
          return Err("--state requires a value")
        }
        if query.states().find(|s| s == val).is_none() {
          return Err(
            f"unknown state '{val}' (use one of: {strings.Join(query.states(), ", ")})",
          )
        }
        state = val
        i += 2
      },
      "--sort" => {
        let Some(val) = args.get(i + 1) else {
          return Err("--sort requires a value")
        }
        sort_flag = val
        i += 2
      },
      "--json" => {
        json_mode = true
        i += 1
      },
      other => return Err(f"unknown flag: '{other}'"),
    }
  }

  let cfg = config.load()?

  // A configured team (LIN_TEAM or .lin.toml) scopes the list by default.
  let mut team_id = ""
  if cfg.team != "" {
    let Some(team) = find_team(cfg.team)? else {
      return Err(f"no team with key '{cfg.team}' on the server")
    }
    team_id = team.id
  }

  let mut assignee_id = ""
  if assignee_name != "" { assignee_id = resolve_member(assignee_name)?.id }

  let mut sort_spec = sort_flag
  if sort_spec == "" { sort_spec = cfg.sort }
  if sort_spec == "" { sort_spec = "created" }
  let sort = query.sort(sort_spec)?

  let mut path = f"/api/collections/issues/records?perPage=200&expand=team,assignee&sort={url.QueryEscape(sort)}"
  let filter = query.filter(team_id, state, assignee_id)
  if filter != "" { path = f"{path}&filter={url.QueryEscape(filter)}" }

  let body = pb.get(path)?
  if json_mode {
    fmt.Println(body)
    return Ok(())
  }

  let mut issues = models.IssueList { .. }
  if let Err(e) = json.Unmarshal(body.bytes(), &issues) {
    return Err(f"decoding issues: {e}")
  }

  let w = tabwriter.NewWriter(os.Stdout, 0, 4, 2, ' ', 0)
  for item in issues.items {
    let key = item.expand.team.key
    let line = f"{key}-{item.number}\t{display.glyph(item.state)} {item.state}\t{display.priority_marker(item.priority)}\t{item.title}\t{item.expand.assignee.name}\t{display.relative(item.updated)}"
    if let Err(e) = fmt.Fprintln(w, line) { return Err(f"writing output: {e}") }
  }
  if let Err(e) = w.Flush() { return Err(f"writing output: {e}") }
  Ok(())
}

fn view(args: Slice<string>) -> Result<(), string> {
  let mut id = ""
  let mut json_mode = false
  let mut i = 3
  while i < args.length() {
    match args[i] {
      "--json" => {
        json_mode = true
        i += 1
      },
      other => {
        if id != "" { return Err(f"unexpected argument: '{other}'") }
        id = other
        i += 1
      },
    }
  }
  let resolved = resolve_id(id, "lin issue view [KEY-123] [--json]")?

  let record = fetch_issue_record(resolved)?
  if json_mode {
    fmt.Println(record)
    return Ok(())
  }

  let mut full = models.Issue { .. }
  if let Err(e) = json.Unmarshal(record.bytes(), &full) {
    return Err(f"decoding issue: {e}")
  }

  let mut assignee = full.expand.assignee.name
  if assignee == "" { assignee = "none" }

  fmt.Println(f"{full.expand.team.key}-{full.number} {full.title}")
  fmt.Println("")
  fmt.Println(f"State:     {display.glyph(full.state)} {full.state}")
  fmt.Println(f"Priority:  {display.priority_name(full.priority)}")
  fmt.Println(f"Assignee:  {assignee}")
  fmt.Println(f"Created:   {display.relative(full.created)}")
  fmt.Println(f"Updated:   {display.relative(full.updated)}")
  if full.description != "" {
    fmt.Println("")
    fmt.Println(full.description)
  }

  let comments = fetch_comments(full.id)?
  if comments.length() > 0 {
    fmt.Println("")
    fmt.Println("Comments:")
    fmt.Println("")
    print_comments(comments)
  }
  Ok(())
}

fn update(args: Slice<string>) -> Result<(), string> {
  let usage = "lin issue update [KEY-123] [--state s] [--priority 0-4] [--assignee name] [--title t] [--description d]"
  let mut id = ""
  let mut state = ""
  let mut priority = -1
  let mut assignee_name = ""
  let mut title = ""
  let mut title_set = false
  let mut description = ""
  let mut description_set = false
  let mut i = 3
  while i < args.length() {
    match args[i] {
      "--assignee" => {
        let Some(val) = args.get(i + 1) else {
          return Err("--assignee requires a value")
        }
        assignee_name = val
        i += 2
      },
      "--state" => {
        let Some(val) = args.get(i + 1) else {
          return Err("--state requires a value")
        }
        if query.states().find(|s| s == val).is_none() {
          return Err(
            f"unknown state '{val}' (use one of: {strings.Join(query.states(), ", ")})",
          )
        }
        state = val
        i += 2
      },
      "--priority" => {
        let Some(val) = args.get(i + 1) else {
          return Err("--priority requires a value")
        }
        let Ok(p) = strconv.Atoi(val) else {
          return Err(f"--priority must be a number 0-4, got '{val}'")
        }
        if p < 0 || p > 4 {
          return Err(
            f"--priority must be 0-4 (0 none, 1 urgent, 2 high, 3 medium, 4 low), got {p}",
          )
        }
        priority = p
        i += 2
      },
      "--title" => {
        let Some(val) = args.get(i + 1) else {
          return Err("--title requires a value")
        }
        if val == "" { return Err("--title cannot be empty") }
        title = val
        title_set = true
        i += 2
      },
      "--description" => {
        let Some(val) = args.get(i + 1) else {
          return Err("--description requires a value")
        }
        description = val
        description_set = true
        i += 2
      },
      other => {
        if other.starts_with("-") { return Err(f"unknown flag: '{other}'") }
        if id != "" { return Err(f"unexpected argument: '{other}'") }
        id = other
        i += 1
      },
    }
  }
  if state == "" && priority < 0 && assignee_name == "" && !title_set &&
  !description_set {
    return Err(f"nothing to update — pass at least one flag\nusage: {usage}")
  }

  let resolved = resolve_id(id, usage)?
  let issue = fetch_issue(resolved)?

  let mut fields: Slice<string> = []
  if state != "" { fields = fields.append("\"state\":" + json_quote(state)?) }
  if priority >= 0 { fields = fields.append(f"\"priority\":{priority}") }
  if assignee_name != "" {
    let member = resolve_member(assignee_name)?
    fields = fields.append("\"assignee\":" + json_quote(member.id)?)
  }
  if title_set { fields = fields.append("\"title\":" + json_quote(title)?) }
  if description_set {
    fields = fields.append("\"description\":" + json_quote(description)?)
  }
  let _ = pb.patch(
    f"/api/collections/issues/records/{issue.id}",
    "{" + strings.Join(fields, ",") + "}",
  )?
  fmt.Println(f"Updated {issue.expand.team.key}-{issue.number}")
  Ok(())
}

fn close_issue(args: Slice<string>) -> Result<(), string> {
  let usage = "lin issue close [KEY-123]"
  let id = positional_id(args, usage)?
  let resolved = resolve_id(id, usage)?
  let issue = fetch_issue(resolved)?
  let _ = pb.patch(
    f"/api/collections/issues/records/{issue.id}",
    "{\"state\":\"done\"}",
  )?
  fmt.Println(f"Closed {issue.expand.team.key}-{issue.number} ● done")
  Ok(())
}

fn start(args: Slice<string>) -> Result<(), string> {
  let usage = "lin issue start [KEY-123]"
  let id = positional_id(args, usage)?
  let resolved = resolve_id(id, usage)?
  let issue = fetch_issue(resolved)?
  let _ = pb.patch(
    f"/api/collections/issues/records/{issue.id}",
    "{\"state\":\"in-progress\"}",
  )?
  let key = issue.expand.team.key
  fmt.Println(f"Started {key}-{issue.number}: {issue.title} (◐ in-progress)")

  let branch = gitctx.branch_name(key, issue.number, issue.title)
  fmt.Println(f"Branch: {branch}")
  if gitctx.in_repo() {
    let created = gitctx.switch_branch(branch)?
    if created {
      fmt.Println(f"Created and switched to branch '{branch}'")
    } else {
      fmt.Println(f"Switched to existing branch '{branch}'")
    }
  }
  Ok(())
}

fn delete_issue(args: Slice<string>) -> Result<(), string> {
  let mut id = ""
  let mut force = false
  let mut i = 3
  while i < args.length() {
    match args[i] {
      "--force" => {
        force = true
        i += 1
      },
      other => {
        if other.starts_with("-") { return Err(f"unknown flag: '{other}'") }
        if id != "" { return Err(f"unexpected argument: '{other}'") }
        id = other
        i += 1
      },
    }
  }
  // Deleting by inferred branch is too dangerous; the ID must be explicit.
  if id == "" { return Err("usage: lin issue delete KEY-123 [--force]") }

  let issue = fetch_issue(id)?
  let label = f"{issue.expand.team.key}-{issue.number}"
  if !force {
    fmt.Print(f"delete {label}? [y/N] ")
    let scanner = bufio.NewScanner(os.Stdin)
    let mut answer = ""
    if scanner.Scan() { answer = strings.TrimSpace(scanner.Text()) }
    let a = strings.ToLower(answer)
    if a != "y" && a != "yes" {
      fmt.Println("Aborted.")
      return Ok(())
    }
  }
  let _ = pb.delete(f"/api/collections/issues/records/{issue.id}")?
  fmt.Println(f"Deleted {label}")
  Ok(())
}

fn comment(args: Slice<string>) -> Result<(), string> {
  let usage = "lin issue comment [KEY-123] [-b \"body\"]"
  let mut id = ""
  let mut body = ""
  let mut body_set = false
  let mut i = 3
  while i < args.length() {
    match args[i] {
      "-b" => {
        let Some(val) = args.get(i + 1) else {
          return Err("-b requires a value")
        }
        body = val
        body_set = true
        i += 2
      },
      other => {
        if other.starts_with("-") { return Err(f"unknown flag: '{other}'") }
        if id != "" { return Err(f"unexpected argument: '{other}'") }
        id = other
        i += 1
      },
    }
  }

  let resolved = resolve_id(id, usage)?
  let issue = fetch_issue(resolved)?

  if !body_set {
    let comments = fetch_comments(issue.id)?
    if comments.is_empty() {
      fmt.Println("No comments.")
      return Ok(())
    }
    print_comments(comments)
    return Ok(())
  }
  if body == "" { return Err(f"-b cannot be empty\nusage: {usage}") }

  // Author is the member named by 'me' in config; unset or unmatched 'me'
  // makes the comment authorless (honor system, no auth).
  let mut author = ""
  let me = config.load()?.me
  if me != "" { if let Some(m) = find_member(me)? { author = m.id } }

  let new_comment = models.NewComment { issue: issue.id, author, body }
  let payload = match json.Marshal(new_comment) {
    Ok(p) => p,
    Err(e) => return Err(f"encoding comment: {e}"),
  }
  let _ = pb.post("/api/collections/comments/records", payload as string)?
  fmt.Println(f"Commented on {issue.expand.team.key}-{issue.number}")
  Ok(())
}

/// An issue's comments, oldest first, author expanded.
fn fetch_comments(issue_id: string) -> Result<Slice<models.Comment>, string> {
  let filter = url.QueryEscape(f"issue='{issue_id}'")
  let body = pb.get(
    f"/api/collections/comments/records?filter={filter}&sort=created&expand=author&perPage=200",
  )?
  let mut comments = models.CommentList { .. }
  if let Err(e) = json.Unmarshal(body.bytes(), &comments) {
    return Err(f"decoding comments: {e}")
  }
  Ok(comments.items)
}

/// Print comments as "author (3h ago)" then the indented body.
fn print_comments(comments: Slice<models.Comment>) {
  for c in comments {
    let mut author = c.expand.author.name
    if author == "" { author = "anon" }
    fmt.Println(f"{author} ({display.relative(c.created)})")
    fmt.Println(f"  {c.body}")
  }
}

/// Resolve a member by name; unknown names error with the fix.
fn resolve_member(name: string) -> Result<models.Member, string> {
  let Some(m) = find_member(name)? else {
    return Err(f"no member named '{name}' — see 'lin member list'")
  }
  Ok(m)
}

/// Parse `[KEY-123]` as the only allowed argument (verbs without flags).
fn positional_id(args: Slice<string>, usage: string) -> Result<string, string> {
  let mut id = ""
  let mut i = 3
  while i < args.length() {
    let arg = args[i]
    if arg.starts_with("-") {
      return Err(f"unknown flag: '{arg}'\nusage: {usage}")
    }
    if id != "" { return Err(f"unexpected argument: '{arg}'") }
    id = arg
    i += 1
  }
  Ok(id)
}

/// Resolution order: explicit arg > current git branch (eng-12-slug -> ENG-12)
/// > error with a hint.
fn resolve_id(explicit: string, usage: string) -> Result<string, string> {
  if explicit != "" { return Ok(explicit) }
  let Some(branch) = gitctx.current_branch() else {
    return Err(
      f"no issue ID given and no git branch to infer one from\nusage: {usage}",
    )
  }
  let Some(id) = gitctx.issue_id_from_branch(branch) else {
    return Err(
      f"no issue ID given and current branch '{branch}' doesn't look like eng-123-...\nusage: {usage}",
    )
  }
  Ok(id)
}

/// Fetch an issue by KEY-123 and return the raw PB record JSON (team and
/// assignee expanded).
fn fetch_issue_record(id: string) -> Result<string, string> {
  let bad_id = f"'{id}' is not an issue ID (expected KEY-123, e.g. ENG-1)"
  let Some(dash) = strings.LastIndex(id, "-") else {
    return Err(bad_id)
  }
  if dash == 0 || dash == id.length() - 1 { return Err(bad_id) }
  let team_key = id.substring(0..dash)
  let Ok(number) = strconv.Atoi(id.substring(dash + 1..id.length())) else {
    return Err(bad_id)
  }

  let not_found = f"issue {id} not found — check 'lin issue list' or LIN_TEAM"
  let Some(team) = find_team(team_key)? else {
    return Err(not_found)
  }

  let filter = url.QueryEscape(
    f"{query.filter(team.id, "", "")} && number={number}",
  )
  let body = pb.get(
    f"/api/collections/issues/records?filter={filter}&perPage=1",
  )?
  let mut issues = models.IssueList { .. }
  if let Err(e) = json.Unmarshal(body.bytes(), &issues) {
    return Err(f"decoding issues: {e}")
  }
  let Some(item) = issues.items.get(0) else {
    return Err(not_found)
  }

  pb.get(f"/api/collections/issues/records/{item.id}?expand=team,assignee")
}

/// fetch_issue_record, decoded.
fn fetch_issue(id: string) -> Result<models.Issue, string> {
  let record = fetch_issue_record(id)?
  let mut full = models.Issue { .. }
  if let Err(e) = json.Unmarshal(record.bytes(), &full) {
    return Err(f"decoding issue: {e}")
  }
  Ok(full)
}

/// JSON-encode a string value (quotes + escaping).
fn json_quote(value: string) -> Result<string, string> {
  match json.Marshal(value) {
    Ok(b) => Ok(b as string),
    Err(e) => Err(f"encoding value: {e}"),
  }
}

fn find_team(key: string) -> Result<Option<models.Team>, string> {
  let filter = url.QueryEscape(f"key='{key}'")
  let body = pb.get(f"/api/collections/teams/records?filter={filter}")?
  let mut result = models.TeamList { .. }
  if let Err(e) = json.Unmarshal(body.bytes(), &result) {
    return Err(f"decoding teams: {e}")
  }
  Ok(result.items.find(|t| t.key == key))
}
