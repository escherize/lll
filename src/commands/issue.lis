import "models"

/// A flag value of `-` means "read it from stdin", the convention `gh gist` and
/// mb-shares' `share -f` use. Reading from a terminal would hang until Ctrl-D,
/// so that is refused with a message instead. `< /dev/null` also reads as a
/// character device, and an empty body is not what anyone meant either way.
fn value_or_stdin(val: string, flag: string) -> Result<string, pb.CliError> {
  if val != "-" { return Ok(val) }

  if let Ok(info) = os.Stdin.Stat() {
    if info.Mode() & os.ModeCharDevice != 0 {
      return Err(
        pb.failed(f"{flag} - reads the body from stdin, but nothing is piped in (try: echo \"text\" | lll issue ... {flag} -)"),
      )
    }
  }

  let Ok(data) = io.ReadAll(os.Stdin) else {
    return Err(pb.failed(f"{flag} -: reading stdin"))
  }
  // Stdin is the author's input, including any final newline or indentation.
  let text = data as string
  if strings.TrimSpace(text) == "" { return Err(pb.failed(f"{flag} -: nothing on stdin")) }
  Ok(text)
}

/// A --priority value: a name on the scale (any case) or its number.
fn check_priority(val: string) -> Result<models.Priority, pb.CliError> {
  if let Some(p) = models.Priority.named(strings.ToLower(val)) { return Ok(p) }
  let Ok(n) = strconv.Atoi(val) else {
    return Err(flags.usage_error(f"unknown priority '{val}' (use none, urgent, high, medium, low, or 0-4)"))
  }
  let Some(p) = models.Priority.from_wire(n) else {
    return Err(
      flags.usage_error(f"--priority must be 0-4 (0 none, 1 urgent, 2 high, 3 medium, 4 low), got {n}"),
    )
  }
  Ok(p)
}

// ---------------------------------------------------------------------
// Flag tables. One entry per flag: the parser, `lll issue --help` and
// `lll completions` all read them (TASK-127). `name` is the spelling shown
// in usage lines; `alias` is also accepted.

fn issue_create_spec() -> Slice<flags.Flag> {
  flags.with_team([
    flags.Flag {
      name: "-t",
      alias: "--title",
      value: true,
      hint: "\"title\"",
      help: "title of the issue (or give it as the bare argument)",
      ..,
    },
    flags.Flag {
      name: "-b",
      alias: "--body -d --description",
      value: true,
      hint: "desc",
      help: "description ('-b -' reads it from stdin)",
      ..,
    },
    flags.Flag {
      name: "--emoji",
      value: true,
      hint: "X",
      help: "one emoji for the issue, shown on the card, the issue page and\nthe list; pass \"\" to clear it",
      ..,
    },
    flags.Flag {
      name: "--priority",
      alias: "-p",
      value: true,
      hint: "name|0-4",
      help: "0 none, 1 urgent (!!!), 2 high (!!), 3 medium (!), 4 low (·)",
      ..,
    },
  ].append(filter_spec(FilterUse.Create)...).append([
    flags.Flag {
      name: "--idempotency-key",
      value: true,
      hint: "key",
      help: "retry the same creation with a stable key: reuse the issue, or refuse a changed payload\nscoped per team; requires a server supporting keyed creation",
      ..,
    },
    flags.Flag {
      name: "--agent",
      value: true,
      hint: "NAME",
      help: "self-asserted session label, recorded as the issue's origin tool\n(default: LLL_AGENT)",
      ..,
    },
    flags.Flag {
      name: "--json",
      help: "the created issue as JSON: the record with key and claim\n(docs/cli-contract.md)",
      ..,
    },
    flags.Flag {
      name: "--help",
      alias: "-h",
      hidden: true,
      help: "show this help",
      ..,
    },
  ]...))
}

fn issue_list_spec() -> Slice<flags.Flag> {
  flags.with_team(filter_spec(FilterUse.List).append([
    flags.Flag {
      name: "--search",
      alias: "",
      value: true,
      hint: "text",
      help: "list only issues whose title contains text",
      ..,
    },
    flags.Flag {
      name: "--sort",
      value: true,
      hint: "f",
      help: f"{strings.Join(query.sort_fields(), ", ")}; prefix - for descending\npriority leads with urgent (- leads with low); unprioritised last either way\n(default: LLL_SORT or 'sort' in .lll.toml, else created)",
      ..,
    },
    flags.Flag {
      name: "--since",
      value: true,
      hint: "rfc3339",
      help: "issues updated at or after an instant: RFC3339 (e.g. 2026-09-18T00:00:00Z),\nor the space form 2026-09-18 00:00:00.000Z\ncurrent records only: no deletions or intermediate states; not exactly-once replay\noverlap the previous window by a second and deduplicate on resume",
      ..,
    },
    flags.Flag {
      name: "--limit",
      alias: "-l",
      value: true,
      hint: "N",
      help: "list at most N issues (positive integer)",
      ..,
    },
    flags.Flag {
      name: "--page",
      value: true,
      hint: "N",
      help: "page of results (positive integer; default 1); --limit sets page size",
      ..,
    },
    flags.Flag {
      name: "--json",
      help: "the list envelope {items, page, perPage, totalItems, totalPages};\neach item the issue record with key and claim (docs/cli-contract.md)",
      ..,
    },
    flags.Flag { name: "--ready", help: "only open issues whose blockers are all done: what an agent can pick up now", .. },
    flags.Flag { name: "--blocked", help: "only issues with an open blocker", .. },
  ]...))
}

