  flags.with_team([
    flags.Flag { name: "--renew", help: "restart the expiry clock on a claim you hold (a hold unrenewed for 24h is released)", .. },
    flags.Flag { name: "--json", help: "print the issue afterwards as JSON: the object 'lll issue list --json' prints per item", .. },
    agent_flag(),
  ])
}

fn issue_release_spec() -> Slice<flags.Flag> {
  flags.with_team([
    flags.Flag { name: "--force", help: "release a claim another member, or another agent label on your token, holds; leaves a comment on the issue", .. },
    reason_flag("release"),
    agent_flag(),
    json_after_flag("the issue"),
  ])
}

/// `--reason` is the one spelling for why a forced action was taken (LLL-646
/// decision): it goes into the comment the server leaves. `-b` stays an
/// alias only on release, which has no other body.
fn reason_flag(verb: string) -> flags.Flag {
  let alias = if verb == "release" { "-b" } else { "" }
  flags.Flag {
    name: "--reason",
    alias,
    value: true,
    hint: "\"why\"",
    help: "with --force: the reason, recorded in the comment ('--reason -' reads stdin)",
    ..,
  }
}

fn agent_flag() -> flags.Flag {
  flags.Flag {
    name: "--agent",
    value: true,
    hint: "NAME",
    help: "self-asserted session label, for agents sharing one member token\n(default: LLL_AGENT)",
    ..,
  }
}

/// The --reason text, read from stdin for '-'. Only a forced action records
/// one, so it is refused without --force rather than silently dropped.
fn forced_reason(p: flags.Parsed, force: bool, what: string) -> Result<string, pb.CliError> {
  if !p.given("--reason") { return Ok("") }
  if !force { return Err(flags.usage_error(f"--reason is the reason for {what}; add --force")) }
  value_or_stdin(p.one("--reason"), "--reason")
}

