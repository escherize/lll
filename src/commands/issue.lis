/// A flag value of `-` means "read it from stdin", the convention `gh gist` and
/// mb-shares' `share -f` use. Reading from a terminal would hang until Ctrl-D,
/// so that is refused with a message instead. `< /dev/null` also reads as a
/// character device, and an empty body is not what anyone meant either way.
fn value_or_stdin(val: string, flag: string) -> Result<string, string> {
  if val != "-" { return Ok(val) }

  if let Ok(info) = os.Stdin.Stat() {
    if info.Mode() & os.ModeCharDevice != 0 {
      return Err(
        f"{flag} - reads the body from stdin, but nothing is piped in (try: echo \"text\" | lll issue ... {flag} -)",
      )
    }
  }

  let Ok(data) = io.ReadAll(os.Stdin) else {
    return Err(f"{flag} -: reading stdin")
  }
  // One trailing newline is the shell's, not the author's: `echo hi` means "hi".
  let text = strings.TrimSuffix(data as string, "\n")
  if text == "" { return Err(f"{flag} -: nothing on stdin") }
  Ok(text)
}

/// One marker per issue, so anything sentence-shaped is a mistake. Graphemes
/// need x/text; rune count is the lazy stand-in that still passes the longest
/// single emoji anyone types (the 7-rune ZWJ family) and stops "in progress".
fn check_emoji(val: string) -> Result<string, string> {
  let trimmed = strings.TrimSpace(val)
  if utf8.RuneCountInString(trimmed) > 8 {
    return Err(
      f"--emoji takes one emoji, got '{trimmed}' (pass \"\" to clear it)",
    )
  }
  Ok(trimmed)
}

/// Shared validators, applied after flags.parse collects the raw values.
/// They live beside the specs so the error wording has exactly one home.
fn check_state(val: string) -> Result<string, string> {
  if query.states().find(|s| s == val).is_none() {
    return Err(
      f"unknown state '{val}' (use one of: {strings.Join(query.states(), ", ")})",
    )
  }
  Ok(val)
}

fn check_priority(val: string) -> Result<int, string> {
  let Ok(p) = strconv.Atoi(val) else {
    return Err(f"--priority must be a number 0-4, got '{val}'")
  }
  if p < 0 || p > 4 {
    return Err(
      f"--priority must be 0-4 (0 none, 1 urgent, 2 high, 3 medium, 4 low), got {p}",
    )
  }
  Ok(p)
}

// ---------------------------------------------------------------------
// Flag tables. One entry per flag: the parser, `lll issue --help` and
// `lll completions` all read them (TASK-127). `name` is the spelling shown
// in usage lines; `alias` is also accepted.

fn issue_create_spec() -> Slice<flags.Flag> {
  [
    flags.Flag {
      name: "-t",
      value: true,
      hint: "\"title\"",
      required: true,
      help: "title of the issue",
      ..
    },
    flags.Flag {
      name: "-d",
      alias: "--description",
      value: true,
      hint: "desc",
      help: "description ('-d -' reads it from stdin)",
      ..
    },
    flags.Flag {
      name: "--emoji",
      value: true,
      hint: "X",
      help: "one emoji for the issue, shown on the card, the issue page and\nthe list; pass \"\" to clear it",
      ..
    },
    flags.Flag {
      name: "--priority",
      value: true,
      hint: "0-4",
      help: "0 none, 1 urgent (!!!), 2 high (!!), 3 medium (!), 4 low (·)",
      ..
    },
    flags.Flag {
      name: "--assignee",
      value: true,
      hint: "name",
      help: "member name (see 'lll member list'); filters on list",
      ..
    },
    flags.Flag {
      name: "--label",
      value: true,
      hint: "name",
      repeat: true,
      help: "label name (see 'lll label list'); repeatable on create/update\n(update replaces the set); filters on list",
      ..
    },
    flags.Flag {
      name: "--project",
      value: true,
      hint: "name",
      help: "project name (see 'lll project list'); filters on list",
      ..
    },
    flags.Flag {
      name: "--json",
      help: "raw PocketBase JSON (team, assignee, labels, project\nexpanded), pipe-friendly",
      ..
    },
  ]
}

fn issue_list_spec() -> Slice<flags.Flag> {
  [
    flags.Flag {
      name: "--state",
      value: true,
      hint: "s",
      help: "one of: backlog, todo, in-progress, in-review, done, cancelled",
      ..
    },
    flags.Flag {
      name: "--assignee",
      value: true,
      hint: "name",
      help: "member name (see 'lll member list'); filters on list",
      ..
    },
    flags.Flag {
      name: "--label",
      value: true,
      hint: "name",
      repeat: true,
      help: "label name (see 'lll label list'); repeatable on create/update\n(update replaces the set); filters on list",
      ..
    },
    flags.Flag {
      name: "--project",
      value: true,
      hint: "name",
      help: "project name (see 'lll project list'); filters on list",
      ..
    },
    flags.Flag {
      name: "--search",
      value: true,
      hint: "q",
      help: "list only issues whose title contains q",
      ..
    },
    flags.Flag {
      name: "--sort",
      value: true,
      hint: "f",
      help: "created, updated, priority, or number; prefix - for descending\n(default: LLL_SORT or 'sort' in .lll.toml, else created)",
      ..
    },
    flags.Flag {
      name: "--limit",
      value: true,
      hint: "N",
      help: "list at most N issues (positive integer)",
      ..
    },
    flags.Flag {
      name: "--json",
      help: "raw PocketBase JSON (team, assignee, labels, project\nexpanded), pipe-friendly",
      ..
    },
  ]
}

