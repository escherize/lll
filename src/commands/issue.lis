/// A flag value of `-` means "read it from stdin", the convention `gh gist` and
/// mb-shares' `share -f` use. Reading from a terminal would hang until Ctrl-D,
/// so that is refused with a message instead. `< /dev/null` also reads as a
/// character device, and an empty body is not what anyone meant either way.
fn value_or_stdin(val: string, flag: string) -> Result<string, string> {
  if val != "-" { return Ok(val) }

  if let Ok(info) = os.Stdin.Stat() {
    if info.Mode() & os.ModeCharDevice != 0 {
      return Err(
        f"{flag} - reads the body from stdin, but nothing is piped in (try: echo \"text\" | lll issue ... {flag} -)",
      )
    }
  }

  let Ok(data) = io.ReadAll(os.Stdin) else {
    return Err(f"{flag} -: reading stdin")
  }
  // Stdin is the author's input, including any final newline or indentation.
  let text = data as string
  if strings.TrimSpace(text) == "" { return Err(f"{flag} -: nothing on stdin") }
  Ok(text)
}

/// One marker per issue, so anything sentence-shaped is a mistake. Graphemes
/// need x/text; rune count is the lazy stand-in that still passes the longest
/// single emoji anyone types (the 7-rune ZWJ family) and stops "in progress".
fn check_emoji(val: string) -> Result<string, string> {
  let trimmed = strings.TrimSpace(val)
  if utf8.RuneCountInString(trimmed) > 8 {
    return Err(
      f"--emoji takes one emoji, got '{trimmed}' (pass \"\" to clear it)",
    )
  }
  Ok(trimmed)
}

fn check_priority(val: string) -> Result<int, string> {
  let named = strings.ToLower(val)
  match named {
    "none" => return Ok(0),
    "urgent" => return Ok(1),
    "high" => return Ok(2),
    "medium" => return Ok(3),
    "low" => return Ok(4),
    _ => (),
  }
  let Ok(p) = strconv.Atoi(val) else {
    return Err(f"unknown priority '{val}' (use none, urgent, high, medium, low, or 0-4)")
  }
  if p < 0 || p > 4 {
    return Err(
      f"--priority must be 0-4 (0 none, 1 urgent, 2 high, 3 medium, 4 low), got {p}",
    )
  }
  Ok(p)
}

// ---------------------------------------------------------------------
// Flag tables. One entry per flag: the parser, `lll issue --help` and
// `lll completions` all read them (TASK-127). `name` is the spelling shown
// in usage lines; `alias` is also accepted.

fn issue_create_spec() -> Slice<flags.Flag> {
  flags.with_team([
    flags.Flag {
      name: "-t",
      alias: "--title",
      value: true,
      hint: "\"title\"",
      help: "title of the issue (or give it as the bare argument)",
      ..,
    },
    flags.Flag {
      name: "-d",
      alias: "--description",
      value: true,
      hint: "desc",
      help: "description ('-d -' reads it from stdin)",
      ..,
    },
    flags.Flag {
      name: "--emoji",
      value: true,
      hint: "X",
      help: "one emoji for the issue, shown on the card, the issue page and\nthe list; pass \"\" to clear it",
      ..,
    },
    flags.Flag {
      name: "--priority",
      alias: "-p",
      value: true,
      hint: "name|0-4",
      help: "0 none, 1 urgent (!!!), 2 high (!!), 3 medium (!), 4 low (·)",
      ..,
    },
  ].append(filter_spec(FilterUse.Create)...).append([
    flags.Flag {
      name: "--json",
      help: "raw PocketBase JSON (team, assignee, labels, project\nexpanded), pipe-friendly",
      ..,
    },
    flags.Flag {
      name: "--help",
      alias: "-h",
      hidden: true,
      help: "show this help",
      ..,
    },
  ]...))
}

fn issue_list_spec() -> Slice<flags.Flag> {
  flags.with_team(filter_spec(FilterUse.List).append([
    flags.Flag {
      name: "--search",
      alias: "--query",
      value: true,
      hint: "text",
      help: "list only issues whose title contains text",
      ..,
    },
    flags.Flag {
      name: "--sort",
      value: true,
      hint: "f",
      help: f"{strings.Join(query.sort_fields(), ", ")}; prefix - for descending\n(default: LLL_SORT or 'sort' in .lll.toml, else created)",
      ..,
    },
    flags.Flag {
      name: "--limit",
      value: true,
      hint: "N",
      help: "list at most N issues (positive integer)",
      ..,
    },
    flags.Flag {
      name: "--page",
      value: true,
      hint: "N",
      help: "page of results (positive integer; default 1); --limit sets page size",
      ..,
    },
    flags.Flag {
      name: "--json",
      help: "raw PocketBase JSON (team, assignee, labels, project\nexpanded), pipe-friendly",
      ..,
    },
    flags.Flag { name: "--ready", help: "only open issues whose blockers are all done (LLL-175): what an agent can pick up now", .. },
    flags.Flag { name: "--blocked", help: "only issues with an open blocker", .. },
  ]...))
}

fn issue_view_spec() -> Slice<flags.Flag> {
  flags.with_team([
    flags.Flag {
      name: "--json",
      help: "issue JSON with expanded relations, comments (oldest first,\nauthor expanded), and claim (member expanded, or null)",
      ..,
    },
    flags.Flag {
      name: "--raw",
      help: "print the issue as plain markdown (view)",
      ..,
    },
    flags.Flag {
      name: "-w",
      help: "open the issue's web page in the browser (view)",
      ..,
    },
  ])
}

fn issue_update_spec() -> Slice<flags.Flag> {
  flags.with_team(filter_spec(FilterUse.Update).append([
    flags.Flag {
      name: "--priority",
      value: true,
      hint: "name|0-4",
      help: "0 none, 1 urgent (!!!), 2 high (!!), 3 medium (!), 4 low (·)",
      ..,
    },
    flags.Flag {
      name: "--title",
      alias: "-t",
      value: true,
      hint: "t",
