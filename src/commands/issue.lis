    flags.Flag {
      name: "--description",
      alias: "-d",
      value: true,
      hint: "d",
      help: "new description (update; '-d -' reads it from stdin)",
      ..,
    },
    flags.Flag {
      name: "--emoji",
      value: true,
      hint: "e",
      help: "one emoji for the issue, shown on the card, the issue page and\nthe list; pass \"\" to clear it",
