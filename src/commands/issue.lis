/// Thin wrapper over the GitHub CLI: gh owns pushing checks, prompts, and
/// errors — we only supply the KEY-prefixed title and an issue-linking body.
fn pr_cmd(input: flags.CommandInput) -> Result<(), string> {
  let usage = "lll issue pr [KEY-123]"
  let id = input.parsed.first()
  let resolved = resolve_id(id, usage)?

  let mut gh = ""
  match exec.LookPath("gh") {
    Partial.Ok(path) => gh = path,
    _ => return Err(
      "gh not found on PATH — install the GitHub CLI (brew install gh)",
    ),
  }

  let issue = records.fetch_issue(resolved)?
  let key = f"{issue.expand.team.key}-{issue.number}"
  let (body, linked_only) = pr_body(issue_url(issue)?, issue.description)?
  if linked_only {
    let _ = fmt.Fprintln(os.Stderr, "issue description exceeds the PR body limit; linking to the full description instead")
  }

  let mut cmd = exec.Command(
    gh,
    "pr",
    "create",
    "--title",
    f"{key}: {issue.title}",
    "--body-file",
    "-",
  )
  cmd.Stdin = Some(strings.NewReader(body))
  cmd.Stdout = Some(os.Stdout)
  cmd.Stderr = Some(os.Stderr)
  if let Err(e) = cmd.Run() { return Err(f"gh pr create: {e}") }
  Ok(())
}

/// Keep the issue as the authoritative full text when its description is
/// larger than GitHub accepts. Never silently publish a truncated excerpt.
fn pr_body(link: string, description: string) -> Result<(string, bool), string> {
  let body = if description == "" { link } else { f"{link}\n\n{description}" }
  if utf8.RuneCountInString(body) <= 65536 { return Ok((body, false)) }
  let fallback = f"{link}\n\nThe full description is on the linked issue; it exceeds the pull request body limit."
  if utf8.RuneCountInString(fallback) > 65536 {
    return Err("the issue URL exceeds the PR body limit; check the configured web_url")
  }
  Ok((fallback, true))
}

/// Web page URL for an issue: <web_url>/issue/KEY-123.
fn issue_url(issue: models.Issue) -> Result<string, string> {
  let base = web_base()?
  Ok(f"{base}/issue/{issue.expand.team.key}-{issue.number}")
}


/// Print comments as "author (3h ago)" then the indented body.
fn print_comments(comments: Slice<models.Comment>) {
  // Numbered so 'comment edit KEY N' and 'comment delete KEY N' have a
  // handle (TASK-320): position in creation order, not the record id.
  let mut n = 0
  for c in comments {
    n += 1
    let mut author = c.expand.author.name
    if author == "" { author = "anon" }
    fmt.Println(f"#{n} {author} ({display.relative(c.created)})")
    fmt.Println(f"  {c.body}")
  }
}

/// `lll issue comment edit KEY N -b "body"` and `... delete KEY N`. N is the
/// position 'comment KEY' prints. Your own comments only, unless --force:
/// the author is the token's member (or 'me' under a superuser token), and
/// a superuser token with no 'me' may change anything.
fn comment_commands() -> Slice<flags.Command> {
  [
    flags.Command { name: "edit", summary: "edit a numbered comment", page: "", spec: comment_mutate_spec("edit"), positional: "KEY N", run: |input| comment_mutate("edit", input.parsed) },
    flags.Command { name: "delete", summary: "delete a numbered comment", page: "", spec: comment_mutate_spec("delete"), positional: "KEY N", run: |input| comment_mutate("delete", input.parsed) },
  ]
}

fn comment_mutate(verb: string, p: flags.Parsed) -> Result<(), string> {
  let spec = comment_mutate_spec(verb)
  let usage = flags.usage(f"lll issue comment {verb}", spec, "KEY-123 N")
  if p.first() == "" || p.nth(1) == "" { return Err(f"usage: {usage}") }
  let resolved = resolve_id(p.first(), usage)?
  let issue = records.fetch_issue(resolved)?
  let key = f"{issue.expand.team.key}-{issue.number}"
  let Ok(n) = strconv.Atoi(p.nth(1)) else {
    return Err(f"'{p.nth(1)}' is not a comment number — 'lll issue comment {key}' numbers them")
  }
  let comments = records.fetch_comments(issue.id)?
  if n < 1 || n > comments.length() {
    return Err(f"{key} has {comments.length()} comments; there is no #{n} — 'lll issue comment {key}' numbers them")
  }
  let c = comments[n - 1]
  let mut whose = c.expand.author.name
  if whose == "" { whose = "anon" }
  if !p.given("--force") {
    if let Some(a) = actor()? {
      if c.author != a.id {
        return Err(f"comment #{n} on {key} is {whose}'s, not yours — --force changes it anyway")
      }
    }
  }
  if verb == "delete" {
    let _ = pb.delete(f"/api/collections/comments/records/{c.id}")?
    fmt.Println(f"Deleted comment #{n} on {key} (was {whose}'s)")
    return Ok(())
  }
  let mut body = ""
  if p.given("-b") {
    body = value_or_stdin(p.one("-b"), "-b")?
  } else if p.nth(2) != "" {
    body = p.nth(2)
  }
  if strings.TrimSpace(body) == "" {
    return Err(f"comment edit needs the new body: -b \"...\" (or '-b -' from stdin)\nusage: {usage}")
  }
  let _ = pb.patch(
    f"/api/collections/comments/records/{c.id}",
    "{\"body\":" + json_quote(body)? + "}",
  )?
  fmt.Println(f"Edited comment #{n} on {key}")
  Ok(())
}

fn comment_mutate_spec(verb: string) -> Slice<flags.Flag> {
  let mut spec = [
    flags.Flag { name: "--force", help: "change a comment that is not yours", .. },
  ]
  if verb == "edit" {
    spec = spec.append(flags.Flag {
      name: "-b",
      alias: "--body -m --message",
      value: true,
      hint: "\"body\"",
      help: "the new body ('-b -' reads it from stdin)",
      ..,
    })
  }
  spec
}


fn deslug(arg: string) -> string {
  // All splitting, no index arithmetic: byte offsets and rune indices disagree
  // on non-ASCII input and panic. See realtime.split_field.
  let mut a = arg
  if strings.Contains(a, "://") {
    let after_scheme = strings.SplitN(a, "://", 2)[1]
    if !strings.Contains(after_scheme, "/") { return arg }
    a = strings.SplitN(after_scheme, "/", 2)[1]
  } else if !strings.Contains(a, "/") { return arg }
  // TASK-144: a URL copied out of a browser carries `?utm_source=...` and
  // `#comment-3`, and neither names the issue. Cut them here, after the host
  // is gone (so a `?` cannot be read as path) and before the trailing slash
  // is trimmed (a share link puts the slash between the key and the query).
  // Fragment first: it may itself contain a `?`, and everything after `#` is
  // fragment.
  a = strings.SplitN(a, "#", 2)[0]
  a = strings.SplitN(a, "?", 2)[0]
  a = strings.TrimSuffix(a, "/")
  // Team-routed board URLs (TASK-198): /t/KEY/issue/ENG-12. The /t/KEY/
  // prefix carries nothing the issue key does not — drop it.
  if strings.HasPrefix(a, "t/") {
    let parts = strings.SplitN(a, "/", 3)
    if parts.length() == 3 { a = parts[2] }
  }
  a = strings.TrimPrefix(a, "issue/")
  if strings.Contains(a, "/") { return arg }
  if a == "" { return arg }
  a
}

fn resolve_id(explicit: string, usage: string) -> Result<string, string> {
  if explicit != "" { return Ok(deslug(explicit)) }
  let Some(branch) = gitctx.current_branch() else {
    return Err(
      f"no issue ID given and no git branch to infer one from\nusage: {usage}",
    )
  }
  let teams = records.list_teams()?
  let mut matches: Slice<string> = []
  for team in teams.items {
    if let Some(id) = gitctx.issue_id_for_team(branch, team.key) { matches = matches.append(id) }
  }
  if matches.length() > 1 {
    return Err(f"branch '{branch}' is ambiguous between {strings.Join(matches, ", ")}; pass the issue ID explicitly")
  }
  if matches.length() == 1 { return Ok(matches[0]) }
  let Some(id) = gitctx.issue_id_from_branch(branch) else {
    return Err(
      f"no issue ID given and current branch '{branch}' doesn't look like eng-123-...\nusage: {usage}",
    )
  }
  Ok(id)
}




/// JSON-encode a string value (quotes + escaping).
fn json_quote(value: string) -> Result<string, string> {
  match json.Marshal(value) {
    Ok(b) => Ok(b as string),
    Err(e) => Err(f"encoding value: {e}"),
  }
}


// ------------------------------------------------------------- doc links

/// Docs linked to an issue. The issue -> doc direction is not stored: it is
/// one `?=` filter over docs.issues, which is the whole reason links are a
/// relation and not a write-once reference on the issue.
fn fetch_issue_docs(issue_id: string) -> Result<Slice<models.Doc>, string> {
  fetch_docs(f"issues.id ?= {query.quote(issue_id)}", "slug", "")
}

fn set_doc_issues(
  doc: models.Doc,
  issue_ids: Slice<string>,
) -> Result<(), string> {
  let encoded = match json.Marshal(issue_ids) {
    Ok(b) => b as string,
    Err(e) => return Err(f"encoding issues: {e}"),
  }
  let _ = pb.patch(
    f"/api/collections/docs/records/{doc.id}",
    "{\"issues\":" + encoded + "}",
  )?
  Ok(())
}

/// Refuse a link whose two ends live in different teams (TASK-173). The doc
/// is looked up in the CONFIGURED team, the issue is whatever KEY-123 names,
/// so `LLL_TEAM=LLL lll issue link GRDN-4 index` would otherwise quietly
/// stitch the two boards' link graphs together.
fn cross_team_link(
  issue: models.Issue,
  team: models.Team,
  d: models.Doc,
) -> Result<(), string> {
  if d.team == issue.team { return Ok(()) }
  let key = f"{issue.expand.team.key}-{issue.number}"
  Err(
    f"{key} is in {issue.expand.team.key} and doc '{d.slug}' is in {team.key} — a link stays inside one team",
  )
}

fn link(input: flags.CommandInput) -> Result<(), string> {
  let usage = "lll issue link KEY-123 SLUG"
  let id = input.parsed.first()
  let slug = input.parsed.nth(1)
  if id == "" || slug == "" { return Err(f"usage: {usage}") }
  let resolved = resolve_id(id, usage)?
  let issue = records.fetch_issue(resolved)?
  let key = f"{issue.expand.team.key}-{issue.number}"
  let team = issue_link_team(issue)?
  let d = fetch_doc(team, slug)?
  cross_team_link(issue, team, d)?

  if d.issues.find(|x| x == issue.id).is_some() {
    fmt.Println(f"{key} is already linked to {d.slug}")
    return Ok(())
  }
  set_doc_issues(d, d.issues.append(issue.id))?
  fmt.Println(f"Linked {key} -> {d.slug}")
  Ok(())
}

fn unlink(input: flags.CommandInput) -> Result<(), string> {
  let usage = "lll issue unlink KEY-123 SLUG"
  let id = input.parsed.first()
  let slug = input.parsed.nth(1)
  if id == "" || slug == "" { return Err(f"usage: {usage}") }
  let resolved = resolve_id(id, usage)?
  let issue = records.fetch_issue(resolved)?
  let key = f"{issue.expand.team.key}-{issue.number}"
  let team = issue_link_team(issue)?
  let d = fetch_doc(team, slug)?
  cross_team_link(issue, team, d)?

  let mut remaining: Slice<string> = []
  for x in d.issues {
    if x != issue.id { remaining = remaining.append(x) }
  }
  if remaining.length() == d.issues.length() {
    return Err(f"{key} is not linked to {d.slug} — see 'lll doc view {d.slug}'")
  }
  set_doc_issues(d, remaining)?
  fmt.Println(f"Unlinked {key} from {d.slug}")
  Ok(())
}

/// An explicit issue identifies its document namespace outside an attached
/// directory. Configured scope remains authoritative, including a mismatch.
fn issue_link_team(issue: models.Issue) -> Result<models.Team, string> {
  Ok(configured_team()?.unwrap_or(issue.expand.team))
}

/// `lll issue block KEY BLOCKER`: KEY cannot start until BLOCKER is done.
/// Refuses a self-block and a cycle (BLOCKER already waits on KEY, at any
/// depth), since a cycle would make both un-ready forever. The dependency
/// lives on the blocked issue: one relation field, no second collection.
fn block(input: flags.CommandInput) -> Result<(), string> {
  let usage = "lll issue block KEY-123 BLOCKER"
  let id = input.parsed.first()
  let blocker_id = input.parsed.nth(1)
  if id == "" || blocker_id == "" { return Err(f"usage: {usage}") }
  let issue = records.fetch_issue(resolve_id(id, usage)?)?
  let blocker = records.fetch_issue(resolve_id(blocker_id, usage)?)?
  let key = f"{issue.expand.team.key}-{issue.number}"
  let bkey = f"{blocker.expand.team.key}-{blocker.number}"
  if issue.id == blocker.id { return Err(f"{key} cannot block itself") }
  if issue.blocked_by.find(|x| x == blocker.id).is_some() {
    fmt.Println(f"{key} is already blocked by {bkey}")
    return Ok(())
  }
  let cyclic = depends_on(blocker, issue.id, 0)?
  if cyclic {
    return Err(f"{bkey} already waits on {key} (directly or through others); blocking {key} by {bkey} would be a cycle")
  }
  set_blocked_by(issue, issue.blocked_by.append(blocker.id))?
  let mut note = ""
  if blocker.state == "done" || blocker.state == "cancelled" { note = f" ({bkey} is already {blocker.state}, so this does not hold {key} back)" }
  fmt.Println(f"{key} is blocked by {bkey}{note}")
  Ok(())
}

fn unblock(input: flags.CommandInput) -> Result<(), string> {
  let usage = "lll issue unblock KEY-123 BLOCKER"
  let id = input.parsed.first()
  let blocker_id = input.parsed.nth(1)
  if id == "" || blocker_id == "" { return Err(f"usage: {usage}") }
  let issue = records.fetch_issue(resolve_id(id, usage)?)?
  let blocker = records.fetch_issue(resolve_id(blocker_id, usage)?)?
  let key = f"{issue.expand.team.key}-{issue.number}"
  let bkey = f"{blocker.expand.team.key}-{blocker.number}"
  let mut remaining: Slice<string> = []
  let mut found = false
  for x in issue.blocked_by {
    if x == blocker.id { found = true } else { remaining = remaining.append(x) }
  }
  if !found {
    fmt.Println(f"{key} was not blocked by {bkey}")
    return Ok(())
  }
  set_blocked_by(issue, remaining)?
  fmt.Println(f"{key} is no longer blocked by {bkey}")
  Ok(())
}

fn set_blocked_by(issue: models.Issue, ids: Slice<string>) -> Result<(), string> {
  let encoded = match json.Marshal(ids) {
    Ok(b) => b as string,
    Err(e) => return Err(f"encoding blockers: {e}"),
  }
  let _ = pb.patch(f"/api/collections/issues/records/{issue.id}", f"{{\"blocked_by\":{encoded}}}")?
  Ok(())
}

/// True when `issue` waits on `target` at any depth. Bounded at eight
/// levels: deeper chains are not a thing a tracker should have.
fn depends_on(issue: models.Issue, target: string, depth: int) -> Result<bool, string> {
  if depth > 8 { return Ok(false) }
  for b in issue.expand.blocked_by {
    if b.id == target { return Ok(true) }
    let full = fetch_issue_by_id(b.id)?
    let deeper = depends_on(full, target, depth + 1)?
    if deeper { return Ok(true) }
  }
  Ok(false)
}

fn fetch_issue_by_id(id: string) -> Result<models.Issue, string> {
  let body = pb.get(f"/api/collections/issues/records/{id}?expand=team,blocked_by")?
  let mut full = models.Issue { .. }
  if let Err(e) = json.Unmarshal(body.bytes(), &full) {
    return Err(f"decoding issue: {e}")
  }
  Ok(full)
}

/// A blocker is open unless it is done or cancelled.
fn open_blockers(issue: models.Issue) -> Slice<models.Issue> {
  issue.expand.blocked_by.filter(|b| b.state != "done" && b.state != "cancelled")
}

/// Issues that name `issue` as a blocker, for the "Blocks:" line.
fn fetch_blocks(issue_id: string) -> Result<Slice<models.Issue>, string> {
  let filter = url.QueryEscape(f"blocked_by.id ?= {query.quote(issue_id)}")
  let mut list = models.IssueList { .. }
  pb.fetch(f"/api/collections/issues/records?perPage=200&sort=number&expand=team&filter={filter}", "issues", &list)?
  Ok(list.items)
}

/// Read the same table used by dispatch and completions.
pub fn issue_verb_spec(verb: string) -> Slice<flags.Flag> {
  flags.command_spec(issue_commands(), verb)
}
