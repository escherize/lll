    flags.Flag { name: "--keep-claim", help: "keep your claim on the closed issue (close releases it by default)", .. },
    flags.Flag { name: "--force", help: "close an issue another member, or another agent label on your token, holds:\nreleases that claim and leaves a comment on the issue", .. },
    reason_flag("close"),
    agent_flag(),
    flags.Flag { name: "--json", help: "print the issue afterwards as JSON: the object 'lll issue list --json' prints per item", .. },
