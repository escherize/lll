fn issue_delete_spec() -> Slice<flags.Flag> {
  flags.with_team([flags.Flag { name: "--force", help: "skip the delete confirmation", .. }])
}

fn issue_comment_spec() -> Slice<flags.Flag> {
  flags.with_team([
    flags.Flag {
      name: "-b",
      alias: "--body -m --message",
      value: true,
      hint: "\"body\"",
      help: "comment body ('-b -' reads it from stdin)",
