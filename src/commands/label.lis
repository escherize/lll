import "go:encoding/json"
import "go:fmt"
import "go:net/url"

import "models"
import "pb"
import "flags"

/// Dispatch `lll label <verb>`.
pub fn label(args: Slice<string>) -> Result<(), string> {
  let Some(verb) = args.get(2) else {
    label_usage()
    return Ok(())
  }
  match verb {
    "list" => label_list(),
    "create" => label_create(args),
    "--help" => {
      label_usage()
      Ok(())
    },
    "-h" => {
      label_usage()
      Ok(())
    },
    other => Err(f"unknown label command: '{other}' (see 'lll label --help')"),
  }
}

fn label_usage() {
  fmt.Println(
    "lll label - work with labels

Usage:
  lll label list                                 list labels (name, color, team)
  lll label create -n \"name\" [-c \"#5e6ad2\"] [--team KEY]
                                                 create a label (no --team means
                                                 workspace-wide)",
  )
}

fn label_list() -> Result<(), string> {
  let mut labels = models.LabelList { .. }
  pb.fetch(
    "/api/collections/labels/records?perPage=200&sort=name&expand=team",
    "labels",
    &labels,
  )?
  for l in labels.items {
    let mut team = l.expand.team.key
    if team == "" { team = "workspace" }
    fmt.Println(f"{l.name}\t{l.color}\t{team}")
  }
  Ok(())
}

fn label_create_spec() -> Slice<flags.Flag> {
  [
    flags.Flag { name: "-n", value: true, hint: "\"name\"", required: true, help: "label name", .. },
    flags.Flag { name: "-c", value: true, hint: "\"#5e6ad2\"", help: "hex color for the label", .. },
    flags.Flag { name: "--team", value: true, hint: "KEY", help: "team key; no --team means workspace-wide", .. },
  ]
}

/// The flag table of one label verb; empty for verbs without flags. Read by
/// `lll completions` so the scripts complete exactly what the parser accepts.
pub fn label_verb_spec(verb: string) -> Slice<flags.Flag> {
  match verb {
    "create" => label_create_spec(),
    _ => [],
  }
}

fn label_create(args: Slice<string>) -> Result<(), string> {
  let spec = label_create_spec()
  let usage = flags.usage("lll label create", spec, "")
  let p = flags.parse(spec, args, 3, false, usage)?
  let name = p.one("-n")
  let color = p.one("-c")
  let team_key = p.one("--team")

  let mut team = ""
  if team_key != "" {
    let Some(t) = find_team(team_key)? else {
      return Err(unknown_team(team_key))
    }
    team = t.id
  }

  let new_label = models.NewLabel { name, color, team }
  let payload = match json.Marshal(new_label) {
    Ok(p) => p,
    Err(e) => return Err(f"encoding label: {e}"),
  }
  let body = pb.post("/api/collections/labels/records", payload as string)?

  let mut created = models.Label { .. }
  if let Err(e) = json.Unmarshal(body.bytes(), &created) {
    return Err(f"decoding created label: {e}")
  }
  fmt.Println(f"Created label {created.name}")
  Ok(())
}

/// Resolve a label by name; unknown names error with the fix.
fn resolve_label(name: string) -> Result<models.Label, string> {
  let filter = url.QueryEscape(f"name='{name}'")
  let mut result = models.LabelList { .. }
  pb.fetch(f"/api/collections/labels/records?filter={filter}", "labels", &result)?
  let Some(l) = result.items.find(|l| l.name == name) else {
    return Err(f"no label named '{name}' — see 'lll label list'")
  }
  Ok(l)
}
