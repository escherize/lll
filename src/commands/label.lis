import "display"
import "records"
import "go:encoding/json"
import "go:strings"

import "models"
import "output"
import "pb"
import "flags"
import "writes"

/// Dispatch `lll label <verb>` through the noun's Command table (TASK-307).
/// The table is the one place a verb is declared: dispatch, `lll label --help`
/// and shell completions all read it, so none of the three can drift.
pub fn label(ctx: pb.Client, args: Slice<string>) -> Result<output.Output, pb.CliError> {
  flags.dispatch(ctx, "label", "work with labels", "", label_commands(), args)
}

/// Every label verb, as a value. Dispatch parses args against `spec` before
/// `run`, so a trailing -h can never reach a verb body - the assertion that
/// matters for `delete`, a write. The summaries are the rows the old
/// print_usage carried, moved rather than reworded.
pub fn label_commands() -> Slice<flags.Command> {
  [
    flags.Command {
      name: "list",
      summary: "list labels (name, color, team); this team's, or every team's when none is configured",
      spec: label_list_spec(),
      run: label_list,
      ..
    },
    flags.Command {
      name: "create",
      summary: "create a label (--team defaults to LLL_TEAM); check 'lll label list' first and reuse over near-duplicates (bug/bugs/defect)",
      page: label_create_page(),
      spec: label_create_spec(),
      positional: "[NAME]",
      run: label_create,
      ..
    },
    flags.Command {
      name: "edit",
      alias: "update",
      summary: "rename or recolor a label; the label keeps its issues",
      spec: label_edit_spec(),
      positional: "NAME",
      run: label_edit,
      ..
    },
    flags.Command {
      name: "move",
      summary: "move a label to another team; refuses while issues outside it still carry the label",
      spec: label_move_spec(),
      positional: "NAME",
      run: label_move,
      ..
    },
    flags.Command {
      name: "delete",
      summary: "delete a label; refuses while issues still carry it, and --force drops it off all of them",
      spec: label_delete_spec(),
      positional: "NAME",
      run: label_delete,
      ..
    },
  ]
}

fn label_list(input: flags.CommandInput) -> Result<output.Output, pb.CliError> {
  let ctx = input.ctx
  let p = input.parsed
  // Scoped when a team is configured, every team's when not: a label belongs
  // to one team (TASK-173), so the unscoped list is an admin's view, not a
  // working one.
  let labels = models.LabelList { items: records.fetch_labels(ctx, configured_scope(ctx)?)? }
  if p.given("--json") { return list_json(labels.items, whole_list(labels.items.length()), "label list") }
  if labels.items.is_empty() { return Ok(empty_list("labels")) }
  let mut out = output.none()
  for l in labels.items {
    let mut team = l.expand.team.key
    if team == "" { team = "workspace" }
    out = out.line(f"{display.table_cell(l.name)}\t{display.table_cell(l.color)}\t{display.table_cell(team)}")
  }
  Ok(out)
}

fn label_list_spec() -> Slice<flags.Flag> {
  flags.with_team([flags.Flag { name: "--json", help: "print the raw record list as JSON", .. }])
}

fn label_create_spec() -> Slice<flags.Flag> {
  flags.with_team([
    flags.Flag { name: "-n", alias: "--name", value: true, hint: "\"name\"", help: "label name", .. },
    flags.Flag { name: "-c", alias: "--color", value: true, hint: "\"#5e6ad2\"", help: "hex color for the label", .. },
    flags.Flag { name: "--team", value: true, hint: "KEY", help: "team key the label belongs to (defaults to LLL_TEAM)", .. },
    flags.Flag { name: "--json", help: "print the created label record as JSON", .. },
  ])
}

fn label_edit_spec() -> Slice<flags.Flag> {
  flags.with_team([
    flags.Flag { name: "-n", alias: "--name", value: true, hint: "\"new name\"", help: "new label name", .. },
    flags.Flag { name: "-c", alias: "--color", value: true, hint: "\"#5e6ad2\"", help: "new hex color for the label", .. },
    json_after_flag("the label record"),
  ])
}

fn label_move_spec() -> Slice<flags.Flag> {
  flags.with_team([
    flags.Flag { name: "--to", value: true, hint: "KEY", help: "team key to move the label to", .. },
    json_after_flag("the label record"),
  ])
}

fn label_delete_spec() -> Slice<flags.Flag> {
  flags.with_team([
    flags.Flag { name: "--force", help: "delete even while issues carry the label", .. },
    flags.Flag { name: "--yes", help: "skip the delete confirmation (asked only on a terminal)", .. },
  ])
}


/// The usage line of `lll label create`. The check-first note rides it
/// (TASK-208), so every surface that prints it - the missing -n error and the
/// help page below - says to reuse before creating.
fn label_create_usage() -> string {
  flags.usage("lll label create", label_create_spec(), "[NAME]") +
  "\n       (check 'lll label list' first; reuse over near-duplicates like bug/bugs/defect)"
}

/// `lll label create --help`. The generic page dispatch would generate uses
/// the bare usage line and so drops the TASK-208 note; this is the same usage
/// + flags block with the note kept, built from the spec so it cannot drift.
fn label_create_page() -> string {
  f"usage: {label_create_usage()}" + flags.section(label_create_spec())
}

fn label_create(input: flags.CommandInput) -> Result<output.Output, pb.CliError> {
  let ctx = input.ctx
  let spec = label_create_spec()
  // The check-first note rides the usage string (TASK-208), so every surface
  // that prints it — --help included — says to reuse before creating.
  let usage = flags.usage("lll label create", spec, "[NAME]") +
  "\n       (check 'lll label list' first; reuse over near-duplicates like bug/bugs/defect)"
  let p = input.parsed
  let name = flags.entity_name(p, "-n", usage)?
  records.check_filter_name("label", name)?
  let color = p.one("-c")
  let team = team_flag_or_current(ctx, p.one("--team"))?

  let body = writes.create_label(ctx, models.NewLabel { name, color, team: team.id })?

  let mut created = models.Label { .. }
  if let Err(e) = json.Unmarshal(body.bytes(), &created) {
    return Err(pb.failed(f"decoding created label: {e}"))
  }
  if p.given("--json") { return Ok(json_body(body)) }
  Ok(output.line(f"Created label {created.name}"))
}

fn label_edit(input: flags.CommandInput) -> Result<output.Output, pb.CliError> {
  let ctx = input.ctx
  let usage = input.usage
  let p = input.parsed
  let Some(name) = nonempty(p.first()) else {
    return Err(flags.usage_error(f"usage: {usage}"))
  }
  if !p.given("-n") && !p.given("-c") {
    return Err(flags.usage_error(f"nothing to update: pass -n or -c\nusage: {usage}"))
  }
  if p.given("-n") { records.check_filter_name("label", p.one("-n"))? }
  let label = records.resolve_label(ctx, current_team(ctx)?.id, name)?

  let mut patch = writes.LabelPatch { .. }
  if p.given("-n") { patch.name = Some(p.one("-n")) }
  if p.given("-c") { patch.color = Some(p.one("-c")) }
  writes.update_label(ctx, label.id, patch)?
  if p.given("--json") { return record_after(ctx, "labels", label.id.string()) }
  // A rename names both, so the line does not report the old name as current
  // (1.0 fleet, case 09).
  if p.given("-n") && p.one("-n") != label.name {
    return Ok(output.line(f"Renamed label {label.name} -> {p.one("-n")}"))
  }
  Ok(output.line(f"Updated label {name}"))
}

/// Delete only after counting references; the web shares the same count policy.
fn label_delete(input: flags.CommandInput) -> Result<output.Output, pb.CliError> {
  let ctx = input.ctx
  let usage = input.usage
  let p = input.parsed
  let Some(name) = nonempty(p.first()) else {
    return Err(flags.usage_error(f"usage: {usage}"))
  }
  let label = records.resolve_label(ctx, current_team(ctx)?.id, name)?
  let used = records.entity_issue_count(ctx, records.Classifier.Label(label.id))?
  if used > 0 && !p.given("--force") {
    return Err(refuse_delete("label", name, used))
  }
  if !confirmed_on_terminal(p.given("--yes"), f"delete label {name}?") {
    return Err(aborted())
  }
  writes.delete_label(ctx, label.id)?
  Ok(output.line(deleted_line("label", name, used)))
}

/// `lll label move NAME --to KEY` (LLL-100). A label created in the wrong
/// team could only be deleted and remade before this, which loses every issue
/// that carried it.
fn label_move(input: flags.CommandInput) -> Result<output.Output, pb.CliError> {
  let ctx = input.ctx
  let usage = input.usage
  let p = input.parsed
  let Some(name) = nonempty(p.first()) else {
    return Err(flags.usage_error(f"usage: {usage}"))
  }
  let from = team_flag_or_current(ctx, p.one("--team"))?
  let to = writes.move_destination(ctx, p.one("--to"))?
  let label = records.resolve_label(ctx, from.id, name)?
  let moved = writes.move_to_team(ctx, records.Classifier.Label(label.id), label.name, from, to)?
  if p.given("--json") { return record_after(ctx, "labels", label.id.string()) }
  Ok(output.line(moved))
}

/// The positional argument, or None when it was absent or blank. `flags`
/// answers "" for both, and a blank name must not reach a name lookup.
fn nonempty(value: string) -> Option<string> {
  if strings.TrimSpace(value) == "" { return None }
  Some(value)
}
