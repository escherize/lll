import "go:encoding/json"
import "go:fmt"
import "go:net/url"
import "go:strings"

import "models"
import "pb"
import "flags"
import "query"

/// Dispatch `lll label <verb>`.
pub fn label(args: Slice<string>) -> Result<(), string> {
  let Some(verb) = args.get(2) else {
    label_usage()
    return Ok(())
  }
  match verb {
    "list" => label_list(args),
    "create" => label_create(args),
    "edit" => label_edit(args),
    "delete" => label_delete(args),
    "--help" => {
      label_usage()
      Ok(())
    },
    "-h" => {
      label_usage()
      Ok(())
    },
    other => Err(f"unknown label command: '{other}' (see 'lll label --help')"),
  }
}

fn label_usage() {
  fmt.Println(
    "lll label - work with labels

Usage:
  lll label list                                 list labels (name, color, team);
                                                 this team's, or every team's
                                                 when none is configured
  lll label create -n \"name\" [-c \"#5e6ad2\"] [--team KEY]
                                                 create a label (--team defaults
                                                 to LLL_TEAM); check 'lll label
                                                 list' first — reuse over
                                                 near-duplicates (bug/bugs/defect)
  lll label edit NAME [-n \"new name\"] [-c \"#5e6ad2\"]
                                                 rename or recolor a label; the
                                                 label keeps its issues
  lll label delete NAME [--force]                delete a label; refuses while
                                                 issues still carry it, and
                                                 --force drops it off all of
                                                 them",
  )
}

fn label_list(args: Slice<string>) -> Result<(), string> {
  let p = flags.parse(label_list_spec(), args, 3, false, "")?
  // Scoped when a team is configured, every team's when not: a label belongs
  // to one team (TASK-173), so the unscoped list is an admin's view, not a
  // working one.
  let filter = url.QueryEscape(
    query.filter(configured_team_id()?, "", "", "", "", ""),
  )
  let mut labels = models.LabelList { .. }
  pb.fetch(
    f"/api/collections/labels/records?perPage=200&sort=name&expand=team&filter={filter}",
    "labels",
    &labels,
  )?
  if p.given("--json") {
    let body = match json.Marshal(labels) {
      Ok(b) => b as string,
      Err(e) => return Err(f"encoding label list: {e}"),
    }
    fmt.Println(body)
    return Ok(())
  }
  for l in labels.items {
    let mut team = l.expand.team.key
    if team == "" { team = "workspace" }
    fmt.Println(f"{l.name}\t{l.color}\t{team}")
  }
  Ok(())
}

fn label_list_spec() -> Slice<flags.Flag> {
  [flags.Flag { name: "--json", help: "print the raw record list as JSON", .. }]
}

fn label_create_spec() -> Slice<flags.Flag> {
  [
    flags.Flag { name: "-n", value: true, hint: "\"name\"", required: true, help: "label name", .. },
    flags.Flag { name: "-c", value: true, hint: "\"#5e6ad2\"", help: "hex color for the label", .. },
    flags.Flag { name: "--team", value: true, hint: "KEY", help: "team key the label belongs to (defaults to LLL_TEAM)", .. },
  ]
}

fn label_edit_spec() -> Slice<flags.Flag> {
  [
    flags.Flag { name: "-n", value: true, hint: "\"name\"", help: "new label name", .. },
    flags.Flag { name: "-c", value: true, hint: "\"#5e6ad2\"", help: "new hex color for the label", .. },
  ]
}

fn label_delete_spec() -> Slice<flags.Flag> {
  [
    flags.Flag { name: "--force", help: "delete even while issues carry the label", .. },
  ]
}

/// The flag table of one label verb; empty for verbs without flags. Read by
/// `lll completions` so the scripts complete exactly what the parser accepts.
pub fn label_verb_spec(verb: string) -> Slice<flags.Flag> {
  match verb {
    "create" => label_create_spec(),
    "list" => label_list_spec(),
    "edit" => label_edit_spec(),
    "delete" => label_delete_spec(),
    _ => [],
  }
}

fn label_create(args: Slice<string>) -> Result<(), string> {
  let spec = label_create_spec()
  // The check-first note rides the usage string (TASK-208), so every surface
  // that prints it — --help included — says to reuse before creating.
  let usage = flags.usage("lll label create", spec, "") +
  "\n       (check 'lll label list' first; reuse over near-duplicates like bug/bugs/defect)"
  let p = flags.parse(spec, args, 3, false, usage)?
  let name = p.one("-n")
  let color = p.one("-c")
  let team = team_flag_or_current(p.one("--team"))?

  let new_label = models.NewLabel { name, color, team: team.id }
  let payload = match json.Marshal(new_label) {
    Ok(p) => p,
    Err(e) => return Err(f"encoding label: {e}"),
  }
  let body = pb.post("/api/collections/labels/records", payload as string)?

  let mut created = models.Label { .. }
  if let Err(e) = json.Unmarshal(body.bytes(), &created) {
    return Err(f"decoding created label: {e}")
  }
  fmt.Println(f"Created label {created.name}")
  Ok(())
}

fn label_edit(args: Slice<string>) -> Result<(), string> {
  let spec = label_edit_spec()
  let usage = flags.usage("lll label edit", spec, "NAME")
  let p = flags.parse(spec, args, 3, true, usage)?
  let Some(name) = nonempty(p.first()) else {
    return Err(f"usage: {usage}")
  }
  if !p.given("-n") && !p.given("-c") {
    return Err(f"nothing to update — pass -n or -c\nusage: {usage}")
  }
  let label = resolve_label(configured_team_id()?, name)?

  let mut fields: Slice<string> = []
  if p.given("-n") { fields = fields.append("\"name\":" + json_quote(p.one("-n"))?) }
  if p.given("-c") { fields = fields.append("\"color\":" + json_quote(p.one("-c"))?) }
  let _ = pb.patch(
    f"/api/collections/labels/records/{label.id}",
    "{" + strings.Join(fields, ",") + "}",
  )?
  fmt.Println(f"Updated label {name}")
  Ok(())
}

/// TASK-131. `/settings` deletes a label with a bare `pb.delete` and no
/// reference check (serve_settings.lis:282), so every issue still carrying it
/// silently loses a label nobody asked to remove. Parity is about
/// capabilities, not about copying that: the CLI counts first, always says
/// the number, and refuses unless --force says the loss is intended.
fn label_delete(args: Slice<string>) -> Result<(), string> {
  let spec = label_delete_spec()
  let usage = flags.usage("lll label delete", spec, "NAME")
  let p = flags.parse(spec, args, 3, true, usage)?
  let Some(name) = nonempty(p.first()) else {
    return Err(f"usage: {usage}")
  }
  let label = resolve_label(configured_team_id()?, name)?
  let used = issue_count(query.filter("", "", "", "", label.id, ""))?
  if used > 0 && !p.given("--force") {
    return Err(refuse_delete("label", name, used))
  }
  let _ = pb.delete(f"/api/collections/labels/records/{label.id}")?
  fmt.Println(deleted_line("label", name, used))
  Ok(())
}

/// The positional argument, or None when it was absent or blank. `flags`
/// answers "" for both, and a blank name must not reach a name lookup.
fn nonempty(value: string) -> Option<string> {
  if strings.TrimSpace(value) == "" { return None }
  Some(value)
}

/// How many issues match a filter. perPage=1 so PocketBase answers the count
/// without a page of records, the same trick the settings sections use.
fn issue_count(filter: string) -> Result<int, string> {
  let mut list = models.IssueList { .. }
  pb.fetch(
    f"/api/collections/issues/records?perPage=1&fields=id&filter={url.QueryEscape(filter)}",
    "issues",
    &list,
  )?
  Ok(list.total_items)
}

/// The refusal a guarded delete answers with. Names the count and the exact
/// command that overrides it, so the user never has to guess the flag.
fn refuse_delete(kind: string, name: string, used: int) -> string {
  f"{used} issue(s) still reference the {kind} '{name}' — deleting it drops the {kind} off them.\nRun 'lll {kind} delete {name} --force' to delete it anyway, or reassign those issues first."
}

/// What a completed delete prints. The count rides along even on the forced
/// path, because "how many issues just changed" is the thing worth knowing.
fn deleted_line(kind: string, name: string, used: int) -> string {
  if used == 0 { return f"Deleted {kind} {name}" }
  f"Deleted {kind} {name} (dropped from {used} issue(s))"
}

/// Resolve one team's label by name; unknown names error with the fix. An
/// empty `team_id` searches every team, which only the unscoped board wants.
///
/// Names are unique within a team, not across them (TASK-173): two projects
/// may both call something "bug", and attaching one team's to the other
/// team's issue is the leak team scoping exists to stop.
fn resolve_label(team_id: string, name: string) -> Result<models.Label, string> {
  let filter = url.QueryEscape(query.scoped(team_id, "name", name))
  let mut result = models.LabelList { .. }
  pb.fetch(f"/api/collections/labels/records?filter={filter}", "labels", &result)?
  let Some(l) = result.items.find(|l| l.name == name) else {
    return Err(f"no label named '{name}' — see 'lll label list'")
  }
  Ok(l)
}
