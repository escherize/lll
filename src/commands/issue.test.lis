import "flags"
import "query"
import "models"
import "go:strings"
import "records"

#[test]
fn description_replacement_splits_once_after_unicode_without_trimming() {
  let assert Ok((old, new)) = parse_description_replacement(" café =日本=x ")
  assert old == " café "
  assert new == "日本=x "
  let assert Ok((old, new)) = parse_description_replacement("=")
  assert old == ""
  assert new == ""
  assert parse_description_replacement("missing separator").is_err()
}

// Unit cover for the pure helpers in issue.lis. Everything here is a function
// of its arguments alone — no PocketBase, no config, no git.
//
// Multi-byte input is deliberate throughout. Byte offsets and rune indices
// disagree, and that confusion panicked in five places in this codebase
// (see realtime.split_field). An all-ASCII suite is how that reached
// production, so every helper that walks a string is fed non-ASCII here.

// ---------------------------------------------------------------- deslug

#[test]
fn deslug_returns_a_bare_key_untouched() {
  assert deslug("ENG-12") == "ENG-12"
  assert deslug("") == ""
  assert deslug("nonsense") == "nonsense"
}

#[test]
fn deslug_strips_scheme_host_and_issue_prefix() {
  assert deslug("http://127.0.0.1:8100/issue/ENG-12") == "ENG-12"
  assert deslug("https://board.example.com/issue/ENG-12") == "ENG-12"
  assert deslug("https://board.example.com/ENG-12") == "ENG-12"
}

#[test]
fn deslug_ignores_a_trailing_slash() {
  assert deslug("http://127.0.0.1:8100/issue/ENG-12/") == "ENG-12"
}

#[test]
fn deslug_strips_a_team_route_prefix() {
  // TASK-198: the board's canonical issue URLs live under /t/KEY/.
  assert deslug("http://127.0.0.1:8100/t/ENG/issue/ENG-12") == "ENG-12"
  assert deslug("t/ENG/issue/ENG-12") == "ENG-12"
  assert deslug("https://board.example.com/t/日本/issue/日本-3") == "日本-3"
}

#[test]
fn deslug_accepts_a_relative_issue_path() {
  assert deslug("issue/ENG-12") == "ENG-12"
}

/// The whole reason deslug is all splitting and no index arithmetic.
#[test]
fn deslug_survives_multi_byte_hosts_paths_and_keys() {
  assert deslug("http://exämple.test/issue/ÉNG-12") == "ÉNG-12"
  assert deslug("https://日本.example/issue/日本-3") == "日本-3"
  assert deslug("http://board.test/issue/🐛-1") == "🐛-1"
  assert deslug("héllo") == "héllo"
}

#[test]
fn deslug_returns_the_argument_when_it_is_not_key_shaped() {
  // No path at all: nothing to strip.
  assert deslug("http://127.0.0.1:8100") == "http://127.0.0.1:8100"
  // Path is empty once the host is gone.
  assert deslug("http://127.0.0.1:8100/") == "http://127.0.0.1:8100/"
  // More path than an issue page has; left alone so the caller's "not an
  // issue ID" message quotes what the user actually typed.
  assert deslug("http://127.0.0.1:8100/a/b/c") == "http://127.0.0.1:8100/a/b/c"
}

/// TASK-144: a URL copied out of a browser carries tracking params and an
/// anchor, and both used to ride into the issue ID ("'ENG-12?tab=comments' is
/// not an issue ID"). Neither names the issue, so both come off.
#[test]
fn deslug_drops_a_query_string_or_fragment() {
  assert deslug("http://127.0.0.1:8100/issue/ENG-12?tab=comments") == "ENG-12"
  assert deslug("http://127.0.0.1:8100/issue/ENG-12#c1") == "ENG-12"
  // Both at once, in the order a browser writes them.
  assert deslug("http://127.0.0.1:8100/issue/ENG-12?utm_source=slack#comment-3")
  == "ENG-12"
  // A fragment before a literal "?" is still all fragment: the first
  // delimiter wins, so nothing after "#" can be mistaken for a key.
  assert deslug("http://127.0.0.1:8100/issue/ENG-12#c1?x=1") == "ENG-12"
  // The trailing slash a share link often carries sits between the key and
  // the query string, so it has to be trimmed after the split, not before.
  assert deslug("http://127.0.0.1:8100/t/ENG/issue/ENG-12/?utm_source=slack")
  == "ENG-12"
  // Multi-byte keys keep working with the delimiters attached.
  assert deslug("https://日本.example/issue/日本-3?tab=comments") == "日本-3"
}

/// The delimiters do not create keys out of paths that have none: a stripped
/// URL that is still not key-shaped comes back untouched, so the caller's
/// error quotes what the user actually pasted.
#[test]
fn deslug_keeps_the_argument_when_only_a_query_string_is_left() {
  assert deslug("http://127.0.0.1:8100/?utm_source=slack") ==
  "http://127.0.0.1:8100/?utm_source=slack"
  assert deslug("http://127.0.0.1:8100/a/b/c?x=1") ==
  "http://127.0.0.1:8100/a/b/c?x=1"
  // An issue page with no key at all degrades to the literal "issue".
  assert deslug("http://127.0.0.1:8100/issue/") == "issue"
  assert deslug("http://127.0.0.1:8100/issue/?x=1") == "issue"
}

/// Neither delimiter present: the untouched path must not regress.
#[test]
fn deslug_leaves_a_url_without_a_query_string_or_fragment_alone() {
  assert deslug("http://127.0.0.1:8100/issue/ENG-12") == "ENG-12"
  assert deslug("ENG-12") == "ENG-12"
}

// ----------------------------------------------------------- check_emoji

#[test]
fn check_emoji_trims_surrounding_space() {
  let assert Ok(e) = records.check_emoji("  🐛  ")
  assert e == "🐛"
}

#[test]
fn check_emoji_clears_with_an_empty_string() {
  let assert Ok(e) = records.check_emoji("")
  assert e == ""
  let assert Ok(blank) = records.check_emoji("   ")
  assert blank == ""
}

#[test]
fn check_emoji_allows_the_longest_single_emoji() {
  // ZWJ family: 7 runes, 25 bytes. Regional-indicator flag: 2 runes, 8 bytes.
  let assert Ok(family) = records.check_emoji("👨‍👩‍👧‍👦")
  assert family == "👨‍👩‍👧‍👦"
  let assert Ok(flag) = records.check_emoji("🇺🇸")
  assert flag == "🇺🇸"
}

/// The limit is 8 RUNES. A byte-length check would reject a single emoji
/// (4 bytes each) long before it rejected a sentence.
#[test]
fn check_emoji_counts_runes_not_bytes() {
  // 4 runes, 16 bytes — passes.
  let assert Ok(bugs) = records.check_emoji("🐛🐛🐛🐛")
  assert bugs == "🐛🐛🐛🐛"
  // 8 runes, 8 bytes — passes on the same budget.
  let assert Ok(ascii) = records.check_emoji("abcdefgh")
  assert ascii == "abcdefgh"
}

#[test]
fn check_emoji_rejects_more_than_eight_runes() {
  let assert Err(msg) = records.check_emoji("abcdefghi")
  assert msg.message.contains("--emoji takes one emoji")
  assert msg.message.contains("abcdefghi")
  let assert Err(_) = records.check_emoji("in progress")
  // 9 runes of non-ASCII is over the line too, bytes notwithstanding.
  let assert Err(_) = records.check_emoji("🐛🐛🐛🐛🐛🐛🐛🐛🐛")
}

#[test]
fn check_emoji_reports_the_trimmed_value() {
  let assert Err(msg) = records.check_emoji("  in progress  ")
  assert msg.message.contains("'in progress'")
}

// -------------------------------------------------------- value_or_stdin

/// Only a lone `-` reaches for stdin; everything else is returned verbatim,
/// including values that merely start with a dash.
#[test]
fn value_or_stdin_returns_a_plain_value_unchanged() {
  let assert Ok(v) = value_or_stdin("a description", "-d")
  assert v == "a description"
  let assert Ok(empty) = value_or_stdin("", "-d")
  assert empty == ""
  let assert Ok(dashed) = value_or_stdin("-not-stdin", "-d")
  assert dashed == "-not-stdin"
  let assert Ok(utf8) = value_or_stdin("café — 日本 🐛", "-d")
  assert utf8 == "café — 日本 🐛"
  // Preserve the author's trailing newline.
  let assert Ok(nl) = value_or_stdin("line\n", "-d")
  assert nl == "line\n"
}


/// The number is the LAST segment, so a team key may contain hyphens.

/// TrimSuffix on the whole id, not a byte offset into it.


// -------------------------------------------------- issue_create_spec

/// TASK-125: create could not set a state, so every issue landed in the
/// default and needed a follow-up 'issue update KEY --state x'.
#[test]
fn issue_create_spec_accepts_a_state() {
  let spec = issue_create_spec()
  let assert Some(state) = spec.find(|f| f.name == "--state")
  assert state.value
  // The parser has to see it, not just help: parse is what returned
  // "unknown flag: '--state'".
  let assert Ok(p) =
    flags.parse(spec, ["lll", "issue", "create", "-t", "x", "--state", "done"], 3, false, "")
  assert p.given("--state")
  assert p.one("--state") == "done"
}

/// create and update validate against ONE list — query.states() — so the two
/// verbs cannot drift about what a state is.
#[test]
fn create_and_update_share_one_state_validator() {
  let assert Ok(ok) = query.state("in-review")
  assert ok == models.IssueState.InReview
  let assert Err(msg) = query.state("nope")
  assert msg.message.contains("unknown state 'nope'")
  // The message enumerates query.states() rather than a second hand-written
  // list, so adding a state cannot leave create behind.
  for s in query.states() {
    assert msg.message.contains(s)
    let assert Ok(accepted) = query.state(s)
    assert accepted.wire() == s
  }
}

/// The default when --state is absent stays todo, so TASK-125 adds a door
/// rather than moving where issues land.
#[test]
fn issue_create_without_a_state_flag_is_not_given() {
  let assert Ok(p) =
    flags.parse(issue_create_spec(), ["lll", "issue", "create", "-t", "x"], 3, false, "")
  assert !p.given("--state")
}

/// TASK-125: the short -p every other value flag has a habit of offering.
#[test]
fn issue_create_spec_takes_p_as_short_for_priority() {
  let spec = issue_create_spec()
  let assert Ok(p) =
    flags.parse(spec, ["lll", "issue", "create", "-t", "x", "-p", "2"], 3, false, "")
  // The alias lands under the canonical name, so create reads one spelling.
  assert p.one("--priority") == "2"
  let assert Ok(two) = check_priority(p.one("--priority"))
  assert two == models.Priority.High
}

/// LLL-313: -l on issue list --limit, the one short the audit called
/// defensible. -P and -p stay rejected on list — list has no priority filter
/// to alias, and -p already means priority on create/update.
#[test]
fn issue_list_takes_l_for_limit_and_refuses_p_shorts() {
  let spec = issue_list_spec()
  let assert Ok(p) = flags.parse(spec, ["lll", "issue", "list", "-l", "5"], 3, false, "")
  assert p.one("--limit") == "5"
  assert flags.parse(spec, ["lll", "issue", "list", "-p", "2"], 3, false, "").is_err()
  assert flags.parse(spec, ["lll", "issue", "list", "-P", "2"], 3, false, "").is_err()
}

/// --help is hidden: it is a parser entry so 'issue create --help' is not an
/// unknown flag, but it must not appear in help output or completions.
#[test]
fn issue_create_help_flag_is_hidden_from_help_and_completions() {
  let spec = issue_create_spec()
  let assert Some(help) = spec.find(|f| f.name == "--help")
  assert help.hidden
  assert flags.tokens(spec).find(|t| t == "--help").is_none()
  assert !flags.usage("lll issue create", spec, "").contains("--help")
  assert !flags.section(spec).contains("--help")
}

// ------------------------------------------------------- member create

/// TASK-130: `member create` is an alias for `member add`, so both spellings
/// resolve to the same flag table. Lives here rather than in member.test.lis
/// because this shard's file list does not include that file.
#[test]
fn member_create_is_an_alias_for_member_add() {
  let add = flags.tokens(flags.command_spec(member_commands(), "add"))
  let create = flags.tokens(flags.command_spec(member_commands(), "create"))
  assert create.equals(add)
  // add is not weakened by the alias: both carry -n. It is optional now, not
  // required - TASK-309's fleet had agents type a bare name the way `issue
  // create` takes a bare title, and the body refuses only when BOTH are
  // absent, so the flag layer must not demand -n on its own.
  let assert Some(n) = flags.command_spec(member_commands(), "add").find(|f| f.name == "-n")
  assert n.alias == "--name"
  assert !n.required
  assert n.value
}

#[test]
fn named_priorities_round_trip_with_numeric_compatibility() {
  for name in ["none", "urgent", "high", "medium", "low"] {
    let assert Ok(value) = check_priority(name)
    let assert Ok(numeric) = check_priority(f"{value.wire()}")
    assert numeric == value
  }
  let assert Ok(high) = check_priority("HIGH")
  assert high == models.Priority.High
  assert check_priority("critical").is_err()
}

#[test]
fn issue_json_preserves_server_fields_and_exposes_empty_handoff_context() {
  let assert Ok(out) = issue_view_json("{\"id\":\"record\",\"future\":9007199254740993,\"extra\":{\"flag\":true}}", [], None, [], [])
  assert out.contains("\"future\":9007199254740993")
  assert out.contains("\"extra\":{\"flag\":true}")
  assert out.contains("\"comments\":[]")
  assert out.contains("\"claim\":null")
  assert out.contains("\"docs\":[]")
  assert out.contains("\"findings\":[]")
}

#[test]
fn issue_json_exposes_authored_comments_and_current_holder() {
  let comments = [models.Comment { body: "handoff\nnext step", author: "alice-id", .. }]
  let claim = models.Claim { member: "bob-id", .. }
  let assert Ok(out) = issue_view_json("{\"id\":\"record\"}", comments, Some(claim), [models.Doc { slug: "decision", body: "why\nnext", .. }], [models.Doc { slug: "finding", area: "cli", .. }])
  assert out.contains("\"body\":\"handoff\\nnext step\"")
  assert out.contains("\"author\":\"alice-id\"")
  assert out.contains("\"member\":\"bob-id\"")
  assert out.contains("\"slug\":\"decision\"")
  assert out.contains("\"body\":\"why\\nnext\"")
  assert out.contains("\"slug\":\"finding\"")
  let assert Err(_) = issue_view_json("broken", [], None, [], [])
}

#[test]
fn issue_help_accepts_each_known_verb_before_or_after_an_identifier() {
  for verb in issue_commands().map(|c| c.name) {
    assert issue_help_requested(["lll", "issue", verb, "--help"], verb)
    assert issue_help_requested(["lll", "issue", verb, "DX-1", "-h"], verb)
  }
  assert !issue_help_requested(["lll", "issue", "bogus", "--help"], "bogus")
}

#[test]
fn issue_help_preserves_literal_flag_values_and_end_of_options() {
  assert !issue_help_requested(["lll", "issue", "create", "-d", "--help"], "create")
  assert !issue_help_requested(["lll", "issue", "update", "-d", "--help"], "update")
  assert !issue_help_requested(["lll", "issue", "comment", "-b", "-h"], "comment")
  assert !issue_help_requested(["lll", "issue", "create", "--description=--help"], "create")
  assert !issue_help_requested(["lll", "issue", "create", "--", "--help"], "create")
  assert issue_help_requested(["lll", "issue", "create", "-d", "--help", "--help"], "create")
}

// -------------------------------------------------------- issue_commands

/// TASK-307: the table is what dispatch, `lll issue --help` and completions
/// read, so every canonical verb is in it once, with a one-line
/// summary - a blank or multi-line summary breaks the noun's help table.
#[test]
fn issue_commands_lists_every_verb_once_with_a_one_line_summary() {
  let cmds = issue_commands()
  assert cmds.map(|c| c.name).equals([
    "attach", "detach", "download", "create", "list", "next", "view", "update", "close", "start", "claim",
    "release", "delete", "comment", "watch", "url", "id", "title", "branch-name", "pr", "ref", "link",
    "unlink", "block", "unblock",
  ])
  for c in cmds {
    assert c.summary != ""
    assert !c.summary.contains("\n")
  }
}

/// create and next are the issue verbs with a page (new resolves to create's
/// row); next's is its generated usage plus the stream contract. Every other
/// verb generates usage + flags from its spec, so a page there would be invented.
#[test]
fn only_issue_create_and_next_have_a_page() {
  for c in issue_commands() {
    assert (c.page != "") == (c.name == "create" || c.name == "next")
  }
  let assert Some(create) = issue_commands().find(|c| c.name == "create")
  assert create.page.contains("The title is the bare argument or -t")
}

fn issue_help_requested(args: Slice<string>, verb: string) -> bool {
  if issue_commands().find(|c| c.name == verb).is_none() { return false }
  flags.help_requested(flags.command_spec(issue_commands(), verb), args, 3)
}

// ---------------------------------------------------------------- next

/// An agenda item with only the fields the ranking reads; `..` zeroes the rest.
fn agenda_item(id: string, assignee: string, priority: int, created: string) -> models.Issue {
  models.Issue { id: models.IssueId(id), assignee: models.MemberId(assignee), priority_wire: priority, created, .. }
}

fn agenda_unblocks(pairs: Slice<(string, int)>) -> Map<models.IssueId, int> {
  let mut m = Map.new<models.IssueId, int>()
  for (id, n) in pairs { m[models.IssueId(id)] = n }
  m
}

#[test]
fn rank_agenda_prefers_more_urgent_priority_with_none_last() {
  // Linear scale: 0 none, 1 urgent, 2 high, 3 medium, 4 low — none sorts
  // after low, the rotation prio_rank already uses elsewhere.
  let items = [
    agenda_item("none1", "", 0, "2026-01-01 00:00:00.000Z"),
    agenda_item("low1", "", 4, "2026-01-01 00:00:00.000Z"),
    agenda_item("urgent1", "", 1, "2026-01-01 00:00:00.000Z"),
    agenda_item("high1", "", 2, "2026-01-01 00:00:00.000Z"),
  ]
  let ranked = rank_agenda(items, agenda_unblocks([]))
  assert ranked[0].id == "urgent1"
  assert ranked[1].id == "high1"
  assert ranked[2].id == "low1"
  assert ranked[3].id == "none1"
}

// LLL-382: `--sort priority` is a triage order. PocketBase can only sort the
// stored number, where none is 0, so it led with the unprioritised.
#[test]
fn rank_by_priority_leads_with_urgent_and_keeps_none_last_both_ways() {
  let items = [
    agenda_item("none1", "", 0, "2026-01-01 00:00:00.000Z"),
    agenda_item("low1", "", 4, "2026-01-01 00:00:00.000Z"),
    agenda_item("urgent1", "", 1, "2026-01-01 00:00:00.000Z"),
    agenda_item("high1", "", 2, "2026-01-01 00:00:00.000Z"),
  ]
  let up = rank_by_priority(items, false)
  assert up.map(|i| i.id).equals(["urgent1", "high1", "low1", "none1"])

  // Descending reverses the prioritised ones; none is absent, not lowest, so
  // it stays at the end rather than leading.
  let down = rank_by_priority(items, true)
  assert down.map(|i| i.id).equals(["low1", "high1", "urgent1", "none1"])
}

#[test]
fn page_of_windows_a_locally_ordered_list() {
  let items = [
    agenda_item("a", "", 1, ""),
    agenda_item("b", "", 1, ""),
    agenda_item("c", "", 1, ""),
  ]
  assert page_of(items, 1, 2).map(|i| i.id).equals(["a", "b"])
  assert page_of(items, 2, 2).map(|i| i.id).equals(["c"])
  assert page_of(items, 3, 2).is_empty()
}

#[test]
fn rank_agenda_prefers_older_issues() {
  let items = [
    agenda_item("newer", "", 0, "2026-09-15 10:00:00.000Z"),
    agenda_item("older", "", 0, "2026-09-01 08:00:00.000Z"),
  ]
  assert rank_agenda(items, agenda_unblocks([]))[0].id == "older"
}

#[test]
fn rank_agenda_prefers_unclaimed_over_claimed() {
  let items = [
    agenda_item("claimed-urgent", "alice", 1, "2026-09-01 08:00:00.000Z"),
    agenda_item("unclaimed-low", "", 4, "2026-09-14 08:00:00.000Z"),
  ]
  assert rank_agenda(items, agenda_unblocks([]))[0].id == "unclaimed-low"
}

#[test]
fn rank_agenda_prefers_the_issue_that_unblocks_more() {
  let items = [
    agenda_item("frees-one", "", 0, "2026-09-01 08:00:00.000Z"),
    agenda_item("frees-three", "", 0, "2026-09-01 08:00:00.000Z"),
  ]
  let unblocks = agenda_unblocks([("frees-one", 1), ("frees-three", 3)])
  assert rank_agenda(items, unblocks)[0].id == "frees-three"
  // Missing entries count as zero, not a crash.
  let partial = agenda_unblocks([("frees-one", 1)])
  assert rank_agenda(items, partial)[0].id == "frees-one"
}

#[test]
fn rank_agenda_keeps_input_order_on_full_ties_and_handles_empty() {
  let items = [
    agenda_item("first", "", 2, "2026-09-01 08:00:00.000Z"),
    agenda_item("second", "", 2, "2026-09-01 08:00:00.000Z"),
  ]
  let ranked = rank_agenda(items, agenda_unblocks([]))
  assert ranked[0].id == "first"
  assert ranked[1].id == "second"
  assert rank_agenda([], agenda_unblocks([])).length() == 0
}

// LLL-484 (fleet case 01): seven of ten fresh workers took the bare "no
// issues" from a title-only search as "the term is nowhere on the board",
// when the term sat in a description. The hint names the narrower contract
// and the full-text escape hatch instead of leaving the empty result bare.
#[test]
fn empty_search_hint_names_the_title_contract_and_lll_search() {
  let msg = empty_search_hint("socket reset")
  assert strings.Contains(msg, "'socket reset'")
  assert strings.Contains(msg, "titles only")
  assert strings.Contains(msg, "'lll search socket reset'")
  // Multi-word searches pass through as the words the operator can retype.
  assert strings.Contains(empty_search_hint("LAN"), "'lll search LAN'")
}

/// LLL-503: the product has at most one alternate spelling per verb/flag.
/// One exception, from D6 (LLL-644): where the long text is a description,
/// -b/--body is canonical and -d/--description stays accepted.
fn alias_count_ok(fl: flags.Flag) -> bool {
  fl.alias == "--body -d --description" ||
  strings.Fields(fl.alias).length() <= 1
}

#[test]
fn command_tables_keep_one_alias_per_verb_and_flag() {
  let tables = [issue_commands(), comment_commands(), team_commands(), member_commands(),
    project_commands(), label_commands(), doc_commands(), finding_commands(),
    config_commands(), import_commands(), token_commands(), webhook_commands()]
  for table in tables {
    for c in table {
      assert strings.Fields(c.alias).length() <= 1
      for fl in c.spec {
        assert alias_count_ok(fl)
        if fl.name == "--limit" { assert fl.alias == "-l" }
      }
    }
  }
  for spec in [watch_spec(), up_spec(), attach_spec(),
    board_spec(), login_spec(), api_spec(), search_spec()] {
    for fl in spec {
      assert alias_count_ok(fl)
      if fl.name == "--limit" { assert fl.alias == "-l" }
    }
  }
}

/// LLL-504: one operation has one advertised word across nouns.
#[test]
fn command_tables_advertise_consistent_creation_and_deletion() {
  for table in [issue_commands(), team_commands(), member_commands(), project_commands(),
    label_commands(), doc_commands(), finding_commands()] {
    assert table.find(|c| c.name == "create").is_some()
    assert table.find(|c| c.name == "new" || c.name == "add").is_none()
  }
  for table in [issue_commands(), member_commands(), project_commands(), label_commands(), doc_commands()] {
    assert table.find(|c| c.name == "delete").is_some()
    assert table.find(|c| c.name == "remove").is_none()
  }
}

fn blocked(id: string, state: string, blocked_by: Slice<string>) -> models.Issue {
  models.Issue { id: models.IssueId(id), state_wire: state, blocked_by: blocked_by.map(|b| models.IssueId(b)), .. }
}

/// LLL-672: PocketBase drops a blocker the reader may not see from the
/// expand. The id is still on the record, and it counts as open: nothing
/// proves it finished, and its state is not this reader's to learn.
#[test]
fn a_hidden_blocker_is_not_ready() {
  let issue = blocked("a", "todo", ["hidden"])
  let b = records.blockers_of(issue, [])
  assert b.hidden == 1
  assert b.open.is_empty()
  assert b.any()
  assert !records.is_ready(issue, [])
}

#[test]
fn readiness_counts_visible_open_blockers_and_ignores_finished_ones() {
  let done = blocked("d", "done", [])
  let cancelled = blocked("c", "cancelled", [])
  let open = blocked("o", "in-progress", [])
  assert records.is_ready(blocked("a", "todo", ["d", "c"]), [done, cancelled])
  assert records.is_ready(blocked("a", "backlog", []), [])
  let stuck = blocked("a", "todo", ["d", "o"])
  assert !records.is_ready(stuck, [done, open])
  assert records.blockers_of(stuck, [done, open]).open.length() == 1
  assert records.blockers_of(stuck, [done, open]).hidden == 0
  // Not open itself: blockers or no, it is not work to pick up.
  assert !records.is_ready(blocked("a", "in-review", []), [])
}

/// LLL-679: an archived team is read-only, so its open issues are not ready.
/// With no team configured, `issue next` offered one.
#[test]
fn an_issue_in_an_archived_team_is_not_ready() {
  let mut issue = blocked("a", "todo", [])
  assert records.is_ready(issue, [])
  issue.expand.team = models.Team { key: "OLD", archived: true, .. }
  assert !records.is_ready(issue, [])
}

/// watch --ready reads the same rule: the cache first, then the issue's
/// expand for a blocker outside it, and an id in neither is hidden.
#[test]
fn watch_ready_keys_share_the_readiness_rule() {
  let mut outside = blocked("x", "done", [])
  let mut a = blocked("a", "todo", ["x"])
  a.expand.blocked_by = [outside]
  let hid = blocked("h", "todo", ["gone"])
  let keys = ready_keys([a, hid])
  assert keys.contains("a")
  assert !keys.contains("h")
  // The cache is fresher than the expand: a blocker it holds as open wins.
  outside.state_wire = "todo"
  assert !ready_keys([a, outside]).contains("a")
}

fn assigned(number: int, to: string) -> models.Issue {
  models.Issue {
    number,
    assignee: "m",
    expand: models.IssueExpand { team: models.Team { key: "ENG", .. }, assignee: models.Member { name: to, .. }, .. },
    ..
  }
}

/// The 1.0 fleet: four agents read "the agenda is empty" while every ready
/// issue was assigned. The refusal names them and the way to offer one.
#[test]
fn an_agenda_of_assigned_issues_says_so() {
  assert empty_agenda_message([]).contains("the agenda is empty")
  let msg = empty_agenda_message([assigned(4, "alice"), assigned(5, "bob"), assigned(6, "cy"), assigned(7, "dee")])
  assert msg.contains("4 ready issues match but are assigned (ENG-4 to alice, ENG-5 to bob, ENG-6 to cy, ...)")
  assert empty_agenda_message([assigned(4, "alice")]).contains("1 ready issue matches but is assigned (ENG-4 to alice)")
  assert msg.contains("'lll issue update KEY --assignee none' offers one")
}

/// `issue next --help` states the output contract; --ready is accepted but
/// not shown.
#[test]
fn issue_next_help_states_the_stream_contract() {
  assert issue_next_page().contains("Capture stdout only: key=$(lll issue next --claim)")
  let assert Some(ready) = issue_next_spec().find(|f| f.name == "--ready")
  assert ready.hidden
  assert !issue_next_page().contains("--ready")
}

/// --assignee '' is none (three 1.0 fleet agents typed it).
#[test]
fn an_empty_assignee_means_none() {
  let spec = [flags.Flag { name: "--assignee", value: true, .. }]
  let assert Ok(p) = flags.parse(spec, ["lll", "issue", "update", "--assignee", ""], 3, false, "")
  assert assignee_value(p) == "none"
  let assert Ok(named) = flags.parse(spec, ["lll", "issue", "update", "--assignee", "alice"], 3, false, "")
  assert assignee_value(named) == "alice"
  let assert Ok(absent) = flags.parse(spec, ["lll", "issue", "update"], 3, false, "")
  assert assignee_value(absent) == ""
}

/// The 1.0 fleet: a stale stamp's refusal carries the retry, stamp swapped.
#[test]
fn a_retry_command_swaps_in_the_current_stamp() {
  let cmd = retry_command(["lll", "issue", "update", "ENG-1", "--description-append", "two words", "--if-unchanged-since", "old"], "2026-10-09 02:55:01.501Z")
  assert cmd == "lll issue update ENG-1 --description-append 'two words' --if-unchanged-since '2026-10-09 02:55:01.501Z'"
  let inline = retry_command(["lll", "issue", "update", "ENG-1", "--if-unchanged-since=old"], "2026-10-09T02:55:01.501Z")
  assert inline == "lll issue update ENG-1 --if-unchanged-since='2026-10-09T02:55:01.501Z'"
}
