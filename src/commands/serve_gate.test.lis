import "go:strings"

#[test]
fn scoped_board_token_opens_only_its_team() {
  let tok = scoped_board_token("board-secret", "AAA")
  assert team_scope(tok, "board-secret") == Some("AAA")
  // Another board's secret, a renamed key and the full token are not scopes.
  assert team_scope(tok, "other-secret") == None
  assert team_scope("BBB" + strings.TrimPrefix(tok, "AAA"), "board-secret") == None
  assert team_scope("board-secret", "board-secret") == None
  assert team_scope(tok, "") == None
}

fn route_kind(route: ScopedVerdict) -> string {
  match route {
    ScopedVerdict.Open => "open",
    ScopedVerdict.Hidden(_) => "hidden",
    ScopedVerdict.Closed(_) => "closed",
  }
}

#[test]
fn scoped_viewer_allowlist() {
  let link = ScopedViewer { teams: ["AAA"], member: None }
  let get = |path: string| route_kind(scoped_route("GET", path, "", "", "", link, false))
  for path in ["/t/AAA", "/t/AAA/", "/t/AAA/issues", "/t/AAA/projects", "/t/AAA/search",
               "/t/AAA/issue/AAA-3", "/t/AAA/issue/aaa-3", "/t/AAA/doc/index", "/t/aaa/", "/static/app.js",
               "/issue/AAA-3", "/issue/aaa-3"] {
    assert get(path) == "open"
  }
  // Another team, or another team's issue, answers like a missing one.
  for path in ["/t/BBB/", "/t/BBB", "/t/AAAB/", "/t/BBB/issue/BBB-1", "/t/BBB/settings/identity",
               "/t/AAA/issue/BBB-3", "/t/AAA/issue/AAAB-3", "/attachments/file",
               "/issue/BBB-1", "/issue/AAA-X-1"] {
    assert get(path) == "hidden"
  }
  for path in ["/", "/t/AAA/settings", "/t/AAA/settings/access", "/t/AAA/doc/", "/t/AAA/doc/a/b",
               "/issue/AAA-3/x", "/search", "/settings/access", "/issues"] {
    assert get(path) == "closed"
  }
  // The hidden answer is the missing team's own words, naming no other team.
  let hidden = match scoped_route("GET", "/t/BBB/", "", "", "", link, false) {
    ScopedVerdict.Hidden(m) => m,
    _ => "",
  }
  assert hidden == "no team with key 'BBB' on this server — see the rail's team switcher"
  // Read-only: no write is admitted, even on its own team.
  assert route_kind(scoped_route("POST", "/t/AAA/settings/label", "", "", "", link, false)) == "closed"
  assert route_kind(scoped_route("POST", "/state", "", "", "", link, false)) == "closed"
  // /events: only its own board or one of its own issues.
  let events = |page: string, issue: string, team: string| route_kind(scoped_route("GET", "/events", page, issue, team, link, false))
  assert events("", "", "AAA") == "open"
  assert events("issue", "AAA-1", "") == "open"
  assert events("", "", "") == "hidden"
  assert events("", "", "BBB") == "hidden"
  assert events("issue", "BBB-1", "AAA") == "hidden"
  // Hyphenated team keys: AAA-X-1 is team AAA-X's issue, not AAA's.
  assert get("/t/AAA/issue/AAA-X-1") == "hidden"
  assert events("issue", "AAA-X-1", "") == "hidden"
  assert get("/t/AAA/issue/AAA-") == "hidden"
  // Attachments download names its issue by key.
  assert route_kind(scoped_route("GET", "/attachments/file", "", "AAA-1", "", link, false)) == "open"
  assert route_kind(scoped_route("GET", "/attachments/file", "", "BBB-1", "", link, false)) == "hidden"
}

#[test]
fn login_redirect_stays_on_the_board() {
  assert local_path("/t/AAA/") == "/t/AAA/"
  assert local_path("/t/AAA/issue/AAA-1?order=priority") == "/t/AAA/issue/AAA-1?order=priority"
  for bad in ["", "//evil.example/", "https://evil.example/", "/\\evil.example", "t/AAA",
              "/\t/evil.example", "/\n/evil.example", "/\r/x", "/\u{7f}/x", "/\u{0}/x"] {
    assert local_path(bad) == "/"
  }
}

#[test]
fn member_viewer_writes_only_when_read_write() {
  let m = ViewerMember { id: "m1", name: "ann", token: "t", rw: true }
  let v = ScopedViewer { teams: ["AAA", "CCC"], member: Some(m) }
  for path in ["/create", "/state", "/title", "/comment", "/claim", "/release", "/attachments/upload"] {
    assert route_kind(scoped_route("POST", path, "", "", "", v, true)) == "open"
    assert route_kind(scoped_route("POST", path, "", "", "", v, false)) == "closed"
  }
  // Workspace-wide rows and settings stay closed even to a writer.
  for path in ["/favorite", "/views/save", "/settings/label", "/t/AAA/settings/label",
               "/settings/access/token", "/settings/access/member", "/settings/teams/archive"] {
    assert route_kind(scoped_route("POST", path, "", "", "", v, true)) == "closed"
  }
  // Two granted teams: both open, a third hidden.
  assert route_kind(scoped_route("GET", "/t/CCC/", "", "", "", v, true)) == "open"
  assert route_kind(scoped_route("GET", "/t/BBB/", "", "", "", v, true)) == "hidden"
  assert v.sees("ccc") && !v.sees("BBB") && v.sees_issue("CCC-2") && !v.sees_issue("BBB-2")
  // No teams sees nothing: empty never means every team.
  let none = ScopedViewer { teams: [], member: Some(m) }
  assert route_kind(scoped_route("GET", "/t/AAA/", "", "", "", none, true)) == "hidden"
  assert !none.sees("AAA")
}
