import "records"
import "claims"
import "go:fmt"
import "go:os"
import "go:regexp"
import "go:strconv"

import "display"
import "flags"
import "gitctx"
import "models"
import "pb"
import "writes"

// Who is working on an issue: start, claim and release, and the session
// label (--agent) they record.

/// `--branch` is opt-in (TASK-310). Fleet task 3b ran `start` from a checkout
/// that was not the work's and it switched that checkout's branch; agents whose
/// job is "record that I am on this" never wanted git touched. The state
/// change is the command; the branch and the work-site stamp are the extra.
fn issue_start_spec() -> Slice<flags.Flag> {
  flags.with_team([
    flags.Flag {
      name: "--branch",
      help: "also git switch -c key-number-slug in the current repo and\nrecord the work site (branch, host, path) on the issue",
      ..,
    },
    flags.Flag {
      name: "--agent",
      value: true,
      hint: "NAME",
      help: "self-asserted session label, on the comment a moved work site leaves\n(default: LLL_AGENT)",
      ..,
    },
    flags.Flag { name: "--json", help: "print the issue afterwards as JSON: the object 'lll issue list --json' prints per item", .. },
  ])
}

fn start(input: flags.CommandInput) -> Result<(), pb.CliError> {
  let ctx = input.ctx
  let usage = input.usage
  let p = input.parsed
  let agent = agent_label(ctx, p)?
  let with_branch = p.given("--branch")
  if with_branch && !gitctx.in_repo() {
    return Err(pb.failed("--branch needs a git repository: run it from inside the one the work happens in; issue state unchanged"))
  }
  let resolved = resolve_id(ctx, p.first(), usage)?
  let issue = records.fetch_issue(ctx, resolved)?
  let key = f"{issue.expand.team.key}-{issue.number}"
  let branch = gitctx.branch_name(issue.expand.team.key, issue.number, issue.title)

  // Git is a local prerequisite for the explicit combined operation. Do it
  // before the remote write so a refused switch cannot start the issue.
  if with_branch {
    let created = match gitctx.switch_branch(branch) {
      Ok(created) => created,
      Err(reason) => return Err(pb.failed(f"{reason}\nIssue {key} state unchanged; branch setup failed.")),
    }
    // Under --json stdout is the issue alone; the Git lines move to stderr.
    let out = if p.given("--json") { os.Stderr } else { os.Stdout }
    fmt.Fprintln(out, f"Branch: {branch}")
    if created {
      fmt.Fprintln(out, f"Created and switched to branch '{branch}'")
    } else {
      fmt.Fprintln(out, f"Switched to existing branch '{branch}'")
    }
  }
  let started = writes.update_issue(ctx, issue,
    writes.IssuePatch { state: Some("in-progress"), ..writes.IssuePatch.unchanged() },
    writes.UpdateOptions.as_caller(pb.Caller.Process),
  )
  if let Err(failure) = started {
    let reason = update_failure(key, failure, false)
    if with_branch {
      // A lost response does not prove the server rejected the write. Never
      // undo Git automatically: report the known local outcome and how to
      // inspect the remote state before retrying.
      return Err(reason.with_message(f"Git is on branch '{branch}', but starting {key} could not be confirmed: {reason.message}\nInspect with 'lll issue view {key}' before retrying."))
    }
    return Err(reason)
  }
  if !p.given("--json") { fmt.Println(f"Started {key}: {issue.title} (◐ in-progress)") }
  if with_branch {
    if let Err(reason) = record_work_site(ctx, issue, branch, agent) {
      return Err(reason.with_message(f"{key} is in-progress and Git is on '{branch}', but recording the work site could not be confirmed: {reason.message}\nInspect with 'lll issue view {key}' before retrying."))
    }
  }
  if p.given("--json") { return print_issue_after(ctx, key) }
  Ok(())
}

/// TASK-205: stamp the work-site slot (work_branch/work_host/work_path) onto
/// the issue when starting on an existing matching branch. The slot holds the CURRENT site only:
/// a start from a different site overwrites it and leaves an auto-comment
/// recording the displaced one, a same-site restart is silent, and nothing
/// ever clears the slot — a done issue keeps which branch shipped it, and
/// views render a stale site as "(last seen)" instead.
///
/// Host comes from os.Hostname; LLL_WORK_HOST overrides it (a test seam —
/// e2e fakes a second machine without owning one). Path is the worktree
/// root, so multiple worktrees of one branch on one host stay distinct.
fn record_work_site(ctx: pb.Client, issue: models.Issue, branch: string, agent: string) -> Result<(), pb.CliError> {
  let mut host = ctx.settings.env.work_host
  if host == "" { host = os.Hostname().unwrap_or("") }
  let Some(path) = gitctx.repo_root() else {
    return Ok(())
  }
  if issue.work_branch == branch && issue.work_host == host && issue.work_path == path {
    return Ok(())
  }
  if issue.work_branch != "" {
    // Author resolution mirrors `issue comment`: the token's member,
    // authorless for a superuser credential. Member identity is not duplicated
    // into the slot; this comment (and the claim holder) carry the who.
    let author = records.find_actor(ctx)?.map(|a| a.id)
    let moved = f"work moved: {issue.work_branch} @ {issue.work_host}:{issue.work_path} -> {branch} @ {host}:{path}"
    let _ = writes.create_comment(ctx, pb.Caller.Process, models.NewComment { issue: issue.id, author, agent, body: moved })?
  }
  writes.set_work_site(ctx, issue.id, writes.WorkSite { branch, host, path })
}

/// The session label for claims and comments (LLL-521): --agent, else
/// LLL_AGENT. Self-asserted; it separates agents sharing one member token and
/// proves nothing about who they are. The server renders it into comments, so
/// it is refused here, before any request, unless it has the server's shape:
/// at most 64 of A-Z, a-z, 0-9, '.', '_' and '-'; empty means no label.
fn agent_label(ctx: pb.Client, p: flags.Parsed) -> Result<string, pb.CliError> {
  let label = if p.given("--agent") { p.one("--agent") } else { ctx.settings.env.agent }
  if !regexp.MustCompile(r"^[A-Za-z0-9._-]{0,64}$").MatchString(label) {
    return Err(flags.usage_error(f"invalid agent label {strconv.Quote(label)} (from --agent or LLL_AGENT): use at most 64 characters from A-Z, a-z, 0-9, '.', '_' and '-'"))
  }
  Ok(label)
}

/// The fix for a claim someone else holds. Plain release works only for the
/// holder (LLL-512), so the hint asks them first and names --force for a hold
/// whose agent is gone. On `update --assignee` the caller may be the holder,
/// which is why the plain release is still named.
fn held_elsewhere_hint(key: string) -> string {
  f"the holder releases it with 'lll issue release {key}'; ask them, or if the hold is dead, 'lll issue release {key} --force --reason \"why\"' takes it and comments on the issue"
}

/// Resolve the actor and delegate acquisition to the shared claims client.
/// The server transaction acquires the exclusive hold and assigns its holder
/// together; the unique issue index also protects against duplicate hold rows.
/// Assignment edits use their own observed-claim transaction and cannot replace
/// another holder. See gopb/claims.go and gopb/assignment.go for that policy.
fn claim(input: flags.CommandInput) -> Result<(), pb.CliError> {
  let ctx = input.ctx
  let usage = "lll issue claim [KEY-123] [--renew]"
  let agent = agent_label(ctx, input.parsed)?
  let id = input.parsed.first()
  let resolved = resolve_id(ctx, id, usage)?
  let Some(member) = records.find_actor(ctx)? else {
    return Err(
      pb.failed("claiming needs a member token: 'lll login' as a person, or 'lll token create <member>' with admin credentials"),
    )
  }
  let issue = records.fetch_issue(ctx, resolved)?
  let key = f"{issue.expand.team.key}-{issue.number}"

  if input.parsed.given("--renew") {
    let Some(held) = claims.fetch(ctx, issue.id)? else {
      return Err(pb.fail(pb.ErrorKind.Refused, f"{key} is not claimed; 'lll issue claim {key}' takes it"))
    };
    let renewed = writes.renew_claim(ctx, issue.id, held.id, agent).map_err(|e| e.with_message(f"{key}: {e.message}"))?
    if input.parsed.given("--json") { return print_issue_after(ctx, key) }
    fmt.Println(f"Renewed {key} for {display.byline(renewed.member_name, renewed.agent)}; the expiry clock restarts now (held since {display.relative(renewed.created)})")
    return Ok(())
  }

  let result = writes.acquire_claim(ctx, pb.Caller.Process, issue.id, member.id, agent).map_err(|e| {
    if e.has_code(pb.ServerCode.ClaimHeld) {
      e.with_message(f"{key}: {e.message}; {held_elsewhere_hint(key)}")
    } else { e }
  })?
  if input.parsed.given("--json") { return print_issue_after(ctx, key) }
  if result.already_owned {
    fmt.Println(f"Claimed {key} for {display.byline(result.member_name, result.agent)} (already yours since {display.relative(result.created)})")
  } else {
    fmt.Println(f"Claimed {key} for {display.byline(result.member_name, result.agent)}")
  }
  Ok(())
}

/// The holder releases an observed hold; anyone else needs --force, and the
/// server records a forced release as a comment on the issue (LLL-512). The
/// server atomically removes that exact claim and clears only its assignment.
fn release(input: flags.CommandInput) -> Result<(), pb.CliError> {
  let ctx = input.ctx
  let usage = "lll issue release [KEY-123] [--force [--reason \"why\"]]"
  let p = input.parsed
  let agent = agent_label(ctx, p)?
  let resolved = resolve_id(ctx, p.first(), usage)?
  let force = p.given("--force")
  let reason = forced_reason(p, force, "a forced release")?
  let issue = records.fetch_issue(ctx, resolved)?
  let key = f"{issue.expand.team.key}-{issue.number}"
  let Some(held) = claims.fetch(ctx, issue.id)? else { return Err(pb.fail(pb.ErrorKind.Refused, f"{key} is not claimed")) };
  let by = writes.ClaimAs { caller: pb.Caller.Process, agent, force, reason }
  let result = writes.release_claim(ctx, issue.id, held.id, by).map_err(|e| {
    if e.has_code(pb.ServerCode.NeedsForce) {
      e.with_message(f"{key}: {e.message}; 'lll issue release {key} --force --reason \"why\"' takes it anyway and comments on the issue")
    } else { e }
  })?
  let assignment = if result.cleared_assignee { "cleared assignee" } else { "assignment unchanged" }
  let forced = if result.forced { "; forced, and commented on the issue" } else { "" }
  fmt.Println(f"Released {key} (was {result.member_name}'s); {assignment}{forced}")
  Ok(())
}

/// Compatibility name for command/page reads; storage ownership is in claims.
fn fetch_claim(ctx: pb.Client, issue_id: models.IssueId) -> Result<Option<models.Claim>, pb.CliError> {
  claims.fetch(ctx, issue_id)
}
