import "go:fmt"
import "go:os"
import "go:path/filepath"

import "config"
import "flags"

// `lll attach` — point a repo at a team, once, in a file the repo keeps.
//
// One instance, one team per repo. The repo says WHICH tracker (team, in a
// committed .lll.toml at its root); the machine says HOW to reach it (url,
// me, in ~/.config/lll/lll.toml). Because config layers rather than shadows,
// those two halves compose, and that is what makes the next clone — and every
// worktree — attached already, with nothing to run.

fn attach_spec() -> Slice<flags.Flag> {
  [
    flags.Flag {
      name: "-k",
      value: true,
      hint: "KEY",
      help: "team key to attach to (default: the server's team, if it has exactly one)",
      ..
    },
    flags.Flag { name: "--help", alias: "-h", hidden: true, help: "show this help", .. },
  ]
}

/// The flag table of the attach verb; read by `lll completions`.
pub fn attach_verb_spec(_verb: string) -> Slice<flags.Flag> {
  attach_spec()
}

pub fn attach(args: Slice<string>) -> Result<(), string> {
  let spec = attach_spec()
  let p = flags.parse(spec, args, 2, false, flags.usage("lll attach", spec, ""))?
  if p.given("--help") {
    print_attach_usage()
    return Ok(())
  }

  // The git root, not the working directory: attaching from src/commands must
  // write the same file as attaching from the top, or the walk that finds it
  // would look past what we just wrote. Outside a repo there is no such root,
  // and the cwd is the only defensible answer — so a plain directory attaches
  // too (TASK-212). Refusing it only pushed people to 'git init' a scratch dir
  // or hand-write the file the command exists to write.
  let (root, in_repo) = match config.git_root() {
    Some(r) => (r, true),
    None => {
      let Ok(cwd) = os.Getwd() else {
        return Err("no working directory to attach — could not read it")
      }
      (cwd, false)
    },
  }

  let name = filepath.Base(root)
  let given = p.one("-k")
  let key = if given != "" {
    clean_key(given)
  } else {
    // Ask the server before inventing anything. Bare `lll attach` reads as
    // "connect me to the tracker", and every usability run typed it against a
    // server that already had exactly one team — and got a brand-new team
    // named after their working directory, written to shared state, at exit
    // 0, with no delete command to undo it. The directory name is a fine
    // guess for the FIRST team on an empty server; it is a bad guess for any
    // other case, so it is now the fallback rather than the rule.
    derive_key_from_server(name)?
  }
  if key == "" {
    return Err(f"no team key in '{name}' to derive one from — pass it: lll attach -k KEY")
  }

  // Attaching to an archived team is refused, not silently revived: archive
  // is a deliberate lifecycle act, and unarchive is one command (TASK-210).
  // A server that is down still attaches — same bargain as the create below.
  if let Ok(Some(t)) = find_team(key) {
    if t.archived { return Err(archived_hint(key)) }
  }

  let path = filepath.Join(root, ".lll.toml")
  set_key_in(path, "team", key)?
  fmt.Println(f"team = \"{key}\" in {path}")
  fmt.Println(ensure_attached_team(key))
  // A plain directory has no clone to inherit the file; what it has instead is
  // its own subtree, so say that rather than tell someone to commit a file in
  // a directory git does not track.
  if in_repo {
    fmt.Println(
      "commit .lll.toml — every clone and worktree of this repo is attached from then on",
    )
  } else {
    fmt.Println(
      f"not a git repository — wrote {path}; every subdirectory of it inherits this team",
    )
  }
  Ok(())
}

/// The team key bare `lll attach` should use, asked of the server first.
/// One team is the answer; several is a choice only the operator can make;
/// none (or a server that cannot be reached) falls back to the directory
/// name, which is the empty-server bootstrap this command was written for.
fn derive_key_from_server(dir_name: string) -> Result<string, string> {
  let Ok(teams) = list_teams() else { return Ok(clean_key(dir_name)) }
  let live = teams.items.filter(|t| !t.archived)
  if live.length() == 1 {
    let key = live[0].key
    fmt.Println(f"the server has one team, {key} — attaching to it")
    return Ok(key)
  }
  if live.length() > 1 {
    let keys = live.map(|t| t.key).join(", ")
    return Err(
      f"the server has {live.length()} teams ({keys}) — say which: lll attach -k KEY",
    )
  }
  Ok(clean_key(dir_name))
}

/// Create the team unless the server already has it, and say which happened.
/// A server that is down is not a reason to fail: the committed file is the
/// point, and `lll up` creates a configured-but-missing team on its next boot.
fn ensure_attached_team(key: string) -> string {
  let Ok(found) = find_team(key) else {
    return f"could not reach PocketBase — 'lll up' will create team {key} on the next boot"
  }
  if found.is_some() { return f"team {key} already exists" }
  let Ok(created) = create_team(key, key) else {
    return f"could not create team {key} — 'lll up' will create it on the next boot"
  }
  f"created team {created.key} — issues will be {created.key}-1, {created.key}-2, ..."
}

fn print_attach_usage() {
  fmt.Println(
    "lll attach - point this directory at a team, once

Usage:
  lll attach [-k KEY]

Writes team = \"KEY\" to .lll.toml and creates the team on the server if it is
missing. Inside a git repository that file goes at the repo root; outside one
it goes in the working directory, and every subdirectory inherits it.

Without -k, the server decides: one team means that team, several means you
have to say which. Only when the server has no teams at all does the key come
from the directory name, reduced to letters and digits, uppercased, at most 5
characters -- the first team on a new server.

In a repo, commit that file. Config layers — the repo's .lll.toml supplies
'team', your ~/.config/lll/lll.toml supplies 'url' and 'me' — so on the next
machine an already-attached repo needs a 'git clone' and nothing else, and
every worktree of it is attached the moment it is created.

'lll config --list' shows every effective value and the file it came from.",
  )
}
