import "go:bytes"
import "go:html/template"
import "go:github.com/escherize/lll/web"
import "go:net/url"
import "go:strings"

import "display"
import "markdown"
import "models"
import "pb"
import "query"
import "theme"

// Rendering: the one template entry point, the SSE event wrappers, and the
// record -> view model mappers that every page and every broadcast shares.

/// Render a named template from the embedded web/templates/ tree.
fn render(name: string, data: Unknown) -> Result<string, string> {
  let tmpl = match template.ParseFS(web.Assets(), "templates/*.html") {
    Ok(t) => t,
    Err(e) => return Err(f"parsing web/templates: {e}"),
  }
  let mut buf = bytes.Buffer { .. }
  if let Err(e) = tmpl.ExecuteTemplate(&buf, name, data) {
    return Err(f"rendering {name}: {e}")
  }
  Ok(buf.String())
}

/// Wrap a rendered fragment as a datastar-patch-elements SSE event. Each
/// line of HTML becomes its own `data: elements` line; Datastar morphs the
/// fragment into the DOM by element id (default mode `outer`).
fn patch_event(html: string) -> string {
  let lines = html.split("\n").map(|l| f"data: elements {l}")
  f"event: datastar-patch-elements\n{strings.Join(lines, "\n")}\n\n"
}

/// Wrap a signal update as a datastar-patch-signals SSE event. `json_text` is
/// a JSON object; Datastar merges it into the page's signals.
fn signals_event(json_text: string) -> string {
  f"event: datastar-patch-signals\ndata: signals {json_text}\n\n"
}

/// "in-progress" -> "In progress".
fn state_label(state: string) -> string {
  let words = strings.ReplaceAll(state, "-", " ")
  strings.ToUpper(words.substring(0..1)) + words.substring(1..)
}

fn state_opts() -> Slice<StateOpt> {
  query.states().map(|s| StateOpt { value: s, label: state_label(s) })
}

/// Web-facing priority label: the web reads priority 0 as "No priority"
/// (CLI output keeps "none").
fn prio_label(name: string) -> string {
  if name == "none" { return "No priority" }
  state_label(name)
}

/// Priority <option>s in Linear order, slug values, web labels.
fn prio_opts() -> Slice<StateOpt> {
  display.priorities().map(|p| StateOpt { value: p, label: prio_label(p) })
}

/// The priority scale most-urgent-first, which is how the filter chooser lists
/// it: the Linear scale rotated, because "none" is the least urgent level and
/// belongs at the tail rather than at the head where its value 0 puts it.
fn prios_by_urgency() -> Slice<string> {
  let scale = display.priorities()
  scale[1..].append(scale[0])
}

/// Initials plus a stable per-name color class (av-0..av-3), so different
/// members scan differently on the board.
fn avatar_vm(name: string) -> AvatarVM {
  let words = strings.Fields(name)
  let first = words.map(|w| strings.ToUpper(w.substring(0..1)))
  let mut sum = 0
  for b in name.bytes() {
    sum += b as int
  }
  AvatarVM {
    initials: strings.Join(first[..min(2, first.length())], ""),
    class: f"av-{sum % 4}",
  }
}

fn label_vms(labels: Slice<models.Label>) -> Slice<LabelVM> {
  labels.map(|l| LabelVM { name: l.name, color: l.color })
}

fn card_vm(issue: models.Issue) -> CardVM {
  let prio = display.priority_name(issue.priority)
  CardVM {
    id: issue.id,
    key: f"{issue.expand.team.key}-{issue.number}",
    title: issue.title,
    state: issue.state,
    state_label: state_label(issue.state),
    prio,
    prio_label: prio_label(prio),
    assignee: issue.expand.assignee.name,
    avatar: avatar_vm(issue.expand.assignee.name),
    labels: label_vms(issue.expand.labels),
    emoji: issue.emoji,
    created: display.relative(issue.created),
    updated: display.relative(issue.updated),
    snippet: snippet(issue.description),
  }
}

/// Description -> hover-preview snippet: the first two non-empty lines
/// joined, capped at 160 chars with an ellipsis. The popover's CSS
/// line-clamp handles the visual "~2 lines"; this keeps payloads small.
fn snippet(desc: string) -> string {
  let lines = desc.split("\n").map(strings.TrimSpace).filter(|l| l != "")
  let text = strings.Join(lines[..min(2, lines.length())], " ")
  if text.length() > 160 { return text.substring(0..159) + "…" }
  text
}

/// The board's resolved filter: values the page handler already validated
/// against the catalogue. An empty dimension does not filter.
struct BoardFilter {
  states: Slice<string>,
  assignees: Slice<string>,
  labels: Slice<string>,
  prios: Slice<string>,
}

/// Does one issue pass the board's current filter? Every dimension ANDs;
/// an empty dimension lets everything through.
fn issue_matches(i: models.Issue, f: BoardFilter) -> bool {
  (f.states.is_empty() || f.states.contains(i.state))
    && (f.assignees.is_empty() || f.assignees.contains(i.expand.assignee.name))
    && (f.labels.is_empty() || issue_has_any_label(i, f.labels))
    && (f.prios.is_empty() || f.prios.contains(display.priority_name(i.priority)))
}

fn issue_has_any_label(i: models.Issue, names: Slice<string>) -> bool {
  i.expand.labels.any(|l| names.contains(l.name))
}

/// One chooser dimension: every value the workspace can name, each with the
/// count of board issues carrying it and the href of the same URL with that
/// value toggled — a navigation, because the URL is the whole filter state.
fn opt_group(
  dim: string,
  label: string,
  values: Slice<string>,
  issues: Slice<models.Issue>,
  q: ViewQuery,
  carries: fn(models.Issue, string) -> bool,
  show: fn(string) -> string,
) -> FilterGroupVM {
  let opts = values.map(|v| FilterOptVM {
    value: v,
    label: show(v),
    href: view_query_href("/", view_query_toggle(q, dim, v)),
    active: view_query_has(q, dim, v),
    count: issues.filter(|i| carries(i, v)).length(),
  })
  FilterGroupVM { dim, label, opts }
}

/// The filter chooser's contents: every value the workspace can name, not
/// just the ones PRESENT on the board. filter_groups used to be built from
/// the board alone, so a filter that matched nothing — the rail's "My
/// issues" with nobody assigned to you — hid every card while rendering no
/// chip to explain or undo itself (TASK-116, TASK-109). With the URL as the
/// source of truth the affordance has to exist wherever the URL can point,
/// so the catalogue comes from the workspace and the board only counts.
fn filter_groups(
  issues: Slice<models.Issue>,
  q: ViewQuery,
  members: Slice<string>,
  labels: Slice<string>,
) -> Slice<FilterGroupVM> {
  let mut assignees: Slice<string> = []
  assignees = assignees.append(members...)
  for a in csv(q.assignee) {
    if !assignees.contains(a) { assignees = assignees.append(a) }
  }
  let mut label_names: Slice<string> = []
  label_names = label_names.append(labels...)
  for l in csv(q.label) {
    if !label_names.contains(l) { label_names = label_names.append(l) }
  }
  let mut prios = prios_by_urgency()
  for p in csv(q.prio) {
    if !prios.contains(p) { prios = prios.append(p) }
  }
  let groups = [
    opt_group("assignee", "Assignee", assignees, issues, q,
      |i, v| i.expand.assignee.name == v, |v| v),
    opt_group("label", "Label", label_names, issues, q,
      |i, v| i.expand.labels.any(|l| l.name == v), |v| v),
    opt_group("prio", "Priority", prios, issues, q,
      |i, v| display.priority_name(i.priority) == v, prio_label),
    opt_group("state", "State", query.states(), issues, q,
      |i, v| i.state == v, state_label),
  ]
  groups.filter(|g| g.opts.length() > 0)
}

/// The six columns in workflow order. Each column renders only the cards
/// its state holds that the filter admits; `total` keeps the unfiltered
/// count, so the column's number is the same on a filtered page and inside
/// a broadcast morph instead of flickering between the two.
fn board_columns(issues: Slice<models.Issue>, flt: BoardFilter) -> Slice<ColumnVM> {
  query
    .states()
    .map(|s| ColumnVM {
      state: s,
      label: state_label(s),
      glyph: display.glyph(s),
      sig: strings.ReplaceAll(s, "-", "_") as template.JS,
      cards: issues.filter(|i| i.state == s && issue_matches(i, flt)).map(card_vm),
      total: issues.filter(|i| i.state == s).length(),
    })
}

/// A whole board, freshly fetched. The broadcast path's renderer, which
/// must stay UNFILTERED: /events sends one #board fragment to every
/// board-scoped client, so the per-URL filter is applied by the page
/// handler (and guarded client-side by the cards' data-show), never here.
fn board_vm(team_id: string, flt: BoardFilter) -> Result<BoardVM, string> {
  let issues = fetch_board_issues(team_id)?
  Ok(BoardVM { states: state_opts(), columns: board_columns(issues, flt), .. })
}

/// The create dialog's pickers, freshly fetched. Three extra PB reads, paid
/// once per board page load and never on a broadcast.
///
/// Labels and projects are the board's team's; members are everyone's
/// (TASK-173). The issue the dialog creates lands in that same team, so a
/// picker offering another team's label would build a record PocketBase is
/// happy to store and no view can explain.
fn compose_vm(team_id: string) -> Result<ComposeVM, string> {
  let members = fetch_members()?
  let projects = fetch_projects(team_id)?
  let labels = fetch_labels(team_id)?
  Ok(ComposeVM {
    prios: prio_opts(),
    members: members.map(|m| PickVM { id: m.id, name: m.name }),
    projects: projects.map(|p| PickVM { id: p.id, name: p.name }),
    labels: labels.map(|l| LabelPickVM {
      id: l.id,
      name: l.name,
      color: theme.normalize_hex(l.color),
      on: false,
    }),
  })
}

fn fetch_board_issues(team_id: string) -> Result<Slice<models.Issue>, string> {
  let mut path = "/api/collections/issues/records?perPage=200&expand=team,assignee,labels&sort=sort,created"
  let filter = query.filter(team_id, "", "", "", "", "")
  if filter != "" { path = f"{path}&filter={url.QueryEscape(filter)}" }
  let mut issues = models.IssueList { .. }
  pb.fetch(path, "issues", &issues)?
  Ok(issues.items)
}

fn comment_vm(c: models.Comment) -> CommentVM {
  let mut author = c.expand.author.name
  if author == "" { author = "anon" }
  CommentVM {
    id: c.id,
    author,
    avatar: avatar_vm(author),
    age: display.relative(c.created),
    body: markdown.md_html(c.body),
    body_md: c.body,
  }
}

/// Issue view model from a full record (expand: team, assignee, labels,
/// project) — shared by the issue page and broadcast re-renders.
fn issue_vm(issue: models.Issue, comments: Slice<models.Comment>) -> Result<IssueVM, string> {
  let assignee = issue.expand.assignee.name
  let mut project = issue.expand.project.name
  let mut project_href = ""
  if project != "" {
    project_href = f"/issues?project={url.QueryEscape(project)}"
  }
  if project == "" { project = "none" }
  Ok(IssueVM {
    deleted: false,
    id: issue.id,
    key: f"{issue.expand.team.key}-{issue.number}",
    title: issue.title,
    state: issue.state,
    prio: display.priority_name(issue.priority),
    assignee,
    avatar: avatar_vm(assignee),
    project,
    project_href,
    labels: label_vms(issue.expand.labels),
    emoji: issue.emoji,
    description: markdown.md_html(issue.description),
    description_md: issue.description,
    created: display.relative(issue.created),
    updated: display.relative(issue.updated),
    states: state_opts(),
    prios: prio_opts(),
    // The three editor catalogues. Small fetches, paid per render — the
    // selects live inside the #issue-detail morph boundary, so a broadcast
    // that shipped no options would wipe the controls mid-edit.
    project_id: issue.project,
    assignee_id: issue.assignee,
    // Scoped to the ISSUE's team, not the server's configured one: this
    // renders for whatever issue arrives, including one from a team the
    // board is not scoped to (TASK-173).
    member_opts: fetch_members()?.map(|m| PickVM { id: m.id, name: m.name }),
    project_opts: fetch_projects(issue.team)?.map(|p| PickVM { id: p.id, name: p.name }),
    label_opts: fetch_labels(issue.team)?.map(|l| LabelPickVM {
      id: l.id,
      name: l.name,
      color: theme.normalize_hex(l.color),
      on: issue.labels.contains(l.id),
    }),
    comments: comments.map(comment_vm),
    // Left empty on purpose: the RELATED FINDINGS block is page-only (set by
    // issue_page), like the star and the emoji catalogue below — the section
    // sits outside the #issue-detail morph boundary, so broadcasts never
    // re-render it.
    findings: [],
    // Left false here on purpose: only issue_page knows, and only it renders
    // the star. Broadcasts of #issue-detail must not carry a stale answer.
    favorited: false,
    // Left empty for the same reason: the picker is page-only, so a
    // broadcast of this fragment carries no catalogue.
    emojis: [],
  })
}

/// A finding doc -> its issue-page block (TASK-103).
fn finding_vm(d: models.Doc) -> FindingVM {
  FindingVM { slug: d.slug, title: d.title, area: d.area }
}
