import "go:encoding/json"
import "go:net/url"

import "pb"
import "query"

struct MemberReferences {
  assigned: int,
  authored: int,
}

/// Both deletion surfaces count assignments and authorship under the identity
/// that will perform the deletion, including references outside the current team.
fn member_references(id: string, token: string) -> Result<MemberReferences, string> {
  Ok(MemberReferences {
    assigned: member_reference_count("issues", "assignee", id, token)?,
    authored: member_reference_count("comments", "author", id, token)?,
  })
}

#[json]
struct MemberReferenceCount {
  #[json("totalItems")]
  total: Option<int>,
}

/// All reads and the deletion use the same administrative identity, so a
/// missing or stale configured member token cannot hide references.
fn member_reference_count(collection: string, field: string, id: string, token: string) -> Result<int, string> {
  let filter = url.QueryEscape(f"{field}={query.quote(id)}")
  let body = pb.get_as(f"/api/collections/{collection}/records?filter={filter}&perPage=1&fields=id", token)?
  let mut count = MemberReferenceCount { .. }
  if let Err(e) = json.Unmarshal(body.bytes(), &count) {
    return Err(f"counting member {collection}: {e}")
  }
  let Some(total) = count.total else { return Err(f"counting member {collection}: response omitted totalItems") };
  if total < 0 { return Err(f"counting member {collection}: invalid totalItems") }
  Ok(total)
}

