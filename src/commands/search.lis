import "display"
import "go:encoding/json"
import "go:net/url"
import "go:strconv"
import "go:strings"
import "go:path/filepath"
import "go:os"

import "config"
import "flags"
import "models"
import "output"
import "pb"
import "query"
import "search"
import "records"

/// `lll search TEXT`: full-text search over the team's record - issue
/// titles and descriptions, comments, and docs - ranked, each hit with the
/// lines around the match (LLL-96). `lll issue list --search` stays the
/// cheap title filter; this is the one that finds a word buried in a
/// comment from last month.
pub fn search_cmd(ctx: pb.Client, args: Slice<string>) -> Result<output.Output, pb.CliError> {
  let spec = search_spec()
  let usage = flags.usage("lll search", spec, "TEXT...")
  let p = flags.parse_n(spec, args, 2, 64, usage)?
  let mut words: Slice<string> = []
  for i in 0..p.positional_count() {
    words = words.append(p.nth(i))
  }
  let q = strings.TrimSpace(strings.Join(words, " "))
  if q == "" { return Err(flags.usage_error(f"what to search for?\nusage: {usage}")) }
  let mut limit = 10
  if p.given("--limit") {
    let Ok(n) = strconv.Atoi(p.one("--limit")) else {
      return Err(flags.usage_error(f"--limit takes a number, got '{p.one("--limit")}'"))
    }
    limit = n
  }
  let only_issues = p.given("--issues")
  let only_docs = p.given("--docs")
  let team = current_team(ctx)?
  let corpus = cached_corpus(ctx, team.id, team.key, p.given("--refresh"), !only_docs, !only_issues)?
  let hits = search.rank(corpus, q, limit)
  if p.given("--json") { return list_json(hits, whole_list(hits.length()), "hits") }
  if hits.is_empty() { return Ok(empty_list(f"match for '{q}' in {team.key}'s issues, comments or docs")) }
  Ok(hits_output(hits))
}

pub fn search_spec() -> Slice<flags.Flag> {
  flags.with_team([
    flags.Flag { name: "--limit", alias: "-l", value: true, hint: "N", help: "at most N results (default 10)", .. },
    flags.Flag { name: "--issues", help: "issues and their comments only", .. },
    flags.Flag { name: "--docs", help: "docs only (wiki, findings, decisions)", .. },
    flags.Flag { name: "--json", help: "the ranked hits as JSON: group, kind, title, state, score, snippets", .. },
    flags.Flag { name: "--refresh", help: "drop the local corpus cache and fetch everything again", .. },
  ])
}

/// The same issues with only the fields the ranker reads: the CLI has no
/// card to draw, and the expansions were most of the bytes on the wire.
fn fetch_team_issues_light(ctx: pb.Client, team_id: models.TeamId, where: string) -> Result<Slice<models.Issue>, pb.CliError> {
  let mut clause = query.filter(query.IssueFilter.over(query.TeamScope.Only(team_id)))
  if where != "" { clause = f"{clause} && {where}" }
  let filter = url.QueryEscape(clause)
  let mut out: Slice<models.Issue> = []
  let mut page = 1
  loop {
    let mut list = models.IssueList { .. }
    pb.fetch(ctx, f"/api/collections/issues/records?perPage=500&page={page}&sort=number&fields=id,number,title,description,state,updated&filter={filter}", "issues", &list)?
    out = out.append(list.items...)
    if list.items.length() < 500 { break }
    page += 1
  }
  Ok(out)
}

/// One hit: the record on its own line, then each matched passage under
/// its source, the matching line marked '>' like grep -B1 -A1.
fn hits_output(hits: Slice<search.Hit>) -> output.Output {
  let mut out = output.none()
  for h in hits {
    let state = if h.state == "" { "" } else { f"  {h.state}" }
    let kind = if h.kind == "doc" { "doc " } else { "" }
    out = out.line(f"{kind}{h.group}{state}  {display.table_cell(h.title)}")
    for s in h.snippets {
      out = out.line(f"    [{s.label}]")
      for l in s.lines { out = out.line(f"    {l}") }
    }
    out = out.line("")
  }
  out
}

// --- the local corpus cache ----------------------------------------------
//
// The hosted board serialises a megabyte of bodies per full fetch and takes
// 5 to 20 seconds to do it; the ranker needs 70 milliseconds. So the corpus
// lives in ~/.cache/lll/, keyed by server and team, and a query fetches only
// what changed: three small id listings (to drop deletions) and three
// filtered fetches of records updated since the last sync (usually none).
// The first query, or --refresh, pays the full fetch once.

#[json]
struct Cache {
  synced: string,
  issues: Slice<models.Issue>,
  comments: Slice<models.Comment>,
  docs: Slice<models.Doc>,
}

fn cache_path(ctx: pb.Client, team_id: models.TeamId) -> Result<string, pb.CliError> {
  let cfg = ctx.settings.config().map_err(pb.failed)?
  let home = ctx.settings.env.home
  if home == "" { return Err(pb.failed("no home directory for the search cache")) }
  let dir = filepath.Join(home, ".cache", "lll")
  if let Err(e) = os.MkdirAll(dir, 0o755) { return Err(pb.failed(f"creating {dir}: {e}")) }
  let host = strings.NewReplacer("https://", "", "http://", "", "/", "_", ":", "_").Replace(cfg.url)
  Ok(filepath.Join(dir, f"search-{host}-{team_id}.json"))
}

fn load_cache(path: string) -> Cache {
  let Ok(data) = os.ReadFile(path) else { return Cache { .. } }
  let mut c = Cache { .. }
  if json.Unmarshal(data, &c).is_err() { return Cache { .. } }
  c
}

fn save_cache(path: string, c: Cache) -> Result<(), pb.CliError> {
  let body = match json.Marshal(c) {
    Ok(b) => b,
    Err(e) => return Err(pb.failed(f"encoding the search cache: {e}")),
  }
  if let Err(e) = os.WriteFile(path, body, 0o600) { return Err(pb.failed(f"writing {path}: {e}")) }
  Ok(())
}

/// Documents for the team from the cache, refreshed first.
fn cached_corpus(ctx: pb.Client, team_id: models.TeamId, team_key: string, refresh: bool, issues: bool, docs: bool) -> Result<Slice<search.Document>, pb.CliError> {
  let path = cache_path(ctx, team_id)?
  let mut c = if refresh { Cache { .. } } else { load_cache(path) }
  c = sync_cache(ctx, c, team_id)?
  save_cache(path, c)?
  let mut out: Slice<search.Document> = []
  if issues { out = out.append(search.issue_documents(team_key, c.issues, c.comments)...) }
  if docs {
    for d in c.docs {
      out = out.append(search.Document { group: d.slug, kind: "doc", label: d.kind, title: d.title, body: d.body, state: "" })
    }
  }
  Ok(out)
}

/// Bring a cache up to date. Empty cache: full fetch. Otherwise the three
/// id listings and the three "updated since" fetches run at once; records
/// whose id is gone are dropped, changed and new ones replace their old
/// selves, and `synced` moves to the newest `updated` seen.
fn sync_cache(ctx: pb.Client, c: Cache, team_id: models.TeamId) -> Result<Cache, pb.CliError> {
  if c.synced == "" {
    let issues_ch = Channel.new<Result<Slice<models.Issue>, pb.CliError>>()
    let comments_ch = Channel.new<Result<Slice<models.Comment>, pb.CliError>>()
    let docs_ch = Channel.new<Result<Slice<models.Doc>, pb.CliError>>()
    task { let _ = issues_ch.send(fetch_team_issues_light(ctx, team_id, "")) }
    task { let _ = comments_ch.send(records.fetch_team_comments_where(ctx, team_id, "")) }
    task { let _ = docs_ch.send(records.fetch_team_docs_light(ctx, team_id, "")) }
    let Some(issues) = issues_ch.receive() else { return Err(pb.failed("issue fetch ended without an answer")) }
    let Some(comments) = comments_ch.receive() else { return Err(pb.failed("comment fetch ended without an answer")) }
    let Some(docs) = docs_ch.receive() else { return Err(pb.failed("doc fetch ended without an answer")) }
    let full = Cache { synced: "1970-01-01 00:00:00.000Z", issues: issues?, comments: comments?, docs: docs? }
    return Ok(Cache { synced: newest(full), issues: full.issues, comments: full.comments, docs: full.docs })
  }
  // Probe first: the newest `updated` and the count per collection are one
  // tiny request each. A collection whose newest is not newer than the mark
  // AND whose count matches has not moved, and costs nothing more.
  //
  // The two halves cover each other, which is why this is not the lie it
  // looks like (LLL-401). A delete alone changes the count. A delete paired
  // with a create keeps the count, but the create stamps `updated` with now,
  // so `newest > synced` fires and the id sweep below drops the deleted
  // record. Verified against a live board: after deleting one doc and
  // creating another in the same window, the deleted doc's text stops
  // matching and the new doc's starts, with no --refresh.
  //
  // It would take a create whose `updated` is NOT newer than the mark to slip
  // past both, which the server does not produce.
  let pi = Channel.new<Result<Probe, pb.CliError>>()
  let pc = Channel.new<Result<Probe, pb.CliError>>()
  let pd = Channel.new<Result<Probe, pb.CliError>>()
  task { let _ = pi.send(probe(ctx, "issues", f"team={query.quote(team_id.string())}")) }
  task { let _ = pc.send(probe(ctx, "comments", f"issue.team={query.quote(team_id.string())}")) }
  task { let _ = pd.send(probe(ctx, "docs", f"team={query.quote(team_id.string())}")) }
  let Some(ri) = pi.receive() else { return Err(pb.failed("probe ended without an answer")) }
  let Some(rc) = pc.receive() else { return Err(pb.failed("probe ended without an answer")) }
  let Some(rd) = pd.receive() else { return Err(pb.failed("probe ended without an answer")) }
  let prob_i = ri?
  let prob_c = rc?
  let prob_d = rd?
  let moved_i = prob_i.newest > c.synced || prob_i.total != c.issues.length()
  let moved_c = prob_c.newest > c.synced || prob_c.total != c.comments.length()
  let moved_d = prob_d.newest > c.synced || prob_d.total != c.docs.length()
  if !moved_i && !moved_c && !moved_d { return Ok(c) }

  let since = f"updated > {query.quote(c.synced)}"
  let mut issues = c.issues
  let mut comments = c.comments
  let mut docs = c.docs
  if moved_i {
    let keep = as_set(fetch_ids(ctx, "issues", f"team={query.quote(team_id.string())}")?)
    let changed = fetch_team_issues_light(ctx, team_id, since)?
    let mut seen = Map.new<models.IssueId, bool>()
    let mut next: Slice<models.Issue> = []
    for i in changed { seen[i.id] = true; next = next.append(i) }
    for i in c.issues { if keep.get(i.id.string()).is_some() && seen.get(i.id).is_none() { next = next.append(i) } }
    issues = next
  }
  if moved_c {
    let keep = as_set(fetch_ids(ctx, "comments", f"issue.team={query.quote(team_id.string())}")?)
    let changed = records.fetch_team_comments_where(ctx, team_id, since)?
    let mut seen = Map.new<string, bool>()
    let mut next: Slice<models.Comment> = []
    for x in changed { seen[x.id] = true; next = next.append(x) }
    for x in c.comments { if keep.get(x.id).is_some() && seen.get(x.id).is_none() { next = next.append(x) } }
    comments = next
  }
  if moved_d {
    let keep = as_set(fetch_ids(ctx, "docs", f"team={query.quote(team_id.string())}")?)
    let changed = records.fetch_team_docs_light(ctx, team_id, since)?
    let mut seen = Map.new<string, bool>()
    let mut next: Slice<models.Doc> = []
    for x in changed { seen[x.id] = true; next = next.append(x) }
    for x in c.docs { if keep.get(x.id).is_some() && seen.get(x.id).is_none() { next = next.append(x) } }
    docs = next
  }
  let merged = Cache { synced: c.synced, issues, comments, docs }
  Ok(Cache { synced: newest(merged), issues: merged.issues, comments: merged.comments, docs: merged.docs })
}

/// A collection's newest `updated` and its count, from one request.
struct Probe {
  newest: string,
  total: int,
}

#[json]
struct ProbeList {
  items: Slice<ProbeItem>,
  #[json("totalItems")]
  total_items: int,
}

#[json]
struct ProbeItem {
  updated: string,
}

fn probe(ctx: pb.Client, collection: string, where: string) -> Result<Probe, pb.CliError> {
  let filter = url.QueryEscape(where)
  let mut list = ProbeList { .. }
  pb.fetch(ctx, f"/api/collections/{collection}/records?perPage=1&sort=-updated&fields=updated&filter={filter}", collection, &list)?
  let newest = if list.items.is_empty() { "" } else { list.items[0].updated }
  Ok(Probe { newest, total: list.total_items })
}

fn as_set(ids: Slice<string>) -> Map<string, bool> {
  let mut m = Map.new<string, bool>()
  for id in ids { m[id] = true }
  m
}

/// The newest `updated` across the cache, or the old mark when nothing is
/// newer. PocketBase timestamps sort as strings.
fn newest(c: Cache) -> string {
  let mut best = c.synced
  for i in c.issues { if i.updated > best { best = i.updated } }
  for x in c.comments { if x.updated > best { best = x.updated } }
  for x in c.docs { if x.updated > best { best = x.updated } }
  best
}

#[json]
struct IdList {
  items: Slice<IdOnly>,
}

#[json]
struct IdOnly {
  id: string,
}

/// Every record id of a collection matching `where`: a few kilobytes even
/// for a big team, which is what makes the delta sync cheap.
fn fetch_ids(ctx: pb.Client, collection: string, where: string) -> Result<Slice<string>, pb.CliError> {
  let filter = url.QueryEscape(where)
  let mut out: Slice<string> = []
  let mut page = 1
  loop {
    let mut list = IdList { .. }
    pb.fetch(ctx, f"/api/collections/{collection}/records?perPage=500&page={page}&fields=id&filter={filter}", collection, &list)?
    for x in list.items { out = out.append(x.id) }
    if list.items.length() < 500 { break }
    page += 1
  }
  Ok(out)
}
