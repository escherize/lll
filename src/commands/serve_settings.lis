import "go:crypto/rand"
import "go:html/template"
import "go:net/http"
import "go:net/url"
import "go:os"
import "go:strings"

import "models"
import "pb"
import "query"
import "theme"

// /settings - the workspace records the web can edit, and the one handler
// that writes them.

/// The workspace's shared settings: labels, members, projects, and the team's
/// name and accent colour.
fn settings_page(
  w: http.ResponseWriter,
  // The page takes no parameters: everything on it is the workspace's, and
  // there is nothing here to scope by query string.
  r: Ref<http.Request>,
  team_id: string,
  me: string,
) {
  let team = shell_team(team_id)
  let vm = match settings_vm(team) {
    Ok(v) => v,
    Err(e) => {
      http.Error(w, e, 500)
      return
    },
  }
  if wants_raw(r) {
    write_raw(w, settings_raw(vm))
    return
  }
  let page = PageVM { rail: rail_vm("settings", me, team), page: vm }
  let html = match render("settings-page", page) {
    Ok(h) => h,
    Err(e) => {
      http.Error(w, e, 500)
      return
    },
  }
  w.Header().Set("Cache-Control", "no-store")
  w.Header().Set("Content-Type", "text/html; charset=utf-8")
  let _ = w.Write(html.bytes())
}

fn settings_vm(team: models.Team) -> Result<SettingsVM, string> {
  let hex = theme.normalize_hex(team.accent)
  let mut accent = hex
  if accent == "" { accent = "#f0883e" }
  // Members stay unscoped on purpose: one person or agent works across many
  // projects, which is what makes a member meaningful on every board.
  let labels = fetch_labels(team.id)?
  let members = fetch_members()?
  let projects = fetch_projects(team.id)?
  Ok(
    SettingsVM {
      team_key: team.key,
      team_name: team.name,
      accent,
      accent_set: hex != "",
      labels: labels.map(|l| SetLabelVM {
        id: l.id,
        name: l.name,
        color: theme.normalize_hex(l.color),
        scope: scope_label(l.expand.team.key),
      }),
      members: members.map(|m| SetMemberVM {
        id: m.id,
        name: m.name,
        email: m.email,
      }),
      projects: projects.map(|p| SetProjectVM {
        id: p.id,
        name: p.name,
        status: p.status,
        scope: scope_label(p.expand.team.key),
      }),
      statuses: project_statuses().map(|s| StateOpt {
        value: s,
        label: state_label(s),
      }),
    },
  )
}

/// A record's owning team key, or the word for "owned by no team".
fn scope_label(key: string) -> string {
  if key == "" { return "workspace" }
  key
}

/// One team's labels. Labels belong to exactly one team (TASK-173), so
/// every chooser, chip list and validator built on this is scoped by
/// construction. An empty `team_id` is the unscoped board, which has no team
/// to scope to.
fn fetch_labels(team_id: string) -> Result<Slice<models.Label>, string> {
  let mut list = models.LabelList { .. }
  pb.fetch(
    f"/api/collections/labels/records?perPage=200&sort=name&expand=team&filter={team_param(team_id)}",
    "labels",
    &list,
  )?
  Ok(list.items)
}

/// A `team=<id>` filter for a records URL, URL-escaped, or "" for every
/// team. Built through query.filter so the id is escaped once, in one place.
fn team_param(team_id: string) -> string {
  url.QueryEscape(query.filter(team_id, "", "", "", "", ""))
}

fn fetch_members() -> Result<Slice<models.Member>, string> {
  let mut list = models.MemberList { .. }
  pb.fetch(
    "/api/collections/members/records?perPage=200&sort=name",
    "members",
    &list,
  )?
  Ok(list.items)
}

/// One team's projects, scoped for the same reason labels are.
fn fetch_projects(team_id: string) -> Result<Slice<models.Project>, string> {
  let mut list = models.ProjectList { .. }
  pb.fetch(
    f"/api/collections/projects/records?perPage=200&sort=name&expand=team&filter={team_param(team_id)}",
    "projects",
    &list,
  )?
  Ok(list.items)
}

/// Patch bodies. Each carries exactly the fields the page edits and no
/// others: PocketBase replaces every field it is handed, so a struct wide
/// enough to include, say, a project description would blank descriptions the
/// page never showed.
#[json]
struct TeamPatch { name: string, accent: string }

// Labels and projects carry their team: it is required (TASK-173), and PB
// replaces every field a patch hands it, so an update that omitted the team
// would blank it. The page only ever lists this team's rows, so the value is
// the same one going out as came in.
#[json]
struct LabelPatch { name: string, color: string, team: string }

/// The create payload members needs now that the collection is an auth one
/// (TASK-180): email identity, password pair, visibility. The update patch
/// stays name+email — a password change is an admin operation, not a
/// settings row.
#[json]
struct MemberCreate {
  name: string,
  email: string,
  password: string,
  #[json("passwordConfirm")]
  password_confirm: string,
  #[json("emailVisibility")]
  email_visibility: bool,
}

#[json]
struct MemberPatch { name: string }

#[json]
struct ProjectPatch { name: string, status: string, team: string }

/// One write for every settings section: `kind` picks the section, an `id`
/// picks update over create, and `?del=1` picks removal.
///
/// The reply is the action's own SSE body — /settings opens no /events
/// connection at all. The bridge broadcasts one unfiltered #board to every
/// board-scoped client, so a settings page on that scope would have to defend
/// against fragments meant for a different view; answering in the response
/// needs no defence, and the page has no realtime story to get wrong.
///
/// The redrawn page rides back as `flashing`'s extra SSE, after the cleared
/// flash. A fragment that fails to render is dropped rather than failed on:
/// the record is already written, and a flash saying otherwise would be a
/// lie about the database.
fn settings_write(
  r: mut Ref<http.Request>,
  team_id: string,
  me: string,
) -> Result<string, string> {
  settings_apply(r, team_id)?
  let team = shell_team(team_id)
  let mut extra = ""
  if let Ok(vm) = settings_vm(team) {
    if let Ok(html) = render("settings", vm) { extra += patch_event(html) }
  }
  // The accent lives in <head>, outside #settings: patch it by id too, so a
  // new colour lands on the open page instead of waiting for a reload.
  if let Ok(html) = render("accent-head", rail_vm("settings", me, team)) {
    extra += patch_event(html)
  }
  Ok(extra)
}

/// The record this request names: created, updated, or deleted.
fn settings_apply(
  r: mut Ref<http.Request>,
  team_id: string,
) -> Result<(), string> {
  let kind = r.PathValue("kind")
  let id = strings.TrimSpace(r.PostFormValue("id"))
  let name = strings.TrimSpace(r.PostFormValue("name"))

  // FormValue, not PostFormValue: delete travels as a query param so the row
  // form can post its own body unchanged.
  if r.FormValue("del") != "" {
    let coll = settings_collection(kind)?
    if id == "" { return Err("nothing to delete") }
    let _ = pb.delete(f"/api/collections/{coll}/records/{id}")?
    return Ok(())
  }

  // Labels and projects are team-owned too, so every section below the
  // delete needs the same configured team the team section does.
  if team_id == "" {
    return Err("no team configured: set LLL_TEAM or 'team' in .lll.toml")
  }

  match kind {
    "team" => {
      if name == "" { return Err("team name is required") }
      let accent = form_hex(r, "accent")?
      let payload = marshal(TeamPatch { name, accent })?
      let _ = pb.patch(f"/api/collections/teams/records/{team_id}", payload)?
      Ok(())
    },
    "label" => {
      if name == "" { return Err("label name is required") }
      let color = form_hex(r, "color")?
      save_record("labels", id, LabelPatch { name, color, team: team_id })
    },
    "member" => {
      if name == "" { return Err("member name is required") }
      let email = strings.TrimSpace(r.PostFormValue("email"))
      if id == "" {
        // members is an auth collection (TASK-180): a create needs an email
        // identity and a password. The synthesized identity and the random
        // never-shown password are the same bargain the CLI's member add
        // runs; nobody can log in as one until a password is set.
        let member_email = if email == "" {
          synthesize_email(name)
        } else {
          email
        }
        // One value for both password fields: two rand.Text() calls would
        // disagree with each other and fail PB's confirm check.
        let password = rand.Text()
        save_record(
          "members",
          id,
          MemberCreate {
            name,
            email: member_email,
            password,
            password_confirm: password,
            email_visibility: true,
          },
        )?
        return Ok(())
      }
      let known = fetch_members()?
      let Some(existing) = known.find(|m| m.id == id) else {
        return Err(
          f"unknown member '{id}' — reload the page for the current list",
        )
      }
      // Email is the member's login identity now (TASK-180): PocketBase
      // refuses an email change on an auth record without its password, so
      // the settings row edits the name and says so when the email moved.
      let posted_email = strings.TrimSpace(email)
      if posted_email != "" && posted_email != existing.email {
        return Err(
          f"'{existing.name}'s email is their login identity now — edit it in the auth flow, not here (name saved)",
        )
      }
      save_record("members", id, MemberPatch { name })
    },
    "project" => {
      if name == "" { return Err("project name is required") }
      let status = r.PostFormValue("status")
      if project_statuses().find(|s| s == status).is_none() {
        return Err(f"unknown project status '{status}'")
      }
      save_record("projects", id, ProjectPatch { name, status, team: team_id })
    },
    other => Err(f"unknown settings section '{other}'"),
  }
}

/// A "#rrggbb" form field: "" clears the colour, anything unparseable is a
/// user error rather than a silent fallback — a typed hex that quietly did
/// nothing would be the worst of both.
fn form_hex(r: mut Ref<http.Request>, field: string) -> Result<string, string> {
  let raw = strings.TrimSpace(r.PostFormValue(field))
  if raw == "" { return Ok("") }
  let hex = theme.normalize_hex(raw)
  if hex == "" { return Err(f"'{raw}' is not a #rrggbb colour") }
  // The canonical orange is stored as "no choice", so a team that picks it
  // back gets theme.css's exact tokens instead of a derived copy of them.
  if field == "accent" && hex == "#f0883e" { return Ok("") }
  Ok(hex)
}

/// Sections whose rows can be deleted. The team is not one: it owns every
/// issue's key, and `lll team` has no delete either.
fn settings_collection(kind: string) -> Result<string, string> {
  match kind {
    "label" => Ok("labels"),
    "member" => Ok("members"),
    "project" => Ok("projects"),
    other => Err(f"cannot delete from '{other}'"),
  }
}

/// Create (no id) or update (id) one record.
fn save_record(coll: string, id: string, value: Unknown) -> Result<(), string> {
  let payload = marshal(value)?
  if id == "" {
    let _ = pb.post(f"/api/collections/{coll}/records", payload)?
  } else {
    let _ = pb.patch(f"/api/collections/{coll}/records/{id}", payload)?
  }
  Ok(())
}

// ── Access (TASK-204) ────────────────────────────────────────────────────
// The settings page is reachable with the board token alone, but minting an
// agent token and credentialing a member are superuser-power actions — the
// server's own PocketBase identity rides the superuser token, so answering
// these on the board token would promote every board-token holder to admin.
// DECISION (per-action re-auth): each Access form carries the admin password,
// verified server-side through PocketBase's own _superusers auth-with-password
// endpoint per request; the token that auth answers with is what rides the
// write, and the password itself is never stored. A separate admin session
// was the alternative — rejected because a session is a second credential
// store to build, expire and steal, while re-auth adds one form field and
// leaves nothing behind.

/// The one-shown-once token, as the mint action's response patch.
pub struct AccessTokenVM {
  pub name: string,
  pub token: string,
}

/// PATCH body for credentialing a member: the login identity and the
/// password pair, nothing else — PB replaces every field it is handed.
#[json]
struct MemberCredentialPatch {
  email: string,
  password: string,
  #[json("passwordConfirm")]
  password_confirm: string,
}

/// The superuser identity Access actions verify against: LLL_ADMIN_EMAIL, or
/// the same printed default `lll up` upserts when the env is unset.
fn admin_email() -> string {
  let e = os.Getenv("LLL_ADMIN_EMAIL")
  if e == "" { "admin@local.dev" } else { e }
}

/// Verify the form's admin password against the superuser and return the
/// superuser token that verification minted — the credential the action's
/// own write rides, so board token + admin password suffices no matter what
/// identity the process holds. The password is checked per action through
/// PocketBase's own endpoint and never stored.
fn verify_admin(pass: string) -> Result<string, string> {
  if pass == "" {
    return Err(
      "the admin password is required: this is a superuser action, and the board token alone must not grant it",
    )
  }
  let payload = marshal(models.AuthRequest { identity: admin_email(), password: pass })?
  let body = match pb.post_anon(
    "/api/collections/_superusers/auth-with-password",
    payload,
  ) {
    Ok(b) => b,
    Err(e) => {
      // PocketBase answers a bad credential pair with 400.
      if strings.Contains(e, "400") {
        return Err(
          "wrong admin password — the superuser credentials are what 'lll up' prints in its banner",
        )
      }
      return Err(f"verifying the admin password: {e}")
    },
  }
  decode_auth(body, "the superuser auth response")
}

/// The named member, from the current list — so the flash can say "reload"
/// instead of relaying a PB 404.
fn access_member(r: mut Ref<http.Request>) -> Result<models.Member, string> {
  let id = strings.TrimSpace(r.PostFormValue("member"))
  if id == "" { return Err("pick a member") }
  let known = fetch_members()?
  let Some(member) = known.find(|m| m.id == id) else {
    return Err(f"unknown member '{id}' — reload the page for the current list")
  }
  Ok(member)
}

/// Mint an agent token for a member — the web face of `lll token create`.
/// The token rides back in the response patch and is shown exactly once:
/// impersonate tokens are stateless (nothing records a mint), so no list of
/// minted tokens exists to show, here or anywhere.
fn access_token_write(r: mut Ref<http.Request>) -> Result<string, string> {
  let member = access_member(r)?
  let su = verify_admin(r.PostFormValue("admin_password"))?
  let payload = marshal(models.ImpersonateRequest { duration: 0 })?
  let body = pb.post_as(
    f"/api/collections/members/impersonate/{member.id}",
    payload,
    su,
  )?
  let tok = decode_auth(body, "the impersonate response")?
  let html = render(
    "access-token-result",
    AccessTokenVM { name: member.name, token: tok },
  )?
  Ok(patch_event(html))
}

/// Give a member a login credential (email + password) — the admin
/// counterpart of the CLI's honor-system member row. The email is the login
/// identity, so this is the one place the web may change it: the write rides
/// the just-verified superuser token, which is exactly the authority the
/// settings row's rename lacks.
fn access_credential_write(
  r: mut Ref<http.Request>,
  team_id: string,
) -> Result<string, string> {
  let member = access_member(r)?
  let password = r.PostFormValue("password")
  if password == "" { return Err("a password is required") }
  if password != r.PostFormValue("password_confirm") {
    return Err("the two passwords do not match")
  }
  let su = verify_admin(r.PostFormValue("admin_password"))?
  // A blank email keeps the member's current identity (often the
  // synthesized @members.invalid one) and just sets the password.
  let mut email = strings.TrimSpace(r.PostFormValue("email"))
  if email == "" { email = member.email }
  let payload = marshal(
    MemberCredentialPatch { email, password, password_confirm: password },
  )?
  let _ = pb.patch_as(
    f"/api/collections/members/records/{member.id}",
    payload,
    su,
  )?
  // The page shows the member's email, so patch the section back — and say
  // the success out loud in the flash strip, after the redraw, so the morph
  // cannot swallow it.
  let mut extra = ""
  if let Ok(vm) = settings_vm(shell_team(team_id)) {
    if let Ok(html) = render("settings", vm) { extra += patch_event(html) }
  }
  extra += flash_ok_event(f"{member.name} can now sign in as {email}")
  Ok(extra)
}

/// A green flash: the same strip errors use, patched with a success tone.
/// Rides AFTER flashing's flash_clear in the response body, so the strip
/// ends up showing the message.
fn flash_ok_event(msg: string) -> string {
  let safe = template.HTMLEscapeString(msg)
  patch_event(f"<div id=\"flash\" class=\"flash flash-ok\">{safe}</div>")
}
