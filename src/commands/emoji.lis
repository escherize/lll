// The emoji catalogue behind the issue page's picker.
//
// Curated, not complete. A full Unicode emoji set is ~1900 entries plus a
// name index — megabytes once it is markup — and task-75 is already an open
// complaint that 2.5MB of vendored mermaid bloats the binary. The picker is
// searchable by name, so coverage past "the marker someone would actually
// choose for an issue" buys nothing: this list leads with the vocabulary an
// issue tracker uses (bug, fire, rocket, wrench, checkered flag) and then
// covers the usual faces, hands, animals, food and objects.
//
// `terms` is the search index: lowercase words, matched as a substring by the
// picker's client-side filter, so "fire" finds the flame and "urgent" finds it
// too. Keep terms lowercase — the filter lowercases the query, not the data.

/// One candidate in the picker: the glyph itself and the words that find it.
pub struct EmojiOpt {
  pub glyph: string,
  pub terms: string,
}

/// The picker's candidates, in the order they are shown: work vocabulary
/// first, then status marks, faces, hands, nature, food, objects.
pub fn emoji_catalog() -> Slice<EmojiOpt> {
  [
    EmojiOpt { glyph: "🐛", terms: "bug insect beetle broken" },
    EmojiOpt { glyph: "🔥", terms: "fire hot urgent burning" },
    EmojiOpt { glyph: "🚀", terms: "rocket ship launch release" },
    EmojiOpt { glyph: "⚡", terms: "zap lightning fast bolt" },
