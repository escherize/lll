import "records"
import "go:encoding/json"
import "go:fmt"
import "go:net/url"

import "flags"
import "models"
import "pb"
import "query"
import "writes"
import "display"

// Links from an issue: linked docs (link, unlink) and blockers (block,
// unblock).

/// Docs linked to an issue. The issue -> doc direction is not stored: it is
/// one `?=` filter over docs.issues, which is the whole reason links are a
/// relation and not a write-once reference on the issue.
fn fetch_issue_docs(ctx: pb.Client, issue_id: models.IssueId) -> Result<Slice<models.Doc>, pb.CliError> {
  records.fetch_docs(ctx, f"issues.id ?= {query.quote(issue_id.string())}", "slug", "")
}

/// Refuse a link whose two ends live in different teams (TASK-173). The doc
/// is looked up in the CONFIGURED team, the issue is whatever KEY-123 names,
/// so `LLL_TEAM=LLL lll issue link GRDN-4 index` would otherwise quietly
/// stitch the two boards' link graphs together.
fn cross_team_link(
  issue: models.Issue,
  team: models.Team,
  d: models.Doc,
) -> Result<(), pb.CliError> {
  if d.team == issue.team { return Ok(()) }
  let key = f"{issue.expand.team.key}-{issue.number}"
  Err(
    pb.failed(f"{key} is in {issue.expand.team.key} and doc '{d.slug}' is in {team.key}; a link stays inside one team"),
  )
}

fn link(input: flags.CommandInput) -> Result<(), pb.CliError> {
  let ctx = input.ctx
  let usage = "lll issue link KEY-123 SLUG"
  let id = input.parsed.first()
  let slug = input.parsed.nth(1)
  if id == "" || slug == "" { return Err(flags.usage_error(f"usage: {usage}")) }
  link_issue(ctx, input.parsed, id, slug, usage)
}

/// The write path behind 'lll issue link KEY-123 SLUG'. The relation is
/// stored once on docs.issues. 'lll doc link' was removed at 1.0 (D5).
fn link_issue(ctx: pb.Client, p: flags.Parsed, id: string, slug: string, usage: string) -> Result<(), pb.CliError> {
  let resolved = resolve_id(ctx, id, usage)?
  let issue = records.fetch_issue(ctx, resolved)?
  let key = f"{issue.expand.team.key}-{issue.number}"
  let team = issue_link_team(ctx, issue)?
  let d = records.fetch_doc(ctx, team, slug)?
  cross_team_link(issue, team, d)?

  if d.issues.find(|x| x == issue.id).is_some() {
    return doc_done(ctx, p, d.id, f"{key} is already linked to {d.slug}")
  }
  writes.link_doc_issue(ctx, d.id, issue.id)?
  doc_done(ctx, p, d.id, f"Linked {key} -> {d.slug}")
}

fn unlink(input: flags.CommandInput) -> Result<(), pb.CliError> {
  let ctx = input.ctx
  let usage = "lll issue unlink KEY-123 SLUG"
  let id = input.parsed.first()
  let slug = input.parsed.nth(1)
  if id == "" || slug == "" { return Err(flags.usage_error(f"usage: {usage}")) }
  unlink_issue(ctx, input.parsed, id, slug, usage)
}

/// The write path behind 'lll issue unlink KEY-123 SLUG'.
fn unlink_issue(ctx: pb.Client, p: flags.Parsed, id: string, slug: string, usage: string) -> Result<(), pb.CliError> {
  let resolved = resolve_id(ctx, id, usage)?
  let issue = records.fetch_issue(ctx, resolved)?
  let key = f"{issue.expand.team.key}-{issue.number}"
  let team = issue_link_team(ctx, issue)?
  let d = records.fetch_doc(ctx, team, slug)?
  cross_team_link(issue, team, d)?

  if d.issues.find(|x| x == issue.id).is_none() {
    return Err(pb.failed(f"{key} is not linked to {d.slug}; see 'lll doc view {d.slug}'"))
  }
  writes.unlink_doc_issue(ctx, d.id, issue.id)?
  doc_done(ctx, p, d.id, f"Unlinked {key} from {d.slug}")
}

/// An explicit issue identifies its document namespace outside an attached
/// directory. Configured scope remains authoritative, including a mismatch.
fn issue_link_team(ctx: pb.Client, issue: models.Issue) -> Result<models.Team, pb.CliError> {
  Ok(records.configured_team(ctx)?.unwrap_or(issue.expand.team))
}

/// `lll issue block KEY BLOCKER`: KEY cannot start until BLOCKER is done.
/// Refuses a self-block and a cycle (BLOCKER already waits on KEY, at any
/// depth), since a cycle would make both un-ready forever. The dependency
/// lives on the blocked issue: one relation field, no second collection.
fn block(input: flags.CommandInput) -> Result<(), pb.CliError> {
  let ctx = input.ctx
  let usage = "lll issue block KEY-123 BLOCKER"
  let id = input.parsed.first()
  let blocker_id = input.parsed.nth(1)
  if id == "" || blocker_id == "" { return Err(flags.usage_error(f"usage: {usage}")) }
  let issue = records.fetch_issue(ctx, resolve_id(ctx, id, usage)?)?
  let blocker = records.fetch_issue(ctx, resolve_id(ctx, blocker_id, usage)?)?
  let key = f"{issue.expand.team.key}-{issue.number}"
  let bkey = f"{blocker.expand.team.key}-{blocker.number}"
  if issue.id == blocker.id { return Err(pb.failed(f"{key} cannot block itself")) }
  if issue.blocked_by.find(|x| x == blocker.id).is_some() {
    return issue_done(ctx, input.parsed, key, f"{key} is already blocked by {bkey}")
  }
  let cyclic = depends_on(ctx, blocker, issue.id, 0)?
  if cyclic {
    return Err(pb.failed(f"{bkey} already waits on {key} (directly or through others); blocking {key} by {bkey} would be a cycle"))
  }
  writes.set_blocked_by(ctx, issue.id, issue.blocked_by.append(blocker.id))?
  let mut note = ""
  if blocker.state().map_or(false, |s| s.is_terminal()) { note = f" ({bkey} is already {display.state_name(blocker.state())}, so this does not hold {key} back)" }
  issue_done(ctx, input.parsed, key, f"{key} is blocked by {bkey}{note}")
}

fn unblock(input: flags.CommandInput) -> Result<(), pb.CliError> {
  let ctx = input.ctx
  let usage = "lll issue unblock KEY-123 BLOCKER"
  let id = input.parsed.first()
  let blocker_id = input.parsed.nth(1)
  if id == "" || blocker_id == "" { return Err(flags.usage_error(f"usage: {usage}")) }
  let issue = records.fetch_issue(ctx, resolve_id(ctx, id, usage)?)?
  let blocker = records.fetch_issue(ctx, resolve_id(ctx, blocker_id, usage)?)?
  let key = f"{issue.expand.team.key}-{issue.number}"
  let bkey = f"{blocker.expand.team.key}-{blocker.number}"
  let mut remaining: Slice<models.IssueId> = []
  let mut found = false
  for x in issue.blocked_by {
    if x == blocker.id { found = true } else { remaining = remaining.append(x) }
  }
  if !found {
    return issue_done(ctx, input.parsed, key, f"{key} was not blocked by {bkey}")
  }
  writes.set_blocked_by(ctx, issue.id, remaining)?
  issue_done(ctx, input.parsed, key, f"{key} is no longer blocked by {bkey}")
}

/// True when `issue` waits on `target` at any depth. Bounded at eight
/// levels: deeper chains are not a thing a tracker should have.
fn depends_on(ctx: pb.Client, issue: models.Issue, target: models.IssueId, depth: int) -> Result<bool, pb.CliError> {
  if depth > 8 { return Ok(false) }
  for b in issue.expand.blocked_by {
    if b.id == target { return Ok(true) }
    let full = fetch_issue_by_id(ctx, b.id)?
    let deeper = depends_on(ctx, full, target, depth + 1)?
    if deeper { return Ok(true) }
  }
  Ok(false)
}

fn fetch_issue_by_id(ctx: pb.Client, id: models.IssueId) -> Result<models.Issue, pb.CliError> {
  let body = ctx.get(f"/api/collections/issues/records/{id}?expand=team,blocked_by")?
  let mut full = models.Issue { .. }
  if let Err(e) = json.Unmarshal(body.bytes(), &full) {
    return Err(pb.failed(f"decoding issue: {e}"))
  }
  Ok(full)
}

/// Issues that name `issue` as a blocker, for the "Blocks:" line.
fn fetch_blocks(ctx: pb.Client, issue_id: models.IssueId) -> Result<Slice<models.Issue>, pb.CliError> {
  let filter = url.QueryEscape(f"blocked_by.id ?= {query.quote(issue_id.string())}")
  let mut list = models.IssueList { .. }
  pb.fetch(ctx, f"/api/collections/issues/records?perPage=200&sort=number&expand=team&filter={filter}", "issues", &list)?
  Ok(list.items)
}
