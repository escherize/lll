import "models"
import "mirror"

fn parent_front(key: string, parent: string) -> (mirror.Front, string) {
  (mirror.Front { key, parent, .. }, "")
}

#[test]
fn mirror_parents_validate_forward_links_and_reject_corrupt_graphs_before_writes() {
  let assert Ok(true) = validate_mirror_parents([parent_front("ENG-1", "ENG-9"), parent_front("ENG-9", "")])
  let assert Ok(false) = validate_mirror_parents([parent_front("ENG-1", "")])
  assert validate_mirror_parents([parent_front("ENG-1", "missing")]).is_err()
  assert validate_mirror_parents([parent_front("ENG-1", "ENG-1")]).is_err()
  assert validate_mirror_parents([parent_front("ENG-1", "ENG-2"), parent_front("ENG-2", "ENG-1")]).is_err()
  assert validate_mirror_parents([parent_front("ENG-1", ""), parent_front("ENG-1", "")]).is_err()
}

#[test]
fn mirror_parents_do_not_impose_a_depth_limit_or_use_recursive_calls() {
  let mut parsed = [parent_front("ENG-0", "")]
  for n in 1..5000 { parsed = parsed.append(parent_front(f"ENG-{n}", f"ENG-{n - 1}")) }
  let assert Ok(true) = validate_mirror_parents(parsed)
}

#[test]
fn repo_shape_requires_owner_and_repo() {
  assert repo_shape_ok("octocat/Hello-World")
  assert !repo_shape_ok("Hello-World")
  assert !repo_shape_ok("octocat/Hello-World/extra")
  assert !repo_shape_ok("/Hello-World")
  assert !repo_shape_ok("octocat/")
  assert !repo_shape_ok("")
}

#[test]
fn imports_run_in_ascending_gh_number_order() {
  let issues = [
    GithubIssue { number: 30, title: "newest", body: "", state: "OPEN", labels: [] },
    GithubIssue { number: 10, title: "oldest", body: "", state: "OPEN", labels: [] },
    GithubIssue { number: 20, title: "middle", body: "", state: "CLOSED", labels: [] },
  ]
  let sorted = sort_by_number(issues)
  assert sorted[0].number == 10
  assert sorted[1].number == 20
  assert sorted[2].number == 30
  assert sort_by_number([]).length() == 0
  let one = [GithubIssue { number: 5, title: "only", body: "", state: "OPEN", labels: [] }]
  assert sort_by_number(one)[0].number == 5
}

#[test]
fn gh_states_map_toward_work_remaining() {
  assert imported_state("OPEN") == models.IssueState.Todo
  assert imported_state("CLOSED") == models.IssueState.Done
  assert imported_state("") == models.IssueState.Todo
  assert imported_state("UNEXPECTED") == models.IssueState.Todo
}

#[test]
fn gh_label_colors_gain_the_hash_only_when_present() {
  assert gh_color("d73a4a") == "#d73a4a"
  assert gh_color("") == ""
}

#[test]
fn labels_collect_once_per_name_in_first_seen_order() {
  let issues = [
    GithubIssue {
      number: 1,
      title: "a",
      body: "",
      state: "OPEN",
      labels: [
        GithubLabel { name: "bug", color: "d73a4a" },
        GithubLabel { name: "web", color: "5e6ad2" },
      ],
    },
    GithubIssue {
      number: 2,
      title: "b",
      body: "",
      state: "OPEN",
      labels: [
        GithubLabel { name: "bug", color: "d73a4a" },
        GithubLabel { name: "", color: "" },
      ],
    },
  ]
  let (names, colors) = collect_labels(issues)
  assert names.equals(["bug", "web"])
  assert colors.get("bug").unwrap_or("") == "d73a4a"
  assert colors.get("web").unwrap_or("") == "5e6ad2"
  assert colors.get("").is_none()
}
