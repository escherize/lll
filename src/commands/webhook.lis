import "records"
import "go:bufio"
import "go:crypto/rand"
import "go:encoding/json"
import "go:net/url"
import "go:os"
import "go:strings"

import "models"
import "output"
import "pb"
import "flags"
import "query"
import "secret"
import "writes"

fn webhook_intro() -> string {
  "The server POSTs one JSON object per issue create/update/delete to every
registered URL whose scope matches, shaped like an `lll watch --json` event
({\"topic\":\"issues\",\"action\":...,\"record\":{...}}). A registration's
secret rides every delivery as the X-LLL-Secret header, so a receiver can tell
the server from anyone who found the URL. The secret is write-only: 'add'
prints a generated one once, or takes yours with --secret, and nothing shows
it again; 'list' says only whether one is set. A registration cannot be
edited; remove it and add it again.

A registration delivers only while the member who added it can still read
its team: remove that member from the team and its deliveries stop, with a
'webhook: skipped' line in the server's log. Registrations added before lll
recorded creators, or by a superuser, have no creator and deliver while their
team exists.

A failed delivery is retried with backoff (three attempts, 1s then 4s
apart), and every failed attempt is printed to the server's log with a
'webhook:' prefix, the last one final. Deliveries are not queued: one still
waiting to be sent or retried when the server stops is lost."
}

pub fn webhook_commands() -> Slice<flags.Command> {
  [
    flags.Command {
      name: "add",
      access: flags.Access.Write,
      summary: "register a URL that receives this team's issue events, or one project's with --project",
      spec: webhook_add_spec(),
      positional: "URL",
      run: webhook_add,
      ..
    },
    flags.Command {
      name: "list",
      access: flags.Access.Read,
      summary: "list this team's registrations: scope, URL, whether a secret is set",
      spec: webhook_list_spec(),
      run: webhook_list,
      ..
    },
    flags.Command {
      name: "remove",
      access: flags.Access.Write,
      summary: "delete a registration by its URL; --project picks between the same URL at both scopes",
      spec: webhook_remove_spec(),
      positional: "URL",
      run: webhook_remove,
      ..
    },
  ]
}

fn webhook_add_spec() -> Slice<flags.Flag> {
  flags.with_team([
    flags.Flag { name: "--project", value: true, hint: "NAME", help: "scope deliveries to one project instead of the whole team", .. },
    flags.Flag { name: "--secret", value: true, stdin: true, hint: "SECRET", help: "sent on every delivery as the X-LLL-Secret header ('-' reads it from stdin;\ndefault: generated and printed once)", .. },
  ])
}

fn webhook_list_spec() -> Slice<flags.Flag> {
  flags.with_team([flags.Flag { name: "--json", help: "print the raw record list as JSON", .. }])
}

fn webhook_remove_spec() -> Slice<flags.Flag> {
  flags.with_team([
    flags.Flag { name: "--project", value: true, hint: "NAME", help: "remove the project-scoped registration of this URL", .. },
  ])
}

fn webhook_add(input: flags.CommandInput) -> Result<output.Output, pb.CliError> {
  let ctx = input.ctx
  let p = input.parsed
  let raw = p.first()
  let target = validate_target(raw)?
  let team = team_flag_or_current(ctx, p.one("--team"))?

  let mut project_id = None
  let mut scope = f"team {team.key}"
  if p.given("--project") {
    let proj = records.resolve_project(ctx, team.id, p.one("--project"))?
    project_id = Some(proj.id)
    scope = f"project {proj.name}"
  }
  // The server never returns the secret (LLL-661), so one the caller did
  // not choose is generated here and printed once, below.
  let chosen = if p.given("--secret") {
    let mut input = bufio.NewReader(os.Stdin)
    Some(secret.Secret.read(p, "--secret", "Webhook secret: ", input)?)
  } else {
    None
  }

  // One registration per scope and URL: a duplicate would double every
  // delivery, which reads downstream as a server bug rather than a mistake.
  let mut existing = models.WebhookList { .. }
  pb.fetch(ctx, 
    f"/api/collections/webhooks/records?filter={url.QueryEscape(dup_filter(team.id, project_id, target))}",
    "webhooks",
    &existing,
  )?
  if existing.items.length() > 0 {
    return Err(pb.failed(f"webhook {target} is already registered for {scope}; remove it first: 'lll webhook remove {target}'"))
  }

  let value = match chosen {
    Some(s) => s.reveal(),
    None => rand.Text(),
  }
  let body = writes.create_webhook(ctx, models.NewWebhook { team: team.id, project: project_id, url: target, secret: value })?
  let mut created = models.Webhook { .. }
  if let Err(e) = json.Unmarshal(body.bytes(), &created) {
    return Err(pb.failed(f"decoding created webhook: {e}"))
  }
  let mut out = output.none()
  // The generated case is checked first: a server older than LLL-661
  // returns no secret_set, and the generated secret must still be shown once.
  if chosen.is_none() {
    out = out.line(f"Registered webhook {target} ({scope}); deliveries carry X-LLL-Secret: {value}")
    out = out.line("Save this secret now: lll will not show it again.")
  } else if chosen.map_or(false, |s| s.is_empty()) {
    out = out.line(f"Registered webhook {target} ({scope})")
  } else {
    out = out.line(f"Registered webhook {target} ({scope}); deliveries carry X-LLL-Secret")
  }
  Ok(out)
}

fn webhook_list(input: flags.CommandInput) -> Result<output.Output, pb.CliError> {
  let ctx = input.ctx
  let p = input.parsed
  let team = team_flag_or_current(ctx, p.one("--team"))?
  // Every page (LLL-659): one page of 200 silently dropped the rest.
  let hooks = models.WebhookList {
    items: records.fetch_all_records<models.Webhook>(ctx,
      f"/api/collections/webhooks/records?sort=-created,id&expand=team,project&filter={url.QueryEscape(f"team={query.quote(team.id.string())}")}",
      "webhooks",
    )?,
    ..
  }
  if p.given("--json") { return list_json(hooks.items, whole_list(hooks.items.length()), "webhook list") }
  if hooks.items.is_empty() { return Ok(empty_list("webhooks")) }
  let mut out = output.none()
  for h in hooks.items {
    out = out.line(f"{scope_label(h)}\t{h.url}\t{secret_state(h.secret_set)}")
  }
  Ok(out)
}

fn webhook_remove(input: flags.CommandInput) -> Result<output.Output, pb.CliError> {
  let ctx = input.ctx
  let usage = input.usage
  let p = input.parsed
  let raw = p.first()
  let target = validate_target(raw)?
  let team = team_flag_or_current(ctx, p.one("--team"))?

  let mut project_id = None
  let mut scope = f"team {team.key}"
  if p.given("--project") {
    let proj = records.resolve_project(ctx, team.id, p.one("--project"))?
    project_id = Some(proj.id)
    scope = f"project {proj.name}"
  }

  let mut matches = models.WebhookList { .. }
  pb.fetch(ctx, 
    f"/api/collections/webhooks/records?filter={url.QueryEscape(dup_filter(team.id, project_id, target))}",
    "webhooks",
    &matches,
  )?
  if matches.items.is_empty() {
    return Err(pb.fail(pb.ErrorKind.NotFound, f"no webhook {target} registered for {scope}; see 'lll webhook list'"))
  }
  if matches.items.length() > 1 {
    let mut ids: Slice<string> = []
    for h in matches.items { ids = ids.append(h.id) }
    return Err(pb.failed(f"webhook {target} is registered more than once; pass --project, or remove by id: one of {strings.Join(ids, ", ")}\nusage: {usage}"))
  }
  let victim = matches.items[0]
  writes.delete_webhook(ctx, victim.id)?
  Ok(output.line(f"Removed webhook {target} ({scope})"))
}

/// The filter naming one registration exactly: team, URL, and project when
/// the caller scoped it. Both halves go through query.quote (TASK-134).
fn dup_filter(team_id: models.TeamId, project_id: Option<models.ProjectId>, target: string) -> string {
  let mut filter = query.scoped(team_id, "url", target)
  if let Some(project) = project_id {
    filter += f" && project={query.quote(project.string())}"
  }
  filter
}

/// An http(s) URL with a host, or the reason it is not one. Deliberately
/// stricter than url.Parse, which happily accepts "not a url" as a path.
fn validate_target(raw: string) -> Result<string, pb.CliError> {
  if strings.TrimSpace(raw) == "" {
    return Err(flags.usage_error("a webhook needs a target URL: 'lll webhook add URL'"))
  }
  let Ok(parsed) = url.Parse(raw) else {
    return Err(flags.usage_error(f"'{raw}' is not a URL; webhook targets are http(s) URLs"))
  }
  if (parsed.Scheme != "http" && parsed.Scheme != "https") || parsed.Host == "" {
    return Err(flags.usage_error(f"'{raw}' is not an http(s) URL with a host; webhook targets are http(s) URLs"))
  }
  Ok(raw)
}

/// The scope column of `lll webhook list`: the project when narrowed, else
/// the team key from the expansion.
fn scope_label(h: models.Webhook) -> string {
  if h.expand.project.name != "" { return f"project {h.expand.project.name}" }
  if h.expand.team.key != "" { return f"team {h.expand.team.key}" }
  "team ?"
}

/// A registration's secret is shown as set or not, never as its value: the
/// server returns only whether one is set (LLL-661).
fn secret_state(secret_set: bool) -> string {
  if secret_set { "secret set" } else { "secret not set" }
}
