import "go:os"
import "go:path/filepath"
import "config"
import "pb"

// LLL-441 review: the home config is replaced by rename, and a rename onto a
// symlink replaces the link. A dotfile-managed (stow, chezmoi) config must
// keep its link, and the link's target must receive the new contents.
#[test]
fn writing_a_symlinked_home_config_writes_through_the_link() {
  let assert Ok(dir) = os.MkdirTemp("", "lll-config-link")
  defer { let _ = os.RemoveAll(dir) }
  let target = filepath.Join(dir, "dotfiles-lll.toml")
  let link = filepath.Join(dir, "lll.toml")
  let assert Ok(_) = os.WriteFile(target, "token = \"old\"\n".bytes(), 0o600)
  let assert Ok(_) = os.Symlink(target, link)

  let assert Ok(_) = write_home_config(link, "token = \"new\"\n")

  let assert Ok(info) = os.Lstat(link)
  assert info.Mode() & os.ModeSymlink != 0
  let assert Ok(data) = os.ReadFile(target)
  assert data as string == "token = \"new\"\n"
}

#[test]
fn writing_a_missing_home_config_creates_it() {
  let assert Ok(dir) = os.MkdirTemp("", "lll-config-new")
  defer { let _ = os.RemoveAll(dir) }
  let path = filepath.Join(dir, "lll.toml")
  let assert Ok(_) = write_home_config(path, "url = \"u\"\n")
  let assert Ok(data) = os.ReadFile(path)
  assert data as string == "url = \"u\"\n"
}

/// A client whose url and token came from `source`, reading no file.
fn sourced(source: Option<config.Source>) -> pb.Client {
  pb.Client.new(config.given(
    config.Config { url: "http://h", token: "t", .. },
    config.Sources { url: source, token: source, .. },
    config.Env { home: "/h", .. },
  ))
}

// LLL-687: only a token from a repo file is in a repo's history, one row per
// source.
#[test]
fn only_a_repo_files_token_is_warned_about() {
  let rows: Slice<(Option<config.Source>, Option<string>)> = [
    (Some(config.Source.Flag("--token")), None),
    (Some(config.Source.Env("LLL_TOKEN")), None),
    (
      Some(config.Source.RepoFile(".lll.toml")),
      Some("warning: the token comes from .lll.toml, which is committed - move it to /h/.config/lll/lll.toml (or LLL_TOKEN) and mint a fresh one, since this one is in the repo's history"),
    ),
    (Some(config.Source.HomeFile("/h/.config/lll/lll.toml")), None),
    (Some(config.Source.Default), None),
    (None, None),
  ]
  for (source, warning) in rows {
    assert committed_token_warning(sourced(source), source) == warning
  }
}

// LLL-687: a refused superuser login names where the url was chosen, one row
// per source.
#[test]
fn a_refused_superuser_login_names_where_the_url_came_from() {
  let refused = pb.CliError { kind: pb.ErrorKind.Auth, status: 400, code: None, message: "Failed to authenticate." }
  let chosen = "authenticating as the superuser: Failed to authenticate.\nif the administrator credentials are right, check the server: "
  let rows: Slice<(Option<config.Source>, string)> = [
    (Some(config.Source.Flag("--url")), chosen + "--url names another one"),
    (Some(config.Source.Env("LLL_URL")), chosen + "LLL_URL names another one"),
    (Some(config.Source.RepoFile(".lll.toml")), chosen + ".lll.toml names another one"),
    (Some(config.Source.HomeFile("/h/.config/lll/lll.toml")), chosen + "/h/.config/lll/lll.toml names another one"),
    (
      Some(config.Source.Default),
      "authenticating as the superuser: Failed to authenticate.\nthat url is the built-in default: nothing here configured one, so the credentials\nwere almost certainly sent to the wrong server. Name it: --url <your server url>",
    ),
    (None, chosen + "--url names another one"),
  ]
  for (source, message) in rows {
    assert superuser_auth_failed(sourced(source), refused).message == message
  }
}
