import "go:encoding/json"
import "go:fmt"
import "go:net/url"
import "go:strings"

import "models"
import "pb"
import "flags"
import "query"

/// Dispatch `lll project <verb>`.
pub fn project(args: Slice<string>) -> Result<(), string> {
  let Some(verb) = args.get(2) else {
    project_usage()
    return Ok(())
  }
  match verb {
    "list" => project_list(args),
    "create" => project_create(args),
    "view" => project_view(args),
    "--help" => {
      project_usage()
      Ok(())
    },
    "-h" => {
      project_usage()
      Ok(())
    },
    other => Err(
      f"unknown project command: '{other}' (see 'lll project --help')",
    ),
  }
}

/// Project statuses, in lifecycle order.
fn project_statuses() -> Slice<string> {
  ["planned", "started", "paused", "completed", "cancelled"]
}

fn project_usage() {
  fmt.Println(
    "lll project - work with projects

Usage:
  lll project list                    list projects (name, status, team); this
                                      team's, or every team's when none is
                                      configured
  lll project view NAME               show a project and its issues
  lll project create -n \"name\" [-d desc] [--status s] [--team KEY]
                                      create a project (status defaults to
                                      planned; --team defaults to LLL_TEAM)

Statuses: planned, started, paused, completed, cancelled",
  )
}

fn project_list(args: Slice<string>) -> Result<(), string> {
  let p = flags.parse(project_list_spec(), args, 3, false, "")?
  // Scoped when a team is configured, every team's when not: a project
  // belongs to one team (TASK-173), so the unscoped list is an admin's view.
  let filter = url.QueryEscape(
    query.filter(configured_team_id()?, "", "", "", "", ""),
  )
  let mut projects = models.ProjectList { .. }
  pb.fetch(
    f"/api/collections/projects/records?perPage=200&sort=name&expand=team&filter={filter}",
    "projects",
    &projects,
  )?
  if p.given("--json") {
    let body = match json.Marshal(projects) {
      Ok(b) => b as string,
      Err(e) => return Err(f"encoding project list: {e}"),
    }
    fmt.Println(body)
    return Ok(())
  }
  for p in projects.items {
    let mut team = p.expand.team.key
    if team == "" { team = "workspace" }
    fmt.Println(f"{p.name}\t{p.status}\t{team}")
  }
  Ok(())
}

fn project_list_spec() -> Slice<flags.Flag> {
  [flags.Flag { name: "--json", help: "print the raw record list as JSON", .. }]
}

fn project_create_spec() -> Slice<flags.Flag> {
  [
    flags.Flag { name: "-n", value: true, hint: "\"name\"", required: true, help: "project name", .. },
    flags.Flag { name: "-d", value: true, hint: "desc", help: "project description", .. },
    flags.Flag { name: "--status", value: true, hint: "s", help: "planned, started, paused, completed, or cancelled\n(defaults to planned)", .. },
    flags.Flag { name: "--team", value: true, hint: "KEY", help: "team key the project belongs to (defaults to LLL_TEAM)", .. },
  ]
}

/// The flag table of one project verb; empty for verbs without flags. Read
/// by `lll completions` so the scripts complete exactly what the parser
/// accepts.
pub fn project_verb_spec(verb: string) -> Slice<flags.Flag> {
  match verb {
    "create" => project_create_spec(),
    "list" => project_list_spec(),
    _ => [],
  }
}

fn check_status(val: string) -> Result<string, string> {
  if project_statuses().find(|s| s == val).is_none() {
    return Err(
      f"unknown status '{val}' (use one of: {strings.Join(project_statuses(), ", ")})",
    )
  }
  Ok(val)
}

fn project_create(args: Slice<string>) -> Result<(), string> {
  let spec = project_create_spec()
  let usage = flags.usage("lll project create", spec, "")
  let p = flags.parse(spec, args, 3, false, usage)?
  let name = p.one("-n")
  let description = p.one("-d")
  let mut status = "planned"
  if p.given("--status") {
    status = check_status(p.one("--status"))?
  }
  let team = team_flag_or_current(p.one("--team"))?

  let new_project = models.NewProject { name, description, status, team: team.id }
  let payload = match json.Marshal(new_project) {
    Ok(p) => p,
    Err(e) => return Err(f"encoding project: {e}"),
  }
  let body = pb.post("/api/collections/projects/records", payload as string)?

  let mut created = models.Project { .. }
  if let Err(e) = json.Unmarshal(body.bytes(), &created) {
    return Err(f"decoding created project: {e}")
  }
  fmt.Println(f"Created project {created.name} ({created.status})")
  Ok(())
}

fn project_view(args: Slice<string>) -> Result<(), string> {
  let Some(name) = args.get(3) else {
    return Err("usage: lll project view NAME")
  }
  let p = resolve_project(configured_team_id()?, name)?

  let mut team = p.expand.team.key
  if team == "" { team = "workspace" }

  fmt.Println(f"Name:    {p.name}")
  fmt.Println(f"Status:  {p.status}")
  fmt.Println(f"Team:    {team}")
  if p.description != "" {
    fmt.Println("")
    fmt.Println(p.description)
  }

  let filter = url.QueryEscape(f"project='{p.id}'")
  let mut issues = models.IssueList { .. }
  pb.fetch(
    f"/api/collections/issues/records?filter={filter}&perPage=200&sort=created&expand=team,assignee",
    "issues",
    &issues,
  )?
  if issues.items.length() > 0 {
    fmt.Println("")
    fmt.Println("Issues:")
    fmt.Println("")
    print_issue_table(issues.items)?
  }
  Ok(())
}

/// Resolve one team's project by name; unknown names error with the fix. An
/// empty `team_id` searches every team, which only the unscoped board wants.
/// Names are unique within a team, not across them (TASK-173).
fn resolve_project(team_id: string, name: string) -> Result<models.Project, string> {
  let filter = url.QueryEscape(query.scoped(team_id, "name", name))
  let mut result = models.ProjectList { .. }
  pb.fetch(
    f"/api/collections/projects/records?filter={filter}&expand=team",
    "projects",
    &result,
  )?
  let Some(p) = result.items.find(|p| p.name == name) else {
    return Err(f"no project named '{name}' — see 'lll project list'")
  }
  Ok(p)
}
