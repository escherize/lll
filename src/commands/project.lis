import "display"
import "records"
import "go:encoding/json"
import "go:fmt"
import "go:net/url"
import "go:strings"

import "models"
import "pb"
import "flags"
import "query"

/// Dispatch `lll project <verb>` through the noun's Command table (TASK-307).
/// The table is the one place a verb is declared: dispatch, `lll project
/// --help` and shell completions all read it, so none of the three can drift.
pub fn project(ctx: pb.Client, args: Slice<string>) -> Result<(), string> {
  flags.dispatch(ctx, "project", "work with projects", project_intro(), project_commands(), args)
}

/// Every project verb, as a value. No verb has a hand-written page, so every
/// `page` is "" and help is generated from `spec`. Dispatch parses args
/// against `spec` before `run`, so a trailing -h can never reach a verb body
/// - `lll project view --help` used to look up a project named "--help".
pub fn project_commands() -> Slice<flags.Command> {
  [
    flags.Command {
      name: "list",
      summary: "list projects (name, status, team); this team's, or every team's when none is configured",
      spec: project_list_spec(),
      run: project_list,
      ..
    },
    flags.Command {
      name: "view",
      summary: "show a project and its issues",
      spec: flags.with_team([flags.Flag { name: "--json", help: "print the project record as JSON, with its issues as issues", .. }]),
      positional: "NAME",
      run: project_view,
      ..
    },
    flags.Command {
      name: "create",
      summary: "create a project (status defaults to planned; --team defaults to LLL_TEAM)",
      spec: project_create_spec(),
      positional: "[NAME]",
      run: project_create,
      ..
    },
    flags.Command {
      name: "edit",
      alias: "update",
      summary: "rename, re-describe or re-status a project; it keeps its issues",
      spec: project_edit_spec(),
      positional: "NAME",
      run: project_edit,
      ..
    },
    flags.Command {
      name: "move",
      summary: "move a project to another team; refuses while issues outside it still belong to it",
      spec: project_move_spec(),
      positional: "NAME",
      run: project_move,
      ..
    },
    flags.Command {
      name: "delete",
      summary: "delete a project; refuses while issues still belong to it, and --force drops it off all of them",
      spec: project_delete_spec(),
      positional: "NAME",
      run: project_delete,
      ..
    },
  ]
}

/// Prose that belongs to the noun rather than to any one verb; dispatch
/// prints it under the verb table for `lll project --help`.
fn project_intro() -> string {
  "Statuses: planned, started, paused, completed, cancelled"
}

/// Project statuses, in lifecycle order.
fn project_statuses() -> Slice<string> {
  ["planned", "started", "paused", "completed", "cancelled"]
}

fn project_list(input: flags.CommandInput) -> Result<(), string> {
  let ctx = input.ctx
  let p = input.parsed
  // Scoped when a team is configured, every team's when not: a project
  // belongs to one team (TASK-173), so the unscoped list is an admin's view.
  let projects = models.ProjectList { items: records.fetch_projects(ctx, configured_scope(ctx)?.filter_team())? }
  if p.given("--json") { return print_list_json(projects.items, whole_list(projects.items.length()), "project list") }
  if projects.items.is_empty() { return say_empty("projects") }
  for p in projects.items {
    let mut team = p.expand.team.key
    if team == "" { team = "workspace" }
    fmt.Println(f"{display.table_cell(p.name)}\t{display.table_cell(p.status)}\t{display.table_cell(team)}")
  }
  Ok(())
}

fn project_list_spec() -> Slice<flags.Flag> {
  flags.with_team([flags.Flag { name: "--json", help: "print the raw record list as JSON", .. }])
}

fn project_create_spec() -> Slice<flags.Flag> {
  flags.with_team([
    flags.Flag { name: "-n", alias: "--name", value: true, hint: "\"name\"", help: "project name", .. },
    flags.Flag { name: "-b", alias: "--body -d --description", value: true, hint: "desc", help: "project description", .. },
    flags.Flag { name: "--status", value: true, hint: "s", help: "planned, started, paused, completed, or cancelled\n(defaults to planned)", .. },
    flags.Flag { name: "--team", value: true, hint: "KEY", help: "team key the project belongs to (defaults to LLL_TEAM)", .. },
  ])
}

fn project_edit_spec() -> Slice<flags.Flag> {
  flags.with_team([
    flags.Flag { name: "-n", alias: "--name", value: true, hint: "\"new name\"", help: "new project name", .. },
    flags.Flag { name: "-b", alias: "--body -d --description", value: true, hint: "desc", help: "new project description", .. },
    flags.Flag { name: "--status", value: true, hint: "s", help: "planned, started, paused, completed, or cancelled", .. },
  ])
}

fn project_move_spec() -> Slice<flags.Flag> {
  flags.with_team([
    flags.Flag { name: "--to", value: true, hint: "KEY", help: "team key to move the project to", .. },
  ])
}

fn project_delete_spec() -> Slice<flags.Flag> {
  flags.with_team([
    flags.Flag { name: "--force", help: "delete even while issues belong to the project", .. },
    flags.Flag { name: "--yes", help: "skip the delete confirmation (asked only on a terminal)", .. },
  ])
}


fn check_status(val: string) -> Result<string, string> {
  if project_statuses().find(|s| s == val).is_none() {
    return Err(
      f"unknown status '{val}' (use one of: {strings.Join(project_statuses(), ", ")})",
    )
  }
  Ok(val)
}

fn project_create(input: flags.CommandInput) -> Result<(), string> {
  let ctx = input.ctx
  let usage = input.usage
  let p = input.parsed
  let name = flags.entity_name(p, "-n", usage)?
  check_filter_name("project", name)?
  let description = p.one("-b")
  let mut status = "planned"
  if p.given("--status") {
    status = check_status(p.one("--status"))?
  }
  let team = team_flag_or_current(ctx, p.one("--team"))?

  let new_project = models.NewProject { name, description, status, team: team.id }
  let payload = match json.Marshal(new_project) {
    Ok(p) => p,
    Err(e) => return Err(f"encoding project: {e}"),
  }
  let body = ctx.post("/api/collections/projects/records", payload as string)?

  let mut created = models.Project { .. }
  if let Err(e) = json.Unmarshal(body.bytes(), &created) {
    return Err(f"decoding created project: {e}")
  }
  fmt.Println(f"Created project {created.name} ({created.status})")
  Ok(())
}

fn project_edit(input: flags.CommandInput) -> Result<(), string> {
  let ctx = input.ctx
  let usage = input.usage
  let p = input.parsed
  let Some(name) = nonempty(p.first()) else {
    return Err(flags.usage_error(f"usage: {usage}"))
  }
  if !p.given("-n") && !p.given("-b") && !p.given("--status") {
    return Err(flags.usage_error(f"nothing to update: pass -n, -b or --status\nusage: {usage}"))
  }
  // Validate before the lookup: a typo'd status should cost no round trip and
  // must not leave a half-applied patch behind.
  let mut status = ""
  if p.given("-n") { check_filter_name("project", p.one("-n"))? }
  if p.given("--status") { status = check_status(p.one("--status"))? }
  let project = records.resolve_project(ctx, current_team(ctx)?.id, name)?

  let mut fields: Slice<string> = []
  if p.given("-n") { fields = fields.append("\"name\":" + json_quote(p.one("-n"))?) }
  if p.given("-b") { fields = fields.append("\"description\":" + json_quote(p.one("-b"))?) }
  if status != "" { fields = fields.append("\"status\":" + json_quote(status)?) }
  let _ = ctx.patch(
    f"/api/collections/projects/records/{project.id}",
    "{" + strings.Join(fields, ",") + "}",
  )?
  fmt.Println(f"Updated project {name}")
  Ok(())
}

/// Count shared references before deleting; force explicitly accepts their loss.
/// `lll project move NAME --to KEY` (LLL-100). See move_scope.lis for why the
/// refusal is the right answer rather than dragging the references along.
fn project_move(input: flags.CommandInput) -> Result<(), string> {
  let ctx = input.ctx
  let usage = input.usage
  let p = input.parsed
  let Some(name) = nonempty(p.first()) else {
    return Err(flags.usage_error(f"usage: {usage}"))
  }
  let from = team_flag_or_current(ctx, p.one("--team"))?
  let to = move_destination(ctx, p.one("--to"))?
  let project = records.resolve_project(ctx, from.id, name)?
  fmt.Println(move_to_team(ctx, "project", project.name, project.id, from, to)?)
  Ok(())
}

fn project_delete(input: flags.CommandInput) -> Result<(), string> {
  let ctx = input.ctx
  let usage = input.usage
  let p = input.parsed
  let Some(name) = nonempty(p.first()) else {
    return Err(flags.usage_error(f"usage: {usage}"))
  }
  let project = records.resolve_project(ctx, current_team(ctx)?.id, name)?
  let used = entity_issue_count(ctx, "project", project.id)?
  if used > 0 && !p.given("--force") {
    return Err(refuse_delete("project", name, used))
  }
  if !confirmed_on_terminal(p.given("--yes"), f"delete project {name}?") {
    return Err(aborted())
  }
  let _ = ctx.delete(f"/api/collections/projects/records/{project.id}")?
  fmt.Println(deleted_line("project", name, used))
  Ok(())
}

fn project_view(input: flags.CommandInput) -> Result<(), string> {
  let ctx = input.ctx
  let name = input.parsed.first()
  if name == "" {
    return Err(flags.usage_error("usage: lll project view NAME"))
  }
  let p = records.resolve_project(ctx, current_team(ctx)?.id, name)?

  let json_mode = input.parsed.given("--json")
  let mut team = p.expand.team.key
  if team == "" { team = "workspace" }

  if !json_mode {
    fmt.Println(f"Name:    {p.name}")
    fmt.Println(f"Status:  {p.status}")
    fmt.Println(f"Team:    {team}")
    if p.description != "" {
      fmt.Println("")
      fmt.Println(p.description)
    }
  }

  let filter = url.QueryEscape(f"project={query.quote(p.id)}")
  let mut issues = models.IssueList { .. }
  pb.fetch(ctx, 
    f"/api/collections/issues/records?filter={filter}&perPage=200&sort=created&expand=team,assignee",
    "issues",
    &issues,
  )?
  if json_mode {
    let mut fields = Map.new<string, json.RawMessage>()
    if let Err(e) = json.Unmarshal(encode_json(p, "project")?, &fields) { return Err(f"decoding project: {e}") }
    let listed = if issues.items.is_empty() { "[]".bytes() as json.RawMessage } else { encode_json(issues.items, "issues")? }
    fields["issues"] = listed
    return print_json(fields, "project")
  }
  if issues.items.length() > 0 {
    fmt.Println("")
    fmt.Println("Issues:")
    fmt.Println("")
    print_issue_table(issues.items, Map.new<string, models.Claim>())?
  }
  Ok(())
}
