import "go:bufio"
import "go:encoding/json"
import "go:fmt"
import "go:os"
import "go:strings"

import "config"
import "models"
import "pb"

// `lll member set-password NAME --old-password OLD` (LLL-648): a member
// changes its own password with its own token. An invite hands out a
// temporary password, and before this only a superuser could replace it.
//
// PocketBase decides: the members update rule admits a member's own record,
// and a non-superuser password change must carry the current password
// (oldPassword), so a stolen token alone cannot take over the login. The
// change rotates the member's token key, which revokes every token it held,
// the CLI's own included; the command logs in again with the new password
// and saves the fresh token where the old one was.

/// PATCH body for a member's own password change.
#[json]
struct OwnPasswordPatch {
  #[json("oldPassword")]
  old_password: string,
  password: string,
  #[json("passwordConfirm")]
  password_confirm: string,
}

/// Change the logged-in member's password. `name` must be that member: the
/// command names whose password changes, so a mistyped NAME is refused
/// instead of silently changing the caller's own.
fn change_own_password(
  name: string,
  old: string,
  given: Option<string>,
) -> Result<(), string> {
  let (cfg, src) = config.load_traced()?
  if cfg.token == "" { return Err(pb.not_logged_in_message()) }
  if old == "" {
    return Err("--old-password needs your current password (the temporary one from your invite, if you have not changed it)")
  }
  let Some(id) = pb.token_subject(cfg.token) else {
    return Err("the configured token names no member; log in with 'lll login' first")
  }
  let me = match pb.get(f"/api/collections/members/records/{id}") {
    Ok(body) => {
      let mut m = models.Member { .. }
      if let Err(e) = json.Unmarshal(body.bytes(), &m) {
        return Err(f"decoding your member record: {e}")
      }
      m
    },
    Err(_) => return Err(
      "--old-password changes the password of the member you are logged in as, and the configured token is not a member's (an administrator token?); set another member's password without --old-password",
    ),
  }
  if me.name != name {
    return Err(
      f"you are logged in as {me.name}, not {name}: --old-password changes only your own password
to set {name}'s password, drop --old-password and use administrator credentials",
    )
  }
  if !real_email(me.email) {
    return Err(
      f"{me.name} has no email to log in with (only {me.email}), so a password would not help: keep using a token ('lll login --token -')",
    )
  }
  let password = match given {
    Some(pw) => pw,
    None => {
      let mut input = bufio.NewReader(os.Stdin)
      let typed = read_password(input, f"New password for {me.name}: ")?
      let confirm = read_password(input, "Confirm password: ")?
      if typed != confirm { return Err("the passwords do not match") }
      typed
    },
  }
  if password.length() < 8 {
    return Err(
      f"passwords require at least 8 characters (got {password.length()})",
    )
  }
  let payload = match json.Marshal(
    OwnPasswordPatch { old_password: old, password, password_confirm: password },
  ) {
    Ok(b) => b,
    Err(e) => return Err(f"encoding the change: {e}"),
  }
  if let Err(e) = pb.patch(f"/api/collections/members/records/{id}", payload as string) {
    if pb.response_status(e) == 400 && strings.Contains(pb.response_body(e), "oldPassword") {
      return Err("the current password (--old-password) is not right; nothing changed")
    }
    return Err(f"changing your password: {e}")
  }
  fmt.Println(f"password changed for {me.name}")
  // The change revoked the token that made it. Log in again so the next
  // command works, and put the new token where the old one came from.
  let renewed = relogin(me.email, password)
  let home = config.home_path()?
  match renewed {
    Ok(tok) => {
      if src.token == f"file:{home}" {
        let path = set_home_key("token", tok)?
        fmt.Println(f"tokens minted before this change are revoked; logged in again, new token saved to {path}")
      } else {
        fmt.Println(
          f"tokens minted before this change are revoked, including the one from {src.token}; unset LLL_TOKEN if it is set, then log in again with: lll login --email {me.email}",
        )
      }
    },
    Err(e) => fmt.Println(
      f"tokens minted before this change are revoked, and logging in again failed ({e}); run: lll login --email {me.email}",
    ),
  }
  Ok(())
}

/// A fresh member token for email and password from the configured server.
fn relogin(email: string, password: string) -> Result<string, string> {
  let payload = match json.Marshal(models.AuthRequest { identity: email, password }) {
    Ok(b) => b,
    Err(e) => return Err(f"encoding credentials: {e}"),
  }
  let body = pb.post_anon("/api/collections/members/auth-with-password", payload as string)?
  let mut auth = models.AuthResponse { .. }
  if let Err(e) = json.Unmarshal(body.bytes(), &auth) {
    return Err(f"decoding the auth response: {e}")
  }
  if auth.token == "" { return Err("the response carried no token") }
  Ok(auth.token)
}
