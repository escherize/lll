import "go:bufio"
import "go:encoding/json"
import "go:fmt"
import "go:os"
import "go:strings"
import "config"
import "flags"
import "models"
import "pb"
import "writes"
import "records"
import "tokens"

// `lll member set-password NAME --old-password OLD` (LLL-648): a member
// changes its own password with its own token. An invite hands out a
// temporary password, and before this only a superuser could replace it.
//
// PocketBase decides: the members update rule admits a member's own record,
// and a non-superuser password change must carry the current password
// (oldPassword), so a stolen token alone cannot take over the login. The
// change rotates the member's token key, which revokes every token it held,
// the CLI's own included; the command logs in again with the new password
// and saves the fresh token where the old one was.

/// Whether an error is a token the server would not accept (exit 6).
fn is_auth_failure(err: pb.CliError) -> bool {
  match err.kind {
    pb.ErrorKind.Auth => true,
    _ => false,
  }
}

/// Whether the configured token is a superuser's: it can read its own
/// _superusers record. Asked only after the member read failed.
fn administrator_token(ctx: pb.Client, id: models.MemberId) -> bool {
  ctx.get(f"/api/collections/_superusers/records/{id}?fields=id").is_ok()
}

fn administrator_token_refusal() -> string {
  "--old-password changes the password of the member you are logged in as, and the configured token is an administrator's; set another member's password without --old-password"
}

/// Change the logged-in member's password. `name` must be that member: the
/// command names whose password changes, so a mistyped NAME is refused
/// instead of silently changing the caller's own.
fn change_own_password(
  ctx: pb.Client,
  name: string,
  old: string,
  given: Option<string>,
) -> Result<(), pb.CliError> {
  let (cfg, src) = ctx.settings.traced().map_err(pb.failed)?
  if cfg.token == "" { return Err(ctx.not_logged_in_message()) }
  if old == "" {
    return Err(flags.usage_error("--old-password needs your current password (the temporary one from your invite, if you have not changed it)"))
  }
  let Some(id) = records.token_member(cfg.token) else {
    return Err(pb.failed("the configured token names no member; log in with 'lll login' first"))
  }
  let me = match ctx.get(f"/api/collections/members/records/{id}") {
    Ok(body) => {
      let mut m = models.Member { .. }
      if let Err(e) = json.Unmarshal(body.bytes(), &m) {
        return Err(pb.failed(f"decoding your member record: {e}"))
      }
      m
    },
    // LLL-679: this arm used to call every failure an administrator token,
    // at exit 1. A token the server refuses (revoked, expired) keeps its
    // exit-6 not-authenticated text; only a token that reads its own
    // _superusers record gets the --old-password advice; anything else (a
    // network error, a removed member) is shown as it is.
    Err(e) => {
      if is_auth_failure(e) { return Err(e) }
      if administrator_token(ctx, id) { return Err(pb.failed(administrator_token_refusal())) }
      return Err(e)
    },
  }
  if me.name != name {
    return Err(pb.fail(
      pb.ErrorKind.Refused,
      f"you are logged in as {me.name}, not {name}: --old-password changes only your own password
to set {name}'s password, drop --old-password and use administrator credentials",
    ))
  }
  if !real_email(me.email) {
    return Err(
      pb.failed(f"{me.name} has no email to log in with (only {me.email}), so a password would not help: keep using a token ('lll login --token -')"),
    )
  }
  let password = match given {
    Some(pw) => pw,
    None => {
      let mut input = bufio.NewReader(os.Stdin)
      let typed = read_password(input, f"New password for {me.name}: ")?
      let confirm = read_password(input, "Confirm password: ")?
      if typed != confirm { return Err(pb.failed("the passwords do not match")) }
      typed
    },
  }
  if password.length() < 8 {
    return Err(
      pb.failed(f"passwords require at least 8 characters (got {password.length()})"),
    )
  }
  let patch = writes.MemberPatch {
    old_password: Some(old),
    password: Some(password),
    password_confirm: Some(password),
    ..
  }
  if let Err(e) = writes.update_member(ctx, pb.Caller.Process, id, patch) {
    if e.has_code(pb.ServerCode.OldPasswordRejected) {
      return Err(pb.fail(pb.ErrorKind.Refused, "the current password (--old-password) is not right; nothing changed\nif you do not know it (never logged in, or lost it), only an administrator can reset it"))
    }
    return Err(e.with_message(f"changing your password: {e.message}"))
  }
  fmt.Println(f"password changed for {me.name}")
  // The change revoked the token that made it. Log in again so the next
  // command works, and put the new token where the old one came from.
  let renewed = relogin(ctx, me.email, password)
  let home = ctx.settings.home_path().map_err(pb.failed)?
  match renewed {
    Ok(tok) => {
      if src.token == f"file:{home}" {
        let path = set_home_key(ctx.settings, "token", tok)?
        fmt.Println(f"tokens minted before this change are revoked; logged in again, new token saved to {path}")
      } else {
        fmt.Println(
          f"tokens minted before this change are revoked, including the one from {src.token}; unset LLL_TOKEN if it is set, then log in again with: lll login --email {me.email}",
        )
      }
    },
    Err(e) => fmt.Println(
      f"tokens minted before this change are revoked, and logging in again failed ({e.message}); run: lll login --email {me.email}",
    ),
  }
  Ok(())
}

/// A fresh member token for email and password from the configured server.
fn relogin(ctx: pb.Client, email: string, password: string) -> Result<string, pb.CliError> {
  let payload = match json.Marshal(models.AuthRequest { identity: email, password }) {
    Ok(b) => b,
    Err(e) => return Err(pb.failed(f"encoding credentials: {e}")),
  }
  let body = ctx.post_anon("/api/collections/members/auth-with-password", payload as string)?
  let mut auth = models.AuthResponse { .. }
  if let Err(e) = json.Unmarshal(body.bytes(), &auth) {
    return Err(pb.failed(f"decoding the auth response: {e}"))
  }
  if auth.token == "" { return Err(pb.failed("the response carried no token")) }
  Ok(auth.token)
}

fn set_password_spec() -> Slice<flags.Flag> {
  with_admin_flags([
    flags.Flag {
      name: "--password",
      value: true,
      hint: "pw",
      help: "the new password; '-' reads it from stdin; omit to be prompted twice",
      ..,
    },
    flags.Flag {
      name: "--old-password",
      value: true,
      hint: "pw",
      help: "change your own password: your current one (no administrator needed);\n'-' reads it from stdin",
      ..,
    },
    flags.Flag {
      name: "--url",
      value: true,
      hint: "url",
      help: "server base url; without it the configured one (LLL_URL, 'url' in .lll.toml)",
      ..,
    },
    flags.Flag {
      name: "--email",
      alias: "-e",
      value: true,
      hint: "email",
      help: "real email to set alongside the password; required when the member has only a synthesized one",
      ..,
    },
  ])
}

/// The client for the rest of the command: pointed at `given` when a --url
/// was given (a flag override in its settings), else unchanged. The token is
/// kept, as LLL_URL kept it.
fn point_at_url(ctx: pb.Client, given: string) -> Result<pb.Client, pb.CliError> {
  let base = strings.TrimSuffix(strings.TrimSpace(given), "/")
  if base == "" { return Ok(ctx) }
  if !strings.HasPrefix(base, "http://") && !strings.HasPrefix(base, "https://") {
    return Err(
      flags.usage_error(f"--url must be a full base url starting with http:// or https:// (got '{base}')"),
    )
  }
  Ok(ctx.with_url(base))
}

/// `lll member set-password NAME` — the superuser gives a member login
/// credentials (TASK-203). Needed because created and imported members carry
/// a random password nobody knows, so 'lll login' is a dead door until this
/// runs. Gated exactly like token create: --admin-email/--admin-password, or a
/// configured superuser token.
/// Keep unrelated validation and server failures intact; only actual auth
/// refusals should advise the caller to change administrative credentials.
fn member_password_error(name: string, e: pb.CliError) -> pb.CliError {
  let status = e.status
  if status == 403 || status == 401 || e.has_code(pb.ServerCode.OldPasswordRejected) {
    return pb.fail(pb.ErrorKind.Refused, "setting another member's password is superuser-only and the configured token is not one
" + tokens.admin_hint() + f"
if {name} is you, change your own password with: lll member set-password {name} --old-password <current>")
  }
  e.with_message(f"setting {name}'s password: {e.message}")
}

fn member_set_password(input: flags.CommandInput) -> Result<(), pb.CliError> {
  let ctx = input.ctx
  let usage = input.usage
  let p = input.parsed
  let name = p.first()
  if name == "" { return Err(flags.usage_error(f"usage: {usage}")) }

  let ctx = point_at_url(ctx, p.one("--url"))?
  if p.given("--old-password") {
    if p.given("--email") || p.given("--admin-email") || p.given("--admin-password") {
      return Err(flags.usage_error("--old-password changes your own password with your own login: drop --email, --admin-email and --admin-password"))
    }
    if p.one("--old-password") == "-" && p.one("--password") == "-" {
      return Err(flags.usage_error("only one of --old-password and --password can read stdin ('-')"))
    }
    // The prompt path opens its own reader, which would lose what this one
    // buffered past the old password.
    if p.one("--old-password") == "-" && !p.given("--password") {
      return Err(flags.usage_error("with --old-password -, give the new one with --password"))
    }
    let mut stdin = bufio.NewReader(os.Stdin)
    let old = password_value(p.one("--old-password"), stdin)?
    let given = if p.given("--password") { Some(password_value(p.one("--password"), stdin)?) } else { None }
    return change_own_password(ctx, name, old, given)
  }
  let su = superuser_auth(ctx, given_admin_login(ctx.settings, p)?)?
  let found = records.find_member_as(ctx, su, name)?
  let Some(member) = found else {
    return Err(pb.fail(pb.ErrorKind.NotFound, f"no member named '{name}'; see 'lll member create'"))
  }

  // The email IS the login identity. A member carrying only the synthesized
  // @members.invalid placeholder has nothing a human can honestly type, so
  // setting a password without fixing the email would leave login broken —
  // the exact dead end this command exists to remove.
  let email = strings.TrimSpace(p.one("--email"))
  if email == "" && !real_email(member.email) {
    return Err(
      pb.failed(f"member '{name}' has no real email (only the synthesized {member.email}), and the email is what 'lll login' asks for
rerun with --email <email> to set one alongside the password"),
    )
  }

  // A flag, not only the two prompts: provisioning a colleague from a script
  // or a deploy step had no non-interactive path at all (TASK-246), and the
  // pipe form was documented only in this command's own --help.
  let password = if p.given("--password") {
    let mut input = bufio.NewReader(os.Stdin)
    password_value(p.one("--password"), input)?
  } else {
    let mut input = bufio.NewReader(os.Stdin)
    let typed = read_password(input, f"New password for {member.name}: ")?
    let confirm = read_password(input, "Confirm password: ")?
    if typed != confirm { return Err(pb.failed("the passwords do not match")) }
    typed
  }
  if password == "" {
    return Err(pb.failed("no password: pass --password <pw>, or answer the two prompts"))
  }
  if password.length() < 8 {
    return Err(
      pb.failed(f"passwords require at least 8 characters (got {password.length()})"),
    )
  }

  let mut patch = writes.MemberPatch { password: Some(password), password_confirm: Some(password), .. }
  if email != "" { patch.email = Some(email) }
  if let Err(e) = writes.update_member(ctx, pb.Caller.Member(su), member.id, patch) {
    return Err(member_password_error(name, e))
  }

  let identity = if email == "" { member.email } else { email }
  if email != "" && email != member.email {
    fmt.Println(f"email set to {email}")
  }
  fmt.Println(f"password set for {member.name}")
  // LLL-499 (fleet case B08): PocketBase rotates the member's tokenKey here,
  // so a token minted before the reset starts answering 401 with nothing in
  // the reset output explaining why. Name the revocation and the re-mint
  // while the operator is still holding the terminal.
  fmt.Println(
    f"tokens minted before this reset are revoked (401): re-mint with 'lll token create {member.name}' and send the new one to whoever held the old",
  )
  fmt.Println(
    f"they log in with: lll login --email {identity} (plus --url <server> on a fresh machine)",
  )
  Ok(())
}

/// The hand-written page for `lll member set-password`.
fn member_set_password_page() -> string {
  let spec = set_password_spec()
  let usage = flags.usage("lll member set-password", spec, "NAME")
  f"lll member set-password - set a member's login password

Usage:
  {usage}

Your own password needs no administrator: pass your name and your current
password, logged in as yourself.

  lll member set-password NAME --old-password <current> --password <new>

The change revokes your earlier tokens; the command logs in again and saves
the new token where the old one was, when that was the home config.

Anyone else's password is superuser only. The command authenticates as the
server administrator using --admin-email/--admin-password, else a configured
superuser token, else LLL_ADMIN_EMAIL/LLL_ADMIN_PASSWORD when no token is
configured.
Sets NAME's password to --password when supplied. Otherwise prompts
twice with echo off when stdin is a terminal, or reads two lines when piped.
The replacement password must contain at least 8 characters.

--email also sets the member's email, and is required when the member only
has a synthesized @members.invalid one: the email is the identity
'lll login' asks for. After this, the member logs in with
'lll login --url <server>'.

The password change rotates the member's token key, so every token minted
before it (an agent's LLL_TOKEN, a person token in a handed-off config)
answers 401 afterwards. Re-mint with 'lll token create NAME' and send the
new token to whoever held the old one." +
  flags.section(spec)
}
