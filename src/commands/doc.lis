/// Dispatch `lll doc <verb>` through the noun's Command table (TASK-307).
/// The table is the one place a verb is declared: dispatch, `lll doc --help`
/// and shell completions all read it, so none of the three can drift.
pub fn doc(ctx: pb.Client, args: Slice<string>) -> Result<(), string> {
  // Removed at 1.0 (D5): the link lives on the issue noun.
  let verb = args.get(2).unwrap_or("")
  if verb == "link" || verb == "unlink" {
    return Err(f"unknown doc command: '{verb}' - did you mean 'lll issue {verb} KEY-123 SLUG'? (see 'lll issue {verb} --help')")
  }
  flags.dispatch(ctx, "doc", "work with docs (wiki pages, findings, decisions, PRDs)", doc_intro(), doc_commands(), args)
}

/// Every doc verb, as a value. No verb has a hand-written page, so `page` is
/// "" throughout and help is generated from `spec`. Dispatch parses args
/// against `spec` before `run`, so a trailing -h on `delete` or `edit` is
/// answered before the verb body can reach the server.
pub fn doc_commands() -> Slice<flags.Command> {
  [
    flags.Command {
      name: "create", alias: "new",
      summary: "create a doc; -b - reads the body from stdin",
      spec: doc_new_spec(),
      run: doc_new,
      ..
    },
    flags.Command {
      name: "list",
      summary: "list docs (slug, kind, title), one line each",
      spec: doc_list_spec(),
      run: doc_list,
      ..
    },
    flags.Command {
      name: "view", alias: "show",
      summary: "show one doc with its linked issues; --raw prints only the body; --json prints the raw record",
      spec: doc_view_spec(),
      positional: "SLUG",
      run: doc_view,
      ..
    },
    flags.Command {
      name: "edit",
      alias: "update",
      summary: "replace fields (at least one flag); -b - reads the whole body from stdin",
      spec: doc_edit_spec(),
      positional: "SLUG",
      run: doc_edit,
      ..
    },
    flags.Command {
      name: "delete",
      summary: "delete; asks [y/N] unless --yes",
      spec: doc_delete_spec(),
      positional: "SLUG",
      run: doc_delete,
      ..
    },
  ]
}

/// Prose that belongs to the noun rather than to any one verb; dispatch
/// prints it under the verb table for `lll doc --help`. The union Flags:
/// block leads it so the noun page keeps every flag's line, as it did before
/// the table (each verb's own --help repeats its share).
fn doc_intro() -> string {
  strings.TrimPrefix(flags.section(doc_union_spec()), "\n") +
    "

Every verb accepts --team KEY for this invocation, overriding LLL_TEAM or
.lll.toml without rewriting configuration. Each works inside ONE team. A
slug is unique per team, so two projects sharing a server both get an
'index'; read the other one with LLL_TEAM=THEIRS lll doc view index.

Docs link to issues with 'lll issue link KEY-123 SLUG' and unlink with
'lll issue unlink KEY-123 SLUG'. A link stays inside one team: the doc and
the issue must belong to the same one.

Findings surface by area and path, not by search: 'lll finding near <path>'
lists what is filed about a file or directory, 'lll finding list [-a AREA]'
lists one area. An issue page shows the findings whose area names one of its
labels (see 'lll finding --help')."
}

// ------------------------------------------------------------- validation

/// An empty kind defaults to wiki, the reading-room kind; anything else
/// must be one of the four words.
pub fn check_kind(val: string) -> Result<string, string> {
  let kind = strings.TrimSpace(strings.ToLower(val))
  if kind == "" { return Ok("wiki") }
  if records.doc_kinds().find(|k| k == kind).is_none() {
    return Err(
      f"unknown kind '{kind}' (use one of: {strings.Join(records.doc_kinds(), ", ")})",
    )
  }
  Ok(kind)
}

/// Confidence values a CREATE may carry (LLL-396). 'refuted' is deliberately
/// absent: a refutation is a later agent's judgement with a reason, and it
/// only exists once something was asserted first — 'finding refute' is the
/// only path that sets it.
pub fn check_confidence(val: string) -> Result<string, string> {
  let c = strings.TrimSpace(strings.ToLower(val))
  if c == "" { return Ok("confirmed") }
  if c != "suspected" && c != "confirmed" {
    return Err(f"unknown confidence '{c}' (use: suspected, confirmed; 'finding refute SLUG -b why' is how a finding becomes refuted)")
  }
  Ok(c)
}

/// Normalize a comma-separated paths value: trim each entry, drop empties
/// and duplicates, join back with ", ". Never errors — a path is free text
/// and retrieval matches by containment, so "./src/pb" and "src/pb" land
/// the same.
pub fn parse_paths(val: string) -> string {
  let mut out: Slice<string> = []
  for raw in strings.Split(val, ",") {
    let p = norm_path(raw)
    if p == "" { continue }
    if out.find(|x| x == p).is_some() { continue }
    out = out.append(p)
  }
  strings.Join(out, ", ")
}

/// Does one stored path entry "touch" the path being asked about? True when
/// they are equal, or either one sits under the other's directory — a
/// finding filed on `src/pb` answers `lll finding near src/pb/records.lis`
/// AND `lll finding near src` (asking broadly finds the specific note).
///
/// Matching is on whole path SEGMENTS, not on the raw string: `src/comm`
/// does not touch `src/commands`, because a prefix of a name is not a
/// parent of it (TASK-166).
pub fn path_touches(entry: string, path: string) -> bool {
  let e = norm_path(entry)
  let p = norm_path(path)
  if e == "" || p == "" { return false }
  e == p || p.starts_with(f"{e}/") || e.starts_with(f"{p}/")
}

/// Trim space and surrounding slashes, and drop a leading `./` (TASK-166).
/// The query side of `lll finding near <path>` is raw argv, and shell path
/// completion hands over `./src/pb` routinely; `./x` and `x` name the same
/// place, so a stored entry on `src/pb` has to answer for both. `parse_paths`
/// uses this same normalization before deduplicating stored metadata.
fn norm_path(val: string) -> string {
  let mut s = strings.TrimSpace(val)
  while strings.HasPrefix(s, "./") { s = strings.TrimPrefix(s, "./") }
  strings.Trim(s, "/")
}

// ----------------------------------------------------------------- specs

fn doc_new_spec() -> Slice<flags.Flag> {
  flags.with_team([
    flags.Flag {
      name: "-s",
      alias: "--slug",
      value: true,
      hint: "slug",
      required: true,
      help: "URL-safe name for the doc, e.g. port-notes",
      ..,
    },
    flags.Flag {
      name: "-t",
      alias: "--title",
      value: true,
      hint: "\"title\"",
      required: true,
      help: "human-readable title",
      ..,
    },
    flags.Flag {
      name: "-k",
      alias: "--kind",
      value: true,
      hint: "kind",
      help: "wiki (default), finding, decision, or prd",
      ..,
    },
    flags.Flag {
      name: "-b",
      alias: "--body",
      value: true,
      hint: "body",
      help: "body text ('-b -' reads it from stdin)",
      ..,
    },
    flags.Flag {
      name: "-a",
      alias: "--area",
      value: true,
      hint: "area",
      help: "workspace area the doc is about, conventionally a label's name,\nso issues carrying that label surface the doc",
      ..,
    },
    flags.Flag {
      name: "--paths",
      value: true,
      hint: "paths",
      help: "comma-separated file/directory paths the doc is about, e.g.\nsrc/pb, pb/pb_migrations ('lll finding near' matches by them)",
      ..,
    },
    flags.Flag { name: "--json", help: "print the created doc record as JSON", .. },
  ])
}

/// finding new/create take the doc-creation flags with one difference: the
/// slug may also arrive as the bare argument, the way issue create takes a
/// bare title (four create verbs already do). So -s cannot be parse-required
/// here: flags.entity_name refuses when neither form appears, and refuses
/// both at once.
fn finding_new_spec() -> Slice<flags.Flag> {
  let mut spec: Slice<flags.Flag> = []
  for fl in doc_new_spec() {
    if fl.name == "-s" {
      spec = spec.append(flags.Flag {
        name: "-s",
        alias: "--slug",
        value: true,
        hint: "slug",
        help: "URL-safe name for the doc, e.g. port-notes (or give it as the bare argument)",
        ..,
      })
    } else {
      spec = spec.append(fl)
    }
  }
  // LLL-396: a finding may be filed as a guess. doc new keeps today's
  // semantics — everything it writes is asserted (confirmed).
  spec = spec.append(flags.Flag {
    name: "--confidence",
    value: true,
    hint: "suspected|confirmed",
    help: "file as a guess with 'suspected' (default 'confirmed'); 'finding\nrefute' is the only way a finding becomes refuted",
    ..,
  })
  spec
}

fn doc_view_spec() -> Slice<flags.Flag> {
  flags.with_team([
    flags.Flag { name: "--raw", help: "print only the body, no chrome", .. },
    flags.Flag {
      name: "--json",
      help: "the doc record as JSON (linked issues and author expanded), timestamps in RFC3339",
      ..,
    },
  ])
}

fn doc_edit_spec() -> Slice<flags.Flag> {
  flags.with_team([
    flags.Flag {
      name: "-b",
      alias: "--body",
      value: true,
      hint: "body",
      help: "replacement body: the WHOLE body, not a patch\n('-b -' reads it from stdin)",
      ..,
    },
    flags.Flag {
      name: "-t",
      alias: "--title",
      value: true,
      hint: "\"title\"",
      help: "new title",
      ..,
    },
    flags.Flag {
      name: "-k",
      alias: "--kind",
      value: true,
      hint: "kind",
      help: "wiki, finding, decision, or prd",
      ..,
    },
    flags.Flag {
      name: "-a",
      alias: "--area",
      value: true,
      hint: "area",
      help: "new area; pass \"\" to clear it",
      ..,
    },
    flags.Flag {
      name: "--paths",
      value: true,
      hint: "paths",
      help: "replacement comma-separated paths: the WHOLE set\n(pass \"\" to clear it)",
      ..,
    },
  ])
}

fn doc_delete_spec() -> Slice<flags.Flag> {
  flags.with_team([flags.Flag { name: "--yes", help: "skip the delete confirmation", .. }])
}

/// Every flag across the doc verbs, deduplicated by canonical name, in the
/// order the verbs declare them. This is the Flags: block `lll doc --help`
/// renders.
fn doc_union_spec() -> Slice<flags.Flag> {
  let mut out: Slice<flags.Flag> = []
  for command in doc_commands() {
    for fl in command.spec {
      if out.find(|f| f.name == fl.name).is_none() { out = out.append(fl) }
    }
  }
  out
}

// ----------------------------------------------------------------- verbs

fn doc_new(input: flags.CommandInput) -> Result<(), string> {
  let ctx = input.ctx
  create_doc(ctx, input.parsed, "wiki", input.parsed.one("-s"))
}

fn create_doc(ctx: pb.Client, p: flags.Parsed, default_kind: string, slug: string) -> Result<(), string> {
  let slug = records.check_slug(slug)?
  let title = p.one("-t")
  let requested_kind = if p.given("-k") { p.one("-k") } else { default_kind }
  let kind = check_kind(requested_kind)?
  let area = strings.TrimSpace(p.one("-a"))
  let paths = parse_paths(p.one("--paths"))
  let confidence_raw = if p.given("--confidence") { p.one("--confidence") } else { "" }
  let confidence = check_confidence(confidence_raw)?
  let mut body = ""
  if p.given("-b") { body = value_or_stdin(p.one("-b"), "-b")? }

  let team = current_team(ctx)?

  // The unique index would catch this too, but the fix belongs in the
  // message, not a raw 400. It is UNIQUE (team, slug) now, so the clash is
  // only ever with this team's own docs.
  if let Some(_) = records.find_doc(ctx, team, slug)? {
    return Err(
      f"{team.key} already has a doc with slug '{slug}'; see 'lll doc view {slug}' or 'lll doc list'",
    )
  }

  let new_doc = models.NewDoc {
    team: team.id,
    slug,
    title,
    kind,
    body,
    confidence,
    confidence_note: "",
    area,
    paths,
    issues: [],
  }
  let resp = writes.create_doc(ctx, new_doc)?

  let mut created = models.Doc { .. }
  if let Err(e) = json.Unmarshal(resp.bytes(), &created) {
    return Err(f"decoding created doc: {e}")
  }
  if p.given("--json") {
    fmt.Println(contract_json(resp.bytes() as json.RawMessage, 0) as string)
    return Ok(())
  }
  fmt.Println(f"Created doc {created.slug}")
  Ok(())
}

fn doc_list_spec() -> Slice<flags.Flag> {
  // --search mirrors finding list's (finding.lis), for the same fleet reason
  // written there: agents ask the list to narrow, not 'lll search' to rank.
  flags.with_team([
    flags.Flag {
      name: "-k",
      alias: "--kind",
      value: true,
      hint: "kind",
      help: "only docs of this kind: wiki, finding, decision, or prd",
      ..,
    },
    flags.Flag {
      name: "--search",
      alias: "",
      value: true,
      hint: "text",
      help: "only docs whose slug or title contains text",
      ..,
    },
    flags.Flag {
      name: "--limit",
      alias: "-l",
      value: true,
      hint: "N",
      help: "list at most N docs (positive integer)",
      ..,
    },
    flags.Flag { name: "--json", help: "print the raw record list as JSON", .. },
  ])
}

/// `--limit N`, validated before any server call; 0 when not given.
fn limit_flag(p: flags.Parsed) -> Result<int, string> {
  if !p.given("--limit") { return Ok(0) }
  let raw = p.one("--limit")
  let Ok(n) = strconv.Atoi(raw) else {
    return Err(flags.usage_error(f"--limit must be a positive integer, got '{raw}'"))
  }
  if n < 1 { return Err(flags.usage_error(f"--limit must be a positive integer, got {n}")) }
  Ok(n)
}

fn doc_list(input: flags.CommandInput) -> Result<(), string> {
  let ctx = input.ctx
  let p = input.parsed
  let kind = if p.given("-k") { check_kind(p.one("-k"))? } else { "" }
  let limit = limit_flag(p)?
  let team = current_team(ctx)?
  let search = strings.ToLower(strings.TrimSpace(p.one("--search")))
  let mut filter = query.filter(team.id, "", "", "", "", "")
  if kind != "" { filter = f"{filter} && kind={query.quote(kind)}" }
  let mut items = records.fetch_docs(ctx, filter, "kind,slug", "")?
  if search != "" {
    items = items.filter(|d| strings.Contains(strings.ToLower(d.slug), search) || strings.Contains(strings.ToLower(d.title), search))
  }
  if limit > 0 && items.length() > limit { items = items[..limit] }
  let docs = models.DocList { items }
  if p.given("--json") { return print_list_json(docs.items, whole_list(docs.items.length()), "docs") }
  if docs.items.is_empty() { return say_empty("docs") }
  for d in docs.items {
    let mut kind = d.kind
    if kind == "" { kind = "-" }
    fmt.Println(f"{d.slug}\t{kind}\t{display.table_cell(d.title)}")
  }
  Ok(())
}

fn doc_view(input: flags.CommandInput) -> Result<(), string> {
  let ctx = input.ctx
  let p = input.parsed
  let slug = p.first()
  let usage = input.usage
  if slug == "" { return Err(flags.usage_error(f"usage: {usage}")) }
  let json_mode = p.given("--json")
  let raw_mode = p.given("--raw")

  let record = records.fetch_doc_record(ctx, current_team(ctx)?, slug)?
  if json_mode {
    fmt.Println(contract_json(record.bytes() as json.RawMessage, 0) as string)
    return Ok(())
  }

  let mut d = models.Doc { .. }
  if let Err(e) = json.Unmarshal(record.bytes(), &d) {
    return Err(f"decoding doc: {e}")
  }

  // --raw: the body and nothing else. For piping, and for an agent that
  // wants the text rather than the property table.
  if raw_mode {
    fmt.Print(d.body)
    return Ok(())
  }

  fmt.Println(f"{d.slug} {display.table_cell(d.title)}{display.table_cell(display.confidence_suffix(d.confidence, d.confidence_note))}")
  fmt.Println("")
  fmt.Println(f"Kind:      {d.kind}")
  if let Some(author) = d.expand.author {
    let tag = display.author_tag(author.kind == "bot", author.owner_name())
    fmt.Println(f"Author:    {display.table_cell(author.name)}{tag}")
  } else if d.author != "" {
    fmt.Println(f"Author:    {display.hidden_member()}")
  }
  if d.confidence_note != "" { fmt.Println(f"Note:      {display.table_cell(d.confidence_note)}") }
  if d.area != "" { fmt.Println(f"Area:      {display.table_cell(d.area)}") }
  if d.paths != "" { fmt.Println(f"Paths:     {display.table_cell(d.paths)}") }
  fmt.Println(f"Created:   {display.relative(d.created)}")
  fmt.Println(f"Updated:   {display.relative(d.updated)}")
  if d.expand.issues.length() > 0 {
    let keys = d.expand.issues.map(|i| f"{i.expand.team.key}-{i.number}")
    fmt.Println(f"Issues:    {strings.Join(keys, ", ")}")
  }
  if d.body != "" {
    fmt.Println("")
    fmt.Println(d.body)
  }
  Ok(())
}

fn doc_edit(input: flags.CommandInput) -> Result<(), string> {
  let ctx = input.ctx
  let usage = input.usage
  let p = input.parsed
  let slug = p.first()
  if slug == "" { return Err(flags.usage_error(f"usage: {usage}")) }
  let mut body = ""
  if p.given("-b") { body = value_or_stdin(p.one("-b"), "-b")? }
  let body_set = p.given("-b")
  let title = p.one("-t")
  let title_set = p.given("-t")
  let kind_raw = p.one("-k")
  let kind_set = p.given("-k")
  let area_raw = p.one("-a")
  let area_set = p.given("-a")
  let paths_raw = p.one("--paths")
  let paths_set = p.given("--paths")
  if !body_set && !title_set && !kind_set && !area_set && !paths_set {
    return Err(flags.usage_error(f"nothing to edit: pass at least one flag\nusage: {usage}"))
  }

  let d = records.fetch_doc(ctx, current_team(ctx)?, slug)?
  // `-b -` replaces the whole body; there is deliberately no append mode.
  let mut patch = writes.DocPatch { .. }
  if body_set { patch.body = Some(body) }
  if title_set { patch.title = Some(title) }
  if kind_set { patch.kind = Some(check_kind(kind_raw)?) }
  if area_set { patch.area = Some(strings.TrimSpace(area_raw)) }
  if paths_set { patch.paths = Some(parse_paths(paths_raw)) }
  writes.update_doc(ctx, d.id, patch)?
  fmt.Println(f"Updated doc {d.slug}")
  Ok(())
}

fn doc_delete(input: flags.CommandInput) -> Result<(), string> {
  let ctx = input.ctx
  let p = input.parsed
  let slug = p.first()
  if slug == "" { return Err(flags.usage_error("usage: lll doc delete SLUG [--yes]")) }

  let d = records.fetch_doc(ctx, current_team(ctx)?, slug)?
  if !p.given("--yes") && !confirmed(f"delete doc {d.slug}?") {
    return Err(aborted())
  }
  writes.delete_doc(ctx, d.id)?
  fmt.Println(f"Deleted doc {d.slug}")
  Ok(())
}

