import "go:strings"

#[test]
fn lines_and_text_accumulate_in_order() {
  let out = line("a").text("b").line("c")
  assert out.data == "a\nbc\n"
}

#[test]
fn text_output_sends_its_notices_to_stderr() {
  let out = line("Created label bug").notice("note: one")
  assert out.data == "Created label bug\n"
  assert strings.Join(out.stderr_lines(), "|") == "note: one"
}

#[test]
fn a_machine_document_drops_the_notices() {
  // --json and --env print the document alone: a script reads stdout whole.
  assert json("{}").notice("no labels").stderr_lines().length() == 0
  assert env("export A=1\n").notice("hint").stderr_lines().length() == 0
  assert json("{}").data == "{}\n"
}

#[test]
fn then_joins_data_and_notices_and_keeps_a_machine_kind() {
  let joined = notice("first").then(json("[]").notice("second"))
  assert joined.data == "[]\n"
  assert strings.Join(joined.notices, "|") == "first|second"
  assert joined.stderr_lines().length() == 0
  let text_after = json("{}").then(none())
  assert text_after.stderr_lines().length() == 0
}
