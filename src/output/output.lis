/// What a command has to say, as a value (LLL-683).
///
/// Commands used to print as they went, each choosing stdout or stderr on
/// its own, and the 1.0 fleet found the drift: notices on stdout, --env
/// output on stderr, "Error:" before an exit that was only nothing-to-do.
/// Now a command returns an Output and main's renderer is the one place
/// that writes: `data` to stdout, `notices` to stderr, and under --json or
/// --env only the data.
pub struct Output {
  /// The command's answer, exactly as stdout carries it: what a pipe or a
  /// script reads. Built with `line` and `text`, so it ends in a newline
  /// whenever the command's last write did.
  pub data: string,
  /// Remarks for the person at the terminal, one per line: stderr.
  pub notices: Slice<string>,
  pub kind: Kind,
}

/// What `data` is. A machine document (--json, --env) stands alone on
/// stdout: the renderer drops the notices, so a script never has to tell
/// the answer from the commentary.
pub enum Kind {
  Text,
  Json,
  Env,
}

/// Nothing to say.
pub fn none() -> Output {
  Output { data: "", notices: [], kind: Kind.Text }
}

/// One line of text.
pub fn line(s: string) -> Output {
  none().line(s)
}

/// Text written as it is, without a newline added.
pub fn text(s: string) -> Output {
  none().text(s)
}

/// A --json document: one line of JSON.
pub fn json(doc: string) -> Output {
  Output { data: f"{doc}\n", notices: [], kind: Kind.Json }
}

/// --env output: shell export lines, written as they are.
pub fn env(exports: string) -> Output {
  Output { data: exports, notices: [], kind: Kind.Env }
}

/// A notice alone, with no data: an empty list's "no labels".
pub fn notice(s: string) -> Output {
  none().notice(s)
}

impl Output {
  /// `s` and a newline appended to the data.
  pub fn line(self, s: string) -> Output {
    Output { data: f"{self.data}{s}\n", ..self }
  }

  /// `s` appended to the data as it is.
  pub fn text(self, s: string) -> Output {
    Output { data: f"{self.data}{s}", ..self }
  }

  /// `s` added as one more notice.
  pub fn notice(self, s: string) -> Output {
    Output { notices: self.notices.append(s), ..self }
  }

  /// This output followed by `next`: data after data, notices after
  /// notices. A machine document in `next` makes the whole one machine.
  pub fn then(self, next: Output) -> Output {
    let kind = match next.kind {
      Kind.Text => self.kind,
      other => other,
    }
    Output { data: f"{self.data}{next.data}", notices: self.notices.append(next.notices...), kind }
  }

  /// The notices the renderer writes to stderr: none under --json or --env.
  pub fn stderr_lines(self) -> Slice<string> {
    match self.kind {
      Kind.Text => self.notices,
      Kind.Json | Kind.Env => [],
    }
  }
}
