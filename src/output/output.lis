/// What a command has to say, as a value (LLL-683).
///
/// Commands used to print as they went, each choosing stdout or stderr on
/// its own, and the 1.0 fleet found the drift: notices on stdout, --env
/// output on stderr, "Error:" before an exit that was only nothing-to-do.
/// Now a command returns an Output and main's renderer is the one place
/// that writes: the data to stdout, the notices to stderr, and under --json or
/// --env only the data.
pub struct Output {
  /// What to write, in the order the command said it: the renderer keeps
  /// that order, so a notice that introduces the data still comes first on
  /// a terminal.
  pub parts: Slice<Part>,
  pub kind: Kind,
}

/// One piece of an Output.
pub enum Part {
  /// The command's answer, exactly as stdout carries it: what a pipe or a
  /// script reads. Written as it is; `line` adds the newline.
  Data(string),
  /// A remark for the person at the terminal, one line: stderr.
  Notice(string),
}

/// What the data is. A machine document (--json, --env) stands alone on
/// stdout: the renderer drops the notices, so a script never has to tell
/// the answer from the commentary.
pub enum Kind {
  Text,
  /// A --json document.
  Json,
  /// --env: shell export lines.
  Exports,
}

/// Nothing to say.
pub fn none() -> Output {
  Output { parts: [], kind: Kind.Text }
}

/// One line of text.
pub fn line(s: string) -> Output {
  none().line(s)
}

/// Text written as it is, without a newline added.
pub fn text(s: string) -> Output {
  none().text(s)
}

/// A --json document: one line of JSON.
pub fn json(doc: string) -> Output {
  Output { parts: [Part.Data(f"{doc}\n")], kind: Kind.Json }
}

/// --env output: shell export lines, written as they are.
pub fn env(exports: string) -> Output {
  Output { parts: [Part.Data(exports)], kind: Kind.Exports }
}

/// A notice alone, with no data: an empty list's "no labels".
pub fn notice(s: string) -> Output {
  none().notice(s)
}

impl Output {
  /// `s` and a newline appended to the data.
  pub fn line(self, s: string) -> Output {
    self.text(f"{s}\n")
  }

  /// `s` appended to the data as it is.
  pub fn text(self, s: string) -> Output {
    Output { parts: self.parts.append(Part.Data(s)), ..self }
  }

  /// `s` added as one more notice.
  pub fn notice(self, s: string) -> Output {
    Output { parts: self.parts.append(Part.Notice(s)), ..self }
  }

  /// This output followed by `next`. A machine document in `next` makes
  /// the whole one machine.
  pub fn then(self, next: Output) -> Output {
    let kind = match next.kind {
      Kind.Text => self.kind,
      other => other,
    }
    Output { parts: self.parts.append(next.parts...), kind }
  }

  /// The parts the renderer writes, in order: every part of a text output,
  /// only the data of a --json or --env document.
  pub fn written(self) -> Slice<Part> {
    match self.kind {
      Kind.Text => self.parts,
      Kind.Json | Kind.Exports => self.parts.filter(|part| match part {
        Part.Data(_) => true,
        Part.Notice(_) => false,
      }),
    }
  }

  /// Everything bound for stdout, joined.
  pub fn data(self) -> string {
    let mut all = ""
    for part in self.parts {
      if let Part.Data(s) = part { all = all + s }
    }
    all
  }

  /// The notices the renderer writes to stderr: none under --json or --env.
  pub fn stderr_lines(self) -> Slice<string> {
    let mut lines: Slice<string> = []
    for part in self.written() {
      if let Part.Notice(s) = part { lines = lines.append(s) }
    }
    lines
  }
}
