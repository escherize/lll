# Add to ~/.bashrc:  eval "$(lll completions bash)"
_lll() {
  local cur=${COMP_WORDS[COMP_CWORD]}
  local noun=${COMP_WORDS[1]-}
  local verb=${COMP_WORDS[2]-}
  local words=
  if [ $COMP_CWORD -eq 1 ]; then
    words='\''issue team member project label doc finding config attach watch up board completions help --version'\''
  elif [ $COMP_CWORD -eq 2 ]; then
    case $noun in
      issue) words='\''create list view update close start claim release delete comment watch url id title pr link unlink'\'' ;;
      team) words='\''list create view'\'' ;;
      member) words='\''list add'\'' ;;
      project) words='\''list view create'\'' ;;
      label) words='\''list create'\'' ;;
      doc) words='\''new list view edit delete'\'' ;;
      finding) words='\''near list'\'' ;;
      config) words='\''init set --list'\'' ;;
      attach) words='\''-k'\'' ;;
      watch) words='\''--state --assignee --label --project --search --json'\'' ;;
      up) words='\''--port --pb-dir --no-open'\'' ;;
      board) words='\''-w'\'' ;;
      completions) words='\''bash zsh fish'\'' ;;
    esac
  else
    case $noun,$verb in
      issue,create) words='\''-t -d --description --emoji --priority --assignee --label --project --json'\'' ;;
      issue,list) words='\''--state --assignee --label --project --search --sort --limit --json'\'' ;;
      issue,view) words='\''--json --raw -w'\'' ;;
      issue,update) words='\''--state --priority --assignee --label --project --title --description --emoji'\'' ;;
      issue,delete) words='\''--force'\'' ;;
      issue,comment) words='\''-b'\'' ;;
      issue,watch) words='\''--json'\'' ;;
      team,create) words='\''-k -n'\'' ;;
      member,add) words='\''-n -e'\'' ;;
      project,create) words='\''-n -d --status --team'\'' ;;
      label,create) words='\''-n -c --team'\'' ;;
      doc,new) words='\''-s --slug -t --title -k --kind -b --body -a --area -p --paths'\'' ;;
      doc,view) words='\''--raw --json'\'' ;;
      doc,edit) words='\''-b --body -t --title -k --kind -a --area -p --paths'\'' ;;
      doc,delete) words='\''--force'\'' ;;
      finding,list) words='\''-a --area'\'' ;;
      attach,*) words='\''-k'\'' ;;
      watch,*) words='\''--state --assignee --label --project --search --json'\'' ;;
      up,*) words='\''--port --pb-dir --no-open'\'' ;;
      board,*) words='\''-w'\'' ;;
    esac
  fi
  COMPREPLY=($(compgen -W "$words" -- "$cur"))
}
